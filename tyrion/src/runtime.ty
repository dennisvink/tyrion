# Runtime values, heap objects, lexical environments, and builtin primitives.


def tyrion_value(kind, value):
    return {"kind": kind, "value": value}


def tyrion_none():
    return tyrion_value("none", none)


def tyrion_bool(value):
    return tyrion_value("bool", value)


def tyrion_int(value):
    return tyrion_value("int", value)


def tyrion_float(value):
    return tyrion_value("float", value)


def tyrion_string(value):
    return tyrion_value("string", value)


def tyrion_bytes(value):
    # Packed interpreter-internal byte storage. It presents list semantics to
    # Tyrion code without allocating a boxed VM integer for every network byte.
    return tyrion_value("bytes", {"segments": [value], "length": len(value)})


def tyrion_bytes_from_segments(segments, length):
    return tyrion_value("bytes", {"segments": segments, "length": length})


def tyrion_bytes_length(value):
    return value["value"]["length"]


def tyrion_bytes_flatten(value):
    data = value["value"]
    segments = data["segments"]
    if len(segments) == 1:
        return segments[0]
    out = range(data["length"])
    out_index = 0
    segment_index = 0
    while segment_index < len(segments):
        segment = segments[segment_index]
        byte_index = 0
        while byte_index < len(segment):
            out[out_index] = segment[byte_index]
            out_index = out_index + 1
            byte_index = byte_index + 1
        segment_index = segment_index + 1
    return out


def tyrion_bytes_index(value, index):
    length = tyrion_bytes_length(value)
    index = tyrion_index_normalize(length, index)
    position = 0
    segments = value["value"]["segments"]
    segment_index = 0
    while segment_index < len(segments):
        segment = segments[segment_index]
        if index < position + len(segment):
            return segment[index - position]
        position = position + len(segment)
        segment_index = segment_index + 1
    raise "IndexError: byte index out of range"


def tyrion_bytes_slice(value, start, stop):
    length = tyrion_bytes_length(value)
    start = tyrion_index_normalize(length, start)
    stop = tyrion_index_normalize(length, stop)
    if start < 0:
        start = 0
    if stop > length:
        stop = length
    if stop <= start:
        return tyrion_bytes([])
    segments = value["value"]["segments"]
    sliced = []
    position = 0
    segment_index = 0
    while segment_index < len(segments):
        segment = segments[segment_index]
        segment_stop = position + len(segment)
        if segment_stop > start and position < stop:
            local_start = 0
            if start > position:
                local_start = start - position
            local_stop = len(segment)
            if stop < segment_stop:
                local_stop = stop - position
            sliced.append(segment[local_start:local_stop])
        position = segment_stop
        segment_index = segment_index + 1
    return tyrion_bytes_from_segments(sliced, stop - start)


def tyrion_extension(value):
    return tyrion_value("extension", value)


def tyrion_function(node, environment):
    return tyrion_value("function", {"node": node, "environment": environment})


def tyrion_lambda(node, environment):
    return tyrion_value("lambda", {"node": node, "environment": environment})


def tyrion_bound_method(receiver, name):
    return tyrion_value("bound_method", {"receiver": receiver, "name": name})


def tyrion_class(name, methods, environment):
    return tyrion_value("class", {"name": name, "methods": methods, "environment": environment})


def tyrion_object_method(receiver, function):
    return tyrion_value("object_method", {"receiver": receiver, "function": function})


def tyrion_runtime_state(args):
    return {"heap": [], "environments": [], "free_environments": [], "args": args, "steps": 0}


def tyrion_runtime_step(state):
    state["steps"] = state["steps"] + 1
    if state["steps"] > 100000000:
        raise "Tyrion execution step limit exceeded"
    return state


def tyrion_heap_alloc(state, object_kind, items):
    heap = state["heap"]
    handle = len(heap)
    heap.append({"kind": object_kind, "items": items})
    state["heap"] = heap
    return {"state": state, "value": tyrion_value(object_kind, handle)}


def tyrion_heap_get(state, value):
    if not value["kind"] in ["list", "tuple", "set", "dict", "file", "object", "iterator", "bytearray"]:
        raise "expected collection, got " + value["kind"]
    return state["heap"][value["value"]]


def tyrion_heap_set(state, value, object_value):
    heap = state["heap"]
    heap[value["value"]] = object_value
    state["heap"] = heap
    return state


def tyrion_env_new(state, parent):
    environments = state["environments"]
    free_environments = state["free_environments"]
    if len(free_environments) > 0:
        free_index = len(free_environments) - 1
        handle = free_environments[free_index]
        free_environments = free_environments[:free_index]
        environments[handle] = {"parent": parent, "values": {}}
    else:
        handle = len(environments)
        environments.append({"parent": parent, "values": {}})
    state["environments"] = environments
    state["free_environments"] = free_environments
    return {"state": state, "environment": handle}


def tyrion_env_release(state, environment):
    if environment <= 0:
        return state
    environments = state["environments"]
    environments[environment] = {"parent": -1, "values": {}}
    free_environments = state["free_environments"]
    free_environments.append(environment)
    state["environments"] = environments
    state["free_environments"] = free_environments
    return state


def tyrion_env_set(state, environment, name, value):
    environments = state["environments"]
    record = environments[environment]
    values = record["values"]
    values[name] = value
    record["values"] = values
    environments[environment] = record
    state["environments"] = environments
    return state


def tyrion_env_assign(state, environment, name, value):
    current = environment
    while current >= 0:
        record = state["environments"][current]
        if name in record["values"].keys():
            return tyrion_env_set(state, current, name, value)
        current = record["parent"]
    return tyrion_env_set(state, environment, name, value)


def tyrion_env_get(state, environment, name):
    current = environment
    while current >= 0:
        record = state["environments"][current]
        if name in record["values"].keys():
            return record["values"][name]
        current = record["parent"]
    if tyrion_is_builtin(name):
        return tyrion_value("builtin", name)
    raise "NameError: " + name + " is not defined"


def tyrion_is_builtin(name):
    return name in ["__tyrion_native_ascii_text", "__tyrion_native_host_call", "__tyrion_native_host_load", "__tyrion_native_host_unload", "__tyrion_native_tcp_close", "__tyrion_native_tcp_connect", "__tyrion_native_tcp_read", "__tyrion_native_tcp_write", "__tyrion_native_tls_read", "__tyrion_native_tls_write", "__tyrion_native_wall_time", "__tyrion_run_tool", "all", "ansi_escape", "any", "argv", "ascii", "bool", "bytearray", "bytes", "callable", "delattr", "dict", "enumerate", "float", "format", "getattr", "hasattr", "input", "int", "isinstance", "iter", "len", "max", "min", "next", "open", "print", "range", "read_key", "repr", "reversed", "run_tool", "set", "setattr", "sorted", "std_io_tcp_close", "std_io_tcp_connect", "std_io_tcp_read", "std_io_tcp_write", "str", "sum", "time", "tuple", "type", "zip"]


def tyrion_type_name(state, value):
    if value["kind"] == "string":
        return "str"
    if value["kind"] == "none":
        return "NoneType"
    if value["kind"] == "object":
        return tyrion_heap_get(state, value)["items"]["class"]["value"]["name"]
    if value["kind"] == "object_method" or value["kind"] == "bound_method":
        return "method"
    return value["kind"]


def tyrion_isinstance_value(state, value, specification):
    if specification["kind"] == "string":
        return tyrion_type_name(state, value) == specification["value"]
    if specification["kind"] == "class":
        if value["kind"] != "object":
            return False
        return tyrion_heap_get(state, value)["items"]["class"]["value"]["name"] == specification["value"]["name"]
    if specification["kind"] == "tuple" or specification["kind"] == "list":
        choices = tyrion_collection_items(state, specification)
        index = 0
        while index < len(choices):
            if tyrion_isinstance_value(state, value, choices[index]):
                return True
            index = index + 1
        return False
    raise "TypeError: isinstance type specification must be a type name, class, or tuple"


def tyrion_embedded_tls_anchor():
    # The interpreter resolves built-in module source at runtime, so the
    # compiler cannot discover its native dependency from the source string.
    # This ordinary unreachable function keeps the dependency explicit while
    # allowing the generic static-extension planner to link the embedded TLS
    # package into the single-file interpreter.
    return __tyrion_native_host_load("tls")


def tyrion_truthy(state, value):
    kind = value["kind"]
    if kind == "none":
        return False
    if kind == "bool":
        return value["value"]
    if kind == "int" or kind == "float":
        return value["value"] != 0
    if kind == "string":
        return value["value"] != ""
    if kind == "bytes":
        return tyrion_bytes_length(value) != 0
    if kind in ["list", "tuple", "set", "dict", "bytearray"]:
        return len(tyrion_heap_get(state, value)["items"]) != 0
    if kind == "file":
        return tyrion_heap_get(state, value)["items"]["path"] != ""
    if kind == "range":
        data = value["value"]
        if data["step"] > 0:
            return data["start"] < data["stop"]
        return data["start"] > data["stop"]
    return True


def tyrion_value_text(state, value):
    kind = value["kind"]
    if kind == "none":
        return "None"
    if kind == "bool":
        if value["value"]:
            return "True"
        return "False"
    if kind == "float":
        return tyrion_float_text(value["value"])
    if kind == "int" or kind == "string":
        return str(value["value"])
    if kind == "bytes":
        raw = tyrion_bytes_flatten(value)
        out = "["
        index = 0
        while index < len(raw):
            if index > 0:
                out = out + ", "
            out = out + str(raw[index])
            index = index + 1
        return out + "]"
    if kind == "bytearray":
        raw_values = tyrion_heap_get(state, value)["items"]
        out = "bytearray(["
        index = 0
        while index < len(raw_values):
            if index > 0:
                out = out + ", "
            out = out + str(raw_values[index]["value"])
            index = index + 1
        return out + "])"
    if kind == "function":
        return "<function " + value["value"]["node"]["name"] + ">"
    if kind == "lambda":
        return "<lambda>"
    if kind == "file":
        return tyrion_heap_get(state, value)["items"]["path"]
    if kind == "builtin":
        return "<builtin " + value["value"] + ">"
    if kind == "bound_method":
        return "<bound method " + value["value"]["name"] + ">"
    if kind == "object_method":
        return "<bound method " + value["value"]["function"]["value"]["node"]["name"] + ">"
    if kind == "class":
        return "<class " + value["value"]["name"] + ">"
    if kind == "object":
        return "<" + tyrion_heap_get(state, value)["items"]["class"]["value"]["name"] + " object>"
    if kind == "extension":
        return "<native extension>"
    if kind == "range":
        data = value["value"]
        return "range(" + str(data["start"]) + ", " + str(data["stop"]) + ", " + str(data["step"]) + ")"
    object_value = tyrion_heap_get(state, value)
    if kind == "dict":
        out = "{"
        index = 0
        while index < len(object_value["items"]):
            if index > 0:
                out = out + ", "
            entry = object_value["items"][index]
            out = out + tyrion_value_repr(state, entry["key"]) + ": " + tyrion_value_repr(state, entry["value"])
            index = index + 1
        return out + "}"
    open_text = "["
    close_text = "]"
    if kind == "tuple":
        open_text = "("
        close_text = ")"
    elif kind == "set":
        open_text = "{"
        close_text = "}"
    out = open_text
    index = 0
    while index < len(object_value["items"]):
        if index > 0:
            out = out + ", "
        out = out + tyrion_value_repr(state, object_value["items"][index])
        index = index + 1
    if kind == "tuple" and len(object_value["items"]) == 1:
        out = out + ","
    return out + close_text


def tyrion_value_repr(state, value):
    if value["kind"] == "string":
        return "\"" + value["value"] + "\""
    return tyrion_value_text(state, value)


def tyrion_value_equal(state, left, right):
    if left["kind"] != right["kind"]:
        if left["kind"] in ["int", "float"] and right["kind"] in ["int", "float"]:
            return left["value"] == right["value"]
        return False
    kind = left["kind"]
    if kind == "bytes":
        return tyrion_bytes_flatten(left) == tyrion_bytes_flatten(right)
    if kind in ["none", "bool", "int", "float", "string", "builtin"]:
        return left["value"] == right["value"]
    if kind == "function" or kind == "lambda" or kind == "bound_method" or kind == "object_method" or kind == "class" or kind == "object":
        return left["value"] == right["value"]
    if kind == "extension":
        return False
    if left["value"] == right["value"]:
        return True
    left_items = tyrion_heap_get(state, left)["items"]
    right_items = tyrion_heap_get(state, right)["items"]
    if len(left_items) != len(right_items):
        return False
    index = 0
    if kind == "dict":
        while index < len(left_items):
            found = False
            right_index = 0
            while right_index < len(right_items):
                if tyrion_value_equal(state, left_items[index]["key"], right_items[right_index]["key"]):
                    if not tyrion_value_equal(state, left_items[index]["value"], right_items[right_index]["value"]):
                        return False
                    found = True
                right_index = right_index + 1
            if not found:
                return False
            index = index + 1
        return True
    while index < len(left_items):
        if not tyrion_value_equal(state, left_items[index], right_items[index]):
            return False
        index = index + 1
    return True


def tyrion_class_find_method(class_value, name):
    methods = class_value["value"]["methods"]
    index = 0
    while index < len(methods):
        if methods[index]["name"] == name:
            return index
        index = index + 1
    return -1


def tyrion_object_find_attr(state, object_value, name):
    attrs = tyrion_heap_get(state, object_value)["items"]["attrs"]
    index = 0
    while index < len(attrs):
        if attrs[index]["name"] == name:
            return index
        index = index + 1
    return -1


def tyrion_object_get_attr(state, object_value, name):
    object_data = tyrion_heap_get(state, object_value)["items"]
    index = tyrion_object_find_attr(state, object_value, name)
    if index >= 0:
        return object_data["attrs"][index]["value"]
    method_index = tyrion_class_find_method(object_data["class"], name)
    if method_index >= 0:
        method = object_data["class"]["value"]["methods"][method_index]
        function_node = {"id": method["node"], "name": object_data["class"]["value"]["name"] + "." + name}
        function = tyrion_function(function_node, object_data["class"]["value"]["environment"])
        return tyrion_object_method(object_value, function)
    return tyrion_none()


def tyrion_object_set_attr(state, object_value, name, value):
    object_record = tyrion_heap_get(state, object_value)
    object_data = object_record["items"]
    attrs = object_data["attrs"]
    index = tyrion_object_find_attr(state, object_value, name)
    if index < 0:
        attrs.append({"name": name, "value": value})
    else:
        attrs[index] = {"name": name, "value": value}
    object_data["attrs"] = attrs
    object_record["items"] = object_data
    return tyrion_heap_set(state, object_value, object_record)


def tyrion_dict_find(state, dictionary, key):
    items = tyrion_heap_get(state, dictionary)["items"]
    index = 0
    while index < len(items):
        if tyrion_value_equal(state, items[index]["key"], key):
            return index
        index = index + 1
    return -1


def tyrion_dict_get(state, dictionary, key):
    index = tyrion_dict_find(state, dictionary, key)
    if index < 0:
        raise "KeyError: " + tyrion_value_text(state, key)
    return tyrion_heap_get(state, dictionary)["items"][index]["value"]

def tyrion_dict_get_default(state, dictionary, key, default):
    index = tyrion_dict_find(state, dictionary, key)
    if index < 0:
        return default
    return tyrion_heap_get(state, dictionary)["items"][index]["value"]


def tyrion_dict_set(state, dictionary, key, value):
    object_value = tyrion_heap_get(state, dictionary)
    items = object_value["items"]
    index = tyrion_dict_find(state, dictionary, key)
    if index < 0:
        items.append({"key": key, "value": value})
    else:
        items[index] = {"key": key, "value": value}
    object_value["items"] = items
    return tyrion_heap_set(state, dictionary, object_value)


def tyrion_collection_items(state, value):
    kind = value["kind"]
    if kind == "bytes":
        raw = tyrion_bytes_flatten(value)
        values = range(len(raw))
        index = 0
        while index < len(raw):
            values[index] = tyrion_int(raw[index])
            index = index + 1
        return values
    if kind == "range":
        data = value["value"]
        values = []
        current = data["start"]
        if data["step"] > 0:
            while current < data["stop"]:
                values.append(tyrion_int(current))
                current = current + data["step"]
        else:
            while current > data["stop"]:
                values.append(tyrion_int(current))
                current = current + data["step"]
        return values
    if kind == "list" or kind == "tuple" or kind == "set" or kind == "bytearray":
        return tyrion_heap_get(state, value)["items"]
    if kind == "dict":
        entries = tyrion_heap_get(state, value)["items"]
        keys = []
        index = 0
        while index < len(entries):
            keys.append(entries[index]["key"])
            index = index + 1
        return keys
    if kind == "string":
        chars = []
        index = 0
        while index < len(value["value"]):
            chars.append(tyrion_string(value["value"][index]))
            index = index + 1
        return chars
    raise "TypeError: " + kind + " is not iterable"


def tyrion_index_normalize(length, index):
    if index < 0:
        return length + index
    return index


def tyrion_index_get(state, receiver, index):
    kind = receiver["kind"]
    if kind == "dict":
        return tyrion_dict_get(state, receiver, index)
    if index["kind"] != "int":
        raise "TypeError: collection index must be int"
    raw_index = index["value"]
    if kind == "string":
        raw_index = tyrion_index_normalize(len(receiver["value"]), raw_index)
        return tyrion_string(receiver["value"][raw_index])
    if kind == "bytes":
        return tyrion_int(tyrion_bytes_index(receiver, raw_index))
    if kind in ["list", "tuple", "set", "range", "bytearray"]:
        items = tyrion_collection_items(state, receiver)
        raw_index = tyrion_index_normalize(len(items), raw_index)
        return items[raw_index]
    raise "TypeError: " + kind + " does not support indexing"


def tyrion_index_set(state, receiver, index, value):
    if receiver["kind"] == "dict":
        return tyrion_dict_set(state, receiver, index, value)
    if receiver["kind"] != "list" and receiver["kind"] != "bytearray":
        raise "TypeError: assignment target is not mutable"
    object_value = tyrion_heap_get(state, receiver)
    items = object_value["items"]
    raw_index = tyrion_index_normalize(len(items), index["value"])
    items[raw_index] = value
    object_value["items"] = items
    return tyrion_heap_set(state, receiver, object_value)


def tyrion_builtin_print(state, args, kwargs):
    separator = " "
    ending = "\n"
    output_value = tyrion_none()
    flush_output = False
    seen_sep = False
    seen_end = False
    seen_file = False
    seen_flush = False
    keyword_index = 0
    while keyword_index < len(kwargs):
        keyword = kwargs[keyword_index]
        if keyword["name"] == "sep":
            if seen_sep:
                raise "TypeError: print() got multiple values for keyword argument 'sep'"
            seen_sep = True
            if keyword["value"]["kind"] == "none":
                separator = " "
            elif keyword["value"]["kind"] == "string":
                separator = keyword["value"]["value"]
            else:
                raise "TypeError: sep must be None or a string"
        elif keyword["name"] == "end":
            if seen_end:
                raise "TypeError: print() got multiple values for keyword argument 'end'"
            seen_end = True
            if keyword["value"]["kind"] == "none":
                ending = "\n"
            elif keyword["value"]["kind"] == "string":
                ending = keyword["value"]["value"]
            else:
                raise "TypeError: end must be None or a string"
        elif keyword["name"] == "file":
            if seen_file:
                raise "TypeError: print() got multiple values for keyword argument 'file'"
            seen_file = True
            output_value = keyword["value"]
        elif keyword["name"] == "flush":
            if seen_flush:
                raise "TypeError: print() got multiple values for keyword argument 'flush'"
            seen_flush = True
            flush_output = tyrion_truthy(state, keyword["value"])
        else:
            raise "TypeError: print got an unexpected keyword argument"
        keyword_index = keyword_index + 1
    text = ""
    index = 0
    while index < len(args):
        if index > 0:
            text = text + separator
        text = text + tyrion_value_text(state, args[index])
        index = index + 1
    if output_value["kind"] == "none" and separator == " " and ending == "\n" and not flush_output:
        print(text)
    elif output_value["kind"] == "none":
        with open("/dev/stdout", "a") as stdout_file:
            stdout_file.write(text + ending)
            if flush_output:
                stdout_file.flush()
    else:
        written = tyrion_call_method(state, output_value, "write", [tyrion_string(text + ending)])
        state = written["state"]
        if flush_output:
            flushed = tyrion_call_method(state, output_value, "flush", [])
            state = flushed["state"]
    return {"state": state, "value": tyrion_none()}


def tyrion_builtin_range(state, args):
    start = 0
    stop = 0
    step = 1
    if len(args) == 1:
        stop = args[0]["value"]
    elif len(args) == 2:
        start = args[0]["value"]
        stop = args[1]["value"]
    elif len(args) == 3:
        start = args[0]["value"]
        stop = args[1]["value"]
        step = args[2]["value"]
    else:
        raise "TypeError: range expects 1 to 3 arguments"
    if step == 0:
        raise "ValueError: range step cannot be zero"
    return {"state": state, "value": tyrion_value("range", {"start": start, "stop": stop, "step": step})}


def tyrion_host_event_value(state, event):
    fields = ["key", "text", "sequence", "shift", "alt", "ctrl", "super"]
    entries = []
    index = 0
    while index < len(fields):
        name = fields[index]
        if name in ["shift", "alt", "ctrl", "super"]:
            field_value = tyrion_bool(event[name])
        else:
            field_value = tyrion_string(event[name])
        entries.append({"key": tyrion_string(name), "value": field_value})
        index = index + 1
    return tyrion_heap_alloc(state, "dict", entries)


def tyrion_sequence_find(state, items, value, start, stop):
    if start < 0:
        start = len(items) + start
    if stop < 0:
        stop = len(items) + stop
    if start < 0:
        start = 0
    if stop > len(items):
        stop = len(items)
    index = start
    while index < stop:
        if tyrion_value_equal(state, items[index], value):
            return index
        index = index + 1
    return -1


def tyrion_string_find(text, needle, start, stop, reverse):
    if start < 0:
        start = len(text) + start
    if stop < 0:
        stop = len(text) + stop
    if start < 0:
        start = 0
    if stop > len(text):
        stop = len(text)
    found = -1
    index = start
    if needle == "":
        return stop
    while index + len(needle) <= stop:
        if text[index:index + len(needle)] == needle:
            found = index
            if not reverse:
                return found
        index = index + 1
    return found


def tyrion_string_case(text, upper):
    lowercase = "abcdefghijklmnopqrstuvwxyz"
    uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    out = ""
    index = 0
    while index < len(text):
        ch = text[index]
        translated = ch
        scan = 0
        while scan < len(lowercase):
            if upper and ch == lowercase[scan]:
                translated = uppercase[scan]
            if not upper and ch == uppercase[scan]:
                translated = lowercase[scan]
            scan = scan + 1
        out = out + translated
        index = index + 1
    return out


def tyrion_string_trim(text, chars, trim_left, trim_right):
    start = 0
    stop = len(text)
    if trim_left:
        while start < stop and tyrion_text_contains(chars, text[start]):
            start = start + 1
    if trim_right:
        while stop > start and tyrion_text_contains(chars, text[stop - 1]):
            stop = stop - 1
    return text[start:stop]


def tyrion_string_join_values(state, separator, values):
    out = ""
    index = 0
    while index < len(values):
        if values[index]["kind"] != "string":
            raise "TypeError: join expects string items"
        if index > 0:
            out = out + separator
        out = out + values[index]["value"]
        index = index + 1
    return out


def tyrion_ascii_letter(character):
    return tyrion_text_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", character)


def tyrion_ascii_digit(character):
    return tyrion_text_contains("0123456789", character)


def tyrion_string_classify(text, mode):
    if mode == "isascii":
        # Tyrion source strings are currently ASCII-oriented. The native text
        # boundary will tighten this once the runtime has full Unicode scalar
        # values.
        return True
    if len(text) == 0:
        return False
    seen_cased = False
    seen_content = False
    index = 0
    while index < len(text):
        character = text[index]
        is_letter = tyrion_ascii_letter(character)
        is_digit = tyrion_ascii_digit(character)
        if mode == "isalpha" and not is_letter:
            return False
        if (mode == "isdigit" or mode == "isdecimal" or mode == "isnumeric") and not is_digit:
            return False
        if mode == "isalnum" and not is_letter and not is_digit:
            return False
        if mode == "isspace" and not tyrion_text_contains(" \t\r\n", character):
            return False
        if mode == "isprintable" and tyrion_text_contains("\t\r\n", character):
            return False
        if mode == "islower" or mode == "isupper":
            if is_letter:
                seen_cased = True
                if mode == "islower" and tyrion_text_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", character):
                    return False
                if mode == "isupper" and tyrion_text_contains("abcdefghijklmnopqrstuvwxyz", character):
                    return False
        seen_content = True
        index = index + 1
    if mode == "islower" or mode == "isupper":
        return seen_cased
    return seen_content


def tyrion_string_repeat(text, count):
    out = ""
    while count > 0:
        out = out + text
        count = count - 1
    return out


def tyrion_parse_int_base(text, base):
    if base < 2 or base > 36:
        raise "ValueError: int base must be between 2 and 36"
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    sign = 1
    index = 0
    if len(text) > 0 and (text[0] == "+" or text[0] == "-"):
        if text[0] == "-":
            sign = -1
        index = 1
    if index >= len(text):
        raise "ValueError: invalid integer literal"
    result = 0
    while index < len(text):
        character = tyrion_string_case(text[index], False)
        digit = tyrion_string_find(digits, character, 0, len(digits), False)
        if digit < 0 or digit >= base:
            raise "ValueError: invalid digit for base " + str(base)
        result = result * base + digit
        index = index + 1
    return result * sign


def tyrion_string_split_raw(text, separator, maxsplit, whitespace):
    out = []
    start = 0
    splits = 0
    index = 0
    while index <= len(text):
        matched = False
        width = len(separator)
        if whitespace:
            if index < len(text) and tyrion_text_contains(" \t\r\n", text[index]):
                matched = True
                width = 1
        elif width > 0 and index + width <= len(text) and text[index:index + width] == separator:
            matched = True
        if matched and (maxsplit < 0 or splits < maxsplit):
            if not whitespace or index > start:
                out.append(text[start:index])
                splits = splits + 1
            index = index + width
            if whitespace:
                while index < len(text) and tyrion_text_contains(" \t\r\n", text[index]):
                    index = index + 1
            start = index
        else:
            index = index + 1
    if not whitespace or start < len(text):
        out.append(text[start:])
    return out


def tyrion_string_split_values(text, separator, maxsplit, reverse, whitespace):
    forward_limit = maxsplit
    if reverse:
        forward_limit = -1
    raw = tyrion_string_split_raw(text, separator, forward_limit, whitespace)
    if reverse and maxsplit >= 0 and len(raw) > maxsplit + 1:
        keep_from = len(raw) - maxsplit
        prefix = raw[0]
        index = 1
        while index < keep_from:
            prefix = prefix + separator + raw[index]
            index = index + 1
        trimmed = [prefix]
        while index < len(raw):
            trimmed.append(raw[index])
            index = index + 1
        raw = trimmed
    out = []
    index = 0
    while index < len(raw):
        out.append(tyrion_string(raw[index]))
        index = index + 1
    return out


def tyrion_set_contains(state, items, value):
    index = 0
    while index < len(items):
        if tyrion_value_equal(state, items[index], value):
            return True
        index = index + 1
    return False


def tyrion_set_result(state, left, right, operation):
    out = []
    index = 0
    while index < len(left):
        present = tyrion_set_contains(state, right, left[index])
        if (operation == "intersection" and present) or (operation == "difference" and not present) or operation == "union":
            if not tyrion_set_contains(state, out, left[index]):
                out.append(left[index])
        index = index + 1
    if operation == "union" or operation == "symmetric_difference":
        index = 0
        while index < len(right):
            present = tyrion_set_contains(state, left, right[index])
            if operation == "union" or not present:
                if not tyrion_set_contains(state, out, right[index]):
                    out.append(right[index])
            index = index + 1
    if operation == "symmetric_difference":
        index = 0
        while index < len(left):
            if not tyrion_set_contains(state, right, left[index]):
                out.append(left[index])
            index = index + 1
    return out


def tyrion_call_method(state, receiver, name, args, kwargs=[]):
    if receiver["kind"] == "dict" and name == "get" and len(args) >= 1 and len(args) <= 2:
        default = tyrion_none()
        if len(args) == 2:
            default = args[1]
        return {"state": state, "value": tyrion_dict_get_default(state, receiver, args[0], default)}
    if receiver["kind"] == "bytes" or receiver["kind"] == "bytearray":
        raw_values = []
        if receiver["kind"] == "bytes":
            raw = tyrion_bytes_flatten(receiver)
            index = 0
            while index < len(raw):
                raw_values.append(tyrion_int(raw[index]))
                index = index + 1
        else:
            raw_values = tyrion_heap_get(state, receiver)["items"]
        if name == "hex" and len(args) == 0:
            digits = "0123456789abcdef"
            out = ""
            index = 0
            while index < len(raw_values):
                byte = raw_values[index]["value"]
                out = out + digits[int(byte / 16)] + digits[byte % 16]
                index = index + 1
            return {"state": state, "value": tyrion_string(out)}
        if name == "decode" and len(args) <= 1:
            encoding = "utf-8"
            if len(args) == 1:
                encoding = args[0]["value"]
            if encoding != "ascii" and encoding != "utf-8":
                raise "ValueError: interpreter byte decoding supports ascii and utf-8"
            table = "\t\n\r !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            codes = [9, 10, 13]
            code = 32
            while code <= 126:
                codes.append(code)
                code = code + 1
            out = ""
            index = 0
            while index < len(raw_values):
                found = -1
                code_index = 0
                while code_index < len(codes):
                    if codes[code_index] == raw_values[index]["value"]:
                        found = code_index
                    code_index = code_index + 1
                if found < 0:
                    raise "UnicodeDecodeError: non-ASCII UTF-8 requires the Unicode runtime slice"
                out = out + table[found]
                index = index + 1
            return {"state": state, "value": tyrion_string(out)}
    if receiver["kind"] == "int" and name == "bit_length" and len(args) == 0:
        value = receiver["value"]
        if value < 0:
            value = 0 - value
        bits = 0
        while value > 0:
            value = int(value / 2)
            bits = bits + 1
        return {"state": state, "value": tyrion_int(bits)}
    if receiver["kind"] == "int" and name == "bit_count" and len(args) == 0:
        value = receiver["value"]
        if value < 0:
            value = 0 - value
        count = 0
        while value > 0:
            if value % 2 == 1:
                count = count + 1
            value = int(value / 2)
        return {"state": state, "value": tyrion_int(count)}
    if receiver["kind"] == "int" and name == "as_integer_ratio" and len(args) == 0:
        return tyrion_heap_alloc(state, "tuple", [receiver, tyrion_int(1)])
    if receiver["kind"] == "int" and name == "is_integer" and len(args) == 0:
        return {"state": state, "value": tyrion_bool(True)}
    if receiver["kind"] == "float" and name == "is_integer" and len(args) == 0:
        return {"state": state, "value": tyrion_bool(receiver["value"] == int(receiver["value"]))}
    if receiver["kind"] == "int" and name == "to_bytes" and len(args) >= 1 and len(args) <= 3:
        length = args[0]["value"]
        byteorder = "big"
        signed = False
        if len(args) >= 2:
            byteorder = args[1]["value"]
        if len(args) == 3:
            signed = tyrion_truthy(state, args[2])
        value = receiver["value"]
        if value < 0:
            if not signed:
                raise "OverflowError: cannot convert negative int to unsigned"
            value = pow(256, length) + value
        raw = range(length)
        index = 0
        while index < length:
            byte = value % 256
            position = length - index - 1
            if byteorder == "little":
                position = index
            raw[position] = byte
            value = int(value / 256)
            index = index + 1
        if value != 0:
            raise "OverflowError: int too big to convert"
        return {"state": state, "value": tyrion_bytes(raw)}
    if receiver["kind"] == "builtin" and receiver["value"] == "int" and name == "from_bytes" and len(args) >= 1 and len(args) <= 3:
        raw = tyrion_builtin_iterable_items(state, args[0])
        byteorder = "big"
        signed = False
        if len(args) >= 2:
            byteorder = args[1]["value"]
        if len(args) == 3:
            signed = tyrion_truthy(state, args[2])
        value = 0
        index = 0
        while index < len(raw):
            source_index = index
            if byteorder == "little":
                source_index = len(raw) - index - 1
            value = value * 256 + raw[source_index]["value"]
            index = index + 1
        if signed and len(raw) > 0:
            sign_index = 0
            if byteorder == "little":
                sign_index = len(raw) - 1
            if raw[sign_index]["value"] >= 128:
                value = value - pow(256, len(raw))
        return {"state": state, "value": tyrion_int(value)}
    if receiver["kind"] == "file":
        object_value = tyrion_heap_get(state, receiver)
        file_data = object_value["items"]
        if file_data["closed"] and name != "close":
            raise "ValueError: I/O operation on closed file"
        if name == "read" and len(args) <= 1:
            with open(file_data["path"], "r") as input_file:
                file_text = input_file.read()
            file_start = file_data["offset"]
            file_stop = len(file_text)
            if len(args) == 1:
                file_stop = file_start + args[0]["value"]
                if file_stop > len(file_text):
                    file_stop = len(file_text)
            file_result = file_text[file_start:file_stop]
            file_data["offset"] = file_stop
            object_value["items"] = file_data
            state = tyrion_heap_set(state, receiver, object_value)
            return {"state": state, "value": tyrion_string(file_result)}
        if name == "write" and len(args) == 1:
            with open(file_data["path"], file_data["mode"]) as output_file:
                written_text = tyrion_value_text(state, args[0])
                output_file.write(written_text)
            file_data["offset"] = file_data["offset"] + len(written_text)
            object_value["items"] = file_data
            state = tyrion_heap_set(state, receiver, object_value)
            return {"state": state, "value": tyrion_int(len(written_text))}
        if name == "readline" and len(args) <= 1:
            with open(file_data["path"], "r") as input_file:
                file_text = input_file.read()
            start = file_data["offset"]
            stop = start
            limit = -1
            if len(args) == 1:
                limit = args[0]["value"]
            while stop < len(file_text) and file_text[stop] != "\n" and (limit < 0 or stop - start < limit):
                stop = stop + 1
            if stop < len(file_text) and file_text[stop] == "\n" and (limit < 0 or stop - start < limit):
                stop = stop + 1
            file_data["offset"] = stop
            object_value["items"] = file_data
            state = tyrion_heap_set(state, receiver, object_value)
            return {"state": state, "value": tyrion_string(file_text[start:stop])}
        if name == "readlines" and len(args) <= 1:
            lines = []
            total = 0
            hint = -1
            if len(args) == 1:
                hint = args[0]["value"]
            active = True
            while active and (hint < 0 or total < hint):
                result = tyrion_call_method(state, receiver, "readline", [])
                state = result["state"]
                if result["value"]["value"] == "":
                    active = False
                else:
                    lines.append(result["value"])
                    total = total + len(result["value"]["value"])
            return tyrion_heap_alloc(state, "list", lines)
        if name == "writelines" and len(args) == 1:
            lines = tyrion_builtin_iterable_items(state, args[0])
            index = 0
            while index < len(lines):
                result = tyrion_call_method(state, receiver, "write", [lines[index]])
                state = result["state"]
                index = index + 1
            return {"state": state, "value": tyrion_none()}
        if name == "tell" and len(args) == 0:
            return {"state": state, "value": tyrion_int(file_data["offset"])}
        if name == "truncate" and len(args) <= 1:
            size = file_data["offset"]
            if len(args) == 1:
                size = args[0]["value"]
            with open(file_data["path"], "r") as input_file:
                file_text = input_file.read()
            with open(file_data["path"], "w") as output_file:
                output_file.write(file_text[:size])
            return {"state": state, "value": tyrion_int(size)}
        if name == "readable" and len(args) == 0:
            return {"state": state, "value": tyrion_bool(tyrion_text_contains(file_data["mode"], "r") or tyrion_text_contains(file_data["mode"], "+"))}
        if name == "writable" and len(args) == 0:
            writable = tyrion_text_contains(file_data["mode"], "w") or tyrion_text_contains(file_data["mode"], "a") or tyrion_text_contains(file_data["mode"], "x") or tyrion_text_contains(file_data["mode"], "+")
            return {"state": state, "value": tyrion_bool(writable)}
        if name == "seekable" and len(args) == 0:
            return {"state": state, "value": tyrion_bool(True)}
        if name == "isatty" and len(args) == 0:
            return {"state": state, "value": tyrion_bool(False)}
        if name == "close" and len(args) == 0:
            file_data["closed"] = True
            object_value["items"] = file_data
            state = tyrion_heap_set(state, receiver, object_value)
            return {"state": state, "value": tyrion_none()}
        if name == "flush" and len(args) == 0:
            return {"state": state, "value": tyrion_none()}
        if name == "seek" and (len(args) == 1 or len(args) == 2):
            file_offset = args[0]["value"]
            file_whence = 0
            if len(args) == 2:
                file_whence = args[1]["value"]
            if file_whence == 0:
                if file_offset < 0:
                    file_offset = 0
                file_data["offset"] = file_offset
            elif file_whence == 1:
                file_data["offset"] = file_data["offset"] + file_offset
                if file_data["offset"] < 0:
                    file_data["offset"] = 0
            object_value["items"] = file_data
            state = tyrion_heap_set(state, receiver, object_value)
            return {"state": state, "value": tyrion_none()}
        raise "AttributeError: unsupported file method " + name
    if name == "append":
        if not receiver["kind"] in ["list", "bytearray"] or len(args) != 1:
            raise "TypeError: append expects a list receiver and one argument"
        if receiver["kind"] == "bytearray" and (args[0]["kind"] != "int" or args[0]["value"] < 0 or args[0]["value"] > 255):
            raise "ValueError: byte must be in range(0, 256)"
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        items.append(args[0])
        object_value["items"] = items
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": receiver}
    if receiver["kind"] == "list" and name == "extend" and len(args) == 1:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        extra = tyrion_collection_items(state, args[0])
        index = 0
        while index < len(extra):
            items.append(extra[index])
            index = index + 1
        object_value["items"] = items
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": receiver}
    if receiver["kind"] == "list" and name == "insert" and len(args) == 2:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        insert_at = args[0]["value"]
        if insert_at < 0:
            insert_at = len(items) + insert_at
        if insert_at < 0:
            insert_at = 0
        if insert_at > len(items):
            insert_at = len(items)
        out = []
        index = 0
        while index < len(items):
            if index == insert_at:
                out.append(args[1])
            out.append(items[index])
            index = index + 1
        if insert_at == len(items):
            out.append(args[1])
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": receiver}
    if receiver["kind"] == "list" and name == "pop" and len(args) <= 1:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        if len(items) == 0:
            raise "IndexError: pop from empty list"
        pop_at = len(items) - 1
        if len(args) == 1:
            pop_at = tyrion_index_normalize(len(items), args[0]["value"])
        if pop_at < 0 or pop_at >= len(items):
            raise "IndexError: pop index out of range"
        value = items[pop_at]
        out = []
        index = 0
        while index < len(items):
            if index != pop_at:
                out.append(items[index])
            index = index + 1
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": value}
    if receiver["kind"] == "list" and name == "clear" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        object_value["items"] = []
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "list" and name == "copy" and len(args) == 0:
        items = tyrion_heap_get(state, receiver)["items"]
        out = []
        index = 0
        while index < len(items):
            out.append(items[index])
            index = index + 1
        return tyrion_heap_alloc(state, "list", out)
    if receiver["kind"] == "list" and name == "reverse" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        out = []
        index = len(items)
        while index > 0:
            index = index - 1
            out.append(items[index])
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] in ["list", "tuple"] and name == "count" and len(args) == 1:
        items = tyrion_collection_items(state, receiver)
        count = 0
        index = 0
        while index < len(items):
            if tyrion_value_equal(state, items[index], args[0]):
                count = count + 1
            index = index + 1
        return {"state": state, "value": tyrion_int(count)}
    if receiver["kind"] in ["list", "tuple"] and name == "index" and len(args) >= 1 and len(args) <= 3:
        items = tyrion_collection_items(state, receiver)
        start = 0
        stop = len(items)
        if len(args) >= 2:
            start = args[1]["value"]
        if len(args) == 3:
            stop = args[2]["value"]
        found = tyrion_sequence_find(state, items, args[0], start, stop)
        if found < 0:
            raise "ValueError: value is not in sequence"
        return {"state": state, "value": tyrion_int(found)}
    if receiver["kind"] == "range" and name == "count" and len(args) == 1:
        items = tyrion_collection_items(state, receiver)
        count = 0
        if tyrion_set_contains(state, items, args[0]):
            count = 1
        return {"state": state, "value": tyrion_int(count)}
    if receiver["kind"] == "range" and name == "index" and len(args) == 1:
        items = tyrion_collection_items(state, receiver)
        found = tyrion_sequence_find(state, items, args[0], 0, len(items))
        if found < 0:
            raise "ValueError: value is not in range"
        return {"state": state, "value": tyrion_int(found)}
    if receiver["kind"] == "list" and name == "sort" and len(args) <= 2:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        reverse = False
        if len(args) == 1:
            if args[0]["kind"] != "bool":
                raise "TypeError: sort positional argument must be bool reverse"
            reverse = args[0]["value"]
        keyword_index = 0
        while keyword_index < len(kwargs):
            keyword = kwargs[keyword_index]
            if keyword["name"] == "reverse":
                if keyword["value"]["kind"] != "bool":
                    raise "TypeError: sort reverse must be bool"
                reverse = keyword["value"]["value"]
            elif keyword["name"] != "key":
                raise "TypeError: sort unexpected keyword argument"
            keyword_index = keyword_index + 1
        left = 0
        while left < len(items):
            right = left + 1
            while right < len(items):
                should_swap = items[right]["value"] < items[left]["value"]
                if reverse:
                    should_swap = items[left]["value"] < items[right]["value"]
                if should_swap:
                    swap = items[left]
                    items[left] = items[right]
                    items[right] = swap
                right = right + 1
            left = left + 1
        object_value["items"] = items
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if name == "add":
        if receiver["kind"] != "set" or len(args) != 1:
            raise "TypeError: add expects a set receiver and one argument"
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        found = False
        index = 0
        while index < len(items):
            if tyrion_value_equal(state, items[index], args[0]):
                found = True
            index = index + 1
        if not found:
            items.append(args[0])
        object_value["items"] = items
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": receiver}
    if name == "remove":
        if not receiver["kind"] in ["list", "set"] or len(args) != 1:
            raise "TypeError: remove expects a collection receiver and one argument"
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        out = []
        removed = False
        index = 0
        while index < len(items):
            if not removed and tyrion_value_equal(state, items[index], args[0]):
                removed = True
            else:
                out.append(items[index])
            index = index + 1
        if not removed:
            raise "ValueError: value is not present"
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": receiver}
    if receiver["kind"] == "set" and name == "discard" and len(args) == 1:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        out = []
        index = 0
        while index < len(items):
            if not tyrion_value_equal(state, items[index], args[0]):
                out.append(items[index])
            index = index + 1
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "set" and name == "pop" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        items = object_value["items"]
        if len(items) == 0:
            raise "KeyError: pop from an empty set"
        value = items[len(items) - 1]
        object_value["items"] = items[:len(items) - 1]
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": value}
    if receiver["kind"] == "set" and name == "clear" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        object_value["items"] = []
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "set" and name == "copy" and len(args) == 0:
        source = tyrion_heap_get(state, receiver)["items"]
        out = []
        index = 0
        while index < len(source):
            out.append(source[index])
            index = index + 1
        return tyrion_heap_alloc(state, "set", out)
    if receiver["kind"] == "set" and name in ["union", "intersection", "difference", "symmetric_difference"] and len(args) == 1:
        right = tyrion_collection_items(state, args[0])
        out = tyrion_set_result(state, tyrion_heap_get(state, receiver)["items"], right, name)
        return tyrion_heap_alloc(state, "set", out)
    if receiver["kind"] == "set" and name in ["update", "intersection_update", "difference_update", "symmetric_difference_update"] and len(args) == 1:
        operation = name
        if name == "update":
            operation = "union"
        elif name == "intersection_update":
            operation = "intersection"
        elif name == "difference_update":
            operation = "difference"
        else:
            operation = "symmetric_difference"
        object_value = tyrion_heap_get(state, receiver)
        object_value["items"] = tyrion_set_result(state, object_value["items"], tyrion_collection_items(state, args[0]), operation)
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "set" and name in ["isdisjoint", "issubset", "issuperset"] and len(args) == 1:
        left = tyrion_heap_get(state, receiver)["items"]
        right = tyrion_collection_items(state, args[0])
        result = True
        if name == "isdisjoint":
            index = 0
            while index < len(left):
                if tyrion_set_contains(state, right, left[index]):
                    result = False
                index = index + 1
        elif name == "issubset":
            index = 0
            while index < len(left):
                if not tyrion_set_contains(state, right, left[index]):
                    result = False
                index = index + 1
        else:
            index = 0
            while index < len(right):
                if not tyrion_set_contains(state, left, right[index]):
                    result = False
                index = index + 1
        return {"state": state, "value": tyrion_bool(result)}
    if name == "keys" or name == "items" or name == "values":
        if receiver["kind"] != "dict" or len(args) != 0:
            raise "TypeError: " + name + " expects a dictionary receiver"
        entries = tyrion_heap_get(state, receiver)["items"]
        out = []
        index = 0
        while index < len(entries):
            if name == "keys":
                out.append(entries[index]["key"])
            elif name == "values":
                out.append(entries[index]["value"])
            else:
                pair = tyrion_heap_alloc(state, "list", [entries[index]["key"], entries[index]["value"]])
                state = pair["state"]
                out.append(pair["value"])
            index = index + 1
        return tyrion_heap_alloc(state, "list", out)
    if receiver["kind"] == "dict" and name == "get" and (len(args) == 1 or len(args) == 2):
        found = tyrion_dict_find(state, receiver, args[0])
        if found >= 0:
            return {"state": state, "value": tyrion_heap_get(state, receiver)["items"][found]["value"]}
        if len(args) == 2:
            return {"state": state, "value": args[1]}
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "dict" and name == "setdefault" and (len(args) == 1 or len(args) == 2):
        found = tyrion_dict_find(state, receiver, args[0])
        if found >= 0:
            return {"state": state, "value": tyrion_heap_get(state, receiver)["items"][found]["value"]}
        value = tyrion_none()
        if len(args) == 2:
            value = args[1]
        state = tyrion_dict_set(state, receiver, args[0], value)
        return {"state": state, "value": value}
    if receiver["kind"] == "dict" and name == "update" and len(args) <= 1:
        if len(args) == 1:
            if args[0]["kind"] != "dict":
                raise "TypeError: update expects a dictionary"
            entries = tyrion_heap_get(state, args[0])["items"]
            index = 0
            while index < len(entries):
                state = tyrion_dict_set(state, receiver, entries[index]["key"], entries[index]["value"])
                index = index + 1
        keyword_index = 0
        while keyword_index < len(kwargs):
            state = tyrion_dict_set(state, receiver, tyrion_string(kwargs[keyword_index]["name"]), kwargs[keyword_index]["value"])
            keyword_index = keyword_index + 1
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "dict" and name == "pop" and (len(args) == 1 or len(args) == 2):
        object_value = tyrion_heap_get(state, receiver)
        entries = object_value["items"]
        found = tyrion_dict_find(state, receiver, args[0])
        if found < 0:
            if len(args) == 2:
                return {"state": state, "value": args[1]}
            raise "KeyError: " + tyrion_value_text(state, args[0])
        value = entries[found]["value"]
        out = []
        index = 0
        while index < len(entries):
            if index != found:
                out.append(entries[index])
            index = index + 1
        object_value["items"] = out
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": value}
    if receiver["kind"] == "dict" and name == "popitem" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        entries = object_value["items"]
        if len(entries) == 0:
            raise "KeyError: popitem from empty dictionary"
        last = entries[len(entries) - 1]
        object_value["items"] = entries[:len(entries) - 1]
        state = tyrion_heap_set(state, receiver, object_value)
        return tyrion_heap_alloc(state, "tuple", [last["key"], last["value"]])
    if receiver["kind"] == "dict" and name == "clear" and len(args) == 0:
        object_value = tyrion_heap_get(state, receiver)
        object_value["items"] = []
        state = tyrion_heap_set(state, receiver, object_value)
        return {"state": state, "value": tyrion_none()}
    if receiver["kind"] == "dict" and name == "copy" and len(args) == 0:
        entries = tyrion_heap_get(state, receiver)["items"]
        out = []
        index = 0
        while index < len(entries):
            out.append({"key": entries[index]["key"], "value": entries[index]["value"]})
            index = index + 1
        return tyrion_heap_alloc(state, "dict", out)
    if receiver["kind"] == "string":
        text = receiver["value"]
        if name == "strip" or name == "lstrip" or name == "rstrip":
            if len(args) > 1:
                raise "TypeError: " + name + " expects zero or one argument"
            chars = " \t\r\n"
            if len(args) == 1:
                chars = args[0]["value"]
            return {"state": state, "value": tyrion_string(tyrion_string_trim(text, chars, name != "rstrip", name != "lstrip"))}
        if name == "lower" and len(args) == 0:
            return {"state": state, "value": tyrion_string(tyrion_string_case(text, False))}
        if name == "upper" and len(args) == 0:
            return {"state": state, "value": tyrion_string(tyrion_string_case(text, True))}
        if name in ["capitalize", "title", "swapcase"] and len(args) == 0:
            out = ""
            word_start = True
            index = 0
            while index < len(text):
                character = text[index]
                if name == "swapcase":
                    if tyrion_text_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", character):
                        character = tyrion_string_case(character, False)
                    elif tyrion_text_contains("abcdefghijklmnopqrstuvwxyz", character):
                        character = tyrion_string_case(character, True)
                elif name == "capitalize":
                    character = tyrion_string_case(character, index == 0)
                else:
                    character = tyrion_string_case(character, word_start)
                    word_start = not tyrion_ascii_letter(character) and not tyrion_ascii_digit(character)
                out = out + character
                index = index + 1
            return {"state": state, "value": tyrion_string(out)}
        if name in ["center", "ljust", "rjust"] and (len(args) == 1 or len(args) == 2):
            width = args[0]["value"]
            fill = " "
            if len(args) == 2:
                fill = args[1]["value"]
            if len(fill) != 1:
                raise "TypeError: fill character must be exactly one character"
            remaining = width - len(text)
            left = 0
            right = 0
            if remaining > 0:
                if name == "ljust":
                    right = remaining
                elif name == "rjust":
                    left = remaining
                else:
                    left = int(remaining / 2)
                    right = remaining - left
            return {"state": state, "value": tyrion_string(tyrion_string_repeat(fill, left) + text + tyrion_string_repeat(fill, right))}
        if name == "zfill" and len(args) == 1:
            width = args[0]["value"]
            zeros = width - len(text)
            if zeros <= 0:
                return {"state": state, "value": receiver}
            if len(text) > 0 and (text[0] == "+" or text[0] == "-"):
                return {"state": state, "value": tyrion_string(text[0] + tyrion_string_repeat("0", zeros) + text[1:])}
            return {"state": state, "value": tyrion_string(tyrion_string_repeat("0", zeros) + text)}
        if name in ["isalnum", "isalpha", "isascii", "isdecimal", "isdigit", "islower", "isnumeric", "isprintable", "isspace", "isupper"] and len(args) == 0:
            return {"state": state, "value": tyrion_bool(tyrion_string_classify(text, name))}
        if name == "join" and len(args) == 1:
            return {"state": state, "value": tyrion_string(tyrion_string_join_values(state, text, tyrion_collection_items(state, args[0])))}
        if name == "find" or name == "rfind" or name == "index" or name == "rindex":
            if len(args) < 1 or len(args) > 3:
                raise "TypeError: " + name + " expects one to three arguments"
            start = 0
            stop = len(text)
            if len(args) >= 2:
                start = args[1]["value"]
            if len(args) == 3:
                stop = args[2]["value"]
            found = tyrion_string_find(text, args[0]["value"], start, stop, name == "rfind" or name == "rindex")
            if found < 0 and (name == "index" or name == "rindex"):
                raise "ValueError: substring not found"
            return {"state": state, "value": tyrion_int(found)}
        if name == "count" and len(args) >= 1 and len(args) <= 3:
            start = 0
            stop = len(text)
            if len(args) >= 2:
                start = args[1]["value"]
            if len(args) == 3:
                stop = args[2]["value"]
            count = 0
            index = start
            needle = args[0]["value"]
            while index + len(needle) <= stop:
                if text[index:index + len(needle)] == needle:
                    count = count + 1
                    index = index + len(needle)
                else:
                    index = index + 1
            return {"state": state, "value": tyrion_int(count)}
        if name == "replace" and (len(args) == 2 or len(args) == 3):
            old = args[0]["value"]
            replacement = args[1]["value"]
            limit = -1
            if len(args) == 3:
                limit = args[2]["value"]
            if old == "":
                raise "ValueError: empty replacement pattern is not supported yet"
            out = ""
            start = 0
            replaced = 0
            found = tyrion_string_find(text, old, start, len(text), False)
            while found >= 0 and (limit < 0 or replaced < limit):
                out = out + text[start:found] + replacement
                start = found + len(old)
                replaced = replaced + 1
                found = tyrion_string_find(text, old, start, len(text), False)
            return {"state": state, "value": tyrion_string(out + text[start:])}
        if (name == "removeprefix" or name == "removesuffix") and len(args) == 1:
            affix = args[0]["value"]
            if name == "removeprefix" and tyrion_string_find(text, affix, 0, len(text), False) == 0:
                return {"state": state, "value": tyrion_string(text[len(affix):])}
            if name == "removesuffix" and len(affix) <= len(text) and text[len(text) - len(affix):] == affix:
                return {"state": state, "value": tyrion_string(text[:len(text) - len(affix)])}
            return {"state": state, "value": receiver}
        if (name == "partition" or name == "rpartition") and len(args) == 1:
            separator = args[0]["value"]
            found = tyrion_string_find(text, separator, 0, len(text), name == "rpartition")
            if found < 0:
                if name == "partition":
                    return tyrion_heap_alloc(state, "tuple", [receiver, tyrion_string(""), tyrion_string("")])
                return tyrion_heap_alloc(state, "tuple", [tyrion_string(""), tyrion_string(""), receiver])
            return tyrion_heap_alloc(state, "tuple", [tyrion_string(text[:found]), args[0], tyrion_string(text[found + len(separator):])])
        if (name == "startswith" or name == "endswith") and len(args) >= 1 and len(args) <= 3:
            start = 0
            stop = len(text)
            if len(args) >= 2:
                start = args[1]["value"]
            if len(args) == 3:
                stop = args[2]["value"]
            bounded = text[start:stop]
            prefixes = [args[0]]
            if args[0]["kind"] == "tuple" or args[0]["kind"] == "list":
                prefixes = tyrion_collection_items(state, args[0])
            result = False
            index = 0
            while index < len(prefixes):
                pattern = prefixes[index]["value"]
                if name == "startswith" and len(pattern) <= len(bounded) and bounded[0:len(pattern)] == pattern:
                    result = True
                if name == "endswith" and len(pattern) <= len(bounded) and bounded[len(bounded) - len(pattern):] == pattern:
                    result = True
                index = index + 1
            return {"state": state, "value": tyrion_bool(result)}
        if (name == "split" or name == "rsplit") and len(args) <= 2:
            separator = ""
            whitespace = True
            maxsplit = -1
            if len(args) >= 1 and args[0]["kind"] != "none":
                separator = args[0]["value"]
                whitespace = False
                if separator == "":
                    raise "ValueError: empty separator"
            if len(args) == 2:
                maxsplit = args[1]["value"]
            parts = tyrion_string_split_values(text, separator, maxsplit, name == "rsplit", whitespace)
            return tyrion_heap_alloc(state, "list", parts)
        if name == "splitlines" and len(args) <= 1:
            keepends = False
            if len(args) == 1:
                keepends = tyrion_truthy(state, args[0])
            parts = []
            start = 0
            index = 0
            while index < len(text):
                if text[index] == "\n":
                    stop = index
                    if stop > start and text[stop - 1] == "\r" and not keepends:
                        stop = stop - 1
                    if keepends:
                        stop = index + 1
                    parts.append(tyrion_string(text[start:stop]))
                    start = index + 1
                index = index + 1
            if start < len(text):
                parts.append(tyrion_string(text[start:]))
            return tyrion_heap_alloc(state, "list", parts)
        if name == "expandtabs" and len(args) <= 1:
            tabsize = 8
            if len(args) == 1:
                tabsize = args[0]["value"]
            out = ""
            column = 0
            index = 0
            while index < len(text):
                if text[index] == "\t":
                    spaces = tabsize - column % tabsize
                    out = out + tyrion_string_repeat(" ", spaces)
                    column = column + spaces
                else:
                    out = out + text[index]
                    if text[index] == "\n" or text[index] == "\r":
                        column = 0
                    else:
                        column = column + 1
                index = index + 1
            return {"state": state, "value": tyrion_string(out)}
    raise "AttributeError: unsupported method " + name


def tyrion_builtin_keyword(kwargs, name, fallback):
    value = fallback
    index = 0
    while index < len(kwargs):
        if kwargs[index]["name"] == name:
            value = kwargs[index]["value"]
        index = index + 1
    return value


def tyrion_builtin_iterable_items(state, value):
    if value["kind"] == "string":
        out = []
        index = 0
        while index < len(value["value"]):
            out.append(tyrion_string(value["value"][index]))
            index = index + 1
        return out
    return tyrion_collection_items(state, value)


def tyrion_builtin_enumerate(state, args, kwargs):
    if len(args) < 1 or len(args) > 2:
        raise "TypeError: enumerate expects one or two arguments"
    start_value = tyrion_int(0)
    if len(args) == 2:
        start_value = args[1]
    start_value = tyrion_builtin_keyword(kwargs, "start", start_value)
    source = tyrion_builtin_iterable_items(state, args[0])
    out = []
    index = 0
    while index < len(source):
        pair = tyrion_heap_alloc(state, "list", [tyrion_int(start_value["value"] + index), source[index]])
        state = pair["state"]
        out.append(pair["value"])
        index = index + 1
    return tyrion_heap_alloc(state, "list", out)


def tyrion_builtin_zip(state, args, kwargs):
    strict_value = tyrion_builtin_keyword(kwargs, "strict", tyrion_bool(False))
    strict = tyrion_truthy(state, strict_value)
    values = []
    index = 0
    while index < len(args):
        values.append(tyrion_collection_items(state, args[index]))
        index = index + 1
    if strict and len(values) > 1:
        expected = len(values[0])
        index = 1
        while index < len(values):
            if len(values[index]) != expected:
                raise "ValueError: zip() argument lengths differ"
            index = index + 1
    out = []
    count = 0
    if len(values) > 0:
        count = len(values[0])
        index = 1
        while index < len(values):
            if len(values[index]) < count:
                count = len(values[index])
            index = index + 1
    index = 0
    while index < count:
        row = []
        value_index = 0
        while value_index < len(values):
            row.append(values[value_index][index])
            value_index = value_index + 1
        pair = tyrion_heap_alloc(state, "list", row)
        state = pair["state"]
        out.append(pair["value"])
        index = index + 1
    return tyrion_heap_alloc(state, "list", out)


def tyrion_builtin_minmax(state, name, args):
    items = args
    if len(args) == 1 and args[0]["kind"] in ["list", "tuple"]:
        items = tyrion_collection_items(state, args[0])
    if len(items) == 0:
        raise "ValueError: " + name + " expects at least one value"
    best = items[0]
    index = 1
    while index < len(items):
        better = items[index]["value"] < best["value"]
        if name == "max":
            better = items[index]["value"] > best["value"]
        if better:
            best = items[index]
        index = index + 1
    return {"state": state, "value": best}


def tyrion_builtin_sorted(state, args):
    if len(args) != 1 or args[0]["kind"] != "list":
        raise "TypeError: sorted expects one list argument"
    source = tyrion_collection_items(state, args[0])
    out = []
    index = 0
    while index < len(source):
        out.append(source[index])
        index = index + 1
    left = 0
    while left < len(out):
        right = left + 1
        while right < len(out):
            if out[right]["value"] < out[left]["value"]:
                swap = out[left]
                out[left] = out[right]
                out[right] = swap
            right = right + 1
        left = left + 1
    return tyrion_heap_alloc(state, "list", out)


def tyrion_builtin_tcp(state, name, args):
    if name == "__tyrion_native_tcp_connect" or name == "std_io_tcp_connect":
        if len(args) != 3 or args[0]["kind"] != "string" or args[1]["kind"] != "int" or args[2]["kind"] != "int":
            raise "TypeError: tcp_connect expects host, port, and timeout"
        handle = std_io_tcp_connect(args[0]["value"], args[1]["value"], args[2]["value"])
        return {"state": state, "value": tyrion_int(handle)}
    if name == "__tyrion_native_tcp_write" or name == "std_io_tcp_write":
        if len(args) != 3 or args[0]["kind"] != "int" or not args[1]["kind"] in ["list", "bytes"] or args[2]["kind"] != "int":
            raise "TypeError: tcp_write expects handle, byte list, and timeout"
        raw_bytes = []
        if args[1]["kind"] == "bytes":
            raw_bytes = tyrion_bytes_flatten(args[1])
        else:
            boxed_bytes = tyrion_collection_items(state, args[1])
            raw_bytes = range(len(boxed_bytes))
            index = 0
            while index < len(boxed_bytes):
                if boxed_bytes[index]["kind"] != "int" or boxed_bytes[index]["value"] < 0 or boxed_bytes[index]["value"] > 255:
                    raise "ValueError: tcp byte is outside 0..255"
                raw_bytes[index] = boxed_bytes[index]["value"]
                index = index + 1
        written = std_io_tcp_write(args[0]["value"], raw_bytes, args[2]["value"])
        return {"state": state, "value": tyrion_int(written)}
    if name == "__tyrion_native_tcp_read" or name == "std_io_tcp_read":
        if len(args) != 3 or args[0]["kind"] != "int" or args[1]["kind"] != "int" or args[2]["kind"] != "int":
            raise "TypeError: tcp_read expects handle, count, and timeout"
        raw_bytes = std_io_tcp_read(args[0]["value"], args[1]["value"], args[2]["value"])
        if raw_bytes == none:
            return {"state": state, "value": tyrion_none()}
        return {"state": state, "value": tyrion_bytes(raw_bytes)}
    if len(args) != 1 or args[0]["kind"] != "int":
        raise "TypeError: tcp_close expects one handle"
    std_io_tcp_close(args[0]["value"])
    return {"state": state, "value": tyrion_none()}


def tyrion_builtin_tls(state, name, args):
    if len(args) != 3 or args[0]["kind"] != "int" or args[2]["kind"] != "int":
        raise "TypeError: TLS I/O expects session, payload/count, and timeout"
    if name == "__tyrion_native_tls_write":
        if not args[1]["kind"] in ["list", "bytes"]:
            raise "TypeError: TLS write expects a byte list"
        raw_bytes = []
        if args[1]["kind"] == "bytes":
            raw_bytes = tyrion_bytes_flatten(args[1])
        else:
            boxed_bytes = tyrion_collection_items(state, args[1])
            raw_bytes = range(len(boxed_bytes))
            index = 0
            while index < len(boxed_bytes):
                if boxed_bytes[index]["kind"] != "int" or boxed_bytes[index]["value"] < 0 or boxed_bytes[index]["value"] > 255:
                    raise "ValueError: TLS byte is outside 0..255"
                raw_bytes[index] = boxed_bytes[index]["value"]
                index = index + 1
        written = __tyrion_native_tls_write(args[0]["value"], raw_bytes, args[2]["value"])
        return {"state": state, "value": tyrion_int(written)}
    if args[1]["kind"] != "int":
        raise "TypeError: TLS read expects a byte count"
    raw_bytes = __tyrion_native_tls_read(args[0]["value"], args[1]["value"], args[2]["value"])
    if raw_bytes == none:
        return {"state": state, "value": tyrion_none()}
    return {"state": state, "value": tyrion_bytes(raw_bytes)}


def tyrion_builtin_ascii_text(state, args):
    if len(args) != 1 or not args[0]["kind"] in ["list", "bytes"]:
        raise "TypeError: ASCII conversion expects one byte list"
    if args[0]["kind"] == "bytes":
        text = __tyrion_native_ascii_text(tyrion_bytes_flatten(args[0]))
        if text == none:
            return {"state": state, "value": tyrion_none()}
        return {"state": state, "value": tyrion_string(text)}
    boxed_bytes = tyrion_collection_items(state, args[0])
    raw_bytes = range(len(boxed_bytes))
    index = 0
    while index < len(boxed_bytes):
        if boxed_bytes[index]["kind"] != "int":
            return {"state": state, "value": tyrion_none()}
        raw_bytes[index] = boxed_bytes[index]["value"]
        index = index + 1
    text = __tyrion_native_ascii_text(raw_bytes)
    if text == none:
        return {"state": state, "value": tyrion_none()}
    return {"state": state, "value": tyrion_string(text)}


def tyrion_builtin_process(state, name, args):
    if name == "run_tool":
        if len(args) != 4:
            raise "TypeError: run_tool expects four arguments"
        command = tyrion_value_text(state, args[0])
        native_args = [tyrion_value_text(state, args[1]), tyrion_value_text(state, args[2]), tyrion_value_text(state, args[3])]
        result = __tyrion_run_tool(command, native_args)
        return {"state": state, "value": tyrion_bool(result["ok"])}
    if len(args) != 2 or args[1]["kind"] != "list":
        raise "TypeError: __tyrion_run_tool expects command and argument list"
    command = tyrion_value_text(state, args[0])
    boxed_args = tyrion_collection_items(state, args[1])
    native_args = []
    index = 0
    while index < len(boxed_args):
        native_args.append(tyrion_value_text(state, boxed_args[index]))
        index = index + 1
    result = __tyrion_run_tool(command, native_args)
    entries = []
    entries.append({"key": tyrion_string("ok"), "value": tyrion_bool(result["ok"])})
    entries.append({"key": tyrion_string("status"), "value": tyrion_int(result["status"])})
    entries.append({"key": tyrion_string("stdout"), "value": tyrion_string(result["stdout"])})
    entries.append({"key": tyrion_string("stderr"), "value": tyrion_string(result["stderr"])})
    return tyrion_heap_alloc(state, "dict", entries)


def tyrion_builtin_extension(state, name, args):
    if name == "__tyrion_native_host_load":
        if len(args) != 1:
            raise "TypeError: __tyrion_native_host_load expects one name"
        extension_name = tyrion_value_text(state, args[0])
        return {"state": state, "value": tyrion_extension(__tyrion_native_host_load(extension_name))}
    if name == "__tyrion_native_host_call":
        if len(args) != 3 or args[0]["kind"] != "extension":
            raise "TypeError: __tyrion_native_host_call expects extension, operation, and payload"
        operation = tyrion_value_text(state, args[1])
        payload = tyrion_value_text(state, args[2])
        result = __tyrion_native_host_call(args[0]["value"], operation, payload)
        if result == none:
            return {"state": state, "value": tyrion_none()}
        return {"state": state, "value": tyrion_string(result)}
    if len(args) != 1 or args[0]["kind"] != "extension":
        raise "TypeError: __tyrion_native_host_unload expects one extension"
    result = __tyrion_native_host_unload(args[0]["value"])
    return {"state": state, "value": tyrion_bool(result)}


def tyrion_call_builtin(state, name, args, kwargs):
    if name == "__tyrion_dict_fromkeys":
        if len(args) != 2:
            raise "TypeError: dict.fromkeys expects one or two arguments"
        entries = []
        for key in tyrion_builtin_iterable_items(state, args[0]):
            entries.append({"key": key, "value": args[1]})
        return tyrion_heap_alloc(state, "dict", entries)
    if name == "__tyrion_native_ascii_text":
        return tyrion_builtin_ascii_text(state, args)
    if name == "run_tool" or name == "__tyrion_run_tool":
        return tyrion_builtin_process(state, name, args)
    if name == "__tyrion_native_host_load" or name == "__tyrion_native_host_call" or name == "__tyrion_native_host_unload":
        return tyrion_builtin_extension(state, name, args)
    if name in ["__tyrion_native_tcp_close", "__tyrion_native_tcp_connect", "__tyrion_native_tcp_read", "__tyrion_native_tcp_write", "std_io_tcp_close", "std_io_tcp_connect", "std_io_tcp_read", "std_io_tcp_write"]:
        return tyrion_builtin_tcp(state, name, args)
    if name == "__tyrion_native_tls_read" or name == "__tyrion_native_tls_write":
        return tyrion_builtin_tls(state, name, args)
    if name == "time" or name == "__tyrion_native_wall_time":
        if len(args) != 0:
            raise "TypeError: " + name + " expects no arguments"
        return {"state": state, "value": tyrion_int(int(time()))}
    if name == "print":
        return tyrion_builtin_print(state, args, kwargs)
    if name == "input":
        if len(kwargs) != 0:
            raise "TypeError: input() takes no keyword arguments"
        if len(args) > 1:
            raise "TypeError: input expected at most 1 argument, got " + str(len(args))
        if len(args) == 1:
            text = input(tyrion_value_text(state, args[0]))
        else:
            text = input()
        return {"state": state, "value": tyrion_string(text)}
    if name == "type":
        if len(args) != 1:
            raise "TypeError: type expects one argument"
        return {"state": state, "value": tyrion_string(tyrion_type_name(state, args[0]))}
    if name == "isinstance":
        if len(args) != 2:
            raise "TypeError: isinstance expects two arguments"
        return {"state": state, "value": tyrion_bool(tyrion_isinstance_value(state, args[0], args[1]))}
    if name == "callable":
        if len(args) != 1:
            raise "TypeError: callable expects one argument"
        return {"state": state, "value": tyrion_bool(args[0]["kind"] in ["builtin", "function", "lambda", "bound_method", "object_method", "class"])}
    if name == "iter":
        if len(args) != 1:
            raise "TypeError: iter expects one argument"
        if args[0]["kind"] == "iterator":
            return {"state": state, "value": args[0]}
        items = tyrion_builtin_iterable_items(state, args[0])
        return tyrion_heap_alloc(state, "iterator", {"items": items, "index": 0})
    if name == "next":
        if len(args) < 1 or len(args) > 2 or args[0]["kind"] != "iterator":
            raise "TypeError: next expects an iterator and optional default"
        iterator_record = tyrion_heap_get(state, args[0])
        iterator_data = iterator_record["items"]
        if iterator_data["index"] >= len(iterator_data["items"]):
            if len(args) == 2:
                return {"state": state, "value": args[1]}
            raise "StopIteration"
        value = iterator_data["items"][iterator_data["index"]]
        iterator_data["index"] = iterator_data["index"] + 1
        iterator_record["items"] = iterator_data
        state = tyrion_heap_set(state, args[0], iterator_record)
        return {"state": state, "value": value}
    if name == "repr" or name == "ascii":
        if len(args) != 1:
            raise "TypeError: " + name + " expects one argument"
        return {"state": state, "value": tyrion_string(tyrion_value_repr(state, args[0]))}
    if name == "format":
        if len(args) < 1 or len(args) > 2:
            raise "TypeError: format expects one or two arguments"
        if len(args) == 2 and args[1]["kind"] == "string" and args[1]["value"] != "":
            raise "ValueError: non-empty format specifications are not supported yet"
        return {"state": state, "value": tyrion_string(tyrion_value_text(state, args[0]))}
    if name == "hasattr" or name == "getattr" or name == "setattr" or name == "delattr":
        if args[0]["kind"] != "object" or args[1]["kind"] != "string":
            raise "TypeError: " + name + " expects an object and attribute name"
        object_value = tyrion_heap_get(state, args[0])
        found = tyrion_object_find_attr(state, args[0], args[1]["value"])
        if name == "hasattr":
            if len(args) != 2:
                raise "TypeError: hasattr expects two arguments"
            return {"state": state, "value": tyrion_bool(found >= 0)}
        if name == "getattr":
            if len(args) < 2 or len(args) > 3:
                raise "TypeError: getattr expects two or three arguments"
            if found >= 0:
                return {"state": state, "value": object_value["items"]["attrs"][found]["value"]}
            if len(args) == 3:
                return {"state": state, "value": args[2]}
            raise "AttributeError: " + args[1]["value"]
        if name == "delattr":
            if len(args) != 2:
                raise "TypeError: delattr expects two arguments"
            if found < 0:
                raise "AttributeError: " + args[1]["value"]
            attrs = object_value["items"]["attrs"]
            remaining = []
            index = 0
            while index < len(attrs):
                if index != found:
                    remaining.append(attrs[index])
                index = index + 1
            object_value["items"]["attrs"] = remaining
            state = tyrion_heap_set(state, args[0], object_value)
            return {"state": state, "value": tyrion_none()}
        if len(args) != 3:
            raise "TypeError: setattr expects three arguments"
        state = tyrion_object_set_attr(state, args[0], args[1]["value"], args[2])
        return {"state": state, "value": tyrion_none()}
    if name == "len":
        if len(args) != 1:
            raise "TypeError: len expects one argument"
        value = args[0]
        if value["kind"] == "string":
            return {"state": state, "value": tyrion_int(len(value["value"]))}
        if value["kind"] == "bytes":
            return {"state": state, "value": tyrion_int(tyrion_bytes_length(value))}
        return {"state": state, "value": tyrion_int(len(tyrion_collection_items(state, value)))}
    if name == "str":
        if len(args) == 0:
            return {"state": state, "value": tyrion_string("")}
        if len(args) != 1:
            raise "TypeError: str expects zero or one argument"
        return {"state": state, "value": tyrion_string(tyrion_value_text(state, args[0]))}
    if name == "int":
        if len(args) == 0:
            return {"state": state, "value": tyrion_int(0)}
        if len(args) == 2:
            if args[0]["kind"] != "string" or args[1]["kind"] != "int":
                raise "TypeError: int with a base expects text and an integer base"
            return {"state": state, "value": tyrion_int(tyrion_parse_int_base(args[0]["value"], args[1]["value"]))}
        if len(args) != 1:
            raise "TypeError: int expects zero, one, or two arguments"
        value = args[0]
        if value["kind"] == "bool":
            if value["value"]:
                return {"state": state, "value": tyrion_int(1)}
            return {"state": state, "value": tyrion_int(0)}
        return {"state": state, "value": tyrion_int(int(value["value"]))}
    if name == "float":
        if len(args) == 0:
            return {"state": state, "value": tyrion_float(0.0)}
        if len(args) != 1:
            raise "TypeError: float expects zero or one argument"
        if args[0]["kind"] == "string":
            return {"state": state, "value": tyrion_float(tyrion_parse_float_text(args[0]["value"]))}
        return {"state": state, "value": tyrion_float(args[0]["value"])}
    if name == "bool":
        if len(args) == 0:
            return {"state": state, "value": tyrion_bool(False)}
        if len(args) != 1:
            raise "TypeError: bool expects zero or one argument"
        return {"state": state, "value": tyrion_bool(tyrion_truthy(state, args[0]))}
    if name == "bytes" or name == "bytearray":
        if len(args) > 1:
            raise "TypeError: " + name + " expects zero or one argument"
        raw = []
        if len(args) == 1 and args[0]["kind"] == "int":
            raw = range(args[0]["value"])
            zero_index = 0
            while zero_index < len(raw):
                raw[zero_index] = 0
                zero_index = zero_index + 1
        elif len(args) == 1 and args[0]["kind"] == "bytes":
            raw = tyrion_bytes_flatten(args[0])
        elif len(args) == 1:
            values = tyrion_builtin_iterable_items(state, args[0])
            index = 0
            while index < len(values):
                if values[index]["kind"] != "int" or values[index]["value"] < 0 or values[index]["value"] > 255:
                    raise "ValueError: bytes must be in range(0, 256)"
                raw.append(values[index]["value"])
                index = index + 1
        if name == "bytes":
            return {"state": state, "value": tyrion_bytes(raw)}
        boxed = []
        index = 0
        while index < len(raw):
            boxed.append(tyrion_int(raw[index]))
            index = index + 1
        return tyrion_heap_alloc(state, "bytearray", boxed)
    if name == "tuple" or name == "set" or name == "dict":
        if len(args) > 1:
            raise "TypeError: " + name + " expects zero or one argument"
        source = []
        if len(args) == 1:
            source = tyrion_builtin_iterable_items(state, args[0])
        if name == "tuple":
            return tyrion_heap_alloc(state, "tuple", source)
        if name == "set":
            unique = []
            index = 0
            while index < len(source):
                if not tyrion_set_contains(state, unique, source[index]):
                    unique.append(source[index])
                index = index + 1
            return tyrion_heap_alloc(state, "set", unique)
        entries = []
        if len(args) == 1 and args[0]["kind"] == "dict":
            existing = tyrion_heap_get(state, args[0])["items"]
            index = 0
            while index < len(existing):
                entries.append({"key": existing[index]["key"], "value": existing[index]["value"]})
                index = index + 1
        elif len(args) == 1:
            index = 0
            while index < len(source):
                pair = tyrion_collection_items(state, source[index])
                if len(pair) != 2:
                    raise "ValueError: dictionary update sequence element must have length 2"
                entries.append({"key": pair[0], "value": pair[1]})
                index = index + 1
        keyword_index = 0
        while keyword_index < len(kwargs):
            entries.append({"key": tyrion_string(kwargs[keyword_index]["name"]), "value": kwargs[keyword_index]["value"]})
            keyword_index = keyword_index + 1
        return tyrion_heap_alloc(state, "dict", entries)
    if name == "range":
        return tyrion_builtin_range(state, args)
    if name == "enumerate":
        return tyrion_builtin_enumerate(state, args, kwargs)
    if name == "zip":
        return tyrion_builtin_zip(state, args, kwargs)
    if name == "sum":
        total = tyrion_int(0)
        items = tyrion_collection_items(state, args[0])
        index = 0
        while index < len(items):
            total = tyrion_numeric_result(total, total["value"] + items[index]["value"])
            index = index + 1
        return {"state": state, "value": total}
    if name == "all" or name == "any":
        result_value = name == "all"
        items = tyrion_builtin_iterable_items(state, args[0])
        index = 0
        while index < len(items):
            if name == "all" and not tyrion_truthy(state, items[index]):
                result_value = False
            if name == "any" and tyrion_truthy(state, items[index]):
                result_value = True
            index = index + 1
        return {"state": state, "value": tyrion_bool(result_value)}
    if name == "min" or name == "max":
        return tyrion_builtin_minmax(state, name, args)
    if name == "sorted":
        return tyrion_builtin_sorted(state, args)
    if name == "open":
        if len(args) < 1 or len(args) > 2:
            raise "TypeError: open expects a path and optional mode"
        file_mode = "r"
        if len(args) == 2:
            file_mode = tyrion_value_text(state, args[1])
        return tyrion_heap_alloc(state, "file", {"path": tyrion_value_text(state, args[0]), "mode": file_mode, "offset": 0, "closed": False})
    if name == "argv":
        values = []
        index = 0
        while index < len(state["args"]):
            values.append(tyrion_string(state["args"][index]))
            index = index + 1
        return tyrion_heap_alloc(state, "list", values)
    if name == "ansi_escape":
        if len(args) != 0:
            raise "TypeError: ansi_escape expects no arguments"
        return {"state": state, "value": tyrion_string(ansi_escape())}
    if name == "read_key":
        if len(args) != 0:
            raise "TypeError: read_key expects no arguments"
        return tyrion_host_event_value(state, read_key())
    raise "NotImplementedError: builtin " + name
