# Scalar literal and binary operations shared by the explicit task-stack VM.


def tyrion_eval_result(state, value):
    return {"state": state, "value": value}


def tyrion_numeric_text(text):
    out = ""
    index = 0
    while index < len(text):
        if text[index] != "_":
            out = out + text[index]
        index = index + 1
    return out


def tyrion_parse_float_text(float_text):
    float_text = tyrion_numeric_text(float_text)
    float_sign = 1
    float_index = 0
    if len(float_text) > 0:
        if float_text[0] == "-":
            float_sign = -1
            float_index = 1
        elif float_text[0] == "+":
            float_index = 1
    float_value = 0.0
    float_fractional = False
    float_scale = 1.0
    while float_index < len(float_text):
        float_ch = float_text[float_index]
        if float_ch == ".":
            if float_fractional:
                raise "ValueError: invalid float " + float_text
            float_fractional = True
        else:
            float_digit = int(float_ch)
            if float_fractional:
                float_scale = float_scale * 10
                float_value = float_value + float_digit / float_scale
            else:
                float_value = float_value * 10 + float_digit
        float_index = float_index + 1
    float_result = float_sign * float_value
    return float_result


def tyrion_float_text(float_number):
    float_prefix = ""
    float_absolute = float_number
    if float_absolute < 0.0:
        float_prefix = "-"
        float_absolute = 0.0 - float_absolute
    float_whole = int(float_absolute)
    float_fraction = float_absolute - float_whole
    float_digits = ""
    float_last_nonzero = 0
    float_digit_index = 0
    while float_digit_index < 8:
        float_fraction = float_fraction * 10.0
        float_digit_value = int(float_fraction)
        float_digits = float_digits + str(float_digit_value)
        if float_digit_value != 0:
            float_last_nonzero = float_digit_index + 1
        float_fraction = float_fraction - float_digit_value
        float_digit_index = float_digit_index + 1
    if float_last_nonzero == 0:
        return float_prefix + str(float_whole) + ".0"
    return float_prefix + str(float_whole) + "." + float_digits[:float_last_nonzero]


def tyrion_eval_literal(state, node):
    kind = node["value_kind"]
    if kind == "none":
        return tyrion_eval_result(state, tyrion_none())
    if kind == "bool":
        return tyrion_eval_result(state, tyrion_bool(node["text"] == "True"))
    if kind == "int":
        return tyrion_eval_result(state, tyrion_int(int(tyrion_numeric_text(node["text"]))))
    if kind == "float":
        return tyrion_eval_result(state, tyrion_float(tyrion_parse_float_text(node["text"])))
    if kind == "string":
        return tyrion_eval_result(state, tyrion_string(node["text"]))
    raise "invalid literal kind " + kind


def tyrion_numeric_result(left, value):
    if left["kind"] == "float":
        return tyrion_float(value)
    return tyrion_int(value)


def tyrion_binary_numeric_result(left, right, op):
    if left["kind"] == "float" or right["kind"] == "float":
        left_value = float(left["value"])
        right_value = float(right["value"])
        if op == "+":
            return tyrion_float(left_value + right_value)
        if op == "-":
            return tyrion_float(left_value - right_value)
        if op == "*":
            return tyrion_float(left_value * right_value)
        if op == "%":
            return tyrion_float(left_value % right_value)
    if op == "+":
        return tyrion_int(left["value"] + right["value"])
    if op == "-":
        return tyrion_int(left["value"] - right["value"])
    if op == "*":
        return tyrion_int(left["value"] * right["value"])
    return tyrion_int(left["value"] % right["value"])


def tyrion_binary_contains(state, needle, haystack):
    kind = haystack["kind"]
    if kind == "string":
        return tyrion_text_contains(haystack["value"], needle["value"])
    if kind == "dict":
        return tyrion_dict_find(state, haystack, needle) >= 0
    items = tyrion_collection_items(state, haystack)
    index = 0
    while index < len(items):
        if tyrion_value_equal(state, needle, items[index]):
            return True
        index = index + 1
    return False


def tyrion_bitwise_result(left_value, right_value, op):
    maximum = left_value
    if maximum < 0 - maximum:
        maximum = 0 - maximum
    right_absolute = right_value
    if right_absolute < 0 - right_absolute:
        right_absolute = 0 - right_absolute
    if right_absolute > maximum:
        maximum = right_absolute
    width = 2
    limit = 2
    while limit <= maximum:
        width = width + 1
        limit = limit * 2
    modulus = 1
    index = 0
    while index < width:
        modulus = modulus * 2
        index = index + 1
    left_normal = left_value
    right_normal = right_value
    if left_normal < 0:
        left_normal = left_normal + modulus
    if right_normal < 0:
        right_normal = right_normal + modulus
    result = 0
    power = 1
    index = 0
    while index < width:
        left_bit = int(left_normal / power) % 2
        right_bit = int(right_normal / power) % 2
        bit = 0
        if op == "&":
            if left_bit == 1 and right_bit == 1:
                bit = 1
        elif op == "|":
            if left_bit == 1 or right_bit == 1:
                bit = 1
        elif op == "^":
            if left_bit != right_bit:
                bit = 1
        if bit == 1:
            result = result + power
        power = power * 2
        index = index + 1
    if result >= modulus / 2:
        result = result - modulus
    return result


def tyrion_eval_binary_values(state, op, left, right):
    if op == "==":
        return tyrion_eval_result(state, tyrion_bool(tyrion_value_equal(state, left, right)))
    if op == "!=":
        return tyrion_eval_result(state, tyrion_bool(not tyrion_value_equal(state, left, right)))
    if op == "in" or op == "not in":
        present = tyrion_binary_contains(state, left, right)
        if op == "not in":
            present = not present
        return tyrion_eval_result(state, tyrion_bool(present))
    if op == "+":
        if left["kind"] == "bytes" and right["kind"] == "bytes":
            segments = left["value"]["segments"] + right["value"]["segments"]
            length = tyrion_bytes_length(left) + tyrion_bytes_length(right)
            return tyrion_eval_result(state, tyrion_bytes_from_segments(segments, length))
        if left["kind"] == "string" and right["kind"] == "string":
            return tyrion_eval_result(state, tyrion_string(left["value"] + right["value"]))
        if left["kind"] == "list" and right["kind"] == "list":
            items = tyrion_collection_items(state, left) + tyrion_collection_items(state, right)
            return tyrion_heap_alloc(state, "list", items)
        return tyrion_eval_result(state, tyrion_binary_numeric_result(left, right, "+"))
    if op == "-":
        return tyrion_eval_result(state, tyrion_binary_numeric_result(left, right, "-"))
    if op == "*":
        return tyrion_eval_result(state, tyrion_binary_numeric_result(left, right, "*"))
    if (op == "/" or op == "//" or op == "%") and right["value"] == 0:
        raise "ZeroDivisionError: division by zero"
    if op == "/":
        return tyrion_eval_result(state, tyrion_float(float(left["value"]) / float(right["value"])))
    if op == "//":
        quotient = int(left["value"] / right["value"])
        if quotient * right["value"] != left["value"]:
            if (left["value"] < 0 and right["value"] > 0) or (left["value"] > 0 and right["value"] < 0):
                quotient = quotient - 1
        return tyrion_eval_result(state, tyrion_int(quotient))
    if op == "%":
        return tyrion_eval_result(state, tyrion_binary_numeric_result(left, right, "%"))
    if op == "|" and left["kind"] == "dict" and right["kind"] == "dict":
        entries = []
        left_items = tyrion_heap_get(state, left)["items"]
        right_items = tyrion_heap_get(state, right)["items"]
        index = 0
        while index < len(left_items):
            entries.append({"key": left_items[index]["key"], "value": left_items[index]["value"]})
            index = index + 1
        index = 0
        while index < len(right_items):
            replaced = False
            key_index = 0
            while key_index < len(entries):
                if tyrion_value_equal(state, entries[key_index]["key"], right_items[index]["key"]):
                    entries[key_index] = {"key": right_items[index]["key"], "value": right_items[index]["value"]}
                    replaced = True
                key_index = key_index + 1
            if not replaced:
                entries.append({"key": right_items[index]["key"], "value": right_items[index]["value"]})
            index = index + 1
        return tyrion_heap_alloc(state, "dict", entries)
    if op == "&" or op == "|" or op == "^":
        return tyrion_eval_result(state, tyrion_int(tyrion_bitwise_result(left["value"], right["value"], op)))
    if op == "<<":
        if right["value"] < 0:
            raise "ValueError: negative shift count"
        factor = 1
        shift = 0
        while shift < right["value"]:
            factor = factor * 2
            shift = shift + 1
        return tyrion_eval_result(state, tyrion_int(left["value"] * factor))
    if op == ">>":
        if right["value"] < 0:
            raise "ValueError: negative shift count"
        factor = 1
        shift = 0
        while shift < right["value"]:
            factor = factor * 2
            shift = shift + 1
        quotient = int(left["value"] / factor)
        if left["value"] < 0 and quotient * factor != left["value"]:
            quotient = quotient - 1
        return tyrion_eval_result(state, tyrion_int(quotient))
    if op == "<":
        return tyrion_eval_result(state, tyrion_bool(left["value"] < right["value"]))
    if op == "<=":
        return tyrion_eval_result(state, tyrion_bool(left["value"] <= right["value"]))
    if op == ">":
        return tyrion_eval_result(state, tyrion_bool(left["value"] > right["value"]))
    if op == ">=":
        return tyrion_eval_result(state, tyrion_bool(left["value"] >= right["value"]))
    raise "unsupported binary operator " + op
