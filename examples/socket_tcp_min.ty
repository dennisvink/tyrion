host = "example.com"
port = 80
timeout_ms = 3000

print("connecting", host, port)
handle = __tyrion_native_tcp_connect(host, port, timeout_ms)

request_bytes = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 48, 10, 72, 111, 115, 116, 58, 32, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 10, 10]
written = __tyrion_native_tcp_write(handle, request_bytes, timeout_ms)
print("bytes written", written)

chunk = __tyrion_native_tcp_read(handle, 128, timeout_ms)
if chunk == None:
    print("read eof")
else:
    print("read chunk bytes", len(chunk))
    print(chunk)

__tyrion_native_tcp_close(handle)
