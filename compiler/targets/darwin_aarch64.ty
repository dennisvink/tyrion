    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x22, [sp, #16]")
    out = asm_line(out, "str x26, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x22, x1")
    out = asm_line(out, "mov x10, #0")
    out = asm_line(out, "bl L_copy_slot_value")
    out = asm_line(out, "ldr x26, [sp, #32]")
    out = asm_line(out, "ldp x19, x22, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_generated_value_copy_slot_self")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")

    # Retain has copy semantics for value slots. Refcounted writer/AST values
    # retain their object; non-refcounted heap values are independently copied.
    out = asm_label(out, "L_generated_value_retain_slot")
    out = asm_line(out, "b L_generated_value_copy_slot")

    # x0=initialized destination slot, x1=source slot. Assignment replacement
