    asm_line(out, "ldrb w9, [x0, #4]")
    asm_line(out, "cbnz w9, L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "b L_generated_value_classify_untagged_scalar_bool")
    asm_label(out, "L_generated_value_classify_untagged_scalar_false")
    asm_line(out, "ldrb w9, [x0, #1]")
    asm_line(out, "cmp w9, #97")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "ldrb w9, [x0, #2]")
    asm_line(out, "cmp w9, #108")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "ldrb w9, [x0, #3]")
    asm_line(out, "cmp w9, #115")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "ldrb w9, [x0, #4]")
    asm_line(out, "cmp w9, #101")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "ldrb w9, [x0, #5]")
    asm_line(out, "cbnz w9, L_generated_value_classify_untagged_scalar_string")
