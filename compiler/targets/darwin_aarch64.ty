    out = asm_line(out, "cmp x1, #8")
    out = asm_line(out, "b.eq L_nshr_maybe_raw_string")
    out = asm_line(out, "cmp x1, #5")
    out = asm_line(out, "b.eq L_nshr_force_heap_list")
    out = asm_line(out, "cmp x1, #6")
    out = asm_line(out, "b.eq L_nshr_force_heap_dict")
    out = asm_line(out, "cmp x1, #9")
    out = asm_line(out, "b.eq L_nshr_copy_heap_collection")
