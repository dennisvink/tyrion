    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_nshr_fail")
    out = asm_line(out, "str x0, [sp, #40]")
    out = asm_line(out, "ldr x11, [sp, #8]")
    out = asm_line(out, "ldr x12, [sp, #32]")
    out = asm_line(out, "mov x13, #0")
    out = asm_label(out, "L_nshr_copy_loop")
    out = asm_line(out, "cmp x13, x12")
    out = asm_line(out, "b.hs L_nshr_copy_done")
    out = asm_line(out, "ldrb w9, [x11, x13]")
    out = asm_line(out, "strb w9, [x0, x13]")
    out = asm_line(out, "add x13, x13, #1")
    out = asm_line(out, "b L_nshr_copy_loop")
    out = asm_label(out, "L_nshr_copy_done")
    out = asm_line(out, "strb wzr, [x0, x12]")
    out = asm_line(out, "ldr x11, [sp, #8]")
    out = asm_line(out, "str x0, [x11]")
    out = asm_line(out, "str x12, [x11, #8]")
    out = asm_line(out, "ldr x9, [sp, #16]")
    out = asm_line(out, "strb w9, " + value_tag_x11)
    out = asm_label(out, "L_nshr_done")
    out = asm_line(out, "ldr x14, [sp, #16]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldr x30, [sp]")
    out = asm_line(out, "add sp, sp, #80")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_nshr_fail")
    out = asm_line(out, "ldr x14, [sp, #24]")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ldr x30, [sp]")
    out = asm_line(out, "add sp, sp, #80")
    out = asm_line(out, "ret")

    out = asm_label(out, "L_store_named_value")
    out = asm_line(out, "sub sp, sp, #80")
    out = asm_line(out, "str x30, [sp]")
    out = asm_line(out, "str x0, [sp, #8]")
    out = asm_line(out, "str x1, [sp, #16]")
    out = asm_line(out, "str x2, [sp, #24]")
    out = asm_line(out, "str x20, [sp, #32]")
    out = asm_line(out, "bl L_find_assignment_slot")
    out = asm_line(out, "cbnz w0, L_snv_slot_ready")
    out = asm_line(out, "cmp x20, #128")
    out = asm_line(out, "b.ge L_snv_fail")
    out = asm_line(out, "lsl x10, x20, #7")
    out = asm_line(out, "add x12, x21, x10")
    out = asm_line(out, "ldr x13, [sp, #8]")
    out = asm_line(out, "mov x11, #0")
    out = asm_label(out, "L_snv_copy_name")
    out = asm_line(out, "cmp x11, #120")
    out = asm_line(out, "b.gt L_snv_fail")
    out = asm_line(out, "ldrb w9, [x13]")
    out = asm_line(out, "cbz w9, L_snv_name_done")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.eq L_snv_name_done")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq L_snv_name_done")
    out = asm_line(out, "cmp w9, #44")
    out = asm_line(out, "b.eq L_snv_name_done")
    out = asm_line(out, "strb w9, [x12]")
    out = asm_line(out, "add x13, x13, #1")
    out = asm_line(out, "add x12, x12, #1")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "b L_snv_copy_name")
    out = asm_label(out, "L_snv_name_done")
    out = asm_line(out, "strb wzr, [x12]")
    out = asm_line(out, "add x20, x20, #1")
    out = asm_label(out, "L_snv_slot_ready")
    out = asm_line(out, "add x12, x22, x10")
    out = asm_line(out, "ldr x13, [sp, #16]")
    out = asm_line(out, "ldr x14, [sp, #24]")
    out = asm_line(out, "cmp x14, #8")
    out = asm_line(out, "b.eq L_snv_copy_heap_value")
    out = asm_line(out, "cmp x14, #9")
    out = asm_line(out, "b.eq L_snv_copy_heap_value")
    out = asm_line(out, "cmp x14, #11")
    out = asm_line(out, "b.eq L_snv_copy_heap_value")
    out = asm_line(out, "mov x11, #0")
    out = asm_label(out, "L_snv_copy_value")
    out = asm_line(out, "cmp x11, #120")
    out = asm_line(out, "b.gt L_snv_fail")
    out = asm_line(out, "ldrb w9, [x13]")
    out = asm_line(out, "strb w9, [x12]")
    out = asm_line(out, "cbz w9, L_snv_value_done")
    out = asm_line(out, "add x13, x13, #1")
    out = asm_line(out, "add x12, x12, #1")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "b L_snv_copy_value")
    out = asm_label(out, "L_snv_value_done")
    out = asm_line(out, "add x12, x22, x10")
    out = asm_line(out, "ldr x9, [sp, #24]")
    out = asm_line(out, "strb w9, " + value_tag_x12)
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "sub x1, x20, x9")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_snv_return")
    out = asm_label(out, "L_snv_copy_heap_value")
    out = asm_line(out, "ldr x9, [x13]")
    out = asm_line(out, "lsr x11, x9, #48")
    out = asm_line(out, "cbnz x11, L_snv_copy_heap_from_raw")
    out = asm_line(out, "str x9, [x12]")
    out = asm_line(out, "ldr x9, [x13, #8]")
    out = asm_line(out, "str x9, [x12, #8]")
    out = asm_line(out, "ldr x9, [sp, #24]")
    out = asm_line(out, "strb w9, " + value_tag_x12)
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "sub x1, x20, x9")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_snv_return")
    out = asm_label(out, "L_snv_copy_heap_from_raw")
    out = asm_line(out, "mov x15, x13")
    out = asm_line(out, "mov x16, #0")
    out = asm_label(out, "L_snv_raw_heap_len")
    out = asm_line(out, "ldrb w9, [x15, x16]")
    out = asm_line(out, "cbz w9, L_snv_raw_heap_alloc")
    out = asm_line(out, "add x16, x16, #1")
    out = asm_line(out, "b L_snv_raw_heap_len")
    out = asm_label(out, "L_snv_raw_heap_alloc")
    out = asm_line(out, "add x0, x16, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_snv_fail")
    out = asm_line(out, "str x0, [x12]")
    out = asm_line(out, "str x16, [x12, #8]")
    out = asm_line(out, "mov x17, #0")
    out = asm_label(out, "L_snv_raw_heap_copy")
    out = asm_line(out, "cmp x17, x16")
    out = asm_line(out, "b.hs L_snv_raw_heap_copy_done")
    out = asm_line(out, "ldrb w9, [x15, x17]")
    out = asm_line(out, "strb w9, [x0, x17]")
    out = asm_line(out, "add x17, x17, #1")
    out = asm_line(out, "b L_snv_raw_heap_copy")
    out = asm_label(out, "L_snv_raw_heap_copy_done")
    out = asm_line(out, "strb wzr, [x0, x16]")
    out = asm_line(out, "ldr x9, [sp, #24]")
    out = asm_line(out, "strb w9, " + value_tag_x12)
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "sub x1, x20, x9")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_snv_return")
    out = asm_label(out, "L_snv_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_snv_return")
    out = asm_line(out, "ldr x30, [sp]")
    out = asm_line(out, "add sp, sp, #80")
    out = asm_line(out, "ret")

    return out

def emit_darwin_aarch64_assignment_mutation_component(out, target, usage_text, version_text, spec):
    value_tag_x12 = generated_value_tag_mem("x12")
    value_tag_x15 = generated_value_tag_mem("x15")
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x22 = generated_value_tag_mem("x22")

    # Serialize a canonical owner-2/owner-3 typed list into a compact
    # dictionary value. ABI: x0=list slot, x1=destination cursor,
    # x2=destination end; w0=success and x1=advanced cursor. The marker and
    # two escape levels make list-of-dictionary values round-trip without
    # confusing list item separators with separators inside each dictionary.
    out = asm_label(out, "L_generated_serialize_typed_list_dict_value")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.ne L_gstldv_fail")
    out = asm_line(out, "ldrb w9, " + generated_value_owner_mem("x19"))
    out = asm_line(out, "cmp w9, #2")
    out = asm_line(out, "b.eq L_gstldv_owner_ready")
    out = asm_line(out, "cmp w9, #3")
    out = asm_line(out, "b.ne L_gstldv_fail")
    out = asm_label(out, "L_gstldv_owner_ready")
    out = asm_line(out, "cmp x20, x21")
    out = asm_line(out, "b.hs L_gstldv_fail")
    out = asm_line(out, "mov w9, #28")
    out = asm_line(out, "strb w9, [x20]")
    out = asm_line(out, "add x20, x20, #1")
    out = asm_line(out, "ldr x22, [x19]")
    out = asm_line(out, "ldr x23, [x19, #8]")
    out = asm_line(out, "mov x24, #0")
    out = asm_label(out, "L_gstldv_item_loop")
    out = asm_line(out, "cmp x24, x23")
    out = asm_line(out, "b.hs L_gstldv_done")
    out = asm_line(out, "cbz x24, L_gstldv_item_start")
    out = asm_line(out, "cmp x20, x21")
    out = asm_line(out, "b.hs L_gstldv_fail")
    out = asm_line(out, "mov w9, #30")
    out = asm_line(out, "strb w9, [x20]")
    out = asm_line(out, "add x20, x20, #1")
    out = asm_label(out, "L_gstldv_item_start")
    out = asm_line(out, "lsl x9, x24, #7")
    out = asm_line(out, "add x25, x22, x9")
    out = asm_line(out, "ldrb w26, " + generated_value_tag_mem("x25"))
    out = asm_line(out, "cmp w26, #8")
    out = asm_line(out, "b.eq L_gstldv_item_heap")
    out = asm_line(out, "cmp w26, #9")
    out = asm_line(out, "b.eq L_gstldv_item_heap")
    out = asm_line(out, "cmp w26, #11")
    out = asm_line(out, "b.eq L_gstldv_item_heap")
    out = asm_line(out, "mov x19, x25")
    out = asm_line(out, "mov x0, #120")
    out = asm_line(out, "b L_gstldv_item_copy_start")
    out = asm_label(out, "L_gstldv_item_heap")
    # Nested typed lists require another escape level and are deliberately
    # rejected until the compact ABI grows a recursive framing byte.
    out = asm_line(out, "cmp w26, #9")
    out = asm_line(out, "b.ne L_gstldv_item_heap_bytes")
    out = asm_line(out, "ldrb w9, " + generated_value_owner_mem("x25"))
    out = asm_line(out, "cmp w9, #2")
    out = asm_line(out, "b.eq L_gstldv_fail")
    out = asm_line(out, "cmp w9, #3")
    out = asm_line(out, "b.eq L_gstldv_fail")
    out = asm_label(out, "L_gstldv_item_heap_bytes")
    out = asm_line(out, "ldr x19, [x25]")
    out = asm_line(out, "ldr x0, [x25, #8]")
    out = asm_label(out, "L_gstldv_item_copy_start")
    out = asm_line(out, "mov x1, #0")
    out = asm_label(out, "L_gstldv_item_copy")
    out = asm_line(out, "cmp x1, x0")
    out = asm_line(out, "b.hs L_gstldv_item_done")
    out = asm_line(out, "ldrb w9, [x19, x1]")
    out = asm_line(out, "cbz w9, L_gstldv_item_done")
    out = asm_line(out, "cmp x20, x21")
    out = asm_line(out, "b.hs L_gstldv_fail")
    # A dictionary element's own entry separator is escaped one level below
    # the surrounding list's byte-30 item separator.
    out = asm_line(out, "cmp w26, #11")
    out = asm_line(out, "b.ne L_gstldv_item_store")
    out = asm_line(out, "cmp w9, #124")
    out = asm_line(out, "b.ne L_gstldv_item_store")
    out = asm_line(out, "mov w9, #31")
    out = asm_label(out, "L_gstldv_item_store")
    out = asm_line(out, "strb w9, [x20]")
    out = asm_line(out, "add x20, x20, #1")
    out = asm_line(out, "add x1, x1, #1")
    out = asm_line(out, "b L_gstldv_item_copy")
    out = asm_label(out, "L_gstldv_item_done")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "b L_gstldv_item_loop")
    out = asm_label(out, "L_gstldv_done")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_gstldv_return")
    out = asm_label(out, "L_gstldv_fail")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_gstldv_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # Replace or append one entry in a heap-backed compact dictionary.
    # ABI: x0=dict slot, x1=key begin, x2=key end, x3=value slot; w0=success.
    # A fresh 64 KiB payload keeps replacement atomic and preserves the same
    # separator encoding used by literal dictionaries and collection access.
    out = asm_label(out, "L_generated_heap_dict_set_compact")
    out = asm_line(out, "stp x29, x30, [sp, #-160]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "ldr x25, [x19]")
    out = asm_line(out, "cbz x25, L_ghdsc_fail")
    out = asm_line(out, "ldr x9, [x19, #8]")
    out = asm_line(out, "mov x10, #65535")
    out = asm_line(out, "cmp x9, x10")
    out = asm_line(out, "b.hi L_ghdsc_fail")
    # The compact payload is NUL-terminated. Treat the stored byte length as a
    # bound, not permission to copy through an earlier terminator: older
    # owner-discriminator bugs could leave a conservative stale length.
    out = asm_line(out, "mov x26, x25")
    out = asm_line(out, "mov x10, #0")
    out = asm_label(out, "L_ghdsc_old_end_scan")
    out = asm_line(out, "cmp x10, x9")
    out = asm_line(out, "b.hi L_ghdsc_fail")
    out = asm_line(out, "ldrb w11, [x26]")
    out = asm_line(out, "cbz w11, L_ghdsc_old_end_ready")
    out = asm_line(out, "add x26, x26, #1")
    out = asm_line(out, "add x10, x10, #1")
    out = asm_line(out, "b L_ghdsc_old_end_scan")
    out = asm_label(out, "L_ghdsc_old_end_ready")
    out = asm_line(out, "mov x0, #1024")
    out = asm_line(out, "lsl x0, x0, #6")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_ghdsc_fail")
    out = asm_line(out, "mov x23, x0")
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "mov x27, x25")
    out = asm_label(out, "L_ghdsc_entry_loop")
    out = asm_line(out, "cmp x27, x26")
    out = asm_line(out, "b.hs L_ghdsc_old_done")
    out = asm_line(out, "str x27, [sp, #96]")
    out = asm_line(out, "mov x28, x27")
    out = asm_label(out, "L_ghdsc_key_end_scan")
    out = asm_line(out, "cmp x28, x26")
    out = asm_line(out, "b.hs L_ghdsc_new_fail")
    out = asm_line(out, "ldrb w9, [x28]")
    out = asm_line(out, "cmp w9, #61")
    out = asm_line(out, "b.eq L_ghdsc_key_end_found")
    out = asm_line(out, "cmp w9, #124")
    out = asm_line(out, "b.eq L_ghdsc_new_fail")
    out = asm_line(out, "add x28, x28, #1")
    out = asm_line(out, "b L_ghdsc_key_end_scan")
    out = asm_label(out, "L_ghdsc_key_end_found")
    out = asm_line(out, "str x28, [sp, #104]")
    out = asm_line(out, "mov x17, x28")
    out = asm_label(out, "L_ghdsc_entry_end_scan")
    out = asm_line(out, "cmp x17, x26")
    out = asm_line(out, "b.hs L_ghdsc_entry_end_found")
    out = asm_line(out, "ldrb w9, [x17]")
    out = asm_line(out, "cmp w9, #124")
    out = asm_line(out, "b.eq L_ghdsc_entry_end_found")
    out = asm_line(out, "add x17, x17, #1")
    out = asm_line(out, "b L_ghdsc_entry_end_scan")
    out = asm_label(out, "L_ghdsc_entry_end_found")
    out = asm_line(out, "str x17, [sp, #112]")
    out = asm_line(out, "ldr x16, [sp, #96]")
    out = asm_line(out, "sub x9, x28, x16")
    out = asm_line(out, "sub x10, x21, x20")
    out = asm_line(out, "cmp x9, x10")
    out = asm_line(out, "b.ne L_ghdsc_copy_entry")
    out = asm_line(out, "mov x11, #0")
    out = asm_label(out, "L_ghdsc_key_compare")
    out = asm_line(out, "cmp x11, x10")
    out = asm_line(out, "b.hs L_ghdsc_skip_entry")
    out = asm_line(out, "ldrb w9, [x16, x11]")
    out = asm_line(out, "ldrb w12, [x20, x11]")
    out = asm_line(out, "cmp w9, w12")
    out = asm_line(out, "b.ne L_ghdsc_copy_entry")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "b L_ghdsc_key_compare")
    out = asm_label(out, "L_ghdsc_copy_entry")
    out = asm_line(out, "cmp x24, x23")
    out = asm_line(out, "b.eq L_ghdsc_copy_entry_bytes")
    out = asm_line(out, "mov w9, #124")
    out = asm_line(out, "strb w9, [x24]")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_label(out, "L_ghdsc_copy_entry_bytes")
    out = asm_line(out, "ldr x16, [sp, #96]")
    out = asm_line(out, "ldr x17, [sp, #112]")
    out = asm_label(out, "L_ghdsc_copy_entry_loop")
    out = asm_line(out, "cmp x16, x17")
    out = asm_line(out, "b.hs L_ghdsc_next_entry")
    out = asm_line(out, "sub x9, x24, x23")
    out = asm_line(out, "mov x10, #65535")
    out = asm_line(out, "cmp x9, x10")
