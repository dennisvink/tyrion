    asm_line(out, "ldrb w9, [x0, #2]")
    asm_line(out, "cmp w9, #110")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "ldrb w9, [x0, #3]")
