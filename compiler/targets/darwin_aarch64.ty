    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, #0")
    asm_label(out, "L_asm_writer_resolve_slot_loop")
    asm_line(out, "cbz x19, L_asm_writer_resolve_slot_fail")
    asm_line(out, "ldrb w9, " + value_tag_x19)
    asm_line(out, "cmp w9, #" + writer_tag)
    asm_line(out, "b.eq L_asm_writer_resolve_slot_ok")
    asm_line(out, "cmp w9, #1")
    asm_line(out, "b.ne L_asm_writer_resolve_slot_fail")
    asm_line(out, "ldr x21, [x19]")
    asm_line(out, "cbz x21, L_asm_writer_resolve_slot_fail")
    asm_line(out, "and x9, x21, #7")
    asm_line(out, "cbnz x9, L_asm_writer_resolve_slot_fail")
    asm_line(out, "lsr x0, x21, #12")
    asm_line(out, "lsl x0, x0, #12")
    asm_line(out, "mov x1, #1")
    asm_line(out, "lsl x1, x1, #12")
    asm_line(out, "add x2, sp, #48")
    asm_line(out, "bl " + asm_call_name(target, "mincore"))
    asm_line(out, "cbnz w0, L_asm_writer_resolve_slot_fail")
    asm_line(out, "add x20, x20, #1")
    asm_line(out, "cmp x20, #4")
    asm_line(out, "b.hs L_asm_writer_resolve_slot_fail")
    asm_line(out, "mov x19, x21")
    asm_line(out, "b L_asm_writer_resolve_slot_loop")
    asm_label(out, "L_asm_writer_resolve_slot_ok")
    asm_line(out, "mov x0, x19")
    asm_line(out, "b L_asm_writer_resolve_slot_return")
    asm_label(out, "L_asm_writer_resolve_slot_fail")
    asm_line(out, "mov x0, #0")
    asm_label(out, "L_asm_writer_resolve_slot_return")
    asm_line(out, "ldr x21, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #64")
    asm_line(out, "ret")

    # x0=path value slot, x1=result slot -> w0=success.
    asm_label(out, "L_asm_writer_open")
    asm_line(out, "stp x29, x30, [sp, #-64]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "str x21, [sp, #32]")
    asm_line(out, "mov x19, x1")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, L_asm_writer_open_fail")
    asm_line(out, "mov x21, x0")
    asm_addr(out, target, "x1", "L_asm_writer_mode_wb")
    asm_line(out, "bl " + fopen_call)
    asm_line(out, "cbz x0, L_asm_writer_open_fail")
    asm_line(out, "mov x20, x0")
    asm_line(out, "mov x0, #48")
    asm_line(out, "bl " + malloc_call)
    asm_line(out, "cbz x0, L_asm_writer_open_fail_close")
    asm_line(out, "mov x21, x0")
    asm_line(out, "stp x20, xzr, [x21]")
    asm_line(out, "stp xzr, xzr, [x21, #16]")
    asm_line(out, "mov x9, #1")
    asm_line(out, "str x9, [x21, #24]")
    asm_line(out, "stp xzr, xzr, [x21, #32]")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "str x21, [x19]")
    asm_line(out, "mov w9, #" + writer_tag)
    asm_line(out, "strb w9, " + value_tag_x19)
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_open_return")
    asm_label(out, "L_asm_writer_open_fail_close")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl " + fclose_call)
    asm_label(out, "L_asm_writer_open_fail")
    asm_addr(out, target, "x0", "L_native_compiler_file_write_failed")
    asm_line(out, "mov x1, x21")
    asm_line(out, "bl L_native_compiler_file_report_failure")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_open_return")
    asm_line(out, "ldr x21, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #64")
    asm_line(out, "ret")

    # x0=writer slot, x1=text slot, x2=result slot -> w0=success.
    asm_label(out, "L_asm_writer_append")
    asm_line(out, "stp x29, x30, [sp, #-96]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "str x23, [sp, #48]")
    asm_line(out, "str x0, [sp, #56]")
    asm_line(out, "str x1, [sp, #64]")
    asm_line(out, "str x2, [sp, #72]")
    asm_line(out, "bl L_asm_writer_resolve_slot")
    asm_line(out, "cbz x0, L_asm_writer_append_string")
    asm_line(out, "ldr x19, [x0]")
    asm_line(out, "cbz x19, L_asm_writer_append_invalid")
    asm_line(out, "mov x23, x2")
    asm_line(out, "ldr x9, [x19, #16]")
    asm_line(out, "tst x9, #3")
    asm_line(out, "b.ne L_asm_writer_append_closed")
    asm_line(out, "mov x0, x1")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, L_asm_writer_append_poison")
    asm_line(out, "mov x20, x0")
    asm_line(out, "mov x21, x1")
    asm_line(out, "ldr x9, [x19, #8]")
    asm_line(out, "adds x22, x9, x21")
    asm_line(out, "b.cs L_asm_writer_append_poison")
    asm_line(out, "mov x0, x20")
    asm_line(out, "mov x1, #1")
    asm_line(out, "mov x2, x21")
    asm_line(out, "ldr x3, [x19]")
    asm_line(out, "bl " + fwrite_call)
    asm_line(out, "cmp x0, x21")
    asm_line(out, "b.ne L_asm_writer_append_poison")
    asm_line(out, "str x22, [x19, #8]")
    asm_line(out, "ldr x9, [sp, #56]")
    asm_line(out, "cmp x23, x9")
    asm_line(out, "b.eq L_asm_writer_append_alias_result")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_asm_writer_retain")
    asm_line(out, "cbz w0, L_asm_writer_append_poison")
    asm_line(out, "mov x0, x23")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "str x19, [x23]")
    asm_line(out, "mov w9, #" + writer_tag)
    asm_line(out, "strb w9, " + value_tag_x23)
    asm_label(out, "L_asm_writer_append_alias_result")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_append_return")
    asm_label(out, "L_asm_writer_append_poison")
    asm_line(out, "ldr x9, [x19, #16]")
    asm_line(out, "orr x9, x9, #1")
    asm_line(out, "str x9, [x19, #16]")
    asm_line(out, "b L_asm_writer_append_invalid")
    asm_label(out, "L_asm_writer_append_string")
    asm_line(out, "ldr x0, [sp, #56]")
    asm_line(out, "ldr x1, [sp, #64]")
    asm_line(out, "ldr x2, [sp, #72]")
    asm_line(out, "bl L_exec_fn_lowered_function_label")
    asm_line(out, "cbz w0, L_asm_writer_append_return")
    asm_line(out, "ldr x0, [sp, #56]")
    asm_line(out, "ldr x1, [sp, #72]")
    asm_line(out, "bl L_generated_value_assign_copy_slot")
    asm_line(out, "b L_asm_writer_append_return")
    asm_label(out, "L_asm_writer_append_invalid")
    asm_addr(out, target, "x0", "L_err_asm_writer_append")
    asm_line(out, "bl " + puts_call)
    asm_line(out, "mov w0, #0")
    asm_line(out, "b L_asm_writer_append_return")
    asm_label(out, "L_asm_writer_append_closed")
    asm_addr(out, target, "x0", "L_err_asm_writer_closed")
    asm_line(out, "bl " + puts_call)
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_append_return")
    asm_line(out, "ldr x23, [sp, #48]")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #96")
    asm_line(out, "ret")

    # x0=writer slot, x1=bool result slot -> w0=success.
    asm_label(out, "L_asm_writer_close")
    asm_line(out, "stp x29, x30, [sp, #-64]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "mov x20, x1")
    asm_line(out, "bl L_asm_writer_resolve_slot")
    asm_line(out, "cbz x0, L_asm_writer_close_invalid")
    asm_line(out, "ldr x19, [x0]")
    asm_line(out, "cbz x19, L_asm_writer_close_invalid")
    asm_line(out, "ldr x9, [x19, #16]")
    asm_line(out, "tst x9, #2")
    asm_line(out, "b.ne L_asm_writer_close_result")
    asm_line(out, "orr x9, x9, #2")
    asm_line(out, "str x9, [x19, #16]")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "cbz x0, L_asm_writer_close_poison")
    asm_line(out, "bl " + fflush_call)
    asm_line(out, "cbnz w0, L_asm_writer_close_poison_after_flush")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "bl " + fclose_call)
    asm_line(out, "str xzr, [x19]")
    asm_line(out, "cbnz w0, L_asm_writer_close_poison")
    asm_line(out, "b L_asm_writer_close_result")
    asm_label(out, "L_asm_writer_close_poison_after_flush")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "bl " + fclose_call)
    asm_line(out, "str xzr, [x19]")
    asm_label(out, "L_asm_writer_close_poison")
    asm_line(out, "ldr x9, [x19, #16]")
    asm_line(out, "orr x9, x9, #1")
    asm_line(out, "str x9, [x19, #16]")
    asm_label(out, "L_asm_writer_close_result")
    asm_line(out, "ldr x9, [x19, #16]")
    asm_line(out, "tst x9, #1")
    asm_line(out, "b.ne L_asm_writer_close_invalid")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "mov w10, #1")
    asm_line(out, "strb w10, [x20]")
    asm_line(out, "mov w9, #3")
    asm_line(out, "strb w9, " + value_tag_x20)
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_close_return")
    asm_label(out, "L_asm_writer_close_invalid")
    asm_addr(out, target, "x0", "L_err_asm_writer_close")
    asm_line(out, "bl " + puts_call)
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_close_return")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #64")
    asm_line(out, "ret")

    # x0=writer slot, x1=int result slot -> w0=success.
    asm_label(out, "L_asm_writer_bytes")
    asm_line(out, "stp x29, x30, [sp, #-16]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "bl L_asm_writer_resolve_slot")
    asm_line(out, "cbz x0, L_asm_writer_bytes_fail")
    asm_line(out, "ldr x9, [x0]")
    asm_line(out, "cbz x9, L_asm_writer_bytes_fail")
    asm_line(out, "ldr x10, [x9, #8]")
    asm_line(out, "str x10, [x1]")
    asm_line(out, "mov w9, #2")
    asm_line(out, "strb w9, " + value_tag_x1)
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_bytes_return")
    asm_label(out, "L_asm_writer_bytes_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_bytes_return")
    asm_line(out, "ldp x29, x30, [sp], #16")
    asm_line(out, "ret")

    # x0=writer slot, x1=backend string slot, x2=result writer slot.
    # Backend mode is writer-owned so nested/generated compiler execution does
    # not depend on source-language globals. Object offset 32 was reserved.
    asm_label(out, "L_asm_writer_set_backend")
    asm_line(out, "stp x29, x30, [sp, #-96]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "mov x20, x2")
    asm_line(out, "bl L_asm_writer_resolve_slot")
    asm_line(out, "cbz x0, L_asm_writer_set_backend_fail")
    asm_line(out, "mov x19, x0")
    asm_line(out, "ldr x21, [x19]")
    asm_line(out, "cbz x21, L_asm_writer_set_backend_fail")
    asm_line(out, "mov x0, x1")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, L_asm_writer_set_backend_fail")
    asm_line(out, "mov x22, x0")
    asm_line(out, "mov x9, #0")
    asm_line(out, "cmp x1, #12")
    asm_line(out, "b.ne L_asm_writer_set_backend_store")
    asm_line(out, "mov x0, x22")
    asm_addr(out, target, "x1", "L_asm_writer_backend_x86")
    asm_line(out, "mov x2, #12")
    asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    asm_line(out, "cmp w0, #0")
    asm_line(out, "cset w9, eq")
    asm_label(out, "L_asm_writer_set_backend_store")
    asm_line(out, "str x9, [x21, #32]")
    asm_line(out, "cmp x20, x19")
    asm_line(out, "b.eq L_asm_writer_set_backend_ok")
    asm_line(out, "mov x0, x21")
    asm_line(out, "bl L_asm_writer_retain")
    asm_line(out, "cbz w0, L_asm_writer_set_backend_fail")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "str x21, [x20]")
    asm_line(out, "mov w9, #" + writer_tag)
    asm_line(out, "strb w9, " + value_tag_x20)
    asm_label(out, "L_asm_writer_set_backend_ok")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_set_backend_return")
    asm_label(out, "L_asm_writer_set_backend_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_set_backend_return")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #96")
    asm_line(out, "ret")

    # x0=writer slot, x1=bool result slot -> w0=success.
    asm_label(out, "L_asm_writer_is_x86")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, x1")
    asm_line(out, "bl L_asm_writer_resolve_slot")
    asm_line(out, "cbz x0, L_asm_writer_is_x86_string")
    asm_line(out, "ldr x9, [x0]")
    asm_line(out, "cbz x9, L_asm_writer_is_x86_fail")
    asm_line(out, "ldr x10, [x9, #32]")
    asm_line(out, "b L_asm_writer_is_x86_publish")
    asm_label(out, "L_asm_writer_is_x86_string")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, L_asm_writer_is_x86_fail")
    asm_line(out, "mov w10, #0")
    asm_label(out, "L_asm_writer_is_x86_publish")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "strb w10, [x20]")
    asm_line(out, "mov w9, #3")
    asm_line(out, "strb w9, " + value_tag_x20)
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_is_x86_return")
    asm_label(out, "L_asm_writer_is_x86_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_asm_writer_is_x86_return")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #48")
    asm_line(out, "ret")

    asm_label(out, "L_asm_writer_fail")
    asm_line(out, "mov w0, #0")
    asm_line(out, "ret")
    asm_section(out, target["rodata_section"])
    asm_cstr(out, "L_asm_writer_mode_wb", "wb")
    asm_cstr(out, "L_asm_writer_backend_x86", "linux-x86_64")
    asm_cstr(out, "L_err_asm_writer_open", "generated asm writer open failed")
    asm_cstr(out, "L_err_asm_writer_append", "generated asm writer append failed")
    asm_cstr(out, "L_err_asm_writer_closed", "generated asm writer is closed or failed")
    asm_cstr(out, "L_err_asm_writer_close", "generated asm writer close failed")
    asm_section(out, target["text_section"])
    return out

def emit_aarch64_runtime_process_argv(out, target):
    out = asm_label(out, "__tyrion_app_process_argv")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_addr(out, target, "x9", "__tyrion_app_process_argc")
    out = asm_line(out, "ldr x20, [x9]")
    out = asm_line(out, "cbz x20, __tyrion_app_process_argv_count_ready")
    out = asm_line(out, "sub x20, x20, #1")
    out = asm_label(out, "__tyrion_app_process_argv_count_ready")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl __tyrion_app_list_new")
    out = asm_line(out, "ldr x21, [x19]")
    out = asm_addr(out, target, "x9", "__tyrion_app_process_argv_native")
    out = asm_line(out, "ldr x22, [x9]")
    out = asm_line(out, "mov x23, #0")
    out = asm_label(out, "__tyrion_app_process_argv_loop")
    out = asm_line(out, "cmp x23, x20")
    out = asm_line(out, "b.hs __tyrion_app_process_argv_done")
    out = asm_line(out, "add x9, x23, #1")
    out = asm_line(out, "ldr x24, [x22, x9, lsl #3]")
    out = asm_line(out, "cbz x24, __tyrion_app_process_argv_fail")
    out = asm_line(out, "mov x0, x24")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "add x10, x21, x23, lsl #7")
    out = asm_line(out, "str x24, [x10]")
    out = asm_line(out, "str x0, [x10, #8]")
    out = asm_line(out, "mov w9, #4")
    out = asm_line(out, "strb w9, [x10, #127]")
    out = asm_line(out, "add x23, x23, #1")
    out = asm_line(out, "b __tyrion_app_process_argv_loop")
    out = asm_label(out, "__tyrion_app_process_argv_fail")
    out = asm_line(out, "b __tyrion_app_oom")
    out = asm_label(out, "__tyrion_app_process_argv_done")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    return asm_line(out, "ret")


def emit_darwin_aarch64_runtime_native_program_asm_into(out, target, program, plan):
    frame_bytes = runtime_native_direct_frame_bytes(plan["top_level"], plan)
    branch_ids = __tyrion_native_ast_builder_create()
    state = {"target": target, "frame": plan["top_level"], "frame_bytes": frame_bytes, "branch_ids": branch_ids, "break_label": "", "continue_label": "", "return_label": "", "raise_label": "", "exception_slot": 0, "temp_base": len(plan["top_level"]["locals"]), "lambda_index": 0, "generator": False, "finally_label": "", "finally_pending_slot": 0, "finally_scope_path": ""}
    out = asm_raw(out, "# tyrion-runtime-native-asm v1 target=" + target["triple"] + "\n")
    out = asm_section(out, target["text_section"])
    for fn_plan in plan["functions"]:
        out = emit_runtime_native_direct_function(out, program, plan, fn_plan, target)
    out = asm_global_c_main(out, target)
    out = asm_addr(out, target, "x9", "__tyrion_app_process_argc")
    out = asm_line(out, "str x0, [x9]")
    out = asm_addr(out, target, "x9", "__tyrion_app_process_argv_native")
    out = asm_line(out, "str x1, [x9]")
    out = asm_line(out, "stp x29, x30, [sp, #-16]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "ldr x15, =" + str(frame_bytes))
    out = asm_line(out, "sub sp, sp, x15")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "ldr x1, =" + str(frame_bytes))
    out = asm_line(out, "bl __tyrion_app_zero_region")
    out = asm_addr(out, target, "x9", "__tyrion_app_global_base")
    out = asm_line(out, "mov x10, sp")
    out = asm_line(out, "str x10, [x9]")
    out = emit_runtime_native_direct_statements(out, runtime_native_top_level_items(program), plan, state, "_top")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ldr x15, =" + str(frame_bytes))
    out = asm_line(out, "add sp, sp, x15")
    out = asm_line(out, "ldp x29, x30, [sp], #16")
    out = asm_line(out, "ret")
    out = emit_runtime_native_direct_runtime(out, target, plan)
    out = emit_aarch64_runtime_process_argv(out, target)
    out = asm_section(out, target["rodata_section"])
    out = asm_cstr(out, "__tyrion_app_none", "none")
    out = asm_cstr(out, "__tyrion_app_true", "True")
    out = asm_cstr(out, "__tyrion_app_false", "False")
    out = asm_cstr(out, "__tyrion_app_space", " ")
    out = asm_cstr(out, "__tyrion_app_newline", "\n")
    out = asm_cstr(out, "__tyrion_app_minus", "-")
    out = asm_cstr(out, "__tyrion_app_dot", ".")
    out = asm_cstr(out, "__tyrion_app_mode_r", "r")
    out = asm_cstr(out, "L_tyrion_direct_lbracket", "[")
    out = asm_cstr(out, "L_tyrion_direct_rbracket", "]")
    out = asm_cstr(out, "L_tyrion_direct_comma_space", ", ")
    out = asm_cstr(out, "L_tyrion_direct_lbrace", "{")
    out = asm_cstr(out, "L_tyrion_direct_rbrace", "}")
    out = asm_cstr(out, "L_tyrion_direct_colon_space", ": ")
    for literal in plan["literals"]:
        if literal["kind"] == "string":
            out = asm_cstr(out, "__tyrion_app_lit_" + str(literal["id"]), literal["value"])
        if literal["kind"] == "float":
            out = asm_cstr(out, "__tyrion_app_lit_" + str(literal["id"]), str(literal["value"]))
    out = asm_section(out, target["data_section"])
    out = asm_label(out, "__tyrion_app_process_argc")
    out = asm_dir(out, ".quad 0")
    out = asm_label(out, "__tyrion_app_process_argv_native")
    out = asm_dir(out, ".quad 0")
    return out

def emit_darwin_aarch64_constant_asm(payload, target):
    payload_len = len(payload)
    out = "# tyrionc-bootstrap-asm v0 target=" + target["triple"] + "\n"
    out = out + "; darwin aarch64 constant-output bootstrap path\n"
    out = asm_section(out, target["text_section"])
    out = asm_dir(out, ".globl " + target["entry_symbol"])
    out = asm_label(out, target["entry_symbol"])
    out = asm_line(out, "mov x16, #4")
    out = asm_line(out, "mov x0, #1")
    out = asm_line(out, "adrp x1, __tyrion_payload_0@PAGE")
    out = asm_line(out, "add x1, x1, __tyrion_payload_0@PAGEOFF")
    out = asm_line(out, "ldr x2, =" + str(payload_len))
    out = asm_line(out, "svc #0x80")
    out = asm_line(out, "mov x16, #1")
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "svc #0x80")
    out = asm_section(out, target["rodata_section"])
    out = asm_label(out, "__tyrion_payload_0")
    out = out + ".asciz \"" + asm_escape_string(payload) + "\"\n"
    return out

def emit_darwin_aarch64_compiler_cli_preamble_into(out, target, spec):
    comment_prefix = ";"
    if target["object_format"] == "elf64":
        comment_prefix = "#"
    asm_writer_append(out, "# tyrionc-bootstrap-asm v0 target=" + target["triple"] + "\n")
    asm_writer_append(out, comment_prefix + " aarch64 source-derived compiler cli path\n")
    asm_writer_append(out, comment_prefix + " compiler source is parsed into persistent typed records before metadata extraction\n")
    asm_writer_append(out, comment_prefix + " compiler assembly is emitted incrementally through the writer ABI\n")
    asm_writer_append(out, comment_prefix + " runtime fallback and parent-compiler execution paths are forbidden\n")
    return out

def emit_darwin_aarch64_compiler_cli_preamble(target, spec):
    return emit_darwin_aarch64_compiler_cli_preamble_into("", target, spec)

def emit_darwin_aarch64_compiler_cli_entry(out, target):
    out = asm_section(out, target["text_section"])
