    out = emit_native_ast_handle_lifetime_runtime(out, target)

    # x0=owning value slot. Collection ownership also identifies representation:
    # 0/1 are borrowed/owned compact payloads and 2/3 are owned/borrowed typed
    # lists. This keeps a borrowed compact tag-9 value from being mistaken for
    # an array of 128-byte value slots.
    asm_label(out, "L_generated_value_release_owned_slot")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "cbz x19, L_generated_value_release_owned_slot_done")
    asm_line(out, "ldrb w9, " + value_tag_x19)
    asm_line(out, "cmp w9, #" + writer_tag)
    asm_line(out, "b.eq L_generated_value_release_owned_slot_writer")
    asm_line(out, "cmp w9, #" + "18")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_ast")
    asm_line(out, "cmp w9, #8")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_heap")
    asm_line(out, "cmp w9, #9")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_collection")
    asm_line(out, "cmp w9, #11")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_heap")
    asm_line(out, "b L_generated_value_release_owned_slot_clear")
    asm_label(out, "L_generated_value_release_owned_slot_writer")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "bl L_asm_writer_release")
    asm_line(out, "b L_generated_value_release_owned_slot_clear")
    asm_label(out, "L_generated_value_release_owned_slot_ast")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "bl L_native_ast_handle_release")
    asm_line(out, "b L_generated_value_release_owned_slot_clear")
    asm_label(out, "L_generated_value_release_owned_slot_heap")
    asm_line(out, "ldrb w9, " + value_owner_x19)
    asm_line(out, "cbz w9, L_generated_value_release_owned_slot_clear")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "cbz x0, L_generated_value_release_owned_slot_clear")
    asm_line(out, "bl " + free_call)
    asm_line(out, "b L_generated_value_release_owned_slot_clear")
    asm_label(out, "L_generated_value_release_owned_slot_collection")
    asm_line(out, "ldrb w9, " + value_owner_x19)
    asm_line(out, "cbz w9, L_generated_value_release_owned_slot_clear")
    asm_line(out, "cmp w9, #3")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_clear")
    asm_line(out, "cmp w9, #2")
    asm_line(out, "b.eq L_generated_value_release_owned_slot_typed_list")
