# compiler / targets / darwin aarch64: responsibility-owned canonical compiler module.

def emit_darwin_aarch64_source_function_runtime(out, target):
    # x0=complete compiler source, x1=function name. Returns an owned,
    # de-indented body in x0 and its exclusive end in x1.
    out = asm_label(out, "L_source_function_body_copy")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "str x27, [sp, #80]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, #0")
    out = asm_line(out, "mov w22, #0")
    out = asm_line(out, "mov x22, #0")
    out = asm_line(out, "cbz x19, L_sfbc_fail")
    out = asm_line(out, "cbz x20, L_sfbc_fail")
    out = asm_line(out, "mov x23, x19")
    out = asm_label(out, "L_sfbc_scan_line")
    out = asm_line(out, "ldrb w9, [x23]")
    out = asm_line(out, "cbz w9, L_sfbc_fail")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.eq L_sfbc_next_line")
    out = asm_line(out, "cmp w9, #13")
    out = asm_line(out, "b.eq L_sfbc_next_line")
    out = asm_line(out, "ldrb w9, [x23]")
    out = asm_line(out, "cmp w9, #100")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "ldrb w9, [x23, #1]")
    out = asm_line(out, "cmp w9, #101")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "ldrb w9, [x23, #2]")
    out = asm_line(out, "cmp w9, #102")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "ldrb w9, [x23, #3]")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "add x24, x23, #4")
    out = asm_line(out, "mov x25, x20")
    out = asm_label(out, "L_sfbc_match_name")
    out = asm_line(out, "ldrb w9, [x25], #1")
    out = asm_line(out, "cbz w9, L_sfbc_match_name_done")
    out = asm_line(out, "ldrb w10, [x24], #1")
    out = asm_line(out, "cmp w9, w10")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "b L_sfbc_match_name")
    out = asm_label(out, "L_sfbc_match_name_done")
    out = asm_line(out, "ldrb w9, [x24]")
    out = asm_line(out, "cmp w9, #40")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_label(out, "L_sfbc_find_header_end")
    out = asm_line(out, "ldrb w9, [x23], #1")
    out = asm_line(out, "cbz w9, L_sfbc_fail")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.ne L_sfbc_find_header_end")
    out = asm_line(out, "mov x24, x23")
    out = asm_line(out, "mov x25, #0")
    out = asm_label(out, "L_sfbc_find_base_indent")
    out = asm_line(out, "ldrb w9, [x24]")
    out = asm_line(out, "cbz w9, L_sfbc_fail")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.eq L_sfbc_base_blank")
    out = asm_line(out, "cmp w9, #13")
    out = asm_line(out, "b.eq L_sfbc_base_blank")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.eq L_sfbc_base_space")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq L_sfbc_base_space")
    out = asm_line(out, "cbz x25, L_sfbc_fail")
    out = asm_line(out, "b L_sfbc_allocate")
    out = asm_label(out, "L_sfbc_base_space")
    out = asm_line(out, "add x25, x25, #1")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "b L_sfbc_find_base_indent")
    out = asm_label(out, "L_sfbc_base_blank")
    out = asm_line(out, "mov x25, #0")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "b L_sfbc_find_base_indent")
    out = asm_label(out, "L_sfbc_allocate")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "add x0, x0, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "cbz x21, L_sfbc_fail")
    out = asm_line(out, "mov x22, x21")
    out = asm_line(out, "mov x24, x23")
    out = asm_label(out, "L_sfbc_copy_line")
    out = asm_line(out, "ldrb w9, [x24]")
    out = asm_line(out, "cbz w9, L_sfbc_success")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.eq L_sfbc_copy_blank")
    out = asm_line(out, "cmp w9, #13")
    out = asm_line(out, "b.eq L_sfbc_copy_blank")
    out = asm_line(out, "mov x26, #0")
    out = asm_label(out, "L_sfbc_skip_indent")
    out = asm_line(out, "cmp x26, x25")
    out = asm_line(out, "b.eq L_sfbc_copy_chars")
    out = asm_line(out, "ldrb w9, [x24]")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.eq L_sfbc_skip_indent_one")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.ne L_sfbc_success")
    out = asm_label(out, "L_sfbc_skip_indent_one")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "add x26, x26, #1")
    out = asm_line(out, "b L_sfbc_skip_indent")
    out = asm_label(out, "L_sfbc_copy_chars")
    out = asm_line(out, "ldrb w9, [x24], #1")
    out = asm_line(out, "strb w9, [x22], #1")
    out = asm_line(out, "cbz w9, L_sfbc_success")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.eq L_sfbc_copy_line")
    out = asm_line(out, "b L_sfbc_copy_chars")
    out = asm_label(out, "L_sfbc_copy_blank")
    out = asm_line(out, "ldrb w9, [x24], #1")
    out = asm_line(out, "strb w9, [x22], #1")
    out = asm_line(out, "b L_sfbc_copy_line")
    out = asm_label(out, "L_sfbc_skip_line")
    out = asm_line(out, "ldrb w9, [x23], #1")
    out = asm_line(out, "cbz w9, L_sfbc_fail")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.ne L_sfbc_skip_line")
    out = asm_line(out, "b L_sfbc_scan_line")
    out = asm_label(out, "L_sfbc_next_line")
    out = asm_line(out, "add x23, x23, #1")
    out = asm_line(out, "b L_sfbc_scan_line")
    out = asm_label(out, "L_sfbc_success")
    out = asm_line(out, "strb wzr, [x22]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "b L_sfbc_return")
    out = asm_label(out, "L_sfbc_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "cbz x0, L_sfbc_fail_empty")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_sfbc_fail_empty")
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "mov x1, #0")
    out = asm_label(out, "L_sfbc_return")
    out = asm_line(out, "ldp x27, x28, [sp, #80]")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")
    return out

def emit_darwin_aarch64_asm_writer_runtime(out, target):
    value_owner_x19 = generated_value_owner_mem("x19")
    value_tag_x0 = generated_value_tag_mem("x0")
    value_tag_x1 = generated_value_tag_mem("x1")
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")
    value_tag_x21 = generated_value_tag_mem("x21")
    value_tag_x23 = generated_value_tag_mem("x23")

    writer_tag = "17"
    slot_size = generated_value_slot_size()
    slot_size_text = decimal_text(slot_size)
    malloc_size_call = asm_call_name(target, "malloc_size")
    strlen_call = asm_call_name(target, "strlen")
    fwrite_call = asm_call_name(target, "fwrite")
    fclose_call = asm_call_name(target, "fclose")
    free_call = asm_call_name(target, "free")
    fopen_call = asm_call_name(target, "fopen")
    malloc_call = asm_call_name(target, "malloc")
    memcpy_call = asm_call_name(target, "memcpy")
    puts_call = asm_call_name(target, "puts")
    fflush_call = asm_call_name(target, "fflush")

    # x0=value slot -> x0=canonical typed slot. Linux/x86 generated call
    # frames can wrap values in tag-1 aliases; inline tag-1 strings remain in
    # place because their packed payload does not resolve to a mapped typed
    # value slot.
    asm_label(out, "L_generated_value_resolve_slot_alias")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        asm_line(out, "stp x29, x30, [sp, #-64]!")
        asm_line(out, "mov x29, sp")
        asm_line(out, "stp x19, x20, [sp, #16]")
        asm_line(out, "str x21, [sp, #32]")
        asm_line(out, "mov x19, x0")
        asm_line(out, "mov x20, #0")
        asm_label(out, "L_generated_value_resolve_slot_alias_loop")
        asm_line(out, "cbz x19, L_generated_value_resolve_slot_alias_fail")
        asm_line(out, "ldrb w9, " + value_tag_x19)
        asm_line(out, "cmp w9, #1")
        asm_line(out, "b.eq L_generated_value_resolve_slot_alias_probe")
        asm_line(out, "cmp w9, #0")
        asm_line(out, "b.ne L_generated_value_resolve_slot_alias_ok")
        asm_label(out, "L_generated_value_resolve_slot_alias_probe")
        asm_line(out, "ldr x21, [x19]")
        asm_line(out, "cbz x21, L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "and x9, x21, #7")
        asm_line(out, "cbnz x9, L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "lsr x0, x21, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #48")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "add x0, x21, #127")
        asm_line(out, "lsr x0, x0, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #48")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "ldrb w9, " + value_tag_x21)
        asm_line(out, "cbz w9, L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "cmp w9, #19")
        asm_line(out, "b.hi L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "add x20, x20, #1")
        asm_line(out, "cmp x20, #4")
        asm_line(out, "b.hs L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "mov x19, x21")
        asm_line(out, "b L_generated_value_resolve_slot_alias_loop")
        asm_label(out, "L_generated_value_resolve_slot_alias_ok")
        asm_line(out, "mov x0, x19")
        asm_line(out, "b L_generated_value_resolve_slot_alias_return")
        asm_label(out, "L_generated_value_resolve_slot_alias_fail")
        asm_line(out, "mov x0, #0")
        asm_label(out, "L_generated_value_resolve_slot_alias_return")
        asm_line(out, "ldr x21, [sp, #32]")
        asm_line(out, "ldp x19, x20, [sp, #16]")
        asm_line(out, "ldp x29, x30, [sp], #64")
        asm_line(out, "ret")
    else:
        asm_line(out, "ret")

    # x0=value slot -> x0=bytes, x1=len, w2=success.
    asm_label(out, "L_generated_value_string_ptr_len")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "cbz x19, L_generated_value_string_ptr_len_fail")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        asm_line(out, "mov x0, x19")
        asm_line(out, "bl L_generated_value_resolve_slot_alias")
        asm_line(out, "mov x19, x0")
        asm_line(out, "cbz x19, L_generated_value_string_ptr_len_fail")
    asm_line(out, "ldrb w9, " + value_tag_x19)
    asm_line(out, "cmp w9, #" + "8")
    asm_line(out, "b.eq L_generated_value_string_ptr_len_heap")
    asm_line(out, "cmp w9, #" + "9")
    asm_line(out, "b.eq L_generated_value_string_ptr_len_heap")
    asm_line(out, "cmp w9, #" + "11")
    asm_line(out, "b.eq L_generated_value_string_ptr_len_heap")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        # CLI argv aliases retain the historical tag-1 representation while
        # storing the NUL-terminated source pointer in slot word zero. Probe
        # the candidate mapping so ordinary inline tag-1 strings remain
        # distinguishable without dereferencing an arbitrary packed payload.
        asm_line(out, "cmp w9, #1")
        asm_line(out, "b.eq L_generated_value_string_ptr_len_tag1_probe")
    asm_label(out, "L_generated_value_string_ptr_len_inline")
    asm_line(out, "mov x10, x19")
    asm_line(out, "mov x1, #0")
    asm_label(out, "L_generated_value_string_ptr_len_inline_loop")
    asm_line(out, "ldrb w11, [x10, x1]")
    asm_line(out, "cbz w11, L_generated_value_string_ptr_len_inline_done")
    asm_line(out, "add x1, x1, #1")
    asm_line(out, "cmp x1, #127")
    asm_line(out, "b.lo L_generated_value_string_ptr_len_inline_loop")
    asm_line(out, "b L_generated_value_string_ptr_len_fail")
    asm_label(out, "L_generated_value_string_ptr_len_inline_done")
    asm_line(out, "mov x0, x10")
    asm_line(out, "mov w2, #1")
    asm_line(out, "b L_generated_value_string_ptr_len_return")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        asm_label(out, "L_generated_value_string_ptr_len_tag1_probe")
        asm_line(out, "ldr x10, [x19]")
        asm_line(out, "cbz x10, L_generated_value_string_ptr_len_inline")
        asm_line(out, "str x10, [sp, #24]")
        asm_line(out, "lsr x0, x10, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #40")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, L_generated_value_string_ptr_len_inline")
        asm_line(out, "ldr x0, [sp, #24]")
        asm_line(out, "bl " + asm_call_name(target, "strlen"))
        asm_line(out, "mov x1, x0")
        asm_line(out, "ldr x0, [sp, #24]")
        asm_line(out, "mov w2, #1")
        asm_line(out, "b L_generated_value_string_ptr_len_return")
    asm_label(out, "L_generated_value_string_ptr_len_heap")
    asm_line(out, "ldr x10, [x19]")
    asm_line(out, "cbz x10, L_generated_value_string_ptr_len_fail")
    if target["os"] == "linux":
        # Tag 11 retains a compatibility form where short payload bytes are
        # inline. Linux malloc_usable_size cannot safely classify that candidate,
        # so probe its page mapping before treating it as a pointer.
        asm_line(out, "str x10, [sp, #24]")
        asm_line(out, "lsr x0, x10, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #40")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, L_generated_value_string_ptr_len_inline")
        asm_line(out, "ldr x0, [sp, #24]")
        asm_line(out, "ldr x1, [x19, #8]")
    else:
        asm_line(out, "str x10, [sp, #24]")
        asm_line(out, "mov x0, x10")
        asm_line(out, "bl " + malloc_size_call)
        asm_line(out, "cbz x0, L_generated_value_string_ptr_len_inline")
        asm_line(out, "ldr x1, [x19, #8]")
        asm_line(out, "ldr x0, [sp, #24]")
    asm_line(out, "mov w2, #1")
    asm_line(out, "b L_generated_value_string_ptr_len_return")
    asm_label(out, "L_generated_value_string_ptr_len_fail")
    asm_line(out, "mov x0, #0")
    asm_line(out, "mov x1, #0")
    asm_line(out, "mov w2, #0")
    asm_label(out, "L_generated_value_string_ptr_len_return")
    asm_line(out, "ldr x19, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #48")
    asm_line(out, "ret")

    # x0=result slot. Clear all 128 bytes before constructing a native value.
    asm_label(out, "L_generated_value_zero_slot")
    asm_line(out, "mov x9, #0")
    asm_label(out, "L_generated_value_zero_slot_loop")
    asm_line(out, "str xzr, [x0, x9]")
    asm_line(out, "add x9, x9, #8")
    asm_line(out, "cmp x9, #" + slot_size_text)
    asm_line(out, "b.lo L_generated_value_zero_slot_loop")
    asm_line(out, "ret")

    # x0=untagged scalar result slot -> x14=canonical value tag. Lowered
    # source helpers still return short scalar values as NUL-terminated bytes;
    # classify that compatibility representation once at the call boundary.
    # Existing typed values pass through unchanged. Collections are normalized
    # before reaching this helper and therefore never enter the text classifier.
    asm_label(out, "L_generated_value_classify_untagged_scalar")
    asm_line(out, "ldrb w14, " + generated_value_tag_mem("x0"))
    asm_line(out, "cbnz w14, L_generated_value_classify_untagged_scalar_done")
    asm_line(out, "ldrb w9, [x0]")
    asm_line(out, "cmp w9, #84")
    asm_line(out, "b.eq L_generated_value_classify_untagged_scalar_true")
    asm_line(out, "cmp w9, #70")
    asm_line(out, "b.eq L_generated_value_classify_untagged_scalar_false")
    asm_line(out, "cmp w9, #110")
    asm_line(out, "b.eq L_generated_value_classify_untagged_scalar_none")
    asm_line(out, "mov x10, x0")
    asm_line(out, "cmp w9, #45")
    asm_line(out, "b.ne L_generated_value_classify_untagged_scalar_digit_first")
    asm_line(out, "add x10, x10, #1")
    asm_line(out, "ldrb w9, [x10]")
    asm_label(out, "L_generated_value_classify_untagged_scalar_digit_first")
    asm_line(out, "cmp w9, #48")
    asm_line(out, "b.lt L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "cmp w9, #57")
    asm_line(out, "b.gt L_generated_value_classify_untagged_scalar_string")
    asm_label(out, "L_generated_value_classify_untagged_scalar_digit_loop")
    asm_line(out, "add x10, x10, #1")
    asm_line(out, "ldrb w9, [x10]")
    asm_line(out, "cbz w9, L_generated_value_classify_untagged_scalar_int")
    asm_line(out, "cmp w9, #48")
    asm_line(out, "b.lt L_generated_value_classify_untagged_scalar_string")
    asm_line(out, "cmp w9, #57")
    asm_line(out, "b.le L_generated_value_classify_untagged_scalar_digit_loop")
    asm_line(out, "b L_generated_value_classify_untagged_scalar_string")
