    # destination, transfers all 128 bytes, and resets the source to none.
    out = asm_label(out, "L_generated_value_move_slot")
    out = asm_line(out, "cmp x0, x1")
    out = asm_line(out, "b.eq L_generated_value_move_slot_done")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "bl L_generated_value_release_owned_slot")
    out = asm_line(out, "ldp x9, x10, [x20]")
    out = asm_line(out, "stp x9, x10, [x19]")
    out = asm_line(out, "ldp x9, x10, [x20, #16]")
    out = asm_line(out, "stp x9, x10, [x19, #16]")
    out = asm_line(out, "ldp x9, x10, [x20, #32]")
    out = asm_line(out, "stp x9, x10, [x19, #32]")
    out = asm_line(out, "ldp x9, x10, [x20, #48]")
    out = asm_line(out, "stp x9, x10, [x19, #48]")
    out = asm_line(out, "ldp x9, x10, [x20, #64]")
    out = asm_line(out, "stp x9, x10, [x19, #64]")
    out = asm_line(out, "ldp x9, x10, [x20, #80]")
    out = asm_line(out, "stp x9, x10, [x19, #80]")
    out = asm_line(out, "ldp x9, x10, [x20, #96]")
    out = asm_line(out, "stp x9, x10, [x19, #96]")
    out = asm_line(out, "ldp x9, x10, [x20, #112]")
    out = asm_line(out, "stp x9, x10, [x19, #112]")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
