    out = asm_line(out, "bl L_normalize_slot_heap_raw")
    out = asm_line(out, "cbz w0, L_bfa_fail")
    out = asm_line(out, "lsl x12, x28, #7")
    out = asm_line(out, "add x13, x22, x12")
    out = asm_line(out, "strb w14, " + value_tag_x13)
    out = asm_line(out, "mov x10, #8")
    out = asm_line(out, "mul x10, x23, x10")
    out = asm_line(out, "add x11, sp, #136")
    out = asm_line(out, "add x11, x11, x10")
    out = asm_line(out, "mov x12, #1")
    out = asm_line(out, "str x12, [x11]")
    out = asm_line(out, "add x28, x28, #1")
    out = asm_line(out, "add x25, x25, #1")
    out = asm_line(out, "cmp x25, x24")
    out = asm_line(out, "b.eq L_bfa_expect_close")
    out = asm_label(out, "L_bfa_expect_comma")
    out = asm_line(out, "ldrb w9, [x19]")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.eq L_bfa_expect_comma_advance")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq L_bfa_expect_comma_advance")
    out = asm_line(out, "cmp w9, #41")
    out = asm_line(out, "b.eq L_bfa_loop")
    out = asm_line(out, "cmp w9, #44")
    out = asm_line(out, "b.ne L_bfa_fail")
    out = asm_line(out, "add x19, x19, #1")
    out = asm_line(out, "b L_bfa_loop")
    out = asm_label(out, "L_bfa_expect_comma_advance")
    out = asm_line(out, "add x19, x19, #1")
    out = asm_line(out, "b L_bfa_expect_comma")
    out = asm_label(out, "L_bfa_no_params")
    out = asm_label(out, "L_bfa_expect_close")
    out = asm_line(out, "ldrb w9, [x19]")
    out = asm_line(out, "cmp w9, #32")
    out = asm_line(out, "b.eq L_bfa_close_advance")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq L_bfa_close_advance")
    out = asm_line(out, "cmp w9, #41")
    out = asm_line(out, "b.ne L_bfa_fail")
    out = asm_line(out, "mov x2, x19")
    out = asm_line(out, "add x2, x2, #1")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "mov x1, x28")
    out = asm_line(out, "b L_bfa_return")
    out = asm_label(out, "L_bfa_close_advance")
    out = asm_line(out, "add x19, x19, #1")
    out = asm_line(out, "b L_bfa_expect_close")
    out = asm_label(out, "L_bfa_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_bfa_return")
    out = asm_line(out, "ldr x3, [sp, #264]")
    out = asm_line(out, "ldp x27, x28, [sp, #80]")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #320")
    out = asm_line(out, "ret")

    return out

def emit_darwin_aarch64_function_calls_component(out, target, usage_text, version_text, spec):
    state_active_stream_x15 = generated_state_active_stream_mem("x15")
    state_active_stream_x20 = generated_state_active_stream_mem("x20")
    state_asm_capacity_x20 = generated_state_asm_capacity_mem("x20")
    state_asm_length_x20 = generated_state_asm_length_mem("x20")
    state_assignment_base_x15 = generated_state_assignment_base_mem("x15")
    state_assignment_end_x15 = generated_state_assignment_end_mem("x15")
    state_source_base_x15 = generated_state_source_base_mem("x15")
    state_source_cursor_x15 = generated_state_source_cursor_mem("x15")
    value_tag_x0 = generated_value_tag_mem("x0")
    value_tag_x11 = generated_value_tag_mem("x11")
    value_tag_x12 = generated_value_tag_mem("x12")
    value_tag_x13 = generated_value_tag_mem("x13")
    value_tag_x15 = generated_value_tag_mem("x15")
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x24 = generated_value_tag_mem("x24")
    value_tag_x26 = generated_value_tag_mem("x26")
    value_tag_x28 = generated_value_tag_mem("x28")

    lowered_inventory_rows = lowered_function_inventory_rows(spec["lowered_function_inventory"])
    out = asm_label(out, "L_try_function_return_call")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "sub sp, sp, #4096")
    # Nested source-body execution can use temporary virtual-stack frames.
    # Anchor this long-lived call frame so all result/context slots are read
    # from their canonical addresses even if a nested failure path leaks a
    # temporary push.
    out = asm_line(out, "str x29, [sp, #4000]")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "str x30, [sp, #144]")
    out = asm_line(out, "stp x19, x20, [sp, #0]")
    out = asm_line(out, "stp x21, x22, [sp, #16]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #32]")
    out = asm_line(out, "stp x27, x28, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x25, x20")
    out = asm_line(out, "mov x28, x26")
    # Every evaluator destination in this frame is an initialized 128-byte
    # value slot. These regions are reused after AST materialization and can
    # otherwise retain token/record bytes that resemble owned heap metadata.
    out = asm_line(out, "add x0, sp, #2560")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #4096")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #4096")
    out = asm_line(out, "add x0, x0, #4096")
    out = asm_line(out, "add x0, x0, #3072")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "mov x11, #1")
    # Linux non-PIE descendants can receive valid brk-backed result slots
    # below 4 GiB. Retain the historical Darwin guard while accepting every
    # non-null userspace pointer above the unmapped guard page on x86-64.
    if target["os"] == "linux" and target["arch"] == "x86_64":
        out = asm_line(out, "lsl x11, x11, #12")
    else:
        out = asm_line(out, "lsl x11, x11, #32")
    out = asm_line(out, "cmp x28, x11")
    out = asm_line(out, "b.hs L_tfr_result_slot_ready")
    out = asm_line(out, "mov x0, #128")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_tfr_fail")
    out = asm_line(out, "mov x28, x0")
    out = asm_label(out, "L_tfr_result_slot_ready")
    out = asm_line(out, "str x28, [sp, #3840]")
    out = asm_line(out, "str xzr, [sp, #120]")
    out = asm_line(out, "str xzr, [sp, #3896]")
    out = asm_addr(out, target, "x15", "L_state_base_ptr")
    out = asm_line(out, "ldr x15, [x15]")
    out = asm_line(out, "cbz x15, L_tfr_context_saved")
    out = asm_line(out, "ldr x12, " + state_active_stream_x15)
    out = asm_line(out, "str x12, [sp, #3856]")
    out = asm_line(out, "ldr x12, " + state_source_cursor_x15)
    out = asm_line(out, "str x12, [sp, #3864]")
    out = asm_line(out, "ldr x12, " + state_assignment_base_x15)
    out = asm_line(out, "str x12, [sp, #3872]")
    out = asm_line(out, "ldr x12, " + state_assignment_end_x15)
    out = asm_line(out, "str x12, [sp, #3880]")
    out = asm_line(out, "ldr x12, " + state_source_base_x15)
    out = asm_line(out, "str x12, [sp, #3888]")
    out = asm_line(out, "mov x12, #1")
    out = asm_line(out, "str x12, [sp, #3896]")
    out = asm_label(out, "L_tfr_context_saved")
    out = asm_addr(out, target, "x15", "L_state_base_ptr")
    out = asm_line(out, "ldr x15, [x15]")
    out = asm_line(out, "cbz x15, L_tfr_try_lowered_return_call")
    out = asm_line(out, "ldr x20, " + state_assignment_base_x15)
    out = asm_line(out, "ldr x22, " + state_assignment_end_x15)
    out = asm_line(out, "ldr x21, " + state_source_base_x15)
    out = asm_line(out, "ldr x14, [x15, #2032]")
    out = asm_line(out, "cmp x14, #8")
    out = asm_line(out, "b.ge L_tfr_fail_no_depth")
    out = asm_line(out, "add x14, x14, #1")
    out = asm_line(out, "str x14, [x15, #2032]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_parse_call_head")
    out = asm_line(out, "cbz w0, L_tfr_fail_lowered_parse")
    out = asm_line(out, "add x10, sp, #2048")
    out = asm_line(out, "mov x11, x1")
    out = asm_line(out, "mov x12, #0")
    out = asm_label(out, "L_tfr_probe_lowered_name_copy")
    out = asm_line(out, "cmp x11, x2")
    out = asm_line(out, "b.eq L_tfr_probe_lowered_name_done")
    out = asm_line(out, "cmp x12, #120")
    out = asm_line(out, "b.gt L_tfr_fail")
    out = asm_line(out, "ldrb w9, [x11]")
    out = asm_line(out, "strb w9, [x10]")
    out = asm_line(out, "add x10, x10, #1")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "add x12, x12, #1")
    out = asm_line(out, "b L_tfr_probe_lowered_name_copy")
    out = asm_label(out, "L_tfr_probe_lowered_name_done")
    out = asm_line(out, "strb wzr, [x10]")
    lowered_probe_idx = 0
    while lowered_probe_idx < len(lowered_inventory_rows):
        lowered_name = lowered_function_inventory_field(lowered_inventory_rows[lowered_probe_idx], 0)
        out = asm_line(out, "add x0, sp, #2048")
        out = asm_addr(out, target, "x1", lowered_function_label("L_fn_", lowered_name))
        out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
        out = asm_line(out, "cbz w0, L_tfr_try_lowered_return_call")
        lowered_probe_idx = lowered_probe_idx + 1
    out = asm_label(out, "L_tfr_try_user_function_call")
    out = asm_addr(out, target, "x15", "L_state_base_ptr")
    out = asm_line(out, "ldr x15, [x15]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x15")
    out = asm_line(out, "bl L_lookup_function_call")
    out = asm_line(out, "cbz w0, L_tfr_try_object_method_return_call")
    out = asm_line(out, "str x1, [sp, #80]")
    out = asm_line(out, "str x2, [sp, #88]")
    out = asm_line(out, "str x3, [sp, #128]")
    out = asm_line(out, "str x4, [sp, #136]")
    out = asm_line(out, "mov x0, x4")
    out = asm_line(out, "mov x1, x3")
    out = asm_line(out, "cmp x20, #128")
    out = asm_line(out, "b.ge L_tfr_fail_slot_count")
    out = asm_line(out, "lsl x2, x20, #7")
    out = asm_line(out, "add x2, x21, x2")
    out = asm_line(out, "ldrb w9, [x2]")
    out = asm_line(out, "mov x5, x2")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "add x2, x2, #1")
    out = asm_line(out, "cbz w9, L_tfr_bind_args_no_target_reserve")
    out = asm_label(out, "L_tfr_bind_args_no_target_reserve")
    out = asm_line(out, "mov x3, x21")
    out = asm_line(out, "mov x4, x22")
    out = asm_line(out, "bl L_bind_function_args")
    out = asm_line(out, "cbz w0, L_tfr_fail_bind")
    out = asm_line(out, "mov x8, x3")
    out = asm_line(out, "str x1, [sp, #96]")
    out = asm_line(out, "str x2, [sp, #104]")
    out = asm_line(out, "ldr x23, [sp, #80]")
    out = asm_line(out, "ldr x24, [sp, #88]")
    out = asm_line(out, "ldr x20, [sp, #96]")
    out = asm_line(out, "ldr x0, [sp, #80]")
    out = asm_line(out, "ldr x1, [sp, #88]")
    out = asm_line(out, "ldr x2, [sp, #80]")
    out = asm_line(out, "mov x3, #1")
    out = asm_line(out, "mov x4, x22")
    out = asm_line(out, "mov x5, x21")
    out = asm_line(out, "mov x6, x20")
    out = asm_line(out, "mov x7, x28")
    out = asm_line(out, "bl L_execute_function_body_range")
    out = asm_line(out, "cbz w0, L_tfr_record_body_fallback")
    out = asm_line(out, "cmp w3, #4")
    out = asm_line(out, "b.eq L_tfr_user_raise")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x28, x2")
    out = asm_line(out, "ldrb w14, " + value_tag_x28)
    out = asm_line(out, "mov x0, x28")
    out = asm_line(out, "mov x1, x14")
    out = asm_line(out, "bl L_normalize_slot_heap_raw")
    out = asm_line(out, "cbz w0, L_tfr_fail")
    out = asm_line(out, "str x28, [sp, #112]")
    out = asm_line(out, "mov x13, #1")
    out = asm_line(out, "str x13, [sp, #120]")
    out = asm_line(out, "ldr x0, [sp, #104]")
    out = asm_line(out, "mov w3, #0")
    out = asm_line(out, "b L_tfr_return")
    out = asm_label(out, "L_tfr_user_raise")
    out = asm_line(out, "ldr x0, [sp, #104]")
    out = asm_line(out, "str xzr, [sp, #120]")
    out = asm_line(out, "mov w3, #4")
    out = asm_line(out, "b L_tfr_return")
    out = asm_label(out, "L_tfr_record_body_fallback")
    out = asm_line(out, "ldr x23, [sp, #80]")
    out = asm_line(out, "ldr x24, [sp, #88]")
    out = asm_line(out, "ldr x20, [sp, #96]")

    out = asm_label(out, "L_tfr_body_loop")
    out = asm_line(out, "cmp x23, x24")
    out = asm_line(out, "b.hs L_tfr_fail_body_end")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "add x1, sp, #192")
    out = asm_line(out, "bl L_next_source_line")
    out = asm_line(out, "mov x27, x0")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl L_next_line_index")
    out = asm_line(out, "mov x26, x0")
    out = asm_line(out, "cmp x26, x23")
    out = asm_line(out, "b.eq L_tfr_fail_next_line")
    out = asm_line(out, "mov x0, x27")
    out = asm_line(out, "add x1, sp, #1536")
    out = asm_line(out, "bl L_parse_statement")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.eq L_tfr_advance")
    out = asm_line(out, "cmp w0, #2")
    out = asm_line(out, "b.eq L_tfr_assign_line")
    out = asm_line(out, "cmp w0, #4")
    out = asm_line(out, "b.eq L_tfr_if_line")
    out = asm_line(out, "cmp w0, #8")
    out = asm_line(out, "b.eq L_tfr_skip_nested_line")
    out = asm_line(out, "cmp w0, #9")
    out = asm_line(out, "b.eq L_tfr_return_line")
    out = asm_line(out, "cmp w0, #10")
    out = asm_line(out, "b.eq L_tfr_skip_nested_line")
    out = asm_line(out, "cmp w0, #11")
    out = asm_line(out, "b.eq L_tfr_skip_nested_line")
    out = asm_line(out, "cmp w0, #12")
    out = asm_line(out, "b.eq L_tfr_call_line")
    out = asm_line(out, "cmp w0, #13")
    out = asm_line(out, "b.eq L_tfr_for_line")
    out = asm_line(out, "b L_tfr_fail_parse_stmt")

    out = asm_label(out, "L_tfr_advance")
    out = asm_line(out, "mov x23, x26")
    out = asm_line(out, "b L_tfr_body_loop")

    out = asm_label(out, "L_tfr_assign_line")
    out = asm_line(out, "cmp x20, #128")
    out = asm_line(out, "b.ge L_tfr_fail")
    out = asm_line(out, "lsl x9, x20, #7")
    out = asm_line(out, "add x1, x21, x9")
    out = asm_line(out, "add x2, x22, x9")
    out = asm_line(out, "mov x0, x27")
    out = asm_line(out, "mov x3, x20")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "str x26, [sp, #136]")
    out = asm_line(out, "bl L_lower_assign_line")
    out = asm_line(out, "ldr x26, [sp, #136]")
    out = asm_line(out, "cbz w0, L_tfr_fail")
    out = asm_line(out, "cbz w1, L_tfr_assign_existing")
    out = asm_line(out, "add x20, x20, x1")
    out = asm_label(out, "L_tfr_assign_existing")
    out = asm_line(out, "mov x23, x26")
    out = asm_line(out, "b L_tfr_body_loop")

    out = asm_label(out, "L_tfr_call_line")
    out = asm_line(out, "str x26, [sp, #184]")
    out = asm_line(out, "add x0, sp, #1536")
    out = asm_line(out, "ldr x2, [sp, #80]")
    out = asm_line(out, "mov x6, x20")
    out = asm_line(out, "mov x7, x28")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "bl L_execute_statement_call_record")
    out = asm_line(out, "ldr x26, [sp, #184]")
    out = asm_line(out, "cbz w0, L_tfr_fail")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x28, x2")
    out = asm_line(out, "mov x23, x26")
    out = asm_line(out, "b L_tfr_body_loop")

    out = asm_label(out, "L_tfr_for_line")
    out = asm_line(out, "str x26, [sp, #184]")
    out = asm_line(out, "add x0, sp, #1536")
    out = asm_line(out, "str x26, [x0, #128]")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "add x2, sp, #2048")
    out = asm_line(out, "add x3, sp, #4096")
    out = asm_line(out, "mov x4, #96")
    out = asm_line(out, "bl L_statement_record_materialize_body_children")
    out = asm_line(out, "cbz w0, L_tfr_fail")
    out = asm_line(out, "add x0, sp, #1536")
    out = asm_line(out, "ldr x2, [sp, #80]")
    out = asm_line(out, "mov x6, x20")
    out = asm_line(out, "mov x7, x28")
    out = asm_line(out, "mov x8, #2")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "bl L_execute_for_record")
    out = asm_line(out, "cbz w0, L_tfr_fail")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x28, x2")
    out = asm_line(out, "cbnz w3, L_tfr_fail")
    out = asm_line(out, "ldr x26, [sp, #184]")
    out = asm_line(out, "mov x0, x26")
    out = asm_line(out, "mov x1, x27")
    out = asm_line(out, "bl L_skip_nested_block")
    out = asm_line(out, "mov x23, x0")
    out = asm_line(out, "b L_tfr_body_loop")

    out = asm_label(out, "L_tfr_if_line")
    out = asm_line(out, "mov x0, x27")
    out = asm_line(out, "mov x3, x20")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "bl L_eval_control_condition")
