    out = asm_line(out, "strb w9, [x20, #3]")
    out = asm_line(out, "strb wzr, [x20, #4]")
    out = asm_line(out, "mov w9, #4")
    out = asm_line(out, "strb w9, " + value_tag_x20)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_tcp_close_return")
    out = asm_label(out, "L_native_tcp_close_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_tcp_close_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    return out

def emit_darwin_aarch64_compiler_cli_data_sections(out, target, usage_text, version_text, spec):
    lowered_function_inventory = spec["lowered_function_inventory"]
    out = asm_section(out, target["data_section"])
    out = asm_label(out, "L_state_base_ptr")
    out = asm_raw(out, ".quad 0\n")
    out = asm_label(out, "L_saved_platform_x18")
    out = asm_raw(out, ".quad 0\n")
    out = asm_label(out, "L_active_output_stream_ptr")
    out = asm_raw(out, ".quad 0\n")
    out = asm_label(out, generated_active_compiler_source_label())
    out = asm_raw(out, ".quad 0\n")
    out = asm_label(out, "L_cli_extension_mode")
    out = asm_raw(out, ".quad 1\n")
    out = asm_label(out, "L_cli_dynamic_extension_mode")
    out = asm_raw(out, ".quad 0\n")
    out = asm_label(out, "L_cli_extension_root_ptr")
    out = asm_raw(out, ".quad 0\n")

    out = asm_section(out, target["rodata_section"])
    out = asm_cstr(out, "L_help_flag", spec["help_flag"])
    out = asm_cstr(out, "L_version_flag", spec["version_flag"])
    out = asm_cstr(out, "L_build_flag", spec["build_flag"])
    out = asm_cstr(out, "L_out_flag", spec["out_flag"])
    out = asm_cstr(out, "L_ext_dir_flag", "--ext-dir")
    out = asm_cstr(out, "L_ext_static_off_flag", "--ext-static=off")
    out = asm_cstr(out, "L_ext_static_auto_flag", "--ext-static=auto")
    out = asm_cstr(out, "L_ext_static_required_flag", "--ext-static=required")
    out = asm_cstr(out, "L_ext_dynamic_off_flag", "--ext-dynamic=off")
    out = asm_cstr(out, "L_ext_dynamic_allowed_flag", "--ext-dynamic=allowed")
    out = asm_cstr(out, "L_cli_default_extension_root", "./extensions")
    out = asm_cstr(out, "L_mode_r", "r")
    out = asm_cstr(out, "L_mode_w", "w")
    out = asm_cstr(out, "L_err_lowered_fn_not_found", "error: lowered helper function not found")
    out = asm_cstr(out, "L_err_lowered_arity_mismatch", "error: lowered helper arity mismatch")
    out = asm_cstr(out, "L_err_lowered_helper_prefix", "helper:")
    out = asm_cstr(out, "L_err_lowered_expected_prefix", "expected:")
    out = asm_cstr(out, "L_err_lowered_actual_prefix", "actual:")
    out = asm_cstr(out, "L_err_lowered_helper_failed_prefix", "error: lowered helper body returned failure")
    out = asm_cstr(out, "L_err_lowered_stmt_call_failed", "error: lowered statement-call dispatch failed")
    out = asm_cstr(out, "L_err_lowered_stage_prefix", "stage:")
    out = asm_cstr(out, "L_err_build_native_stage", "error: generated build_native failed at stage")
    out = asm_cstr(out, "L_err_method_append_fail_code", "error: method_append fail code")
    out = asm_cstr(out, "L_err_function_body_materialize_failed", "error: generated function body materialization failed")
    out = asm_cstr(out, "L_err_function_body_child_failed", "error: generated function body child execution failed")
    out = asm_cstr(out, "L_err_child_assign_failed", "error: generated child assignment failed")
    out = asm_cstr(out, "L_err_child_precheck_kind_failed", "error: generated child precheck unknown statement kind")
    out = asm_cstr(out, "L_err_child_precheck_control_context_failed", "error: generated child precheck control outside loop")
    out = asm_cstr(out, "L_err_child_precheck_return_context_failed", "error: generated child precheck return outside return-enabled body")
    out = asm_cstr(out, "L_err_child_precheck_leaf_body_failed", "error: generated child precheck leaf unexpectedly has body")
    out = asm_cstr(out, "L_err_child_precheck_block_body_failed", "error: generated child precheck block missing body")
    out = asm_cstr(out, "L_err_child_call_failed", "error: generated child statement call failed")
    out = asm_cstr(out, "L_err_def_no_body", "error: generated def registration missing body")
    out = asm_cstr(out, "L_err_def_skip_block", "error: generated def registration block-end scan failed")
    out = asm_cstr(out, "L_err_def_no_state", "error: generated def registration missing state")
    out = asm_cstr(out, "L_err_def_register", "error: generated def registration failed")
    out = asm_cstr(out, "L_err_child_condition_failed", "error: generated child condition failed")
    out = asm_cstr(out, "L_err_child_unsupported_stmt", "error: generated child unsupported statement")
    out = asm_cstr(out, "L_err_statement_call_record_failed", "error: generated statement-call record failed")
    out = asm_cstr(out, "L_err_while_no_body", "error: generated while statement missing body")
    out = asm_cstr(out, "L_err_while_materialize", "error: generated while statement body materialization failed")
    out = asm_cstr(out, "L_err_while_empty_body", "error: generated while statement body materialized zero children")
    out = asm_cstr(out, "L_err_while_guard", "error: generated while statement iteration guard exceeded")
    out = asm_cstr(out, "L_err_while_condition", "error: generated while statement condition failed")
    out = asm_cstr(out, "L_err_while_child", "error: generated while statement child execution failed")
    out = asm_cstr(out, "L_builtin_fail_name", "fail")
    out = asm_cstr(out, "L_builtin_print_name", "print")
    out = asm_cstr(out, "L_fn_sum", "sum")
    out = asm_cstr(out, "L_err_builtin_fail_called", "error: generated fail() called")
    out = asm_cstr(out, "L_err_for_no_body", "error: generated for statement missing body")
    out = asm_cstr(out, "L_err_for_header_overflow", "error: generated for statement header overflow")
    out = asm_cstr(out, "L_err_for_no_children_count", "error: generated for statement body child count missing")
    out = asm_cstr(out, "L_err_for_no_children_ptr", "error: generated for statement body child pointer missing")
    out = asm_cstr(out, "L_err_for_condition_failed", "error: generated for statement condition/iterator failed")
    out = asm_cstr(out, "L_err_for_child_exec_failed", "error: generated for statement child execution failed")
    out = asm_cstr(out, "L_err_for_iter_guard", "error: generated for statement iteration guard exceeded")
    out = asm_cstr(out, "L_err_enum_outer_open", "error: generated enumerate iterator missing outer open paren")
    out = asm_cstr(out, "L_err_enum_arg", "error: generated enumerate iterator unsupported argument")
    out = asm_cstr(out, "L_err_enum_outer_close", "error: generated enumerate iterator missing outer close paren")
    out = asm_cstr(out, "L_err_enum_first_slot", "error: generated enumerate first target slot allocation failed")
    out = asm_cstr(out, "L_err_enum_pair_seek", "error: generated enumerate pair seek failed")
    out = asm_cstr(out, "L_err_enum_index_copy", "error: generated enumerate index copy failed")
    out = asm_cstr(out, "L_err_enum_second_slot", "error: generated enumerate second target slot allocation failed")
    out = asm_cstr(out, "L_err_pair_first_slot", "error: generated pair first target slot allocation failed")
    out = asm_cstr(out, "L_err_pair_seek", "error: generated pair item seek failed")
    out = asm_cstr(out, "L_err_pair_key_copy", "error: generated pair key copy failed")
    out = asm_cstr(out, "L_err_pair_second_slot", "error: generated pair second target slot allocation failed")
    out = asm_cstr(out, "L_err_helper_body_failed", "error: lowered helper body returned failure")
    out = asm_cstr(out, "L_err_native_read_text_file", "error: native read_text_file failed")
    out = asm_cstr(out, "L_err_native_write_text_file", "error: native write_text_file failed")
    out = asm_cstr(out, "L_err_tfr_no_depth", "error: return-call executor recursion depth exhausted")
    out = asm_cstr(out, "L_err_tfr_lookup", "error: return-call executor user function lookup failed")
    out = asm_cstr(out, "L_err_tfr_lambda_parse", "error: return-call executor lambda parse failed")
    out = asm_cstr(out, "L_err_tfr_lambda_slot", "error: return-call executor lambda slot lookup failed")
    out = asm_cstr(out, "L_err_tfr_lambda_kind", "error: return-call executor lambda slot kind mismatch")
    out = asm_cstr(out, "L_err_tfr_bind", "error: return-call executor argument bind failed")
    out = asm_cstr(out, "L_err_tfr_body_end", "error: return-call executor reached function body end")
    out = asm_cstr(out, "L_err_tfr_slot_count", "error: return-call executor slot capacity exhausted")
    out = asm_cstr(out, "L_err_tfr_next_line", "error: return-call executor next-line failed")
    out = asm_cstr(out, "L_err_tfr_parse_stmt", "error: return-call executor statement parse failed")
    out = asm_cstr(out, "L_err_tfr_return_resolve", "error: return-call executor return expression resolve failed")
    out = asm_cstr(out, "L_err_tfr_multi_arg_eval", "error: return-call executor multi-arg evaluation failed")
    out = asm_cstr(out, "L_err_tfr_multi_arg_dispatch", "error: return-call executor multi-arg dispatch failed")
    out = asm_cstr(out, "L_err_tfr_return_eval_general", "error: return-call executor general return expression evaluation failed")
    out = asm_cstr(out, "L_err_tfr_return_expr_copy_overflow", "error: return-call executor return expression copy overflow")
    out = asm_cstr(out, "L_err_tfr_return_normalize", "error: return-call executor return normalization failed")
    out = asm_cstr(out, "L_err_tfr_lowered_parse", "error: return-call executor lowered-call parse failed")
    out = asm_cstr(out, "L_err_tfr_read_text_file_bad_result", "error: read_text_file returned non-string result tag")
    out = asm_cstr(out, "L_err_tfr_lowered_inline_dispatch", "error: return-call executor lowered inline dispatch failed")
    out = asm_cstr(out, "L_err_tfr_lowered_inline_normalize", "error: return-call executor lowered inline normalization failed")
    out = asm_cstr(out, "L_err_tfr_lowered_arg_slot_miss", "error: return-call executor lowered arg slot miss")
    out = asm_cstr(out, "L_err_tfr_generic", "error: return-call executor generic failure")
    out = asm_cstr(out, "L_err_ear_generic", "error: expression AST evaluator generic failure")
    out = asm_cstr(out, "L_err_ear_postfix_base", "error: expression AST postfix base resolution failed")
    out = asm_cstr(out, "L_err_ear_postfix_apply", "error: expression AST postfix application failed")
    out = asm_cstr(out, "L_err_raa_index_var_find", "error: index variable lookup failed")
    out = asm_cstr(out, "L_err_raa_index_var_type", "error: index variable has unsupported type")
    out = asm_cstr(out, "L_err_raa_index_var_uint", "error: index variable text parse failed")
    out = asm_cstr(out, "L_err_raa_index_var_bound", "error: index variable bound check failed")
    out = asm_cstr(out, "L_err_raa_string_index", "error: string index resolution failed")
    out = asm_cstr(out, "L_err_raa_generic", "error: resolve-assignment atom generic failure")
    out = asm_cstr(out, "L_build_native_input_param_name", lowered_function_inventory_param(lowered_function_inventory, "build_native", 0))
    out = asm_cstr(out, "L_build_native_output_param_name", lowered_function_inventory_param(lowered_function_inventory, "build_native", 1))
    out = asm_cstr(out, "L_read_file_param_name", "path")
    out = asm_cstr(out, "L_make_asm_path_suffix", spec["make_asm_path_suffix"])
    out = asm_cstr(out, "L_make_asm_path_param_name", lowered_function_inventory_param(lowered_function_inventory, "make_asm_path", 0))
    out = asm_cstr(out, "L_tok_print", "print")
    out = asm_cstr(out, "L_tok_if", "if")
    out = asm_cstr(out, "L_tok_while", "while")
    out = asm_cstr(out, "L_tok_for", "for")
    out = asm_cstr(out, "L_tok_break", "break")
    out = asm_cstr(out, "L_tok_continue", "continue")
    out = asm_cstr(out, "L_tok_def", "def")
    out = asm_cstr(out, "L_tok_return", "return")
    out = asm_cstr(out, "L_tok_else", "else")
    out = asm_cstr(out, "L_tok_elif", "elif")
    out = asm_cstr(out, "L_tok_with", "with")
    out = asm_cstr(out, "L_tok_raise", "raise")
    out = asm_cstr(out, "L_tok_class", "class")
    out = asm_cstr(out, "L_tok_try", "try")
    out = asm_cstr(out, "L_tok_except", "except")
    out = asm_cstr(out, "L_tok_finally", "finally")
    out = asm_cstr(out, "L_tok_yield", "yield")
    out = asm_cstr(out, "L_tok_cli_main", "cli_main")
    out = asm_cstr(out, "L_tok_def_cli_main", "def cli_main")
    out = asm_cstr(out, "L_true_text", "True")
    out = asm_cstr(out, "L_false_text", "False")
    out = asm_cstr(out, "L_none_text", "none")
    out = asm_cstr(out, "L_fmt_long", "%ld")
    out = asm_cstr(out, "L_cmd_prefix", "cc ")
    out = asm_cstr(out, "L_cmd_assemble_prefix", "cc -c ")
    out = asm_cstr(out, "L_cmd_space", " ")
    out = asm_cstr(out, "L_cmd_ldl", " -ldl")
    out = asm_cstr(out, "L_cmd_middle", " -o ")
    out = asm_cstr(out, "L_cmd_object_suffix", ".o")
    out = asm_cstr(out, "L_asm_indent", "    ")
    out = asm_cstr(out, "L_runtime_newline", "\n")
    out = asm_cstr(out, "L_colon_newline", ":\n")
    out = asm_cstr(out, "L_token_kind_prefix", "kind=")
    out = asm_cstr(out, "L_asciz_quote", ".asciz \"")
    out = asm_cstr(out, "L_quote_newline", "\"\n")
    # Runtime probes use stable name constants even when a focused fixture does
    # not inventory the corresponding source function. Inventory-owned L_fn_*
    # labels remain unique and are emitted only by the inventory pass below.
    out = asm_cstr(out, "L_runtime_fn_build_compiler_cli_native", "build_compiler_cli_native")
    out = asm_cstr(out, "L_runtime_fn_token_kind_at", "token_kind_at")
    out = asm_cstr(out, "L_runtime_fn_token_text_at", "token_text_at")
    out = asm_cstr(out, "L_runtime_fn_token_value_at", "token_value_at")
    # The lowered-function inventory is authoritative for all function and
    # parameter name data. Compatibility labels here used to mask incomplete
    # inventories; retaining them now creates duplicate symbols in descendants.
    out = emit_lowered_function_inventory_name_data(out, lowered_function_inventory)
    out = asm_section(out, target["data_section"])
    out = asm_dir(out, ".p2align 3")
    out = asm_label(out, "L_print_expr_scratch")
    out = asm_dir(out, ".space 128")
    out = asm_dir(out, ".p2align 3")
    out = asm_label(out, "L_lowered_fn_table")
    out = emit_lowered_function_inventory_table(out, lowered_function_inventory)
    out = asm_dir(out, ".quad 0, 0")
    out = asm_section(out, target["rodata_section"])
    out = asm_cstr(out, "L_payload_newline", "\\n")
    out = asm_cstr(out, "L_payload_space", " ")
    out = asm_cstr(out, "L_version_text", version_text)
    out = asm_cstr(out, "L_unsupported_text", "unsupported compiler invocation or compiler-source build failed")
    out = asm_cstr(out, "L_usage_text", usage_text)
    return out

def emit_darwin_aarch64_compiler_cli_asm_into(out, target, usage_text, version_text, spec):
    plan = collect_compiler_asm_section_plan(target, spec)
    emit_compiler_asm_section_plan(out, plan, target, spec)
    emit_darwin_aarch64_compiler_cli_data_sections(out, target, usage_text, version_text, spec)
    return out

def emit_darwin_aarch64_compiler_cli_asm(target, usage_text, version_text, spec):
    return emit_darwin_aarch64_compiler_cli_asm_into("", target, usage_text, version_text, spec)
