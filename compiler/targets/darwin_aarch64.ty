    asm_line(out, "stp x29, x30, [sp, #-32]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "cbz x19, L_asm_writer_release_done")
    asm_line(out, "ldr x9, [x19, #24]")
    asm_line(out, "cbz x9, L_asm_writer_release_done")
    asm_line(out, "sub x9, x9, #1")
    asm_line(out, "str x9, [x19, #24]")
    asm_line(out, "cbnz x9, L_asm_writer_release_done")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "cbz x0, L_asm_writer_release_free")
    asm_line(out, "bl " + fclose_call)
    asm_label(out, "L_asm_writer_release_free")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl " + free_call)
    asm_label(out, "L_asm_writer_release_done")
    asm_line(out, "ldr x19, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #32")
    asm_line(out, "ret")

