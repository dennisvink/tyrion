    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_generated_value_release_owned_slot")
    out = asm_line(out, "add sp, sp, #128")
    out = asm_line(out, "cbz w25, L_ear_membership_false")
    out = asm_line(out, "b L_ear_membership_true")

    out = asm_label(out, "L_ear_membership_typed")
    out = asm_line(out, "ldr x9, [x12]")
    out = asm_line(out, "str x9, [sp, #16]")
    out = asm_line(out, "ldr x9, [x12, #8]")
    out = asm_line(out, "str x9, [sp, #24]")
    out = asm_line(out, "str xzr, [sp, #32]")
    out = asm_label(out, "L_ear_membership_typed_loop")
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "ldr x10, [sp, #24]")
    out = asm_line(out, "cmp x9, x10")
