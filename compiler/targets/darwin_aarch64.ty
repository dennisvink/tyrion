    out = asm_label(out, "L_nshr_force_heap_list")
    out = asm_line(out, "mov x9, #9")
    out = asm_line(out, "str x9, [sp, #16]")
    out = asm_line(out, "b L_nshr_force_heap_list_raw")
    out = asm_label(out, "L_nshr_force_heap_list_raw")
    out = asm_line(out, "b L_nshr_len_start")
    out = asm_label(out, "L_nshr_force_heap_dict")
