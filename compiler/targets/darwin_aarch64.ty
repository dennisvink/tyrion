    asm_line(out, "ldr x10, [sp, #48]")
    asm_line(out, "str x10, [x21, #8]")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_asm_writer_append_cstr_return")
    asm_label(out, "L_asm_writer_append_cstr_string")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, L_asm_writer_append_cstr_fail")
    asm_line(out, "mov x21, x0")
    asm_line(out, "mov x22, x1")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl " + strlen_call)
    asm_line(out, "str x0, [sp, #48]")
    asm_line(out, "adds x0, x22, x0")
    asm_line(out, "b.cs L_asm_writer_append_cstr_fail")
    asm_line(out, "str x0, [sp, #64]")
    asm_line(out, "adds x0, x0, #1")
    asm_line(out, "b.cs L_asm_writer_append_cstr_fail")
    asm_line(out, "bl " + malloc_call)
    asm_line(out, "cbz x0, L_asm_writer_append_cstr_fail")
    asm_line(out, "str x0, [sp, #56]")
    asm_line(out, "mov x1, x21")
    asm_line(out, "mov x2, x22")
    asm_line(out, "bl " + memcpy_call)
    asm_line(out, "ldr x0, [sp, #56]")
    asm_line(out, "add x0, x0, x22")
    asm_line(out, "mov x1, x20")
    asm_line(out, "ldr x2, [sp, #48]")
    asm_line(out, "bl " + memcpy_call)
    asm_line(out, "ldr x9, [sp, #64]")
    asm_line(out, "ldr x10, [sp, #56]")
    asm_line(out, "strb wzr, [x10, x9]")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_generated_value_release_owned_slot")
    asm_line(out, "ldr x10, [sp, #56]")
    asm_line(out, "ldr x9, [sp, #64]")
    asm_line(out, "str x10, [x19]")
    asm_line(out, "str x9, [x19, #8]")
    asm_line(out, "mov w9, #8")
    asm_line(out, "strb w9, " + value_tag_x19)
    asm_line(out, "mov w9, #1")
    asm_line(out, "strb w9, " + value_owner_x19)
