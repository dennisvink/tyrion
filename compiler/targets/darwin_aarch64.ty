    out = asm_line(out, "lsl x11, x9, #7")
    out = asm_line(out, "add x0, x10, x11")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, L_ear_membership_typed_next")
    out = asm_line(out, "ldr x10, [sp, #8]")
    out = asm_line(out, "cmp x1, x10")
    out = asm_line(out, "b.ne L_ear_membership_typed_next")
    out = asm_line(out, "mov x2, x1")
    out = asm_line(out, "mov x1, x0")
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cbz w0, L_ear_membership_true")
    out = asm_label(out, "L_ear_membership_typed_next")
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "str x9, [sp, #32]")
    out = asm_line(out, "b L_ear_membership_typed_loop")
    out = asm_label(out, "L_ear_membership_true")
    out = asm_line(out, "mov x11, #1")
    out = asm_line(out, "add sp, sp, #64")
    out = asm_line(out, "b L_ear_bool_write")
    out = asm_label(out, "L_ear_membership_false")
    out = asm_line(out, "mov x11, #0")
    out = asm_line(out, "add sp, sp, #64")
    out = asm_line(out, "b L_ear_bool_write")
    out = asm_label(out, "L_ear_membership_fail")
    out = asm_line(out, "add sp, sp, #64")
    out = asm_line(out, "b L_ear_fail")

    out = asm_label(out, "L_ear_apply_plus")
    out = asm_line(out, "ldr x10, [sp, #72]")
    out = asm_line(out, "cmp x10, #" + "17")
    out = asm_line(out, "b.eq L_ear_apply_writer_plus")
    out = asm_line(out, "cmp x10, #1")
    out = asm_line(out, "b.eq L_ear_apply_concat")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.eq L_ear_apply_concat")
    out = asm_line(out, "ldr x10, [sp, #80]")
    out = asm_line(out, "cmp x10, #1")
    out = asm_line(out, "b.eq L_ear_apply_concat")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.eq L_ear_apply_concat")
    out = asm_line(out, "ldr x10, [sp, #72]")
    out = asm_line(out, "cmp x10, #3")
    out = asm_line(out, "b.eq L_ear_apply_int_arith")
    out = asm_line(out, "cmp x10, #4")
    out = asm_line(out, "b.eq L_ear_apply_int_arith")
    out = asm_line(out, "ldr x10, [sp, #80]")
    out = asm_line(out, "cmp x10, #3")
    out = asm_line(out, "b.eq L_ear_apply_int_arith")
    out = asm_line(out, "cmp x10, #4")
    out = asm_line(out, "b.eq L_ear_apply_int_arith")
    out = asm_line(out, "ldrb w9, [sp, #128]")
    out = asm_line(out, "cmp w9, #48")
    out = asm_line(out, "b.lt L_ear_apply_concat")
    out = asm_line(out, "cmp w9, #57")
    out = asm_line(out, "b.gt L_ear_apply_concat")
    out = asm_line(out, "ldrb w9, [sp, #384]")
    out = asm_line(out, "cmp w9, #48")
    out = asm_line(out, "b.lt L_ear_apply_concat")
    out = asm_line(out, "cmp w9, #57")
    out = asm_line(out, "b.gt L_ear_apply_concat")
    out = asm_line(out, "b L_ear_apply_int_arith")
    out = asm_label(out, "L_ear_apply_minus")
    out = asm_label(out, "L_ear_apply_mul")
    out = asm_label(out, "L_ear_apply_div")
    out = asm_line(out, "b L_ear_apply_int_arith")

    out = asm_label(out, "L_ear_apply_writer_plus")
    out = asm_line(out, "ldr x10, [sp, #80]")
    out = asm_line(out, "cmp x10, #1")
    out = asm_line(out, "b.eq L_ear_writer_plus_right_inline")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.ne L_ear_fail")
    out = asm_line(out, "b L_ear_writer_plus_slots_ready")
    out = asm_label(out, "L_ear_writer_plus_right_inline")
    out = asm_line(out, "mov w9, #1")
    out = asm_line(out, "strb w9, [sp, #511]")
    out = asm_label(out, "L_ear_writer_plus_slots_ready")
    out = asm_line(out, "add x0, sp, #128")
