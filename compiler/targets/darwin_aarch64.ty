    out = asm_label(out, "L_asv_done")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_asv_heap_alias")
    out = asm_line(out, "ldr x9, [x12]")
    out = asm_line(out, "ldr x10, [x12, #8]")
    out = asm_line(out, "mov x11, x9")
    out = asm_line(out, "mov x12, #0")
    out = asm_label(out, "L_asv_heap_copy_loop")
    out = asm_line(out, "cmp x12, x10")
    out = asm_line(out, "b.hs L_asv_heap_copy_done")
