def emit_darwin_aarch64_child_record_epilogue_runtime(out, target):
    out = asm_label(out, "L_ecr_propagate")
    out = asm_line(out, "b L_ecr_signal")
    out = asm_label(out, "L_ecr_signal")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "mov x2, x28")
    out = asm_line(out, "b L_ecr_return")
    out = asm_label(out, "L_ecr_next")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "b L_ecr_loop")
    out = asm_label(out, "L_ecr_success")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "mov w3, #0")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "mov x2, x28")
    out = asm_line(out, "b L_ecr_return")
    out = asm_label(out, "L_ecr_unsupported")
    out = asm_addr(out, target, "x0", "L_err_child_unsupported_stmt")
    out = asm_line(out, "bl " + asm_call_name(target, "puts"))
    # Child statement records store a bounded source span in words zero and
    # one. The old diagnostic interpreted the length as a second source
    # pointer and could fault while reporting the original lowering failure.
    out = asm_line(out, "ldr x25, [sp, #104]")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "ldr x1, [x25]")
    out = asm_line(out, "ldr x2, [x25, #8]")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, #2")
    out = asm_addr(out, target, "x1", "L_ecr_unsupported_newline")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_ecr_return")
    out = asm_line(out, "ldp x27, x28, [sp, #80]")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")
    out = asm_cstr(out, "L_ecr_unsupported_newline", "\n")
    out = asm_line(out, ".p2align 2")

    return out

