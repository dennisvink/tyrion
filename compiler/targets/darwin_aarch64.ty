def emit_darwin_aarch64_string_copy_runtime(out, target):
    out = asm_label(out, "L_string_copy")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        # Non-PIE x86 static labels are valid pointers below 2^32, where the
        # AArch64-oriented packed-text classifier expects only packed bytes.
        # Probe the source page before applying the shared numeric heuristic.
        out = asm_line(out, "sub sp, sp, #48")
        out = asm_line(out, "str x30, [sp]")
        out = asm_line(out, "str x0, [sp, #8]")
        out = asm_line(out, "str x1, [sp, #16]")
        out = asm_line(out, "lsr x0, x1, #12")
        out = asm_line(out, "lsl x0, x0, #12")
        out = asm_line(out, "mov x1, #1")
        out = asm_line(out, "lsl x1, x1, #12")
        out = asm_line(out, "add x2, sp, #32")
        out = asm_line(out, "bl " + asm_call_name(target, "mincore"))
        out = asm_line(out, "cbnz w0, L_string_copy_x86_packed")
        out = asm_line(out, "ldr x1, [sp, #16]")
        out = asm_line(out, "ldr x0, [sp, #8]")
        out = asm_line(out, "ldr x30, [sp]")
        out = asm_line(out, "add sp, sp, #48")
        out = asm_line(out, "mov x2, x0")
        out = asm_line(out, "b L_string_copy_loop")
        out = asm_label(out, "L_string_copy_x86_packed")
        out = asm_line(out, "ldr x1, [sp, #16]")
        out = asm_line(out, "ldr x0, [sp, #8]")
        out = asm_line(out, "ldr x30, [sp]")
        out = asm_line(out, "add sp, sp, #48")
        out = asm_line(out, "mov x2, x0")
        out = asm_line(out, "b L_string_copy_packed")
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x10, x1")
    out = asm_line(out, "lsr x11, x10, #48")
    out = asm_line(out, "cbnz x11, L_string_copy_packed")
    out = asm_line(out, "mov x11, #1")
    out = asm_line(out, "lsl x11, x11, #32")
    out = asm_line(out, "cmp x10, x11")
    out = asm_line(out, "b.lo L_string_copy_packed")
    if target["os"] == "linux":
        # Linux/AArch64 places heap and stack pointers in the upper canonical
        # user window. Packed ASCII remains below bit 47.
        out = asm_line(out, "mov x11, #1")
        out = asm_line(out, "lsl x11, x11, #47")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.hs L_string_copy_loop")
        out = asm_line(out, "b L_string_copy_packed")
    else:
        # Darwin uses both low image/stack addresses and high nano-malloc
        # addresses. Values below the high packed-text window are pointers;
        # treating every address at or above 2^38 as packed text turns common
        # 0x6000... heap pointers into empty strings when their low byte is 0.
        out = asm_line(out, "mov x11, #1")
        out = asm_line(out, "lsl x11, x11, #38")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.lo L_string_copy_loop")
        out = asm_line(out, "mov x11, #4")
        out = asm_line(out, "lsl x11, x11, #44")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.lo L_string_copy_loop")
        out = asm_line(out, "mov x11, #6")
        out = asm_line(out, "lsl x11, x11, #44")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.lo L_string_copy_packed")
    out = asm_label(out, "L_string_copy_loop")
    out = asm_line(out, "ldrb w9, [x1], #1")
    out = asm_line(out, "strb w9, [x0], #1")
    out = asm_line(out, "cbnz w9, L_string_copy_loop")
    out = asm_line(out, "mov x0, x2")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_string_copy_packed")
    out = asm_line(out, "mov x12, #0")
    out = asm_label(out, "L_string_copy_packed_loop")
    out = asm_line(out, "and w9, w10, #255")
    out = asm_line(out, "strb w9, [x0], #1")
    out = asm_line(out, "cbz w9, L_string_copy_packed_done")
    out = asm_line(out, "lsr x10, x10, #8")
    out = asm_line(out, "add x12, x12, #1")
    out = asm_line(out, "cmp x12, #8")
    out = asm_line(out, "b.lt L_string_copy_packed_loop")
    out = asm_line(out, "strb wzr, [x0]")
    out = asm_label(out, "L_string_copy_packed_done")
    out = asm_line(out, "mov x0, x2")
    out = asm_line(out, "ret")

    out = asm_label(out, "L_string_append")
    out = asm_line(out, "mov x2, x0")
    out = asm_label(out, "L_string_append_seek")
    out = asm_line(out, "ldrb w9, [x0]")
    out = asm_line(out, "cbz w9, L_string_append_copy")
    out = asm_line(out, "add x0, x0, #1")
    out = asm_line(out, "b L_string_append_seek")
    out = asm_label(out, "L_string_append_copy")
    if target["os"] == "linux" and target["arch"] == "x86_64":
        # PIE labels and low heap pointers overlap the numeric range used by
        # packed short strings. Resolve the source by page mapping before the
        # shared AArch64-oriented heuristic sees it.
        out = asm_line(out, "sub sp, sp, #64")
        out = asm_line(out, "str x30, [sp]")
        out = asm_line(out, "str x0, [sp, #8]")
        out = asm_line(out, "str x1, [sp, #16]")
        out = asm_line(out, "str x2, [sp, #24]")
        out = asm_line(out, "lsr x0, x1, #12")
        out = asm_line(out, "lsl x0, x0, #12")
        out = asm_line(out, "mov x1, #1")
        out = asm_line(out, "lsl x1, x1, #12")
        out = asm_line(out, "add x2, sp, #48")
        out = asm_line(out, "bl " + asm_call_name(target, "mincore"))
        out = asm_line(out, "mov w12, w0")
        out = asm_line(out, "ldr x0, [sp, #8]")
        out = asm_line(out, "ldr x1, [sp, #16]")
        out = asm_line(out, "ldr x2, [sp, #24]")
        out = asm_line(out, "ldr x30, [sp]")
        out = asm_line(out, "add sp, sp, #64")
        out = asm_line(out, "cbnz w12, L_string_append_packed")
        out = asm_line(out, "b L_string_append_copy_loop")
    out = asm_line(out, "mov x10, x1")
    out = asm_line(out, "lsr x11, x10, #48")
    out = asm_line(out, "cbnz x11, L_string_append_packed")
    out = asm_line(out, "mov x11, #1")
    out = asm_line(out, "lsl x11, x11, #32")
    out = asm_line(out, "cmp x10, x11")
    out = asm_line(out, "b.lo L_string_append_packed")
    if target["os"] == "linux":
        out = asm_line(out, "mov x11, #1")
        out = asm_line(out, "lsl x11, x11, #47")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.hs L_string_append_copy_loop")
        out = asm_line(out, "b L_string_append_packed")
    else:
        out = asm_line(out, "mov x11, #4")
        out = asm_line(out, "lsl x11, x11, #44")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.lo L_string_append_copy_loop")
        out = asm_line(out, "mov x11, #6")
        out = asm_line(out, "lsl x11, x11, #44")
        out = asm_line(out, "cmp x10, x11")
        out = asm_line(out, "b.lo L_string_append_packed")
    out = asm_label(out, "L_string_append_copy_loop")
    out = asm_line(out, "ldrb w9, [x1], #1")
    out = asm_line(out, "strb w9, [x0], #1")
    out = asm_line(out, "cbnz w9, L_string_append_copy_loop")
    out = asm_line(out, "mov x0, x2")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_string_append_packed")
    out = asm_line(out, "mov x12, #0")
    out = asm_label(out, "L_string_append_packed_loop")
    out = asm_line(out, "and w9, w10, #255")
    out = asm_line(out, "strb w9, [x0], #1")
    out = asm_line(out, "cbz w9, L_string_append_packed_done")
    out = asm_line(out, "lsr x10, x10, #8")
    out = asm_line(out, "add x12, x12, #1")
    out = asm_line(out, "cmp x12, #8")
    out = asm_line(out, "b.lt L_string_append_packed_loop")
    out = asm_line(out, "strb wzr, [x0]")
    out = asm_label(out, "L_string_append_packed_done")
    out = asm_line(out, "mov x0, x2")
    out = asm_line(out, "ret")

    return out

