def emit_darwin_aarch64_function_body_runtime(out, target):
    state_scope_floor_x15 = generated_state_scope_floor_mem("x15")
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x28 = generated_value_tag_mem("x28")

    out = asm_label(out, "L_execute_function_body_range")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "str x5, [sp, #960]")
    out = asm_line(out, "str x4, [sp, #968]")
    out = asm_line(out, "str x3, [sp, #976]")
    out = asm_line(out, "str x7, [sp, #984]")
    # x26 carries the active output stream through record execution. The
    # function materializer reuses x26 for body sizing, so preserve it before
    # that calculation and restore it before executing child records.
    out = asm_line(out, "str x26, [sp, #992]")
    # x8 is the first slot owned by this invocation. Publish it as the lexical
    # lookup floor and restore the caller floor on every exit so recursive
    # helpers cannot reuse or overwrite caller locals with the same name.
    out = asm_line(out, "str x8, [sp, #1000]")
    out = asm_addr(out, target, "x15", "L_state_base_ptr")
    out = asm_line(out, "ldr x15, [x15]")
    out = asm_line(out, "str x15, [sp, #1008]")
    out = asm_line(out, "cbz x15, L_efbr_scope_floor_ready")
    out = asm_line(out, "ldr x9, " + state_scope_floor_x15)
    out = asm_line(out, "str x9, [sp, #1016]")
    out = asm_line(out, "str x8, " + state_scope_floor_x15)
    out = asm_label(out, "L_efbr_scope_floor_ready")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x27, x2")
    out = asm_line(out, "mov x23, x6")
