    out = asm_line(out, "b.lt L_nshr_len_start")
    out = asm_line(out, "cmp x12, #65536")
    out = asm_line(out, "b.gt L_nshr_len_start")
    out = asm_line(out, "b L_nshr_copy_heap_collection_ptr_ok")
    out = asm_label(out, "L_nshr_copy_heap_collection")
    out = asm_line(out, "ldr x11, [x0]")
    if target["os"] == "linux" and target["arch"] == "x86_64":
