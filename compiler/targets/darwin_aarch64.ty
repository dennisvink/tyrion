        out = asm_line(out, "b L_nshr_copy_heap_collection_ptr_ok")
        out = asm_label(out, "L_nshr_copy_heap_collection_x86_raw")
        out = asm_line(out, "ldr x0, [sp, #8]")
        out = asm_line(out, "ldr x11, [sp, #48]")
    out = asm_line(out, "mov x13, #1")
    out = asm_line(out, "lsl x13, x13, #32")
    out = asm_line(out, "cmp x11, x13")
    out = asm_line(out, "b.lo L_nshr_copy_heap_collection_raw_kind")
    out = asm_line(out, "lsr x13, x11, #48")
    out = asm_line(out, "cbnz x13, L_nshr_copy_heap_collection_raw_slot")
    out = asm_line(out, "b L_nshr_copy_heap_collection_ptr_ok")
    out = asm_label(out, "L_nshr_copy_heap_collection_raw_kind")
    out = asm_line(out, "ldr x13, [sp, #16]")
    out = asm_line(out, "cmp x13, #9")
    out = asm_line(out, "b.eq L_nshr_force_heap_list")
