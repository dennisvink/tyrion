    out = asm_label(out, "L_source_line_is_ignorable")
    out = asm_line(out, "stp x29, x30, [sp, #-16]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "bl L_string_lstrip")
    out = asm_line(out, "ldrb w9, [x0]")
    out = asm_line(out, "cbz w9, L_ignore_true")
    out = asm_line(out, "mov w1, #35")
    out = asm_line(out, "bl L_string_startswith_char")
    out = asm_line(out, "cbnz w0, L_ignore_true")
