    out = asm_line(out, "ldr x15, [x14]")
    out = asm_line(out, "cmp x11, #17")
    out = asm_line(out, "b.ne L_ear_scan_start")
    out = asm_line(out, "cmp x15, #18")
    out = asm_line(out, "b.ne L_ear_scan_start")
    out = asm_line(out, "add x16, x3, #1")
    out = asm_label(out, "L_ear_paren_tuple_probe")
    out = asm_line(out, "cmp x16, x12")
    out = asm_line(out, "b.ge L_ear_paren_not_tuple")
    out = asm_line(out, "add x10, x1, #16")
    out = asm_line(out, "lsl x11, x16, #5")
    out = asm_line(out, "add x10, x10, x11")
    out = asm_line(out, "ldr x11, [x10]")
    out = asm_line(out, "cmp x11, #19")
    out = asm_line(out, "b.eq L_ear_scan_start")
    out = asm_line(out, "add x16, x16, #1")
    out = asm_line(out, "b L_ear_paren_tuple_probe")
    out = asm_label(out, "L_ear_paren_not_tuple")
    out = asm_line(out, "add x3, x3, #1")
    out = asm_line(out, "sub x4, x4, #1")
    out = asm_line(out, "ldr x26, [sp, #40]")
    out = asm_line(out, "bl L_eval_ast_range")
    out = asm_line(out, "cbz x0, L_ear_fail")
    out = asm_line(out, "ldr x1, [sp, #8]")
    out = asm_line(out, "ldr x12, [sp, #32]")
    out = asm_line(out, "sub x12, x12, #1")
    out = asm_line(out, "add x10, x1, #16")
    out = asm_line(out, "lsl x11, x12, #5")
    out = asm_line(out, "add x10, x10, x11")
    out = asm_line(out, "ldr x0, [x10, #8]")
    out = asm_line(out, "ldr x11, [x10, #16]")
    out = asm_line(out, "add x0, x0, x11")
    out = asm_line(out, "b L_ear_return")

    out = asm_label(out, "L_ear_scan_start")
    out = asm_line(out, "mov x5, #99")
    out = asm_line(out, "mov x6, #-1")
    out = asm_line(out, "mov x7, #0")
    out = asm_line(out, "mov x8, x3")
    out = asm_label(out, "L_ear_scan_loop")
    out = asm_line(out, "cmp x8, x4")
    out = asm_line(out, "b.ge L_ear_scan_done")
    out = asm_line(out, "add x10, x1, #16")
    out = asm_line(out, "lsl x11, x8, #5")
    out = asm_line(out, "add x10, x10, x11")
    out = asm_line(out, "ldr x11, [x10, #24]")
    out = asm_line(out, "ldr x13, [sp, #104]")
    out = asm_line(out, "cmp x11, x13")
    out = asm_line(out, "b.ne L_ear_scan_next")
    out = asm_line(out, "ldr x12, [x10]")
    out = asm_line(out, "mov x15, #0")
    out = asm_line(out, "cmp x12, #21")
    out = asm_line(out, "b.eq L_ear_prec_or")
    out = asm_line(out, "cmp x12, #20")
    out = asm_line(out, "b.eq L_ear_prec_and")
    out = asm_line(out, "cmp x12, #11")
    out = asm_line(out, "b.lt L_ear_prec_add")
    out = asm_line(out, "cmp x12, #16")
    out = asm_line(out, "b.le L_ear_prec_cmp")
    out = asm_line(out, "cmp x12, #29")
    out = asm_line(out, "b.eq L_ear_prec_cmp")
    out = asm_label(out, "L_ear_prec_add")
    out = asm_line(out, "cmp x12, #7")
    out = asm_line(out, "b.eq L_ear_prec_add_take")
    out = asm_line(out, "cmp x12, #8")
    out = asm_line(out, "b.eq L_ear_prec_add_take")
    out = asm_line(out, "cmp x12, #9")
    out = asm_line(out, "b.eq L_ear_prec_mul")
    out = asm_line(out, "cmp x12, #10")
    out = asm_line(out, "b.eq L_ear_prec_mul")
    out = asm_line(out, "b L_ear_scan_next")
    out = asm_label(out, "L_ear_prec_or")
    out = asm_line(out, "mov x15, #1")
    out = asm_line(out, "b L_ear_consider_op")
    out = asm_label(out, "L_ear_prec_and")
    out = asm_line(out, "mov x15, #2")
    out = asm_line(out, "b L_ear_consider_op")
    out = asm_label(out, "L_ear_prec_cmp")
    out = asm_line(out, "mov x15, #3")
    out = asm_line(out, "b L_ear_consider_op")
    out = asm_label(out, "L_ear_prec_add_take")
    out = asm_line(out, "cmp x8, x3")
    out = asm_line(out, "b.eq L_ear_scan_next")
    out = asm_line(out, "mov x15, #4")
    out = asm_line(out, "b L_ear_consider_op")
    out = asm_label(out, "L_ear_prec_mul")
    out = asm_line(out, "cmp x8, x3")
    out = asm_line(out, "b.eq L_ear_scan_next")
    out = asm_line(out, "mov x15, #5")
    out = asm_label(out, "L_ear_consider_op")
    out = asm_line(out, "cmp x15, x5")
    out = asm_line(out, "b.gt L_ear_scan_next")
    out = asm_line(out, "mov x5, x15")
    out = asm_line(out, "mov x6, x8")
    out = asm_line(out, "mov x7, x12")
    out = asm_label(out, "L_ear_scan_next")
    out = asm_line(out, "add x8, x8, #1")
    out = asm_line(out, "b L_ear_scan_loop")

    out = asm_label(out, "L_ear_scan_done")
    out = asm_line(out, "mov x9, #-1")
    out = asm_line(out, "cmp x6, x9")
    out = asm_line(out, "b.ne L_ear_binary_op")
    # Unary `not` binds more tightly than `and`/`or`. Dispatch it only after
    # the current range has been scanned for a top-level binary operator; an
    # eager dispatch here used to parse `not a and not b` as
    # `not (a and not b)` instead of `(not a) and (not b)`.
    out = asm_line(out, "add x10, x1, #16")
    out = asm_line(out, "lsl x11, x3, #5")
    out = asm_line(out, "add x10, x10, x11")
    out = asm_line(out, "ldr x11, [x10]")
    out = asm_line(out, "cmp x11, #22")
    out = asm_line(out, "b.eq L_ear_unary_not")
    out = asm_line(out, "b L_ear_atom")
    out = asm_label(out, "L_ear_binary_op")
    out = asm_line(out, "str x6, [sp, #56]")
    out = asm_line(out, "str x7, [sp, #64]")

    out = asm_line(out, "ldr x1, [sp, #8]")
    out = asm_line(out, "ldr x2, [sp, #16]")
    out = asm_line(out, "ldr x3, [sp, #24]")
    out = asm_line(out, "ldr x4, [sp, #56]")
    out = asm_line(out, "add x26, sp, #128")
    out = asm_line(out, "bl L_eval_ast_range")
    out = asm_line(out, "cbz x0, L_ear_fail")
    out = asm_line(out, "str x0, [sp, #88]")
    out = asm_line(out, "str x14, [sp, #72]")

    # Boolean operators are left-to-right and short-circuit. Besides matching
    # Tyrion semantics, this is required for safe structural predicates such
    # as `kind == "assign" and node["target"]...`, where the right field is
    # intentionally absent when the left predicate is false.
    out = asm_line(out, "ldr x7, [sp, #64]")
    out = asm_line(out, "cmp x7, #20")
    out = asm_line(out, "b.eq L_ear_short_circuit_and")
    out = asm_line(out, "cmp x7, #21")
    out = asm_line(out, "b.ne L_ear_eval_right")
    out = asm_line(out, "ldr x10, [sp, #72]")
    out = asm_line(out, "cmp x10, #3")
    out = asm_line(out, "b.ne L_ear_eval_right")
    out = asm_line(out, "ldrb w9, [sp, #128]")
    out = asm_line(out, "cmp w9, #84")
    out = asm_line(out, "b.ne L_ear_eval_right")
    out = asm_line(out, "mov x11, #1")
    out = asm_line(out, "b L_ear_bool_write")
    out = asm_label(out, "L_ear_short_circuit_and")
    out = asm_line(out, "ldr x10, [sp, #72]")
    out = asm_line(out, "cmp x10, #3")
    out = asm_line(out, "b.ne L_ear_eval_right")
    out = asm_line(out, "ldrb w9, [sp, #128]")
    out = asm_line(out, "cmp w9, #84")
    out = asm_line(out, "b.eq L_ear_eval_right")
    out = asm_line(out, "mov x11, #0")
    out = asm_line(out, "b L_ear_bool_write")
    out = asm_label(out, "L_ear_eval_right")

    out = asm_line(out, "ldr x1, [sp, #8]")
    out = asm_line(out, "ldr x2, [sp, #16]")
    out = asm_line(out, "ldr x3, [sp, #56]")
    out = asm_line(out, "add x3, x3, #1")
    out = asm_line(out, "ldr x4, [sp, #32]")
    out = asm_line(out, "add x26, sp, #384")
    out = asm_line(out, "bl L_eval_ast_range")
    out = asm_line(out, "cbz x0, L_ear_fail")
    out = asm_line(out, "str x0, [sp, #96]")
    out = asm_line(out, "str x14, [sp, #80]")

    # Recursive atom evaluation reports the canonical value tag in x14, but
    # some atom paths only write payload bytes into the caller-provided slot.
    # Normalize both temporary slots before string/collection operations read
    # their in-slot tags; otherwise reused stack bytes can forge a heap value.
    out = asm_line(out, "ldr x9, [sp, #72]")
    out = asm_line(out, "strb w9, [sp, #255]")
    out = asm_line(out, "ldr x9, [sp, #80]")
    out = asm_line(out, "strb w9, [sp, #511]")

    out = asm_line(out, "ldr x7, [sp, #64]")
    out = asm_line(out, "cmp x7, #7")
    out = asm_line(out, "b.eq L_ear_apply_plus")
    out = asm_line(out, "cmp x7, #8")
    out = asm_line(out, "b.eq L_ear_apply_minus")
    out = asm_line(out, "cmp x7, #9")
    out = asm_line(out, "b.eq L_ear_apply_mul")
    out = asm_line(out, "cmp x7, #10")
    out = asm_line(out, "b.eq L_ear_apply_div")
    out = asm_line(out, "cmp x7, #11")
    out = asm_line(out, "b.lt L_ear_apply_bool")
    out = asm_line(out, "cmp x7, #16")
    out = asm_line(out, "b.le L_ear_apply_compare")
    out = asm_line(out, "cmp x7, #29")
    out = asm_line(out, "b.eq L_ear_apply_membership")
    out = asm_line(out, "b L_ear_apply_bool")

    # Membership is a normal precedence operator. Compact list values retain
