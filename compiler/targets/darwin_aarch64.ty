    # representations use the same exact string comparison semantics.
    out = asm_label(out, "L_ear_apply_membership")
    out = asm_line(out, "sub sp, sp, #64")
    out = asm_line(out, "add x0, sp, #192")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, L_ear_membership_fail")
    out = asm_line(out, "str x0, [sp]")
    out = asm_line(out, "str x1, [sp, #8]")
    out = asm_line(out, "add x12, sp, #448")
    out = asm_line(out, "ldrb w9, " + value_tag_x12)
    out = asm_line(out, "cmp w9, #18")
    out = asm_line(out, "b.eq L_ear_membership_ast_field")
    out = asm_line(out, "cmp w9, #5")
    out = asm_line(out, "b.eq L_ear_membership_compact_inline")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.ne L_ear_membership_fail")
    out = asm_line(out, "ldrb w10, " + value_owner_x12)
    out = asm_line(out, "cmp w10, #2")
    out = asm_line(out, "b.eq L_ear_membership_typed")
    out = asm_line(out, "cmp w10, #3")
    out = asm_line(out, "b.eq L_ear_membership_typed")
    out = asm_line(out, "ldr x25, [x12]")
    out = asm_line(out, "cbz x25, L_ear_membership_false")
    out = asm_line(out, "b L_ear_membership_compact_entry")
    out = asm_label(out, "L_ear_membership_compact_inline")
    out = asm_line(out, "mov x25, x12")
    out = asm_label(out, "L_ear_membership_compact_entry")
    out = asm_line(out, "mov x27, x25")
    out = asm_line(out, "mov x28, #0")
    out = asm_label(out, "L_ear_membership_compact_compare")
    out = asm_line(out, "ldrb w9, [x27, x28]")
    out = asm_line(out, "cbz w9, L_ear_membership_compact_end")
    out = asm_line(out, "cmp w9, #124")
    out = asm_line(out, "b.eq L_ear_membership_compact_end")
    out = asm_line(out, "cmp w9, #31")
    out = asm_line(out, "b.eq L_ear_membership_compact_end")
    out = asm_line(out, "ldr x10, [sp, #8]")
    out = asm_line(out, "cmp x28, x10")
    out = asm_line(out, "b.hs L_ear_membership_compact_next")
    out = asm_line(out, "ldr x11, [sp]")
    out = asm_line(out, "ldrb w10, [x11, x28]")
    out = asm_line(out, "cmp w9, w10")
    out = asm_line(out, "b.ne L_ear_membership_compact_next")
    out = asm_line(out, "add x28, x28, #1")
    out = asm_line(out, "b L_ear_membership_compact_compare")
    out = asm_label(out, "L_ear_membership_compact_end")
    out = asm_line(out, "ldr x10, [sp, #8]")
    out = asm_line(out, "cmp x28, x10")
    out = asm_line(out, "b.eq L_ear_membership_true")
    out = asm_label(out, "L_ear_membership_compact_next")
    out = asm_line(out, "ldrb w9, [x25]")
    out = asm_line(out, "cbz w9, L_ear_membership_false")
    out = asm_line(out, "add x25, x25, #1")
    out = asm_line(out, "cmp w9, #124")
    out = asm_line(out, "b.eq L_ear_membership_compact_entry")
    out = asm_line(out, "cmp w9, #31")
    out = asm_line(out, "b.eq L_ear_membership_compact_entry")
    out = asm_line(out, "b L_ear_membership_compact_next")

    # Persistent AST handles are source-level record values. Membership with
