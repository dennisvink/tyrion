    asm_line(out, "cmp x12, x11")
    asm_line(out, "b.hs L_generated_value_release_owned_slot_typed_list_free")
    asm_line(out, "str x10, [sp, #24]")
    asm_line(out, "str x11, [sp, #32]")
    asm_line(out, "str x12, [sp, #40]")
    asm_line(out, "add x0, x10, x12, lsl #7")
    asm_line(out, "bl L_generated_value_release_owned_slot")
    asm_line(out, "ldr x10, [sp, #24]")
    asm_line(out, "ldr x11, [sp, #32]")
    asm_line(out, "ldr x12, [sp, #40]")
    asm_line(out, "add x12, x12, #1")
    asm_line(out, "b L_generated_value_release_owned_slot_typed_list_loop")
    asm_label(out, "L_generated_value_release_owned_slot_typed_list_free")
    asm_line(out, "mov x0, x10")
