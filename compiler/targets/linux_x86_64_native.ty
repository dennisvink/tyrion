    out = x86_native_line(out, "subq $8, %rsp")
    out = x86_native_line(out, "movq %rdi, %rbx")
    out = x86_native_line(out, "movq %rsi, %r12")
    out = x86_native_line(out, "movq %rdx, %r13")
    out = x86_native_line(out, "movq %rbx, %rdi")
    out = x86_native_line(out, "call __tyrion_native_slot_string_view")
    out = x86_native_line(out, "testq %rax, %rax")
    out = x86_native_line(out, "je .L_tyrion_native_report_compiler_file_failure_done")
    out = x86_native_line(out, "movq %rax, %rbx")
    out = x86_native_line(out, "movq %rdx, 0(%rsp)")
    out = x86_native_line(out, "movl $2, %edi")
    out = x86_native_line(out, "movq %r12, %rsi")
    out = x86_native_line(out, "movq %r13, %rdx")
    out = x86_native_line(out, "call write@PLT")
    out = x86_native_line(out, "movl $2, %edi")
    out = x86_native_line(out, "movq %rbx, %rsi")
    out = x86_native_line(out, "movq 0(%rsp), %rdx")
    out = x86_native_line(out, "call write@PLT")
    out = x86_native_line(out, "movl $2, %edi")
    out = x86_native_line(out, "leaq .L_tyrion_native_compiler_file_newline(%rip), %rsi")
    out = x86_native_line(out, "movl $1, %edx")
    out = x86_native_line(out, "call write@PLT")
    out = asm_writer_append(out, ".L_tyrion_native_report_compiler_file_failure_done:\n")
    out = x86_native_line(out, "addq $8, %rsp")
