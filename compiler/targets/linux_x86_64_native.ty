# Native SysV AMD64 instruction selection. This backend consumes verified
# native IR and never parses or simulates AArch64 instructions.

def x86_native_line(out, text):
    return asm_writer_append(out, "    " + text + "\n")


def x86_native_value_slot(value_id):
    return 8 * (value_id + 1)


def x86_native_stack_size(value_count):
    raw_size = value_count * 8
    if raw_size < 16:
        return 16
    remainder = raw_size % 16
    if remainder == 0:
        return raw_size
    return raw_size + (16 - remainder)


def x86_native_spill_size(value_count):
    return x86_native_stack_size(value_count)


def x86_native_value_count(instructions):
    maximum = -1
    idx = 0
    while idx < len(instructions):
        result = instructions[idx]["result"]
        if result > maximum:
            maximum = result
        idx = idx + 1
    return maximum + 1


def x86_native_slot_count(instructions):
    count = 0
    idx = 0
    while idx < len(instructions):
        if instructions[idx]["op"] == "slot_alloc":
            count = count + 1
        idx = idx + 1
    return count


def x86_native_record_temp_count(instructions):
    count = 0
    idx = 0
    while idx < len(instructions):
        if instructions[idx]["op"] == "ast_append_record":
            count = count + 1
        idx = idx + 1
    return count


def x86_native_function_instructions(function):
    out = []
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            out.append(instructions[instruction_idx])
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return out


def x86_native_function_stack_size(instructions):
    size = x86_native_spill_size(x86_native_value_count(instructions))
    size = size + x86_native_slot_count(instructions) * generated_value_slot_size()
    size = size + x86_native_record_temp_count(instructions) * generated_ast_record_size()
    remainder = size % 16
    if remainder != 0:
        size = size + (16 - remainder)
    return size


def x86_native_slot_storage_offset(instructions, index):
    ordinal = 0
    idx = 0
    while idx <= index:
        if instructions[idx]["op"] == "slot_alloc":
            ordinal = ordinal + 1
        idx = idx + 1
    return x86_native_spill_size(x86_native_value_count(instructions)) + ordinal * generated_value_slot_size()


def x86_native_record_temp_offset(instructions, index):
    ordinal = 0
    idx = 0
    while idx <= index:
        if instructions[idx]["op"] == "ast_append_record":
            ordinal = ordinal + 1
        idx = idx + 1
    return x86_native_spill_size(x86_native_value_count(instructions)) + x86_native_slot_count(instructions) * generated_value_slot_size() + ordinal * generated_ast_record_size()


def x86_native_stack_operand(value_id):
    return "-" + str(x86_native_value_slot(value_id)) + "(%rbp)"


def x86_native_constant_label(constant_id):
    return "__tyrion_native_ir_const_" + str(constant_id)


def x86_native_scoped_constant_label(scope_id, constant_id):
    return "__tyrion_native_ir_unit_" + str(scope_id) + "_const_" + str(constant_id)


def x86_native_dispatch_table_label(table_id):
    return "__tyrion_native_ir_dispatch_table_" + str(table_id)


def x86_native_dispatch_runtime_label(table_id):
    return "__tyrion_native_ir_dispatch_" + str(table_id)


def x86_native_static_token_image_label(table_id):
    return ".L_tyrion_native_ir_static_token_image_" + str(table_id)


def x86_native_static_token_pool_label(table_id):
    return ".L_tyrion_native_ir_static_token_pool_" + str(table_id)


def x86_native_static_token_image_size_label(table_id):
    return ".L_tyrion_native_ir_static_token_image_size_" + str(table_id)


def x86_native_static_token_image_magic():
    # ASCII "TYRSTIMG", interpreted as a little-endian-independent integer
    # contract by the emitter and generated runtime.
    return 6077979689963048263


def x86_native_static_token_image_version():
    return 1


def x86_native_static_token_image_header_size():
    return 48


def x86_native_static_token_image_record_size():
    return 40


def x86_native_static_token_image_magic_offset():
    return 0


def x86_native_static_token_image_version_offset():
    return 8


def x86_native_static_token_image_token_count_offset():
    return 16


def x86_native_static_token_image_pool_size_offset():
    return 24


def x86_native_static_token_image_record_size_offset():
    return 32


def x86_native_static_token_image_reserved_offset():
    return 40


def x86_native_static_token_record_kind_offset():
    return 0


def x86_native_static_token_record_text_offset_offset():
    return 8


def x86_native_static_token_record_text_length_offset():
    return 16


def x86_native_static_token_record_line_offset():
    return 24


def x86_native_static_token_record_column_offset():
    return 32


def x86_native_static_image_checked_add(left, right, detail):
    if left < 0 or right < 0 or left > 9223372036854775807 - right:
        fail("x86 static token image rejected code=size-overflow;detail=" + detail)
    return left + right


def x86_native_static_image_checked_multiply(left, right, detail):
    if left < 0 or right < 0:
        fail("x86 static token image rejected code=size-negative;detail=" + detail)
    if left != 0 and right > 9223372036854775807 / left:
        fail("x86 static token image rejected code=size-overflow;detail=" + detail)
    return left * right


def x86_native_token_pool_entry(pool, text):
    length = len(text)
    if length < 0:
        fail("x86 static token image rejected code=negative-text-length")
    offset = pool["size"]
    pool["size"] = x86_native_static_image_checked_add(offset, length, "text-pool")
    __tyrion_native_ast_builder_append(pool["entries"], 0, {"kind": 0, "text": text, "line": offset, "column": length})
    pool["unique_count"] = pool["unique_count"] + 1
    return pool


def x86_native_token_pool_char_band(ch):
    # A small comparison tree is substantially cheaper in the self-hosted
    # evaluator than scanning an alphabet for every sampled byte. Bands need
    # only distribute candidates: exact byte equality resolves collisions.
    if ch < "0":
        return 1
    if ch < "A":
        return 2
    if ch < "G":
        return 3
    if ch < "M":
        return 4
    if ch < "S":
        return 5
    if ch < "Y":
        return 6
    if ch < "a":
        return 7
    if ch < "g":
        return 8
    if ch < "m":
        return 9
    if ch < "s":
        return 10
    if ch < "y":
        return 11
    return 12


def x86_native_token_pool_hash(text, kind):
    # Kind, length, and up to four character bands cheaply separate compiler
    # identifiers and punctuation. First-occurrence ordering remains
    # independent of buckets, and exact equality resolves every collision.
    modulus = 65521
    length = len(text)
    value = (kind * 257 + length) % modulus
    if length > 0:
        value = (value * 17 + x86_native_token_pool_char_band(text[0])) % modulus
        value = (value * 17 + x86_native_token_pool_char_band(text[length - 1])) % modulus
    if length > 2:
        value = (value * 17 + x86_native_token_pool_char_band(text[1])) % modulus
        value = (value * 17 + x86_native_token_pool_char_band(text[length - 2])) % modulus
    return value


def x86_native_token_pool_map(pool, token_index):
    return __tyrion_native_ast_builder_get(pool["mapping"], 0, token_index)


def x86_native_token_pool_text(pool, entry_index):
    return __tyrion_native_ast_builder_get(pool["entries"], 0, entry_index)["text"]


def x86_native_build_token_pool(item):
    pool = {"entries": __tyrion_native_ast_builder_create(), "mapping": __tyrion_native_ast_builder_create(), "size": 0, "raw_size": 0, "unique_count": 0}
    heads = range(65536)
    head_idx = 0
    while head_idx < len(heads):
        heads[head_idx] = 0
        head_idx = head_idx + 1
    token_count = native_static_program_token_count(item)
    token_idx = 0
    while token_idx < token_count:
        token = native_static_program_token(item, token_idx)
        if token["kind"] <= 0 or token["kind"] > len(generated_token_kind_names()):
            fail("x86 static token image rejected code=token-kind;table=" + str(item["id"]) + ";index=" + str(token_idx))
        if token["line"] < 0 or token["column"] < 0:
            fail("x86 static token image rejected code=token-coordinate;table=" + str(item["id"]) + ";index=" + str(token_idx))
        text = token["text"]
        length = len(text)
        pool["raw_size"] = x86_native_static_image_checked_add(pool["raw_size"], length, "raw-token-text")
        bucket = x86_native_token_pool_hash(text, token["kind"])
        cursor = heads[bucket]
        entry_index = -1
        while cursor > 0:
            candidate = __tyrion_native_ast_builder_get(pool["entries"], 0, cursor - 1)
            if candidate["text"] == text:
                entry_index = cursor - 1
                break
            cursor = candidate["kind"]
        if entry_index < 0:
            entry_index = pool["unique_count"]
            offset = pool["size"]
            pool["size"] = x86_native_static_image_checked_add(offset, length, "text-pool")
            __tyrion_native_ast_builder_append(pool["entries"], 0, {"kind": heads[bucket], "text": text, "line": offset, "column": length})
            pool["unique_count"] = pool["unique_count"] + 1
            heads[bucket] = entry_index + 1
        entry = __tyrion_native_ast_builder_get(pool["entries"], 0, entry_index)
        __tyrion_native_ast_builder_append(pool["mapping"], 0, {"kind": entry_index + 1, "text": "", "line": entry["line"], "column": entry["column"]})
        token_idx = token_idx + 1
    if __tyrion_native_ast_builder_len(pool["mapping"], 0) != token_count:
        fail("x86 static token image rejected code=pool-map-count;table=" + str(item["id"]))
    if __tyrion_native_ast_builder_len(pool["entries"], 0) != pool["unique_count"]:
        fail("x86 static token image rejected code=pool-entry-count;table=" + str(item["id"]))
    return pool


def x86_native_verify_token_pool(item, pool):
    token_count = native_static_program_token_count(item)
    if __tyrion_native_ast_builder_len(pool["mapping"], 0) != token_count:
        fail("x86 static token image rejected code=pool-map-count;table=" + str(item["id"]))
    if __tyrion_native_ast_builder_len(pool["entries"], 0) != pool["unique_count"]:
        fail("x86 static token image rejected code=pool-entry-count;table=" + str(item["id"]))
    expected_offset = 0
    entry_idx = 0
    while entry_idx < pool["unique_count"]:
        entry = __tyrion_native_ast_builder_get(pool["entries"], 0, entry_idx)
        if entry["line"] != expected_offset or entry["column"] != len(entry["text"]):
            fail("x86 static token image rejected code=pool-entry-layout;table=" + str(item["id"]) + ";index=" + str(entry_idx))
        expected_offset = x86_native_static_image_checked_add(expected_offset, entry["column"], "verify-unique-text-pool")
        entry_idx = entry_idx + 1
    if expected_offset != pool["size"]:
        fail("x86 static token image rejected code=pool-size-mismatch;table=" + str(item["id"]))
    verified_raw_size = 0
    token_idx = 0
    while token_idx < token_count:
        token = native_static_program_token(item, token_idx)
        length = len(token["text"])
        mapping = x86_native_token_pool_map(pool, token_idx)
        entry_index = mapping["kind"] - 1
        if entry_index < 0 or entry_index >= pool["unique_count"]:
            fail("x86 static token image rejected code=pool-entry-index;table=" + str(item["id"]) + ";index=" + str(token_idx))
        entry = __tyrion_native_ast_builder_get(pool["entries"], 0, entry_index)
        if mapping["line"] != entry["line"] or mapping["column"] != length or entry["column"] != length:
            fail("x86 static token image rejected code=pool-token-mismatch;table=" + str(item["id"]) + ";index=" + str(token_idx))
        if entry["text"] != token["text"]:
            fail("x86 static token image rejected code=pool-text-mismatch;table=" + str(item["id"]) + ";index=" + str(token_idx))
        verified_raw_size = x86_native_static_image_checked_add(verified_raw_size, length, "verify-raw-token-text")
        token_idx = token_idx + 1
    if verified_raw_size != pool["raw_size"]:
        fail("x86 static token image rejected code=pool-raw-size-mismatch;table=" + str(item["id"]))
    record_bytes = x86_native_static_image_checked_multiply(token_count, x86_native_static_token_image_record_size(), "token-records")
    x86_native_static_image_checked_add(x86_native_static_token_image_header_size(), record_bytes, "image-header-records")
    x86_native_static_image_checked_add(x86_native_static_token_image_header_size() + record_bytes, pool["size"], "complete-image")
    return True


def x86_native_emit_byte_span(out, text):
    return asm_writer_append(out, ".ascii \"" + asm_escape_string(text) + "\"\n")


def x86_native_static_token_image_size(token_count, pool_size):
    record_bytes = x86_native_static_image_checked_multiply(token_count, x86_native_static_token_image_record_size(), "token-image-records")
    image_size = x86_native_static_image_checked_add(x86_native_static_token_image_header_size(), record_bytes, "token-image-header")
    return x86_native_static_image_checked_add(image_size, pool_size, "token-image-pool")


def x86_native_static_record_label(table_id):
    return "__tyrion_native_ir_static_records_" + str(table_id)


def x86_native_block_label(function, block_id):
    return ".L_native_ir_" + function["name"] + "_block_" + str(block_id)


def x86_native_call_arg_register(index):
    if index == 0:
        return "%rdi"
    if index == 1:
        return "%rsi"
    if index == 2:
        return "%rdx"
    if index == 3:
        return "%rcx"
    if index == 4:
        return "%r8"
    if index == 5:
        return "%r9"
    fail("x86-native rejected code=call-arity-not-selected;index=" + str(index))


def x86_native_direct_binary_operator_id(operator):
    operators = ["+", "-", "*", "/", "//", "%", "==", "!=", "<", "<=", ">", ">=", "in", "not in", "**", "|", "^", "&", "<<", ">>"]
    idx = 0
    while idx < len(operators):
        if operators[idx] == operator:
            return idx
        idx = idx + 1
    fail("x86-native rejected code=direct-binary-operator;operator=" + operator)


def x86_native_direct_unary_operator_id(operator):
    if operator == "not":
        return 0
    if operator == "-":
        return 1
    if operator == "+":
        return 2
    if operator == "~":
        return 3
    fail("x86-native rejected code=direct-unary-operator;operator=" + operator)


def x86_native_direct_method_id(method):
    methods = ["append", "remove", "add", "insert", "keys", "items", "strip", "split", "startswith", "endswith", "pop", "extend", "clear", "copy", "reverse", "sort"]
    idx = 0
    while idx < len(methods):
        if methods[idx] == method:
            return idx
        idx = idx + 1
    fail("x86-native rejected code=direct-method;method=" + method)


def x86_native_emit_instruction(out, instruction, storage_offset, label_scope, constant_scope=-1):
    op = instruction["op"]
    fields = instruction["fields"]
    result = instruction["result"]
    result_label = str(label_scope) + "_" + str(result)
    result_slot = x86_native_stack_operand(result)
    if op == "parameter":
        parameter_index = fields["index"]
        if parameter_index >= 0 and parameter_index < 6:
            return x86_native_line(out, "movq " + x86_native_call_arg_register(parameter_index) + ", " + result_slot)
        fail("x86-native rejected code=parameter-not-selected;index=" + str(parameter_index))
    if op == "const_int":
        value = fields["value"]
        if value >= -2147483648 and value <= 2147483647:
            return x86_native_line(out, "movq $" + str(value) + ", " + result_slot)
        out = x86_native_line(out, "movabsq $" + str(value) + ", %r10")
        return x86_native_line(out, "movq %r10, " + result_slot)
    if op == "const_address":
        constant_label = x86_native_constant_label(fields["constant_id"])
        if constant_scope >= 0:
            constant_label = x86_native_scoped_constant_label(constant_scope, fields["constant_id"])
        out = x86_native_line(out, "leaq " + constant_label + "(%rip), %rax")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "call_external":
        if fields["name"] == "write" and len(fields["args"]) == 3:
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][0]) + ", %rdi")
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][1]) + ", %rsi")
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][2]) + ", %rdx")
            out = x86_native_line(out, "call write@PLT")
            return x86_native_line(out, "movq %rax, " + result_slot)
        if fields["name"] == "strcmp" and len(fields["args"]) == 2:
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][0]) + ", %rdi")
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][1]) + ", %rsi")
            out = x86_native_line(out, "call strcmp@PLT")
            out = x86_native_line(out, "movslq %eax, %rax")
            return x86_native_line(out, "movq %rax, " + result_slot)
        fail("x86-native rejected code=external-not-selected;name=" + fields["name"])
    if op == "call_internal":
        arg_idx = 0
        while arg_idx < len(fields["args"]):
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][arg_idx]) + ", " + x86_native_call_arg_register(arg_idx))
            arg_idx = arg_idx + 1
        out = x86_native_line(out, "call " + fields["name"])
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "dispatch_call":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["name"]) + ", %rdi")
        out = x86_native_line(out, "movq $" + str(fields["actual_arity"]) + ", %rsi")
        dispatch_arg_idx = 0
        while dispatch_arg_idx < len(fields["args"]):
            out = x86_native_line(out, "movq " + x86_native_stack_operand(fields["args"][dispatch_arg_idx]) + ", " + x86_native_call_arg_register(dispatch_arg_idx + 2))
            dispatch_arg_idx = dispatch_arg_idx + 1
        out = x86_native_line(out, "call " + x86_native_dispatch_runtime_label(fields["table_id"]))
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_from_static":
        out = x86_native_line(out, "leaq " + x86_native_static_token_image_label(fields["table_id"]) + "(%rip), %rdi")
        out = x86_native_line(out, "movq $" + x86_native_static_token_image_size_label(fields["table_id"]) + ", %rsi")
        out = x86_native_line(out, "leaq " + x86_native_static_record_label(fields["table_id"]) + "(%rip), %rdx")
        out = x86_native_line(out, "movq $" + str(fields["record_count"]) + ", %rcx")
        out = x86_native_line(out, "movq $" + str(fields["root"]) + ", %r8")
        out = x86_native_line(out, "call __tyrion_native_ast_from_static")
        return x86_native_line(out, "movq %rax, " + result_slot)
    args = fields["args"]
    if op == "ast_create":
        ast_arg_idx = 0
        while ast_arg_idx < len(args):
            out = x86_native_line(out, "movq " + x86_native_stack_operand(args[ast_arg_idx]) + ", " + x86_native_call_arg_register(ast_arg_idx))
            ast_arg_idx = ast_arg_idx + 1
        out = x86_native_line(out, "call __tyrion_native_ast_create")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_retain":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "call __tyrion_native_ast_retain")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_release":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "call __tyrion_native_ast_release")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_kind":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "call __tyrion_native_ast_kind")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_field":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[1]) + ", %rsi")
        out = x86_native_line(out, "call __tyrion_native_ast_field")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_bind_tokens":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[1]) + ", %rsi")
        out = x86_native_line(out, "call __tyrion_native_ast_bind_tokens")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_view":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[1]) + ", %rsi")
        out = x86_native_line(out, "call __tyrion_native_ast_view")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_append":
        ast_append_arg_idx = 0
        while ast_append_arg_idx < len(args):
            out = x86_native_line(out, "movq " + x86_native_stack_operand(args[ast_append_arg_idx]) + ", " + x86_native_call_arg_register(ast_append_arg_idx))
            ast_append_arg_idx = ast_append_arg_idx + 1
        out = x86_native_line(out, "call __tyrion_native_ast_append")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "ast_append_record":
        record_offset = storage_offset
        record_arg_idx = 1
        while record_arg_idx < len(args):
            field_offset = (record_arg_idx - 1) * 8
            out = x86_native_line(out, "movq " + x86_native_stack_operand(args[record_arg_idx]) + ", %rax")
            out = x86_native_line(out, "movq %rax, -" + str(record_offset - field_offset) + "(%rbp)")
            record_arg_idx = record_arg_idx + 1
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
        out = x86_native_line(out, "leaq -" + str(record_offset) + "(%rbp), %rsi")
        out = x86_native_line(out, "call __tyrion_native_ast_append_record")
        return x86_native_line(out, "movq %rax, " + result_slot)
    if op == "expr_eval":
        out = x86_native_line(out, "movq " + x86_native_stack_operand(args[0]) + ", %rdi")
