    out = x86_native_line(out, "popq %rbx")
    out = x86_native_line(out, "leave")
    out = x86_native_line(out, "ret")

    out = asm_writer_append(out, "__tyrion_native_tcp_release:\n")
    out = x86_native_line(out, "pushq %rbp")
    out = x86_native_line(out, "movq %rsp, %rbp")
    out = x86_native_line(out, "pushq %rbx")
    out = x86_native_line(out, "subq $8, %rsp")
    out = x86_native_line(out, "movq %rdi, %rbx")
    out = x86_native_line(out, "testq %rbx, %rbx")
    out = x86_native_line(out, "je .L_tyrion_native_tcp_release_done")
