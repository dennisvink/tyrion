def x86_native_patch_module_graph_core_bootstrap(out):
    # The x86 emitter is file-backed. Template rewrites happen on each
    # fragment in asm_writer_append (and in the C bootstrap writer) before
    # bytes are committed; the accumulated writer is intentionally not a
    # string and cannot be searched or replaced after streaming.
    return out


def x86_native_emit_v2_module_graph_runtime(out):
    # Native module-graph primitive for compiler descendants. This operates on
    # byte spans and compact newline-delimited indexes instead of materializing
    # one owned value slot for every line, token, split part, and symbol.
    #
    # Context layout:
    #   0 output ptr, 8 length, 16 capacity
    #   24 loaded ptr, 32 length
    #   40 active ptr, 48 length
    #   56 symbols ptr, 64 length
    #   96 immutable root path, 104 failure kind (1 cycle, 2 duplicate)
    # Publish the root-file diagnostic with the canonical path-bearing shape.
