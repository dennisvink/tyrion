def x86_native_emit_v2_function(out, function):
    if function["visibility"] == "public":
        out = asm_writer_append(out, ".globl " + function["name"] + "\n")
    out = asm_writer_append(out, function["name"] + ":\n")
    if function["name"] == "main":
        out = x86_native_line(out, "movq %rdi, __tyrion_native_process_argc(%rip)")
        out = x86_native_line(out, "movq %rsi, __tyrion_native_process_argv(%rip)")
    out = x86_native_line(out, "pushq %rbp")
    out = x86_native_line(out, "movq %rsp, %rbp")
    slot_count = function["frame"]["local_slots"] + function["frame"]["control_slots"] + function["frame"]["temporary_slots"]
    slot_storage_base = x86_native_stack_size(function["frame"]["scalar_spills"])
    stack_size = slot_storage_base + slot_count * generated_value_slot_size()
    stack_remainder = stack_size % 16
    if stack_remainder != 0:
        stack_size = stack_size + (16 - stack_remainder)
    out = x86_native_line(out, "subq $" + str(stack_size) + ", %rsp")
    slot_ordinal = 0
    constant_scope = -1
    if "local_constants" in function:
        constant_scope = function["id"]
    block_idx = 0
    while block_idx < len(function["blocks"]):
        block = function["blocks"][block_idx]
        out = asm_writer_append(out, x86_native_block_label(function, block["id"]) + ":\n")
        instruction_idx = 0
        while instruction_idx < len(block["instructions"]):
            instruction = block["instructions"][instruction_idx]
            storage_offset = 0
            if instruction["op"] == "slot_alloc":
                slot_ordinal = slot_ordinal + 1
                storage_offset = slot_storage_base + slot_ordinal * generated_value_slot_size()
            out = x86_native_emit_instruction(out, instruction, storage_offset, function["id"], constant_scope)
            instruction_idx = instruction_idx + 1
        terminator = block["terminator"]
        if terminator["op"] == "return":
            out = x86_native_line(out, "movq " + x86_native_stack_operand(terminator["value"]) + ", %rax")
            out = x86_native_line(out, "leave")
            out = x86_native_line(out, "ret")
        elif terminator["op"] == "jump":
            out = x86_native_line(out, "jmp " + x86_native_block_label(function, terminator["target"]))
        elif terminator["op"] == "branch":
            out = x86_native_line(out, "cmpq $0, " + x86_native_stack_operand(terminator["condition"]))
            out = x86_native_line(out, "jne " + x86_native_block_label(function, terminator["true_target"]))
            out = x86_native_line(out, "jmp " + x86_native_block_label(function, terminator["false_target"]))
        elif terminator["op"] == "unreachable":
            out = x86_native_line(out, "ud2")
        else:
            fail("x86-native rejected code=v2-terminator-not-selected;op=" + terminator["op"])
        block_idx = block_idx + 1
    if constant_scope >= 0 and len(function["local_constants"]) > 0:
        out = asm_writer_append(out, ".section .rodata\n")
        constant_idx = 0
        while constant_idx < len(function["local_constants"]):
            constant = function["local_constants"][constant_idx]
            out = asm_writer_append(out, x86_native_scoped_constant_label(constant_scope, constant["id"]) + ":\n")
            out = x86_native_emit_byte_span(out, constant["value"])
            out = asm_writer_append(out, ".byte 0\n")
            constant_idx = constant_idx + 1
        out = asm_writer_append(out, ".text\n")
    return out


def x86_native_emit_v2_print_runtime(out):
    out = asm_writer_append(out, "__tyrion_direct_print_int:\n")
    out = x86_native_line(out, "pushq %rbp")
    out = x86_native_line(out, "movq %rsp, %rbp")
    out = x86_native_line(out, "subq $80, %rsp")
    out = x86_native_line(out, "movq %rdi, %rcx")
    out = x86_native_line(out, "leaq -64(%rbp), %rdi")
    out = x86_native_line(out, "movl $64, %esi")
    out = x86_native_line(out, "leaq .L_tyrion_direct_int_format(%rip), %rdx")
    out = x86_native_line(out, "xorl %eax, %eax")
    out = x86_native_line(out, "call snprintf@PLT")
    out = x86_native_line(out, "testl %eax, %eax")
    out = x86_native_line(out, "jle .L_tyrion_direct_print_int_done")
    out = x86_native_line(out, "movl %eax, %edx")
    out = x86_native_line(out, "movl $1, %edi")
    out = x86_native_line(out, "leaq -64(%rbp), %rsi")
    out = x86_native_line(out, "call write@PLT")
    out = asm_writer_append(out, ".L_tyrion_direct_print_int_done:\n")
    out = x86_native_line(out, "leave")
    out = x86_native_line(out, "ret")
    return out


