    out = x86_native_line(out, "call snprintf@PLT")
    out = x86_native_line(out, "testl %eax, %eax")
    out = x86_native_line(out, "jle .L_tyrion_native_tcp_connect_host_free")
    out = x86_native_line(out, "cmpl $32, %eax")
    out = x86_native_line(out, "jge .L_tyrion_native_tcp_connect_host_free")
    out = x86_native_line(out, "leaq 32(%rsp), %rdi")
    out = x86_native_line(out, "xorl %esi, %esi")
    out = x86_native_line(out, "movl $48, %edx")
    out = x86_native_line(out, "call memset@PLT")
    out = x86_native_line(out, "movl $1, 40(%rsp)")
    out = x86_native_line(out, "movq %r15, %rdi")
    out = x86_native_line(out, "leaq 0(%rsp), %rsi")
    out = x86_native_line(out, "leaq 32(%rsp), %rdx")
    out = x86_native_line(out, "leaq 80(%rsp), %rcx")
    out = x86_native_line(out, "call getaddrinfo@PLT")
    out = x86_native_line(out, "movl %eax, 108(%rsp)")
    out = x86_native_line(out, "movq %r15, %rdi")
    out = x86_native_line(out, "call free@PLT")
    out = x86_native_line(out, "cmpl $0, 108(%rsp)")
    out = x86_native_line(out, "jne .L_tyrion_native_tcp_connect_fail")
    out = x86_native_line(out, "movq 80(%rsp), %rax")
    out = x86_native_line(out, "movq %rax, 96(%rsp)")
    out = asm_writer_append(out, ".L_tyrion_native_tcp_connect_loop:\n")
    out = x86_native_line(out, "movq 96(%rsp), %r15")
    out = x86_native_line(out, "testq %r15, %r15")
