def x86_native_emit_v2_iterable_runtime(out):
    # Small dependency-closed iterable helpers used by direct iterators.  The
    # older expression runtime also contains these helpers, but pulling that
    # whole runtime into a focused native module introduces unrelated symbols.
    out = asm_writer_append(out, "__tyrion_native_iterable_count:\n")
    out = x86_native_line(out, "testq %rdi, %rdi")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_fail")
    out = x86_native_line(out, "movzbl " + str(generated_value_tag_offset()) + "(%rdi), %eax")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_collection_heap()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_aggregate")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_set_heap()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_aggregate")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_dict_heap()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_aggregate")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_generator()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_generator")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_string_inline()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_string_inline")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_string_borrowed()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_string_heap")
    out = x86_native_line(out, "cmpl $" + str(generated_value_tag_string_heap()) + ", %eax")
    out = x86_native_line(out, "je .L_tyrion_v2_iter_count_string_heap")
    out = asm_writer_append(out, ".L_tyrion_v2_iter_count_fail:\n")
    out = x86_native_line(out, "movq $-1, %rax")
    out = x86_native_line(out, "ret")
