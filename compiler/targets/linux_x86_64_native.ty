def x86_native_emit_v2_primitive_runtime(out):
    # Direct primitive ABI:
    #   rdi = destination slot
    #   rsi = caller-owned exception slot
    #   rdx = contiguous array of borrowed value-slot pointers
    #   rcx = argument count
    # Return the direct call status (0 success, 3 failure) in rax.
