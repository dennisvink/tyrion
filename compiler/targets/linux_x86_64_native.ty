    out = x86_native_line(out, "popq %r14")
    out = x86_native_line(out, "popq %r13")
    out = x86_native_line(out, "popq %r12")
    out = x86_native_line(out, "popq %rbx")
    out = x86_native_line(out, "leave")
    out = x86_native_line(out, "ret")
    return out


def emit_linux_x86_64_native_v2_header_asm_into(out):
    out = asm_writer_append(out, "# tyrion-native-ir-v2 target=x86_64-linux execution=direct\n")
    out = asm_writer_append(out, ".section .note.GNU-stack,\"\",@progbits\n")
    out = asm_writer_append(out, ".bss\n")
    out = asm_writer_append(out, ".p2align 3\n")
    out = asm_writer_append(out, "__tyrion_native_process_argc:\n.quad 0\n")
    out = asm_writer_append(out, "__tyrion_native_process_argv:\n.quad 0\n")
    return asm_writer_append(out, ".text\n")


def emit_linux_x86_64_native_v2_tail_asm_into(out, module):
    primitive_idx = 0
    while primitive_idx < len(module["primitive_implementations"]):
        primitive_implementation = module["primitive_implementations"][primitive_idx]
        if not x86_native_v2_primitive_implementation_supported(primitive_implementation):
            fail("x86-native rejected code=v2-primitive-not-selected;implementation=" + primitive_implementation)
        primitive_idx = primitive_idx + 1
    has_writer_primitive = x86_native_module_has_writer_primitive(module)
    has_ast_builder_primitive = x86_native_module_has_ast_builder_primitive(module)
    has_extension_primitive = x86_native_module_has_extension_primitive(module)
    has_process_capture_primitive = x86_native_module_has_primitive_implementation(module, "run_tool_capture")
    has_tcp_primitive = x86_native_module_has_primitive_implementation(module, "tcp_connect") or x86_native_module_has_primitive_implementation(module, "tcp_write") or x86_native_module_has_primitive_implementation(module, "tcp_read") or x86_native_module_has_primitive_implementation(module, "tcp_close")
    has_tls_primitive = x86_native_module_has_primitive_implementation(module, "tls_write") or x86_native_module_has_primitive_implementation(module, "tls_read")
    has_ascii_text_primitive = x86_native_module_has_primitive_implementation(module, "ascii_text")
    has_terminal_primitive = x86_native_module_has_primitive_implementation(module, "terminal_read_key") or x86_native_module_has_primitive_implementation(module, "ansi_escape")
    has_input_primitive = x86_native_module_has_primitive_implementation(module, "input")
    if x86_native_module_has_operation(module, "print_int") or x86_native_module_has_operation(module, "direct_print_string_slot") or has_input_primitive:
        out = x86_native_emit_v2_print_runtime(out)
    if x86_native_module_has_operation(module, "direct_print_string_slot") or has_input_primitive:
        out = x86_native_emit_v2_print_float_runtime(out)
    if x86_native_module_has_operation(module, "print_bool") or x86_native_module_has_operation(module, "direct_print_string_slot") or has_input_primitive:
        out = x86_native_emit_v2_print_bool_runtime(out)
    if x86_native_module_has_operation(module, "direct_slot_release") or x86_native_module_has_operation(module, "direct_slots_release_contiguous") or x86_native_module_has_operation(module, "direct_slot_set_bool_owned") or x86_native_module_has_operation(module, "direct_slot_set_none_owned") or x86_native_module_has_operation(module, "direct_slot_set_float_text") or x86_native_module_has_operation(module, "direct_slot_set_string") or x86_native_module_has_operation(module, "direct_slot_set_collection") or x86_native_module_has_operation(module, "direct_slot_collection_new") or x86_native_module_has_operation(module, "direct_collection_append_owned") or x86_native_module_has_operation(module, "direct_slot_dict_new") or x86_native_module_has_operation(module, "direct_dict_put_owned") or x86_native_module_has_operation(module, "direct_slot_copy_owned") or x86_native_module_has_operation(module, "direct_iterator_new") or x86_native_module_has_operation(module, "direct_iterator_next") or x86_native_module_has_operation(module, "direct_iterable_prepare") or x86_native_module_has_operation(module, "direct_iterable_item_copy") or x86_native_module_has_operation(module, "direct_print_string_slot") or x86_native_module_has_operation(module, "direct_generator_new") or x86_native_module_has_operation(module, "direct_generator_saved_slot") or x86_native_module_has_operation(module, "direct_object_new") or x86_native_module_has_operation(module, "direct_object_class_id") or x86_native_module_has_operation(module, "direct_object_attr_get") or x86_native_module_has_operation(module, "direct_object_attr_set") or x86_native_module_has_operation(module, "direct_file_open") or x86_native_module_has_operation(module, "direct_file_method") or x86_native_module_has_operation(module, "direct_file_close") or x86_native_module_has_operation(module, "direct_process_argv") or x86_native_module_has_operation(module, "direct_primitive_call"):
        # The aggregate runtime's primitive paths (notably input()) can call
        # the canonical string printer even when the operation inventory does
        # not retain a direct_print_string_slot entry.  Keep that dependency
        # in the same emitted component so native programs never end up with
        # a dangling __tyrion_direct_print_string reference.
        out = x86_native_emit_v2_aggregate_runtime(out, True, has_writer_primitive, has_ast_builder_primitive, module)
    if x86_native_module_has_operation(module, "direct_file_open") or x86_native_module_has_operation(module, "direct_file_method") or x86_native_module_has_operation(module, "direct_file_close"):
        out = x86_native_emit_v2_file_runtime(out)
    if x86_native_module_has_operation(module, "direct_process_argv"):
        out = x86_native_emit_v2_process_runtime(out)
    if x86_native_module_has_operation(module, "direct_primitive_call"):
        out = x86_native_emit_v2_primitive_runtime(out)
    if x86_native_module_has_primitive_implementation(module, "cache_encode"):
        out = x86_native_emit_cache_primitive_runtime(out, "cache_encode")
    if x86_native_module_has_primitive_implementation(module, "cache_decode"):
        out = x86_native_emit_cache_primitive_runtime(out, "cache_decode")
    if has_tcp_primitive:
        out = x86_native_emit_tcp_runtime(out, True, True)
    if has_tls_primitive:
        out = x86_native_emit_tls_runtime(out)
    if has_ascii_text_primitive:
        out = x86_native_emit_ascii_text_runtime(out)
    if has_terminal_primitive:
        out = x86_native_emit_terminal_runtime(out, True)
    if x86_native_module_has_primitive_implementation(module, "lex"):
        out = x86_native_emit_v2_lex_runtime(out)
    if x86_native_module_has_primitive_implementation(module, "program_has_function"):
        out = x86_native_emit_v2_program_has_function_runtime(out)
    if x86_native_module_has_primitive_implementation(module, "read_module_graph"):
        out = x86_native_emit_v2_module_graph_runtime(out)
    if has_extension_primitive:
        out = x86_native_emit_v2_extension_runtime(out, module["extensions"], module["dynamic_extension_mode"], module["dynamic_extension_root"])
    if has_process_capture_primitive:
        out = x86_native_emit_v2_process_capture_runtime(out)
    if has_writer_primitive:
        out = x86_native_emit_writer_runtime(out)
        out = x86_native_emit_v2_writer_primitive_runtime(out)
        out = asm_writer_append(out, ".section .rodata\n")
        out = asm_writer_append(out, ".L_tyrion_native_writer_mode:\n.asciz \"wb\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_backend_x86:\n.ascii \"linux-x86_64\"\n")
        out = asm_writer_append(out, ".text\n")
    if has_ast_builder_primitive:
        out = x86_native_emit_v2_ast_builder_runtime(out)
        out = x86_native_emit_v2_ast_builder_primitive_runtime(out)
    if len(module["constants"]) > 0:
        out = asm_writer_append(out, ".section .rodata\n")
    constant_idx = 0
    while constant_idx < len(module["constants"]):
        constant = module["constants"][constant_idx]
        out = asm_writer_append(out, x86_native_constant_label(constant["id"]) + ":\n")
        out = x86_native_emit_byte_span(out, constant["value"])
        out = asm_writer_append(out, ".byte 0\n")
        constant_idx = constant_idx + 1
    if x86_native_module_has_operation(module, "print_int") or x86_native_module_has_operation(module, "direct_print_string_slot"):
        out = asm_writer_append(out, ".L_tyrion_direct_int_format:\n.asciz \"%lld\"\n")
    if x86_native_module_has_operation(module, "direct_print_string_slot"):
        out = asm_writer_append(out, ".L_tyrion_direct_float_format:\n.asciz \"%.15g\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_lbracket:\n.ascii \"[\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_rbracket:\n.ascii \"]\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_lparen:\n.ascii \"(\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_rparen:\n.ascii \")\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_lbrace:\n.ascii \"{\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_rbrace:\n.ascii \"}\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_comma_space:\n.ascii \", \"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_colon_space:\n.ascii \": \"\n")
    if x86_native_module_has_operation(module, "print_bool") or x86_native_module_has_operation(module, "direct_print_string_slot"):
        out = asm_writer_append(out, ".L_tyrion_direct_bool_true:\n.ascii \"True\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_bool_false:\n.ascii \"False\"\n")
    if x86_native_module_has_operation(module, "direct_print_string_slot"):
        out = asm_writer_append(out, ".L_tyrion_direct_none_text:\n.ascii \"none\"\n")
        out = asm_writer_append(out, ".L_tyrion_direct_generator_text:\n.ascii \"<generator object>\"\n")
        if "class_descriptors" in module:
            class_idx = 0
            while class_idx < len(module["class_descriptors"]):
                descriptor = module["class_descriptors"][class_idx]
                out = asm_writer_append(out, ".L_tyrion_direct_object_text_" + str(descriptor["id"]) + ":\n")
                out = x86_native_emit_byte_span(out, "<" + descriptor["name"] + " object>")
                class_idx = class_idx + 1
    if has_tcp_primitive or has_terminal_primitive:
        out = asm_writer_append(out, ".section .rodata\n")
    if has_tcp_primitive:
        out = asm_writer_append(out, ".L_tyrion_native_tcp_port_format:\n.asciz \"%lld\"\n")
    if has_terminal_primitive:
        out = asm_writer_append(out, ".L_tyrion_native_terminal_escape_byte:\n.byte 27\n")
        terminal_fields = ["key", "text", "sequence", "shift", "alt", "ctrl", "super"]
        terminal_field_idx = 0
        while terminal_field_idx < len(terminal_fields):
            terminal_field = terminal_fields[terminal_field_idx]
            out = asm_writer_append(out, ".L_tyrion_native_terminal_field_" + terminal_field + ":\n.ascii \"" + terminal_field + "\"\n")
            terminal_field_idx = terminal_field_idx + 1
        terminal_keys = ["up", "down", "left", "right", "enter", "space", "escape", "tab", "backspace", "home", "end", "insert", "delete", "page_up", "page_down", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "char", "codepoint", "unknown", "eof"]
        terminal_key_idx = 0
        while terminal_key_idx < len(terminal_keys):
            terminal_key = terminal_keys[terminal_key_idx]
            out = asm_writer_append(out, ".L_tyrion_native_key_" + terminal_key + ":\n.ascii \"" + terminal_key + "\"\n")
            terminal_key_idx = terminal_key_idx + 1
    if x86_native_module_has_operation(module, "direct_iterator_new") or x86_native_module_has_operation(module, "direct_iterator_next"):
        out = asm_writer_append(out, ".text\n")
        out = x86_native_emit_v2_iterable_runtime(out)
        out = x86_native_emit_dispatch_runtime(out, {"id": 999999})
        out = asm_writer_append(out, x86_native_dispatch_table_label(999999) + ":\n.quad 0\n")
    return out


def x86_native_emit_cached_function(out, function, cache_dir, cache_context, cache_stats=False, trusted_fingerprint=""):
    if cache_dir == "":
        return x86_native_emit_v2_function(out, function)
    if "module_fingerprint" in function:
        if function["module_fingerprint"] == "":
            return x86_native_emit_v2_function(out, function)
    else:
        return x86_native_emit_v2_function(out, function)
    # A verified lowering-unit fingerprint already includes the compiler,
    # target layout, source module, and function identity. Reuse it directly
    # on the staged path so a warm build does not serialize the full IR merely
    # to locate assembly that was emitted from that exact unit.
    if trusted_fingerprint != "":
        fingerprint = cache_context + "\nemitter=tyrion-x86-unit-emitter-v2\nverified-lowering=" + trusted_fingerprint
    else:
        # The non-staged path has no independently verified lowering record,
        # so retain the canonical full-function guard.
        function_record = __tyrion_native_cache_encode(function)
        fingerprint = cache_context + "\nfunction=" + function["name"] + "\nmodule=" + function["module_fingerprint"] + "\nir=" + function_record
    module_identity = ""
    if "module_path" in function:
        module_identity = function["module_path"]
    cache_name = str(compiler_cache_path_hash(fingerprint)) + "-" + str(compiler_cache_short_text_hash(module_identity)) + "-" + str(compiler_cache_short_text_hash(function["name"]))
    cache_path = cache_dir + "/" + cache_name + ".unitcache"
    cached = generated_asm_cache_load(cache_path, fingerprint)
    if cached != "":
        generated_asm_cache_note(cache_dir, "unit-hit", cache_stats)
        return asm_writer_append(out, cached)
    generated_asm_cache_note(cache_dir, "unit-miss", cache_stats)
    temporary_path = cache_path + ".fragment.tmp"
    fragment_writer = asm_writer_open(temporary_path)
    fragment_writer = x86_native_emit_v2_function(fragment_writer, function)
    asm_writer_close(fragment_writer)
    fragment = read_text_file(temporary_path)
    if not __tyrion_run_tool("rm", ["-f", temporary_path])["ok"]:
        fail("compiler cache rejected code=cleanup-failed;path=" + temporary_path)
    generated_asm_cache_store(cache_path, fingerprint, fragment)
    return asm_writer_append(out, fragment)

def emit_linux_x86_64_native_v2_module_asm_into(out, module, cache_dir="", cache_context="", cache_stats=False):
    module = verify_native_ir_v2(module)
    out = emit_linux_x86_64_native_v2_header_asm_into(out)
    function_idx = 0
    while function_idx < len(module["functions"]):
        out = x86_native_emit_cached_function(out, module["functions"][function_idx], cache_dir, cache_context, cache_stats)
        function_idx = function_idx + 1
    return emit_linux_x86_64_native_v2_tail_asm_into(out, module)


def emit_linux_x86_64_native_module_asm_into(out, module):
    module = verify_native_ir_v1(module)
    extensions = []
    if "extensions" in module:
        extensions = module["extensions"]
    out = asm_writer_append(out, "# tyrion-native-ir-v1 target=x86_64-linux\n")
    out = asm_writer_append(out, ".section .note.GNU-stack,\"\",@progbits\n")
    out = asm_writer_append(out, ".bss\n")
    out = asm_writer_append(out, ".p2align 3\n")
    out = asm_writer_append(out, "__tyrion_native_process_argc:\n.quad 0\n")
    out = asm_writer_append(out, "__tyrion_native_process_argv:\n.quad 0\n")
    out = asm_writer_append(out, ".text\n")
    function_idx = 0
    while function_idx < len(module["functions"]):
        out = x86_native_emit_function(out, module["functions"][function_idx])
        function_idx = function_idx + 1
    table_idx = 0
    while table_idx < len(module["dispatch_tables"]):
        out = x86_native_emit_dispatch_runtime(out, module["dispatch_tables"][table_idx])
        table_idx = table_idx + 1
    has_expression_execution = x86_native_module_has_capability(module, "expression-eval") or x86_native_module_has_operation(module, "expr_eval")
    has_statement_execution = x86_native_module_has_capability(module, "statement-execution") or x86_native_module_has_operation(module, "statement_execute") or x86_native_module_has_operation(module, "statement_execute_result") or has_expression_execution
    has_value_slots = x86_native_module_has_capability(module, "value-slots") or x86_native_module_has_operation(module, "expr_eval") or has_statement_execution
    if x86_native_module_has_operation(module, "writer_open") or has_value_slots:
        out = x86_native_emit_writer_runtime(out)
    if has_value_slots:
        out = x86_native_emit_slot_runtime(out)
        out = x86_native_emit_file_runtime(out)
        out = x86_native_emit_tcp_runtime(out, has_expression_execution or has_statement_execution)
        out = x86_native_emit_compiler_file_report_runtime(out)
    # The canonical slot runtime owns closures and objects, whose retain and
    # release paths reference AST handles and lexical environments even in
    # focused value-slot probes. Emit the complete ownership dependency cycle
    # whenever value slots are present rather than relying on unresolved
    # dead-code symbols being discarded by a particular linker.
    if has_value_slots or x86_native_module_has_operation(module, "ast_create") or x86_native_module_has_operation(module, "ast_from_static"):
        out = x86_native_emit_ast_runtime(out)
    if has_value_slots or x86_native_module_has_operation(module, "token_vector_create") or x86_native_module_has_operation(module, "ast_from_static"):
        out = x86_native_emit_token_runtime(out)
    if has_value_slots or x86_native_module_has_operation(module, "environment_create"):
        out = x86_native_emit_environment_runtime(out)
    if has_expression_execution or has_statement_execution:
        out = x86_native_emit_expression_runtime(out)
        out = x86_native_emit_terminal_runtime(out)
        out = x86_native_emit_extension_runtime(out, extensions)
    if has_statement_execution:
        out = x86_native_emit_print_runtime(out)
        out = x86_native_emit_statement_runtime(out)
    out = asm_writer_append(out, ".section .rodata\n")
    if x86_native_module_has_operation(module, "writer_open") or has_value_slots:
        out = asm_writer_append(out, ".L_tyrion_native_writer_mode:\n.asciz \"wb\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_compiler_file_read_prefix:\n.ascii \"compiler-file rejected code=read-failed;path=\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_compiler_file_write_prefix:\n.ascii \"compiler-file rejected code=write-failed;path=\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_compiler_file_newline:\n.ascii \"\\n\"\n")
    if has_statement_execution:
        out = asm_writer_append(out, ".L_tyrion_native_name_init:\n.ascii \"__init__\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_sum:\n.ascii \"sum\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_any:\n.ascii \"any\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_all:\n.ascii \"all\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_min:\n.ascii \"min\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_max:\n.ascii \"max\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_zip:\n.ascii \"zip\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_sorted:\n.ascii \"sorted\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_key:\n.ascii \"key\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_start:\n.ascii \"start\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_range:\n.ascii \"range\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_enumerate:\n.ascii \"enumerate\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_time:\n.ascii \"time\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_open:\n.ascii \"open\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_read:\n.ascii \"read\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_write:\n.ascii \"write\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_flush:\n.ascii \"flush\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_seek:\n.ascii \"seek\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_close:\n.ascii \"close\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_seek_set:\n.ascii \"SEEK_SET\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_seek_cur:\n.ascii \"SEEK_CUR\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_seek_end:\n.ascii \"SEEK_END\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_file_mode_r:\n.ascii \"r\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_none:\n.ascii \"none\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_true:\n.ascii \"True\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_false:\n.ascii \"False\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_int_format:\n.asciz \"%lld\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_float_format:\n.asciz \"%.15g\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_list_open:\n.ascii \"[\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_list_close:\n.ascii \"]\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_tuple_open:\n.ascii \"(\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_tuple_close:\n.ascii \")\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_set_open:\n.ascii \"{\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_set_close:\n.ascii \"}\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_separator:\n.ascii \", \"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_dict_separator:\n.ascii \": \"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_space:\n.ascii \" \"\n")
        out = asm_writer_append(out, ".L_tyrion_native_print_newline:\n.ascii \"\\n\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_read_text_file:\n.ascii \"read_text_file\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_write_text_file:\n.ascii \"write_text_file\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_open:\n.ascii \"asm_writer_open\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_append:\n.ascii \"asm_writer_append\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_close:\n.ascii \"asm_writer_close\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_bytes:\n.ascii \"asm_writer_bytes\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_set_backend:\n.ascii \"asm_writer_set_backend\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_asm_writer_is_x86:\n.ascii \"asm_writer_is_x86\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_str:\n.ascii \"str\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_internal_run_tool:\n.ascii \"__tyrion_run_tool\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_run_tool:\n.ascii \"run_tool\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_host_load:\n.ascii \"__tyrion_native_host_load\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_host_call:\n.ascii \"__tyrion_native_host_call\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_host_unload:\n.ascii \"__tyrion_native_host_unload\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_read_key:\n.ascii \"read_key\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ansi_escape:\n.ascii \"ansi_escape\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_connect:\n.ascii \"__tyrion_native_tcp_connect\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_connect_alias:\n.ascii \"std_io_tcp_connect\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_write:\n.ascii \"__tyrion_native_tcp_write\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_write_alias:\n.ascii \"std_io_tcp_write\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_read:\n.ascii \"__tyrion_native_tcp_read\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_read_alias:\n.ascii \"std_io_tcp_read\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_close:\n.ascii \"__tyrion_native_tcp_close\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_tcp_close_alias:\n.ascii \"std_io_tcp_close\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_tcp_port_format:\n.asciz \"%lld\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_terminal_escape_byte:\n.byte 27\n")
        terminal_fields = ["key", "text", "sequence", "shift", "alt", "ctrl", "super"]
        terminal_field_idx = 0
        while terminal_field_idx < len(terminal_fields):
            terminal_field = terminal_fields[terminal_field_idx]
            out = asm_writer_append(out, ".L_tyrion_native_terminal_field_" + terminal_field + ":\n.ascii \"" + terminal_field + "\"\n")
            terminal_field_idx = terminal_field_idx + 1
        terminal_keys = ["up", "down", "left", "right", "enter", "space", "escape", "tab", "backspace", "home", "end", "insert", "delete", "page_up", "page_down", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "char", "codepoint", "unknown", "eof"]
        terminal_key_idx = 0
        while terminal_key_idx < len(terminal_keys):
            terminal_key = terminal_keys[terminal_key_idx]
            out = asm_writer_append(out, ".L_tyrion_native_key_" + terminal_key + ":\n.ascii \"" + terminal_key + "\"\n")
            terminal_key_idx = terminal_key_idx + 1
        out = asm_writer_append(out, ".L_tyrion_native_name_method_append:\n.ascii \"method_append\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_len:\n.ascii \"len\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ast_builder_create:\n.ascii \"__tyrion_native_ast_builder_create\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ast_builder_len:\n.ascii \"__tyrion_native_ast_builder_len\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ast_builder_append:\n.ascii \"__tyrion_native_ast_builder_append\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ast_builder_finish:\n.ascii \"__tyrion_native_ast_builder_finish\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_ast_builder_get:\n.ascii \"__tyrion_native_ast_builder_get\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_token_builder_count:\n.ascii \"__tyrion_native_token_builder_count\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_token_builder_append:\n.ascii \"__tyrion_native_token_builder_append\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_name_token_builder_field:\n.ascii \"__tyrion_native_token_builder_field\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_backend_x86:\n.ascii \"linux-x86_64\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_read_mode:\n.asciz \"rb\"\n")
        out = asm_writer_append(out, ".L_tyrion_native_write_mode:\n.asciz \"wb\"\n")
        extension_idx = 0
        while extension_idx < len(extensions):
            extension = extensions[extension_idx]
            out = asm_writer_append(out, ".L_tyrion_native_extension_name_" + str(extension_idx) + ":\n")
            out = asm_writer_append(out, ".asciz \"" + asm_escape_string(extension["name"]) + "\"\n")
            extension_idx = extension_idx + 1
        out = asm_writer_append(out, ".section .data.rel.ro,\"aw\",@progbits\n")
        out = asm_writer_append(out, ".p2align 3\n")
        out = asm_writer_append(out, ".L_tyrion_native_extension_table:\n")
        extension_idx = 0
        while extension_idx < len(extensions):
            extension = extensions[extension_idx]
            out = asm_writer_append(out, ".quad .L_tyrion_native_extension_name_" + str(extension_idx) + ", " + str(len(extension["name"])) + ", " + extension["call_symbol"] + "\n")
            extension_idx = extension_idx + 1
        if len(extensions) == 0:
            out = asm_writer_append(out, ".quad 0, 0, 0\n")
        out = asm_writer_append(out, ".section .rodata\n")
    constant_idx = 0
    while constant_idx < len(module["constants"]):
        constant = module["constants"][constant_idx]
        out = asm_writer_append(out, x86_native_constant_label(constant["id"]) + ":\n")
        out = asm_writer_append(out, ".asciz \"" + asm_escape_string(constant["value"]) + "\"\n")
        constant_idx = constant_idx + 1
    global_idx = 0
    while global_idx < len(module["globals"]):
        item = module["globals"][global_idx]
        token_count = native_static_program_token_count(item)
        record_count = native_static_program_record_count(item)
        pool = x86_native_build_token_pool(item)
        record_bytes = x86_native_static_image_checked_multiply(token_count, x86_native_static_token_image_record_size(), "metrics-token-records")
        static_bytes = x86_native_static_token_image_size(token_count, pool["size"])
        static_bytes_per_token = static_bytes / token_count
        out = asm_writer_append(out, "# tyrion-static-token-metrics tokens=" + str(token_count) + " unique_texts=" + str(pool["unique_count"]) + " raw_text_bytes=" + str(pool["raw_size"]) + " pooled_text_bytes=" + str(pool["size"]) + " static_bytes_per_token=" + str(static_bytes_per_token) + "\n")
        out = asm_writer_append(out, ".section .rodata\n")
        out = asm_writer_append(out, ".p2align 3\n")
        out = asm_writer_append(out, ".set " + x86_native_static_token_image_size_label(item["id"]) + ", " + str(static_bytes) + "\n")
        out = asm_writer_append(out, x86_native_static_token_image_label(item["id"]) + ":\n")
        out = asm_writer_append(out, ".quad " + str(x86_native_static_token_image_magic()) + ", " + str(x86_native_static_token_image_version()) + ", " + str(token_count) + ", " + str(pool["size"]) + ", " + str(x86_native_static_token_image_record_size()) + ", 0\n")
        token_idx = 0
        while token_idx < token_count:
            token = native_static_program_token(item, token_idx)
            mapping = x86_native_token_pool_map(pool, token_idx)
            out = asm_writer_append(out, ".quad " + str(token["kind"]) + ", " + str(mapping["line"]) + ", " + str(mapping["column"]) + ", " + str(token["line"]) + ", " + str(token["column"]) + "\n")
            token_idx = token_idx + 1
        out = asm_writer_append(out, x86_native_static_token_pool_label(item["id"]) + ":\n")
        pool_idx = 0
        while pool_idx < pool["unique_count"]:
            out = x86_native_emit_byte_span(out, x86_native_token_pool_text(pool, pool_idx))
            pool_idx = pool_idx + 1
        out = asm_writer_append(out, ".byte 0\n")
        out = asm_writer_append(out, ".section .rodata\n")
        out = asm_writer_append(out, ".p2align 3\n")
        out = asm_writer_append(out, x86_native_static_record_label(item["id"]) + ":\n")
        record_idx = 0
        while record_idx < record_count:
            record = native_static_program_record(item, record_idx)
            out = asm_writer_append(out, ".quad " + str(record["kind"]) + ", " + str(record["start"]) + ", " + str(record["end"]) + ", " + str(record["field0"]) + ", " + str(record["field1"]) + ", " + str(record["field2"]) + ", " + str(record["field3"]) + ", " + str(record["field4"]) + "\n")
            record_idx = record_idx + 1
        global_idx = global_idx + 1
    if len(module["dispatch_tables"]) > 0:
        out = asm_writer_append(out, ".section .data.rel.ro,\"aw\",@progbits\n")
    table_idx = 0
    while table_idx < len(module["dispatch_tables"]):
        table = module["dispatch_tables"][table_idx]
        out = asm_writer_append(out, ".p2align 3\n")
        out = asm_writer_append(out, x86_native_dispatch_table_label(table["id"]) + ":\n")
        entry_idx = 0
        while entry_idx < len(table["entries"]):
            entry = table["entries"][entry_idx]
            out = asm_writer_append(out, ".quad " + x86_native_constant_label(entry["constant_id"]) + ", " + entry["function"] + ", " + str(len(table["parameter_types"])) + "\n")
            entry_idx = entry_idx + 1
        out = asm_writer_append(out, ".quad 0, 0, 0\n")
        table_idx = table_idx + 1
    return out


def emit_linux_x86_64_native_module_asm(module):
    writer = asm_writer_open_memory()
    writer = emit_linux_x86_64_native_module_asm_into(writer, module)
    text = asm_writer_text(writer)
    asm_writer_close(writer)
    return text


def emit_linux_x86_64_native_v2_module_asm(module):
    writer = asm_writer_open_memory()
    writer = emit_linux_x86_64_native_v2_module_asm_into(writer, module)
    text = asm_writer_text(writer)
    asm_writer_close(writer)
    return text


