    out = x86_native_line(out, "jae .L_tyrion_direct_print_sequence_close")
    out = x86_native_line(out, "testq %r14, %r14")
    out = x86_native_line(out, "je .L_tyrion_direct_print_sequence_value")
    out = x86_native_line(out, "movl $1, %edi")
    out = x86_native_line(out, "leaq .L_tyrion_direct_comma_space(%rip), %rsi")
