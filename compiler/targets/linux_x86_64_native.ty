def x86_native_emit_function(out, function):
    instructions = x86_native_function_instructions(function)
    out = asm_writer_append(out, ".globl " + function["name"] + "\n")
    out = asm_writer_append(out, function["name"] + ":\n")
    if function["name"] == "main":
        out = x86_native_line(out, "movq %rdi, __tyrion_native_process_argc(%rip)")
        out = x86_native_line(out, "movq %rsi, __tyrion_native_process_argv(%rip)")
    out = x86_native_line(out, "pushq %rbp")
    out = x86_native_line(out, "movq %rsp, %rbp")
    out = x86_native_line(out, "subq $" + str(x86_native_function_stack_size(instructions)) + ", %rsp")
    global_index = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        block = function["blocks"][block_idx]
        out = asm_writer_append(out, x86_native_block_label(function, block["id"]) + ":\n")
        instruction_idx = 0
        while instruction_idx < len(block["instructions"]):
            instruction = block["instructions"][instruction_idx]
            storage_offset = 0
            if instruction["op"] == "slot_alloc":
                storage_offset = x86_native_slot_storage_offset(instructions, global_index)
            elif instruction["op"] == "ast_append_record":
                storage_offset = x86_native_record_temp_offset(instructions, global_index)
            out = x86_native_emit_instruction(out, instruction, storage_offset, function["id"])
            global_index = global_index + 1
            instruction_idx = instruction_idx + 1
        terminator = block["terminator"]
        if terminator["op"] == "return":
            out = x86_native_line(out, "movq " + x86_native_stack_operand(terminator["value"]) + ", %rax")
            out = x86_native_line(out, "leave")
            out = x86_native_line(out, "ret")
        elif terminator["op"] == "branch":
            out = x86_native_line(out, "cmpq $0, " + x86_native_stack_operand(terminator["condition"]))
            out = x86_native_line(out, "jne " + x86_native_block_label(function, terminator["true_target"]))
            out = x86_native_line(out, "jmp " + x86_native_block_label(function, terminator["false_target"]))
        else:
            fail("x86-native rejected code=terminator-not-selected;op=" + terminator["op"])
        block_idx = block_idx + 1
    return out


def x86_native_module_has_operation(module, op):
    if "streaming_verified" in module and module["streaming_verified"] and "stream_operation_inventory" in module:
        return native_ir_v2_has_text(module["stream_operation_inventory"], op)
    function_idx = 0
    while function_idx < len(module["functions"]):
        block_idx = 0
        blocks = module["functions"][function_idx]["blocks"]
        while block_idx < len(blocks):
            instruction_idx = 0
            instructions = blocks[block_idx]["instructions"]
            while instruction_idx < len(instructions):
                if instructions[instruction_idx]["op"] == op:
                    return True
                instruction_idx = instruction_idx + 1
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return False


def x86_native_module_has_primitive_implementation(module, implementation):
    if "primitive_implementations" in module:
        implementation_idx = 0
        while implementation_idx < len(module["primitive_implementations"]):
            if module["primitive_implementations"][implementation_idx] == implementation:
                return True
            implementation_idx = implementation_idx + 1
        return False
    function_idx = 0
    while function_idx < len(module["functions"]):
        block_idx = 0
        blocks = module["functions"][function_idx]["blocks"]
        while block_idx < len(blocks):
            instruction_idx = 0
            instructions = blocks[block_idx]["instructions"]
            while instruction_idx < len(instructions):
                instruction = instructions[instruction_idx]
                if instruction["op"] == "direct_primitive_call":
                    instruction_implementation = primitive_schema_implementation_for_id(instruction["fields"]["primitive_id"])
                    if instruction_implementation == implementation:
                        return True
                instruction_idx = instruction_idx + 1
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return False


def x86_native_module_has_writer_primitive(module):
    return x86_native_module_has_primitive_implementation(module, "writer_open") or x86_native_module_has_primitive_implementation(module, "writer_append") or x86_native_module_has_primitive_implementation(module, "writer_close") or x86_native_module_has_primitive_implementation(module, "writer_bytes") or x86_native_module_has_primitive_implementation(module, "writer_set_backend") or x86_native_module_has_primitive_implementation(module, "writer_is_x86")


def x86_native_module_has_ast_builder_primitive(module):
    return x86_native_module_has_primitive_implementation(module, "ast_builder_create") or x86_native_module_has_primitive_implementation(module, "ast_builder_len") or x86_native_module_has_primitive_implementation(module, "ast_builder_append") or x86_native_module_has_primitive_implementation(module, "ast_builder_finish") or x86_native_module_has_primitive_implementation(module, "ast_builder_get") or x86_native_module_has_primitive_implementation(module, "token_builder_count") or x86_native_module_has_primitive_implementation(module, "token_builder_append") or x86_native_module_has_primitive_implementation(module, "token_builder_field") or x86_native_module_has_primitive_implementation(module, "lex")


def x86_native_module_has_extension_primitive(module):
    return x86_native_module_has_primitive_implementation(module, "host_load") or x86_native_module_has_primitive_implementation(module, "host_call") or x86_native_module_has_primitive_implementation(module, "host_unload")


def x86_native_v2_primitive_implementation_supported(implementation):
    if implementation == "int" or implementation == "bool" or implementation == "float" or implementation == "str" or implementation == "wall_time":
        return True
    if implementation == "range" or implementation == "read_text_file" or implementation == "read_module_graph" or implementation == "write_text_file":
        return True
    if implementation == "run_tool" or implementation == "run_tool_capture":
        return True
    if implementation == "writer_open" or implementation == "writer_append" or implementation == "writer_close" or implementation == "writer_bytes" or implementation == "writer_set_backend" or implementation == "writer_is_x86":
        return True
    if implementation == "ast_builder_create" or implementation == "ast_builder_len" or implementation == "ast_builder_append" or implementation == "ast_builder_finish" or implementation == "ast_builder_get":
        return True
    if implementation == "token_builder_count" or implementation == "token_builder_append" or implementation == "token_builder_field" or implementation == "lex" or implementation == "program_has_function":
        return True
    if implementation == "host_load" or implementation == "host_call" or implementation == "host_unload":
        return True
    if implementation == "tcp_connect" or implementation == "tcp_write" or implementation == "tcp_read" or implementation == "tcp_close":
        return True
    if implementation == "tls_write" or implementation == "tls_read" or implementation == "ascii_text":
        return True
    if implementation == "terminal_read_key" or implementation == "ansi_escape":
        return True
    if implementation == "input":
        return True
    if implementation == "cache_encode" or implementation == "cache_decode":
        return True
    return False


def x86_native_emit_cache_primitive_runtime(out, implementation):
    label = "__tyrion_direct_primitive_" + implementation
    fail_label = ".L_tyrion_direct_primitive_" + implementation + "_fail"
    done_label = ".L_tyrion_direct_primitive_" + implementation + "_done"
    out = asm_writer_append(out, label + ":\n")
    out = x86_native_line(out, "cmpq $1, %rcx")
    out = x86_native_line(out, "jne " + fail_label)
    out = x86_native_line(out, "testq %rdx, %rdx")
    out = x86_native_line(out, "je " + fail_label)
    out = x86_native_line(out, "movq 0(%rdx), %rsi")
    out = x86_native_line(out, "subq $8, %rsp")
    out = x86_native_line(out, "call __tyrion_app_" + implementation)
    out = x86_native_line(out, "addq $8, %rsp")
    out = x86_native_line(out, "testl %eax, %eax")
    out = x86_native_line(out, "je " + fail_label)
    out = x86_native_line(out, "xorl %eax, %eax")
    out = x86_native_line(out, "jmp " + done_label)
    out = asm_writer_append(out, fail_label + ":\n")
    out = x86_native_line(out, "movl $3, %eax")
    out = asm_writer_append(out, done_label + ":\n")
    return x86_native_line(out, "ret")


def x86_native_module_has_capability(module, capability):
    idx = 0
    while idx < len(module["capabilities"]):
        if module["capabilities"][idx] == capability:
            return True
        idx = idx + 1
    return False


def x86_native_emit_dispatch_runtime(out, table):
