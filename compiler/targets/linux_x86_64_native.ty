    out = x86_native_line(out, "popq %r13")
    out = x86_native_line(out, "popq %r12")
    out = x86_native_line(out, "popq %rbx")
    out = x86_native_line(out, "leave")
    out = x86_native_line(out, "ret")

    # Return an owned ESC string. This is intentionally a language primitive,
    # not a terminal-formatting policy; applications construct arbitrary ANSI
    # sequences themselves.
    out = asm_writer_append(out, "__tyrion_native_terminal_ansi_escape:\n")
    out = x86_native_line(out, "leaq .L_tyrion_native_terminal_escape_byte(%rip), %rsi")
    out = x86_native_line(out, "movl $1, %edx")
    out = x86_native_line(out, "jmp " + slot_publish_string_copy)

