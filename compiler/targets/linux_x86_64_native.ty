def x86_native_emit_compiler_file_report_runtime(out):
    # rdi=path slot, rsi=static diagnostic prefix, rdx=prefix byte length.
    # File primitives report at their ownership boundary; callers only
    # propagate failure, preventing duplicate or missing diagnostics.
    out = asm_writer_append(out, "__tyrion_native_report_compiler_file_failure:\n")
    out = x86_native_line(out, "pushq %rbp")
