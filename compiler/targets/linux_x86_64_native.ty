    out = x86_native_line(out, "call write@PLT")
    out = x86_native_line(out, "movq %r14, %rdi")
    out = x86_native_line(out, "shlq $8, %rdi")
    out = x86_native_line(out, "addq %r12, %rdi")
    out = x86_native_line(out, "addq $128, %rdi")
    out = x86_native_line(out, "call __tyrion_direct_print_string")
    out = x86_native_line(out, "addq $1, %r14")
    out = x86_native_line(out, "jmp .L_tyrion_direct_print_dict_loop")
    out = asm_writer_append(out, ".L_tyrion_direct_print_dict_close:\n")
