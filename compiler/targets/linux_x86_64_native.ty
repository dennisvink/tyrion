def x86_native_stream_components(module, stream_operations, primitive_manifest):
    operation_function = {"operation_inventory": stream_operations, "blocks": []}
    application_components = []
    if native_ir_v2_has_text(module["components"], "exceptions"):
        application_components = ["exceptions"]
    stream_plan = {"aggregate_core": module["ownership_manifest"] == "direct-owned-aggregate", "application": {"components": application_components}}
    return native_direct_components_from_functions(stream_plan, [operation_function], primitive_manifest)


def x86_native_stream_append_unique_primitive_id(primitive_ids, primitive_id):
    idx = 0
    while idx < len(primitive_ids):
        if primitive_ids[idx] == primitive_id:
            return primitive_ids
        idx = idx + 1
    return method_append(primitive_ids, primitive_id)


def x86_native_function_primitive_ids(function):
    # Streamed functions publish this inventory during lowering. Do not walk
    # their just-materialized block graph again merely to rediscover metadata.
    return function["primitive_ids"]


def x86_native_stream_primitive_manifest(primitive_ids):
    implementations = []
    capabilities = []
    primitive_idx = 0
    while primitive_idx < len(primitive_ids):
        primitive_id = primitive_ids[primitive_idx]
        if primitive_id < 1 or primitive_id > primitive_schema_count():
            fail("x86-native rejected code=v2-primitive-id;id=" + str(primitive_id))
        implementation = primitive_schema_implementation_for_id(primitive_id)
        capability = primitive_schema_capability_for_id(primitive_id)
        if implementation == "" or capability == "":
            fail("x86-native rejected code=v2-primitive-id-schema;id=" + str(primitive_id))
        implementations = native_direct_append_unique_name(implementations, implementation)
        capabilities = native_direct_append_unique_name(capabilities, capability)
        primitive_idx = primitive_idx + 1
    return {"implementations": implementations, "capabilities": capabilities}


def x86_native_function_with_stream_metadata(function, function_operations, function_primitive_ids, function_primitives):
    published = {"id": function["id"], "name": function["name"], "visibility": function["visibility"], "parameters": function["parameters"], "result_type": function["result_type"], "entry_block": function["entry_block"], "frame": function["frame"], "blocks": function["blocks"], "effects": function["effects"], "ownership": function["ownership"], "operation_inventory": function_operations, "primitive_ids": function_primitive_ids, "primitive_implementations": function_primitives["implementations"], "primitive_capabilities": function_primitives["capabilities"]}
    for field in ["source_name", "source_arity", "callable_kind", "address_taken", "capture_count", "class_id", "method_name", "module_path", "module_fingerprint", "is_generator_constructor"]:
        if field in function:
            published[field] = function[field]
    if "local_constants" in function:
        published["local_constants"] = function["local_constants"]
    return published


def x86_native_lowering_layout_identity(plan, cache_context):
    layout = {"contract": "tyrion-x86-lowering-layout-v1", "target": plan["target"], "declarations": native_direct_stream_declarations(plan), "classes": plan["classes"], "attribute_names": plan["attribute_names"], "global_names": plan["global_names"], "root_manifest": plan["root_manifest"]}
    return cache_context + "\n" + __tyrion_native_cache_encode(layout)


def x86_native_lowering_layout_token(plan, cache_dir, cache_context):
    if cache_dir == "":
        return ""
    identity = x86_native_lowering_layout_identity(plan, cache_context)
    token = str(len(identity)) + "-" + str(compiler_cache_path_hash(identity)) + "-" + str(compiler_cache_short_text_hash(identity))
    cache_path = cache_dir + "/" + token + ".lowerlayout"
    try:
        cached = __tyrion_native_cache_decode(read_text_file(cache_path))
        if cached["contract"] == "tyrion-x86-lowering-layout-v1" and cached["identity"] == identity:
            return token
        return ""
    except:
        record = {"contract": "tyrion-x86-lowering-layout-v1", "identity": identity}
        temporary_path = cache_path + ".tmp"
        write_text_file(temporary_path, __tyrion_native_cache_encode(record))
        if not __tyrion_run_tool("mv", [temporary_path, cache_path])["ok"]:
            fail("compiler cache rejected code=publish-failed;path=" + cache_path)
        return token


def x86_native_root_module_fingerprint(plan):
    fingerprints = []
    if "module_fingerprints" in plan["program"]:
        fingerprints = plan["program"]["module_fingerprints"]
    if len(fingerprints) == 0:
        return ""
    return fingerprints[len(fingerprints) - 1]["fingerprint"]


def x86_native_root_module_path(plan):
    fingerprints = []
    if "module_fingerprints" in plan["program"]:
        fingerprints = plan["program"]["module_fingerprints"]
    if len(fingerprints) == 0:
        return ""
    return fingerprints[len(fingerprints) - 1]["path"]


def x86_native_lowering_unit_fingerprint(layout_token, unit_kind, function_id, source_name, module_fingerprint):
    return "tyrion-x86-lowering-unit-v2\nverifier=tyrion-native-ir-v2-slot-rows\nlayout=" + layout_token + "\nkind=" + unit_kind + "\nid=" + str(function_id) + "\nsource=" + source_name + "\nmodule=" + module_fingerprint


def x86_native_lowering_unit_cache_path(cache_dir, fingerprint):
    cache_name = str(compiler_cache_path_hash(fingerprint)) + "-" + str(compiler_cache_short_text_hash(fingerprint))
    return cache_dir + "/" + cache_name + ".lowercache"


def x86_native_lowering_unit_load(cache_dir, fingerprint, cache_stats=False):
    if cache_dir == "" or fingerprint == "":
        return None
    cache_path = x86_native_lowering_unit_cache_path(cache_dir, fingerprint)
    try:
        cached = __tyrion_native_cache_decode(read_text_file(cache_path))
        if cached["contract"] == "tyrion-x86-lowering-unit-v2" and cached["fingerprint"] == fingerprint:
            unit = cached["unit"]
            if "verified" in unit and unit["verified"] == True:
                generated_asm_cache_note(cache_dir, "lower-hit", cache_stats)
                return unit
    except:
        cached = None
    generated_asm_cache_note(cache_dir, "lower-miss", cache_stats)
    return None


def x86_native_lowering_unit_store(cache_dir, fingerprint, unit):
    if cache_dir == "" or fingerprint == "":
        return
    cache_path = x86_native_lowering_unit_cache_path(cache_dir, fingerprint)
    temporary_path = cache_path + ".tmp"
    record = {"contract": "tyrion-x86-lowering-unit-v2", "fingerprint": fingerprint, "unit": unit}
    write_text_file(temporary_path, __tyrion_native_cache_encode(record))
    if not __tyrion_run_tool("mv", [temporary_path, cache_path])["ok"]:
        fail("compiler cache rejected code=publish-failed;path=" + cache_path)


def x86_native_lowering_unit(function, operation_inventory, primitive_ids):
    return {"verified": True, "function": function, "operation_inventory": operation_inventory, "primitive_ids": primitive_ids}


def x86_native_stream_verify_emit_function(out, module, function, function_operations, function_primitive_ids, constant_pool, cache_dir="", cache_context="", cache_stats=False, verify_function=True, trusted_fingerprint=""):
    function_primitives = x86_native_stream_primitive_manifest(function_primitive_ids)
    function = x86_native_function_with_stream_metadata(function, function_operations, function_primitive_ids, function_primitives)
    primitive_idx = 0
    while primitive_idx < len(function_primitives["implementations"]):
        implementation = function_primitives["implementations"][primitive_idx]
        if not x86_native_v2_primitive_implementation_supported(implementation):
            source_name = function["name"]
            if "source_name" in function:
                source_name = function["source_name"]
            fail("x86-native rejected code=v2-primitive-not-selected;implementation=" + implementation + ";function=" + source_name)
        primitive_idx = primitive_idx + 1
    stream_operations = []
    stream_primitive_ids = []
    if "stream_operation_inventory" in module:
        stream_operations = module["stream_operation_inventory"]
        stream_primitive_ids = module["stream_primitive_ids"]
    operation_idx = 0
    while operation_idx < len(function_operations):
        stream_operations = native_direct_append_unique_name(stream_operations, function_operations[operation_idx])
        operation_idx = operation_idx + 1
    primitive_idx = 0
    while primitive_idx < len(function_primitive_ids):
        stream_primitive_ids = x86_native_stream_append_unique_primitive_id(stream_primitive_ids, function_primitive_ids[primitive_idx])
        primitive_idx = primitive_idx + 1
    declaration = module["functions"][function["id"]]
    declaration["operation_inventory"] = function_operations
    declaration["primitive_implementations"] = function_primitives["implementations"]
    declaration["primitive_capabilities"] = function_primitives["capabilities"]
    declaration["frame"] = function["frame"]
    declaration["effects"] = function["effects"]
    declaration["ownership"] = function["ownership"]
    functions = module["functions"]
    functions[function["id"]] = declaration
    module["functions"] = functions
    module["stream_operation_inventory"] = stream_operations
    module["stream_primitive_ids"] = stream_primitive_ids
    module["constant_count"] = __tyrion_native_ast_builder_len(constant_pool["constants"], 0)
    if "local_constants" in function:
        module["constant_count"] = len(function["local_constants"])
    module["streaming_verified"] = True
    if verify_function:
        stream_primitive_manifest = x86_native_stream_primitive_manifest(stream_primitive_ids)
        stream_primitive_implementations = stream_primitive_manifest["implementations"]
        stream_primitive_capabilities = stream_primitive_manifest["capabilities"]
        module["components"] = x86_native_stream_components(module, stream_operations, stream_primitive_manifest)
        root_manifest = module["root_manifest"]
        root_manifest["primitive_roots"] = stream_primitive_implementations
        root_manifest["runtime_roots"] = module["components"]
        module["root_manifest"] = root_manifest
        module["primitive_implementations"] = stream_primitive_implementations
        module["primitive_capabilities"] = stream_primitive_capabilities
        module["stream_primitive_implementations"] = stream_primitive_implementations
        module["stream_primitive_capabilities"] = stream_primitive_capabilities
        verify_native_ir_v2_function(module, function)
    declaration = module["functions"][function["id"]]
    declaration["stream_verified"] = True
    functions = module["functions"]
    functions[function["id"]] = declaration
    module["functions"] = functions
    out = x86_native_emit_cached_function(out, function, cache_dir, cache_context, cache_stats, trusted_fingerprint)
    return {"out": out, "module": module}


def emit_linux_x86_64_direct_plan_asm_into(out, plan, cache_dir="", cache_context="", cache_stats=False):
    if plan["contract"] != "tyrion-native-direct-plan-v1":
        fail("direct-native lowering rejected code=plan-contract")
    full_symbol_index = native_direct_reachability_index(plan["functions"], plan["classes"])
    symbol_index = {"entries": full_symbol_index["entries"], "heads": full_symbol_index["heads"]}
    function_plan_store = native_direct_function_plan_store(plan["functions"])
    constant_pool = native_direct_constant_pool_create()
    primitive_manifest = {"implementations": [], "capabilities": []}
    declarations = native_direct_stream_declarations(plan)
    module = native_direct_module_from_parts(plan, declarations, [], primitive_manifest)
    module["streaming_verified"] = True
    module["constant_count"] = 0
    out = emit_linux_x86_64_native_v2_header_asm_into(out)
    lowering_layout_token = x86_native_lowering_layout_token(plan, cache_dir, cache_context)

    main_module_fingerprint = x86_native_root_module_fingerprint(plan)
    main_lowering_fingerprint = ""
    if lowering_layout_token != "" and main_module_fingerprint != "":
        main_lowering_fingerprint = x86_native_lowering_unit_fingerprint(lowering_layout_token, "main", 0, "main", main_module_fingerprint)
    main_lowering_unit = x86_native_lowering_unit_load(cache_dir, main_lowering_fingerprint, cache_stats)
    main_lowering_miss = main_lowering_unit == None
    if main_lowering_miss:
        state = native_direct_function_state(plan, function_plan_store, symbol_index, constant_pool, primitive_manifest, False)
        state = native_direct_lower_statements(state, plan["executable_items"], "program")
        if not state["terminated"]:
            exit_value = native_direct_append_const_int(state, 0, "i32")
            state = exit_value["state"]
            state = native_direct_release_frame_slots(state)
            state = native_direct_finish_block(state, native_ir_v2_return(exit_value["result"]))
        frame = native_ir_v2_frame(len(plan["locals"]), plan["loop_control_slot_count"] + plan["exception_control_slot_count"], plan["value_temporary_slot_count"], state["next_result"])
        function = native_ir_v2_function(0, "main", "public", [], "i32", frame, native_direct_materialize_blocks(state))
        function["effects"] = ["io"]
        if plan["aggregate_core"]:
            function["ownership"] = "owned-frame-cleanup"
        constant_pool = state["constant_pool"]
        primitive_manifest = state["primitive_manifest"]
        function["module_path"] = x86_native_root_module_path(plan)
        function["module_fingerprint"] = main_module_fingerprint
        main_constant_lists = __tyrion_native_ast_builder_finish(constant_pool["constants"])
        function["local_constants"] = main_constant_lists[0]
        main_lowering_unit = x86_native_lowering_unit(function, state["operation_inventory"], state["primitive_ids"])
    function = main_lowering_unit["function"]
    emitted = x86_native_stream_verify_emit_function(out, module, function, main_lowering_unit["operation_inventory"], main_lowering_unit["primitive_ids"], constant_pool, cache_dir, cache_context, cache_stats, main_lowering_miss, main_lowering_fingerprint)
    out = emitted["out"]
    module = emitted["module"]
    if main_lowering_miss:
        x86_native_lowering_unit_store(cache_dir, main_lowering_fingerprint, main_lowering_unit)
    state = none
    function = none
    emitted = none
    main_lowering_unit = none

    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        lowering_fingerprint = ""
        if lowering_layout_token != "" and function_plan["module_fingerprint"] != "":
            lowering_fingerprint = x86_native_lowering_unit_fingerprint(lowering_layout_token, "function", function_plan["id"], function_plan["source_name"], function_plan["module_fingerprint"])
        lowering_unit = x86_native_lowering_unit_load(cache_dir, lowering_fingerprint, cache_stats)
        lowering_miss = lowering_unit == None
        function_constant_pool = native_direct_constant_pool_create()
        if lowering_miss:
            function_primitive_manifest = {"implementations": [], "capabilities": []}
            function_state = native_direct_function_state(function_plan, function_plan_store, symbol_index, function_constant_pool, function_primitive_manifest, True)
            if function_plan["is_generator"]:
                finished = native_direct_finish_generator_constructor(function_state, function_plan)
            else:
                function_state = native_direct_lower_statements(function_state, function_plan["body"], "function." + function_plan["source_name"])
                finished = native_direct_finish_user_function(function_state, function_plan)
            function_constant_pool = finished["state"]["constant_pool"]
            function = finished["function"]
            function["module_path"] = function_plan["module_path"]
            function["module_fingerprint"] = function_plan["module_fingerprint"]
            function_constant_lists = __tyrion_native_ast_builder_finish(function_constant_pool["constants"])
            function["local_constants"] = function_constant_lists[0]
            lowering_unit = x86_native_lowering_unit(function, finished["state"]["operation_inventory"], finished["state"]["primitive_ids"])
        function = lowering_unit["function"]
        emitted = x86_native_stream_verify_emit_function(out, module, function, lowering_unit["operation_inventory"], lowering_unit["primitive_ids"], function_constant_pool, cache_dir, cache_context, cache_stats, lowering_miss, lowering_fingerprint)
        out = emitted["out"]
        module = emitted["module"]
        if lowering_miss:
            x86_native_lowering_unit_store(cache_dir, lowering_fingerprint, lowering_unit)
        function_state = none
        finished = none
        emitted = none
        lowering_unit = none
        function_idx = function_idx + 1

    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        if function_plan["is_generator"]:
            lowering_fingerprint = ""
            if lowering_layout_token != "" and function_plan["module_fingerprint"] != "":
                lowering_fingerprint = x86_native_lowering_unit_fingerprint(lowering_layout_token, "generator-resume", function_plan["resume_id"], function_plan["source_name"], function_plan["module_fingerprint"])
            lowering_unit = x86_native_lowering_unit_load(cache_dir, lowering_fingerprint, cache_stats)
            lowering_miss = lowering_unit == None
            resume_constant_pool = native_direct_constant_pool_create()
            if lowering_miss:
                resume_primitive_manifest = {"implementations": [], "capabilities": []}
                resume_state = native_direct_generator_resume_state(function_plan, function_plan_store, symbol_index, resume_constant_pool, resume_primitive_manifest)
                resume_state = native_direct_lower_statements(resume_state, function_plan["body"], "generator." + function_plan["source_name"])
                finished = native_direct_finish_generator_resume(resume_state, function_plan)
                resume_constant_pool = finished["state"]["constant_pool"]
                function = finished["function"]
                function["module_path"] = function_plan["module_path"]
                function["module_fingerprint"] = function_plan["module_fingerprint"]
                resume_constant_lists = __tyrion_native_ast_builder_finish(resume_constant_pool["constants"])
                function["local_constants"] = resume_constant_lists[0]
                lowering_unit = x86_native_lowering_unit(function, finished["state"]["operation_inventory"], finished["state"]["primitive_ids"])
            function = lowering_unit["function"]
            emitted = x86_native_stream_verify_emit_function(out, module, function, lowering_unit["operation_inventory"], lowering_unit["primitive_ids"], resume_constant_pool, cache_dir, cache_context, cache_stats, lowering_miss, lowering_fingerprint)
            out = emitted["out"]
            module = emitted["module"]
            if lowering_miss:
                x86_native_lowering_unit_store(cache_dir, lowering_fingerprint, lowering_unit)
            resume_state = none
            finished = none
            emitted = none
            lowering_unit = none
        function_idx = function_idx + 1

    stream_operations = module["stream_operation_inventory"]
    stream_primitive_ids = module["stream_primitive_ids"]
    primitive_manifest = x86_native_stream_primitive_manifest(stream_primitive_ids)
    stream_primitive_implementations = primitive_manifest["implementations"]
    stream_primitive_capabilities = primitive_manifest["capabilities"]
    module = native_direct_module_from_parts(plan, module["functions"], [], primitive_manifest)
    module["streaming_verified"] = True
    module["stream_operation_inventory"] = stream_operations
    module["stream_primitive_ids"] = stream_primitive_ids
    module["stream_primitive_implementations"] = stream_primitive_implementations
    module["stream_primitive_capabilities"] = stream_primitive_capabilities
    operation_function = {"operation_inventory": stream_operations, "blocks": []}
    module["components"] = native_direct_components_from_functions(plan, [operation_function], primitive_manifest)
    root_manifest = module["root_manifest"]
    root_manifest["runtime_roots"] = module["components"]
    module["root_manifest"] = root_manifest
    module = verify_native_ir_v2(module)
    return emit_linux_x86_64_native_v2_tail_asm_into(out, module)


def emit_linux_x86_64_direct_program_with_extension_config_asm_into(out, program, extensions, dynamic_extension_mode, dynamic_extension_root, cache_dir="", cache_context="", cache_stats=False):
    target = target_spec("linux", "x86_64")
    application = native_direct_analyze(program, target)
    plan = native_direct_plan(program, application, target)
    plan["extensions"] = extensions
    plan["dynamic_extension_mode"] = dynamic_extension_mode
    plan["dynamic_extension_root"] = dynamic_extension_root
    return emit_linux_x86_64_direct_plan_asm_into(out, plan, cache_dir, cache_context, cache_stats)

def emit_linux_x86_64_direct_program_asm_into(out, program, extensions):
    return emit_linux_x86_64_direct_program_with_extension_config_asm_into(out, program, extensions, "off", "")
