def x86_native_emit_terminal_runtime(out, direct_slots=False):
    slot_publish_string_copy = "__tyrion_native_slot_publish_string_copy"
    slot_dict_set = "__tyrion_native_slot_dict_set_inplace"
    slot_release = "__tyrion_native_slot_release"
    if direct_slots:
        slot_publish_string_copy = "__tyrion_direct_slot_publish_string_copy"
        slot_dict_set = "__tyrion_direct_dict_put_owned"
        slot_release = "__tyrion_direct_slot_release"
    # Insert one event field into an owned canonical dictionary. Key strings
    # and values are copied through the normal slot ABI, so the event owns no
    # pointers into this helper's stack frame.
    out = asm_writer_append(out, "__tyrion_native_terminal_event_put:\n")
    out = x86_native_line(out, "pushq %rbp")
    out = x86_native_line(out, "movq %rsp, %rbp")
    out = x86_native_line(out, "pushq %rbx")
    out = x86_native_line(out, "pushq %r12")
    out = x86_native_line(out, "pushq %r13")
    out = x86_native_line(out, "pushq %r14")
    out = x86_native_line(out, "subq $128, %rsp")
    out = x86_native_line(out, "movq %rdi, %rbx")
    out = x86_native_line(out, "movq %rsi, %r12")
    out = x86_native_line(out, "movq %rdx, %r13")
    out = x86_native_line(out, "movq %rcx, %r14")
    out = x86_native_line(out, "movq %rsp, %rdi")
    out = x86_native_line(out, "xorl %eax, %eax")
    out = x86_native_line(out, "movl $16, %ecx")
    out = x86_native_line(out, "rep stosq")
    out = x86_native_line(out, "movq %rsp, %rdi")
    out = x86_native_line(out, "movq %r12, %rsi")
    out = x86_native_line(out, "movq %r13, %rdx")
    out = x86_native_line(out, "call " + slot_publish_string_copy)
    out = x86_native_line(out, "testl %eax, %eax")
    out = x86_native_line(out, "je .L_tyrion_native_terminal_event_put_done")
    out = x86_native_line(out, "movq %rbx, %rdi")
    out = x86_native_line(out, "movq %rsp, %rsi")
    out = x86_native_line(out, "movq %r14, %rdx")
    out = x86_native_line(out, "call " + slot_dict_set)
    out = x86_native_line(out, "movl %eax, %r12d")
    out = x86_native_line(out, "movq %rsp, %rdi")
    out = x86_native_line(out, "call " + slot_release)
