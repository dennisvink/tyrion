    out = asm_writer_append(out, ".L_tyrion_direct_print_sequence_close:\n")
    out = x86_native_line(out, "leaq .L_tyrion_direct_rbracket(%rip), %rsi")
    out = x86_native_line(out, "cmpb $" + str(generated_value_tag_set_heap()) + ", 127(%rbx)")
    out = x86_native_line(out, "je .L_tyrion_direct_print_sequence_close_set")
    out = x86_native_line(out, "cmpq $" + str(generated_ast_kind_tuple()) + ", 24(%rbx)")
    out = x86_native_line(out, "jne .L_tyrion_direct_print_sequence_close_write")
    out = x86_native_line(out, "leaq .L_tyrion_direct_rparen(%rip), %rsi")
