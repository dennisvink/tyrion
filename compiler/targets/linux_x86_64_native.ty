    out = x86_native_line(out, "subq $8, %rsp")
    out = x86_native_line(out, "movq %rdi, %rbx")
    out = x86_native_line(out, "testq %rbx, %rbx")
    out = x86_native_line(out, "je .L_tyrion_native_tcp_close_descriptor_fail")
    out = x86_native_line(out, "cmpq $0, 16(%rbx)")
    out = x86_native_line(out, "jne .L_tyrion_native_tcp_close_descriptor_success")
    out = x86_native_line(out, "movq 8(%rbx), %rdi")
    out = x86_native_line(out, "cmpq $0, %rdi")
