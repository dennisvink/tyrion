def x86_native_emit_tcp_runtime(out, include_primitives, direct_slots=False):
    slot_release = "__tyrion_native_slot_release"
    slot_string_cstr = "__tyrion_native_slot_string_cstr"
    if direct_slots:
        slot_release = "__tyrion_direct_slot_release"
        slot_string_cstr = "__tyrion_direct_slot_string_cstr"
    # Socket descriptor layout: +0 refcount, +8 descriptor, +16 closed flag.
    out = asm_writer_append(out, "__tyrion_native_tcp_retain:\n")
    out = x86_native_line(out, "xorl %eax, %eax")
    out = x86_native_line(out, "testq %rdi, %rdi")
    out = x86_native_line(out, "je .L_tyrion_native_tcp_retain_done")
