    text = text + "    TyCacheBuffer buffer = {0};\n"
    text = text + "    int ok = ty_cache_buffer_append(&buffer, header, sizeof(header) - 1) &&\n"
    text = text + "             ty_cache_encode_value(value, &buffer, 0);\n"
    text = text + "    if (!ok) {\n"
    text = text + "        free(buffer.data);\n"
    text = text + "        return ty_cache_set_string(out, \"invalid-cache\", 13);\n"
    text = text + "    }\n"
    text = text + "    int published = ty_cache_set_string(out, buffer.data, buffer.length);\n"
    text = text + "    free(buffer.data);\n"
    text = text + "    return published;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "int ty_cache_decode_export(TyCacheSlot *, const TyCacheSlot *) __asm__(\"__tyrion_app_cache_decode\");\n"
    text = text + "int ty_cache_decode_export(TyCacheSlot *out, const TyCacheSlot *encoded) {\n"
    text = text + "    static const char header[] = \"TYRION_AST_CACHE_V1\\n\";\n"
    text = text + "    const char *data = ty_cache_string_data(encoded);\n"
    text = text + "    size_t length = ty_cache_string_length(encoded);\n"
    text = text + "    if (!data || length < sizeof(header) - 1 || memcmp(data, header, sizeof(header) - 1) != 0) {\n"
    text = text + "        ty_cache_decode_sentinel(out);\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    TyCacheReader reader = {data, length, sizeof(header) - 1};\n"
    text = text + "    if (!ty_cache_decode_value(&reader, out, 0) || reader.position != reader.length) {\n"
