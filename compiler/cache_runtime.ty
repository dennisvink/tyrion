# Tyrion Compiler
# Embedded source for the portable compiler-cache native helper.

def compiler_cache_runtime_c_source():
    text = ""
    text = text + "#include <stdint.h>\n"
    text = text + "#include <stdio.h>\n"
    text = text + "#include <stdlib.h>\n"
    text = text + "#include <string.h>\n"
    text = text + "\n"
    text = text + "/* Native Tyrion values are opaque 128-byte slots. Keep this helper at the\n"
    text = text + " * public runtime boundary: it uses the same lifecycle and collection entry\n"
    text = text + " * points as generated Tyrion code and therefore does not duplicate ownership\n"
    text = text + " * rules. */\n"
    text = text + "typedef struct TyCacheSlot {\n"
    text = text + "    unsigned char bytes[128];\n"
    text = text + "} TyCacheSlot;\n"
    text = text + "\n"
    text = text + "#if defined(__x86_64__) && defined(__linux__)\n"
    text = text + "extern void ty_cache_runtime_slot_release(TyCacheSlot *) __asm__(\"__tyrion_direct_slot_release\");\n"
    text = text + "#else\n"
    text = text + "extern void ty_cache_runtime_slot_release(TyCacheSlot *) __asm__(\"__tyrion_app_slot_release\");\n"
    text = text + "#endif\n"
    text = text + "\n"
    text = text + "enum {\n"
    text = text + "    TY_CACHE_TAG_NONE = 0,\n"
    text = text + "    TY_CACHE_TAG_INT = 2,\n"
    text = text + "    TY_CACHE_TAG_BOOL = 3,\n"
    text = text + "    TY_CACHE_TAG_STRING_INLINE = 1,\n"
    text = text + "    TY_CACHE_TAG_STRING_BORROWED = 4,\n"
    text = text + "    TY_CACHE_TAG_STRING_HEAP = 8,\n"
    text = text + "    TY_CACHE_TAG_LIST = 9,\n"
    text = text + "    TY_CACHE_TAG_DICT = 10,\n"
    text = text + "    TY_CACHE_TAG_FLOAT = 19,\n"
    text = text + "};\n"
    text = text + "\n"
    text = text + "typedef struct TyCacheBuffer {\n"
    text = text + "    char *data;\n"
    text = text + "    size_t length;\n"
    text = text + "    size_t capacity;\n"
    text = text + "} TyCacheBuffer;\n"
    text = text + "\n"
    text = text + "typedef struct TyCacheReader {\n"
    text = text + "    const char *data;\n"
    text = text + "    size_t length;\n"
    text = text + "    size_t position;\n"
    text = text + "} TyCacheReader;\n"
    text = text + "\n"
    text = text + "static uint64_t ty_cache_load_u64(const TyCacheSlot *slot, size_t offset) {\n"
    text = text + "    uint64_t value = 0;\n"
    text = text + "    memcpy(&value, slot->bytes + offset, sizeof(value));\n"
    text = text + "    return value;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_store_u64(TyCacheSlot *slot, size_t offset, uint64_t value) {\n"
    text = text + "    memcpy(slot->bytes + offset, &value, sizeof(value));\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static unsigned char ty_cache_tag(const TyCacheSlot *slot) {\n"
    text = text + "    return slot->bytes[127];\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_slot_init(TyCacheSlot *slot) {\n"
    text = text + "    memset(slot, 0, sizeof(*slot));\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_slot_release(TyCacheSlot *slot) {\n"
    text = text + "    ty_cache_runtime_slot_release(slot);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_list_new(TyCacheSlot *out, uint64_t capacity) {\n"
    text = text + "    ty_cache_slot_release(out);\n"
    text = text + "    TyCacheSlot *items = capacity ? calloc((size_t)capacity, sizeof(*items)) : NULL;\n"
    text = text + "    if (capacity && !items) return;\n"
    text = text + "    ty_cache_store_u64(out, 0, (uint64_t)(uintptr_t)items);\n"
    text = text + "    ty_cache_store_u64(out, 8, 0);\n"
    text = text + "    ty_cache_store_u64(out, 16, capacity);\n"
    text = text + "    out->bytes[126] = 2;\n"
    text = text + "    out->bytes[127] = TY_CACHE_TAG_LIST;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_list_set(TyCacheSlot *out, uint64_t index, TyCacheSlot *value) {\n"
    text = text + "    uint64_t capacity = ty_cache_load_u64(out, 16);\n"
    text = text + "    TyCacheSlot *items = (TyCacheSlot *)(uintptr_t)ty_cache_load_u64(out, 0);\n"
    text = text + "    if (!items || index >= capacity) return;\n"
    text = text + "    memcpy(&items[index], value, sizeof(*value));\n"
    text = text + "    ty_cache_slot_init(value);\n"
    text = text + "    if (index >= ty_cache_load_u64(out, 8)) ty_cache_store_u64(out, 8, index + 1);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_dict_new(TyCacheSlot *out, uint64_t capacity) {\n"
    text = text + "    ty_cache_slot_release(out);\n"
    text = text + "    TyCacheSlot *items = capacity ? calloc((size_t)capacity * 2, sizeof(*items)) : NULL;\n"
    text = text + "    if (capacity && !items) return;\n"
    text = text + "    ty_cache_store_u64(out, 0, (uint64_t)(uintptr_t)items);\n"
    text = text + "    ty_cache_store_u64(out, 8, 0);\n"
    text = text + "    ty_cache_store_u64(out, 16, capacity);\n"
    text = text + "    out->bytes[126] = 2;\n"
    text = text + "    out->bytes[127] = TY_CACHE_TAG_DICT;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_dict_set(TyCacheSlot *out, TyCacheSlot *key, TyCacheSlot *value) {\n"
    text = text + "    uint64_t count = ty_cache_load_u64(out, 8);\n"
    text = text + "    uint64_t capacity = ty_cache_load_u64(out, 16);\n"
    text = text + "    TyCacheSlot *items = (TyCacheSlot *)(uintptr_t)ty_cache_load_u64(out, 0);\n"
    text = text + "    if (!items || count >= capacity) return;\n"
    text = text + "    memcpy(&items[count * 2], key, sizeof(*key));\n"
    text = text + "    memcpy(&items[count * 2 + 1], value, sizeof(*value));\n"
    text = text + "    ty_cache_slot_init(key);\n"
    text = text + "    ty_cache_slot_init(value);\n"
    text = text + "    ty_cache_store_u64(out, 8, count + 1);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static const char *ty_cache_string_data(const TyCacheSlot *slot) {\n"
    text = text + "    if (ty_cache_tag(slot) == TY_CACHE_TAG_STRING_INLINE) return (const char *)slot->bytes;\n"
    text = text + "    if (ty_cache_tag(slot) == TY_CACHE_TAG_STRING_BORROWED || ty_cache_tag(slot) == TY_CACHE_TAG_STRING_HEAP) {\n"
    text = text + "        return (const char *)(uintptr_t)ty_cache_load_u64(slot, 0);\n"
    text = text + "    }\n"
    text = text + "    return NULL;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static size_t ty_cache_string_length(const TyCacheSlot *slot) {\n"
    text = text + "    if (ty_cache_tag(slot) == TY_CACHE_TAG_STRING_INLINE) {\n"
    text = text + "        size_t length = 0;\n"
    text = text + "        while (length <= 120 && slot->bytes[length] != '\\0') length++;\n"
    text = text + "        return length;\n"
    text = text + "    }\n"
    text = text + "    return (size_t)ty_cache_load_u64(slot, 8);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_buffer_append(TyCacheBuffer *buffer, const void *data, size_t length) {\n"
    text = text + "    if (!buffer || (!data && length != 0) || length > SIZE_MAX - buffer->length - 1) return 0;\n"
    text = text + "    size_t required = buffer->length + length + 1;\n"
    text = text + "    if (required > buffer->capacity) {\n"
    text = text + "        size_t capacity = buffer->capacity ? buffer->capacity : 256;\n"
    text = text + "        while (capacity < required) {\n"
    text = text + "            if (capacity > SIZE_MAX / 2) return 0;\n"
    text = text + "            capacity *= 2;\n"
    text = text + "        }\n"
    text = text + "        char *grown = (char *)realloc(buffer->data, capacity);\n"
    text = text + "        if (!grown) return 0;\n"
    text = text + "        buffer->data = grown;\n"
    text = text + "        buffer->capacity = capacity;\n"
    text = text + "    }\n"
    text = text + "    if (length != 0) memcpy(buffer->data + buffer->length, data, length);\n"
    text = text + "    buffer->length += length;\n"
    text = text + "    buffer->data[buffer->length] = '\\0';\n"
    text = text + "    return 1;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_buffer_cstr(TyCacheBuffer *buffer, const char *text) {\n"
    text = text + "    return ty_cache_buffer_append(buffer, text, text ? strlen(text) : 0);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_buffer_size(TyCacheBuffer *buffer, size_t value) {\n"
    text = text + "    char text[32];\n"
    text = text + "    int length = snprintf(text, sizeof(text), \"%zu\", value);\n"
    text = text + "    return length > 0 && (size_t)length < sizeof(text) &&\n"
    text = text + "           ty_cache_buffer_append(buffer, text, (size_t)length);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_encode_value(const TyCacheSlot *value, TyCacheBuffer *buffer, unsigned depth) {\n"
    text = text + "    if (!value || !buffer || depth > 256) return 0;\n"
    text = text + "    unsigned char tag = ty_cache_tag(value);\n"
    text = text + "    if (tag == TY_CACHE_TAG_NONE) return ty_cache_buffer_cstr(buffer, \"N;\");\n"
    text = text + "    if (tag == TY_CACHE_TAG_BOOL) {\n"
    text = text + "        return ty_cache_buffer_cstr(buffer, ty_cache_load_u64(value, 0) ? \"B1;\" : \"B0;\");\n"
    text = text + "    }\n"
    text = text + "    if (tag == TY_CACHE_TAG_INT) {\n"
    text = text + "        char text[64];\n"
    text = text + "        int length = snprintf(text, sizeof(text), \"I%lld;\", (long long)ty_cache_load_u64(value, 0));\n"
    text = text + "        return length > 0 && (size_t)length < sizeof(text) &&\n"
    text = text + "               ty_cache_buffer_append(buffer, text, (size_t)length);\n"
    text = text + "    }\n"
    text = text + "    if (tag == TY_CACHE_TAG_FLOAT) {\n"
    text = text + "        double number = 0.0;\n"
    text = text + "        char text[96];\n"
    text = text + "        memcpy(&number, value->bytes, sizeof(number));\n"
    text = text + "        int length = snprintf(text, sizeof(text), \"F%a;\", number);\n"
    text = text + "        return length > 0 && (size_t)length < sizeof(text) &&\n"
    text = text + "               ty_cache_buffer_append(buffer, text, (size_t)length);\n"
    text = text + "    }\n"
    text = text + "    if (tag == TY_CACHE_TAG_STRING_INLINE || tag == TY_CACHE_TAG_STRING_BORROWED || tag == TY_CACHE_TAG_STRING_HEAP) {\n"
    text = text + "        const char *data = ty_cache_string_data(value);\n"
    text = text + "        size_t length = ty_cache_string_length(value);\n"
    text = text + "        return data && ty_cache_buffer_cstr(buffer, \"S\") &&\n"
    text = text + "               ty_cache_buffer_size(buffer, length) &&\n"
    text = text + "               ty_cache_buffer_cstr(buffer, \":\") &&\n"
    text = text + "               ty_cache_buffer_append(buffer, data, length);\n"
    text = text + "    }\n"
    text = text + "    if (tag == TY_CACHE_TAG_LIST) {\n"
    text = text + "        const TyCacheSlot *items = (const TyCacheSlot *)(uintptr_t)ty_cache_load_u64(value, 0);\n"
    text = text + "        size_t count = (size_t)ty_cache_load_u64(value, 8);\n"
    text = text + "        if ((count != 0 && !items) || !ty_cache_buffer_cstr(buffer, \"L\") ||\n"
    text = text + "            !ty_cache_buffer_size(buffer, count) || !ty_cache_buffer_cstr(buffer, \";\")) return 0;\n"
    text = text + "        for (size_t index = 0; index < count; index++) {\n"
    text = text + "            if (!ty_cache_encode_value(&items[index], buffer, depth + 1)) return 0;\n"
    text = text + "        }\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    if (tag == TY_CACHE_TAG_DICT) {\n"
    text = text + "        const unsigned char *entries = (const unsigned char *)(uintptr_t)ty_cache_load_u64(value, 0);\n"
    text = text + "        size_t count = (size_t)ty_cache_load_u64(value, 8);\n"
    text = text + "        if ((count != 0 && !entries) || !ty_cache_buffer_cstr(buffer, \"D\") ||\n"
    text = text + "            !ty_cache_buffer_size(buffer, count) || !ty_cache_buffer_cstr(buffer, \";\")) return 0;\n"
    text = text + "        for (size_t index = 0; index < count; index++) {\n"
    text = text + "            const TyCacheSlot *key = (const TyCacheSlot *)(entries + index * 256);\n"
    text = text + "            const TyCacheSlot *item = (const TyCacheSlot *)(entries + index * 256 + 128);\n"
    text = text + "            if (!ty_cache_encode_value(key, buffer, depth + 1) ||\n"
    text = text + "                !ty_cache_encode_value(item, buffer, depth + 1)) return 0;\n"
    text = text + "        }\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    return 0;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_reader_byte(TyCacheReader *reader, char expected) {\n"
    text = text + "    if (!reader || reader->position >= reader->length || reader->data[reader->position] != expected) return 0;\n"
    text = text + "    reader->position++;\n"
    text = text + "    return 1;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_reader_size(TyCacheReader *reader, size_t *out) {\n"
    text = text + "    if (!reader || !out || reader->position >= reader->length) return 0;\n"
    text = text + "    size_t value = 0;\n"
    text = text + "    size_t start = reader->position;\n"
    text = text + "    while (reader->position < reader->length && reader->data[reader->position] >= '0' && reader->data[reader->position] <= '9') {\n"
    text = text + "        size_t digit = (size_t)(reader->data[reader->position] - '0');\n"
    text = text + "        if (value > (SIZE_MAX - digit) / 10) return 0;\n"
    text = text + "        value = value * 10 + digit;\n"
    text = text + "        reader->position++;\n"
    text = text + "    }\n"
    text = text + "    if (reader->position == start) return 0;\n"
    text = text + "    *out = value;\n"
    text = text + "    return 1;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_set_none(TyCacheSlot *out) {\n"
    text = text + "    ty_cache_slot_release(out);\n"
    text = text + "    ty_cache_slot_init(out);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_set_scalar(TyCacheSlot *out, unsigned char tag, uint64_t bits) {\n"
    text = text + "    ty_cache_set_none(out);\n"
    text = text + "    ty_cache_store_u64(out, 0, bits);\n"
    text = text + "    out->bytes[127] = tag;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_set_string(TyCacheSlot *out, const char *data, size_t length) {\n"
    text = text + "    if (!out || (!data && length != 0)) return 0;\n"
    text = text + "    ty_cache_set_none(out);\n"
    text = text + "    if (length == SIZE_MAX) return 0;\n"
    text = text + "    char *copy = (char *)malloc(length + 1);\n"
    text = text + "    if (!copy) return 0;\n"
    text = text + "    memcpy(copy, data, length);\n"
    text = text + "    copy[length] = '\\0';\n"
    text = text + "    ty_cache_store_u64(out, 0, (uint64_t)(uintptr_t)copy);\n"
    text = text + "    ty_cache_store_u64(out, 8, length);\n"
    text = text + "    out->bytes[127] = TY_CACHE_TAG_STRING_HEAP;\n"
    text = text + "    return 1;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static int ty_cache_decode_value(TyCacheReader *reader, TyCacheSlot *out, unsigned depth) {\n"
    text = text + "    if (!reader || !out || depth > 256 || reader->position >= reader->length) return 0;\n"
    text = text + "    char tag = reader->data[reader->position++];\n"
    text = text + "    if (tag == 'N') {\n"
    text = text + "        if (!ty_cache_reader_byte(reader, ';')) return 0;\n"
    text = text + "        ty_cache_set_none(out);\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    if (tag == 'B') {\n"
    text = text + "        if (reader->position >= reader->length ||\n"
    text = text + "            (reader->data[reader->position] != '0' && reader->data[reader->position] != '1')) return 0;\n"
    text = text + "        uint64_t value = reader->data[reader->position++] == '1';\n"
    text = text + "        if (!ty_cache_reader_byte(reader, ';')) return 0;\n"
    text = text + "        ty_cache_set_scalar(out, TY_CACHE_TAG_BOOL, value);\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    if (tag == 'I' || tag == 'F') {\n"
    text = text + "        size_t start = reader->position;\n"
    text = text + "        while (reader->position < reader->length && reader->data[reader->position] != ';') reader->position++;\n"
    text = text + "        if (reader->position == start || reader->position >= reader->length) return 0;\n"
    text = text + "        size_t length = reader->position - start;\n"
    text = text + "        char text[128];\n"
    text = text + "        if (length >= sizeof(text)) return 0;\n"
    text = text + "        memcpy(text, reader->data + start, length);\n"
    text = text + "        text[length] = '\\0';\n"
    text = text + "        reader->position++;\n"
    text = text + "        if (tag == 'I') {\n"
    text = text + "            char *end = NULL;\n"
    text = text + "            long long value = strtoll(text, &end, 10);\n"
    text = text + "            if (!end || *end != '\\0') return 0;\n"
    text = text + "            ty_cache_set_scalar(out, TY_CACHE_TAG_INT, (uint64_t)value);\n"
    text = text + "        } else {\n"
    text = text + "            char *end = NULL;\n"
    text = text + "            double value = strtod(text, &end);\n"
    text = text + "            uint64_t bits = 0;\n"
    text = text + "            if (!end || *end != '\\0') return 0;\n"
    text = text + "            memcpy(&bits, &value, sizeof(bits));\n"
    text = text + "            ty_cache_set_scalar(out, TY_CACHE_TAG_FLOAT, bits);\n"
    text = text + "        }\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    if (tag == 'S') {\n"
    text = text + "        size_t length = 0;\n"
    text = text + "        if (!ty_cache_reader_size(reader, &length) || !ty_cache_reader_byte(reader, ':') ||\n"
    text = text + "            length > reader->length - reader->position) return 0;\n"
    text = text + "        int ok = ty_cache_set_string(out, reader->data + reader->position, length);\n"
    text = text + "        reader->position += length;\n"
    text = text + "        return ok;\n"
    text = text + "    }\n"
    text = text + "    if (tag == 'L' || tag == 'D' || tag == 'A') {\n"
    text = text + "        size_t count = 0;\n"
    text = text + "        if (!ty_cache_reader_size(reader, &count) || !ty_cache_reader_byte(reader, ';') || count > 1000000) return 0;\n"
    text = text + "        ty_cache_set_none(out);\n"
    text = text + "        if (tag == 'L') ty_cache_list_new(out, (uint64_t)count);\n"
    text = text + "        else ty_cache_dict_new(out, (uint64_t)count);\n"
    text = text + "        if ((tag == 'L' && ty_cache_tag(out) != TY_CACHE_TAG_LIST) ||\n"
    text = text + "            (tag != 'L' && ty_cache_tag(out) != TY_CACHE_TAG_DICT)) return 0;\n"
    text = text + "        for (size_t index = 0; index < count; index++) {\n"
    text = text + "            TyCacheSlot key;\n"
    text = text + "            TyCacheSlot value;\n"
    text = text + "            ty_cache_slot_init(&key);\n"
    text = text + "            ty_cache_slot_init(&value);\n"
    text = text + "            if (tag == 'L') {\n"
    text = text + "                if (!ty_cache_decode_value(reader, &value, depth + 1)) {\n"
    text = text + "                    ty_cache_slot_release(&value);\n"
    text = text + "                    ty_cache_slot_release(out);\n"
    text = text + "                    return 0;\n"
    text = text + "                }\n"
    text = text + "                ty_cache_list_set(out, (uint64_t)index, &value);\n"
    text = text + "            } else {\n"
    text = text + "                if (!ty_cache_decode_value(reader, &key, depth + 1) ||\n"
    text = text + "                    (ty_cache_tag(&key) != TY_CACHE_TAG_STRING_INLINE && ty_cache_tag(&key) != TY_CACHE_TAG_STRING_HEAP) ||\n"
    text = text + "                    !ty_cache_decode_value(reader, &value, depth + 1)) {\n"
    text = text + "                    ty_cache_slot_release(&key);\n"
    text = text + "                    ty_cache_slot_release(&value);\n"
    text = text + "                    ty_cache_slot_release(out);\n"
    text = text + "                    return 0;\n"
    text = text + "                }\n"
    text = text + "                ty_cache_dict_set(out, &key, &value);\n"
    text = text + "            }\n"
    text = text + "            ty_cache_slot_release(&key);\n"
    text = text + "            ty_cache_slot_release(&value);\n"
    text = text + "        }\n"
    text = text + "        return 1;\n"
    text = text + "    }\n"
    text = text + "    return 0;\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "static void ty_cache_decode_sentinel(TyCacheSlot *out) {\n"
    text = text + "    TyCacheSlot key;\n"
    text = text + "    TyCacheSlot value;\n"
    text = text + "    ty_cache_slot_init(&key);\n"
    text = text + "    ty_cache_slot_init(&value);\n"
    text = text + "    ty_cache_set_none(out);\n"
    text = text + "    ty_cache_dict_new(out, 1);\n"
    text = text + "    ty_cache_set_string(&key, \"fingerprint\", 11);\n"
    text = text + "    ty_cache_set_string(&value, \"\", 0);\n"
    text = text + "    ty_cache_dict_set(out, &key, &value);\n"
    text = text + "    ty_cache_slot_release(&key);\n"
    text = text + "    ty_cache_slot_release(&value);\n"
    text = text + "}\n"
    text = text + "\n"
    text = text + "int ty_cache_encode_export(TyCacheSlot *, const TyCacheSlot *) __asm__(\"__tyrion_app_cache_encode\");\n"
