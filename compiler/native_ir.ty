def native_ir_token_vector_probe_module():
    entry = []
    entry.append(native_ir_const_int(0, 2, "usize"))
    entry.append(native_ir_operation(1, "token_vector_create", "token_vector_ptr", [0]))
    entry.append(native_ir_const_address(2, 0))
    entry.append(native_ir_const_int(3, 7, "i32"))
    entry.append(native_ir_const_int(4, 4, "usize"))
    entry.append(native_ir_const_int(5, 3, "usize"))
    entry.append(native_ir_const_int(6, 9, "usize"))
    entry.append(native_ir_operation(7, "token_vector_append", "i32", [1, 3, 2, 4, 5, 6]))
    entry.append(native_ir_operation(8, "token_vector_count", "usize", [1]))
    entry.append(native_ir_const_int(9, 1, "usize"))
    entry.append(native_ir_operation(10, "eq", "i1", [8, 9]))

    kind_check = []
    kind_check.append(native_ir_const_int(11, 0, "usize"))
    kind_check.append(native_ir_operation(12, "token_kind", "i32", [1, 11]))
    kind_check.append(native_ir_const_int(13, 7, "i32"))
    kind_check.append(native_ir_operation(14, "eq", "i1", [12, 13]))

    text_check = []
    text_check.append(native_ir_const_int(15, 0, "usize"))
    text_check.append(native_ir_operation(16, "token_text_length", "usize", [1, 15]))
    text_check.append(native_ir_const_int(17, 4, "usize"))
    text_check.append(native_ir_operation(18, "eq", "i1", [16, 17]))

    success = []
    success.append(native_ir_operation(19, "token_vector_release", "i32", [1]))
    success.append(native_ir_const_int(20, 0, "i32"))

    failure = []
    failure.append(native_ir_operation(21, "token_vector_release", "i32", [1]))
    failure.append(native_ir_const_int(22, 1, "i32"))

    blocks = []
    blocks.append(native_ir_block(0, entry, native_ir_branch(10, 1, 4)))
    blocks.append(native_ir_block(1, kind_check, native_ir_branch(14, 2, 4)))
    blocks.append(native_ir_block(2, text_check, native_ir_branch(18, 3, 4)))
    blocks.append(native_ir_block(3, success, native_ir_return(20)))
    blocks.append(native_ir_block(4, failure, native_ir_return(22)))
    function = native_ir_function("main", "i32", blocks)
    constant = {"id": 0, "kind": "string", "value": "name"}
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [function], "globals": [], "constants": [constant], "externals": [], "dispatch_tables": [], "capabilities": ["core", "token-records"], "ownership_manifest": "token-vector-owned-records-borrowed-text"}


