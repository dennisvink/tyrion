def native_ir_cli_probe_module(usage_text, version_text):
    usage_payload = usage_text + "\n"
    version_payload = version_text + "\n"

    entry = []
    entry.append(native_ir_parameter(0, 0, "i32"))
    entry.append(native_ir_parameter(1, 1, "ptr"))
    entry.append(native_ir_const_int(2, 1, "i32"))
    entry.append(native_ir_operation(3, "eq", "i1", [0, 2]))

    argc_two = []
    argc_two.append(native_ir_const_int(4, 2, "i32"))
    argc_two.append(native_ir_operation(5, "eq", "i1", [0, 4]))

    help_check = []
    help_check.append(native_ir_operation(6, "argv_at", "ptr", [1, 2]))
    help_check.append(native_ir_const_address(7, 0))
    help_check.append(native_ir_call_external(8, "strcmp", [6, 7], "i32"))
    help_check.append(native_ir_const_int(9, 0, "i32"))
    help_check.append(native_ir_operation(10, "eq", "i1", [8, 9]))

    version_check = []
    version_check.append(native_ir_const_address(11, 1))
    version_check.append(native_ir_call_external(12, "strcmp", [6, 11], "i32"))
    version_check.append(native_ir_const_int(13, 0, "i32"))
    version_check.append(native_ir_operation(14, "eq", "i1", [12, 13]))

    usage = []
    usage.append(native_ir_const_int(15, 1, "i32"))
    usage.append(native_ir_const_address(16, 2))
    usage.append(native_ir_const_int(17, len(usage_payload), "usize"))
    usage.append(native_ir_call_external(18, "write", [15, 16, 17], "isize"))
    usage.append(native_ir_const_int(19, 0, "i32"))

    version = []
    version.append(native_ir_const_int(20, 1, "i32"))
    version.append(native_ir_const_address(21, 3))
    version.append(native_ir_const_int(22, len(version_payload), "usize"))
    version.append(native_ir_call_external(23, "write", [20, 21, 22], "isize"))
    version.append(native_ir_const_int(24, 0, "i32"))

    unsupported = [native_ir_const_int(25, 1, "i32")]
    blocks = []
    blocks.append(native_ir_block(0, entry, native_ir_branch(3, 4, 1)))
    blocks.append(native_ir_block(1, argc_two, native_ir_branch(5, 2, 6)))
    blocks.append(native_ir_block(2, help_check, native_ir_branch(10, 4, 3)))
    blocks.append(native_ir_block(3, version_check, native_ir_branch(14, 5, 6)))
    blocks.append(native_ir_block(4, usage, native_ir_return(19)))
    blocks.append(native_ir_block(5, version, native_ir_return(24)))
    blocks.append(native_ir_block(6, unsupported, native_ir_return(25)))
    function = native_ir_function_with_parameters("main", ["i32", "ptr"], "i32", blocks)
    constants = []
    constants.append({"id": 0, "kind": "string", "value": "--help"})
    constants.append({"id": 1, "kind": "string", "value": "--version"})
    constants.append({"id": 2, "kind": "string", "value": usage_payload})
    constants.append({"id": 3, "kind": "string", "value": version_payload})
    externals = []
    externals.append({"name": "write", "parameters": ["i32", "ptr", "usize"], "result_type": "isize", "effect": "io"})
    externals.append({"name": "strcmp", "parameters": ["ptr", "ptr"], "result_type": "i32", "effect": "read"})
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [function], "globals": [], "constants": constants, "externals": externals, "dispatch_tables": [], "capabilities": ["core", "compiler-cli"], "ownership_manifest": "no-owned-values"}


def native_ir_internal_call_probe_module():
    main_instructions = []
    main_instructions.append(native_ir_const_int(0, 41, "i32"))
    main_instructions.append(native_ir_call_internal(1, "__tyrion_native_ir_add_one", [0], "i32"))
