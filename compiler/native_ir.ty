    instructions.append(native_ir_operation(3, "slot_set_int", "slot_ptr", [1, 2]))
    instructions.append(native_ir_operation(4, "slot_alloc", "slot_ptr", []))
    instructions.append(native_ir_operation(5, "slot_zero", "slot_ptr", [4]))
    instructions.append(native_ir_operation(6, "slot_copy", "slot_ptr", [5, 3]))
    instructions.append(native_ir_operation(7, "slot_get_int", "i32", [6]))
    instructions.append(native_ir_const_int(8, 42, "i32"))
    instructions.append(native_ir_operation(9, "sub", "i32", [7, 8]))
    block = native_ir_block(0, instructions, native_ir_return(9))
    function = native_ir_function("main", "i32", [block])
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [function], "globals": [], "constants": [], "externals": [], "dispatch_tables": [], "capabilities": ["core", "value-slots"], "ownership_manifest": "stack-slots"}


