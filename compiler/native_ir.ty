# Versioned architecture-neutral native IR records.

def native_ir_value(result, op, value_type, fields):
    return {"result": result, "op": op, "type": value_type, "fields": fields}


def native_ir_const_int(result, value, value_type):
    return native_ir_value(result, "const_int", value_type, {"value": value})


def native_ir_const_address(result, constant_id):
    return native_ir_value(result, "const_address", "ptr", {"constant_id": constant_id})


def native_ir_call_external(result, name, args, result_type):
    return native_ir_value(result, "call_external", result_type, {"name": name, "args": args})


def native_ir_operation(result, op, result_type, args):
    return native_ir_value(result, op, result_type, {"args": args})


def native_ir_parameter(result, index, value_type):
    return native_ir_value(result, "parameter", value_type, {"index": index})


def native_ir_call_internal(result, name, args, result_type):
    return native_ir_value(result, "call_internal", result_type, {"name": name, "args": args})


def native_ir_dispatch_call(result, table_id, name, args, actual_arity, result_type):
    return native_ir_value(result, "dispatch_call", result_type, {"table_id": table_id, "name": name, "args": args, "actual_arity": actual_arity})


def native_ir_dispatch_entry(constant_id, function):
    return {"constant_id": constant_id, "function": function}


def native_ir_dispatch_table(table_id, parameter_types, result_type, entries):
    return {"id": table_id, "parameter_types": parameter_types, "result_type": result_type, "entries": entries}


def native_ir_return(value):
    return {"op": "return", "value": value}


def native_ir_branch(condition, true_target, false_target):
    return {"op": "branch", "condition": condition, "true_target": true_target, "false_target": false_target}


def native_ir_block(block_id, instructions, terminator):
    return {"id": block_id, "instructions": instructions, "terminator": terminator}


def native_ir_function(name, result_type, blocks):
    return {"name": name, "visibility": "public", "parameters": [], "result_type": result_type, "entry_block": 0, "blocks": blocks, "local_slot_count": 0, "effect_set": ["io"], "ownership_contract": "no-owned-results"}


def native_ir_function_with_parameters(name, parameters, result_type, blocks):
    return {"name": name, "visibility": "public", "parameters": parameters, "result_type": result_type, "entry_block": 0, "blocks": blocks, "local_slot_count": 0, "effect_set": ["io"], "ownership_contract": "no-owned-results"}


def native_ir_literal_module(payload):
    instructions = []
    instructions.append(native_ir_const_int(0, 1, "i32"))
    instructions.append(native_ir_const_address(1, 0))
    instructions.append(native_ir_const_int(2, len(payload), "usize"))
    instructions.append(native_ir_call_external(3, "write", [0, 1, 2], "isize"))
    instructions.append(native_ir_const_int(4, 0, "i32"))
    block = native_ir_block(0, instructions, native_ir_return(4))
    function = native_ir_function("main", "i32", [block])
    constant = {"id": 0, "kind": "string", "value": payload}
    external = {"name": "write", "parameters": ["i32", "ptr", "usize"], "result_type": "isize", "effect": "io"}
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [function], "globals": [], "constants": [constant], "externals": [external], "dispatch_tables": [], "capabilities": ["core"], "ownership_manifest": "no-owned-values"}


