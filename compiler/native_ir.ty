    main_instructions.append(native_ir_operation(3, "sub", "i32", [1, 2]))
    main_block = native_ir_block(0, main_instructions, native_ir_return(3))
    main_function = native_ir_function("main", "i32", [main_block])

    add_instructions = []
    add_instructions.append(native_ir_parameter(0, 0, "i32"))
    add_instructions.append(native_ir_const_int(1, 1, "i32"))
    add_instructions.append(native_ir_operation(2, "add", "i32", [0, 1]))
    add_block = native_ir_block(0, add_instructions, native_ir_return(2))
    add_function = native_ir_function_with_parameters("__tyrion_native_ir_add_one", ["i32"], "i32", [add_block])
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [main_function, add_function], "globals": [], "constants": [], "externals": [], "dispatch_tables": [], "capabilities": ["core", "internal-calls"], "ownership_manifest": "no-owned-values"}


def native_ir_dispatch_probe_module(dispatch_name, actual_arity):
    main_instructions = []
    main_instructions.append(native_ir_const_address(0, 0))
    main_instructions.append(native_ir_const_int(1, 41, "i32"))
    main_instructions.append(native_ir_dispatch_call(2, 0, 0, [1], actual_arity, "i32"))
    main_instructions.append(native_ir_const_int(3, 42, "i32"))
    main_instructions.append(native_ir_operation(4, "sub", "i32", [2, 3]))
    main_block = native_ir_block(0, main_instructions, native_ir_return(4))
    main_function = native_ir_function("main", "i32", [main_block])

    add_instructions = []
    add_instructions.append(native_ir_parameter(0, 0, "i32"))
    add_instructions.append(native_ir_const_int(1, 1, "i32"))
    add_instructions.append(native_ir_operation(2, "add", "i32", [0, 1]))
    add_block = native_ir_block(0, add_instructions, native_ir_return(2))
    add_function = native_ir_function_with_parameters("__tyrion_native_ir_dispatch_add_one", ["i32"], "i32", [add_block])

    constants = []
    constants.append({"id": 0, "kind": "string", "value": dispatch_name})
    constants.append({"id": 1, "kind": "string", "value": "add_one"})
    entries = [native_ir_dispatch_entry(1, "__tyrion_native_ir_dispatch_add_one")]
    table = native_ir_dispatch_table(0, ["i32"], "i32", entries)
    return {"contract": "tyrion-native-ir-v1", "target_independent_abi_version": 1, "functions": [main_function, add_function], "globals": [], "constants": constants, "externals": [], "dispatch_tables": [table], "capabilities": ["core", "dynamic-dispatch"], "ownership_manifest": "no-owned-values"}


