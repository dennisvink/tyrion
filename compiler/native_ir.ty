    initialized.append(native_ir_v2_instruction(4, "slot_set_int", "slot_ptr", {"args": [1, 3]}))
    merge = []
    merge.append(native_ir_v2_instruction(5, "slot_get_int", "i32", {"args": [1]}))
    blocks = []
    blocks.append(native_ir_v2_block(0, entry, native_ir_v2_branch(2, 1, 2)))
    blocks.append(native_ir_v2_block(1, initialized, native_ir_v2_jump(3)))
    blocks.append(native_ir_v2_block(2, [], native_ir_v2_jump(3)))
    blocks.append(native_ir_v2_block(3, merge, native_ir_v2_return(5)))
    probe = native_ir_v2_probe_module(blocks, 6)
