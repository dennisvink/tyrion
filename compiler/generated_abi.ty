def generated_token_kind_names():
    return ["EOF", "NEWLINE", "INDENT", "DEDENT", "IDENTIFIER", "STRING", "INT", "FLOAT", "KW_DEF", "KW_CLASS", "KW_IF", "KW_ELIF", "KW_ELSE", "KW_WHILE", "KW_FOR", "KW_IN", "KW_RETURN", "KW_RAISE", "KW_TRY", "KW_EXCEPT", "KW_FINALLY", "KW_WITH", "KW_AS", "KW_AND", "KW_OR", "KW_NOT", "KW_TRUE", "KW_FALSE", "KW_NONE", "KW_BREAK", "KW_CONTINUE", "KW_UNLESS", "KW_LAMBDA", "KW_YIELD", "LPAREN", "RPAREN", "LBRACE", "RBRACE", "LBRACKET", "RBRACKET", "COMMA", "COLON", "DOT", "MINUS", "STAR", "SLASH", "PERCENT", "PLUS", "EQ", "UNKNOWN", "LT", "GT", "PLUSEQ", "EQEQ", "NE", "LE", "GE"]


def generated_token_kind_id(name):
    names = generated_token_kind_names()
    idx = 0
    while idx < len(names):
        if names[idx] == name:
            return idx + 1
        idx = idx + 1
    fail("generated ABI rejected unknown token kind: " + name)


def generated_token_kind_identifier():
    return generated_token_kind_id("IDENTIFIER")


