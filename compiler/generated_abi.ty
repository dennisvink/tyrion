def generated_direct_closure_function_id_offset():
    # Native IR v2 reuses the canonical closure descriptor footprint without
    # retaining parser AST state: bytes 8/16/24 hold the direct function ID,
    # capture count, and contiguous canonical capture-slot array.
    return generated_closure_ast_offset()


def generated_direct_closure_capture_count_offset():
    return generated_closure_record_offset()


def generated_direct_closure_captures_offset():
