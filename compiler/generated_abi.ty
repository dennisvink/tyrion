def generated_direct_closure_globals_offset():
    return 32


def generated_direct_closure_size():
    return 40


def generated_abi_contract_text():
    out = lowered_function_label(generated_abi_version(), ":token=")
    out = lowered_function_label(out, str(generated_token_vector_magic()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_token_vector_header_size()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_token_record_size()))
    out = lowered_function_label(out, ":ast=")
    out = lowered_function_label(out, str(generated_ast_arena_magic()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_ast_record_size()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_ast_handle_magic()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_ast_handle_size()))
    out = lowered_function_label(out, ":value=")
    out = lowered_function_label(out, str(generated_value_slot_size()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_value_tag_offset()))
    out = lowered_function_label(out, ",")
    out = lowered_function_label(out, str(generated_value_owner_offset()))
    return out


