# Generated values occupy 128-byte slots. Byte 127 is the stable value tag and
# byte 126 is the owner discriminator. Owner 0 is inline/borrowed, owner 1 owns
# the pointer in byte 0, and owners 2/3 identify canonical typed aggregate
# storage whose elements must be copied/released recursively. These tags are
# shared by compiler execution and direct applications; they are not parser
# statement-kind values.
def generated_value_slot_size():
    return 128


def generated_value_tag_offset():
    return 127


def generated_value_owner_offset():
    return 126


def generated_value_owner_mem(reg):
    out = lowered_function_label("[", reg)
    out = lowered_function_label(out, ", #126]")
    return out


def generated_value_tag_mem(reg):
    out = lowered_function_label("[", reg)
    out = lowered_function_label(out, ", #127]")
    return out


def generated_value_tag_none():
    # No payload and no ownership.
    return 0


def generated_value_tag_string_inline():
    # NUL-terminated UTF-8 bytes live directly in bytes 0..120.
    return 1


def generated_value_tag_int():
    # Signed 64-bit integer in bytes 0..7.
    return 2


def generated_value_tag_bool():
    # Canonical 0/1 integer payload in bytes 0..7.
    return 3


def generated_value_tag_string_borrowed():
    # Application literal/borrowed string: bytes 0/8 contain pointer/length.
    # The slot does not own the pointed-to storage.
    return 4


def generated_value_tag_collection_inline():
    # Compiler-internal compact collection payload stored in the slot. Direct
    # applications normalize mutable/owned aggregates to tags 9, 10, or 20.
    return 5


def generated_value_tag_object():
    # Direct application object descriptor pointer in byte 0. The descriptor
    # owns a refcount and canonical field dictionary.
    return 6


def generated_object_refcount_offset():
    return 0


def generated_object_class_name_offset():
    return 8


def generated_object_class_name_length_offset():
    return 16


def generated_object_fields_offset():
    return 24


def generated_object_size():
    return 32


def generated_direct_object_class_id_offset():
    # Native IR v2 uses the canonical object descriptor footprint without
    # retaining class-name source text. Bytes 8/16/24 contain the immutable
    # class ID, fixed attribute-slot count, and contiguous owned field slots.
    return generated_object_class_name_offset()


def generated_direct_object_field_count_offset():
    return generated_object_class_name_length_offset()


def generated_direct_object_fields_offset():
    return generated_object_fields_offset()


def generated_value_tag_alias():
    # Non-owning compiler-internal alias. Byte 0 points at another live value
    # slot; aliases must not escape the frame that owns the referent.
    return 7


def generated_value_tag_string_heap():
    # Pointer and byte length in bytes 0/8. Owner 1 frees the byte allocation;
    # owner 0 is a non-owning compiler-runtime view.
    return 8


def generated_value_tag_collection_heap():
    # Owned list/tuple payload: bytes 0/8/16 contain the element pointer,
    # logical length, and capacity. Elements are canonical 128-byte values.
    return 9


def generated_value_tag_dict_heap():
    # Owned insertion-ordered dictionary payload. Bytes 0/8/16 contain the
    # pair-record pointer, logical pair count, and capacity; every pair is two
    # adjacent canonical value slots.
    return 10


def generated_value_tag_payload_heap():
    # Compiler-internal opaque heap payload or typed token vector. Bytes 0/8
    # hold pointer/length; application iterators are represented by retained
    # iterable values and explicit index state rather than this tag.
    return 11


def generated_value_tag_file():
    # Byte 0 points to a refcounted runtime file record containing FILE* and
    # open/closed state. Copy retains; release closes only the final live owner.
    return 12


def generated_value_tag_tcp_socket():
    # Byte 0 points to a refcounted socket record containing the descriptor and
    # open/closed state. Copy retains; close is shared and idempotent.
    return 13


def generated_value_tag_ast_builder():
    # Pointer in byte 0 to a refcounted compiler AST builder. The builder owns
    # two canonical list slots (tokens and records). Copy retains the descriptor;
    # release drops both lanes only when the final reference is released.
    return 14


def generated_value_tag_extension_handle():
    # Pointer in bytes 0..7 to a refcounted 48-byte extension record:
    # refcount, backend kind, registry index/library handle, call pointer,
    # loaded state, and optional close pointer. Copies retain the record;
    # aliases therefore observe shared unload state.
    return 15


# Tag 16 is reserved. It must not be assigned by target-local code; adding a
# value kind requires a canonical ABI version and lifetime proof.
def generated_value_tag_writer():
    # Compiler-owned assembly writer pointer in byte 0. The writer record owns
    # its growable byte buffer and is retained/released explicitly.
    return 17


def generated_value_tag_ast_handle():
    # Pointer in byte 0 to the refcounted 80-byte AST handle described above.
    # Sequence views retain their parent handle and encode projection flags.
    return 18


def generated_value_tag_float():
    # Scalar IEEE-754 binary64 payload stored in bytes 0..7 of the value slot.
    return 19


def generated_value_tag_set_heap():
    # Heap collection payload with uniqueness semantics; bytes 0/8/16 hold
    # data pointer, logical length, and capacity respectively.
    return 20


def generated_value_tag_generator():
    # Owned resumable generator state. Byte 0 points to the resume/state/local
    # record used by the canonical iterator ABI.
    return 21


