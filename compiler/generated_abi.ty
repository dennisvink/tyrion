def generated_abi_mem(reg, offset):
    # Keep each append result in a named slot. Generated nested additive
    # evaluation may otherwise retain an alias to an intermediate owned string
    # while the following append grows or replaces its backing allocation.
    out = lowered_function_label("[", reg)
    out = lowered_function_label(out, ", #")
    out = lowered_function_label(out, str(offset))
    out = lowered_function_label(out, "]")
    return out


