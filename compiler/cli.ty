# compiler / cli: responsibility-owned canonical compiler module.

def compiler_usage_text():
    return "Usage:\n  tyrionic --help\n  tyrionic --version\n  tyrionic --scan <input.ty>\n  tyrionic --tokens <input.ty>\n  tyrionic --token-summary <input.ty>\n  tyrionic --parse-summary <input.ty>\n  tyrionic --build <input.ty> --out <output>\n  tyrionic --build <input.ty> --out <output> --target <host|darwin-aarch64|linux-aarch64|linux-x86_64>\n  tyrionic --build <input.ty> --out <output> --emit=assembly\n  tyrionic --build <input.ty> --out <output> --emit=objects\n  tyrionic --build <input.ty> --out <output> --ext-static=<off|auto|required>\n  tyrionic --build <input.ty> --out <output> --ext-dynamic=<off|allowed> --ext-dir <path>\n  tyrionic --build <input.ty> --out <output> --cache-stats"

def compiler_version_text():
    return "tyrion compiler 1.0.0"

def usage():
    print("Usage:")
    print("  tyrionic --help")
    print("  tyrionic --version")
    print("  tyrionic --scan <input.ty>")
    print("  tyrionic --tokens <input.ty>")
    print("  tyrionic --token-summary <input.ty>")
    print("  tyrionic --parse-summary <input.ty>")
    print("  tyrionic --build <input.ty> --out <output>")
    print("  tyrionic --build <input.ty> --out <output> --target <host|darwin-aarch64|linux-aarch64|linux-x86_64>")
    print("  tyrionic --build <input.ty> --out <output> --emit=assembly")
    print("  tyrionic --build <input.ty> --out <output> --emit=objects")
    print("  tyrionic --build <input.ty> --out <output> --cache-dir <directory>")
    print("  tyrionic --build <input.ty> --out <output> --cache-stats")
    print("  tyrionic --build <input.ty> --out <output> --ext-static=<off|auto|required>")
    print("  tyrionic --build <input.ty> --out <output> --ext-dynamic=<off|allowed> --ext-dir <path>")

def version():
    print(compiler_version_text())

def command_scan(path):
    inv = source_inventory(path)
    print("source=" + path)
    print("line_count=" + str(inv["line_count"]))
    print("nonempty_line_count=" + str(inv["nonempty_line_count"]))

def command_token_summary(path):
    source = read_text_file(path)
    tokens = lex(source)
    inv = token_inventory(tokens)
    print("source=" + path)
    print("token_count=" + str(inv["token_count"]))
    print("identifier_count=" + str(inv["identifier_count"]))
    print("keyword_count=" + str(inv["keyword_count"]))
    print("string_count=" + str(inv["string_count"]))
    print("int_count=" + str(inv["int_count"]))
    print("float_count=" + str(inv["float_count"]))
    print("indent_count=" + str(inv["indent_count"]))
    print("dedent_count=" + str(inv["dedent_count"]))
    print("unknown_count=" + str(inv["unknown_count"]))

def command_tokens(path):
    source = read_text_file(path)
    tokens = lex(source)
    idx = 0
    while idx < token_count(tokens):
        print(str(idx) + ":" + token_kind_at(tokens, idx) + ":" + token_text_at(tokens, idx))
        idx = idx + 1

def command_parse_summary(path):
    source = read_text_file(path)
    tokens = lex(source)
    program = parse_program(tokens)
    inv = ast_inventory(program)
    print("source=" + path)
    print("node_count=" + str(inv["node_count"]))
    print("function_count=" + str(inv["function_count"]))
    print("assign_count=" + str(inv["assign_count"]))
    print("return_count=" + str(inv["return_count"]))
    print("if_count=" + str(inv["if_count"]))
    print("while_count=" + str(inv["while_count"]))
    print("for_count=" + str(inv["for_count"]))
    print("expr_count=" + str(inv["expr_count"]))
    print("call_count=" + str(inv["call_count"]))
    print("print_call_count=" + str(inv["print_call_count"]))
    print("binary_count=" + str(inv["binary_count"]))
    print("unary_count=" + str(inv["unary_count"]))

def cli_route_info_add_test(info, expr):
    if expr["kind"] == "binary" and expr["op"] == "and":
        info = cli_route_info_add_test(info, expr["left"])
        return cli_route_info_add_test(info, expr["right"])
    if expr["kind"] == "binary" and expr["op"] == "==":
        if expr_is_args_len_call(expr["left"]) and expr["right"]["kind"] == "int":
            info["argc"] = expr["right"]["value"]
            return info
        if expr_is_args_len_call(expr["right"]) and expr["left"]["kind"] == "int":
            info["argc"] = expr["left"]["value"]
            return info
        if expr_is_args_index(expr["left"]) and expr["right"]["kind"] == "string":
            info["tests"] = method_append(info["tests"], {"index": expr["left"]["index"]["value"], "value": expr["right"]["value"]})
            return info
        if expr_is_args_index(expr["right"]) and expr["left"]["kind"] == "string":
            info["tests"] = method_append(info["tests"], {"index": expr["right"]["index"]["value"], "value": expr["left"]["value"]})
            return info
    fail("unsupported cli_main route condition for native lowering")

def cli_route_info(condition):
    return cli_route_info_add_test({"argc": -1, "tests": []}, condition)

def cli_test_value(info, index):
    idx = 0
    while idx < len(info["tests"]):
        if info["tests"][idx]["index"] == index:
            return info["tests"][idx]["value"]
        idx = idx + 1
    return ""

def cli_spec_record_route(spec, info, action):
    first = cli_test_value(info, 0)
    third = cli_test_value(info, 2)
    if action == "usage":
        if info["argc"] == 0 or info["argc"] == -1:
            spec["usage_default"] = True
        elif info["argc"] == 1 and first != "":
            spec["help_flag"] = first
    elif action == "version":
        if info["argc"] == 1 and first != "":
            spec["version_flag"] = first
    elif action == "build_native":
        if info["argc"] == 4 and first != "" and third != "":
            spec["build_flag"] = first
            spec["out_flag"] = third
    elif action == "build_native_with_options":
        if first != "" and third != "":
            spec["build_flag"] = first
            spec["out_flag"] = third
    elif action != "":
        if first != "":
            spec["unsupported_flags"] = method_append(spec["unsupported_flags"], first)
    return spec

def cli_route_records_to_spec(records):
    spec = {"usage_default": False, "help_flag": "", "version_flag": "", "build_flag": "", "out_flag": "", "unsupported_flags": []}
    idx = 0
    while idx < len(records):
        spec = cli_spec_record_route(spec, records[idx]["info"], records[idx]["action"])
        idx = idx + 1
    if spec["help_flag"] == "":
        spec["help_flag"] = "--help"
    if spec["version_flag"] == "":
        spec["version_flag"] = "--version"
    if spec["build_flag"] == "":
        spec["build_flag"] = "--build"
    if spec["out_flag"] == "":
        spec["out_flag"] = "--out"
    return spec

def generated_asm_cache_record(fingerprint, assembly):
    return "TYRION_GENERATED_ASM_CACHE_V1\n" + str(len(fingerprint)) + ":" + fingerprint + assembly


def generated_asm_cache_load(cache_path, fingerprint):
    if not compiler_optional_file_exists(cache_path):
        return ""
    try:
        record = read_text_file(cache_path)
        header = "TYRION_GENERATED_ASM_CACHE_V1\n"
        if len(record) < len(header) or record[0:len(header)] != header:
            return ""
        cursor = len(header)
        while cursor < len(record) and record[cursor] != ":":
            cursor = cursor + 1
        if cursor >= len(record):
            return ""
        fingerprint_length = int(record[len(header):cursor])
        start = cursor + 1
        if fingerprint_length != len(fingerprint) or start + fingerprint_length > len(record):
            return ""
        if record[start:start + fingerprint_length] != fingerprint:
            return ""
        assembly = record[start + fingerprint_length:]
        if assembly == "":
            return ""
        return assembly
    except:
        return ""

def generated_asm_cache_store(cache_path, fingerprint, assembly):
    temporary_path = cache_path + ".tmp"
    write_text_file(temporary_path, generated_asm_cache_record(fingerprint, assembly))
    if not __tyrion_run_tool("mv", [temporary_path, cache_path])["ok"]:
        fail("compiler cache rejected code=publish-failed;path=" + cache_path)

def generated_asm_cache_note(cache_dir, event, enabled=False):
    if cache_dir == "" or not enabled:
        return
    stats_path = cache_dir + "/.generated-asm-cache-events"
    previous = ""
    if compiler_optional_file_exists(stats_path):
        try:
            previous = read_text_file(stats_path)
        except:
            previous = ""
    write_text_file(stats_path, previous + event + "\n")


def x86_native_object_bundle_token(cache_fingerprint):
    # `cache_fingerprint` contains the full compiler layout and can be large.
    # Cache records retain and compare that complete text. Two independent
    # bounded samples keep filenames well distributed without interpreting
    # every byte merely to form a path.
    return str(len(cache_fingerprint)) + "-" + str(compiler_cache_path_hash(cache_fingerprint)) + "-" + str(compiler_cache_bounded_text_hash(cache_fingerprint))


def x86_native_noop_response_text(output_path):
    shard_list_path = output_path + ".shards/objects.list"
    shard_text = read_text_file(shard_list_path).strip()
    if shard_text == "":
        return ""
    response = "\"" + output_path + ".o\"\n"
    for shard_path in split_inventory_text(shard_text, "\n"):
        if shard_path == "":
            return ""
        response = response + "\"" + shard_path + "\"\n"
    # This initial no-op lane is deliberately limited to extension-free x86
    # application links. The complete bundle format will add runtime/extension
    # input identities before it accepts those more complex link plans.
    return response + "-lm\n"


def x86_native_noop_object_valid(target, object_path, allowed_kinds):
    # Object bytes and the paired sidecar are independently validated.  The
    # sidecar carries the target contract, deterministic shard identity, and
    # exported symbols; use those symbols for the native ELF check as well.
    try:
        record = object_shard_read(object_path + ".tyobj")
    except:
        return False
    if not object_shard_matches_target(record, target, allowed_kinds):
        return False
    if not runtime_native_object_valid_for_target(target, object_path, record["symbols"]):
        return False
    # Refuse a legacy cached object which would make the final ELF linker infer
    # an executable stack. This turns the GNU-stack hardening migration into a
    # normal cache miss rather than preserving an unsafe no-op link forever.
    sections = run_tool_capture("readelf", ["-S", object_path])
    if sections["ok"] and not contains_text(sections["stdout"], ".note.GNU-stack"):
        return False
    return True


def x86_native_try_noop_object_link(target, output_path, extension_mode, dynamic_extension_mode, cache_fingerprint, cache_dir="", cache_stats=False, emit_mode="executable"):
    if emit_mode != "executable" or dynamic_extension_mode != "off":
        return False
    # `auto` is just as safe as `off` when the saved bundle records no static
    # extension inputs. Keep `required` out of this lane: its contract is
    # about extension selection, not merely the eventual link response.
    if extension_mode != "off" and extension_mode != "auto":
        return False
    if not target_can_link_on_host(target, host_target()):
        return False
    artifact_path = output_path + ".tyn"
    response_path = output_path + ".link.rsp"
    expected_token = x86_native_object_bundle_token(cache_fingerprint)
    if not compiler_optional_file_exists(artifact_path) or not compiler_optional_file_exists(response_path) or not compiler_optional_file_exists(output_path + ".shards/objects.list"):
        return False
    try:
        artifact = read_text_file(artifact_path)
        response = read_text_file(response_path)
        expected_response = x86_native_noop_response_text(output_path)
    except:
        return False
    if expected_response == "" or response != expected_response:
        return False
    if not contains_text(artifact, "object-bundle-contract=tyrion-x86-object-bundle-v2\n"):
        return False
    if not contains_text(artifact, "object-bundle-token=" + expected_token + "\n"):
        return False
    if not contains_text(artifact, "target=" + target_id(target) + "\n"):
        return False
    if not contains_text(artifact, "target-context=" + target_context_fingerprint(target) + "\n"):
        return False
    if not contains_text(artifact, "native-link-mode=sharded-object-link\n"):
        return False
    if not contains_text(artifact, "native-static-extension-count=0\n"):
        return False
    if not x86_native_noop_object_valid(target, output_path + ".o", ["root-runtime"]):
        return False
    shard_text = read_text_file(output_path + ".shards/objects.list").strip()
    for shard_path in split_inventory_text(shard_text, "\n"):
        if not x86_native_noop_object_valid(target, shard_path, ["program-entry", "program-metadata", "function", "module"]):
            return False
    # The response text was reconstructed above, so this remains the canonical
    # manifest link rather than an unvalidated saved command line. A failure is
    # a cache miss: the normal parse/lower/object path rebuilds the inputs.
    if not run_tool("cc", "@" + response_path, "-o", output_path):
        return False
    generated_asm_cache_note(cache_dir, "shard-noop-link", cache_stats)
    return True

def build_runtime_native_x86_program(program, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir="", cache_fingerprint="", cache_context="", cache_stats=False, target=None, emit_mode="executable"):
    if target == None:
        target = target_spec("linux", "x86_64")
    target = target_require_assembly_emission(target)
    if target["backend"] != "linux-x86_64":
        fail("x86 native builder received non-x86 target: " + target_id(target))
    artifact_path = output_path + ".tyn"
    asm_path = make_asm_path(output_path)
    extensions = static_extension_build_plan_configured(program, extension_mode, extension_root, dynamic_extension_mode)
    shard_dir = ""
    shard_cache_dir = cache_dir
    root_symbols = []
    metadata_asm_path = ""
    metadata_object_path = ""
    metadata_symbols = []
    metadata_fingerprint = ""
    metadata_object_cached = False
    module_objects = []
    function_shard_input_count = 0
    root_object_fingerprint = ""
    if emit_mode == "objects" or emit_mode == "executable":
        shard_dir = output_path + ".shards"
        if not __tyrion_run_tool("mkdir", ["-p", shard_dir])["ok"]:
            fail("compiler shard rejected code=create-failed;path=" + shard_dir)
        write_text_file(shard_dir + "/objects.list", "")
        write_text_file(shard_dir + "/function-shards.list", "")
        write_text_file(shard_dir + "/nonmodule-objects.list", "")
        if shard_cache_dir == "":
            shard_cache_dir = shard_dir + "/cache"
            if not __tyrion_run_tool("mkdir", ["-p", shard_cache_dir])["ok"]:
                fail("compiler shard rejected code=create-failed;path=" + shard_cache_dir)
        # Keep executable/process metadata out of the runtime object.  This
        # makes the program entry, process state, and selected runtime helpers
        # independently cacheable object inputs while retaining the same
        # system-linker contract.
        metadata_asm_path = shard_dir + "/program-metadata.s"
        metadata_source = x86_native_export_shard_root_symbols(x86_native_program_metadata_asm_text()) + "\n.section .note.GNU-stack,\"\",@progbits\n"
        metadata_symbols = x86_native_shard_root_symbols(metadata_source)
        metadata_fingerprint = "tyrion-x86-program-metadata-v3\ntarget=" + target_context_fingerprint(target) + "\nsource=" + metadata_source
        metadata_object_path = shard_dir + "/program-metadata.o"
        metadata_object_cached = restore_runtime_native_object_cache(target, metadata_object_path, shard_cache_dir, metadata_fingerprint, cache_stats, metadata_symbols)
        if not metadata_object_cached:
            write_text_file(metadata_asm_path, metadata_source)
    cached_assembly = ""
    if shard_dir == "" and cache_dir != "":
        cached_assembly = generated_asm_cache_load(cache_dir + "/" + str(compiler_cache_path_hash(cache_fingerprint)) + ".asmcache", cache_fingerprint)
    if cached_assembly != "":
        generated_asm_cache_note(cache_dir, "hit", cache_stats)
        write_text_file(asm_path, cached_assembly)
    else:
        generated_asm_cache_note(cache_dir, "miss", cache_stats)
        asm_writer = asm_writer_open(asm_path)
        asm_writer = emit_linux_x86_64_direct_program_with_extension_config_asm_into(asm_writer, program, extensions, dynamic_extension_mode, extension_root, shard_cache_dir, cache_context, cache_stats, shard_dir, shard_dir == "")
        asm_writer_close(asm_writer)
        if shard_dir != "":
            root_source = read_text_file(asm_path)
            root_symbols = x86_native_shard_root_symbols(root_source)
            write_text_file(asm_path, x86_native_export_shard_root_symbols(root_source) + "\n.section .note.GNU-stack,\"\",@progbits\n")
        if shard_dir == "" and cache_dir != "":
            generated_asm_cache_store(cache_dir + "/" + str(compiler_cache_path_hash(cache_fingerprint)) + ".asmcache", cache_fingerprint, read_text_file(asm_path))
    artifact = "tyrion-runtime-native v1\nnative-build-target-kind=application\nnative-ir-contract=tyrion-native-ir-v2\nnative-lowering-plan=tyrion-native-direct-plan-v1\nnative-exec-mode=native-ir-v2-direct\n"
    # Emit an explicit zero as well. It lets a future no-op link prove that
    # `--ext-static=auto` selected no user-provided link inputs without
    # reparsing the program merely to rediscover that fact.
    artifact = artifact + "native-static-extension-count=" + str(len(extensions)) + "\n"
    if dynamic_extension_mode == "allowed":
        artifact = artifact + "native-dynamic-extension-mode=allowed\n"
    artifact = artifact + "target=" + target_id(target) + "\n"
    artifact = artifact + "target-context=" + target_context_fingerprint(target) + "\n"
    if emit_mode == "assembly":
        artifact = artifact + "native-link-mode=assembly-only\n"
        write_text_file(artifact_path, artifact)
        return True
    program_objects = []
    if emit_mode == "objects" or emit_mode == "executable":
        # The root object contains only startup/runtime assembly in the shard
        # lane. Key it from that exact generated source and target contract,
        # not the raw program graph: a private function body can reuse the
        # root, while a new runtime capability changes this source and forces
        # the required rebuild.
        root_object_fingerprint = "tyrion-x86-root-runtime-v3\ntarget=" + target_context_fingerprint(target) + "\next-static=" + extension_mode + "\next-dynamic=" + dynamic_extension_mode + "\nsource=" + read_text_file(asm_path)
        object_path = assemble_runtime_native_object_cached(target, asm_path, output_path + ".o", shard_cache_dir, root_object_fingerprint, cache_stats, False, root_symbols)
        # The root object supplies selected runtime helpers. The application
        # `main` is a separate function shard, while ELF `_start` belongs to
        # the host CRT; publish only the root object's actual ABI surface.
        object_shard_write(object_shard_create(target, "root-runtime", "root", str(compiler_cache_path_hash(root_object_fingerprint)), root_symbols), object_path + ".tyobj")
        program_objects = method_append(program_objects, object_path)
        artifact = artifact + "program-object=" + object_path + "\n"
        artifact = artifact + "object-toolchain=" + runtime_native_object_toolchain_id(target) + "\n"
        # Cross-host `--emit=objects` is intentionally limited to target
        # assembly until a configured target relocatable linker is available.
        # On a native Linux x86 host, compact function inputs into the default
        # module-object boundary before publishing the final link inventory.
        function_shard_text = read_text_file(shard_dir + "/function-shards.list").strip()
        if function_shard_text != "":
            function_shard_input_count = len(split_inventory_text(function_shard_text, "\n"))
        if target_can_link_on_host(target, host_target()):
            module_objects = x86_native_compact_function_shards(target, shard_dir, shard_cache_dir, cache_stats)
        # Process/startup metadata is determined by the target ABI and its
        # own generated source. Do not couple this object to the concatenated
        # application graph: ordinary function-body edits must leave it
        # independently reusable.
        if not metadata_object_cached:
            metadata_object_path = assemble_runtime_native_object_cached(target, metadata_asm_path, metadata_object_path, shard_cache_dir, metadata_fingerprint, cache_stats, True, metadata_symbols)
        object_shard_write(object_shard_create(target, "program-metadata", "program-metadata", str(compiler_cache_path_hash(metadata_fingerprint)), metadata_symbols), metadata_object_path + ".tyobj")
        append_text_file(shard_dir + "/objects.list", metadata_object_path + "\n")
        artifact = artifact + "program-metadata-object=" + metadata_object_path + "\n"
        shard_objects = read_text_file(shard_dir + "/objects.list")
        artifact = artifact + "object-shard-list=" + shard_dir + "/objects.list\n"
        artifact = artifact + "object-shard-count=" + str(len(split_inventory_text(shard_objects.strip(), "\n"))) + "\n"
        artifact = artifact + "object-function-input-count=" + str(function_shard_input_count) + "\n"
        artifact = artifact + "object-module-count=" + str(len(module_objects)) + "\n"
        artifact = artifact + "object-shard-contract=tyrion-object-shard-v2\n"
        if shard_objects.strip() != "":
            for shard_object in split_inventory_text(shard_objects.strip(), "\n"):
                program_objects = method_append(program_objects, shard_object)
        artifact = artifact + "object-bundle-contract=tyrion-x86-object-bundle-v2\n"
        artifact = artifact + "object-bundle-token=" + x86_native_object_bundle_token(cache_fingerprint) + "\n"
    if emit_mode == "objects":
        artifact = artifact + "native-link-mode=object-only\n"
        write_text_file(artifact_path, artifact)
        return True
    if emit_mode != "executable":
        fail("invalid native emit mode: " + emit_mode)
    application = require_application_analysis(program, runtime_native_function_names(program))
    link_plan = {"extensions": extensions, "extension_count": len(extensions), "dynamic_extension_mode": dynamic_extension_mode, "dynamic_extension_root": extension_root, "operations": application["runtime_operations"], "semantic_operations": application["operations"]}
    artifact = artifact + "native-link-mode=sharded-object-link\n"
    write_text_file(artifact_path, artifact)
    if not link_runtime_native_objects(target, program_objects, output_path, link_plan):
        fail("native-link rejected code=link-failed;output=" + output_path)
    return True

# Five-argument entry point used by the native compiler runtime dispatch.  The
# runtime route owns source text (rather than a pre-parsed AST), so parse it
# through the same frontend before entering the Native IR v2 x86 builder.
def build_runtime_native_x86_program_from_source(raw_source, output_path, extension_mode, extension_root, dynamic_extension_mode):
    program = parse_program(lex(raw_source))
    return build_runtime_native_x86_program(program, output_path, extension_mode, extension_root, dynamic_extension_mode)

def build_runtime_native_program_if_needed(raw_source, program, input_path, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir="", cache_fingerprint="", cache_context="", cache_stats=False, target=None, emit_mode="executable"):
    if target == None:
        target = host_target()
    target = target_require_assembly_emission(target)
    # The architecture-neutral analysis contract owns source rejection.
    # Backend emitters only receive accepted programs and therefore cannot
    # expose private lowering diagnostics.
    require_application_analysis(program, runtime_native_function_names(program))
    if target["backend"] == "linux-x86_64":
        # Applications and compiler descendants share the same verified native
        # IR path. Never route x86 applications through the historical
        # AArch64-shaped runtime translator.
        return build_runtime_native_x86_program(program, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir, cache_fingerprint, cache_context, cache_stats, target, emit_mode)
    else:
        # The module-unit frontend has already produced the canonical parsed
        # program. Reuse it on AArch64 instead of reparsing the concatenated
        # graph and discarding the AST-cache boundary.
        return build_runtime_native_direct_program_if_supported_with_program(program, input_path, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir, cache_fingerprint, cache_stats, target, emit_mode)

def build_native_with_extension_config(input_path, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir="", cache_stats=False, target=None, emit_mode="executable"):
    if target == None:
        target = host_target()
    target = target_require_assembly_emission(target)
    if dynamic_extension_mode == "allowed":
        if extension_root == "" or extension_root[0] != "/":
            fail("--ext-dynamic=allowed requires an absolute --ext-dir")
    if cache_dir != "":
        if not __tyrion_run_tool("mkdir", ["-p", cache_dir])["ok"]:
            fail("compiler cache rejected code=create-failed;path=" + cache_dir)
    target_fingerprint = target_context_fingerprint(target)
    cache_context = "compiler=1.0.0,target=" + target_fingerprint + ",abi=1,ext-static=" + extension_mode + ",ext-dynamic=" + dynamic_extension_mode + ",ext-root=" + extension_root
    graph_record = read_module_graph_units_cached(input_path, cache_dir, cache_context, cache_stats)
    raw_source = graph_record["graph"]
    cache_fingerprint = "compiler=1.0.0,target=" + target_fingerprint + ",abi=1,ext-static=" + extension_mode + ",ext-dynamic=" + dynamic_extension_mode + ",ext-root=" + extension_root + "\n" + raw_source
    if target["backend"] == "linux-x86_64":
        if x86_native_try_noop_object_link(target, output_path, extension_mode, dynamic_extension_mode, cache_fingerprint, cache_dir, cache_stats, emit_mode):
            return
    program = parse_module_unit_records(graph_record["units"], cache_dir, cache_context)
    if target["backend"] == "linux-x86_64":
        # The direct x86 path now owns the parsed program and its compact
        # module fingerprints. It does not consume the concatenated graph
        # source after the cache identity above has been made, so retaining
        # both outer graph/source owners through a cold self-host emission
        # needlessly pins another large source graph in memory.
        graph_record = none
        raw_source = ""
    if build_runtime_native_program_if_needed(raw_source, program, input_path, output_path, extension_mode, extension_root, dynamic_extension_mode, cache_dir, cache_fingerprint, cache_context, cache_stats, target, emit_mode):
        return
    fail("direct native lowering does not support this program")

def build_native_configured(input_path, output_path, extension_mode, extension_root):
    return build_native_with_extension_config(input_path, output_path, extension_mode, extension_root, "off", "")

def build_native(input_path, output_path):
    return build_native_configured(input_path, output_path, "auto", "./extensions")

def build_native_with_options(args):
    extension_mode = "auto"
    extension_root = "./extensions"
    dynamic_extension_mode = "off"
    cache_dir = ""
    cache_stats = False
    target = host_target()
    emit_mode = "executable"
    idx = 4
    while idx < len(args):
        arg = args[idx]
        if arg == "--ext-static=off":
            extension_mode = "off"
            idx = idx + 1
        elif arg == "--ext-static=auto":
            extension_mode = "auto"
            idx = idx + 1
        elif arg == "--ext-static=required":
            extension_mode = "required"
            idx = idx + 1
        elif arg == "--ext-dynamic=off":
            dynamic_extension_mode = "off"
            idx = idx + 1
        elif arg == "--ext-dynamic=allowed":
            dynamic_extension_mode = "allowed"
            idx = idx + 1
        elif arg == "--ext-dir":
            if idx + 1 >= len(args):
                fail("missing path after --ext-dir")
            extension_root = args[idx + 1]
            idx = idx + 2
        elif arg == "--cache-dir":
            if idx + 1 >= len(args):
                fail("missing path after --cache-dir")
            cache_dir = args[idx + 1]
            idx = idx + 2
        elif arg == "--cache-stats":
            cache_stats = True
            idx = idx + 1
        elif arg == "--target":
            if idx + 1 >= len(args):
                fail("missing target after --target")
            target = target_from_id(args[idx + 1])
            idx = idx + 2
        elif arg == "--emit=assembly":
            emit_mode = "assembly"
            idx = idx + 1
        elif arg == "--emit=objects":
            emit_mode = "objects"
            idx = idx + 1
        elif arg == "--emit=executable":
            emit_mode = "executable"
            idx = idx + 1
        else:
            fail("unknown or invalid compiler arguments")
    return build_native_with_extension_config(args[1], args[3], extension_mode, extension_root, dynamic_extension_mode, cache_dir, cache_stats, target, emit_mode)

def cli_main(args):
    if len(args) == 0:
        usage()
        return
    if len(args) == 1 and args[0] == "--help":
        usage()
        return
    if len(args) == 1 and args[0] == "--version":
        version()
        return
    if len(args) == 2 and args[0] == "--scan":
        command_scan(args[1])
        return
    if len(args) == 2 and args[0] == "--token-summary":
        command_token_summary(args[1])
        return
    if len(args) == 2 and args[0] == "--tokens":
        command_tokens(args[1])
        return
    if len(args) == 2 and args[0] == "--parse-summary":
        command_parse_summary(args[1])
        return
    if len(args) == 4 and args[0] == "--build" and args[2] == "--out":
        build_native(args[1], args[3])
        return
    if len(args) >= 5 and args[0] == "--build" and args[2] == "--out":
        build_native_with_options(args)
        return
    fail("unknown or invalid compiler arguments")
