        pos = parser_skip_newlines(tokens, pos)
        elifs = parser_list_create()
        else_body = []
        while pos < token_count(tokens) and token_kind_at(tokens, pos) == "KW_ELIF":
            elif_cond = parse_expression(tokens, pos + 1)
            elif_pos = parser_expect(tokens, elif_cond["pos"], "COLON")
            pos = elif_pos
            elif_block_body = parser_list_create()
            if token_kind_at(tokens, pos) == "LBRACE":
                pos = pos + 1
                pos = parser_skip_newlines(tokens, pos)
                elif_block_scanning_block = True
                while elif_block_scanning_block:
                    elif_block_block_kind = token_kind_at(tokens, pos)
                    if elif_block_block_kind == "RBRACE":
                        elif_block_scanning_block = False
                    elif elif_block_block_kind == "EOF":
