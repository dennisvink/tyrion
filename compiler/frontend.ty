                pos = pos + 1
            if pos < token_count(tokens) and token_kind_at(tokens, pos) == "KW_AS":
                if token_kind_next(tokens, pos) != "IDENTIFIER":
                    fail("expected except binding")
                except_binding = token_text_next(tokens, pos)
                pos = pos + 2
            pos = parser_expect(tokens, pos, "COLON")
            except_block_body = parser_list_create()
            if token_kind_at(tokens, pos) == "LBRACE":
                pos = pos + 1
                pos = parser_skip_newlines(tokens, pos)
                except_block_scanning_block = True
                while except_block_scanning_block:
                    except_block_block_kind = token_kind_at(tokens, pos)
                    if except_block_block_kind == "RBRACE":
                        except_block_scanning_block = False
                    elif except_block_block_kind == "EOF":
                        except_block_scanning_block = False
                    else:
                        except_block_stmt = parse_statement(tokens, pos)
                        except_block_body = parser_list_append(except_block_body, except_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, except_block_stmt["pos"])
                pos = parser_expect(tokens, pos, "RBRACE")
            else:
                pos = parser_expect(tokens, pos, "NEWLINE")
                pos = parser_expect(tokens, pos, "INDENT")
                pos = parser_skip_newlines(tokens, pos)
                except_block_scanning_indent_block = True
                while except_block_scanning_indent_block:
                    except_block_block_kind = token_kind_at(tokens, pos)
                    if except_block_block_kind == "DEDENT":
                        except_block_scanning_indent_block = False
                    elif except_block_block_kind == "EOF":
                        except_block_scanning_indent_block = False
                    else:
                        except_block_stmt = parse_statement(tokens, pos)
                        except_block_body = parser_list_append(except_block_body, except_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, except_block_stmt["pos"])
                except_block_end_kind = token_kind_at(tokens, pos)
                if except_block_end_kind == "DEDENT":
                    pos = parser_expect(tokens, pos, "DEDENT")
                elif except_block_end_kind != "EOF":
                    fail("expected DEDENT or EOF")
            except_body = parser_list_finish(except_block_body)
            pos = parser_skip_newlines(tokens, pos)
        if pos < token_count(tokens) and token_kind_at(tokens, pos) == "KW_FINALLY":
            pos = parser_expect(tokens, pos + 1, "COLON")
            finally_block_body = parser_list_create()
            if token_kind_at(tokens, pos) == "LBRACE":
                pos = pos + 1
                pos = parser_skip_newlines(tokens, pos)
                finally_block_scanning_block = True
                while finally_block_scanning_block:
                    finally_block_block_kind = token_kind_at(tokens, pos)
                    if finally_block_block_kind == "RBRACE":
                        finally_block_scanning_block = False
                    elif finally_block_block_kind == "EOF":
                        finally_block_scanning_block = False
                    else:
                        finally_block_stmt = parse_statement(tokens, pos)
                        finally_block_body = parser_list_append(finally_block_body, finally_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, finally_block_stmt["pos"])
                pos = parser_expect(tokens, pos, "RBRACE")
            else:
                pos = parser_expect(tokens, pos, "NEWLINE")
                pos = parser_expect(tokens, pos, "INDENT")
                pos = parser_skip_newlines(tokens, pos)
                finally_block_scanning_indent_block = True
                while finally_block_scanning_indent_block:
                    finally_block_block_kind = token_kind_at(tokens, pos)
                    if finally_block_block_kind == "DEDENT":
                        finally_block_scanning_indent_block = False
                    elif finally_block_block_kind == "EOF":
                        finally_block_scanning_indent_block = False
                    else:
                        finally_block_stmt = parse_statement(tokens, pos)
                        finally_block_body = parser_list_append(finally_block_body, finally_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, finally_block_stmt["pos"])
                finally_block_end_kind = token_kind_at(tokens, pos)
                if finally_block_end_kind == "DEDENT":
                    pos = parser_expect(tokens, pos, "DEDENT")
                elif finally_block_end_kind != "EOF":
                    fail("expected DEDENT or EOF")
            finally_body = parser_list_finish(finally_block_body)
            pos = parser_skip_newlines(tokens, pos)
        return {"node": ast_try(parser_list_finish(try_body_block_body), except_name, except_binding, except_body, finally_body), "pos": pos}
    if kind == "KW_RAISE":
        value = parse_expression(tokens, pos + 1)
        return {"node": ast_raise(value["node"]), "pos": value["pos"]}
    if kind == "KW_YIELD":
        value = parse_expression(tokens, pos + 1)
        return {"node": ast_yield(value["node"]), "pos": value["pos"]}
    if kind == "KW_RETURN":
        next_kind = token_kind_next(tokens, pos)
        if next_kind == "NEWLINE":
            return {"node": ast_return(ast_value("none", none)), "pos": pos + 1}
        value = parse_expression(tokens, pos + 1)
        return {"node": ast_return(value["node"]), "pos": value["pos"]}
    if kind == "KW_CONTINUE":
        return {"node": ast_node("continue"), "pos": pos + 1}
    if kind == "KW_BREAK":
        return {"node": ast_node("break"), "pos": pos + 1}
    if kind == "STAR":
        targets = parser_list_create()
        scan = pos
        saw_comma = False
        reading_targets = True
        while reading_targets:
            star = False
            scan_kind = token_kind_at(tokens, scan)
            if scan_kind == "STAR":
                star = True
                scan = scan + 1
            scan_kind = token_kind_at(tokens, scan)
            if scan_kind != "IDENTIFIER":
                fail("expected unpack assignment target")
            targets = parser_list_append(targets, ast_unpack_entry(token_text_at(tokens, scan), star))
            scan = scan + 1
            scan_kind = token_kind_at(tokens, scan)
            if scan_kind == "COMMA":
                saw_comma = True
                scan = scan + 1
                scan_kind = token_kind_at(tokens, scan)
                if scan_kind == "EQ":
                    reading_targets = False
                else:
                    reading_targets = True
            else:
                reading_targets = False
        scan_kind = token_kind_at(tokens, scan)
        if saw_comma:
            if scan_kind == "EQ":
                value = parse_expression(tokens, scan + 1)
                return {"node": ast_assign_target(ast_unpack_target(parser_list_finish(targets)), value["node"]), "pos": value["pos"]}
        fail("expected unpack assignment after starred target")
    if kind == "IDENTIFIER":
        next_kind = token_kind_next(tokens, pos)
        if next_kind == "COMMA":
            targets = parser_list_create()
            scan = pos
            saw_comma = False
            reading_targets = True
            while reading_targets:
                star = False
                scan_kind = token_kind_at(tokens, scan)
                if scan_kind == "STAR":
                    star = True
                    scan = scan + 1
                scan_kind = token_kind_at(tokens, scan)
                if scan_kind != "IDENTIFIER":
                    fail("expected unpack assignment target")
                targets = parser_list_append(targets, ast_unpack_entry(token_text_at(tokens, scan), star))
                scan = scan + 1
                scan_kind = token_kind_at(tokens, scan)
                if scan_kind == "COMMA":
                    saw_comma = True
                    scan = scan + 1
                    scan_kind = token_kind_at(tokens, scan)
                    if scan_kind == "EQ":
                        reading_targets = False
                    else:
                        reading_targets = True
                else:
                    reading_targets = False
            scan_kind = token_kind_at(tokens, scan)
            if saw_comma:
                if scan_kind == "EQ":
                    value = parse_expression(tokens, scan + 1)
                    return {"node": ast_assign_target(ast_unpack_target(parser_list_finish(targets)), value["node"]), "pos": value["pos"]}
        target_node = ast_value("var", token_text_at(tokens, pos))
        target_pos = pos + 1
        target_active = True
        while target_active:
            target_loop_kind = token_kind_at(tokens, target_pos)
            target_handled = False
            if target_loop_kind == "DOT":
                target_handled = True
                if token_kind_next(tokens, target_pos) != "IDENTIFIER":
                    fail("expected attribute name")
                target_node = ast_attr(target_node, token_text_next(tokens, target_pos))
                target_pos = target_pos + 2
            if not target_handled:
                if target_loop_kind == "LBRACKET":
                    target_handled = True
                    bracket_next = token_kind_next(tokens, target_pos)
                    if bracket_next == "COLON":
                        start = ast_value("none", none)
                        stop = parse_expression(tokens, target_pos + 2)
                        target_pos = parser_expect(tokens, stop["pos"], "RBRACKET")
                        target_node = ast_slice(target_node, start, stop["node"])
                    if bracket_next != "COLON":
                        first = parse_expression(tokens, target_pos + 1)
                        first_kind = token_kind_at(tokens, first["pos"])
                        if first_kind == "COLON":
                            stop_kind = token_kind_at(tokens, first["pos"] + 1)
                            if stop_kind == "RBRACKET":
                                stop_node = ast_value("none", none)
                                target_pos = parser_expect(tokens, first["pos"] + 1, "RBRACKET")
                            if stop_kind != "RBRACKET":
                                stop = parse_expression(tokens, first["pos"] + 1)
                                stop_node = stop["node"]
                                target_pos = parser_expect(tokens, stop["pos"], "RBRACKET")
                            target_node = ast_slice(target_node, first["node"], stop_node)
                        if first_kind != "COLON":
                            target_pos = parser_expect(tokens, first["pos"], "RBRACKET")
                            target_node = ast_index(target_node, first["node"])
            if not target_handled:
                target_active = False
        target = {"node": target_node, "pos": target_pos}
        target_kind = token_kind_at(tokens, target["pos"])
        if target_kind == "EQ":
            value = parse_expression(tokens, target["pos"] + 1)
            name = ""
            if target["node"]["kind"] == "var":
                name = target["node"]["value"]
            return {"node": ast_assign_target(target["node"], value["node"]), "pos": value["pos"]}
        if target_kind == "PLUSEQ":
            value = parse_expression(tokens, target["pos"] + 1)
            name = ""
            if target["node"]["kind"] == "var":
                name = target["node"]["value"]
            return {"node": ast_assign_target(target["node"], ast_binary("+", target["node"], value["node"])), "pos": value["pos"]}
    expr = parse_expression(tokens, pos)
    # Parse assignment syntax independently from assignment-target validity.
    # Semantic analysis owns that validity decision and its canonical
    # diagnostic; rejecting `1 = 2` here would leak a parser-specific error
    # from descendant compilers instead.
    if token_kind_at(tokens, expr["pos"]) == "EQ":
        value = parse_expression(tokens, expr["pos"] + 1)
        return {"node": ast_assign_target(expr["node"], value["node"]), "pos": value["pos"]}
    expr_node = ast_expr(expr["node"])
    expr_pos = expr["pos"]
    return {"node": expr_node, "pos": expr_pos}

def parse_program_items(tokens):
    items = parser_list_create()
    pos = 0
    scanning = True
    while scanning:
        pos = parser_skip_newlines(tokens, pos)
        kind = token_kind_at(tokens, pos)
        if kind == "EOF":
            scanning = False
        else:
            stmt = parse_statement(tokens, pos)
            stmt_node = stmt["node"]
            items = parser_list_append(items, stmt_node)
            pos = stmt["pos"]
    return parser_list_finish(items)


def parse_program(tokens):
    items = parse_program_items(tokens)
    return ast_collection("program", items)


def ast_inventory_node(node, inv):
    kind = node["kind"]
    inv["node_count"] = inv["node_count"] + 1
    if kind == "function":
        inv["function_count"] = inv["function_count"] + 1
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
    elif kind == "class":
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
    elif kind == "assign":
        inv["assign_count"] = inv["assign_count"] + 1
        inv = ast_inventory_node(node["value"], inv)
    elif kind == "return":
        inv["return_count"] = inv["return_count"] + 1
        inv = ast_inventory_node(node["value"], inv)
    elif kind == "if":
        inv["if_count"] = inv["if_count"] + 1
        inv = ast_inventory_node(node["condition"], inv)
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
        idx = 0
        while idx < len(node["elifs"]):
            inv["if_count"] = inv["if_count"] + 1
            inv = ast_inventory_node(node["elifs"][idx]["condition"], inv)
            body_idx = 0
            while body_idx < len(node["elifs"][idx]["body"]):
                inv = ast_inventory_node(node["elifs"][idx]["body"][body_idx], inv)
                body_idx = body_idx + 1
            idx = idx + 1
        idx = 0
        while idx < len(node["else_body"]):
            inv = ast_inventory_node(node["else_body"][idx], inv)
            idx = idx + 1
    elif kind == "while":
        inv["while_count"] = inv["while_count"] + 1
        inv = ast_inventory_node(node["condition"], inv)
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
    elif kind == "for":
        inv["for_count"] = inv["for_count"] + 1
        inv = ast_inventory_node(node["iterable"], inv)
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
    elif kind == "with":
        inv = ast_inventory_node(node["resource"], inv)
        idx = 0
        while idx < len(node["body"]):
            inv = ast_inventory_node(node["body"][idx], inv)
            idx = idx + 1
    elif kind == "expr":
        inv["expr_count"] = inv["expr_count"] + 1
        inv = ast_inventory_node(node["value"], inv)
    elif kind == "call":
        inv["call_count"] = inv["call_count"] + 1
        if node["callee"]["kind"] == "var" and node["callee"]["value"] == "print":
            inv["print_call_count"] = inv["print_call_count"] + 1
        inv = ast_inventory_node(node["callee"], inv)
        idx = 0
        while idx < len(node["args"]):
            inv = ast_inventory_node(node["args"][idx], inv)
            idx = idx + 1
    elif kind == "method_call":
        inv["call_count"] = inv["call_count"] + 1
        inv = ast_inventory_node(node["receiver"], inv)
        idx = 0
        while idx < len(node["args"]):
            inv = ast_inventory_node(node["args"][idx], inv)
            idx = idx + 1
    elif kind == "attr":
        inv = ast_inventory_node(node["receiver"], inv)
    elif kind == "index":
        inv = ast_inventory_node(node["receiver"], inv)
        inv = ast_inventory_node(node["index"], inv)
    elif kind == "binary":
        inv["binary_count"] = inv["binary_count"] + 1
        inv = ast_inventory_node(node["left"], inv)
        inv = ast_inventory_node(node["right"], inv)
    elif kind == "unary":
        inv["unary_count"] = inv["unary_count"] + 1
        inv = ast_inventory_node(node["value"], inv)
    elif kind == "list" or kind == "tuple":
        idx = 0
        while idx < len(node["items"]):
            inv = ast_inventory_node(node["items"][idx], inv)
            idx = idx + 1
    elif kind == "dict":
        idx = 0
        while idx < len(node["entries"]):
            inv = ast_inventory_node(node["entries"][idx]["key"], inv)
            inv = ast_inventory_node(node["entries"][idx]["value"], inv)
            idx = idx + 1
    elif kind == "program":
        idx = 0
        while idx < len(node["items"]):
            inv = ast_inventory_node(node["items"][idx], inv)
            idx = idx + 1
    return inv


def ast_inventory(program):
    inv = {"node_count": 0, "function_count": 0, "assign_count": 0, "return_count": 0, "if_count": 0, "while_count": 0, "for_count": 0, "expr_count": 0, "call_count": 0, "print_call_count": 0, "binary_count": 0, "unary_count": 0}
    return ast_inventory_node(program, inv)
