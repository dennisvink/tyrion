                    else:
                        elif_block_stmt = parse_statement(tokens, pos)
                        elif_block_body = parser_list_append(elif_block_body, elif_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, elif_block_stmt["pos"])
                pos = parser_expect(tokens, pos, "RBRACE")
            else:
                pos = parser_expect(tokens, pos, "NEWLINE")
                pos = parser_expect(tokens, pos, "INDENT")
                pos = parser_skip_newlines(tokens, pos)
                elif_block_scanning_indent_block = True
                while elif_block_scanning_indent_block:
                    elif_block_block_kind = token_kind_at(tokens, pos)
                    if elif_block_block_kind == "DEDENT":
                        elif_block_scanning_indent_block = False
