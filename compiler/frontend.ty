            elif try_body_block_end_kind != "EOF":
                fail("expected DEDENT or EOF")
        pos = parser_skip_newlines(tokens, pos)
        except_name = ""
        except_binding = ""
        except_body = []
        finally_body = []
        if pos < token_count(tokens) and token_kind_at(tokens, pos) == "KW_EXCEPT":
            pos = pos + 1
