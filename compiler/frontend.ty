                    try_body_block_body = parser_list_append(try_body_block_body, try_body_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, try_body_block_stmt["pos"])
            try_body_block_end_kind = token_kind_at(tokens, pos)
            if try_body_block_end_kind == "DEDENT":
