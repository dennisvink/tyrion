                    pos = parser_expect(tokens, pos, "DEDENT")
                elif elif_block_end_kind != "EOF":
                    fail("expected DEDENT or EOF")
            elifs = parser_list_append(elifs, ast_branch(elif_cond["node"], parser_list_finish(elif_block_body)))
            pos = parser_skip_newlines(tokens, pos)
        if pos < token_count(tokens) and token_kind_at(tokens, pos) == "KW_ELSE":
            else_pos = parser_expect(tokens, pos + 1, "COLON")
            pos = else_pos
            else_block_body = parser_list_create()
            if token_kind_at(tokens, pos) == "LBRACE":
                pos = pos + 1
                pos = parser_skip_newlines(tokens, pos)
                else_block_scanning_block = True
                while else_block_scanning_block:
                    else_block_block_kind = token_kind_at(tokens, pos)
                    if else_block_block_kind == "RBRACE":
                        else_block_scanning_block = False
                    elif else_block_block_kind == "EOF":
                        else_block_scanning_block = False
                    else:
                        else_block_stmt = parse_statement(tokens, pos)
                        else_block_body = parser_list_append(else_block_body, else_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, else_block_stmt["pos"])
                pos = parser_expect(tokens, pos, "RBRACE")
            else:
                pos = parser_expect(tokens, pos, "NEWLINE")
                pos = parser_expect(tokens, pos, "INDENT")
                pos = parser_skip_newlines(tokens, pos)
                else_block_scanning_indent_block = True
                while else_block_scanning_indent_block:
                    else_block_block_kind = token_kind_at(tokens, pos)
                    if else_block_block_kind == "DEDENT":
                        else_block_scanning_indent_block = False
                    elif else_block_block_kind == "EOF":
                        else_block_scanning_indent_block = False
                    else:
                        else_block_stmt = parse_statement(tokens, pos)
                        else_block_body = parser_list_append(else_block_body, else_block_stmt["node"])
                        pos = parser_skip_newlines(tokens, else_block_stmt["pos"])
                else_block_end_kind = token_kind_at(tokens, pos)
                if else_block_end_kind == "DEDENT":
                    pos = parser_expect(tokens, pos, "DEDENT")
                elif else_block_end_kind != "EOF":
                    fail("expected DEDENT or EOF")
            else_body = parser_list_finish(else_block_body)
            pos = parser_skip_newlines(tokens, pos)
        return {"node": ast_if(cond["node"], parser_list_finish(if_block_body), parser_list_finish(elifs), else_body), "pos": pos}
    if kind == "KW_WHILE":
        pos = parser_expect(tokens, pos, "KW_WHILE")
        cond = parse_expression(tokens, pos)
        pos = parser_expect(tokens, cond["pos"], "COLON")
        while_block_body = parser_list_create()
        if token_kind_at(tokens, pos) == "LBRACE":
