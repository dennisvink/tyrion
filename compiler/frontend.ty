                while_block_block_kind = token_kind_at(tokens, pos)
                if while_block_block_kind == "DEDENT":
                    while_block_scanning_indent_block = False
                elif while_block_block_kind == "EOF":
                    while_block_scanning_indent_block = False
                else:
                    while_block_stmt = parse_statement(tokens, pos)
                    while_block_body = parser_list_append(while_block_body, while_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, while_block_stmt["pos"])
            while_block_end_kind = token_kind_at(tokens, pos)
            if while_block_end_kind == "DEDENT":
                pos = parser_expect(tokens, pos, "DEDENT")
            elif while_block_end_kind != "EOF":
                fail("expected DEDENT or EOF")
        return {"node": ast_while(cond["node"], parser_list_finish(while_block_body)), "pos": pos}
    if kind == "KW_FOR":
        pos = parser_expect(tokens, pos, "KW_FOR")
        targets = parser_list_create()
        while pos < token_count(tokens) and token_kind_at(tokens, pos) != "KW_IN":
            if token_kind_at(tokens, pos) != "IDENTIFIER":
                fail("expected for target got " + token_kind_at(tokens, pos) + " text=" + token_text_at(tokens, pos))
            targets = parser_list_append(targets, token_text_at(tokens, pos))
            pos = pos + 1
            if token_kind_at(tokens, pos) == "COMMA":
                pos = pos + 1
            elif token_kind_at(tokens, pos) != "KW_IN":
                fail("expected comma or in after for target")
        if __tyrion_native_ast_builder_len(targets, 0) == 0:
            fail("expected for target after " + token_kind_at(tokens, pos - 1) + " text=" + token_text_at(tokens, pos - 1) + " before " + token_kind_at(tokens, pos) + " text=" + token_text_at(tokens, pos))
        pos = parser_expect(tokens, pos, "KW_IN")
        iterable = parse_expression(tokens, pos)
        pos = parser_expect(tokens, iterable["pos"], "COLON")
        for_block_body = parser_list_create()
