# Canonical AST construction, token access, parsing, and frontend inventories.

def ast_record(kind):
    # The C seed recognizes this constructor as a type-distinct AST record.
    # Descendants lower the same semantic record into the generated AST arena.
    return {"kind": kind, "items": []}


def ast_node(kind):
    return ast_record(kind)


def ast_value(kind, value):
    node = ast_record(kind)
    node["value"] = value
    return node


def ast_binary(op, left, right):
    node = ast_record("binary")
    node["op"] = op
    node["left"] = left
    node["right"] = right
    return node


def ast_unary(op, value):
    node = ast_record("unary")
    node["op"] = op
    node["value"] = value
    return node


def string_token_value(text):
    if len(text) < 2:
        fail("invalid string token")
    quote = text[0]
    if (quote != "\"" and quote != "'") or text[len(text) - 1] != quote:
        fail("invalid string token")
    out = ""
    idx = 1
    end = len(text) - 1
    while idx < end:
        ch = text[idx]
        if ch == "\\":
            idx = idx + 1
            if idx >= end:
                fail("invalid string escape")
            escaped = text[idx]
            if escaped == "n":
                out = out + "\n"
            elif escaped == "r":
                out = out + "\r"
            elif escaped == "t":
                out = out + "\t"
            elif escaped == "\\":
                out = out + "\\"
            elif escaped == "\"":
                out = out + "\""
            elif escaped == "'":
                out = out + "'"
            else:
                out = out + escaped
        else:
            out = out + ch
        idx = idx + 1
    return out


def ast_collection(kind, items):
    node = ast_record(kind)
    node["items"] = items
    return node


def ast_dict(entries):
    node = ast_record("dict")
    node["entries"] = entries
    return node


def ast_dict_entry(key, value):
    node = ast_record("dict_entry")
    node["key"] = key
    node["value"] = value
    return node


def ast_branch(condition, body):
    node = ast_record("branch")
    node["condition"] = condition
    node["body"] = body
    return node


def ast_unpack_entry(name, star):
    node = ast_record("unpack_target")
    node["name"] = name
    node["star"] = star
    return node


def ast_call(callee, args):
    node = ast_record("call")
    node["callee"] = callee
    node["args"] = args
    return node


def ast_method_call(receiver, name, args):
    node = ast_record("method_call")
    node["receiver"] = receiver
    node["name"] = name
    node["args"] = args
    return node


def ast_attr(receiver, name):
    node = ast_record("attr")
    node["receiver"] = receiver
    node["name"] = name
    return node


def ast_index(receiver, index):
    node = ast_record("index")
    node["receiver"] = receiver
    node["index"] = index
    return node


def ast_slice(receiver, start, stop):
    node = ast_record("slice")
    node["receiver"] = receiver
    node["start"] = start
    node["stop"] = stop
    return node


def ast_kwarg(name, value):
    node = ast_record("kwarg")
    node["name"] = name
    node["value"] = value
    return node


def ast_lambda(params, body):
    node = ast_record("lambda")
    node["params"] = params
    node["body"] = body
    return node


def ast_comprehension(out_kind, expr, key, value, target, iterable, condition):
    node = ast_record("comprehension")
    node["out_kind"] = out_kind
    node["expr"] = expr
    node["key"] = key
    node["value"] = value
    node["target"] = target
    node["iterable"] = iterable
    node["condition"] = condition
    return node


def token_field_at(tokens, pos, field):
    return __tyrion_native_token_builder_field(tokens, pos, field)


def token_count(tokens):
    return __tyrion_native_token_builder_count(tokens)


def token_kind_at(tokens, pos):
    return token_field_at(tokens, pos, "kind")


def token_text_at(tokens, pos):
    return token_field_at(tokens, pos, "text")


def token_value_at(tokens, pos):
    return token_text_at(tokens, pos)


def token_line_at(tokens, pos):
    return str(token_field_at(tokens, pos, "line"))


def token_column_at(tokens, pos):
    return str(token_field_at(tokens, pos, "column"))


def token_roundtrip_probe(kind, text, line, column):
    tokens = __tyrion_native_ast_builder_create()
    __tyrion_native_token_builder_append(tokens, kind, text, line, column)
    return token_kind_at(tokens, 0) + ":" + token_text_at(tokens, 0) + ":" + token_line_at(tokens, 0) + ":" + token_column_at(tokens, 0)


def token_clone_probe(kind, text, line, column):
    original = __tyrion_native_ast_builder_create()
    __tyrion_native_token_builder_append(original, kind, text, line, column)
    cloned = original
    return token_kind_at(cloned, 0) + ":" + token_text_at(cloned, 0) + ":" + token_line_at(cloned, 0) + ":" + token_column_at(cloned, 0)


def malformed_token_record_probe():
    return parse_program([{"kind": "EOF", "text": "", "line": 1, "column": 1}])


def ast_record_clone_probe(source):
    program = parse_program(lex(source))
    cloned = program
    return cloned["kind"] + ":" + cloned["items"][0]["kind"]


def malformed_ast_record_probe():
    return program_has_function({"kind": "program", "items": []}, "missing")


def malformed_nested_ast_record_probe():
    program = ast_record("program")
    program["items"] = [{"kind": "function", "name": "fake", "items": []}]
    return program_has_function(program, "fake")


def parser_list_create():
    return __tyrion_native_ast_builder_create()


def parser_list_append(builder, value):
    __tyrion_native_ast_builder_append(builder, 0, value)
    return builder


def parser_list_single(value):
    builder = parser_list_create()
    return parser_list_append(builder, value)


def parser_list_finish(builder):
    return __tyrion_native_ast_builder_finish(builder)[0]


def malformed_ast_kind_probe():
    return ast_record("not_a_real_ast_kind")


def malformed_ast_field_probe():
    node = ast_record("var")
    node["not_a_var_field"] = 1
    return node


def function_signature_record_probe(source, name):
    program = parse_program(lex(source))
    fn = program_find_function(program, name)
    out = ""
    idx = 0
    while idx < len(fn["params"]):
        if idx > 0:
            out = out + ","
        param = fn["params"][idx]
        out = out + param_name(param) + ":" + str(param_has_default(param))
        idx = idx + 1
    return out


def compiler_cli_parse_path_probe(path):
    program = parse_program(lex(read_text_file(path)))
    return len(program["items"])


def compiler_cli_plan_path_probe(path):
    program = parse_program(lex(read_text_file(path)))
    spec = collect_cli_spec(program)
    return len(spec["lowered_functions"])


def compiler_cli_build_plan_path_probe(path):
    program = parse_program(lex(read_text_file(path)))
    plan = collect_build_native_plan(program)
    return plan["shape_ok"]


def compiler_cli_lowered_table_path_probe(path):
    program = parse_program(lex(read_text_file(path)))
    plan = collect_build_native_plan(program)
    functions = collect_lowered_function_table_plan(program, plan)
    return len(functions)


def token_kind_next(tokens, pos):
    next_pos = pos + 1
    return token_kind_at(tokens, next_pos)


def token_text_next(tokens, pos):
    next_pos = pos + 1
    return token_text_at(tokens, next_pos)


def ast_assign(name, value):
    return ast_assign_target(ast_value("var", name), value)


def ast_assign_target(target, value):
    name = ""
    if target["kind"] == "var":
        name = target["value"]
    node = ast_record("assign")
    node["target"] = target
    node["name"] = name
    node["value"] = value
    return node


def ast_unpack_target(targets):
    node = ast_record("unpack")
    node["targets"] = targets
    return node


def ast_return(value):
    return ast_value("return", value)


def ast_if(condition, body, elifs, else_body):
    node = ast_record("if")
    node["condition"] = condition
    node["body"] = body
    node["elifs"] = elifs
    node["else_body"] = else_body
    return node


def ast_while(condition, body):
    node = ast_record("while")
    node["condition"] = condition
    node["body"] = body
    return node


def ast_for(targets, iterable, body):
    node = ast_record("for")
    node["targets"] = targets
    node["iterable"] = iterable
    node["body"] = body
    return node


def ast_with(resource, name, body):
    node = ast_record("with")
    node["resource"] = resource
    node["name"] = name
    node["body"] = body
    return node


def ast_try(body, except_name, except_binding, except_body, finally_body):
    node = ast_record("try")
    node["body"] = body
    node["except_name"] = except_name
    node["except_binding"] = except_binding
    node["except_body"] = except_body
    node["finally_body"] = finally_body
    return node


def ast_raise(value):
    return ast_value("raise", value)


def ast_yield(value):
    return ast_value("yield", value)


def ast_expr(value):
    return ast_value("expr", value)


def ast_class(name, body):
    node = ast_record("class")
    node["name"] = name
    node["body"] = body
    return node


def ast_meta(kind, name):
    node = ast_record(kind)
    node["name"] = name
    return node


def ast_function(name, params, body):
    node = ast_record("function")
    node["name"] = name
    node["params"] = params
    node["body"] = body
    return node


def ast_parameter(name, has_default, default_value):
    node = ast_record("parameter")
    node["name"] = name
    node["has_default"] = has_default
    node["default"] = default_value
    return node


def parser_skip_newlines(tokens, pos):
    scanning = True
    while scanning:
        kind = token_kind_at(tokens, pos)
        if kind == "EOF":
            scanning = False
        else:
            if kind == "NEWLINE":
                pos = pos + 1
            else:
                scanning = False
    return pos


def parser_reject_token(tokens, pos):
    actual = token_kind_at(tokens, pos)
    fail("parser rejected code=syntax-error;line=" + token_line_at(tokens, pos) + ";column=" + token_column_at(tokens, pos) + ";detail=" + actual)


def parser_expect(tokens, pos, kind):
    if token_kind_at(tokens, pos) != kind:
        parser_reject_token(tokens, pos)
    return pos + 1


def numeric_text(text):
    out = ""
    idx = 0
    while idx < len(text):
        if text[idx] != "_":
            out = out + text[idx]
        idx = idx + 1
    return out



def is_compare_token(kind):
    return kind == "EQEQ" or kind == "NE" or kind == "LT" or kind == "LE" or kind == "GT" or kind == "GE" or kind == "KW_IN"


def pratt_infix_binding_power(kind):
    if kind == "KW_OR":
        return 10
    if kind == "KW_AND":
        return 20
    if is_compare_token(kind):
        return 30
    if kind == "PLUS" or kind == "MINUS":
        return 40
    if kind == "STAR" or kind == "SLASH" or kind == "PERCENT":
        return 50
    return 0



def parse_pratt_expr(tokens, pos, min_bp):
    if token_kind_at(tokens, pos) == "EOF":
        fail("expected expression")
    prefix_kind = token_kind_at(tokens, pos)
    if prefix_kind == "MINUS":
        inner = parse_pratt_expr(tokens, pos + 1, 60)
        zero = ast_value("int", 0)
        parsed = {"node": ast_binary("-", zero, inner["node"]), "pos": inner["pos"]}
    elif prefix_kind == "KW_NOT":
        inner = parse_pratt_expr(tokens, pos + 1, 60)
        parsed = {"node": ast_unary("not", inner["node"]), "pos": inner["pos"]}
    else:
        atom_kind = token_kind_at(tokens, pos)
        atom_text = token_text_at(tokens, pos)
        if atom_kind == "INT":
            atom = {"node": ast_value("int", int(numeric_text(atom_text))), "pos": pos + 1}
        elif atom_kind == "FLOAT":
            atom = {"node": ast_value("float", float(numeric_text(atom_text))), "pos": pos + 1}
        elif atom_kind == "STRING":
            atom = {"node": ast_value("string", string_token_value(atom_text)), "pos": pos + 1}
        elif atom_kind == "KW_TRUE":
            atom = {"node": ast_value("bool", True), "pos": pos + 1}
        elif atom_kind == "KW_FALSE":
            atom = {"node": ast_value("bool", False), "pos": pos + 1}
        elif atom_kind == "KW_NONE":
            atom = {"node": ast_value("none", none), "pos": pos + 1}
        elif atom_kind == "IDENTIFIER":
            atom = {"node": ast_value("var", atom_text), "pos": pos + 1}
        elif atom_kind == "KW_LAMBDA":
            lambda_pos = pos + 1
            params = parser_list_create()
            if lambda_pos < token_count(tokens) and token_kind_at(tokens, lambda_pos) != "COLON":
                reading_params = True
                while reading_params:
                    if token_kind_at(tokens, lambda_pos) != "IDENTIFIER":
                        fail("expected lambda parameter name")
                    params = parser_list_append(params, token_text_at(tokens, lambda_pos))
                    lambda_pos = lambda_pos + 1
                    if lambda_pos < token_count(tokens) and token_kind_at(tokens, lambda_pos) == "COMMA":
                        lambda_pos = lambda_pos + 1
                    else:
                        reading_params = False
            lambda_pos = parser_expect(tokens, lambda_pos, "COLON")
            body = parse_expression(tokens, lambda_pos)
            atom = {"node": ast_lambda(parser_list_finish(params), body["node"]), "pos": body["pos"]}
        elif atom_kind == "LBRACKET":
            list_pos = pos + 1
            items = parser_list_create()
            if list_pos < token_count(tokens) and token_kind_at(tokens, list_pos) != "RBRACKET":
                first = parse_expression(tokens, list_pos)
                if first["pos"] < token_count(tokens) and token_kind_at(tokens, first["pos"]) == "KW_FOR":
                    if token_kind_at(tokens, first["pos"] + 1) != "IDENTIFIER":
                        fail("expected comprehension target")
                    target = token_text_at(tokens, first["pos"] + 1)
                    comp_pos = parser_expect(tokens, first["pos"] + 2, "KW_IN")
                    iterable = parse_expression(tokens, comp_pos)
                    comp_pos = iterable["pos"]
                    condition = ast_value("bool", True)
                    if comp_pos < token_count(tokens) and token_kind_at(tokens, comp_pos) == "KW_IF":
                        parsed_condition = parse_expression(tokens, comp_pos + 1)
                        condition = parsed_condition["node"]
                        comp_pos = parsed_condition["pos"]
                    list_pos = parser_expect(tokens, comp_pos, "RBRACKET")
                    atom = {"node": ast_comprehension("list", first["node"], ast_value("none", none), ast_value("none", none), target, iterable["node"], condition), "pos": list_pos}
                else:
                    items = parser_list_append(items, first["node"])
                    list_pos = first["pos"]
                    while list_pos < token_count(tokens) and token_kind_at(tokens, list_pos) == "COMMA":
                        list_pos = list_pos + 1
                        if list_pos < token_count(tokens) and token_kind_at(tokens, list_pos) == "RBRACKET":
                            break
                        item = parse_expression(tokens, list_pos)
                        items = parser_list_append(items, item["node"])
                        list_pos = item["pos"]
                    list_pos = parser_expect(tokens, list_pos, "RBRACKET")
                    atom = {"node": ast_collection("list", parser_list_finish(items)), "pos": list_pos}
            else:
                list_pos = parser_expect(tokens, list_pos, "RBRACKET")
                atom = {"node": ast_collection("list", parser_list_finish(items)), "pos": list_pos}
        elif atom_kind == "LBRACE":
            brace_pos = pos + 1
            entries = parser_list_create()
            atom_set_done = False
            if brace_pos < token_count(tokens) and token_kind_at(tokens, brace_pos) != "RBRACE":
                first = parse_expression(tokens, brace_pos)
                if first["pos"] < token_count(tokens) and token_kind_at(tokens, first["pos"]) == "COLON":
                    value = parse_expression(tokens, first["pos"] + 1)
                    if value["pos"] < token_count(tokens) and token_kind_at(tokens, value["pos"]) == "KW_FOR":
                        if token_kind_at(tokens, value["pos"] + 1) != "IDENTIFIER":
                            fail("expected dict comprehension target")
                        target = token_text_at(tokens, value["pos"] + 1)
                        comp_pos = parser_expect(tokens, value["pos"] + 2, "KW_IN")
                        iterable = parse_expression(tokens, comp_pos)
                        comp_pos = iterable["pos"]
                        condition = ast_value("bool", True)
                        if comp_pos < token_count(tokens) and token_kind_at(tokens, comp_pos) == "KW_IF":
                            parsed_condition = parse_expression(tokens, comp_pos + 1)
                            condition = parsed_condition["node"]
                            comp_pos = parsed_condition["pos"]
                        brace_pos = parser_expect(tokens, comp_pos, "RBRACE")
                        atom = {"node": ast_comprehension("dict", ast_value("none", none), first["node"], value["node"], target, iterable["node"], condition), "pos": brace_pos}
                        atom_set_done = True
                    if not atom_set_done:
                        entries = parser_list_append(entries, ast_dict_entry(first["node"], value["node"]))
                        brace_pos = value["pos"]
                        while brace_pos < token_count(tokens) and token_kind_at(tokens, brace_pos) == "COMMA":
                            brace_pos = brace_pos + 1
                            if brace_pos < token_count(tokens) and token_kind_at(tokens, brace_pos) == "RBRACE":
                                break
                            key = parse_expression(tokens, brace_pos)
                            brace_pos = parser_expect(tokens, key["pos"], "COLON")
                            value = parse_expression(tokens, brace_pos)
                            entries = parser_list_append(entries, ast_dict_entry(key["node"], value["node"]))
                            brace_pos = value["pos"]
                        brace_pos = parser_expect(tokens, brace_pos, "RBRACE")
                        atom = {"node": ast_dict(parser_list_finish(entries)), "pos": brace_pos}
                else:
                    items = parser_list_single(first["node"])
                    brace_pos = first["pos"]
                    while brace_pos < token_count(tokens) and token_kind_at(tokens, brace_pos) == "COMMA":
                        brace_pos = brace_pos + 1
                        if brace_pos < token_count(tokens) and token_kind_at(tokens, brace_pos) == "RBRACE":
                            break
                        item = parse_expression(tokens, brace_pos)
                        items = parser_list_append(items, item["node"])
                        brace_pos = item["pos"]
                    brace_pos = parser_expect(tokens, brace_pos, "RBRACE")
                    atom = {"node": ast_collection("set", parser_list_finish(items)), "pos": brace_pos}
            else:
                brace_pos = parser_expect(tokens, brace_pos, "RBRACE")
                atom = {"node": ast_dict(parser_list_finish(entries)), "pos": brace_pos}
        elif atom_kind == "LPAREN":
            paren_pos = pos + 1
            if paren_pos < token_count(tokens) and token_kind_at(tokens, paren_pos) == "RPAREN":
                atom = {"node": ast_collection("tuple", []), "pos": paren_pos + 1}
            else:
                first = parse_expression(tokens, paren_pos)
                paren_pos = first["pos"]
                if paren_pos < token_count(tokens) and token_kind_at(tokens, paren_pos) == "COMMA":
                    items = parser_list_single(first["node"])
                    while paren_pos < token_count(tokens) and token_kind_at(tokens, paren_pos) == "COMMA":
                        paren_pos = paren_pos + 1
                        if paren_pos < token_count(tokens) and token_kind_at(tokens, paren_pos) == "RPAREN":
                            break
                        item = parse_expression(tokens, paren_pos)
                        items = parser_list_append(items, item["node"])
                        paren_pos = item["pos"]
                    paren_pos = parser_expect(tokens, paren_pos, "RPAREN")
                    atom = {"node": ast_collection("tuple", parser_list_finish(items)), "pos": paren_pos}
                else:
                    next_pos = parser_expect(tokens, paren_pos, "RPAREN")
                    atom = {"node": first["node"], "pos": next_pos}
        else:
            parser_reject_token(tokens, pos)
        postfix_node = atom["node"]
        postfix_pos = atom["pos"]
        postfix_active = True
        while postfix_active:
            postfix_kind = token_kind_at(tokens, postfix_pos)
            if postfix_kind == "EOF":
                postfix_kind = ""
            postfix_handled = False
            if postfix_kind == "LPAREN":
                postfix_handled = True
                postfix_pos = postfix_pos + 1
                args = parser_list_create()
                arg_kind = token_kind_at(tokens, postfix_pos)
                if arg_kind != "RPAREN":
                    reading = True
                    while reading:
                        is_kwarg = False
                        current_kind = token_kind_at(tokens, postfix_pos)
                        next_kind = token_kind_next(tokens, postfix_pos)
                        if current_kind == "IDENTIFIER":
                            if next_kind == "EQ":
                                is_kwarg = True
                        if is_kwarg:
                            arg = parse_expression(tokens, postfix_pos + 2)
                            args = parser_list_append(args, ast_kwarg(token_text_at(tokens, postfix_pos), arg["node"]))
                            postfix_pos = arg["pos"]
                        if not is_kwarg:
                            arg = parse_expression(tokens, postfix_pos)
                            args = parser_list_append(args, arg["node"])
                            postfix_pos = arg["pos"]
                        comma_kind = token_kind_at(tokens, postfix_pos)
                        if comma_kind == "COMMA":
                            postfix_pos = postfix_pos + 1
                            if token_kind_at(tokens, postfix_pos) == "RPAREN":
                                reading = False
                        if comma_kind != "COMMA":
                            reading = False
                postfix_pos = parser_expect(tokens, postfix_pos, "RPAREN")
                postfix_node = ast_call(postfix_node, parser_list_finish(args))
            if not postfix_handled:
                if postfix_kind == "DOT":
                    postfix_handled = True
                    if token_kind_next(tokens, postfix_pos) != "IDENTIFIER":
                        fail("expected attribute name")
                    name = token_text_next(tokens, postfix_pos)
                    postfix_pos = postfix_pos + 2
                    method_kind = token_kind_at(tokens, postfix_pos)
                    if method_kind == "LPAREN":
                        postfix_pos = postfix_pos + 1
                        args = parser_list_create()
                        arg_kind = token_kind_at(tokens, postfix_pos)
                        if arg_kind != "RPAREN":
                            reading = True
                            while reading:
                                is_kwarg = False
                                current_kind = token_kind_at(tokens, postfix_pos)
                                next_kind = token_kind_next(tokens, postfix_pos)
                                if current_kind == "IDENTIFIER":
                                    if next_kind == "EQ":
                                        is_kwarg = True
                                if is_kwarg:
                                    arg = parse_expression(tokens, postfix_pos + 2)
                                    args = parser_list_append(args, ast_kwarg(token_text_at(tokens, postfix_pos), arg["node"]))
                                    postfix_pos = arg["pos"]
                                if not is_kwarg:
                                    arg = parse_expression(tokens, postfix_pos)
                                    args = parser_list_append(args, arg["node"])
                                    postfix_pos = arg["pos"]
                                comma_kind = token_kind_at(tokens, postfix_pos)
                                if comma_kind == "COMMA":
                                    postfix_pos = postfix_pos + 1
                                    if token_kind_at(tokens, postfix_pos) == "RPAREN":
                                        reading = False
                                if comma_kind != "COMMA":
                                    reading = False
                        postfix_pos = parser_expect(tokens, postfix_pos, "RPAREN")
                        postfix_node = ast_method_call(postfix_node, name, parser_list_finish(args))
                    if method_kind != "LPAREN":
                        postfix_node = ast_attr(postfix_node, name)
            if not postfix_handled:
                if postfix_kind == "LBRACKET":
                    postfix_handled = True
                    bracket_next = token_kind_next(tokens, postfix_pos)
                    if bracket_next == "COLON":
                        start = ast_value("none", none)
                        stop = parse_expression(tokens, postfix_pos + 2)
                        postfix_pos = parser_expect(tokens, stop["pos"], "RBRACKET")
                        postfix_node = ast_slice(postfix_node, start, stop["node"])
                    if bracket_next != "COLON":
                        first = parse_expression(tokens, postfix_pos + 1)
                        first_kind = token_kind_at(tokens, first["pos"])
                        if first_kind == "COLON":
                            stop_kind = token_kind_at(tokens, first["pos"] + 1)
                            if stop_kind == "RBRACKET":
                                stop_node = ast_value("none", none)
                                postfix_pos = parser_expect(tokens, first["pos"] + 1, "RBRACKET")
                            if stop_kind != "RBRACKET":
                                stop = parse_expression(tokens, first["pos"] + 1)
                                stop_node = stop["node"]
                                postfix_pos = parser_expect(tokens, stop["pos"], "RBRACKET")
                            postfix_node = ast_slice(postfix_node, first["node"], stop_node)
                        if first_kind != "COLON":
                            postfix_pos = parser_expect(tokens, first["pos"], "RBRACKET")
                            postfix_node = ast_index(postfix_node, first["node"])
            if not postfix_handled:
                postfix_active = False
        parsed = {"node": postfix_node, "pos": postfix_pos}
    node = parsed["node"]
    pos = parsed["pos"]
    active = True
    while active:
        kind = token_kind_at(tokens, pos)
        if kind == "EOF":
            active = False
        if active:
            bp = pratt_infix_binding_power(kind)
            take_infix = True
            if bp == 0:
                take_infix = False
            if take_infix:
                if bp < min_bp:
                    take_infix = False
            if take_infix:
                op = token_text_at(tokens, pos)
                if kind == "KW_AND":
                    op = "and"
                if kind == "KW_OR":
                    op = "or"
                right = parse_pratt_expr(tokens, pos + 1, bp + 1)
                node = ast_binary(op, node, right["node"])
                pos = right["pos"]
            if not take_infix:
                active = False
    return {"node": node, "pos": pos}


def parse_expression(tokens, pos):
    return parse_pratt_expr(tokens, pos, 1)




def parse_statement(tokens, pos):
    pos = parser_skip_newlines(tokens, pos)
    kind = token_kind_at(tokens, pos)
    text = token_text_at(tokens, pos)
    if kind == "IDENTIFIER" and text == "eturn":
        kind = "KW_RETURN"
    if kind == "KW_DEF":
        pos = parser_expect(tokens, pos, "KW_DEF")
        name = token_text_at(tokens, pos)
        pos = parser_expect(tokens, pos + 1, "LPAREN")
        params = parser_list_create()
        current_kind = token_kind_at(tokens, pos)
        if current_kind != "RPAREN":
            reading = True
            while reading:
                param_name = token_text_at(tokens, pos)
                pos = pos + 1
                has_default = False
                current_kind = token_kind_at(tokens, pos)
                if current_kind == "EQ":
                    parsed_default = parse_expression(tokens, pos + 1)
                    default_value = parsed_default["node"]
                    has_default = True
                    pos = parsed_default["pos"]
                if not has_default:
                    default_value = ast_value("none", none)
                params = parser_list_append(params, ast_parameter(param_name, has_default, default_value))
                current_kind = token_kind_at(tokens, pos)
                if current_kind == "COMMA":
                    pos = pos + 1
                    if token_kind_at(tokens, pos) == "RPAREN":
                        reading = False
                else:
                    reading = False
        pos = parser_expect(tokens, pos, "RPAREN")
        pos = parser_expect(tokens, pos, "COLON")
        fn_block_body = parser_list_create()
        if token_kind_at(tokens, pos) == "LBRACE":
            pos = pos + 1
            pos = parser_skip_newlines(tokens, pos)
            fn_block_scanning_block = True
            while fn_block_scanning_block:
                fn_block_block_kind = token_kind_at(tokens, pos)
                if fn_block_block_kind == "RBRACE":
                    fn_block_scanning_block = False
                elif fn_block_block_kind == "EOF":
                    fn_block_scanning_block = False
                else:
                    fn_block_stmt = parse_statement(tokens, pos)
                    fn_block_body = parser_list_append(fn_block_body, fn_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, fn_block_stmt["pos"])
            pos = parser_expect(tokens, pos, "RBRACE")
        else:
            pos = parser_expect(tokens, pos, "NEWLINE")
            pos = parser_expect(tokens, pos, "INDENT")
            pos = parser_skip_newlines(tokens, pos)
            fn_block_scanning_indent_block = True
            while fn_block_scanning_indent_block:
                fn_block_block_kind = token_kind_at(tokens, pos)
                if fn_block_block_kind == "DEDENT":
                    fn_block_scanning_indent_block = False
                elif fn_block_block_kind == "EOF":
                    fn_block_scanning_indent_block = False
                else:
                    fn_block_stmt = parse_statement(tokens, pos)
                    fn_block_body = parser_list_append(fn_block_body, fn_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, fn_block_stmt["pos"])
            fn_block_end_kind = token_kind_at(tokens, pos)
            if fn_block_end_kind == "DEDENT":
                pos = parser_expect(tokens, pos, "DEDENT")
            elif fn_block_end_kind != "EOF":
                fail("expected DEDENT or EOF")
        return {"node": ast_function(name, parser_list_finish(params), parser_list_finish(fn_block_body)), "pos": pos}
    if kind == "KW_CLASS":
        pos = parser_expect(tokens, pos, "KW_CLASS")
        if token_kind_at(tokens, pos) != "IDENTIFIER":
            fail("expected class name")
        name = token_text_at(tokens, pos)
        pos = parser_expect(tokens, pos + 1, "COLON")
        class_block_body = parser_list_create()
        if token_kind_at(tokens, pos) == "LBRACE":
            pos = pos + 1
            pos = parser_skip_newlines(tokens, pos)
            class_block_scanning_block = True
            while class_block_scanning_block:
                class_block_block_kind = token_kind_at(tokens, pos)
                if class_block_block_kind == "RBRACE":
                    class_block_scanning_block = False
                elif class_block_block_kind == "EOF":
                    class_block_scanning_block = False
                else:
                    class_block_stmt = parse_statement(tokens, pos)
                    class_block_body = parser_list_append(class_block_body, class_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, class_block_stmt["pos"])
            pos = parser_expect(tokens, pos, "RBRACE")
        else:
            pos = parser_expect(tokens, pos, "NEWLINE")
            pos = parser_expect(tokens, pos, "INDENT")
            pos = parser_skip_newlines(tokens, pos)
            class_block_scanning_indent_block = True
            while class_block_scanning_indent_block:
                class_block_block_kind = token_kind_at(tokens, pos)
                if class_block_block_kind == "DEDENT":
                    class_block_scanning_indent_block = False
                elif class_block_block_kind == "EOF":
                    class_block_scanning_indent_block = False
                else:
                    class_block_stmt = parse_statement(tokens, pos)
                    class_block_body = parser_list_append(class_block_body, class_block_stmt["node"])
                    pos = parser_skip_newlines(tokens, class_block_stmt["pos"])
            class_block_end_kind = token_kind_at(tokens, pos)
            if class_block_end_kind == "DEDENT":
                pos = parser_expect(tokens, pos, "DEDENT")
            elif class_block_end_kind != "EOF":
                fail("expected DEDENT or EOF")
        return {"node": ast_class(name, parser_list_finish(class_block_body)), "pos": pos}
    if kind == "IDENTIFIER":
        # module/export are contextual declaration words. They remain valid
        # identifiers in expressions and assignments used by the compiler
        # backend itself.
        next_kind = token_kind_at(tokens, pos + 1)
        if text == "module" and next_kind == "IDENTIFIER":
            name = ""
            if token_count(tokens) > pos + 1:
                name = token_text_next(tokens, pos)
            scan = pos
            while scan < token_count(tokens) and token_kind_at(tokens, scan) != "NEWLINE" and token_kind_at(tokens, scan) != "EOF":
                scan = scan + 1
            return {"node": ast_meta("module", name), "pos": scan}
        if text == "export" and next_kind == "IDENTIFIER":
            name = ""
            if token_count(tokens) > pos + 1:
                name = token_text_next(tokens, pos)
            scan = pos
            while scan < token_count(tokens) and token_kind_at(tokens, scan) != "NEWLINE" and token_kind_at(tokens, scan) != "EOF":
                scan = scan + 1
            return {"node": ast_meta("export", name), "pos": scan}
        if text == "import" or text == "from":
            name = ""
            if token_count(tokens) > pos + 1:
                name = token_text_next(tokens, pos)
            scan = pos
            while scan < token_count(tokens) and token_kind_at(tokens, scan) != "NEWLINE" and token_kind_at(tokens, scan) != "EOF":
                scan = scan + 1
            return {"node": ast_meta("import", name), "pos": scan}
    if kind == "KW_IF":
        pos = parser_expect(tokens, pos, "KW_IF")
        cond = parse_expression(tokens, pos)
        pos = parser_expect(tokens, cond["pos"], "COLON")
