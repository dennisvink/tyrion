            elif for_block_end_kind != "EOF":
                fail("expected DEDENT or EOF")
        return {"node": ast_for(parser_list_finish(targets), iterable["node"], parser_list_finish(for_block_body)), "pos": pos}
    if kind == "KW_WITH":
        pos = parser_expect(tokens, pos, "KW_WITH")
        resource = parse_expression(tokens, pos)
        pos = parser_expect(tokens, resource["pos"], "KW_AS")
