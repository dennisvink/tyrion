def lowered_function_is_native_side_effect_primitive(name):
    # Historical name: this predicate protects every compiler-owned native
    # boundary from helper-source embedding, including pure queries such as
    # len/asm_writer_bytes. Purity remains a separate schema field.
    if primitive_schema_lowered_fixed(name):
        return True
    if name == "read_text_file":
        return True
    if name == "write_text_file":
        return True
    if name == "run_tool":
        return True
    if name == "link_asm":
        return True
    if name == "host_target":
        return True
    return False

