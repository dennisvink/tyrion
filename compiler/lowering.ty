def lowered_source_function_arg_count(fn):
    count = len(fn["params"])
    if source_function_has_value_return(fn):
        count = count + 1
    if count > 6:
        fail("source function dispatcher entry exceeded checked six-argument limit: " + fn["name"])
    return count

