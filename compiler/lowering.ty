    if name == "is_digit":
        return 1
    if name == "is_lower":
        return 2
    if name == "is_upper":
        return 3
    if name == "is_space":
        return 4
    if name == "is_alpha":
        return 5
    if name == "is_ident_start":
        return 6
    if name == "is_ident_continue":
        return 7
    return -1

