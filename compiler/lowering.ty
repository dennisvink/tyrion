# compiler / lowering: responsibility-owned canonical compiler module.

def lowered_function_entry_payload_seed(program, build_plan, name):
    fn = program_find_function_or_none(program, name)
    if name == "render_compiler_cli_artifact":
        return {"name": name, "name_label": lowered_function_label("L_fn_", name), "handler_label": lowered_function_label("L_clcf_", name), "exec_label": lowered_function_label("L_exec_fn_", name), "dispatch_arg_count": lowered_function_dispatch_arg_count(name), "force_success": lowered_function_force_success(name), "plan_kind": lowered_function_plan_kind(name), "body_plan": {"chunks": minimal_compiler_cli_artifact_chunks()}, "signature_params": [], "source_params": [], "source_body": []}
    if fn == none:
        return lowered_function_entry(program, build_plan, name)
    return lowered_function_entry(program, build_plan, name)

def lowered_function_append_compiler_component_sources(program, names):
    component_names = ["collect_compiler_asm_section_plan", "emit_compiler_asm_section_plan", "emit_compiler_asm_section", "emit_darwin_aarch64_statement_mutation_component", "emit_darwin_aarch64_control_flow_component", "emit_darwin_aarch64_function_registry_component", "emit_darwin_aarch64_function_calls_component", "emit_darwin_aarch64_expression_eval_component", "emit_darwin_aarch64_expression_ast_component", "emit_darwin_aarch64_atom_core_component", "emit_darwin_aarch64_builtin_atoms_component", "emit_darwin_aarch64_indexing_component", "emit_darwin_aarch64_methods_objects_component", "emit_darwin_aarch64_slots_ownership_component", "emit_darwin_aarch64_assignment_mutation_component", "emit_darwin_aarch64_scalar_formatting_component"]
    idx = 0
    while idx < len(component_names):
        names = lowered_function_append_source_if_present(program, names, component_names[idx])
        idx = idx + 1
    return names

def collect_lowered_function_table_plan_payload_seed(program, build_plan):
    names = []
    names = lowered_function_append_name(names, "asm_writer_open")
    names = lowered_function_append_name(names, "asm_writer_append")
    names = lowered_function_append_name(names, "asm_writer_close")
    names = lowered_function_append_name(names, "asm_writer_bytes")
    names = lowered_function_append_name(names, "asm_writer_set_backend")
    names = lowered_function_append_name(names, "asm_writer_is_x86")
    names = lowered_function_append_name(names, "runtime_native_linux_aarch64_asm_text")
    names = lowered_function_append_source_if_present(program, names, "emit_darwin_aarch64_compiler_cli_asm_into")
    names = lowered_function_append_source_if_present(program, names, "emit_linux_aarch64_compiler_cli_asm_into")
    names = lowered_function_append_source_if_present(program, names, "emit_linux_x86_64_compiler_cli_asm_into")
    if program_has_function(program, "usage"):
        names = lowered_function_append_name(names, "usage")
    if program_has_function(program, "version"):
        names = lowered_function_append_name(names, "version")
    names = lowered_function_append_name(names, "len")
    # Generic record execution references the native append ABI even when a
    # reduced compiler fixture omits the documenting Tyrion helper.
    names = lowered_function_append_name(names, "method_append")
    names = lowered_function_append_name(names, "build_native")
    names = lowered_function_append_source_if_present(program, names, "build_compiler_cli_native")
    if build_plan["shape_ok"] and build_plan["diagnostic"] != "":
        names = lowered_function_append_known_direct_calls(program, names, "build_native")
    names = lowered_function_append_name(names, "read_text_file")
    names = lowered_function_append_name(names, "write_text_file")
    names = lowered_function_append_name(names, "host_target")
    names = lowered_function_append_source_if_present(program, names, "generated_value_owner_mem")
    names = lowered_function_append_source_if_present(program, names, "generated_value_tag_mem")
    names = lowered_function_append_name(names, "__tyrion_native_tcp_connect")
    names = lowered_function_append_name(names, "__tyrion_native_tcp_write")
    names = lowered_function_append_name(names, "__tyrion_native_tcp_read")
    names = lowered_function_append_name(names, "__tyrion_native_tcp_close")
    names = lowered_function_append_name(names, "std_io_tcp_connect")
    names = lowered_function_append_name(names, "std_io_tcp_write")
    names = lowered_function_append_name(names, "std_io_tcp_read")
    names = lowered_function_append_name(names, "std_io_tcp_close")
    if program_has_function(program, "token_kind_at"):
        names = lowered_function_append_name(names, "token_kind_at")
    if program_has_function(program, "token_text_at"):
        names = lowered_function_append_name(names, "token_text_at")
    if program_has_function(program, "token_value_at"):
        names = lowered_function_append_name(names, "token_value_at")
    if program_has_function(program, "asm_line"):
        names = lowered_function_append_name(names, "asm_line")
    if program_has_function(program, "asm_label"):
        names = lowered_function_append_name(names, "asm_label")
    if program_has_function(program, "asm_dir"):
        names = lowered_function_append_name(names, "asm_dir")
    if program_has_function(program, "asm_raw"):
        names = lowered_function_append_name(names, "asm_raw")
    if program_has_function(program, "asm_section"):
        names = lowered_function_append_name(names, "asm_section")
    if program_has_function(program, "asm_cstr"):
        names = lowered_function_append_name(names, "asm_cstr")
    if program_has_function(program, "asm_escape_string"):
        names = lowered_function_append_name(names, "asm_escape_string")
    names = lowered_function_append_source_if_present(program, names, "source_indent")
    names = lowered_function_append_compiler_component_sources(program, names)
    if not build_plan["shape_ok"]:
        names = lowered_function_append_source_if_present(program, names, "fail")
        names = lowered_function_append_source_if_present(program, names, "method_append")
        names = lowered_function_append_source_if_present(program, names, "token")
        names = lowered_function_append_source_if_present(program, names, "lex")
        names = lowered_function_append_source_if_present(program, names, "parse_program")
        names = lowered_function_append_source_if_present(program, names, "parse_program_items")
        names = lowered_function_append_source_if_present(program, names, "host_target")
        names = lowered_function_append_source_if_present(program, names, "lower_program_to_constant_payload")
        names = lowered_function_append_source_if_present(program, names, "lower_statement_list")
        names = lowered_function_append_source_if_present(program, names, "emit_constant_asm")
        names = lowered_function_append_source_if_present(program, names, "render_native_artifact")
    names = lowered_function_expand_reachable_sources(program, names)
    entries_builder = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < len(names):
        if lowered_function_can_emit(program, names[idx]):
            __tyrion_native_ast_builder_append(entries_builder, 0, lowered_function_entry_payload_seed(program, build_plan, names[idx]))
        idx = idx + 1
    entries_lanes = __tyrion_native_ast_builder_finish(entries_builder)
    return entries_lanes[0]

def program_has_function(program, name):
    items = program["items"]
    idx = 0
    while idx < len(items):
        stmt = items[idx]
        if stmt["kind"] == "function":
            if stmt["name"] == name:
                return True
        idx = idx + 1
    return False

def program_find_function(program, name):
    items = program["items"]
    idx = 0
    while idx < len(items):
        stmt = items[idx]
        if stmt["name"] == name:
            return stmt
        idx = idx + 1
    if len(items) == 0:
        fail("required function not found for native lowering: empty program items")
    fail("required function not found for native lowering: non-empty program items")

def program_find_function_or_none(program, name):
    items = program["items"]
    idx = 0
    while idx < len(items):
        stmt = items[idx]
        if stmt["kind"] == "function":
            if stmt["name"] == name:
                return stmt
        idx = idx + 1
    return none

def lower_print_arg_literal(expr):
    kind = expr["kind"]
    if kind == "string":
        return expr["value"]
    if kind == "int":
        return str(expr["value"])
    if kind == "float":
        return str(expr["value"])
    if kind == "bool":
        if expr["value"]:
            return "True"
        return "False"
    if kind == "none":
        return "none"
    fail("native function print lowering requires literal print args, got: " + kind)

def expr_is_args_len_call(expr):
    return expr["kind"] == "call" and expr["callee"]["kind"] == "var" and expr["callee"]["value"] == "len" and len(expr["args"]) == 1 and expr["args"][0]["kind"] == "var" and expr["args"][0]["value"] == "args"

def expr_is_args_index(expr):
    return expr["kind"] == "index" and expr["receiver"]["kind"] == "var" and expr["receiver"]["value"] == "args" and expr["index"]["kind"] == "int"

def expr_call_name(expr):
    if expr["kind"] == "call" and expr["callee"]["kind"] == "var":
        return expr["callee"]["value"]
    return ""

def expr_var_name(expr):
    if expr["kind"] == "var":
        return expr["value"]
    return ""

def stmt_assign_call_info(stmt):
    if stmt["kind"] != "assign":
        return {"target": "", "call": "", "arg0": "", "arg1": ""}
    expr = stmt["value"]
    if expr["kind"] != "call":
        return {"target": "", "call": "", "arg0": "", "arg1": ""}
    arg0 = ""
    arg1 = ""
    if len(expr["args"]) > 0:
        arg0 = expr_var_name(expr["args"][0])
    if len(expr["args"]) > 1:
        arg1 = expr_var_name(expr["args"][1])
    return {"target": stmt["name"], "call": expr_call_name(expr), "arg0": arg0, "arg1": arg1}

def stmt_expr_call_info(stmt):
    if stmt["kind"] != "expr":
        return {"call": "", "arg0": "", "arg1": ""}
    expr = stmt["value"]
    if expr["kind"] != "call":
        return {"call": "", "arg0": "", "arg1": ""}
    arg0 = ""
    arg1 = ""
    if len(expr["args"]) > 0:
        arg0 = expr_var_name(expr["args"][0])
    if len(expr["args"]) > 1:
        arg1 = expr_var_name(expr["args"][1])
    return {"call": expr_call_name(expr), "arg0": arg0, "arg1": arg1}

def expr_source_simple(expr):
    kind = expr["kind"]
    if kind == "var":
        return expr["value"]
    if kind == "string":
        return "\"" + asm_escape_string(expr["value"]) + "\""
    if kind == "int":
        return str(expr["value"])
    if kind == "float":
        return str(expr["value"])
    if kind == "bool":
        if expr["value"]:
            return "True"
        return "False"
    if kind == "none":
        return "none"
    if kind == "binary":
        left = expr_source_simple(expr["left"])
        right = expr_source_simple(expr["right"])
        if left == "" or right == "":
            return ""
        return left + " " + expr["op"] + " " + right
    if kind == "unary":
        value = expr_source_simple(expr["value"])
        if value == "":
            return ""
        return expr["op"] + " " + value
    if kind == "call":
        out = expr_source_simple(expr["callee"]) + "("
        idx = 0
        while idx < len(expr["args"]):
            if idx > 0:
                out = out + ", "
            out = out + expr_source_simple(expr["args"][idx])
            idx = idx + 1
        return out + ")"
    if kind == "method_call":
        receiver = expr_source_simple(expr["receiver"])
        if receiver == "":
            return ""
        out = receiver + "." + expr["name"] + "("
        idx = 0
        while idx < len(expr["args"]):
            if idx > 0:
                out = out + ", "
            out = out + expr_source_simple(expr["args"][idx])
            idx = idx + 1
        return out + ")"
    if kind == "attr":
        receiver = expr_source_simple(expr["receiver"])
        if receiver == "":
            return ""
        return receiver + "." + expr["name"]
    if kind == "index":
        receiver = expr_source_simple(expr["receiver"])
        index = expr_source_simple(expr["index"])
        if receiver == "" or index == "":
            return ""
        return receiver + "[" + index + "]"
    if kind == "slice":
        receiver = expr_source_simple(expr["receiver"])
        start = ""
        stop = ""
        if expr["start"]["kind"] != "none":
            start = expr_source_simple(expr["start"])
        if expr["stop"]["kind"] != "none":
            stop = expr_source_simple(expr["stop"])
        if receiver == "":
            return ""
        return receiver + "[" + start + ":" + stop + "]"
    if kind == "kwarg":
        value = expr_source_simple(expr["value"])
        if value == "":
            return ""
        return expr["name"] + "=" + value
    if kind == "list" or kind == "tuple" or kind == "set":
        open_text = "["
        close_text = "]"
        if kind == "tuple":
            open_text = "("
            close_text = ")"
        if kind == "set":
            open_text = "{"
            close_text = "}"
        out = open_text
        idx = 0
        while idx < len(expr["items"]):
            if idx > 0:
                out = out + ", "
            item = expr_source_simple(expr["items"][idx])
            if item == "":
                return ""
            out = out + item
            idx = idx + 1
        return out + close_text
    if kind == "dict":
        out = "{"
        idx = 0
        while idx < len(expr["entries"]):
            if idx > 0:
                out = out + ", "
            key = expr_source_simple(expr["entries"][idx]["key"])
            value = expr_source_simple(expr["entries"][idx]["value"])
            if key == "" or value == "":
                return ""
            out = out + key + ": " + value
            idx = idx + 1
        return out + "}"
    return ""

def target_source_simple(target):
    if target["kind"] == "var":
        return target["value"]
    if target["kind"] == "index":
        return expr_source_simple(target)
    if target["kind"] == "attr":
        return expr_source_simple(target)
    if target["kind"] == "unpack":
        out = ""
        idx = 0
        while idx < len(target["targets"]):
            if idx > 0:
                out = out + ", "
            if target["targets"][idx]["star"]:
                out = out + "*"
            out = out + target["targets"][idx]["name"]
            idx = idx + 1
        return out
    return ""

def source_indent(depth):
    out = ""
    idx = 0
    while idx < depth:
        out = out + "  "
        idx = idx + 1
    return out

def block_source_simple(body, depth):
    out = ""
    idx = 0
    while idx < len(body):
        line = stmt_source_simple_depth(body[idx], depth)
        if line == "":
            return ""
        out = out + line
        idx = idx + 1
    if out == "":
        return source_indent(depth) + "pass\n"
    return out

def param_source_simple(param):
    if "name" in param:
        if param["has_default"]:
            value = expr_source_simple(param["default"])
            if value == "":
                return ""
            return param["name"] + "=" + value
        return param["name"]
    return param

def params_source_simple(params):
    out = ""
    idx = 0
    while idx < len(params):
        if idx > 0:
            out = out + ", "
        param = param_source_simple(params[idx])
        if param == "":
            return ""
        out = out + param
        idx = idx + 1
    return out

def stmt_source_simple_depth(stmt, depth):
    indent = source_indent(depth)
    kind = stmt["kind"]
    if kind == "assign":
        target = target_source_simple(stmt["target"])
        value = expr_source_simple(stmt["value"])
        if target != "" and value != "":
            return indent + target + " = " + value + "\n"
    if kind == "return":
        value = expr_source_simple(stmt["value"])
        if value != "":
            if value == "none":
                return indent + "return\n"
            return indent + "return " + value + "\n"
    if kind == "expr":
        value = expr_source_simple(stmt["value"])
        if value != "":
            return indent + value + "\n"
    if kind == "raise":
        value = expr_source_simple(stmt["value"])
        if value != "":
            return indent + "raise " + value + "\n"
    if kind == "break":
        return indent + "break\n"
    if kind == "continue":
        return indent + "continue\n"
    if kind == "if":
        condition = expr_source_simple(stmt["condition"])
        if condition == "":
            return ""
        out = indent + "if " + condition + ":\n"
        out = out + block_source_simple(stmt["body"], depth + 1)
        idx = 0
        while idx < len(stmt["elifs"]):
            elif_cond = expr_source_simple(stmt["elifs"][idx]["condition"])
            if elif_cond == "":
                return ""
            out = out + indent + "elif " + elif_cond + ":\n"
            out = out + block_source_simple(stmt["elifs"][idx]["body"], depth + 1)
            idx = idx + 1
        if len(stmt["else_body"]) > 0:
            out = out + indent + "else:\n"
            out = out + block_source_simple(stmt["else_body"], depth + 1)
        return out
    if kind == "while":
        condition = expr_source_simple(stmt["condition"])
        if condition == "":
            return ""
        return indent + "while " + condition + ":\n" + block_source_simple(stmt["body"], depth + 1)
    if kind == "for":
        targets = ""
        idx = 0
        while idx < len(stmt["targets"]):
            if idx > 0:
                targets = targets + ", "
            targets = targets + stmt["targets"][idx]
            idx = idx + 1
        iterable = expr_source_simple(stmt["iterable"])
        if targets == "" or iterable == "":
            return ""
        return indent + "for " + targets + " in " + iterable + ":\n" + block_source_simple(stmt["body"], depth + 1)
    if kind == "with":
        resource = expr_source_simple(stmt["resource"])
        if resource == "":
            return ""
        return indent + "with " + resource + " as " + stmt["name"] + ":\n" + block_source_simple(stmt["body"], depth + 1)
    if kind == "function":
        params = params_source_simple(stmt["params"])
        return indent + "def " + stmt["name"] + "(" + params + "):\n" + block_source_simple(stmt["body"], depth + 1)
    if kind == "class":
        return indent + "class " + stmt["name"] + ":\n" + block_source_simple(stmt["body"], depth + 1)
    if kind == "try":
        out = indent + "try:\n" + block_source_simple(stmt["body"], depth + 1)
        if len(stmt["except_body"]) > 0:
            out = out + indent + "except"
            if stmt["except_name"] != "":
                out = out + " " + stmt["except_name"]
            if stmt["except_binding"] != "":
                out = out + " as " + stmt["except_binding"]
            out = out + ":\n" + block_source_simple(stmt["except_body"], depth + 1)
        if len(stmt["finally_body"]) > 0:
            out = out + indent + "finally:\n" + block_source_simple(stmt["finally_body"], depth + 1)
        return out
    return ""

def stmt_source_simple(stmt):
    return stmt_source_simple_depth(stmt, 0)

def function_body_source_simple(fn):
    out = ""
    idx = 0
    while idx < len(fn["body"]):
        line = stmt_source_simple(fn["body"][idx])
        if line == "":
            return ""
        out = out + line
        idx = idx + 1
    return out

def statement_list_has_return(stmts):
    idx = 0
    while idx < len(stmts):
        stmt = stmts[idx]
        kind = stmt["kind"]
        if kind == "return":
            return True
        if kind == "if":
            if statement_list_has_return(stmt["body"]):
                return True
            elif_idx = 0
            while elif_idx < len(stmt["elifs"]):
                if statement_list_has_return(stmt["elifs"][elif_idx]["body"]):
                    return True
                elif_idx = elif_idx + 1
            if statement_list_has_return(stmt["else_body"]):
                return True
        if kind == "while" or kind == "for" or kind == "with" or kind == "try":
            if statement_list_has_return(stmt["body"]):
                return True
            if kind == "try":
                if statement_list_has_return(stmt["except_body"]):
                    return True
                if statement_list_has_return(stmt["finally_body"]):
                    return True
        idx = idx + 1
    return False

def source_function_has_return(fn):
    return statement_list_has_return(fn["body"])

def statement_list_has_value_return(stmts):
    idx = 0
    while idx < len(stmts):
        stmt = stmts[idx]
        kind = stmt["kind"]
        if kind == "return":
            value = stmt["value"]
            if value["kind"] != "none":
                return True
        if kind == "if":
            if statement_list_has_value_return(stmt["body"]):
                return True
            elif_idx = 0
            while elif_idx < len(stmt["elifs"]):
                if statement_list_has_value_return(stmt["elifs"][elif_idx]["body"]):
                    return True
                elif_idx = elif_idx + 1
            if statement_list_has_value_return(stmt["else_body"]):
                return True
        if kind == "while" or kind == "for" or kind == "with" or kind == "try":
            if statement_list_has_value_return(stmt["body"]):
                return True
            if kind == "try":
                if statement_list_has_value_return(stmt["except_body"]):
                    return True
                if statement_list_has_value_return(stmt["finally_body"]):
                    return True
        idx = idx + 1
    return False

def source_function_has_value_return(fn):
    return statement_list_has_value_return(fn["body"])

def expr_is_var(expr, name):
    return expr["kind"] == "var" and expr["value"] == name

def expr_is_int(expr, value):
    return expr["kind"] == "int" and expr["value"] == value

def expr_is_bool(expr, value):
    return expr["kind"] == "bool" and expr["value"] == value

def expr_is_newline_string(expr):
    return expr["kind"] == "string" and (expr["value"] == "\n" or expr["value"] == "\\n")

def expr_is_call0(expr, name):
    return expr["kind"] == "call" and expr_call_name(expr) == name and len(expr["args"]) == 0

def expr_is_call1_var(expr, name, arg_name):
    return expr["kind"] == "call" and expr_call_name(expr) == name and len(expr["args"]) == 1 and expr_var_name(expr["args"][0]) == arg_name

def expr_is_call2_vars(expr, name, arg0_name, arg1_name):
    return expr["kind"] == "call" and expr_call_name(expr) == name and len(expr["args"]) == 2 and expr_var_name(expr["args"][0]) == arg0_name and expr_var_name(expr["args"][1]) == arg1_name

def expr_is_method_call0(expr, receiver_name, method_name):
    return expr["kind"] == "method_call" and expr_var_name(expr["receiver"]) == receiver_name and expr["name"] == method_name and len(expr["args"]) == 0

def expr_is_method_call1_string(expr, receiver_name, method_name, value):
    return expr["kind"] == "method_call" and expr_var_name(expr["receiver"]) == receiver_name and expr["name"] == method_name and len(expr["args"]) == 1 and expr["args"][0]["kind"] == "string" and expr["args"][0]["value"] == value

def expr_is_len_call_var(expr, arg_name):
    return expr_is_call1_var(expr, "len", arg_name)

def return_expr(fn):
    if len(fn["body"]) != 1:
        fail(fn["name"] + " native helper lowering requires a single return statement")
    stmt = fn["body"][0]
    if stmt["kind"] != "return":
        fail(fn["name"] + " native helper lowering requires a return statement")
    return stmt["value"]

def single_return_expr_or_unsupported(fn):
    if len(fn["body"]) != 1:
        return {"kind": "unsupported", "reason": fn["name"] + " helper body is not a single return statement"}
    stmt = fn["body"][0]
    if stmt["kind"] != "return":
        return {"kind": "unsupported", "reason": fn["name"] + " helper body is not a return statement"}
    return stmt["value"]

def collect_read_file_plan(program):
    fn = program_find_function_or_none(program, "read_file")
    if fn == none:
        return {"param": "", "lowered_call": "", "param_label": "L_read_file_param_name", "body_label": "L_read_file_body_src", "body_source": "", "shape_ok": False, "diagnostic": "read_file native lowering helper is not present"}
    if len(fn["params"]) != 1:
        return {"param": "", "lowered_call": "", "param_label": "L_read_file_param_name", "body_label": "L_read_file_body_src", "body_source": "", "shape_ok": False, "diagnostic": "read_file native lowering requires one path param"}
    path_param = param_name(fn["params"][0])
    body_source = function_body_source_simple(fn)
    lowered_call = "read_text_file"
    expr = single_return_expr_or_unsupported(fn)
    if expr["kind"] == "call" and expr_call_name(expr) == "read_text_file" and len(expr["args"]) == 1 and expr_var_name(expr["args"][0]) == path_param:
        body_source = "return read_text_file(" + path_param + ")\n"
        return {"param": path_param, "lowered_call": lowered_call, "param_label": "L_read_file_param_name", "body_label": "L_read_file_body_src", "body_source": body_source, "shape_ok": True, "diagnostic": "read_file lowered as fixed native read_text_file wrapper"}
    return {"param": path_param, "lowered_call": lowered_call, "param_label": "L_read_file_param_name", "body_label": "L_read_file_body_src", "body_source": body_source, "shape_ok": False, "diagnostic": "read_file native lowering expected: return read_text_file(path)"}

def collect_make_asm_path_plan(program):
    fn = program_find_function_or_none(program, "make_asm_path")
    if fn == none:
        return {"param": "", "suffix": "", "suffix_label": "L_make_asm_path_suffix", "param_label": "L_make_asm_path_param_name", "body_label": "L_make_asm_path_body_src", "body_source": "", "shape_ok": False, "diagnostic": "make_asm_path native lowering helper is not present"}
    if len(fn["params"]) != 1:
        return {"param": "", "suffix": "", "suffix_label": "L_make_asm_path_suffix", "param_label": "L_make_asm_path_param_name", "body_label": "L_make_asm_path_body_src", "body_source": "", "shape_ok": False, "diagnostic": "make_asm_path native lowering requires one output_path param"}
    output_param = param_name(fn["params"][0])
    body_source = function_body_source_simple(fn)
    suffix = ""
    expr = single_return_expr_or_unsupported(fn)
    if expr["kind"] == "binary" and expr["op"] == "+" and expr_var_name(expr["left"]) == output_param and expr["right"]["kind"] == "string":
        suffix = expr["right"]["value"]
        body_source = "return " + output_param + " + \"" + suffix + "\"\n"
        return {"param": output_param, "suffix": suffix, "suffix_label": "L_make_asm_path_suffix", "param_label": "L_make_asm_path_param_name", "body_label": "L_make_asm_path_body_src", "body_source": body_source, "shape_ok": True, "diagnostic": "make_asm_path lowered as fixed suffix append wrapper"}
    return {"param": output_param, "suffix": suffix, "suffix_label": "L_make_asm_path_suffix", "param_label": "L_make_asm_path_param_name", "body_label": "L_make_asm_path_body_src", "body_source": body_source, "shape_ok": False, "diagnostic": "make_asm_path native lowering expected: return output_path + suffix"}

def collect_link_asm_plan(program):
    fn = program_find_function_or_none(program, "link_asm")
    if fn == none:
        return {"asm_param": "", "output_param": "", "tool": "", "out_flag": "", "body_label": "L_link_asm_body_src", "body_source": "", "shape_ok": False, "diagnostic": "link_asm native lowering helper is not present"}
    if len(fn["params"]) != 2:
        return {"asm_param": "", "output_param": "", "tool": "", "out_flag": "", "body_label": "L_link_asm_body_src", "body_source": "", "shape_ok": False, "diagnostic": "link_asm native lowering requires asm_path and output_path params"}
    asm_param = param_name(fn["params"][0])
    output_param = param_name(fn["params"][1])
    # Linking is a compiler-owned side-effect primitive. The source body
    # documents and executes the seed semantics; descendants use the same
    # explicit assemble/object-link ABI rather than embedding helper source.
    return {"asm_param": asm_param, "output_param": output_param, "tool": "cc", "out_flag": "-o", "object_suffix": ".o", "body_label": "L_link_asm_body_src", "body_source": function_body_source_simple(fn), "shape_ok": True, "diagnostic": "link_asm lowered as fixed two-stage native tool primitive"}

def build_native_plan_record(program, input_param, output_param, body_source, shape_ok, diagnostic):
    return {"program": program, "input_param": input_param, "output_param": output_param, "input_param_label": "L_build_native_input_param_name", "output_param_label": "L_build_native_output_param_name", "body_label": "L_build_native_body_src", "body_source": body_source, "read_plan": collect_read_file_plan(program), "make_asm_path_plan": collect_make_asm_path_plan(program), "link_plan": collect_link_asm_plan(program), "parse_program_items_plan": collect_parse_program_items_plan(program), "lex_plan": collect_lowered_source_body_plan(program, "lex", "L_lex_body_src"), "parse_statement_plan": collect_lowered_source_body_plan(program, "parse_statement", "L_parse_statement_body_src"), "parse_pratt_expr_plan": collect_lowered_source_body_plan(program, "parse_pratt_expr", "L_parse_pratt_expr_body_src"), "compiler_cli_plan": collect_lowered_source_body_plan(program, "build_compiler_cli_native", "L_build_compiler_cli_native_body_src"), "collect_cli_spec_plan": collect_lowered_source_body_plan(program, "collect_cli_spec", "L_collect_cli_spec_body_src"), "render_compiler_cli_artifact_plan": collect_lowered_source_body_plan(program, "render_compiler_cli_artifact", "L_render_compiler_cli_artifact_body_src"), "program_find_function_plan": collect_lowered_source_body_plan(program, "program_find_function", "L_program_find_function_body_src"), "program_find_function_or_none_plan": collect_lowered_source_body_plan(program, "program_find_function_or_none", "L_program_find_function_or_none_body_src"), "shape_ok": shape_ok, "diagnostic": diagnostic}

def unsupported_build_native_plan(program, diagnostic, input_param, output_param):
    body_source = ""
    fn = program_find_function_or_none(program, "build_native")
    if fn != none:
        body_source = function_body_source_simple(fn)
    return build_native_plan_record(program, input_param, output_param, body_source, False, diagnostic)

def collect_return_call_one_arg_plan(program, name, callee):
    fn = program_find_function_or_none(program, name)
    if fn == none:
        return {"source_param": "", "callee": callee, "shape_ok": False, "diagnostic": name + " helper is not present"}
    if len(fn["params"]) != 1:
        return {"source_param": "", "callee": callee, "shape_ok": False, "diagnostic": name + " requires one source param"}
    source_param = param_name(fn["params"][0])
    expr = single_return_expr_or_unsupported(fn)
    if expr["kind"] == "call" and expr_call_name(expr) == callee and len(expr["args"]) == 1 and expr_var_name(expr["args"][0]) == source_param:
        return {"source_param": source_param, "callee": callee, "shape_ok": True, "diagnostic": ""}
    return {"source_param": source_param, "callee": callee, "shape_ok": False, "diagnostic": name + " expected: return " + callee + "(source)"}

def collect_build_native_plan(program):
    fn = program_find_function(program, "build_native")
    if len(fn["params"]) < 2:
        return unsupported_build_native_plan(program, "build_native native lowering requires input_path and output_path params", "", "")
    input_param = param_name(fn["params"][0])
    output_param = param_name(fn["params"][1])
    body_source = function_body_source_simple(fn)
    return build_native_plan_record(program, input_param, output_param, body_source, True, "")

def collect_parse_program_items_plan(program):
    fn = program_find_function_or_none(program, "parse_program_items")
    if fn == none:
        return {"body_label": "L_parse_program_items_body_src", "body_source": "", "param_labels": [lowered_function_label("L_fn_param_parse_program_items_", "0")], "has_return": True}
    return {"body_label": "L_parse_program_items_body_src", "body_source": function_body_source_simple(fn), "param_labels": lowered_source_function_param_labels(fn), "has_return": source_function_has_value_return(fn)}

def collect_lowered_source_body_plan(program, name, body_label):
    fn = program_find_function_or_none(program, name)
    if fn == none:
        return {"body_label": body_label, "body_source": "", "param_labels": [], "has_return": True}
    return {"body_label": body_label, "body_source": function_body_source_simple(fn), "param_labels": lowered_source_function_param_labels(fn), "has_return": source_function_has_value_return(fn)}

def lowered_function_label(prefix, name):
    return prefix + name

def lowered_function_char_equals_code(name):
    if name == "char_is_tab":
        return 9
    if name == "char_is_newline":
        return 10
    if name == "char_is_hash":
        return 35
    if name == "char_is_underscore":
        return 95
    if name == "char_is_dot":
        return 46
    if name == "char_is_double_quote":
        return 34
    if name == "char_is_single_quote":
        return 39
    if name == "char_is_backslash":
        return 92
    return -1

