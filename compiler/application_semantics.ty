def application_runtime_operation_id(name):
    primitive_id = primitive_schema_id(name)
    if primitive_id != -1:
        return int(primitive_id)
    if name == "file.read":
        return 901
    if name == "file.write":
        return 902
    if name == "file.flush":
        return 903
    if name == "file.seek":
        return 904
    return 0


def application_runtime_operation_ids(names):
    ids = []
    for name in names:
        operation_id = application_runtime_operation_id(name)
        if operation_id != 0:
            ids = application_append_unique_id(ids, operation_id)
    return ids


def application_analysis_ok(operation_id):
    operations = []
    if operation_id != 0:
        operations = method_append(operations, operation_id)
    return {"ok": True, "code": "", "path": "", "detail": "", "operations": operations, "value_kinds": [], "assignment_targets": [], "iterator_kinds": [], "call_kinds": [], "methods": [], "control_exits": [], "components": [], "component_ids": [], "runtime_operations": [], "temporary_slots": 1}


def application_analysis_fail(operation_id, code, kind, path, detail):
    analysis = application_analysis_ok(operation_id)
    analysis["ok"] = False
    analysis["code"] = code
    analysis["path"] = path
    analysis["detail"] = detail
    return analysis


def application_analysis_merge(left, right):
    for operation in right["operations"]:
        left["operations"] = application_append_unique_id(left["operations"], operation)
    for value_kind in right["value_kinds"]:
        left["value_kinds"] = application_append_unique_id(left["value_kinds"], value_kind)
    for assignment_target in right["assignment_targets"]:
        left["assignment_targets"] = application_append_unique_id(left["assignment_targets"], assignment_target)
    for iterator_kind in right["iterator_kinds"]:
        left["iterator_kinds"] = application_append_unique_id(left["iterator_kinds"], iterator_kind)
    for call_kind in right["call_kinds"]:
        left["call_kinds"] = application_append_unique_id(left["call_kinds"], call_kind)
    for method in right["methods"]:
        left["methods"] = application_append_unique_id(left["methods"], method)
    for control_exit in right["control_exits"]:
        left["control_exits"] = application_append_unique_id(left["control_exits"], control_exit)
    for component in right["components"]:
        left["components"] = application_append_unique(left["components"], component)
    for component_id in right["component_ids"]:
        left["component_ids"] = application_append_unique_id(left["component_ids"], component_id)
    for runtime_operation in right["runtime_operations"]:
        left["runtime_operations"] = application_append_unique(left["runtime_operations"], runtime_operation)
    left["temporary_slots"] = application_max(left["temporary_slots"], right["temporary_slots"])
    if left["ok"] and not right["ok"]:
        left["ok"] = False
        left["code"] = right["code"]
        left["path"] = right["path"]
        left["detail"] = right["detail"]
    return left


def application_analysis_kind(code, detail):
    if code == "unsupported-assignment-target":
        return "assignment_target"
    if code == "multiple-starred-targets":
        return "unpack"
    if code == "break-outside-loop":
        return "break"
    if code == "continue-outside-loop":
        return "continue"
    if code == "return-outside-function":
        return "return"
    if code == "yield-outside-function":
        return "yield"
    if code == "unknown-call" or code == "primitive-arity" or code == "unsupported-callee":
        return "call"
    if code == "unsupported-lambda-capture":
        return "lambda"
    if code == "unsupported-method" or code == "method-arity":
        return "method_call"
    if code == "unsupported-keyword":
        return "kwarg"
    if code == "unsupported-unary":
        return "unary"
    if code == "unsupported-binary":
        return "binary"
    if code == "unsupported-comprehension":
        return "comprehension"
    if code == "unsupported-for-target":
        return "for"
    return detail


def application_analysis_require_value_kind(analysis, kind):
    value_kind = application_value_kind_id(kind)
    if value_kind != 0:
        analysis["value_kinds"] = application_append_unique_id(analysis["value_kinds"], value_kind)
    return analysis


