# Canonical target-neutral application semantics and direct-lowering analysis.

def application_append_unique(items, value):
    idx = 0
    while idx < len(items):
        if items[idx] == value:
            return items
        idx = idx + 1
    return method_append(items, value)


def application_append_unique_id(items, value):
    out = []
    inserted = False
    idx = 0
    while idx < len(items):
        current = items[idx]
        if current == value:
            return items
        if inserted == False and value < current:
            out = method_append(out, value)
            inserted = True
        out = method_append(out, current)
        idx = idx + 1
    if inserted == False:
        out = method_append(out, value)
    return out


def application_max(left, right):
    if left > right:
        return left
    return right


