        return native_direct_require_runtime_success(loaded["state"], loaded["result"], path, temporary_depth + 1)
    if kind == "call" and expression["callee"]["kind"] == "var" and native_direct_has_class_plan(state, expression["callee"]["value"]):
        return native_direct_lower_constructor_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and native_direct_value_name_is_bound(state, expression["callee"]["value"]):
        if native_direct_has_function_plan(state, expression["callee"]["value"]):
            return native_direct_lower_closure_call_into_slot(state, expression, destination_slot, path, temporary_depth)
        return native_direct_lower_dynamic_closure_call_into_slot(state, expression, destination_slot, path, temporary_depth)
    # Resolve declared language functions before consulting the primitive
    # namespace.  Besides matching lexical shadowing, this keeps non-primitive
