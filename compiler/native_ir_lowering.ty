        temporary_idx = temporary_idx + 1
    capture_idx = 0
    while capture_idx < len(function_plan["captures"]):
        state = native_direct_mark_local_initialized(state, function_plan["captures"][capture_idx])
        capture_idx = capture_idx + 1
    parameter_idx = 0
    while parameter_idx < len(function_plan["parameters"]):
        state = native_direct_mark_local_initialized(state, function_plan["parameters"][parameter_idx]["name"])
        parameter_idx = parameter_idx + 1

    generator_state = native_direct_append_instruction(state, "direct_generator_state", "i32", {"args": [descriptor["result"]]})
    state = generator_state["state"]
    yield_state = 1
    while yield_state <= function_plan["yield_count"]:
        expected = native_direct_append_const_int(state, yield_state, "i32")
        state = expected["state"]
        matched = native_direct_append_instruction(state, "eq", "i1", {"args": [generator_state["result"], expected["result"]]})
        state = matched["state"]
        dispatch_block = state["current_block"]
        state = native_direct_finish_block(state, native_ir_v2_branch(matched["result"], -1, state["next_block"]))
        state["yield_dispatch_blocks"] = method_append(state["yield_dispatch_blocks"], dispatch_block)
        state = native_direct_begin_next_block(state)
        yield_state = yield_state + 1
    initial = native_direct_append_const_int(state, 0, "i32")
    state = initial["state"]
    initial_match = native_direct_append_instruction(state, "eq", "i1", {"args": [generator_state["result"], initial["result"]]})
    state = initial_match["state"]
    initial_dispatch = state["current_block"]
    done_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(initial_match["result"], -1, done_block))
    state = native_direct_begin_next_block(state)
    exhausted = native_direct_append_const_int(state, 1, "i32")
    state = native_direct_finish_block(exhausted["state"], native_ir_v2_return(exhausted["result"]))
    body_block = state["next_block"]
    state = native_direct_patch_branch_true_target(state, initial_dispatch, body_block)
    return native_direct_begin_next_block(state)


def native_direct_finish_generator_constructor(state, function_plan):
    args = [state["result_slot"]]
    saved_indexes = []
    local_idx = 0
    while local_idx < len(state["locals"]):
        if native_direct_name_in_list(state["initialized_locals"], state["locals"][local_idx]["name"]):
            args = method_append(args, state["locals"][local_idx]["slot"])
            saved_indexes = method_append(saved_indexes, local_idx)
        local_idx = local_idx + 1
    saved_count = len(state["locals"]) + len(state["loop_control_slots"]) + len(state["exception_control_slots"])
    created = native_direct_append_instruction(state, "direct_generator_new", "i32", {"args": args, "resume_name": function_plan["resume_symbol"], "saved_count": saved_count, "saved_indexes": saved_indexes, "global_frame": state["global_frame"]})
    state = native_direct_release_frame_slots(created["state"])
    state = native_direct_finish_block(state, native_ir_v2_return(created["result"]))
    frame = native_ir_v2_frame(len(function_plan["locals"]), function_plan["loop_control_slot_count"] + function_plan["exception_control_slot_count"], function_plan["value_temporary_slot_count"], state["next_result"])
    function = native_ir_v2_function(function_plan["id"], function_plan["symbol"], "private", ["ptr", "usize", "slot_ptr", "slot_ptr", "ptr"], "i32", frame, native_direct_materialize_blocks(state))
    function["source_name"] = function_plan["source_name"]
    function["source_arity"] = len(function_plan["parameters"])
    function["callable_kind"] = function_plan["callable_kind"]
    function["address_taken"] = function_plan["address_taken"]
    function["capture_count"] = len(function_plan["captures"])
    function["class_id"] = function_plan["class_id"]
    function["method_name"] = function_plan["method_name"]
    function["is_generator_constructor"] = True
    function["effects"] = ["io"]
    function["ownership"] = "owned-frame-cleanup"
    return {"state": state, "function": function}


def native_direct_finish_generator_resume(state, function_plan):
    if not state["terminated"]:
        finished = native_direct_append_instruction(state, "direct_generator_finish", "i32", {"args": [state["generator_descriptor"]]})
        state = native_direct_release_temporary_slots(finished["state"])
        exhausted = native_direct_append_const_int(state, 1, "i32")
        state = native_direct_finish_block(exhausted["state"], native_ir_v2_return(exhausted["result"]))
    if state["next_yield_state"] != function_plan["yield_count"] + 1:
        fail("direct-native lowering rejected code=generator-yield-count;function=" + function_plan["source_name"])
    frame = native_ir_v2_frame(0, 0, function_plan["value_temporary_slot_count"], state["next_result"])
    function = native_ir_v2_function(function_plan["resume_id"], function_plan["resume_symbol"], "private", ["ptr", "slot_ptr", "slot_ptr"], "i32", frame, native_direct_materialize_blocks(state))
    function["source_name"] = function_plan["source_name"]
    function["source_arity"] = 3
    function["callable_kind"] = "generator-resume"
    function["address_taken"] = False
    function["capture_count"] = 0
    function["class_id"] = function_plan["class_id"]
    function["method_name"] = function_plan["method_name"]
    function["effects"] = ["io"]
    function["ownership"] = "owned-frame-cleanup"
    return {"state": state, "function": function}


def native_direct_finish_user_function(state, function_plan):
    if not state["terminated"]:
        state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, state["result_slot"], "function." + function_plan["source_name"] + ".fallthrough", 0)
        status = native_direct_append_const_int(state, 0, "i32")
        state = native_direct_release_frame_slots(status["state"])
        state = native_direct_finish_block(state, native_ir_v2_return(status["result"]))
    frame = native_ir_v2_frame(len(function_plan["locals"]), function_plan["loop_control_slot_count"] + function_plan["exception_control_slot_count"], function_plan["value_temporary_slot_count"], state["next_result"])
    function = native_ir_v2_function(function_plan["id"], function_plan["symbol"], "private", ["ptr", "usize", "slot_ptr", "slot_ptr", "ptr"], "i32", frame, native_direct_materialize_blocks(state))
    function["source_name"] = function_plan["source_name"]
    function["source_arity"] = len(function_plan["parameters"])
    function["callable_kind"] = function_plan["callable_kind"]
    function["address_taken"] = function_plan["address_taken"]
    function["capture_count"] = len(function_plan["captures"])
    function["class_id"] = function_plan["class_id"]
    function["method_name"] = function_plan["method_name"]
    function["effects"] = ["io"]
    function["ownership"] = "owned-frame-cleanup"
    return {"state": state, "function": function}


def native_direct_functions_have_operation(functions, operation):
    function_idx = 0
    while function_idx < len(functions):
        if native_ir_v2_function_has_operation(functions[function_idx], operation):
            return True
        block_idx = 0
        while block_idx < len(functions[function_idx]["blocks"]):
            instruction_idx = 0
            instructions = functions[function_idx]["blocks"][block_idx]["instructions"]
            while instruction_idx < len(instructions):
                if instructions[instruction_idx]["op"] == operation:
                    return True
                instruction_idx = instruction_idx + 1
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return False


def native_direct_append_component(components, component):
    if not native_direct_name_in_list(components, component):
        return method_append(components, component)
    return components


def native_direct_components_from_functions(plan, functions, primitive_manifest):
    components = ["scalar-core"]
    if plan["aggregate_core"]:
        components = native_direct_append_component(components, "aggregate-core")
    has_print = native_direct_functions_have_operation(functions, "call_external") or native_direct_functions_have_operation(functions, "print_int") or native_direct_functions_have_operation(functions, "print_bool") or native_direct_functions_have_operation(functions, "direct_print_string_slot")
    if has_print:
        components = native_direct_append_component(components, "print")
    if native_direct_functions_have_operation(functions, "direct_object_new") or native_direct_functions_have_operation(functions, "direct_object_class_id") or native_direct_functions_have_operation(functions, "direct_object_attr_get") or native_direct_functions_have_operation(functions, "direct_object_attr_set"):
        components = native_direct_append_component(components, "objects")
    if native_direct_name_in_list(plan["application"]["components"], "exceptions"):
        components = native_direct_append_component(components, "exceptions")
    if native_direct_functions_have_operation(functions, "direct_generator_new") or native_direct_functions_have_operation(functions, "direct_generator_saved_slot") or native_direct_functions_have_operation(functions, "direct_generator_state") or native_direct_functions_have_operation(functions, "direct_generator_set_state") or native_direct_functions_have_operation(functions, "direct_generator_finish"):
        components = native_direct_append_component(components, "generators")
    if native_direct_functions_have_operation(functions, "direct_file_open") or native_direct_functions_have_operation(functions, "direct_file_method") or native_direct_functions_have_operation(functions, "direct_file_close"):
        components = native_direct_append_component(components, "file")
    capability_idx = 0
    while capability_idx < len(primitive_manifest["capabilities"]):
        capability = primitive_manifest["capabilities"][capability_idx]
        if capability == "process":
            components = native_direct_append_component(components, "process")
        elif capability == "collections":
            components = native_direct_append_component(components, "collections")
        elif capability == "compiler-file":
            components = native_direct_append_component(components, "compiler-file")
        elif capability == "compiler-writer":
            components = native_direct_append_component(components, "writer")
        elif capability == "host-extension":
            components = native_direct_append_component(components, "host-extension")
        elif capability == "tcp":
            components = native_direct_append_component(components, "tcp")
        elif capability == "terminal":
            components = native_direct_append_component(components, "terminal")
        elif capability == "clock":
            components = native_direct_append_component(components, "clock")
        capability_idx = capability_idx + 1
    implementation_idx = 0
    while implementation_idx < len(primitive_manifest["implementations"]):
        implementation = primitive_manifest["implementations"][implementation_idx]
        if implementation == "ast_builder_create" or implementation == "ast_builder_len" or implementation == "ast_builder_append" or implementation == "ast_builder_finish" or implementation == "ast_builder_get":
            components = native_direct_append_component(components, "compiler-ast-builder")
        if implementation == "token_builder_count" or implementation == "token_builder_append" or implementation == "token_builder_field":
            components = native_direct_append_component(components, "compiler-token")
        implementation_idx = implementation_idx + 1
    return components


def native_direct_module_from_parts(plan, functions, constants, primitive_manifest):
    externals = []
    externals.append({"name": "write", "parameters": ["i32", "ptr", "usize"], "result_type": "isize", "effect": "io"})
    components = native_direct_components_from_functions(plan, functions, primitive_manifest)
    root_manifest = plan["root_manifest"]
    root_manifest["primitive_roots"] = primitive_manifest["implementations"]
    root_manifest["runtime_roots"] = components
    plan["root_manifest"] = root_manifest
    module = native_ir_v2_module(functions, constants, externals, components, True)
    module["global_slots"] = plan["global_names"]
    module["root_manifest"] = plan["root_manifest"]
    module["class_descriptors"] = plan["classes"]
    module["attribute_names"] = plan["attribute_names"]
    if native_direct_name_in_list(plan["application"]["components"], "exceptions"):
        module["exception_abi"] = "caller-owned-slot-status-v1"
    if native_direct_name_in_list(plan["application"]["components"], "generator"):
        module["generator_abi"] = "owned-state-resume-status-v1"
    if plan["aggregate_core"]:
        module["ownership_manifest"] = "direct-owned-aggregate"
    module["primitive_implementations"] = primitive_manifest["implementations"]
    module["primitive_capabilities"] = primitive_manifest["capabilities"]
    module["extensions"] = plan["extensions"]
    module["dynamic_extension_mode"] = plan["dynamic_extension_mode"]
    module["dynamic_extension_root"] = plan["dynamic_extension_root"]
    return module


def native_direct_stream_declaration(function_id, name, visibility, parameters, result_type):
    function = native_ir_v2_function(function_id, name, visibility, parameters, result_type, native_ir_v2_frame(0, 0, 0, 0), [])
    function["operation_inventory"] = []
    function["stream_verified"] = False
    function["primitive_implementations"] = []
    function["primitive_capabilities"] = []
    return function


def native_direct_stream_declarations(plan):
    declarations = __tyrion_native_ast_builder_create()
    main = native_direct_stream_declaration(0, "main", "public", [], "i32")
    main["effects"] = ["io"]
    if plan["aggregate_core"]:
        main["ownership"] = "owned-frame-cleanup"
    __tyrion_native_ast_builder_append(declarations, 0, main)
    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        function = native_direct_stream_declaration(function_plan["id"], function_plan["symbol"], "private", ["ptr", "usize", "slot_ptr", "slot_ptr", "ptr"], "i32")
        function["source_name"] = function_plan["source_name"]
        function["source_arity"] = len(function_plan["parameters"])
        function["callable_kind"] = function_plan["callable_kind"]
        function["address_taken"] = function_plan["address_taken"]
        function["capture_count"] = len(function_plan["captures"])
        function["class_id"] = function_plan["class_id"]
        function["method_name"] = function_plan["method_name"]
        if function_plan["is_generator"]:
            function["is_generator_constructor"] = True
        function["effects"] = ["io"]
        function["ownership"] = "owned-frame-cleanup"
        __tyrion_native_ast_builder_append(declarations, 0, function)
        function_idx = function_idx + 1
    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        if function_plan["is_generator"]:
            resume = native_direct_stream_declaration(function_plan["resume_id"], function_plan["resume_symbol"], "private", ["ptr", "slot_ptr", "slot_ptr"], "i32")
            resume["source_name"] = function_plan["source_name"]
            resume["source_arity"] = 3
            resume["callable_kind"] = "generator-resume"
            resume["address_taken"] = False
            resume["capture_count"] = 0
            resume["class_id"] = function_plan["class_id"]
            resume["method_name"] = function_plan["method_name"]
            resume["effects"] = ["io"]
            resume["ownership"] = "owned-frame-cleanup"
            __tyrion_native_ast_builder_append(declarations, 0, resume)
        function_idx = function_idx + 1
    declaration_lists = __tyrion_native_ast_builder_finish(declarations)
    return declaration_lists[0]


def native_direct_stream_publish_function(module, function):
    function["operation_inventory"] = native_ir_v2_function_operation_inventory(function)
    function_primitive_manifest = native_ir_v2_function_primitive_manifest(function)
    declaration = module["functions"][function["id"]]
    declaration["operation_inventory"] = function["operation_inventory"]
    declaration["primitive_implementations"] = function_primitive_manifest["implementations"]
    declaration["primitive_capabilities"] = function_primitive_manifest["capabilities"]
    declaration["frame"] = function["frame"]
    declaration["effects"] = function["effects"]
    declaration["ownership"] = function["ownership"]
    functions = module["functions"]
    functions[function["id"]] = declaration
    module["functions"] = functions
    return module


def native_direct_module_from_plan(plan):
    if plan["contract"] != "tyrion-native-direct-plan-v1":
        fail("direct-native lowering rejected code=plan-contract")
    full_symbol_index = native_direct_reachability_index(plan["functions"], plan["classes"])
    symbol_index = {"entries": full_symbol_index["entries"], "heads": full_symbol_index["heads"]}
    function_plan_store = native_direct_function_plan_store(plan["functions"])
    primitive_manifest = {"implementations": [], "capabilities": []}
    state = native_direct_function_state(plan, function_plan_store, symbol_index, native_direct_constant_pool_create(), primitive_manifest, False)
    state = native_direct_lower_statements(state, plan["executable_items"], "program")
    if not state["terminated"]:
        exit_value = native_direct_append_const_int(state, 0, "i32")
        state = exit_value["state"]
        state = native_direct_release_frame_slots(state)
        state = native_direct_finish_block(state, native_ir_v2_return(exit_value["result"]))
    frame = native_ir_v2_frame(len(plan["locals"]), plan["loop_control_slot_count"] + plan["exception_control_slot_count"], plan["value_temporary_slot_count"], state["next_result"])
    function = native_ir_v2_function(0, "main", "public", [], "i32", frame, native_direct_materialize_blocks(state))
    function["effects"] = ["io"]
    if plan["aggregate_core"]:
        function["ownership"] = "owned-frame-cleanup"
    functions = __tyrion_native_ast_builder_create()
    __tyrion_native_ast_builder_append(functions, 0, function)
    constant_pool = state["constant_pool"]
    primitive_manifest = state["primitive_manifest"]
    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        function_state = native_direct_function_state(function_plan, function_plan_store, symbol_index, constant_pool, primitive_manifest, True)
        if function_plan["is_generator"]:
            finished = native_direct_finish_generator_constructor(function_state, function_plan)
        else:
            function_state = native_direct_lower_statements(function_state, function_plan["body"], "function." + function_plan["source_name"])
            finished = native_direct_finish_user_function(function_state, function_plan)
        constant_pool = finished["state"]["constant_pool"]
        primitive_manifest = finished["state"]["primitive_manifest"]
        __tyrion_native_ast_builder_append(functions, 0, finished["function"])
        function_idx = function_idx + 1
    function_idx = 0
    while function_idx < len(plan["functions"]):
        function_plan = plan["functions"][function_idx]
        if function_plan["is_generator"]:
            resume_state = native_direct_generator_resume_state(function_plan, function_plan_store, symbol_index, constant_pool, primitive_manifest)
            resume_state = native_direct_lower_statements(resume_state, function_plan["body"], "generator." + function_plan["source_name"])
            finished = native_direct_finish_generator_resume(resume_state, function_plan)
            constant_pool = finished["state"]["constant_pool"]
            primitive_manifest = finished["state"]["primitive_manifest"]
            __tyrion_native_ast_builder_append(functions, 0, finished["function"])
        function_idx = function_idx + 1
    function_lists = __tyrion_native_ast_builder_finish(functions)
    constant_lists = __tyrion_native_ast_builder_finish(constant_pool["constants"])
    return native_direct_module_from_parts(plan, function_lists[0], constant_lists[0], primitive_manifest)


def native_direct_module_from_program(program, target, extensions):
    application = native_direct_analyze(program, target)
    plan = native_direct_plan(program, application, target)
    plan["extensions"] = extensions
    return verify_native_ir(native_direct_module_from_plan(plan))


def native_direct_path_module(path, target, extensions):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    return native_direct_module_from_program(program, target, extensions)


def native_direct_source_module(source, target):
    program = parse_program(lex(source))
    return native_direct_module_from_program(program, target, [])


def native_direct_source_summary(source):
    module = native_direct_source_module(source, target_spec("linux", "x86_64"))
    function = module["functions"][0]
    instruction_count = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instruction_count = instruction_count + len(function["blocks"][block_idx]["instructions"])
        block_idx = block_idx + 1
    return module["contract"] + ":functions=" + str(len(module["functions"])) + ":blocks=" + str(len(function["blocks"])) + ":constants=" + str(len(module["constants"])) + ":instructions=" + str(instruction_count)


def native_direct_source_component_summary(source):
    module = native_direct_source_module(source, target_spec("linux", "x86_64"))
    text = ""
    component_idx = 0
    while component_idx < len(module["components"]):
        if component_idx != 0:
            text = text + ","
        text = text + module["components"][component_idx]
        component_idx = component_idx + 1
    return "tyrion-native-direct-components-v1:count=" + str(len(module["components"])) + ":components=" + text


def native_direct_path_summary(path):
    module = native_direct_path_module(path, target_spec("linux", "x86_64"), [])
    instruction_count = 0
    block_count = 0
    function_idx = 0
    while function_idx < len(module["functions"]):
        function = module["functions"][function_idx]
        block_count = block_count + len(function["blocks"])
        block_idx = 0
        while block_idx < len(function["blocks"]):
            instruction_count = instruction_count + len(function["blocks"][block_idx]["instructions"])
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    primitive_implementations = native_direct_module_primitive_implementations(module)
    primitive_text = ""
    primitive_idx = 0
    while primitive_idx < len(primitive_implementations):
        if primitive_idx != 0:
            primitive_text = primitive_text + ","
        primitive_text = primitive_text + primitive_implementations[primitive_idx]
        primitive_idx = primitive_idx + 1
    return module["contract"] + ":functions=" + str(len(module["functions"])) + ":blocks=" + str(block_count) + ":constants=" + str(len(module["constants"])) + ":instructions=" + str(instruction_count) + ":primitives=" + primitive_text


def native_direct_module_primitive_implementations(module):
    implementations = []
    function_idx = 0
    while function_idx < len(module["functions"]):
        function = module["functions"][function_idx]
        block_idx = 0
        while block_idx < len(function["blocks"]):
            instructions = function["blocks"][block_idx]["instructions"]
            instruction_idx = 0
            while instruction_idx < len(instructions):
                instruction = instructions[instruction_idx]
                if instruction["op"] == "direct_primitive_call":
                    implementation = primitive_schema_implementation_for_id(instruction["fields"]["primitive_id"])
                    if not native_direct_name_in_list(implementations, implementation):
                        implementations = method_append(implementations, implementation)
                instruction_idx = instruction_idx + 1
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return implementations


def native_direct_module_primitive_capabilities(module):
    capabilities = []
    function_idx = 0
    while function_idx < len(module["functions"]):
        function = module["functions"][function_idx]
        block_idx = 0
        while block_idx < len(function["blocks"]):
            instructions = function["blocks"][block_idx]["instructions"]
            instruction_idx = 0
            while instruction_idx < len(instructions):
                instruction = instructions[instruction_idx]
                if instruction["op"] == "direct_primitive_call":
                    capability = primitive_schema_capability_for_id(instruction["fields"]["primitive_id"])
                    if not native_direct_name_in_list(capabilities, capability):
                        capabilities = method_append(capabilities, capability)
                instruction_idx = instruction_idx + 1
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return capabilities


def native_direct_path_primitive_summary(path):
    module = native_direct_path_module(path, target_spec("linux", "x86_64"), [])
    implementations = native_direct_module_primitive_implementations(module)
    text = ""
    idx = 0
    while idx < len(implementations):
        if idx != 0:
            text = text + ","
        text = text + implementations[idx]
        idx = idx + 1
    return "tyrion-native-direct-primitives-v1:count=" + str(len(implementations)) + ":implementations=" + text


def native_direct_path_plan_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    analysis = native_direct_analyze(program, target_spec("linux", "x86_64"))
    plan = native_direct_plan(program, analysis, target_spec("linux", "x86_64"))
    return plan["contract"] + ":declared-functions=" + str(plan["declared_function_count"]) + ":reachable-functions=" + str(len(plan["functions"])) + ":classes=" + str(len(plan["classes"])) + ":top-level-statements=" + str(len(plan["executable_items"])) + ":main-locals=" + str(len(plan["locals"])) + ":main-loop-slots=" + str(plan["loop_control_slot_count"]) + ":main-exception-slots=" + str(plan["exception_control_slot_count"]) + ":main-temporary-slots=" + str(plan["value_temporary_slot_count"]) + ":max-function-arity=" + str(plan["max_function_arity"])


def native_direct_path_descriptor_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    target = target_spec("linux", "x86_64")
    analysis = native_direct_analyze(program, target)
    plan = native_direct_plan(program, analysis, target)
    attributes = ""
    attribute_idx = 0
    while attribute_idx < len(plan["attribute_names"]):
        if attribute_idx != 0:
            attributes = attributes + ","
        attributes = attributes + plan["attribute_names"][attribute_idx]
        attribute_idx = attribute_idx + 1
    return "tyrion-native-direct-descriptors-v1:classes=" + str(len(plan["classes"])) + ":attributes=" + str(len(plan["attribute_names"])) + ":attribute-names=" + attributes


def native_direct_path_runtime_operation_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    analysis = native_direct_analyze(program, target_spec("linux", "x86_64"))
    operations = analysis["application"]["runtime_operations"]
    text = ""
    idx = 0
    while idx < len(operations):
        if idx != 0:
            text = text + ","
        text = text + operations[idx]
        idx = idx + 1
    return "tyrion-native-direct-runtime-operations-v1:count=" + str(len(operations)) + ":operations=" + text


def native_direct_path_parse_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    return "tyrion-native-direct-parse-v1:source-bytes=" + str(len(source)) + ":top-level-statements=" + str(len(program["items"]))


def native_direct_path_inventory_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    functions = native_direct_function_plans(program)
    classes = native_direct_class_plans(program, functions)
    return "tyrion-native-direct-inventory-v1:functions=" + str(len(functions)) + ":classes=" + str(len(classes))


def native_direct_path_reachability_summary(path):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    functions = native_direct_function_plans(program)
    classes = native_direct_class_plans(program, functions)
    target = target_spec("linux", "x86_64")
    reachable = native_direct_reachable_function_ids(program["items"], [], functions, classes, target, native_direct_root_manifest(target))
    return "tyrion-native-direct-reachability-v1:declared-functions=" + str(len(functions)) + ":reachable-functions=" + str(len(reachable["ids"])) + ":classes=" + str(len(classes))


def native_direct_plan_has_source_function(plan, name):
    idx = 0
    while idx < len(plan["functions"]):
        if plan["functions"][idx]["source_name"] == name:
            return True
        idx = idx + 1
    return False


def native_direct_path_reachability_pair_summary(path, required_name, omitted_name):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    target = target_spec("linux", "x86_64")
    functions = native_direct_function_plans(program)
    classes = native_direct_class_plans(program, functions)
    root_manifest = native_direct_root_manifest(target)
    reachable = native_direct_reachable_function_ids(program["items"], [], functions, classes, target, root_manifest)
    required_present = False
    omitted_present = False
    reachable_idx = 0
    while reachable_idx < len(reachable["ids"]):
        function = native_direct_function_plan_by_id(functions, reachable["ids"][reachable_idx])
        if function["source_name"] == required_name:
            required_present = True
        if function["source_name"] == omitted_name:
            omitted_present = True
        reachable_idx = reachable_idx + 1
    return "tyrion-native-direct-reachability-pair-v1:required=" + required_name + ":required-present=" + str(required_present) + ":omitted=" + omitted_name + ":omitted-present=" + str(omitted_present) + ":root-contract=" + root_manifest["contract"]


def native_direct_reachability_index_probe(source, name):
    program = parse_program(lex(source))
    functions = native_direct_function_plans(program)
    classes = native_direct_class_plans(program, functions)
    reachability = native_direct_reachability_index(functions, classes)
    return native_direct_reachability_index_first(reachability, name, 1, 0)


def native_direct_plan_summary(source):
    target = target_spec("linux", "x86_64")
    program = parse_program(lex(source))
    analysis = native_direct_analyze(program, target)
    plan = native_direct_plan(program, analysis, target)
    local_names = ""
    idx = 0
    while idx < len(plan["locals"]):
        if idx > 0:
            local_names = local_names + ","
        local_names = local_names + plan["locals"][idx]["name"]
        idx = idx + 1
    application = plan["application"]
    return plan["contract"] + ":locals=" + local_names + ":operations=" + str(len(application["operations"])) + ":value-kinds=" + str(len(application["value_kinds"])) + ":calls=" + str(len(application["call_kinds"])) + ":components=" + str(len(application["components"]))
