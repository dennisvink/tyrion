    return native_direct_require_call_success(called["state"], called["result"], exception_slot, path)


def native_direct_lower_sorted_builtin_into_slot(state, expression, destination_slot, path, temporary_depth):
    base_depth = temporary_depth + 1
    work_depth = base_depth + 1
    compare_depth = base_depth + 2
    nested_depth = base_depth + 3
    iterable_slot = native_direct_value_temporary_pair_slot(state, base_depth, 0, path + ".iterable")
    key_slot = native_direct_value_temporary_pair_slot(state, base_depth, 1, path + ".key")
    copy_cursor_slot = native_direct_value_temporary_pair_slot(state, base_depth, 2, path + ".copy-cursor")
    outer_cursor_slot = native_direct_value_temporary_pair_slot(state, base_depth, 3, path + ".outer-cursor")
    inner_cursor_slot = native_direct_value_temporary_pair_slot(state, work_depth, 0, path + ".inner-cursor")
    left_item_slot = native_direct_value_temporary_pair_slot(state, work_depth, 1, path + ".left-item")
    right_item_slot = native_direct_value_temporary_pair_slot(state, work_depth, 2, path + ".right-item")
    left_key_slot = native_direct_value_temporary_pair_slot(state, work_depth, 3, path + ".left-key")
    right_key_slot = native_direct_value_temporary_pair_slot(state, compare_depth, 0, path + ".right-key")
    compare_slot = native_direct_value_temporary_pair_slot(state, compare_depth, 1, path + ".compare")
    exception_slot = native_direct_value_temporary_pair_slot(state, compare_depth, 2, path + ".exception")

    iterable = native_direct_call_argument_value(expression["args"][0])
    state = native_direct_lower_value_into_slot(state, iterable, iterable_slot, path + ".arg[0]", nested_depth)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".arg[0].prepare", nested_depth)
    has_key = len(expression["args"]) == 2
    if has_key:
        key_argument = expression["args"][1]
        key_path = path + ".arg[1]"
        if key_argument["kind"] == "kwarg":
            key_path = key_path + ".value"
        key_expression = native_direct_call_argument_value(key_argument)
        state = native_direct_lower_value_into_slot(state, key_expression, key_slot, key_path, nested_depth)

    created = native_direct_append_instruction(state, "direct_slot_collection_new", "slot_ptr", {"args": [destination_slot], "collection_kind": "list", "capacity": 0})
    state = created["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    copy_cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [copy_cursor_slot, zero["result"]]})
    state = copy_cursor_stored["state"]

    copy_condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(copy_condition_block))
    state = native_direct_begin_next_block(state)
    copy_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [copy_cursor_slot]})
    state = copy_current["state"]
    copy_count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = copy_count["state"]
    copy_has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [copy_current["result"], copy_count["result"]]})
    state = copy_has_item["state"]
    copy_body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(copy_has_item["result"], copy_body_block, -1))

    state = native_direct_begin_next_block(state)
    copied_item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [left_item_slot, iterable_slot, copy_current["result"]]})
    state = copied_item["state"]
    appended = native_direct_append_instruction(state, "direct_collection_append_owned", "i32", {"args": [destination_slot, left_item_slot]})
    state = appended["state"]
    copy_increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [copy_cursor_slot]})
    state = copy_increment_current["state"]
    copy_one = native_direct_append_const_int(state, 1, "i32")
    state = copy_one["state"]
    copy_next = native_direct_append_instruction(state, "add", "i32", {"args": [copy_increment_current["result"], copy_one["result"]]})
    state = copy_next["state"]
    copy_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [copy_cursor_slot, copy_next["result"]]})
    state = native_direct_finish_block(copy_next_stored["state"], native_ir_v2_jump(copy_condition_block))

    copy_exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, copy_condition_block, copy_exit_block)
    state = native_direct_begin_next_block(state)
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    outer_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [outer_cursor_slot, one["result"]]})
    state = outer_stored["state"]

    outer_condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(outer_condition_block))
    state = native_direct_begin_next_block(state)
    outer_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [outer_cursor_slot]})
    state = outer_current["state"]
    outer_count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [destination_slot]})
    state = outer_count["state"]
    outer_has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [outer_current["result"], outer_count["result"]]})
    state = outer_has_item["state"]
    outer_body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(outer_has_item["result"], outer_body_block, -1))

    state = native_direct_begin_next_block(state)
    inner_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [inner_cursor_slot, outer_current["result"]]})
    state = inner_stored["state"]
    inner_condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(inner_condition_block))
    state = native_direct_begin_next_block(state)
    inner_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [inner_cursor_slot]})
    state = inner_current["state"]
    inner_zero = native_direct_append_const_int(state, 0, "i32")
    state = inner_zero["state"]
    has_previous = native_direct_append_instruction(state, "gt", "i1", {"args": [inner_current["result"], inner_zero["result"]]})
    state = has_previous["state"]
    compare_body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_previous["result"], compare_body_block, -1))

    state = native_direct_begin_next_block(state)
    compare_inner = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [inner_cursor_slot]})
    state = compare_inner["state"]
    compare_one = native_direct_append_const_int(state, 1, "i32")
    state = compare_one["state"]
    left_index = native_direct_append_instruction(state, "sub", "i32", {"args": [compare_inner["result"], compare_one["result"]]})
    state = left_index["state"]
    left_item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [left_item_slot, destination_slot, left_index["result"]]})
    state = left_item["state"]
    right_item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [right_item_slot, destination_slot, compare_inner["result"]]})
    state = right_item["state"]
    if has_key:
        state = native_direct_lower_closure_slot_call_into_slot(state, key_slot, left_item_slot, left_key_slot, exception_slot, path + ".key.left")
        state = native_direct_lower_closure_slot_call_into_slot(state, key_slot, right_item_slot, right_key_slot, exception_slot, path + ".key.right")
    else:
        left_key = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [left_key_slot, left_item_slot]})
        state = left_key["state"]
        right_key = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [right_key_slot, right_item_slot]})
        state = right_key["state"]
    compared = native_direct_append_instruction(state, "direct_slot_binary", "i32", {"args": [compare_slot, right_key_slot, left_key_slot], "operator": "<"})
    state = compared["state"]
    should_swap = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [compare_slot]})
    state = should_swap["state"]
    comparison_block = state["current_block"]
    swap_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(should_swap["result"], swap_block, -1))

    state = native_direct_begin_next_block(state)
    right_index_stored = native_direct_append_instruction(state, "direct_slot_set_int_owned", "slot_ptr", {"args": [right_key_slot, compare_inner["result"]]})
    state = right_index_stored["state"]
    left_index_stored = native_direct_append_instruction(state, "direct_slot_set_int_owned", "slot_ptr", {"args": [compare_slot, left_index["result"]]})
    state = left_index_stored["state"]
    left_replaced = native_direct_append_instruction(state, "direct_slot_index_set", "i32", {"args": [destination_slot, compare_slot, right_item_slot]})
    state = left_replaced["state"]
    right_replaced = native_direct_append_instruction(state, "direct_slot_index_set", "i32", {"args": [destination_slot, right_key_slot, left_item_slot]})
    state = right_replaced["state"]
    decrement_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [inner_cursor_slot]})
    state = decrement_current["state"]
    decrement_one = native_direct_append_const_int(state, 1, "i32")
    state = decrement_one["state"]
    previous = native_direct_append_instruction(state, "sub", "i32", {"args": [decrement_current["result"], decrement_one["result"]]})
    state = previous["state"]
    previous_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [inner_cursor_slot, previous["result"]]})
    state = native_direct_finish_block(previous_stored["state"], native_ir_v2_jump(inner_condition_block))

    outer_increment_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, inner_condition_block, outer_increment_block)
    state = native_direct_patch_branch_false_target(state, comparison_block, outer_increment_block)
    state = native_direct_begin_next_block(state)
    outer_increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [outer_cursor_slot]})
    state = outer_increment_current["state"]
    outer_one = native_direct_append_const_int(state, 1, "i32")
    state = outer_one["state"]
    outer_next = native_direct_append_instruction(state, "add", "i32", {"args": [outer_increment_current["result"], outer_one["result"]]})
    state = outer_next["state"]
    outer_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [outer_cursor_slot, outer_next["result"]]})
    state = native_direct_finish_block(outer_next_stored["state"], native_ir_v2_jump(outer_condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, outer_condition_block, exit_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_primitive_call_into_slot(state, expression, destination_slot, path, temporary_depth):
    # Keep the schema lookup key independent of the borrowed AST field.  The
    # schema helpers create temporary split rows and may otherwise expose C-seed
    # allocator reuse in sufficiently large compiler descendants.
    name = "" + expression["callee"]["value"]
    argc = len(expression["args"])
    if not primitive_schema_accepts_arity(name, argc):
        fail("direct-native lowering rejected code=primitive-arity;name=" + name + ";position=" + path)
    fields = primitive_schema_find(name)
    primitive_id = int(fields[0])
    primitive_borrows_arguments = fields[8] == "borrow"
    fields = none
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    args = [destination_slot, exception_slot]
    reserved_depth = native_direct_temporary_groups_for_arguments(argc + 1)
    arg_idx = 0
    while arg_idx < argc:
        argument = expression["args"][arg_idx]
        argument_expression = argument
        if argument["kind"] == "kwarg":
            argument_expression = argument["value"]
        argument_path = path + ".arg[" + str(arg_idx) + "]"
        if primitive_borrows_arguments and argument_expression["kind"] == "var":
            # Primitive calls are synchronous and the ABI schema explicitly
            # guarantees that borrowed arguments do not escape. Pass a bound
            # variable's existing slot directly instead of recursively cloning
            # a potentially huge aggregate into a temporary call slot.
            resolved = native_direct_value_slot_for_read(state, argument_expression["value"], argument_path)
            state = resolved["state"]
            argument_slot = resolved["slot"]
        else:
            argument_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, arg_idx + 1, argument_path)
            state = native_direct_lower_value_into_slot(state, argument_expression, argument_slot, argument_path, temporary_depth + reserved_depth)
        args = method_append(args, argument_slot)
        arg_idx = arg_idx + 1
    primitive = native_direct_append_instruction(state, "direct_primitive_call", "i32", {"args": args, "primitive_id": primitive_id, "argc": argc})
    return native_direct_require_call_success(primitive["state"], primitive["result"], exception_slot, path)


def native_direct_prepare_iterable(state, iterable_slot, path, temporary_depth):
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    prepared = native_direct_append_instruction(state, "direct_iterable_prepare", "i32", {"args": [iterable_slot, exception_slot]})
    return native_direct_require_call_success(prepared["state"], prepared["result"], exception_slot, path)


def native_direct_lower_constructor_into_slot(state, expression, destination_slot, path, temporary_depth):
    class_plan = native_direct_class_plan(state, expression["callee"]["value"])
    created = native_direct_append_instruction(state, "direct_object_new", "i32", {"args": [destination_slot], "class_id": class_plan["id"], "field_count": len(state["attribute_names"])})
    state = native_direct_require_runtime_success(created["state"], created["result"], path + ".new", temporary_depth)
    if native_direct_class_has_method(class_plan, "__init__"):
        init_plan = native_direct_class_method_plan(state, class_plan, "__init__")
        ignored_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 1, path + ".init-result")
        return native_direct_lower_bound_call_into_slot(state, init_plan, expression["args"], destination_slot, ignored_slot, path + ".__init__", temporary_depth + 2)
    if len(expression["args"]) != 0:
        fail("direct-native lowering rejected code=argument-count;function=" + class_plan["name"] + ";position=" + path)
    return state


def native_direct_lower_bound_method_into_slot(state, expression, destination_slot, path, temporary_depth):
    receiver_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".receiver")
    state = native_direct_lower_value_into_slot(state, expression["receiver"], receiver_slot, path + ".receiver", temporary_depth + 1)
    matches = native_direct_classes_with_method(state, expression["name"])
    if len(matches) == 0:
        fail("direct-native lowering rejected code=unknown-bound-method;name=" + expression["name"] + ";position=" + path)
    class_id_value = native_direct_append_instruction(state, "direct_object_class_id", "i32", {"args": [receiver_slot]})
    state = class_id_value["state"]
    incoming_initialized = state["initialized_locals"]
    exits = []
    match_idx = 0
    while match_idx < len(matches):
        class_plan = matches[match_idx]
        expected = native_direct_append_const_int(state, class_plan["id"], "i32")
        state = expected["state"]
        matches_class = native_direct_append_instruction(state, "eq", "i1", {"args": [class_id_value["result"], expected["result"]]})
        state = matches_class["state"]
        condition_block = state["current_block"]
        call_block = state["next_block"]
        state = native_direct_finish_block(state, native_ir_v2_branch(matches_class["result"], call_block, -1))
        state = native_direct_begin_next_block(state)
        method_plan = native_direct_class_method_plan(state, class_plan, expression["name"])
        state = native_direct_lower_bound_call_into_slot(state, method_plan, expression["args"], receiver_slot, destination_slot, path + "." + class_plan["name"], temporary_depth + 1)
        exits = method_append(exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        next_test_block = state["next_block"]
        state = native_direct_patch_branch_false_target(state, condition_block, next_test_block)
        state = native_direct_begin_next_block(state)
        state["initialized_locals"] = incoming_initialized
        match_idx = match_idx + 1
    failure_status = native_direct_append_const_int(state, 3, "i32")
    state = failure_status["state"]
    state = native_direct_release_frame_slots(state)
    state = native_direct_finish_block(state, native_ir_v2_return(failure_status["result"]))
    merge_block = state["next_block"]
    exit_idx = 0
    while exit_idx < len(exits):
        state = native_direct_patch_jump_target(state, exits[exit_idx], merge_block)
        exit_idx = exit_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_closure_call_into_slot(state, expression, destination_slot, path, temporary_depth):
    function_plan = native_direct_function_plan(state, expression["callee"]["value"])
    binding = native_direct_bind_call(function_plan, expression["args"], path)
    parameter_count = len(function_plan["parameters"])
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    argument_slots = []
    parameter_idx = 0
    while parameter_idx < parameter_count:
        argument_slots = method_append(argument_slots, native_direct_value_temporary_offset_slot(state, temporary_depth, parameter_idx + 1, path + ".bound[" + str(parameter_idx) + "]"))
        parameter_idx = parameter_idx + 1
    reserved_depth = native_direct_temporary_groups_for_arguments(parameter_count)
    argument_idx = 0
    while argument_idx < len(expression["args"]):
        argument = expression["args"][argument_idx]
        argument_expression = argument
        if argument["kind"] == "kwarg":
            argument_expression = argument["value"]
        parameter_idx = binding["argument_parameter_indices"][argument_idx]
        state = native_direct_lower_value_into_slot(state, argument_expression, argument_slots[parameter_idx], path + ".arg[" + str(argument_idx) + "]", temporary_depth + reserved_depth)
        argument_idx = argument_idx + 1
    callee_slot = native_direct_local_slot(state, expression["callee"]["value"])
    call_args = [destination_slot, exception_slot, callee_slot]
    parameter_idx = 0
    while parameter_idx < len(argument_slots):
        call_args = method_append(call_args, argument_slots[parameter_idx])
        parameter_idx = parameter_idx + 1
    called = native_direct_append_instruction(state, "direct_closure_call", "i32", {"args": call_args, "argc": parameter_count, "targets": native_direct_closure_targets(state)})
    return native_direct_require_call_success(called["state"], called["result"], exception_slot, path)


def native_direct_lower_dynamic_closure_call_into_slot(state, expression, destination_slot, path, temporary_depth):
    parameter_count = len(expression["args"])
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    argument_slots = []
    reserved_depth = native_direct_temporary_groups_for_arguments(parameter_count)
    argument_idx = 0
    while argument_idx < len(expression["args"]):
        argument = expression["args"][argument_idx]
        if argument["kind"] == "kwarg":
            fail("direct-native lowering rejected code=dynamic-closure-keyword;name=" + argument["name"] + ";position=" + path)
        argument_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, argument_idx + 1, path + ".arg[" + str(argument_idx) + "]")
        state = native_direct_lower_value_into_slot(state, argument, argument_slot, path + ".arg[" + str(argument_idx) + "]", temporary_depth + reserved_depth)
        argument_slots = method_append(argument_slots, argument_slot)
        argument_idx = argument_idx + 1
    callee_slot = native_direct_local_slot(state, expression["callee"]["value"])
    call_args = [destination_slot, exception_slot, callee_slot]
    argument_idx = 0
    while argument_idx < len(argument_slots):
        call_args = method_append(call_args, argument_slots[argument_idx])
        argument_idx = argument_idx + 1
    called = native_direct_append_instruction(state, "direct_closure_call", "i32", {"args": call_args, "argc": parameter_count, "targets": native_direct_closure_targets(state)})
    return native_direct_require_call_success(called["state"], called["result"], exception_slot, path)


def native_direct_lower_short_circuit_into_slot(state, expression, destination_slot, path, temporary_depth):
    left_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".left")
    state = native_direct_lower_value_into_slot(state, expression["left"], left_slot, path + ".left", temporary_depth + 1)
    truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [left_slot]})
    state = truthy["state"]
    first_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(truthy["result"], first_block, -1))
    condition_block = state["current_block"]
    state = native_direct_begin_next_block(state)
    if expression["op"] == "and":
        right_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".right")
        state = native_direct_lower_value_into_slot(state, expression["right"], right_slot, path + ".right", temporary_depth + 1)
        right_truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [right_slot]})
        stored = native_direct_append_instruction(right_truthy["state"], "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, right_truthy["result"]]})
        state = stored["state"]
    else:
        stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, truthy["result"]]})
        state = stored["state"]
    first_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    second_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, second_block)
    state = native_direct_begin_next_block(state)
    if expression["op"] == "and":
        stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, truthy["result"]]})
        state = stored["state"]
    else:
        right_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".right")
        state = native_direct_lower_value_into_slot(state, expression["right"], right_slot, path + ".right", temporary_depth + 1)
        right_truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [right_slot]})
        stored = native_direct_append_instruction(right_truthy["state"], "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, right_truthy["result"]]})
        state = stored["state"]
    second_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    merge_block = state["next_block"]
    state = native_direct_patch_jump_target(state, first_exit, merge_block)
    state = native_direct_patch_jump_target(state, second_exit, merge_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_comprehension_into_slot(state, expression, destination_slot, path, temporary_depth):
    incoming_initialized = state["initialized_locals"]
    iterable_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".iterable")
    cursor_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 1, path + ".cursor")
    condition_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 2, path + ".condition")
    result_a_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 3, path + ".result-a")
    result_b_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 4, path + ".result-b")
    nested_depth = temporary_depth + 2

    state = native_direct_lower_value_into_slot(state, expression["iterable"], iterable_slot, path + ".iterable", nested_depth)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".iterable.prepare", nested_depth)
    if expression["out_kind"] == "list":
        created = native_direct_append_instruction(state, "direct_slot_collection_new", "slot_ptr", {"args": [destination_slot], "collection_kind": "list", "capacity": 0})
    elif expression["out_kind"] == "dict":
        created = native_direct_append_instruction(state, "direct_slot_dict_new", "slot_ptr", {"args": [destination_slot], "capacity": 0})
    else:
        fail("direct-native lowering rejected code=comprehension-kind;kind=" + expression["out_kind"] + ";position=" + path)
    state = created["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    test_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(test_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    target_slot = native_direct_local_slot(state, expression["target"])
    copied = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, iterable_slot, current["result"]]})
    state = native_direct_mark_local_initialized(copied["state"], expression["target"])
    state = native_direct_lower_value_into_slot(state, expression["condition"], condition_slot, path + ".condition", nested_depth)
    condition = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [condition_slot]})
    state = condition["state"]
    condition_block = state["current_block"]
    emit_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(condition["result"], emit_block, -1))

    state = native_direct_begin_next_block(state)
    if expression["out_kind"] == "list":
        state = native_direct_lower_value_into_slot(state, expression["expr"], result_a_slot, path + ".expr", nested_depth)
        appended = native_direct_append_instruction(state, "direct_collection_append_owned", "i32", {"args": [destination_slot, result_a_slot]})
        state = appended["state"]
    else:
        state = native_direct_lower_value_into_slot(state, expression["key"], result_a_slot, path + ".key", nested_depth)
        state = native_direct_lower_value_into_slot(state, expression["value"], result_b_slot, path + ".value", nested_depth)
        inserted = native_direct_append_instruction(state, "direct_dict_put_owned", "i32", {"args": [destination_slot, result_a_slot, result_b_slot]})
        state = inserted["state"]
    advance_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(advance_block))
    state = native_direct_patch_branch_false_target(state, condition_block, advance_block)

    state = native_direct_begin_next_block(state)
    increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = increment_current["state"]
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
    state = next_value["state"]
    next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
    state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(test_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, test_block, exit_block)
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_value_into_slot(state, expression, destination_slot, path, temporary_depth):
    kind = expression["kind"]
    if kind == "lambda":
        function_plan = native_direct_lambda_plan(state, path)
        capture_args = [destination_slot]
        capture_idx = 0
        while capture_idx < len(function_plan["captures"]):
            capture_name = function_plan["captures"][capture_idx]
            if not native_direct_name_in_list(state["initialized_locals"], capture_name):
                fail("direct-native lowering rejected code=closure-capture-before-assignment;name=" + capture_name + ";position=" + path)
            capture_args = method_append(capture_args, native_direct_local_slot(state, capture_name))
            capture_idx = capture_idx + 1
        created = native_direct_append_instruction(state, "direct_slot_closure_new", "i32", {"args": capture_args, "function_id": function_plan["id"], "capture_count": len(function_plan["captures"]), "global_frame": state["global_frame"]})
        return created["state"]
    if kind == "string":
        constant = native_direct_constant_id(state, "bytes", expression["value"])
        state = constant["state"]
        address = native_direct_append_instruction(state, "const_address", "ptr", {"constant_id": constant["id"]})
        state = address["state"]
        length = native_direct_append_const_int(state, len(expression["value"]), "usize")
        state = length["state"]
        stored = native_direct_append_instruction(state, "direct_slot_set_string", "slot_ptr", {"args": [destination_slot, address["result"], length["result"]]})
        return stored["state"]
    if kind == "none":
        operation = "slot_set_none"
        if state["aggregate_core"]:
            operation = "direct_slot_set_none_owned"
        stored = native_direct_append_instruction(state, operation, "slot_ptr", {"args": [destination_slot]})
        return stored["state"]
    if kind == "bool":
        value = native_direct_lower_scalar_expression(state, expression, path)
