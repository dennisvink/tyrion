    compare_slot = native_direct_value_temporary_offset_slot(state, base_depth, 3, path + ".compare")
    nested_depth = base_depth + 1
    if len(expression["args"]) == 1:
        iterable = native_direct_call_argument_value(expression["args"][0])
    else:
        iterable_items = []
        argument_idx = 0
        while argument_idx < len(expression["args"]):
            iterable_items = method_append(iterable_items, native_direct_call_argument_value(expression["args"][argument_idx]))
            argument_idx = argument_idx + 1
        iterable = {"kind": "list", "items": iterable_items}
    state = native_direct_lower_value_into_slot(state, iterable, iterable_slot, path + ".iterable", nested_depth)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".iterable.prepare", nested_depth)
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    nonempty = native_direct_append_instruction(state, "gt", "i1", {"args": [count["result"], zero["result"]]})
    state = nonempty["state"]
    count_block = state["current_block"]
    failure_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(nonempty["result"], -1, failure_block))

    state = native_direct_begin_next_block(state)
    error_text = "min() arg is an empty sequence\n"
    if max_mode:
        error_text = "max() arg is an empty sequence\n"
    state = native_direct_append_write_fd(state, 2, error_text)
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    state = native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))

    initial_block = state["next_block"]
    state = native_direct_patch_branch_true_target(state, count_block, initial_block)
    state = native_direct_begin_next_block(state)
    first_index = native_direct_append_const_int(state, 0, "i32")
    state = first_index["state"]
    first = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [destination_slot, iterable_slot, first_index["result"]]})
    state = first["state"]
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, one["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    current_count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = current_count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], current_count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [item_slot, iterable_slot, current["result"]]})
    state = item["state"]
    operator = "<"
    if max_mode:
        operator = ">"
    compared = native_direct_append_instruction(state, "direct_slot_binary", "i32", {"args": [compare_slot, item_slot, destination_slot], "operator": operator})
    state = compared["state"]
    replace = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [compare_slot]})
    state = replace["state"]
    replace_block = state["current_block"]
    update_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(replace["result"], update_block, -1))

    state = native_direct_begin_next_block(state)
    updated = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [destination_slot, item_slot]})
    state = updated["state"]
    increment_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
    state = native_direct_patch_branch_false_target(state, replace_block, increment_block)

    state = native_direct_begin_next_block(state)
    increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = increment_current["state"]
    increment_one = native_direct_append_const_int(state, 1, "i32")
    state = increment_one["state"]
    next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], increment_one["result"]]})
    state = next_value["state"]
    next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
    state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_zip_builtin_into_slot(state, expression, destination_slot, path, temporary_depth):
    argument_count = len(expression["args"])
    base_depth = temporary_depth + 1
    snapshots = []
    argument_idx = 0
    while argument_idx < argument_count:
        snapshot_slot = native_direct_value_temporary_offset_slot(state, base_depth, argument_idx, path + ".snapshot[" + str(argument_idx) + "]")
        argument = native_direct_call_argument_value(expression["args"][argument_idx])
        state = native_direct_lower_value_into_slot(state, argument, snapshot_slot, path + ".arg[" + str(argument_idx) + "]", base_depth + native_direct_temporary_groups_for_arguments(argument_count + 3))
        state = native_direct_prepare_iterable(state, snapshot_slot, path + ".arg[" + str(argument_idx) + "].prepare", base_depth + native_direct_temporary_groups_for_arguments(argument_count + 3))
        snapshots = method_append(snapshots, snapshot_slot)
        argument_idx = argument_idx + 1
    cursor_slot = native_direct_value_temporary_offset_slot(state, base_depth, argument_count, path + ".cursor")
    tuple_slot = native_direct_value_temporary_offset_slot(state, base_depth, argument_count + 1, path + ".tuple")
    item_slot = native_direct_value_temporary_offset_slot(state, base_depth, argument_count + 2, path + ".item")
    created = native_direct_append_instruction(state, "direct_slot_collection_new", "slot_ptr", {"args": [destination_slot], "collection_kind": "list", "capacity": 0})
    state = created["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    has_all = -1
    snapshot_idx = 0
    while snapshot_idx < len(snapshots):
        count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [snapshots[snapshot_idx]]})
        state = count["state"]
        has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
        state = has_item["state"]
        if has_all < 0:
            has_all = has_item["result"]
        else:
            combined = native_direct_append_instruction(state, "and_i1", "i1", {"args": [has_all, has_item["result"]]})
            state = combined["state"]
            has_all = combined["result"]
        snapshot_idx = snapshot_idx + 1
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_all, body_block, -1))

    state = native_direct_begin_next_block(state)
    tuple_created = native_direct_append_instruction(state, "direct_slot_collection_new", "slot_ptr", {"args": [tuple_slot], "collection_kind": "list", "capacity": argument_count})
    state = tuple_created["state"]
    snapshot_idx = 0
    while snapshot_idx < len(snapshots):
        item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [item_slot, snapshots[snapshot_idx], current["result"]]})
        state = item["state"]
        tuple_appended = native_direct_append_instruction(state, "direct_collection_append_owned", "i32", {"args": [tuple_slot, item_slot]})
        state = tuple_appended["state"]
        snapshot_idx = snapshot_idx + 1
    appended = native_direct_append_instruction(state, "direct_collection_append_owned", "i32", {"args": [destination_slot, tuple_slot]})
    state = appended["state"]
    increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = increment_current["state"]
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
    state = next_value["state"]
    next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
    state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_enumerate_builtin_into_slot(state, expression, destination_slot, path, temporary_depth):
    base_depth = temporary_depth + 1
    nested_depth = base_depth + native_direct_temporary_groups_for_arguments(5)
    iterable_slot = native_direct_value_temporary_offset_slot(state, base_depth, 0, path + ".iterable")
