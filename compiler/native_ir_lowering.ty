    if kind == "call" and expression["callee"]["kind"] == "var" and native_direct_has_function_plan(state, "" + expression["callee"]["value"]):
        return native_direct_lower_language_call_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "sum":
        return native_direct_lower_sum_builtin_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "min":
        return native_direct_lower_extreme_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, False)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "max":
        return native_direct_lower_extreme_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, True)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "any":
        return native_direct_lower_quantifier_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, False)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "all":
        return native_direct_lower_quantifier_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, True)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "zip":
        return native_direct_lower_zip_builtin_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "enumerate":
        return native_direct_lower_enumerate_builtin_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "sorted":
        return native_direct_lower_sorted_builtin_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and primitive_schema_has("" + expression["callee"]["value"]) and not primitive_schema_direct_source_body("" + expression["callee"]["value"]) and expression["callee"]["value"] != "open" and expression["callee"]["value"] != "len":
        return native_direct_lower_primitive_call_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "argv" and len(expression["args"]) == 0:
        loaded = native_direct_append_instruction(state, "direct_process_argv", "i32", {"args": [destination_slot]})
        return native_direct_require_runtime_success(loaded["state"], loaded["result"], path, temporary_depth + 1)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "open":
        path_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".arg[0]")
        mode_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".arg[1]")
        state = native_direct_lower_value_into_slot(state, expression["args"][0], path_slot, path + ".arg[0]", temporary_depth + 1)
        if len(expression["args"]) == 1:
            state = native_direct_lower_value_into_slot(state, {"kind": "string", "value": "r", "items": []}, mode_slot, path + ".default-mode", temporary_depth + 1)
        else:
            state = native_direct_lower_value_into_slot(state, expression["args"][1], mode_slot, path + ".arg[1]", temporary_depth + 1)
        opened = native_direct_append_instruction(state, "direct_file_open", "i32", {"args": [destination_slot, path_slot, mode_slot]})
        return native_direct_require_runtime_success(opened["state"], opened["result"], path, temporary_depth + 1)
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "len" and len(expression["args"]) == 1:
        argument = expression["args"][0]
        if argument["kind"] == "var":
            # len() observes but does not retain its input. Borrow a bound
            # variable directly so a later mutation does not detach solely
            # because the length check left a frame temporary alive.
            resolved = native_direct_value_slot_for_read(state, argument["value"], path + ".arg[0]")
            state = resolved["state"]
            argument_slot = resolved["slot"]
        else:
            argument_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".arg[0]")
            state = native_direct_lower_value_into_slot(state, argument, argument_slot, path + ".arg[0]", temporary_depth + 1)
        state = native_direct_prepare_iterable(state, argument_slot, path + ".arg[0].prepare", temporary_depth + 1)
        length = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [argument_slot]})
        stored = native_direct_append_instruction(length["state"], "direct_slot_set_int_owned", "slot_ptr", {"args": [destination_slot, length["result"]]})
        return stored["state"]
    if kind == "method_call":
        if len(native_direct_classes_with_method(state, expression["name"])) > 0:
            return native_direct_lower_bound_method_into_slot(state, expression, destination_slot, path, temporary_depth)
        file_method = expression["name"] == "read" or expression["name"] == "write" or expression["name"] == "flush" or expression["name"] == "seek" or expression["name"] == "close"
        if file_method:
            receiver_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".receiver")
            state = native_direct_lower_value_into_slot(state, expression["receiver"], receiver_slot, path + ".receiver", temporary_depth + 1)
            args = [destination_slot, receiver_slot]
            arg_idx = 0
            while arg_idx < len(expression["args"]):
                argument_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, arg_idx + 2, path + ".arg[" + str(arg_idx) + "]")
                state = native_direct_lower_value_into_slot(state, expression["args"][arg_idx], argument_slot, path + ".arg[" + str(arg_idx) + "]", temporary_depth + 1)
                args = method_append(args, argument_slot)
                arg_idx = arg_idx + 1
            if expression["name"] == "seek" and len(expression["args"]) == 1:
                whence_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 3, path + ".default-whence")
                state = native_direct_lower_value_into_slot(state, {"kind": "int", "value": 0, "items": []}, whence_slot, path + ".default-whence", temporary_depth + 1)
                args = method_append(args, whence_slot)
            lowered = native_direct_append_instruction(state, "direct_file_method", "i32", {"args": args, "method": expression["name"]})
            return native_direct_require_runtime_success(lowered["state"], lowered["result"], path, temporary_depth + 1)
        receiver_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".receiver")
        mutates_receiver = expression["name"] == "append" or expression["name"] == "remove" or expression["name"] == "add"
        if mutates_receiver and expression["receiver"]["kind"] == "var":
            receiver_name = expression["receiver"]["value"]
            if not native_direct_name_in_list(state["initialized_locals"], receiver_name):
                fail("direct-native lowering rejected code=local-read-before-assignment;name=" + receiver_name + ";position=" + path + ".receiver")
            receiver_slot = native_direct_local_slot(state, receiver_name)
        else:
            state = native_direct_lower_value_into_slot(state, expression["receiver"], receiver_slot, path + ".receiver", temporary_depth + 1)
        args = [destination_slot, receiver_slot]
        if len(expression["args"]) == 1:
            argument_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".arg[0]")
            state = native_direct_lower_value_into_slot(state, expression["args"][0], argument_slot, path + ".arg[0]", temporary_depth + 1)
            args = method_append(args, argument_slot)
        lowered = native_direct_append_instruction(state, "direct_slot_method", "i32", {"args": args, "method": expression["name"]})
        state = lowered["state"]
        # Indexed and attributed receivers are materialized into a temporary.
        # Mutating that detached value must write it back through the original
        # lvalue chain (for example state["nodes"].append(node)).
        if mutates_receiver and (expression["receiver"]["kind"] == "index" or expression["receiver"]["kind"] == "attr"):
            return native_direct_lower_assignment_target_from_slot(state, expression["receiver"], receiver_slot, path + ".receiver-writeback", temporary_depth + 1)
        return state
    value = native_direct_lower_scalar_expression(state, expression, path)
    if value["type"] != "i32":
        fail("direct-native lowering rejected code=assignment-type-not-lowered;position=" + path)
    operation = "slot_set_int"
    if state["aggregate_core"]:
        operation = "direct_slot_set_int_owned"
    stored = native_direct_append_instruction(value["state"], operation, "slot_ptr", {"args": [destination_slot, value["result"]]})
    return stored["state"]


def native_direct_lower_unpack_assignment(state, statement, path):
    target = statement["target"]
    iterable_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".value")
    state = native_direct_lower_value_into_slot(state, statement["value"], iterable_slot, path + ".value", 1)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".prepare", 1)
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    star_idx = -1
    target_idx = 0
    while target_idx < len(target["targets"]):
        if target["targets"][target_idx]["star"]:
            star_idx = target_idx
        target_idx = target_idx + 1
    required_count = len(target["targets"])
    compare_operation = "eq"
    if star_idx >= 0:
        required_count = required_count - 1
        compare_operation = "ge"
    required = native_direct_append_const_int(state, required_count, "i32")
    state = required["state"]
    size_ok = native_direct_append_instruction(state, compare_operation, "i1", {"args": [count["result"], required["result"]]})
    state = size_ok["state"]
    condition_block = state["current_block"]
    success_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(size_ok["result"], success_block, -1))

    state = native_direct_begin_next_block(state)
    target_idx = 0
    while target_idx < len(target["targets"]):
        unpack_target = target["targets"][target_idx]
        target_slot = native_direct_local_slot(state, unpack_target["name"])
        if unpack_target["star"]:
            start = native_direct_append_const_int(state, target_idx, "i32")
            state = start["state"]
            trailing_count = len(target["targets"]) - target_idx - 1
            stop_result = count["result"]
            if trailing_count > 0:
                trailing = native_direct_append_const_int(state, trailing_count, "i32")
                state = trailing["state"]
                stop = native_direct_append_instruction(state, "sub", "i32", {"args": [count["result"], trailing["result"]]})
                state = stop["state"]
                stop_result = stop["result"]
            copied = native_direct_append_instruction(state, "direct_slot_unpack_star", "i32", {"args": [target_slot, iterable_slot, start["result"], stop_result]})
            state = copied["state"]
        else:
            item_index_result = -1
            if star_idx >= 0 and target_idx > star_idx:
                trailing_count = len(target["targets"]) - target_idx
                trailing = native_direct_append_const_int(state, trailing_count, "i32")
                state = trailing["state"]
                item_index = native_direct_append_instruction(state, "sub", "i32", {"args": [count["result"], trailing["result"]]})
                state = item_index["state"]
                item_index_result = item_index["result"]
            else:
                item_index = native_direct_append_const_int(state, target_idx, "i32")
                state = item_index["state"]
                item_index_result = item_index["result"]
            copied = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, iterable_slot, item_index_result]})
            state = copied["state"]
        state = native_direct_mark_local_initialized(state, unpack_target["name"])
        target_idx = target_idx + 1
    success_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    failure_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, failure_block)
    state = native_direct_begin_next_block(state)
    state = native_direct_append_write_fd(state, 2, "unpack assignment size mismatch\n")
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    state = native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))

    merge_block = state["next_block"]
    state = native_direct_patch_jump_target(state, success_exit, merge_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_return_statement(state, statement, path):
    if not state["is_user_function"]:
        fail("direct-native lowering rejected code=return-outside-function;position=" + path)
    if state["is_generator_resume"]:
        return_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".value")
        state = native_direct_lower_value_into_slot(state, statement["value"], return_slot, path + ".value", 1)
        state = native_direct_run_cleanup_contexts(state, 0, path + ".return")
        if state["terminated"]:
            return state
        finished = native_direct_append_instruction(state, "direct_generator_finish", "i32", {"args": [state["generator_descriptor"]]})
        state = native_direct_release_temporary_slots(finished["state"])
        status = native_direct_append_const_int(state, 1, "i32")
        return native_direct_finish_block(status["state"], native_ir_v2_return(status["result"]))
    state = native_direct_lower_value_into_slot(state, statement["value"], state["result_slot"], path + ".value", 0)
    state = native_direct_run_cleanup_contexts(state, 0, path + ".return")
    if state["terminated"]:
        return state
    status = native_direct_append_const_int(state, 0, "i32")
    state = native_direct_release_frame_slots(status["state"])
    return native_direct_finish_block(state, native_ir_v2_return(status["result"]))


def native_direct_next_exception_control_slot(state, path):
    slot_idx = state["next_exception_control_slot"]
    if slot_idx < 0 or slot_idx >= len(state["exception_control_slots"]):
        fail("direct-native lowering rejected code=exception-control-slot-underflow;position=" + path)
    state["next_exception_control_slot"] = slot_idx + 1
    return {"state": state, "slot": state["exception_control_slots"][slot_idx]}


def native_direct_lower_raise_statement(state, statement, path):
    raised_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".value")
    state = native_direct_lower_value_into_slot(state, statement["value"], raised_slot, path + ".value", 1)
    status = native_direct_append_const_int(state, 1, "i32")
    return native_direct_propagate_exception_slot(status["state"], raised_slot, status["result"], path + ".raise")


def native_direct_lower_yield_statement(state, statement, path):
    if not state["is_generator_resume"]:
