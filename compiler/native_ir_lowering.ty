# Target-neutral direct Native IR lowering. This module is deliberately
# separate from native_ir_source.ty: the latter remains the explicit v1
# static-program oracle until the direct route passes the migration gates.

def native_direct_collect_function_names_into(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "function":
            __tyrion_native_ast_builder_append(names, 0, statement["name"])
            native_direct_collect_function_names_into(statement["body"], names)
        elif statement["kind"] == "class":
            __tyrion_native_ast_builder_append(names, 0, statement["name"])
            member_idx = 0
            while member_idx < len(statement["body"]):
                member = statement["body"][member_idx]
                if member["kind"] == "function":
                    __tyrion_native_ast_builder_append(names, 0, "@method:" + member["name"])
                member_idx = member_idx + 1
        elif statement["kind"] == "assign" and statement["target"]["kind"] == "var" and (statement["value"]["kind"] == "lambda" or statement["value"]["kind"] == "call" or statement["value"]["kind"] == "var"):
            __tyrion_native_ast_builder_append(names, 0, statement["target"]["value"])
        elif statement["kind"] == "if":
            native_direct_collect_function_names_into(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                native_direct_collect_function_names_into(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            native_direct_collect_function_names_into(statement["else_body"], names)
        elif statement["kind"] == "while" or statement["kind"] == "for":
            native_direct_collect_function_names_into(statement["body"], names)
        idx = idx + 1
    return none


def native_direct_function_names(program):
    names = __tyrion_native_ast_builder_create()
    native_direct_collect_function_names_into(program["items"], names)
    name_lists = __tyrion_native_ast_builder_finish(names)
    return name_lists[0]


def native_direct_collect_declared_callable_names_into(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "function":
            __tyrion_native_ast_builder_append(names, 0, statement["name"])
            native_direct_collect_declared_callable_names_into(statement["body"], names)
        elif statement["kind"] == "assign" and statement["target"]["kind"] == "var" and statement["value"]["kind"] == "lambda":
            __tyrion_native_ast_builder_append(names, 0, statement["target"]["value"])
        elif statement["kind"] == "if":
            native_direct_collect_declared_callable_names_into(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                native_direct_collect_declared_callable_names_into(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            native_direct_collect_declared_callable_names_into(statement["else_body"], names)
        elif statement["kind"] == "while" or statement["kind"] == "for":
            native_direct_collect_declared_callable_names_into(statement["body"], names)
        idx = idx + 1
    return none


def native_direct_declared_callable_names(program):
    names = __tyrion_native_ast_builder_create()
    native_direct_collect_declared_callable_names_into(program["items"], names)
    name_lists = __tyrion_native_ast_builder_finish(names)
    return name_lists[0]


def native_direct_analyze(program, target):
    target = backend_require_operation(target, "native-ir-v2-direct")
    application = require_application_analysis(program, native_direct_function_names(program))
    return {"contract": "tyrion-native-direct-analysis-v1", "target": target, "program": program, "application": application}


def native_direct_append_local(locals, name):
    found = False
    local_idx = 0
    while local_idx < len(locals):
        if locals[local_idx]["name"] == name:
            found = True
        local_idx = local_idx + 1
    if not found:
        locals = method_append(locals, {"id": len(locals), "name": name, "kind": "value_slot"})
    return locals


def native_direct_collect_expression_locals(expression, locals):
    kind = expression["kind"]
    if kind == "comprehension":
        locals = native_direct_append_local(locals, expression["target"])
        locals = native_direct_collect_expression_locals(expression["iterable"], locals)
        locals = native_direct_collect_expression_locals(expression["condition"], locals)
        if expression["out_kind"] == "list":
            return native_direct_collect_expression_locals(expression["expr"], locals)
        locals = native_direct_collect_expression_locals(expression["key"], locals)
        return native_direct_collect_expression_locals(expression["value"], locals)
    if kind == "binary":
        locals = native_direct_collect_expression_locals(expression["left"], locals)
        return native_direct_collect_expression_locals(expression["right"], locals)
    if kind == "unary" or kind == "kwarg":
        return native_direct_collect_expression_locals(expression["value"], locals)
    if kind == "call":
        locals = native_direct_collect_expression_locals(expression["callee"], locals)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            locals = native_direct_collect_expression_locals(expression["args"][arg_idx], locals)
            arg_idx = arg_idx + 1
        return locals
    if kind == "method_call":
        locals = native_direct_collect_expression_locals(expression["receiver"], locals)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            locals = native_direct_collect_expression_locals(expression["args"][arg_idx], locals)
            arg_idx = arg_idx + 1
        return locals
    if kind == "index":
        locals = native_direct_collect_expression_locals(expression["receiver"], locals)
        return native_direct_collect_expression_locals(expression["index"], locals)
    if kind == "slice":
        locals = native_direct_collect_expression_locals(expression["receiver"], locals)
        locals = native_direct_collect_expression_locals(expression["start"], locals)
        return native_direct_collect_expression_locals(expression["stop"], locals)
    if kind == "attr":
        return native_direct_collect_expression_locals(expression["receiver"], locals)
    if kind == "list" or kind == "tuple" or kind == "set":
        item_idx = 0
        while item_idx < len(expression["items"]):
            locals = native_direct_collect_expression_locals(expression["items"][item_idx], locals)
            item_idx = item_idx + 1
        return locals
    if kind == "dict":
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            locals = native_direct_collect_expression_locals(expression["entries"][entry_idx]["key"], locals)
            locals = native_direct_collect_expression_locals(expression["entries"][entry_idx]["value"], locals)
            entry_idx = entry_idx + 1
    return locals


def native_direct_collect_statement_locals(items, locals):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        kind = statement["kind"]
        if kind == "assign":
            locals = native_direct_collect_expression_locals(statement["value"], locals)
            target = statement["target"]
            if target["kind"] == "index":
                locals = native_direct_collect_expression_locals(target["receiver"], locals)
                locals = native_direct_collect_expression_locals(target["index"], locals)
            elif target["kind"] == "attr":
                locals = native_direct_collect_expression_locals(target["receiver"], locals)
        elif kind == "expr" or kind == "return" or kind == "raise" or kind == "yield":
            locals = native_direct_collect_expression_locals(statement["value"], locals)
        elif kind == "if" or kind == "while":
            locals = native_direct_collect_expression_locals(statement["condition"], locals)
        elif kind == "for":
            locals = native_direct_collect_expression_locals(statement["iterable"], locals)
        elif kind == "with":
            locals = native_direct_collect_expression_locals(statement["resource"], locals)
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            locals = native_direct_append_local(locals, statement["target"]["value"])
        elif statement["kind"] == "assign" and statement["target"]["kind"] == "unpack":
            target_idx = 0
            while target_idx < len(statement["target"]["targets"]):
                locals = native_direct_append_local(locals, statement["target"]["targets"][target_idx]["name"])
                target_idx = target_idx + 1
        elif statement["kind"] == "if":
            locals = native_direct_collect_statement_locals(statement["body"], locals)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                locals = native_direct_collect_statement_locals(statement["elifs"][branch_idx]["body"], locals)
                branch_idx = branch_idx + 1
            locals = native_direct_collect_statement_locals(statement["else_body"], locals)
        elif statement["kind"] == "while":
            locals = native_direct_collect_statement_locals(statement["body"], locals)
        elif statement["kind"] == "for":
            target_idx = 0
            while target_idx < len(statement["targets"]):
                locals = native_direct_append_local(locals, statement["targets"][target_idx])
                target_idx = target_idx + 1
            locals = native_direct_collect_statement_locals(statement["body"], locals)
        elif statement["kind"] == "with":
            locals = native_direct_append_local(locals, statement["name"])
            locals = native_direct_collect_statement_locals(statement["body"], locals)
        elif statement["kind"] == "try":
            if statement["except_binding"] != "":
                locals = native_direct_append_local(locals, statement["except_binding"])
            locals = native_direct_collect_statement_locals(statement["body"], locals)
            locals = native_direct_collect_statement_locals(statement["except_body"], locals)
            locals = native_direct_collect_statement_locals(statement["finally_body"], locals)
        idx = idx + 1
    return locals


def native_direct_collect_locals(program):
    return native_direct_collect_statement_locals(program["items"], [])


def native_direct_collect_scope_locals(items, parameters, captures):
    locals = []
    capture_idx = 0
    while capture_idx < len(captures):
        locals = native_direct_append_local(locals, captures[capture_idx])
        capture_idx = capture_idx + 1
    parameter_idx = 0
    while parameter_idx < len(parameters):
        locals = native_direct_append_local(locals, parameters[parameter_idx]["name"])
        parameter_idx = parameter_idx + 1
    return native_direct_collect_statement_locals(items, locals)


def native_direct_executable_program_items(program):
    executable = []
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] != "function" and statement["kind"] != "class":
            # Declarations have no top-level runtime effect. Do not retain one
            # placeholder record per declaration in the executable stream;
            # large compiler module graphs otherwise keep hundreds of dead AST
            # records alive merely to preserve diagnostic indices. Original
            # source positions live in a compact parallel integer vector.
            executable = method_append(executable, statement)
        idx = idx + 1
    return executable


def native_direct_executable_program_source_indices(program):
    indices = []
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] != "function" and statement["kind"] != "class":
            indices = method_append(indices, idx)
        idx = idx + 1
    return indices


def native_direct_function_symbol(function_id):
    return "__tyrion_direct_fn_" + str(function_id)


def native_direct_statements_have_yield(items):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        kind = statement["kind"]
        if kind == "yield":
            return True
        if kind == "if":
            if native_direct_statements_have_yield(statement["body"]):
                return True
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                if native_direct_statements_have_yield(statement["elifs"][branch_idx]["body"]):
                    return True
                branch_idx = branch_idx + 1
            if native_direct_statements_have_yield(statement["else_body"]):
                return True
        elif kind == "while" or kind == "for" or kind == "with":
            if native_direct_statements_have_yield(statement["body"]):
                return True
        elif kind == "try":
            if native_direct_statements_have_yield(statement["body"]):
                return True
            if native_direct_statements_have_yield(statement["except_body"]):
                return True
            if native_direct_statements_have_yield(statement["finally_body"]):
                return True
        # Nested function and class bodies define different callable scopes.
        idx = idx + 1
    return False


def native_direct_statement_yield_count(items):
    count = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        kind = statement["kind"]
        if kind == "yield":
            count = count + 1
        elif kind == "if":
            count = count + native_direct_statement_yield_count(statement["body"])
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                count = count + native_direct_statement_yield_count(statement["elifs"][branch_idx]["body"])
                branch_idx = branch_idx + 1
            count = count + native_direct_statement_yield_count(statement["else_body"])
        elif kind == "while" or kind == "for" or kind == "with":
            count = count + native_direct_statement_yield_count(statement["body"])
        elif kind == "try":
            count = count + native_direct_statement_yield_count(statement["body"])
            count = count + native_direct_statement_yield_count(statement["except_body"])
            count = count + native_direct_statement_yield_count(statement["finally_body"])
        idx = idx + 1
    return count


def native_direct_collect_lambda_captures(expression, parameters, function_names, captures):
    kind = expression["kind"]
    if kind == "var":
        name = expression["value"]
        if not native_direct_name_in_list(parameters, name) and not application_name_index_present(function_names, name) and not application_direct_builtin_supported(name):
            captures = native_direct_append_unique_name(captures, name)
        return captures
    if kind == "binary":
        captures = native_direct_collect_lambda_captures(expression["left"], parameters, function_names, captures)
        return native_direct_collect_lambda_captures(expression["right"], parameters, function_names, captures)
    if kind == "unary" or kind == "kwarg":
        return native_direct_collect_lambda_captures(expression["value"], parameters, function_names, captures)
    if kind == "call":
        captures = native_direct_collect_lambda_captures(expression["callee"], parameters, function_names, captures)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            captures = native_direct_collect_lambda_captures(expression["args"][arg_idx], parameters, function_names, captures)
            arg_idx = arg_idx + 1
        return captures
    if kind == "method_call":
        captures = native_direct_collect_lambda_captures(expression["receiver"], parameters, function_names, captures)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            captures = native_direct_collect_lambda_captures(expression["args"][arg_idx], parameters, function_names, captures)
            arg_idx = arg_idx + 1
        return captures
    if kind == "index":
        captures = native_direct_collect_lambda_captures(expression["receiver"], parameters, function_names, captures)
        return native_direct_collect_lambda_captures(expression["index"], parameters, function_names, captures)
    if kind == "slice":
        captures = native_direct_collect_lambda_captures(expression["receiver"], parameters, function_names, captures)
        captures = native_direct_collect_lambda_captures(expression["start"], parameters, function_names, captures)
        return native_direct_collect_lambda_captures(expression["stop"], parameters, function_names, captures)
    if kind == "attr":
        return native_direct_collect_lambda_captures(expression["receiver"], parameters, function_names, captures)
    if kind == "list" or kind == "tuple" or kind == "set":
        item_idx = 0
        while item_idx < len(expression["items"]):
            captures = native_direct_collect_lambda_captures(expression["items"][item_idx], parameters, function_names, captures)
            item_idx = item_idx + 1
        return captures
    if kind == "dict":
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            captures = native_direct_collect_lambda_captures(expression["entries"][entry_idx]["key"], parameters, function_names, captures)
            captures = native_direct_collect_lambda_captures(expression["entries"][entry_idx]["value"], parameters, function_names, captures)
            entry_idx = entry_idx + 1
        return captures
    if kind == "comprehension":
        nested_parameters = native_direct_append_unique_name(parameters, expression["target"])
        captures = native_direct_collect_lambda_captures(expression["iterable"], parameters, function_names, captures)
        captures = native_direct_collect_lambda_captures(expression["condition"], nested_parameters, function_names, captures)
        if expression["out_kind"] == "list":
            return native_direct_collect_lambda_captures(expression["expr"], nested_parameters, function_names, captures)
        captures = native_direct_collect_lambda_captures(expression["key"], nested_parameters, function_names, captures)
        return native_direct_collect_lambda_captures(expression["value"], nested_parameters, function_names, captures)
    return captures


def native_direct_append_lambda_plan(plans, expression, path, scope_id, binding_name, function_names):
    function_id = __tyrion_native_ast_builder_len(plans, 0) + 1
    lambda_parameters = []
    parameter_names = []
    parameter_idx = 0
    while parameter_idx < len(expression["params"]):
        parameter_name = expression["params"][parameter_idx]
        parameter_names = method_append(parameter_names, parameter_name)
        lambda_parameters = method_append(lambda_parameters, ast_parameter(parameter_name, False, ast_value("none", none)))
        parameter_idx = parameter_idx + 1
    captures = native_direct_collect_lambda_captures(expression["body"], parameter_names, function_names, [])
    source_name = binding_name
    if source_name == "":
        source_name = "@lambda:" + path
    lambda_body = [ast_return(expression["body"])]
    __tyrion_native_ast_builder_append(plans, 0, {"id": function_id, "source_name": source_name, "symbol": native_direct_function_symbol(function_id), "parameters": lambda_parameters, "body": lambda_body, "callable_kind": "lambda", "scope_id": scope_id, "definition_path": path, "captures": captures, "class_id": 0, "method_name": "", "is_generator": False})
    return plans


def native_direct_collect_expression_lambda_plans(plans, expression, path, scope_id, binding_name, function_names):
    kind = expression["kind"]
    if kind == "lambda":
        return native_direct_append_lambda_plan(plans, expression, path, scope_id, binding_name, function_names)
    if kind == "binary":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["left"], path + ".left", scope_id, "", function_names)
        return native_direct_collect_expression_lambda_plans(plans, expression["right"], path + ".right", scope_id, "", function_names)
    if kind == "unary" or kind == "kwarg":
        return native_direct_collect_expression_lambda_plans(plans, expression["value"], path + ".value", scope_id, "", function_names)
    if kind == "call":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["callee"], path + ".callee", scope_id, "", function_names)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            plans = native_direct_collect_expression_lambda_plans(plans, expression["args"][arg_idx], path + ".arg[" + str(arg_idx) + "]", scope_id, "", function_names)
            arg_idx = arg_idx + 1
        return plans
    if kind == "method_call":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["receiver"], path + ".receiver", scope_id, "", function_names)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            plans = native_direct_collect_expression_lambda_plans(plans, expression["args"][arg_idx], path + ".arg[" + str(arg_idx) + "]", scope_id, "", function_names)
            arg_idx = arg_idx + 1
        return plans
    if kind == "index":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["receiver"], path + ".receiver", scope_id, "", function_names)
        return native_direct_collect_expression_lambda_plans(plans, expression["index"], path + ".index", scope_id, "", function_names)
    if kind == "slice":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["receiver"], path + ".receiver", scope_id, "", function_names)
        plans = native_direct_collect_expression_lambda_plans(plans, expression["start"], path + ".start", scope_id, "", function_names)
        return native_direct_collect_expression_lambda_plans(plans, expression["stop"], path + ".stop", scope_id, "", function_names)
    if kind == "attr":
        return native_direct_collect_expression_lambda_plans(plans, expression["receiver"], path + ".receiver", scope_id, "", function_names)
    if kind == "list" or kind == "tuple" or kind == "set":
        item_idx = 0
        while item_idx < len(expression["items"]):
            plans = native_direct_collect_expression_lambda_plans(plans, expression["items"][item_idx], path + ".item[" + str(item_idx) + "]", scope_id, "", function_names)
            item_idx = item_idx + 1
        return plans
    if kind == "dict":
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            plans = native_direct_collect_expression_lambda_plans(plans, expression["entries"][entry_idx]["key"], path + ".entry[" + str(entry_idx) + "].key", scope_id, "", function_names)
            plans = native_direct_collect_expression_lambda_plans(plans, expression["entries"][entry_idx]["value"], path + ".entry[" + str(entry_idx) + "].value", scope_id, "", function_names)
            entry_idx = entry_idx + 1
        return plans
    if kind == "comprehension":
        plans = native_direct_collect_expression_lambda_plans(plans, expression["iterable"], path + ".iterable", scope_id, "", function_names)
        plans = native_direct_collect_expression_lambda_plans(plans, expression["condition"], path + ".condition", scope_id, "", function_names)
        if expression["out_kind"] == "list":
            return native_direct_collect_expression_lambda_plans(plans, expression["expr"], path + ".expr", scope_id, "", function_names)
        plans = native_direct_collect_expression_lambda_plans(plans, expression["key"], path + ".key", scope_id, "", function_names)
        return native_direct_collect_expression_lambda_plans(plans, expression["value"], path + ".value", scope_id, "", function_names)
    return plans


def native_direct_collect_statement_lambda_plans(plans, items, path, scope_id, function_names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        statement_path = path + "[" + str(idx) + "]"
        if statement["kind"] == "assign":
            binding_name = ""
            if statement["target"]["kind"] == "var":
                binding_name = statement["target"]["value"]
            plans = native_direct_collect_expression_lambda_plans(plans, statement["value"], statement_path + ".value", scope_id, binding_name, function_names)
        elif statement["kind"] == "expr" or statement["kind"] == "return" or statement["kind"] == "raise" or statement["kind"] == "yield":
            plans = native_direct_collect_expression_lambda_plans(plans, statement["value"], statement_path + ".value", scope_id, "", function_names)
        elif statement["kind"] == "if":
            plans = native_direct_collect_expression_lambda_plans(plans, statement["condition"], statement_path + ".condition", scope_id, "", function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["body"], statement_path + ".if", scope_id, function_names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                plans = native_direct_collect_expression_lambda_plans(plans, statement["elifs"][branch_idx]["condition"], statement_path + ".elif[" + str(branch_idx) + "].condition", scope_id, "", function_names)
                plans = native_direct_collect_statement_lambda_plans(plans, statement["elifs"][branch_idx]["body"], statement_path + ".elif[" + str(branch_idx) + "]", scope_id, function_names)
                branch_idx = branch_idx + 1
            plans = native_direct_collect_statement_lambda_plans(plans, statement["else_body"], statement_path + ".else", scope_id, function_names)
        elif statement["kind"] == "while":
            plans = native_direct_collect_expression_lambda_plans(plans, statement["condition"], statement_path + ".condition", scope_id, "", function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["body"], statement_path + ".body", scope_id, function_names)
        elif statement["kind"] == "for":
            plans = native_direct_collect_expression_lambda_plans(plans, statement["iterable"], statement_path + ".iterable", scope_id, "", function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["body"], statement_path + ".body", scope_id, function_names)
        elif statement["kind"] == "with":
            plans = native_direct_collect_expression_lambda_plans(plans, statement["resource"], statement_path + ".resource", scope_id, "", function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["body"], statement_path + ".body", scope_id, function_names)
        elif statement["kind"] == "try":
            plans = native_direct_collect_statement_lambda_plans(plans, statement["body"], statement_path + ".body", scope_id, function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["except_body"], statement_path + ".except", scope_id, function_names)
            plans = native_direct_collect_statement_lambda_plans(plans, statement["finally_body"], statement_path + ".finally", scope_id, function_names)
        idx = idx + 1
    return plans


def native_direct_function_plans(program):
    plans = __tyrion_native_ast_builder_create()
    function_names = native_direct_declared_callable_names(program)
    global_locals = native_direct_collect_locals(program)
    global_idx = 0
    while global_idx < len(global_locals):
        function_names = native_direct_append_unique_name(function_names, global_locals[global_idx]["name"])
        global_idx = global_idx + 1
    function_names = application_name_index(function_names)
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] == "function":
            function_id = __tyrion_native_ast_builder_len(plans, 0) + 1
            __tyrion_native_ast_builder_append(plans, 0, {"id": function_id, "source_name": statement["name"], "symbol": native_direct_function_symbol(function_id), "parameters": statement["params"], "body": statement["body"], "callable_kind": "function", "scope_id": 0, "definition_path": "program[" + str(idx) + "]", "captures": [], "class_id": 0, "method_name": "", "is_generator": native_direct_statements_have_yield(statement["body"])})
        idx = idx + 1
    class_id = 1
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] == "class":
            member_idx = 0
            while member_idx < len(statement["body"]):
                member = statement["body"][member_idx]
                if member["kind"] == "function":
                    function_id = __tyrion_native_ast_builder_len(plans, 0) + 1
                    source_name = "@method:" + statement["name"] + "." + member["name"]
                    __tyrion_native_ast_builder_append(plans, 0, {"id": function_id, "source_name": source_name, "symbol": native_direct_function_symbol(function_id), "parameters": member["params"], "body": member["body"], "callable_kind": "method", "scope_id": 0, "definition_path": "program[" + str(idx) + "].class[" + str(member_idx) + "]", "captures": [], "class_id": class_id, "method_name": member["name"], "is_generator": native_direct_statements_have_yield(member["body"])})
                member_idx = member_idx + 1
            class_id = class_id + 1
        idx = idx + 1
    plans = native_direct_collect_statement_lambda_plans(plans, program["items"], "program", 0, function_names)
    scan_idx = 0
    while scan_idx < __tyrion_native_ast_builder_len(plans, 0):
        plan = __tyrion_native_ast_builder_get(plans, 0, scan_idx)
        plans = native_direct_collect_statement_lambda_plans(plans, plan["body"], "function." + plan["source_name"], plan["id"], function_names)
        scan_idx = scan_idx + 1
    plan_count = __tyrion_native_ast_builder_len(plans, 0)
    next_resume_id = plan_count + 1
    annotated = __tyrion_native_ast_builder_create()
    plan_idx = 0
    while plan_idx < plan_count:
        plan = __tyrion_native_ast_builder_get(plans, 0, plan_idx)
        resume_id = 0
        resume_symbol = ""
        if plan["is_generator"]:
            resume_id = next_resume_id
            resume_symbol = native_direct_function_symbol(next_resume_id) + "_resume"
            next_resume_id = next_resume_id + 1
        annotated_plan = {}
        annotated_plan["id"] = plan["id"]
        annotated_plan["source_name"] = plan["source_name"]
        annotated_plan["symbol"] = plan["symbol"]
        annotated_plan["parameters"] = plan["parameters"]
        annotated_plan["body"] = plan["body"]
        annotated_plan["callable_kind"] = plan["callable_kind"]
        annotated_plan["scope_id"] = plan["scope_id"]
        annotated_plan["definition_path"] = plan["definition_path"]
        annotated_plan["captures"] = plan["captures"]
        annotated_plan["class_id"] = plan["class_id"]
        annotated_plan["method_name"] = plan["method_name"]
        annotated_plan["is_generator"] = plan["is_generator"]
        annotated_plan["yield_count"] = native_direct_statement_yield_count(plan["body"])
        annotated_plan["resume_id"] = resume_id
        annotated_plan["resume_symbol"] = resume_symbol
        __tyrion_native_ast_builder_append(annotated, 0, annotated_plan)
        plan_idx = plan_idx + 1
    annotated_lists = __tyrion_native_ast_builder_finish(annotated)
    return annotated_lists[0]


def native_direct_reachable_state(function_count, class_count):
    seen = range(function_count + 1)
    address_taken_seen = range(function_count + 1)
    idx = 0
    while idx < len(seen):
        seen[idx] = 0
        address_taken_seen[idx] = 0
        idx = idx + 1
    class_seen = range(class_count + 1)
    class_idx = 0
    while class_idx < len(class_seen):
        class_seen[class_idx] = 0
        class_idx = class_idx + 1
    return {"ids": __tyrion_native_ast_builder_create(), "seen": seen, "address_taken_ids": __tyrion_native_ast_builder_create(), "address_taken_seen": address_taken_seen, "class_ids": __tyrion_native_ast_builder_create(), "class_seen": class_seen}


def native_direct_reachable_append(ids, function_id):
    if function_id <= 0 or function_id >= len(ids["seen"]):
        return ids
    seen = ids["seen"]
    if seen[function_id] != 0:
        return ids
    seen[function_id] = 1
    ids["seen"] = seen
    __tyrion_native_ast_builder_append(ids["ids"], 0, function_id)
    return ids


def native_direct_address_taken_append(ids, function_id):
    if function_id <= 0 or function_id >= len(ids["address_taken_seen"]):
        return ids
    seen = ids["address_taken_seen"]
    if seen[function_id] != 0:
        return ids
    seen[function_id] = 1
    ids["address_taken_seen"] = seen
    __tyrion_native_ast_builder_append(ids["address_taken_ids"], 0, function_id)
    return ids


def native_direct_reachable_class_append(ids, class_id):
    if class_id <= 0 or class_id >= len(ids["class_seen"]):
        return ids
    seen = ids["class_seen"]
    if seen[class_id] != 0:
        return ids
    seen[class_id] = 1
    ids["class_seen"] = seen
    __tyrion_native_ast_builder_append(ids["class_ids"], 0, class_id)
    return ids


def native_direct_reachability_char_band(ch):
    if ch < "0":
        return 1
    if ch < "A":
        return 2
    if ch < "G":
        return 3
    if ch < "M":
        return 4
    if ch < "S":
        return 5
    if ch < "Y":
        return 6
    if ch < "a":
        return 7
    if ch < "g":
        return 8
    if ch < "m":
        return 9
    if ch < "s":
        return 10
    if ch < "y":
        return 11
    return 12


def native_direct_reachability_hash(name, entry_kind, scope_id):
    modulus = 8191
    length = len(name)
    value = (entry_kind * 257 + (scope_id % modulus) * 17 + length) % modulus
    if length > 0:
        value = (value * 17 + native_direct_reachability_char_band(name[0])) % modulus
        value = (value * 17 + native_direct_reachability_char_band(name[length - 1])) % modulus
    if length > 2:
        value = (value * 17 + native_direct_reachability_char_band(name[1])) % modulus
        value = (value * 17 + native_direct_reachability_char_band(name[length - 2])) % modulus
    return value


def native_direct_reachability_index_append(entries, heads, name, entry_kind, scope_id, value):
    bucket = native_direct_reachability_hash(name, entry_kind, scope_id)
    __tyrion_native_ast_builder_append(entries, 0, {"kind": heads[bucket], "text": name, "line": entry_kind, "column": scope_id, "value": value})
    heads[bucket] = __tyrion_native_ast_builder_len(entries, 0)
    return heads


def native_direct_reachability_index(function_plans, class_plans):
    heads = range(8192)
    head_idx = 0
    while head_idx < len(heads):
        heads[head_idx] = 0
        head_idx = head_idx + 1
    entries = __tyrion_native_ast_builder_create()
    lambda_ids = []
    function_idx = 0
    while function_idx < len(function_plans):
        plan = function_plans[function_idx]
        heads = native_direct_reachability_index_append(entries, heads, plan["source_name"], 1, plan["scope_id"], plan["id"])
        if plan["callable_kind"] == "lambda":
            heads = native_direct_reachability_index_append(entries, heads, plan["definition_path"], 2, 0, plan["id"])
            lambda_ids = method_append(lambda_ids, plan["id"])
        if plan["class_id"] > 0:
            heads = native_direct_reachability_index_append(entries, heads, plan["method_name"], 4, 0, plan["id"])
            heads = native_direct_reachability_index_append(entries, heads, plan["method_name"], 5, plan["class_id"], plan["id"])
        function_idx = function_idx + 1
    class_idx = 0
    while class_idx < len(class_plans):
        heads = native_direct_reachability_index_append(entries, heads, class_plans[class_idx]["name"], 3, 0, class_plans[class_idx]["id"])
        class_idx = class_idx + 1
    return {"entries": entries, "heads": heads, "function_plans": function_plans, "class_plans": class_plans, "lambda_ids": lambda_ids}


def native_direct_reachability_index_first(index, name, entry_kind, scope_id):
    bucket = native_direct_reachability_hash(name, entry_kind, scope_id)
    cursor = index["heads"][bucket]
    while cursor > 0:
        entry = __tyrion_native_ast_builder_get(index["entries"], 0, cursor - 1)
        if entry["line"] == entry_kind and entry["column"] == scope_id and entry["text"] == name:
            return entry["value"]
        cursor = entry["kind"]
    return 0


def native_direct_reachability_index_all(ids, index, name, entry_kind, scope_id):
    bucket = native_direct_reachability_hash(name, entry_kind, scope_id)
    cursor = index["heads"][bucket]
    while cursor > 0:
        entry = __tyrion_native_ast_builder_get(index["entries"], 0, cursor - 1)
        if entry["line"] == entry_kind and entry["column"] == scope_id and entry["text"] == name:
            ids = native_direct_reachable_append(ids, entry["value"])
        cursor = entry["kind"]
    return ids


def native_direct_reachable_named_function_id(reachability, name, scope_id):
    if primitive_schema_has(name) and not primitive_schema_direct_source_body(name):
        return 0
    function_id = native_direct_reachability_index_first(reachability, name, 1, scope_id)
    if function_id == 0 and scope_id != 0:
        function_id = native_direct_reachability_index_first(reachability, name, 1, 0)
    return function_id


def native_direct_reachable_lambda_id(reachability, path):
    return native_direct_reachability_index_first(reachability, path, 2, 0)


def native_direct_reachable_class_id(reachability, name):
    return native_direct_reachability_index_first(reachability, name, 3, 0)


def native_direct_reachable_class_method_ids(ids, reachability, class_id, method_name):
    ids = native_direct_reachable_class_append(ids, class_id)
    return native_direct_reachability_index_all(ids, reachability, method_name, 5, class_id)


def native_direct_reachable_method_ids(ids, reachability, method_name):
    bucket = native_direct_reachability_hash(method_name, 4, 0)
    cursor = reachability["heads"][bucket]
    while cursor > 0:
        entry = __tyrion_native_ast_builder_get(reachability["entries"], 0, cursor - 1)
        if entry["line"] == 4 and entry["column"] == 0 and entry["text"] == method_name:
            ids = native_direct_reachable_append(ids, entry["value"])
            function_plan = native_direct_function_plan_by_id(reachability["function_plans"], entry["value"])
            ids = native_direct_reachable_class_append(ids, function_plan["class_id"])
        cursor = entry["kind"]
    return ids


def native_direct_root_manifest(target):
    target = target_validate(target)
    primitive_roots = ["read_text_file", "write_text_file", "run_tool", "run_tool_capture", "writer_open", "writer_append", "writer_close", "writer_bytes", "writer_set_backend", "writer_is_x86", "ast_builder_create", "ast_builder_len", "ast_builder_append", "ast_builder_finish", "ast_builder_get", "token_builder_count", "token_builder_append", "token_builder_field"]
    runtime_roots = ["scalar-core", "aggregate-core", "file", "process", "writer", "ast-builder"]
    return {"contract": "tyrion-native-direct-roots-v1", "target_backend": target["backend"], "target_specialized": True, "report_unhandled_exception": True, "entry_roots": ["main"], "address_taken_roots": [], "primitive_roots": primitive_roots, "runtime_roots": runtime_roots}


def native_direct_collect_reachable_expression(ids, expression, path, scope_id, reachability):
    kind = expression["kind"]
    if kind == "lambda":
        function_id = native_direct_reachable_lambda_id(reachability, path)
        ids = native_direct_reachable_append(ids, function_id)
        return native_direct_address_taken_append(ids, function_id)
    if kind == "var":
        function_id = native_direct_reachable_named_function_id(reachability, expression["value"], scope_id)
        ids = native_direct_reachable_append(ids, function_id)
        return native_direct_address_taken_append(ids, function_id)
    if kind == "binary":
        ids = native_direct_collect_reachable_expression(ids, expression["left"], path + ".left", scope_id, reachability)
        return native_direct_collect_reachable_expression(ids, expression["right"], path + ".right", scope_id, reachability)
    if kind == "unary" or kind == "kwarg":
        return native_direct_collect_reachable_expression(ids, expression["value"], path + ".value", scope_id, reachability)
    if kind == "call":
        if expression["callee"]["kind"] == "var":
            name = expression["callee"]["value"]
            class_id = native_direct_reachable_class_id(reachability, name)
            if class_id > 0:
                ids = native_direct_reachable_class_method_ids(ids, reachability, class_id, "__init__")
            else:
                ids = native_direct_reachable_append(ids, native_direct_reachable_named_function_id(reachability, name, scope_id))
        else:
            ids = native_direct_collect_reachable_expression(ids, expression["callee"], path + ".callee", scope_id, reachability)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            ids = native_direct_collect_reachable_expression(ids, expression["args"][arg_idx], path + ".arg[" + str(arg_idx) + "]", scope_id, reachability)
            arg_idx = arg_idx + 1
        return ids
    if kind == "method_call":
        ids = native_direct_reachable_method_ids(ids, reachability, expression["name"])
        ids = native_direct_collect_reachable_expression(ids, expression["receiver"], path + ".receiver", scope_id, reachability)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            ids = native_direct_collect_reachable_expression(ids, expression["args"][arg_idx], path + ".arg[" + str(arg_idx) + "]", scope_id, reachability)
            arg_idx = arg_idx + 1
        return ids
    if kind == "index":
        ids = native_direct_collect_reachable_expression(ids, expression["receiver"], path + ".receiver", scope_id, reachability)
        return native_direct_collect_reachable_expression(ids, expression["index"], path + ".index", scope_id, reachability)
    if kind == "slice":
        ids = native_direct_collect_reachable_expression(ids, expression["receiver"], path + ".receiver", scope_id, reachability)
        ids = native_direct_collect_reachable_expression(ids, expression["start"], path + ".start", scope_id, reachability)
        return native_direct_collect_reachable_expression(ids, expression["stop"], path + ".stop", scope_id, reachability)
    if kind == "attr":
        return native_direct_collect_reachable_expression(ids, expression["receiver"], path + ".receiver", scope_id, reachability)
    if kind == "list" or kind == "tuple" or kind == "set":
        item_idx = 0
        while item_idx < len(expression["items"]):
            ids = native_direct_collect_reachable_expression(ids, expression["items"][item_idx], path + ".item[" + str(item_idx) + "]", scope_id, reachability)
            item_idx = item_idx + 1
        return ids
    if kind == "dict":
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            ids = native_direct_collect_reachable_expression(ids, expression["entries"][entry_idx]["key"], path + ".entry[" + str(entry_idx) + "].key", scope_id, reachability)
            ids = native_direct_collect_reachable_expression(ids, expression["entries"][entry_idx]["value"], path + ".entry[" + str(entry_idx) + "].value", scope_id, reachability)
            entry_idx = entry_idx + 1
        return ids
    if kind == "comprehension":
        ids = native_direct_collect_reachable_expression(ids, expression["iterable"], path + ".iterable", scope_id, reachability)
        ids = native_direct_collect_reachable_expression(ids, expression["condition"], path + ".condition", scope_id, reachability)
        if expression["out_kind"] == "list":
            return native_direct_collect_reachable_expression(ids, expression["expr"], path + ".expr", scope_id, reachability)
        ids = native_direct_collect_reachable_expression(ids, expression["key"], path + ".key", scope_id, reachability)
        return native_direct_collect_reachable_expression(ids, expression["value"], path + ".value", scope_id, reachability)
    return ids


def native_direct_collect_reachable_target(ids, target, path, scope_id, reachability):
    if target["kind"] == "index":
        ids = native_direct_collect_reachable_expression(ids, target["receiver"], path + ".receiver", scope_id, reachability)
        return native_direct_collect_reachable_expression(ids, target["index"], path + ".index", scope_id, reachability)
    if target["kind"] == "attr":
        return native_direct_collect_reachable_expression(ids, target["receiver"], path + ".receiver", scope_id, reachability)
    return ids


def native_direct_target_field_expression(expression):
    if expression["kind"] != "index":
        return ""
    receiver = expression["receiver"]
    if receiver["kind"] != "call":
        return ""
    if receiver["callee"]["kind"] != "var" or receiver["callee"]["value"] != "host_target" or len(receiver["args"]) != 0:
        return ""
    index = expression["index"]
    if index["kind"] != "string":
        return ""
    if index["value"] == "backend" or index["value"] == "os" or index["value"] == "arch":
        return index["value"]
    return ""


def native_direct_target_condition_value(expression, target, specialize_target):
    if not specialize_target:
        return -1
    if expression["kind"] != "binary":
        return -1
    if expression["op"] != "==" and expression["op"] != "!=":
        return -1
    field = native_direct_target_field_expression(expression["left"])
    literal = expression["right"]
    if field == "":
        field = native_direct_target_field_expression(expression["right"])
        literal = expression["left"]
    if field == "" or literal["kind"] != "string":
        return -1
    matches = target[field] == literal["value"]
    if expression["op"] == "!=":
        matches = not matches
    if matches:
        return 1
    return 0


def native_direct_collect_reachable_statements(ids, items, path, scope_id, reachability, target, specialize_target, source_indices):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        source_index = idx
        if idx < len(source_indices):
            source_index = source_indices[idx]
        statement_path = path + "[" + str(source_index) + "]"
        kind = statement["kind"]
        if kind == "assign":
            ids = native_direct_collect_reachable_expression(ids, statement["value"], statement_path + ".value", scope_id, reachability)
            ids = native_direct_collect_reachable_target(ids, statement["target"], statement_path + ".target", scope_id, reachability)
        elif kind == "expr" or kind == "return" or kind == "raise" or kind == "yield":
            ids = native_direct_collect_reachable_expression(ids, statement["value"], statement_path + ".value", scope_id, reachability)
        elif kind == "if":
            ids = native_direct_collect_reachable_expression(ids, statement["condition"], statement_path + ".condition", scope_id, reachability)
            target_condition = native_direct_target_condition_value(statement["condition"], target, specialize_target)
            if target_condition == 1:
                ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".if", scope_id, reachability, target, specialize_target, [])
            elif target_condition == 0 and len(statement["elifs"]) == 0:
                ids = native_direct_collect_reachable_statements(ids, statement["else_body"], statement_path + ".else", scope_id, reachability, target, specialize_target, [])
            else:
                ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".if", scope_id, reachability, target, specialize_target, [])
                branch_idx = 0
                while branch_idx < len(statement["elifs"]):
                    ids = native_direct_collect_reachable_expression(ids, statement["elifs"][branch_idx]["condition"], statement_path + ".elif[" + str(branch_idx) + "].condition", scope_id, reachability)
                    ids = native_direct_collect_reachable_statements(ids, statement["elifs"][branch_idx]["body"], statement_path + ".elif[" + str(branch_idx) + "]", scope_id, reachability, target, specialize_target, [])
                    branch_idx = branch_idx + 1
                ids = native_direct_collect_reachable_statements(ids, statement["else_body"], statement_path + ".else", scope_id, reachability, target, specialize_target, [])
        elif kind == "while":
            ids = native_direct_collect_reachable_expression(ids, statement["condition"], statement_path + ".condition", scope_id, reachability)
            ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".body", scope_id, reachability, target, specialize_target, [])
        elif kind == "for":
            ids = native_direct_collect_reachable_expression(ids, statement["iterable"], statement_path + ".iterable", scope_id, reachability)
            ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".body", scope_id, reachability, target, specialize_target, [])
        elif kind == "with":
            ids = native_direct_collect_reachable_expression(ids, statement["resource"], statement_path + ".resource", scope_id, reachability)
            ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".body", scope_id, reachability, target, specialize_target, [])
        elif kind == "try":
            ids = native_direct_collect_reachable_statements(ids, statement["body"], statement_path + ".body", scope_id, reachability, target, specialize_target, [])
            ids = native_direct_collect_reachable_statements(ids, statement["except_body"], statement_path + ".except", scope_id, reachability, target, specialize_target, [])
            ids = native_direct_collect_reachable_statements(ids, statement["finally_body"], statement_path + ".finally", scope_id, reachability, target, specialize_target, [])
        idx = idx + 1
    return ids


def native_direct_function_plan_by_id(function_plans, function_id):
    if function_id > 0 and function_id <= len(function_plans) and function_plans[function_id - 1]["id"] == function_id:
        return function_plans[function_id - 1]
    fail("direct-native reachability rejected code=unknown-function-id;id=" + str(function_id))


def native_direct_function_plan_store(function_plans):
    store = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < len(function_plans):
        plan = function_plans[idx]
        call_plan = {"id": plan["id"], "source_name": plan["source_name"], "symbol": plan["symbol"], "parameters": plan["parameters"], "captures": plan["captures"], "callable_kind": plan["callable_kind"], "address_taken": plan["address_taken"], "class_id": plan["class_id"], "method_name": plan["method_name"], "never_returns": plan["never_returns"]}
        __tyrion_native_ast_builder_append(store, 0, call_plan)
        idx = idx + 1
    return store


def native_direct_state_function_plan_by_id(state, function_id):
    if function_id > 0 and function_id <= __tyrion_native_ast_builder_len(state["function_plan_store"], 0):
        plan = __tyrion_native_ast_builder_get(state["function_plan_store"], 0, function_id - 1)
        if plan["id"] == function_id:
            return plan
    fail("direct-native lowering rejected code=unknown-function-id;id=" + str(function_id))


def native_direct_reachable_function_ids(executable_items, executable_source_indices, function_plans, class_plans, target, root_manifest):
    reachability = native_direct_reachability_index(function_plans, class_plans)
    specialize_target = root_manifest["target_specialized"]
    ids = native_direct_reachable_state(len(function_plans), len(class_plans))
    ids = native_direct_collect_reachable_statements(ids, executable_items, "program", 0, reachability, target, specialize_target, executable_source_indices)
    scan_idx = 0
    while scan_idx < __tyrion_native_ast_builder_len(ids["ids"], 0):
        function_id = __tyrion_native_ast_builder_get(ids["ids"], 0, scan_idx)
        plan = native_direct_function_plan_by_id(function_plans, function_id)
        ids = native_direct_collect_reachable_statements(ids, plan["body"], "function." + plan["source_name"], plan["id"], reachability, target, specialize_target, [])
        parameter_idx = 0
        while parameter_idx < len(plan["parameters"]):
            if plan["parameters"][parameter_idx]["has_default"]:
                ids = native_direct_collect_reachable_expression(ids, plan["parameters"][parameter_idx]["default"], "function." + plan["source_name"] + ".default[" + str(parameter_idx) + "]", plan["id"], reachability)
            parameter_idx = parameter_idx + 1
        scan_idx = scan_idx + 1
    result = __tyrion_native_ast_builder_finish(ids["ids"])
    address_taken_result = __tyrion_native_ast_builder_finish(ids["address_taken_ids"])
    class_result = __tyrion_native_ast_builder_finish(ids["class_ids"])
    return {"ids": result[0], "address_taken_ids": address_taken_result[0], "class_ids": class_result[0], "target_specialized": specialize_target}


def native_direct_reachable_has_id(ids, function_id):
    idx = 0
    while idx < len(ids):
        if ids[idx] == function_id:
            return True
        idx = idx + 1
    return False


def native_direct_address_taken_roots(function_plans):
    roots = []
    function_idx = 0
    while function_idx < len(function_plans):
        plan = function_plans[function_idx]
        if plan["address_taken"]:
            roots = method_append(roots, plan["symbol"])
        function_idx = function_idx + 1
    return roots


def native_direct_remapped_function_id(id_map, old_id):
    if old_id == 0:
        return 0
    idx = 0
    while idx < len(id_map):
        if id_map[idx]["old"] == old_id:
            return id_map[idx]["new"]
        idx = idx + 1
    fail("direct-native reachability rejected code=unreachable-scope;id=" + str(old_id))


def native_direct_prune_function_plans(function_plans, reachable_ids, address_taken_ids):
    reachable = range(len(function_plans) + 1)
    idx = 0
    while idx < len(reachable):
        reachable[idx] = 0
        idx = idx + 1
    idx = 0
    while idx < len(reachable_ids):
        reachable[reachable_ids[idx]] = 1
        idx = idx + 1
    id_map = range(len(function_plans) + 1)
    idx = 0
    next_id = 1
    while idx < len(function_plans):
        old_id = function_plans[idx]["id"]
        id_map[old_id] = 0
        if reachable[old_id] != 0:
            id_map[old_id] = next_id
            next_id = next_id + 1
        idx = idx + 1
    pruned = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < len(function_plans):
        plan = function_plans[idx]
        old_id = plan["id"]
        if reachable[old_id] != 0:
            plan["address_taken"] = native_direct_reachable_has_id(address_taken_ids, old_id)
            plan["id"] = id_map[old_id]
            plan["symbol"] = native_direct_function_symbol(plan["id"])
            if plan["scope_id"] != 0:
                if id_map[plan["scope_id"]] == 0:
                    fail("direct-native reachability rejected code=unreachable-scope;id=" + str(plan["scope_id"]))
                plan["scope_id"] = id_map[plan["scope_id"]]
            plan["resume_id"] = 0
            plan["resume_symbol"] = ""
            __tyrion_native_ast_builder_append(pruned, 0, plan)
        idx = idx + 1
    pruned_count = __tyrion_native_ast_builder_len(pruned, 0)
    next_resume_id = pruned_count + 1
    annotated = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < pruned_count:
        plan = __tyrion_native_ast_builder_get(pruned, 0, idx)
        if plan["is_generator"]:
            plan["resume_id"] = next_resume_id
            plan["resume_symbol"] = native_direct_function_symbol(next_resume_id) + "_resume"
            next_resume_id = next_resume_id + 1
        __tyrion_native_ast_builder_append(annotated, 0, plan)
        idx = idx + 1
    annotated_lists = __tyrion_native_ast_builder_finish(annotated)
    return annotated_lists[0]


def native_direct_class_plans(program, function_plans):
    classes = []
    class_id = 1
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] == "class":
            methods = []
            function_idx = 0
            while function_idx < len(function_plans):
                function_plan = function_plans[function_idx]
                if function_plan["class_id"] == class_id:
                    methods = method_append(methods, {"name": function_plan["method_name"], "function_id": function_plan["id"], "symbol": function_plan["symbol"], "arity": len(function_plan["parameters"])})
                function_idx = function_idx + 1
            classes = method_append(classes, {"id": class_id, "name": statement["name"], "methods": methods})
            class_id = class_id + 1
        idx = idx + 1
    return classes


def native_direct_prune_class_plans(program, function_plans, reachable_class_ids):
    class_count = 0
    item_idx = 0
    while item_idx < len(program["items"]):
        if program["items"][item_idx]["kind"] == "class":
            class_count = class_count + 1
        item_idx = item_idx + 1
    id_map = range(class_count + 1)
    old_id = 0
    while old_id < len(id_map):
        id_map[old_id] = 0
        old_id = old_id + 1
    reachable = range(class_count + 1)
    old_id = 0
    while old_id < len(reachable):
        reachable[old_id] = 0
        old_id = old_id + 1
    reachable_idx = 0
    while reachable_idx < len(reachable_class_ids):
        old_id = reachable_class_ids[reachable_idx]
        if old_id > 0 and old_id < len(reachable):
            reachable[old_id] = 1
        reachable_idx = reachable_idx + 1
    next_id = 1
    old_id = 1
    while old_id < len(id_map):
        if reachable[old_id] != 0:
            id_map[old_id] = next_id
            next_id = next_id + 1
        old_id = old_id + 1
    remapped_functions = __tyrion_native_ast_builder_create()
    function_idx = 0
    while function_idx < len(function_plans):
        function_plan = function_plans[function_idx]
        if function_plan["class_id"] > 0:
            remapped_class_id = id_map[function_plan["class_id"]]
            if remapped_class_id == 0:
                fail("direct-native reachability rejected code=method-without-class;function=" + function_plan["source_name"])
            function_plan["class_id"] = remapped_class_id
        __tyrion_native_ast_builder_append(remapped_functions, 0, function_plan)
        function_idx = function_idx + 1
    remapped_lists = __tyrion_native_ast_builder_finish(remapped_functions)
    classes = []
    old_id = 1
    item_idx = 0
    while item_idx < len(program["items"]):
        statement = program["items"][item_idx]
        if statement["kind"] == "class":
            remapped_class_id = id_map[old_id]
            if remapped_class_id != 0:
                methods = []
                function_idx = 0
                while function_idx < len(remapped_lists[0]):
                    function_plan = remapped_lists[0][function_idx]
                    if function_plan["class_id"] == remapped_class_id:
                        methods = method_append(methods, {"name": function_plan["method_name"], "function_id": function_plan["id"], "symbol": function_plan["symbol"], "arity": len(function_plan["parameters"])})
                    function_idx = function_idx + 1
                classes = method_append(classes, {"id": remapped_class_id, "name": statement["name"], "methods": methods})
            old_id = old_id + 1
        item_idx = item_idx + 1
    return {"functions": remapped_lists[0], "classes": classes}


def native_direct_append_attribute_name(names, name):
    return native_direct_append_unique_name(names, name)


def native_direct_collect_expression_attribute_names(expression, names):
    kind = expression["kind"]
    if kind == "attr":
        names = native_direct_append_attribute_name(names, expression["name"])
        return native_direct_collect_expression_attribute_names(expression["receiver"], names)
    if kind == "binary":
        names = native_direct_collect_expression_attribute_names(expression["left"], names)
        return native_direct_collect_expression_attribute_names(expression["right"], names)
    if kind == "unary" or kind == "kwarg":
        return native_direct_collect_expression_attribute_names(expression["value"], names)
    if kind == "call":
        names = native_direct_collect_expression_attribute_names(expression["callee"], names)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            names = native_direct_collect_expression_attribute_names(expression["args"][arg_idx], names)
            arg_idx = arg_idx + 1
        return names
    if kind == "method_call":
        names = native_direct_collect_expression_attribute_names(expression["receiver"], names)
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            names = native_direct_collect_expression_attribute_names(expression["args"][arg_idx], names)
            arg_idx = arg_idx + 1
        return names
    if kind == "index":
        names = native_direct_collect_expression_attribute_names(expression["receiver"], names)
        return native_direct_collect_expression_attribute_names(expression["index"], names)
    if kind == "slice":
        names = native_direct_collect_expression_attribute_names(expression["receiver"], names)
        names = native_direct_collect_expression_attribute_names(expression["start"], names)
        return native_direct_collect_expression_attribute_names(expression["stop"], names)
    if kind == "list" or kind == "tuple" or kind == "set":
        item_idx = 0
        while item_idx < len(expression["items"]):
            names = native_direct_collect_expression_attribute_names(expression["items"][item_idx], names)
            item_idx = item_idx + 1
        return names
    if kind == "dict":
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            names = native_direct_collect_expression_attribute_names(expression["entries"][entry_idx]["key"], names)
            names = native_direct_collect_expression_attribute_names(expression["entries"][entry_idx]["value"], names)
            entry_idx = entry_idx + 1
    if kind == "comprehension":
        names = native_direct_collect_expression_attribute_names(expression["iterable"], names)
        names = native_direct_collect_expression_attribute_names(expression["condition"], names)
        if expression["out_kind"] == "list":
            return native_direct_collect_expression_attribute_names(expression["expr"], names)
        names = native_direct_collect_expression_attribute_names(expression["key"], names)
        return native_direct_collect_expression_attribute_names(expression["value"], names)
    return names


def native_direct_collect_statement_attribute_names(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        kind = statement["kind"]
        if kind == "assign":
            if statement["target"]["kind"] == "attr":
                names = native_direct_append_attribute_name(names, statement["target"]["name"])
                names = native_direct_collect_expression_attribute_names(statement["target"]["receiver"], names)
            elif statement["target"]["kind"] == "index":
                names = native_direct_collect_expression_attribute_names(statement["target"]["receiver"], names)
                names = native_direct_collect_expression_attribute_names(statement["target"]["index"], names)
            names = native_direct_collect_expression_attribute_names(statement["value"], names)
        elif kind == "expr" or kind == "return" or kind == "raise" or kind == "yield":
            names = native_direct_collect_expression_attribute_names(statement["value"], names)
        elif kind == "if":
            names = native_direct_collect_expression_attribute_names(statement["condition"], names)
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_expression_attribute_names(statement["elifs"][branch_idx]["condition"], names)
                names = native_direct_collect_statement_attribute_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_statement_attribute_names(statement["else_body"], names)
        elif kind == "while":
            names = native_direct_collect_expression_attribute_names(statement["condition"], names)
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
        elif kind == "for":
            names = native_direct_collect_expression_attribute_names(statement["iterable"], names)
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
        elif kind == "with":
            names = native_direct_collect_expression_attribute_names(statement["resource"], names)
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
        elif kind == "try":
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
            names = native_direct_collect_statement_attribute_names(statement["except_body"], names)
            names = native_direct_collect_statement_attribute_names(statement["finally_body"], names)
        elif kind == "function":
            names = native_direct_collect_statement_attribute_names(statement["body"], names)
        elif kind == "class":
            member_idx = 0
            while member_idx < len(statement["body"]):
                member = statement["body"][member_idx]
                if member["kind"] == "function":
                    names = native_direct_collect_statement_attribute_names(member["body"], names)
                member_idx = member_idx + 1
        idx = idx + 1
    return names


def native_direct_attribute_names(program):
    return native_direct_collect_statement_attribute_names(program["items"], [])


def native_direct_collect_reachable_statement_attribute_names(items, names, target, specialize_target):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        kind = statement["kind"]
        if kind == "assign":
            if statement["target"]["kind"] == "attr":
                names = native_direct_append_attribute_name(names, statement["target"]["name"])
                names = native_direct_collect_expression_attribute_names(statement["target"]["receiver"], names)
            elif statement["target"]["kind"] == "index":
                names = native_direct_collect_expression_attribute_names(statement["target"]["receiver"], names)
                names = native_direct_collect_expression_attribute_names(statement["target"]["index"], names)
            names = native_direct_collect_expression_attribute_names(statement["value"], names)
        elif kind == "expr" or kind == "return" or kind == "raise" or kind == "yield":
            names = native_direct_collect_expression_attribute_names(statement["value"], names)
        elif kind == "if":
            names = native_direct_collect_expression_attribute_names(statement["condition"], names)
            target_condition = native_direct_target_condition_value(statement["condition"], target, specialize_target)
            if target_condition == 1:
                names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
            elif target_condition == 0 and len(statement["elifs"]) == 0:
                names = native_direct_collect_reachable_statement_attribute_names(statement["else_body"], names, target, specialize_target)
            else:
                names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
                branch_idx = 0
                while branch_idx < len(statement["elifs"]):
                    names = native_direct_collect_expression_attribute_names(statement["elifs"][branch_idx]["condition"], names)
                    names = native_direct_collect_reachable_statement_attribute_names(statement["elifs"][branch_idx]["body"], names, target, specialize_target)
                    branch_idx = branch_idx + 1
                names = native_direct_collect_reachable_statement_attribute_names(statement["else_body"], names, target, specialize_target)
        elif kind == "while":
            names = native_direct_collect_expression_attribute_names(statement["condition"], names)
            names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
        elif kind == "for":
            names = native_direct_collect_expression_attribute_names(statement["iterable"], names)
            names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
        elif kind == "with":
            names = native_direct_collect_expression_attribute_names(statement["resource"], names)
            names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
        elif kind == "try":
            names = native_direct_collect_reachable_statement_attribute_names(statement["body"], names, target, specialize_target)
            names = native_direct_collect_reachable_statement_attribute_names(statement["except_body"], names, target, specialize_target)
            names = native_direct_collect_reachable_statement_attribute_names(statement["finally_body"], names, target, specialize_target)
        idx = idx + 1
    return names


def native_direct_max_function_arity(function_plans):
    maximum = 0
    idx = 0
    while idx < len(function_plans):
        arity = len(function_plans[idx]["parameters"])
        if arity > maximum:
            maximum = arity
        idx = idx + 1
    return maximum


def native_direct_append_unique_name(names, name):
    idx = 0
    while idx < len(names):
        if names[idx] == name:
            return names
        idx = idx + 1
    return method_append(names, name)


def native_direct_collect_aggregate_names(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            value = statement["value"]
            if value["kind"] == "list" or value["kind"] == "tuple" or value["kind"] == "set" or value["kind"] == "dict" or value["kind"] == "comprehension" or value["kind"] == "call" or value["kind"] == "lambda":
                names = native_direct_append_unique_name(names, statement["target"]["value"])
            elif value["kind"] == "var":
                source_idx = 0
                while source_idx < len(names):
                    if names[source_idx] == value["value"]:
                        names = native_direct_append_unique_name(names, statement["target"]["value"])
                    source_idx = source_idx + 1
        elif statement["kind"] == "if":
            names = native_direct_collect_aggregate_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_aggregate_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_aggregate_names(statement["else_body"], names)
        elif statement["kind"] == "for":
            iterable = statement["iterable"]
            if iterable["kind"] == "var" and native_direct_name_in_list(names, iterable["value"]):
                target_idx = 0
                while target_idx < len(statement["targets"]):
                    names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                    target_idx = target_idx + 1
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate" and len(iterable["args"]) > 0:
                inner = iterable["args"][0]
                if inner["kind"] == "var" and native_direct_name_in_list(names, inner["value"]):
                    target_idx = 0
                    while target_idx < len(statement["targets"]):
                        names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                        target_idx = target_idx + 1
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
                target_idx = 0
                while target_idx < len(statement["targets"]):
                    names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                    target_idx = target_idx + 1
            names = native_direct_collect_aggregate_names(statement["body"], names)
        elif statement["kind"] == "while":
            names = native_direct_collect_aggregate_names(statement["body"], names)
        elif statement["kind"] == "with":
            names = native_direct_collect_aggregate_names(statement["body"], names)
        elif statement["kind"] == "try":
            names = native_direct_collect_aggregate_names(statement["body"], names)
            names = native_direct_collect_aggregate_names(statement["except_body"], names)
            names = native_direct_collect_aggregate_names(statement["finally_body"], names)
        idx = idx + 1
    return names


def native_direct_aggregate_names(program):
    names = []
    changed = True
    while changed:
        prior_count = len(names)
        names = native_direct_collect_aggregate_names(program["items"], names)
        changed = len(names) != prior_count
    return names


def native_direct_collect_string_names(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            value = statement["value"]
            if value["kind"] == "string":
                names = native_direct_append_unique_name(names, statement["target"]["value"])
            elif value["kind"] == "var" and native_direct_name_in_list(names, value["value"]):
                names = native_direct_append_unique_name(names, statement["target"]["value"])
        elif statement["kind"] == "if":
            names = native_direct_collect_string_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_string_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_string_names(statement["else_body"], names)
        elif statement["kind"] == "for":
            iterable = statement["iterable"]
            if iterable["kind"] == "var" and native_direct_name_in_list(names, iterable["value"]) and len(statement["targets"]) == 1:
                names = native_direct_append_unique_name(names, statement["targets"][0])
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate" and len(iterable["args"]) > 0 and len(statement["targets"]) == 2:
                inner = iterable["args"][0]
                if inner["kind"] == "var" and native_direct_name_in_list(names, inner["value"]):
                    names = native_direct_append_unique_name(names, statement["targets"][1])
            names = native_direct_collect_string_names(statement["body"], names)
        elif statement["kind"] == "while":
            names = native_direct_collect_string_names(statement["body"], names)
        elif statement["kind"] == "with":
            names = native_direct_collect_string_names(statement["body"], names)
        elif statement["kind"] == "try":
            names = native_direct_collect_string_names(statement["body"], names)
            names = native_direct_collect_string_names(statement["except_body"], names)
            names = native_direct_collect_string_names(statement["finally_body"], names)
        idx = idx + 1
    return names


def native_direct_string_names(program):
    names = []
    changed = True
    while changed:
        prior_count = len(names)
        names = native_direct_collect_string_names(program["items"], names)
        changed = len(names) != prior_count
    return names


def native_direct_for_control_slot_count(statement):
    iterable = statement["iterable"]
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate":
        if len(iterable["args"]) > 0:
            inner = iterable["args"][0]
            if inner["kind"] == "list" or inner["kind"] == "tuple":
                return 3
            if inner["kind"] == "var":
                return 3
        return 4
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
        return len(iterable["args"]) + 1
    if iterable["kind"] == "list" or iterable["kind"] == "tuple":
        if len(statement["targets"]) > 1:
            return 3
        return 2
    if iterable["kind"] == "var":
        if len(statement["targets"]) > 1:
            return 3
        return 2
    return 3


def native_direct_count_for_control_slots(items):
    count = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "if":
            count = count + native_direct_count_for_control_slots(statement["body"])
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                count = count + native_direct_count_for_control_slots(statement["elifs"][branch_idx]["body"])
                branch_idx = branch_idx + 1
            count = count + native_direct_count_for_control_slots(statement["else_body"])
        elif statement["kind"] == "while":
            count = count + native_direct_count_for_control_slots(statement["body"])
        elif statement["kind"] == "for":
            count = count + native_direct_for_control_slot_count(statement) + native_direct_count_for_control_slots(statement["body"])
        elif statement["kind"] == "with":
            count = count + native_direct_count_for_control_slots(statement["body"])
        elif statement["kind"] == "try":
            count = count + native_direct_count_for_control_slots(statement["body"])
            count = count + native_direct_count_for_control_slots(statement["except_body"])
            count = count + native_direct_count_for_control_slots(statement["finally_body"])
        idx = idx + 1
    return count


def native_direct_count_exception_control_slots(items):
    count = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "if":
            count = count + native_direct_count_exception_control_slots(statement["body"])
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                count = count + native_direct_count_exception_control_slots(statement["elifs"][branch_idx]["body"])
                branch_idx = branch_idx + 1
            count = count + native_direct_count_exception_control_slots(statement["else_body"])
        elif statement["kind"] == "while" or statement["kind"] == "for" or statement["kind"] == "with":
            count = count + native_direct_count_exception_control_slots(statement["body"])
        elif statement["kind"] == "try":
            count = count + 1
            count = count + native_direct_count_exception_control_slots(statement["body"])
            count = count + native_direct_count_exception_control_slots(statement["except_body"])
            count = count + native_direct_count_exception_control_slots(statement["finally_body"])
        idx = idx + 1
    return count


def native_direct_temporary_groups_for_arguments(argument_count):
    remaining = argument_count + 1
    groups = 0
    while remaining > 0:
        groups = groups + 1
        remaining = remaining - 4
    return groups


def native_direct_expression_temporary_depth(expression):
    kind = expression["kind"]
    if kind == "comprehension":
        depth = 2 + native_direct_expression_temporary_depth(expression["iterable"])
        condition_depth = 2 + native_direct_expression_temporary_depth(expression["condition"])
        if condition_depth > depth:
            depth = condition_depth
        if expression["out_kind"] == "list":
            result_depth = 2 + native_direct_expression_temporary_depth(expression["expr"])
            if result_depth > depth:
                depth = result_depth
        else:
            key_depth = 2 + native_direct_expression_temporary_depth(expression["key"])
            value_depth = 2 + native_direct_expression_temporary_depth(expression["value"])
            if key_depth > depth:
                depth = key_depth
            if value_depth > depth:
                depth = value_depth
        return depth
    if kind == "list" or kind == "tuple" or kind == "set":
        depth = 1
        item_idx = 0
        while item_idx < len(expression["items"]):
            item_depth = 1 + native_direct_expression_temporary_depth(expression["items"][item_idx])
            if item_depth > depth:
                depth = item_depth
            item_idx = item_idx + 1
        return depth
    if kind == "dict":
        depth = 1
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            key_depth = 1 + native_direct_expression_temporary_depth(expression["entries"][entry_idx]["key"])
            value_depth = 1 + native_direct_expression_temporary_depth(expression["entries"][entry_idx]["value"])
            if key_depth > depth:
                depth = key_depth
            if value_depth > depth:
                depth = value_depth
            entry_idx = entry_idx + 1
        return depth
    if kind == "call":
        depth = native_direct_temporary_groups_for_arguments(len(expression["args"]))
        if depth < 1:
            depth = 1
        if expression["callee"]["kind"] == "var":
            call_name = expression["callee"]["value"]
            if call_name == "sum" or call_name == "min" or call_name == "max" or call_name == "any" or call_name == "all":
                if depth < 2:
                    depth = 2
            elif call_name == "zip":
                zip_depth = native_direct_temporary_groups_for_arguments(len(expression["args"]) + 3) + 1
                if zip_depth > depth:
                    depth = zip_depth
            elif call_name == "enumerate":
                enumerate_depth = native_direct_temporary_groups_for_arguments(5) + 1
                if enumerate_depth > depth:
                    depth = enumerate_depth
            elif call_name == "sorted":
                if depth < 4:
                    depth = 4
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            argument = expression["args"][arg_idx]
            if argument["kind"] == "kwarg":
                argument = argument["value"]
            argument_depth = depth + native_direct_expression_temporary_depth(argument)
            if argument_depth > depth:
                depth = argument_depth
            arg_idx = arg_idx + 1
        return depth
    if kind == "method_call":
        depth = native_direct_temporary_groups_for_arguments(len(expression["args"]) + 1)
        receiver_depth = depth + native_direct_expression_temporary_depth(expression["receiver"])
        if receiver_depth > depth:
            depth = receiver_depth
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            argument = expression["args"][arg_idx]
            if argument["kind"] == "kwarg":
                argument = argument["value"]
            argument_depth = depth + native_direct_expression_temporary_depth(argument)
            if argument_depth > depth:
                depth = argument_depth
            arg_idx = arg_idx + 1
        return depth
    if kind == "attr":
        return 1 + native_direct_expression_temporary_depth(expression["receiver"])
    if kind == "binary":
        left_depth = 1 + native_direct_expression_temporary_depth(expression["left"])
        right_depth = 1 + native_direct_expression_temporary_depth(expression["right"])
        if left_depth > right_depth:
            return left_depth
        return right_depth
    if kind == "unary":
        return 1 + native_direct_expression_temporary_depth(expression["value"])
    if kind == "index":
        receiver_depth = 1 + native_direct_expression_temporary_depth(expression["receiver"])
        index_depth = 1 + native_direct_expression_temporary_depth(expression["index"])
        if receiver_depth > index_depth:
            return receiver_depth
        return index_depth
    if kind == "slice":
        depth = 1 + native_direct_expression_temporary_depth(expression["receiver"])
        start_depth = 1 + native_direct_expression_temporary_depth(expression["start"])
        stop_depth = 1 + native_direct_expression_temporary_depth(expression["stop"])
        if start_depth > depth:
            depth = start_depth
        if stop_depth > depth:
            depth = stop_depth
        return depth
    return 0


def native_direct_statement_temporary_depth(items):
    depth = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign":
            statement_depth = native_direct_expression_temporary_depth(statement["value"])
            if statement["target"]["kind"] == "index":
                statement_depth = statement_depth + 1
            elif statement["target"]["kind"] == "attr":
                statement_depth = statement_depth + 1
            elif statement["target"]["kind"] == "unpack":
                statement_depth = statement_depth + 1
            if statement_depth > depth:
                depth = statement_depth
            if statement["target"]["kind"] == "index":
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["target"]["receiver"])
                if statement_depth > depth:
                    depth = statement_depth
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["target"]["index"])
                if statement_depth > depth:
                    depth = statement_depth
            elif statement["target"]["kind"] == "attr":
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["target"]["receiver"])
                if statement_depth > depth:
                    depth = statement_depth
        elif statement["kind"] == "if":
            statement_depth = 1 + native_direct_expression_temporary_depth(statement["condition"])
            if statement_depth > depth:
                depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                statement_depth = native_direct_statement_temporary_depth(statement["elifs"][branch_idx]["body"])
                if statement_depth > depth:
                    depth = statement_depth
                branch_idx = branch_idx + 1
            statement_depth = native_direct_statement_temporary_depth(statement["else_body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "while" or statement["kind"] == "for":
            if statement["kind"] == "while":
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["condition"])
                if statement_depth > depth:
                    depth = statement_depth
            if statement["kind"] == "for":
                statement_depth = native_direct_expression_temporary_depth(statement["iterable"])
                if statement_depth > depth:
                    depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "with":
            statement_depth = native_direct_expression_temporary_depth(statement["resource"])
            if statement_depth > depth:
                depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "try":
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["except_body"])
            if statement_depth > depth:
                depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["finally_body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "expr":
            statement_depth = native_direct_expression_temporary_depth(statement["value"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "return" or statement["kind"] == "raise" or statement["kind"] == "yield":
            statement_depth = native_direct_expression_temporary_depth(statement["value"])
            if statement_depth > depth:
                depth = statement_depth
        idx = idx + 1
    return depth


def native_direct_expression_never_returns(expression, scope_id, reachability, never_returns):
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var":
        return False
    function_id = native_direct_reachable_named_function_id(reachability, expression["callee"]["value"], scope_id)
    return function_id > 0 and never_returns[function_id] != 0


def native_direct_statement_never_returns(statement, scope_id, reachability, never_returns):
    kind = statement["kind"]
    if kind == "raise":
        return True
    if kind == "expr":
        return native_direct_expression_never_returns(statement["value"], scope_id, reachability, never_returns)
    if kind == "if":
        if len(statement["else_body"]) == 0 or not native_direct_statements_never_return(statement["body"], scope_id, reachability, never_returns):
            return False
        branch_idx = 0
        while branch_idx < len(statement["elifs"]):
            if not native_direct_statements_never_return(statement["elifs"][branch_idx]["body"], scope_id, reachability, never_returns):
                return False
            branch_idx = branch_idx + 1
        return native_direct_statements_never_return(statement["else_body"], scope_id, reachability, never_returns)
    if kind == "with":
        return native_direct_statements_never_return(statement["body"], scope_id, reachability, never_returns)
    if kind == "try" and len(statement["finally_body"]) > 0:
        return native_direct_statements_never_return(statement["finally_body"], scope_id, reachability, never_returns)
    return False


def native_direct_statements_never_return(statements, scope_id, reachability, never_returns):
    statement_idx = 0
    while statement_idx < len(statements):
        if native_direct_statement_never_returns(statements[statement_idx], scope_id, reachability, never_returns):
            return True
        statement_idx = statement_idx + 1
    return False


def native_direct_statements_have_return(statements):
    statement_idx = 0
    while statement_idx < len(statements):
        statement = statements[statement_idx]
        kind = statement["kind"]
        if kind == "return":
            return True
        if kind == "if":
            if native_direct_statements_have_return(statement["body"]):
                return True
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                if native_direct_statements_have_return(statement["elifs"][branch_idx]["body"]):
                    return True
                branch_idx = branch_idx + 1
            if native_direct_statements_have_return(statement["else_body"]):
                return True
        elif kind == "while" or kind == "for" or kind == "with":
            if native_direct_statements_have_return(statement["body"]):
                return True
        elif kind == "try":
            if native_direct_statements_have_return(statement["body"]) or native_direct_statements_have_return(statement["except_body"]) or native_direct_statements_have_return(statement["finally_body"]):
                return True
        statement_idx = statement_idx + 1
    return False


def native_direct_append_unique_id(ids, value):
    idx = 0
    while idx < len(ids):
        if ids[idx] == value:
            return ids
        idx = idx + 1
    return method_append(ids, value)


def native_direct_collect_never_return_dependencies(dependencies, statements, scope_id, reachability):
    statement_idx = 0
    while statement_idx < len(statements):
        statement = statements[statement_idx]
        kind = statement["kind"]
        if kind == "expr":
            expression = statement["value"]
            if expression["kind"] == "call" and expression["callee"]["kind"] == "var":
                function_id = native_direct_reachable_named_function_id(reachability, expression["callee"]["value"], scope_id)
                if function_id > 0:
                    dependencies = native_direct_append_unique_id(dependencies, function_id)
        elif kind == "if":
            dependencies = native_direct_collect_never_return_dependencies(dependencies, statement["body"], scope_id, reachability)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                dependencies = native_direct_collect_never_return_dependencies(dependencies, statement["elifs"][branch_idx]["body"], scope_id, reachability)
                branch_idx = branch_idx + 1
            dependencies = native_direct_collect_never_return_dependencies(dependencies, statement["else_body"], scope_id, reachability)
        elif kind == "with":
            dependencies = native_direct_collect_never_return_dependencies(dependencies, statement["body"], scope_id, reachability)
        elif kind == "try" and len(statement["finally_body"]) > 0:
            dependencies = native_direct_collect_never_return_dependencies(dependencies, statement["finally_body"], scope_id, reachability)
        statement_idx = statement_idx + 1
    return dependencies


def native_direct_annotate_never_returns(function_plans, class_plans):
    full_reachability = native_direct_reachability_index(function_plans, class_plans)
    reachability = {"entries": full_reachability["entries"], "heads": full_reachability["heads"]}
    never_returns = range(len(function_plans) + 1)
    idx = 0
    while idx < len(never_returns):
        never_returns[idx] = 0
        idx = idx + 1
    reverse_heads = range(len(function_plans) + 1)
    idx = 0
    while idx < len(reverse_heads):
        reverse_heads[idx] = 0
        idx = idx + 1
    reverse_dependencies = __tyrion_native_ast_builder_create()
    queue = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < len(function_plans):
        plan = function_plans[idx]
        dependencies = native_direct_collect_never_return_dependencies([], plan["body"], plan["id"], reachability)
        dependency_idx = 0
        while dependency_idx < len(dependencies):
            dependency_id = dependencies[dependency_idx]
            __tyrion_native_ast_builder_append(reverse_dependencies, 0, {"caller": plan["id"], "next": reverse_heads[dependency_id]})
            reverse_heads[dependency_id] = __tyrion_native_ast_builder_len(reverse_dependencies, 0)
            dependency_idx = dependency_idx + 1
        if not native_direct_statements_have_return(plan["body"]) and native_direct_statements_never_return(plan["body"], plan["id"], reachability, never_returns):
            never_returns[plan["id"]] = 1
            __tyrion_native_ast_builder_append(queue, 0, plan["id"])
        idx = idx + 1
    queue_idx = 0
    while queue_idx < __tyrion_native_ast_builder_len(queue, 0):
        completed_id = __tyrion_native_ast_builder_get(queue, 0, queue_idx)
        cursor = reverse_heads[completed_id]
        while cursor > 0:
            dependency = __tyrion_native_ast_builder_get(reverse_dependencies, 0, cursor - 1)
            dependent_id = dependency["caller"]
            if never_returns[dependent_id] == 0:
                dependent = native_direct_function_plan_by_id(function_plans, dependent_id)
                if not native_direct_statements_have_return(dependent["body"]) and native_direct_statements_never_return(dependent["body"], dependent_id, reachability, never_returns):
                    never_returns[dependent_id] = 1
                    __tyrion_native_ast_builder_append(queue, 0, dependent_id)
            cursor = dependency["next"]
        queue_idx = queue_idx + 1
    annotated = __tyrion_native_ast_builder_create()
    idx = 0
    while idx < len(function_plans):
        plan = function_plans[idx]
        plan["never_returns"] = never_returns[plan["id"]] != 0
        __tyrion_native_ast_builder_append(annotated, 0, plan)
        idx = idx + 1
    annotated_lists = __tyrion_native_ast_builder_finish(annotated)
    return annotated_lists[0]


def native_direct_plan(program, application, target):
    target = backend_require_operation(target, "native-ir-v2-direct")
    if application["contract"] != "tyrion-native-direct-analysis-v1":
        fail("direct-native lowering rejected code=analysis-contract")
    if application["program"] != program:
        fail("direct-native lowering rejected code=analysis-program-mismatch")
    all_function_plans = native_direct_function_plans(program)
    all_class_plans = native_direct_class_plans(program, all_function_plans)
    executable_items = native_direct_executable_program_items(program)
    executable_source_indices = native_direct_executable_program_source_indices(program)
    if len(executable_items) != len(executable_source_indices):
        fail("direct-native lowering rejected code=executable-source-index-count")
    root_manifest = native_direct_root_manifest(target)
    reachability = native_direct_reachable_function_ids(executable_items, executable_source_indices, all_function_plans, all_class_plans, target, root_manifest)
    reachable_function_ids = reachability["ids"]
    root_manifest["target_specialized"] = reachability["target_specialized"]
    function_plans = native_direct_prune_function_plans(all_function_plans, reachable_function_ids, reachability["address_taken_ids"])
    root_manifest["address_taken_roots"] = native_direct_address_taken_roots(function_plans)
    pruned_classes = native_direct_prune_class_plans(program, function_plans, reachability["class_ids"])
    function_plans = pruned_classes["functions"]
    class_plans = pruned_classes["classes"]
    function_plans = native_direct_annotate_never_returns(function_plans, class_plans)
    attribute_names = native_direct_collect_reachable_statement_attribute_names(executable_items, [], target, reachability["target_specialized"])
    attribute_function_idx = 0
    while attribute_function_idx < len(function_plans):
        attribute_names = native_direct_collect_reachable_statement_attribute_names(function_plans[attribute_function_idx]["body"], attribute_names, target, reachability["target_specialized"])
        attribute_parameter_idx = 0
        while attribute_parameter_idx < len(function_plans[attribute_function_idx]["parameters"]):
            parameter = function_plans[attribute_function_idx]["parameters"][attribute_parameter_idx]
            if parameter["has_default"]:
                attribute_names = native_direct_collect_expression_attribute_names(parameter["default"], attribute_names)
            attribute_parameter_idx = attribute_parameter_idx + 1
        attribute_function_idx = attribute_function_idx + 1
    executable_program = {"kind": "program", "items": executable_items}
    locals = native_direct_collect_locals(executable_program)
    global_names = []
    global_idx = 0
    while global_idx < len(locals):
        global_names = method_append(global_names, locals[global_idx]["name"])
        global_idx = global_idx + 1
    loop_control_slot_count = native_direct_count_for_control_slots(executable_items)
    exception_control_slot_count = native_direct_count_exception_control_slots(executable_items)
    max_function_arity = native_direct_max_function_arity(function_plans)
    value_temporary_slot_count = native_direct_statement_temporary_depth(executable_items) * 4 + max_function_arity + 8
    aggregate_names = native_direct_aggregate_names(executable_program)
    string_names = native_direct_string_names(executable_program)
    aggregate_core = len(locals) > 0 or loop_control_slot_count > 0 or value_temporary_slot_count > 0 or len(function_plans) > 0
    planned_functions = __tyrion_native_ast_builder_create()
    function_idx = 0
    while function_idx < len(function_plans):
        function_plan = function_plans[function_idx]
        function_program = {"kind": "program", "items": function_plan["body"]}
        function_plan["locals"] = native_direct_collect_scope_locals(function_plan["body"], function_plan["parameters"], function_plan["captures"])
        function_plan["loop_control_slot_count"] = native_direct_count_for_control_slots(function_plan["body"])
        function_plan["exception_control_slot_count"] = native_direct_count_exception_control_slots(function_plan["body"])
        function_plan["value_temporary_slot_count"] = native_direct_statement_temporary_depth(function_plan["body"]) * 4 + max_function_arity + 8
        function_plan["aggregate_names"] = native_direct_aggregate_names(function_program)
        function_plan["string_names"] = native_direct_string_names(function_program)
        parameter_idx = 0
        while parameter_idx < len(function_plan["parameters"]):
            function_plan["aggregate_names"] = native_direct_append_unique_name(function_plan["aggregate_names"], function_plan["parameters"][parameter_idx]["name"])
            parameter_idx = parameter_idx + 1
        capture_idx = 0
        while capture_idx < len(function_plan["captures"]):
            function_plan["aggregate_names"] = native_direct_append_unique_name(function_plan["aggregate_names"], function_plan["captures"][capture_idx])
            capture_idx = capture_idx + 1
        function_plan["aggregate_core"] = True
        function_plan["target"] = target
        function_plan["classes"] = class_plans
        function_plan["attribute_names"] = attribute_names
        function_plan["global_names"] = global_names
        __tyrion_native_ast_builder_append(planned_functions, 0, function_plan)
        function_idx = function_idx + 1
    planned_function_lists = __tyrion_native_ast_builder_finish(planned_functions)
    return {"contract": "tyrion-native-direct-plan-v1", "target": target, "program": program, "executable_items": executable_items, "executable_source_indices": executable_source_indices, "application": application["application"], "extensions": [], "dynamic_extension_mode": "off", "dynamic_extension_root": "", "root_manifest": root_manifest, "locals": locals, "global_names": global_names, "loop_control_slot_count": loop_control_slot_count, "exception_control_slot_count": exception_control_slot_count, "value_temporary_slot_count": value_temporary_slot_count, "aggregate_names": aggregate_names, "string_names": string_names, "aggregate_core": aggregate_core, "functions": planned_function_lists[0], "classes": class_plans, "attribute_names": attribute_names, "max_function_arity": max_function_arity, "declared_function_count": len(all_function_plans)}


def native_direct_constant_pool_create():
    heads = range(8192)
    idx = 0
    while idx < len(heads):
        heads[idx] = 0
        idx = idx + 1
    return {"constants": __tyrion_native_ast_builder_create(), "entries": __tyrion_native_ast_builder_create(), "heads": heads}


def native_direct_constant_hash(kind, value):
    entry_kind = 7
    if kind == "bytes":
        entry_kind = 8
    return native_direct_reachability_hash(value, entry_kind, 0)


def native_direct_constant_id(state, kind, value):
    pool = state["constant_pool"]
    bucket = native_direct_constant_hash(kind, value)
    cursor = pool["heads"][bucket]
    while cursor > 0:
        entry = __tyrion_native_ast_builder_get(pool["entries"], 0, cursor - 1)
        if entry["kind"] == kind and entry["value"] == value:
            return {"state": state, "id": entry["id"]}
        cursor = entry["next"]
    constant_id = __tyrion_native_ast_builder_len(pool["constants"], 0)
    __tyrion_native_ast_builder_append(pool["constants"], 0, native_ir_v2_constant(constant_id, kind, value))
    __tyrion_native_ast_builder_append(pool["entries"], 0, {"kind": kind, "value": value, "id": constant_id, "next": pool["heads"][bucket]})
    heads = pool["heads"]
    heads[bucket] = __tyrion_native_ast_builder_len(pool["entries"], 0)
    pool["heads"] = heads
    state["constant_pool"] = pool
    return {"state": state, "id": constant_id}


def native_direct_append_instruction(state, op, value_type, fields):
    if state["terminated"]:
        fail("direct-native lowering rejected code=instruction-after-terminator;op=" + op)
    if op == "direct_primitive_call":
        implementation = primitive_schema_implementation_for_id(fields["primitive_id"])
        capability = primitive_schema_capability_for_id(fields["primitive_id"])
        if implementation == "" or capability == "":
            fail("direct-native lowering rejected code=primitive-id;id=" + str(fields["primitive_id"]))
        manifest = state["primitive_manifest"]
        if not native_direct_name_in_list(manifest["implementations"], implementation):
            manifest["implementations"] = method_append(manifest["implementations"], implementation)
        if not native_direct_name_in_list(manifest["capabilities"], capability):
            manifest["capabilities"] = method_append(manifest["capabilities"], capability)
        state["primitive_manifest"] = manifest
    result = state["next_result"]
    state["next_result"] = result + 1
    __tyrion_native_ast_builder_append(state["instructions"], 0, native_ir_v2_instruction(result, op, value_type, fields))
    return {"state": state, "result": result}


def native_direct_finish_block(state, terminator):
    completed = __tyrion_native_ast_builder_len(state["blocks"], 0)
    if state["current_block"] != completed:
        fail("direct-native lowering rejected code=noncanonical-block-completion;block=" + str(state["current_block"]) + ";completed=" + str(completed))
    instruction_lists = __tyrion_native_ast_builder_finish(state["instructions"])
    __tyrion_native_ast_builder_append(state["blocks"], 0, native_ir_v2_block(state["current_block"], instruction_lists[0], terminator))
    state["instructions"] = __tyrion_native_ast_builder_create()
    state["terminated"] = True
    return state


def native_direct_begin_next_block(state):
    block_id = state["next_block"]
    state["next_block"] = block_id + 1
    state["current_block"] = block_id
    state["instructions"] = __tyrion_native_ast_builder_create()
    state["terminated"] = False
    return state


def native_direct_patch_branch_false_target(state, block_id, target):
    block = __tyrion_native_ast_builder_get(state["blocks"], 0, block_id)
    terminator = block["terminator"]
    if terminator["op"] != "branch" or terminator["false_target"] != -1:
        fail("direct-native lowering rejected code=branch-patch-state;block=" + str(block_id))
    native_direct_append_block_patch(state, block_id, "false", target)
    return state


def native_direct_patch_branch_true_target(state, block_id, target):
    block = __tyrion_native_ast_builder_get(state["blocks"], 0, block_id)
    terminator = block["terminator"]
    if terminator["op"] != "branch" or terminator["true_target"] != -1:
        fail("direct-native lowering rejected code=branch-patch-state;block=" + str(block_id))
    native_direct_append_block_patch(state, block_id, "true", target)
    return state


def native_direct_patch_jump_target(state, block_id, target):
    block = __tyrion_native_ast_builder_get(state["blocks"], 0, block_id)
    terminator = block["terminator"]
    if terminator["op"] != "jump" or terminator["target"] != -1:
        fail("direct-native lowering rejected code=jump-patch-state;block=" + str(block_id))
    native_direct_append_block_patch(state, block_id, "jump", target)
    return state


def native_direct_append_block_patch(state, block_id, edge, target):
    patch_idx = 0
    while patch_idx < __tyrion_native_ast_builder_len(state["block_patches"], 0):
        patch = __tyrion_native_ast_builder_get(state["block_patches"], 0, patch_idx)
        if patch["block_id"] == block_id and patch["edge"] == edge:
            if edge == "jump":
                fail("direct-native lowering rejected code=jump-patch-state;block=" + str(block_id))
            fail("direct-native lowering rejected code=branch-patch-state;block=" + str(block_id))
        patch_idx = patch_idx + 1
    __tyrion_native_ast_builder_append(state["block_patches"], 0, {"block_id": block_id, "edge": edge, "target": target})
    return none


def native_direct_materialize_blocks(state):
    block_lists = __tyrion_native_ast_builder_finish(state["blocks"])
    patch_lists = __tyrion_native_ast_builder_finish(state["block_patches"])
    blocks = block_lists[0]
    patches = patch_lists[0]
    materialized = __tyrion_native_ast_builder_create()
    patch_heads = range(len(blocks))
    block_idx = 0
    while block_idx < len(patch_heads):
        patch_heads[block_idx] = 0
        block_idx = block_idx + 1
    indexed_patches = __tyrion_native_ast_builder_create()
    patch_idx = 0
    while patch_idx < len(patches):
        patch = patches[patch_idx]
        patch_block = patch["block_id"]
        if patch_block >= 0 and patch_block < len(blocks):
            __tyrion_native_ast_builder_append(indexed_patches, 0, {"edge": patch["edge"], "target": patch["target"], "next": patch_heads[patch_block]})
            patch_heads[patch_block] = __tyrion_native_ast_builder_len(indexed_patches, 0)
        patch_idx = patch_idx + 1
    block_idx = 0
    applied = 0
    while block_idx < len(blocks):
        block = blocks[block_idx]
        terminator = block["terminator"]
        patch_cursor = patch_heads[block_idx]
        while patch_cursor > 0:
            patch = __tyrion_native_ast_builder_get(indexed_patches, 0, patch_cursor - 1)
            if patch["edge"] == "false":
                terminator["false_target"] = patch["target"]
            elif patch["edge"] == "true":
                terminator["true_target"] = patch["target"]
            else:
                terminator["target"] = patch["target"]
            applied = applied + 1
            patch_cursor = patch["next"]
        block["terminator"] = terminator
        __tyrion_native_ast_builder_append(materialized, 0, block)
        block_idx = block_idx + 1
    if applied != len(patches):
        fail("direct-native lowering rejected code=unknown-block-patch")
    materialized_lists = __tyrion_native_ast_builder_finish(materialized)
    return materialized_lists[0]


def native_direct_append_const_int(state, value, value_type):
    return native_direct_append_instruction(state, "const_int", value_type, {"value": value})


def native_direct_append_write_fd(state, fd_value, payload):
    if len(payload) == 0:
        return state
    constant = native_direct_constant_id(state, "bytes", payload)
    state = constant["state"]
    fd = native_direct_append_const_int(state, fd_value, "i32")
    state = fd["state"]
    address = native_direct_append_instruction(state, "const_address", "ptr", {"constant_id": constant["id"]})
    state = address["state"]
    length = native_direct_append_const_int(state, len(payload), "usize")
    state = length["state"]
    call = native_direct_append_instruction(state, "call_external", "isize", {"name": "write", "args": [fd["result"], address["result"], length["result"]]})
    return call["state"]


def native_direct_append_write(state, payload):
    return native_direct_append_write_fd(state, 1, payload)


def native_direct_release_frame_slots(state):
    if not state["aggregate_core"]:
        return state
    if state["terminated"]:
        fail("direct-native lowering rejected code=instruction-after-terminator;op=direct_slots_release_contiguous")
    if len(state["frame_slots"]) > 0:
        result = state["next_result"]
        state["next_result"] = result + 1
        __tyrion_native_ast_builder_append(state["instructions"], 0, native_ir_v2_instruction(result, "direct_slots_release_contiguous", "i32", {"args": state["frame_slots"]}))
    return state


def native_direct_release_temporary_slots(state):
    if not state["aggregate_core"]:
        return state
    if state["terminated"]:
        fail("direct-native lowering rejected code=instruction-after-terminator;op=direct_slots_release_contiguous")
    if len(state["value_temporary_slots"]) > 0:
        result = state["next_result"]
        state["next_result"] = result + 1
        __tyrion_native_ast_builder_append(state["instructions"], 0, native_ir_v2_instruction(result, "direct_slots_release_contiguous", "i32", {"args": state["value_temporary_slots"]}))
    return state


def native_direct_literal_text(expr):
    kind = expr["kind"]
    if kind == "string":
        return {"ok": True, "value": expr["value"]}
    if kind == "int":
        return {"ok": True, "value": str(expr["value"])}
    if kind == "bool":
        if expr["value"]:
            return {"ok": True, "value": "True"}
        return {"ok": True, "value": "False"}
    if kind == "none":
        return {"ok": True, "value": "none"}
    return {"ok": False, "value": ""}


def native_direct_local_index_create():
    heads = range(257)
    idx = 0
    while idx < len(heads):
        heads[idx] = 0
        idx = idx + 1
    return {"entries": __tyrion_native_ast_builder_create(), "heads": heads}


def native_direct_local_hash(name):
    return native_direct_reachability_hash(name, 9, 0) % 257


def native_direct_local_index_append(state, name, slot, owned):
    index = state["local_index"]
    bucket = native_direct_local_hash(name)
    __tyrion_native_ast_builder_append(index["entries"], 0, {"name": name, "slot": slot, "owned": owned, "next": index["heads"][bucket]})
    heads = index["heads"]
    heads[bucket] = __tyrion_native_ast_builder_len(index["entries"], 0)
    index["heads"] = heads
    state["local_index"] = index
    return state


def native_direct_rebuild_local_index(state):
    state["local_index"] = native_direct_local_index_create()
    idx = 0
    while idx < len(state["locals"]):
        name = state["locals"][idx]["name"]
        owned = native_direct_name_in_list(state["aggregate_names"], name) or native_direct_name_in_list(state["string_names"], name)
        state = native_direct_local_index_append(state, name, state["locals"][idx]["slot"], owned)
        idx = idx + 1
    return state


def native_direct_local_entry(state, name):
    bucket = native_direct_local_hash(name)
    cursor = state["local_index"]["heads"][bucket]
    while cursor > 0:
        entry = __tyrion_native_ast_builder_get(state["local_index"]["entries"], 0, cursor - 1)
        if entry["name"] == name:
            return entry
        cursor = entry["next"]
    return {"name": "", "slot": -1, "owned": False, "next": 0}


def native_direct_local_slot(state, name):
    entry = native_direct_local_entry(state, name)
    if entry["slot"] >= 0:
        return entry["slot"]
    fail("direct-native lowering rejected code=unresolved-local;name=" + name)


def native_direct_global_index(state, name):
    idx = 0
    while idx < len(state["global_names"]):
        if state["global_names"][idx] == name:
            return idx
        idx = idx + 1
    return -1


def native_direct_value_slot_for_read(state, name, path):
    if native_direct_name_in_list(state["initialized_locals"], name):
        return {"state": state, "slot": native_direct_local_slot(state, name)}
    global_index = native_direct_global_index(state, name)
    if state["scope_id"] != 0 and global_index >= 0 and state["global_frame"] >= 0:
        loaded = native_direct_append_instruction(state, "direct_global_slot", "slot_ptr", {"args": [state["global_frame"]], "index": global_index})
        return {"state": loaded["state"], "slot": loaded["result"]}
    fail("direct-native lowering rejected code=local-read-before-assignment;name=" + name + ";position=" + path)


def native_direct_value_name_is_bound(state, name):
    if native_direct_name_in_list(state["initialized_locals"], name):
        return True
    return state["scope_id"] != 0 and native_direct_global_index(state, name) >= 0 and state["global_frame"] >= 0


def native_direct_name_in_list(names, name):
    idx = 0
    while idx < len(names):
        if names[idx] == name:
            return True
        idx = idx + 1
    return False


def native_direct_mark_local_initialized(state, name):
    if not native_direct_name_in_list(state["initialized_locals"], name):
        state["initialized_locals"] = method_append(state["initialized_locals"], name)
    return state


def native_direct_known_bool(state, name):
    idx = 0
    while idx < len(state["known_bools"]):
        if state["known_bools"][idx]["name"] == name:
            if state["known_bools"][idx]["value"]:
                return 1
            return 0
        idx = idx + 1
    return -1


def native_direct_set_known_bool(state, name, known, value):
    updated = []
    idx = 0
    while idx < len(state["known_bools"]):
        if state["known_bools"][idx]["name"] != name:
            updated = method_append(updated, state["known_bools"][idx])
        idx = idx + 1
    if known:
        updated = method_append(updated, {"name": name, "value": value})
    state["known_bools"] = updated
    return state


def native_direct_intersect_known_bools(left, right):
    out = []
    idx = 0
    while idx < len(left):
        right_idx = 0
        while right_idx < len(right):
            if left[idx]["name"] == right[right_idx]["name"] and left[idx]["value"] == right[right_idx]["value"]:
                out = method_append(out, left[idx])
            right_idx = right_idx + 1
        idx = idx + 1
    return out


def native_direct_intersect_initialized(left, right):
    out = []
    idx = 0
    while idx < len(left):
        if native_direct_name_in_list(right, left[idx]):
            out = method_append(out, left[idx])
        idx = idx + 1
    return out


def native_direct_comparison_operation(op):
    if op == "==":
        return "eq"
    if op == "!=":
        return "ne"
    if op == "<":
        return "lt"
    if op == "<=":
        return "le"
    if op == ">":
        return "gt"
    if op == ">=":
        return "ge"
    return ""


def native_direct_seek_constant(name):
    if name == "SEEK_SET":
        return 0
    if name == "SEEK_CUR":
        return 1
    if name == "SEEK_END":
        return 2
    return -1


def native_direct_lower_scalar_expression(state, expression, path):
    kind = expression["kind"]
    if kind == "int":
        value = native_direct_append_const_int(state, expression["value"], "i32")
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "bool":
        int_value = 0
        if expression["value"]:
            int_value = 1
        value = native_direct_append_const_int(state, int_value, "i1")
        return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "var":
        seek_value = native_direct_seek_constant(expression["value"])
        if seek_value >= 0:
            value = native_direct_append_const_int(state, seek_value, "i32")
            return {"state": value["state"], "result": value["result"], "type": "i32"}
        resolved = native_direct_value_slot_for_read(state, expression["value"], path)
        value = native_direct_append_instruction(resolved["state"], "slot_get_int", "i32", {"args": [resolved["slot"]]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "binary" and (expression["op"] == "+" or expression["op"] == "-" or expression["op"] == "*"):
        left = native_direct_lower_scalar_expression(state, expression["left"], path + ".left")
        right = native_direct_lower_scalar_expression(left["state"], expression["right"], path + ".right")
        if left["type"] != "i32" or right["type"] != "i32":
            fail("direct-native lowering rejected code=arithmetic-type-not-lowered;position=" + path)
        operation = "add"
        if expression["op"] == "-":
            operation = "sub"
        elif expression["op"] == "*":
            operation = "mul"
        value = native_direct_append_instruction(right["state"], operation, "i32", {"args": [left["result"], right["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "binary":
        operation = native_direct_comparison_operation(expression["op"])
        if operation != "":
            left = native_direct_lower_scalar_expression(state, expression["left"], path + ".left")
            right = native_direct_lower_scalar_expression(left["state"], expression["right"], path + ".right")
            if left["type"] != right["type"]:
                fail("direct-native lowering rejected code=comparison-type-mismatch;position=" + path)
            value = native_direct_append_instruction(right["state"], operation, "i1", {"args": [left["result"], right["result"]]})
            return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "unary" and expression["op"] == "not":
        inner = native_direct_lower_condition(state, expression["value"], path + ".value")
        zero = native_direct_append_const_int(inner["state"], 0, "i1")
        value = native_direct_append_instruction(zero["state"], "eq", "i1", {"args": [inner["result"], zero["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "unary" and expression["op"] == "-":
        inner = native_direct_lower_scalar_expression(state, expression["value"], path + ".value")
        if inner["type"] != "i32":
            fail("direct-native lowering rejected code=unary-type-not-lowered;position=" + path)
        zero = native_direct_append_const_int(inner["state"], 0, "i32")
        value = native_direct_append_instruction(zero["state"], "sub", "i32", {"args": [zero["result"], inner["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    fail("direct-native lowering rejected code=expression-not-lowered;kind=" + kind + ";position=" + path)


def native_direct_lower_condition(state, expression, path):
    value_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path)
    state = native_direct_lower_value_into_slot(state, expression, value_slot, path, 1)
    condition = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [value_slot]})
    return {"state": condition["state"], "result": condition["result"], "type": "i1"}


def native_direct_lower_print_statement(state, statement, path):
    if statement["kind"] != "expr":
        fail("direct-native lowering rejected code=statement-not-lowered;kind=" + statement["kind"] + ";position=" + path)
    expression = statement["value"]
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var" or expression["callee"]["value"] != "print":
        fail("direct-native lowering rejected code=statement-not-lowered;kind=" + expression["kind"] + ";position=" + path)
    expression_path = path + ".value"
    arg_idx = 0
    while arg_idx < len(expression["args"]):
        argument = expression["args"][arg_idx]
        literal = native_direct_literal_text(argument)
        if arg_idx > 0:
            state = native_direct_append_write(state, " ")
        if literal["ok"]:
            state = native_direct_append_write(state, literal["value"])
        elif argument["kind"] == "var" and native_direct_value_name_is_bound(state, argument["value"]):
            resolved = native_direct_value_slot_for_read(state, argument["value"], expression_path + ".arg[" + str(arg_idx) + "]")
            state = resolved["state"]
            slot = resolved["slot"]
            printed = native_direct_append_instruction(state, "direct_print_string_slot", "i32", {"args": [slot]})
            state = printed["state"]
        else:
            value_slot = native_direct_value_temporary_pair_slot(state, 0, 0, expression_path + ".arg[" + str(arg_idx) + "]")
            state = native_direct_lower_value_into_slot(state, argument, value_slot, expression_path + ".arg[" + str(arg_idx) + "]", 1)
            printed = native_direct_append_instruction(state, "direct_print_string_slot", "i32", {"args": [value_slot]})
            state = printed["state"]
        arg_idx = arg_idx + 1
    return native_direct_append_write(state, "\n")


def native_direct_statement_definitely_assigns_name(statement, name):
    if statement["kind"] == "assign" and statement["target"]["kind"] == "var" and statement["target"]["value"] == name:
        return True
    if statement["kind"] == "if":
        if len(statement["else_body"]) == 0 or not native_direct_statements_definitely_assign_name(statement["body"], name):
            return False
        branch_idx = 0
        while branch_idx < len(statement["elifs"]):
            if not native_direct_statements_definitely_assign_name(statement["elifs"][branch_idx]["body"], name):
                return False
            branch_idx = branch_idx + 1
        return native_direct_statements_definitely_assign_name(statement["else_body"], name)
    if statement["kind"] == "with":
        return native_direct_statements_definitely_assign_name(statement["body"], name)
    if statement["kind"] == "try" and len(statement["finally_body"]) > 0:
        return native_direct_statements_definitely_assign_name(statement["finally_body"], name)
    return False


def native_direct_statements_definitely_assign_name(statements, name):
    idx = 0
    while idx < len(statements):
        if native_direct_statement_definitely_assigns_name(statements[idx], name):
            return True
        idx = idx + 1
    return False


def native_direct_collect_assigned_names(statements, names):
    idx = 0
    while idx < len(statements):
        statement = statements[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            names = native_direct_append_unique_name(names, statement["target"]["value"])
        elif statement["kind"] == "if":
            names = native_direct_collect_assigned_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_assigned_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_assigned_names(statement["else_body"], names)
        elif statement["kind"] == "while" or statement["kind"] == "for" or statement["kind"] == "with":
            names = native_direct_collect_assigned_names(statement["body"], names)
        elif statement["kind"] == "try":
            names = native_direct_collect_assigned_names(statement["body"], names)
            names = native_direct_collect_assigned_names(statement["except_body"], names)
            names = native_direct_collect_assigned_names(statement["finally_body"], names)
        idx = idx + 1
    return names


def native_direct_guard_writes_safe(statements, guard_name, guarded_name, initially_ready):
    ready = initially_ready
    found = False
    idx = 0
    while idx < len(statements):
        statement = statements[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            target_name = statement["target"]["value"]
            if target_name == guard_name:
                value = statement["value"]
                if value["kind"] != "bool":
                    return {"safe": False, "found": found, "ready": ready}
                if value["value"] and not ready:
                    return {"safe": False, "found": True, "ready": ready}
                found = True
            if target_name == guarded_name:
                ready = True
        elif statement["kind"] == "if":
            branch = native_direct_guard_writes_safe(statement["body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                branch = native_direct_guard_writes_safe(statement["elifs"][branch_idx]["body"], guard_name, guarded_name, ready)
                if not branch["safe"]:
                    return branch
                found = found or branch["found"]
                branch_idx = branch_idx + 1
            branch = native_direct_guard_writes_safe(statement["else_body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            if native_direct_statement_definitely_assigns_name(statement, guarded_name):
                ready = True
        elif statement["kind"] == "while" or statement["kind"] == "for" or statement["kind"] == "with":
            branch = native_direct_guard_writes_safe(statement["body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            if statement["kind"] == "with" and native_direct_statement_definitely_assigns_name(statement, guarded_name):
                ready = True
        elif statement["kind"] == "try":
            branch = native_direct_guard_writes_safe(statement["body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            branch = native_direct_guard_writes_safe(statement["except_body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            branch = native_direct_guard_writes_safe(statement["finally_body"], guard_name, guarded_name, ready)
            if not branch["safe"]:
                return branch
            found = found or branch["found"]
            if native_direct_statement_definitely_assigns_name(statement, guarded_name):
                ready = True
        idx = idx + 1
    return {"safe": True, "found": found, "ready": ready}


def native_direct_statement_definitely_assigns_bool(statement, name, expected):
    if statement["kind"] == "assign" and statement["target"]["kind"] == "var" and statement["target"]["value"] == name:
        return statement["value"]["kind"] == "bool" and statement["value"]["value"] == expected
    if statement["kind"] == "if":
        if len(statement["else_body"]) == 0 or not native_direct_statements_definitely_assign_bool(statement["body"], name, expected):
            return False
        branch_idx = 0
        while branch_idx < len(statement["elifs"]):
            if not native_direct_statements_definitely_assign_bool(statement["elifs"][branch_idx]["body"], name, expected):
                return False
            branch_idx = branch_idx + 1
        return native_direct_statements_definitely_assign_bool(statement["else_body"], name, expected)
    if statement["kind"] == "with":
        return native_direct_statements_definitely_assign_bool(statement["body"], name, expected)
    if statement["kind"] == "try" and len(statement["finally_body"]) > 0:
        return native_direct_statements_definitely_assign_bool(statement["finally_body"], name, expected)
    return False


def native_direct_statements_definitely_assign_bool(statements, name, expected):
    idx = 0
    while idx < len(statements):
        if native_direct_statement_definitely_assigns_bool(statements[idx], name, expected):
            return True
        idx = idx + 1
    return False


def native_direct_same_stable_expression(left, right):
    if left["kind"] != right["kind"]:
        return False
    kind = left["kind"]
    if kind == "var" or kind == "string" or kind == "int" or kind == "float" or kind == "bool" or kind == "none":
        return left["value"] == right["value"]
    return False


def native_direct_complementary_conditions(left, right):
    if left["kind"] != "binary" or right["kind"] != "binary":
        return False
    complementary = False
    if left["op"] == "==" and right["op"] == "!=":
        complementary = True
    if left["op"] == "!=" and right["op"] == "==":
        complementary = True
    if not complementary:
        return False
    return native_direct_same_stable_expression(left["left"], right["left"]) and native_direct_same_stable_expression(left["right"], right["right"])


def native_direct_guard_fusion(state, statements, statement_idx):
    if statement_idx + 1 >= len(statements):
        return {"ok": False}
    guarded = statements[statement_idx]
    fallback = statements[statement_idx + 1]
    if guarded["kind"] != "if":
        return {"ok": False}
    if fallback["kind"] != "if":
        return {"ok": False}
    if len(guarded["elifs"]) != 0 or len(guarded["else_body"]) != 0:
        return {"ok": False}
    if len(fallback["elifs"]) != 0 or len(fallback["else_body"]) != 0:
        return {"ok": False}
    if native_direct_complementary_conditions(guarded["condition"], fallback["condition"]):
        return {"ok": True, "statement": {"kind": "if", "condition": guarded["condition"], "body": guarded["body"], "elifs": [], "else_body": fallback["body"]}}
    fallback_condition = fallback["condition"]
    if fallback_condition["kind"] != "unary":
        return {"ok": False}
    if fallback_condition["op"] != "not":
        return {"ok": False}
    if fallback_condition["value"]["kind"] != "var":
        return {"ok": False}
    guard_name = fallback_condition["value"]["value"]
    known_false = native_direct_known_bool(state, guard_name) == 0
    if not known_false and statement_idx > 0:
        initialized = statements[statement_idx - 1]
        if initialized["kind"] == "assign" and initialized["target"]["kind"] == "var" and initialized["target"]["value"] == guard_name:
            initial_value = initialized["value"]
            known_false = initial_value["kind"] == "bool" and not initial_value["value"]
    if not known_false:
        return {"ok": False}
    if not native_direct_statements_definitely_assign_bool(guarded["body"], guard_name, True):
        return {"ok": False}
    candidates = native_direct_collect_assigned_names(fallback["body"], [])
    has_completed_value = False
    candidate_idx = 0
    while candidate_idx < len(candidates):
        candidate = candidates[candidate_idx]
        if native_direct_statements_definitely_assign_name(fallback["body"], candidate) and native_direct_statements_definitely_assign_name(guarded["body"], candidate):
            has_completed_value = True
        candidate_idx = candidate_idx + 1
    if not has_completed_value:
        return {"ok": False}
    return {"ok": True, "statement": {"kind": "if", "condition": guarded["condition"], "body": guarded["body"], "elifs": [], "else_body": fallback["body"]}}


def native_direct_lower_statements(state, statements, path):
    idx = 0
    while idx < len(statements) and not state["terminated"]:
        source_index = idx
        if path == "program" and idx < len(state["top_level_source_indices"]):
            source_index = state["top_level_source_indices"][idx]
        statement_path = path + "[" + str(source_index) + "]"
        fusion = native_direct_guard_fusion(state, statements, idx)
        if fusion["ok"]:
            state = native_direct_lower_if_statement(state, fusion["statement"], statement_path + ".guard-fusion")
            idx = idx + 2
        else:
            state = native_direct_lower_statement(state, statements[idx], statement_path)
            idx = idx + 1
    return state


def native_direct_context_prefix(contexts, count):
    out = []
    idx = 0
    while idx < count:
        out = method_append(out, contexts[idx])
        idx = idx + 1
    return out


def native_direct_restore_outer_exception_updates(saved, active):
    idx = 0
    while idx < len(active) and idx < len(saved):
        saved[idx] = active[idx]
        idx = idx + 1
    return saved


def native_direct_run_cleanup_contexts(state, target_depth, path):
    saved_cleanups = state["cleanup_contexts"]
    saved_exceptions = state["exception_contexts"]
    cleanup_idx = len(saved_cleanups) - 1
    while cleanup_idx >= target_depth and not state["terminated"]:
        cleanup = saved_cleanups[cleanup_idx]
        state["cleanup_contexts"] = native_direct_context_prefix(saved_cleanups, cleanup_idx)
        state["exception_contexts"] = native_direct_context_prefix(saved_exceptions, cleanup["exception_depth"])
        if cleanup["kind"] == "file-close":
            closed = native_direct_append_instruction(state, "direct_file_close", "i32", {"args": [cleanup["slot"]]})
            # Closing is idempotent and must not overwrite a pending return or
            # exception value while unwinding an outer control-flow edge.
            state = closed["state"]
        else:
            state = native_direct_lower_statements(state, cleanup["body"], path + ".cleanup[" + str(cleanup_idx) + "]")
        saved_exceptions = native_direct_restore_outer_exception_updates(saved_exceptions, state["exception_contexts"])
        cleanup_idx = cleanup_idx - 1
    state["cleanup_contexts"] = saved_cleanups
    state["exception_contexts"] = saved_exceptions
    return state


def native_direct_record_exception_block(state, block_id):
    context_idx = len(state["exception_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=exception-context-underflow")
    contexts = state["exception_contexts"]
    context = contexts[context_idx]
    context["raise_blocks"] = method_append(context["raise_blocks"], block_id)
    contexts[context_idx] = context
    state["exception_contexts"] = contexts
    return state


def native_direct_propagate_exception_slot(state, raised_slot, status_result, path):
    if len(state["exception_contexts"]) > 0:
        context_idx = len(state["exception_contexts"]) - 1
        context = state["exception_contexts"][context_idx]
        copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [context["exception_slot"], raised_slot]})
        state = copied["state"]
        state = native_direct_run_cleanup_contexts(state, context["cleanup_depth"] + 1, path)
        if state["terminated"]:
            return state
        block_id = state["current_block"]
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        return native_direct_record_exception_block(state, block_id)
    state = native_direct_run_cleanup_contexts(state, 0, path)
    if state["terminated"]:
        return state
    if state["is_user_function"]:
        copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [state["exception_slot"], raised_slot]})
        state = copied["state"]
        if state["is_generator_resume"]:
            finished = native_direct_append_instruction(state, "direct_generator_finish", "i32", {"args": [state["generator_descriptor"]]})
            state = finished["state"]
            generator_failure = native_direct_append_const_int(state, 2, "i32")
            status_result = generator_failure["result"]
            state = generator_failure["state"]
        state = native_direct_release_frame_slots(state)
        return native_direct_finish_block(state, native_ir_v2_return(status_result))
    if state["report_unhandled_exception"]:
        # Compiler descendants preserve the bootstrap CLI contract: a raised
        # diagnostic is written exactly once before the process returns its
        # failure status. Ordinary applications retain the established silent
        # unhandled-exception behavior.
        reported = native_direct_append_instruction(state, "direct_print_string_slot", "i32", {"args": [raised_slot], "stream": "stderr"})
        state = reported["state"]
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    return native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))


def native_direct_push_loop(state, continue_target):
    context = {"continue_target": continue_target, "break_blocks": [], "continue_blocks": [], "cleanup_depth": len(state["cleanup_contexts"])}
    state["loop_contexts"] = method_append(state["loop_contexts"], context)
    return state


def native_direct_record_loop_break(state, block_id):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=break-outside-loop")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    context["break_blocks"] = method_append(context["break_blocks"], block_id)
    contexts[context_idx] = context
    state["loop_contexts"] = contexts
    return state


def native_direct_record_loop_continue(state, block_id):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=continue-outside-loop")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    context["continue_blocks"] = method_append(context["continue_blocks"], block_id)
    contexts[context_idx] = context
    state["loop_contexts"] = contexts
    return state


def native_direct_pop_loop(state):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=loop-context-underflow")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    remaining = []
    idx = 0
    while idx < context_idx:
        remaining = method_append(remaining, contexts[idx])
        idx = idx + 1
    state["loop_contexts"] = remaining
    return {"state": state, "context": context}


def native_direct_lower_break_statement(state):
    if len(state["loop_contexts"]) == 0:
        fail("direct-native lowering rejected code=break-outside-loop")
    context = state["loop_contexts"][len(state["loop_contexts"]) - 1]
    state = native_direct_run_cleanup_contexts(state, context["cleanup_depth"], "break")
    if state["terminated"]:
        return state
    block_id = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))
    return native_direct_record_loop_break(state, block_id)


def native_direct_lower_continue_statement(state):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=continue-outside-loop")
    context = state["loop_contexts"][context_idx]
    state = native_direct_run_cleanup_contexts(state, context["cleanup_depth"], "continue")
    if state["terminated"]:
        return state
    block_id = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(context["continue_target"]))
    return native_direct_record_loop_continue(state, block_id)


def native_direct_target_specialized_if_body(state, statement):
    if not ("target" in state):
        return {"known": False, "body": [], "suffix": ""}
    selected = native_direct_target_condition_value(statement["condition"], state["target"], True)
    if selected == 1:
        return {"known": True, "body": statement["body"], "suffix": ".if"}
    if selected != 0:
        return {"known": False, "body": [], "suffix": ""}
    branch_idx = 0
    while branch_idx < len(statement["elifs"]):
        branch = statement["elifs"][branch_idx]
        selected = native_direct_target_condition_value(branch["condition"], state["target"], True)
        if selected == 1:
            return {"known": True, "body": branch["body"], "suffix": ".elif[" + str(branch_idx) + "]"}
        if selected != 0:
            return {"known": False, "body": [], "suffix": ""}
        branch_idx = branch_idx + 1
    return {"known": True, "body": statement["else_body"], "suffix": ".else"}


def native_direct_lower_if_statement(state, statement, path):
    specialized = native_direct_target_specialized_if_body(state, statement)
    if specialized["known"]:
        return native_direct_lower_statements(state, specialized["body"], path + specialized["suffix"])
    incoming_initialized = state["initialized_locals"]
    incoming_known_bools = state["known_bools"]
    condition = native_direct_lower_condition(state, statement["condition"], path + ".condition")
    state = condition["state"]
    condition_block = state["current_block"]
    true_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(condition["result"], true_block, -1))
    state = native_direct_begin_next_block(state)
    state = native_direct_lower_statements(state, statement["body"], path + ".if")
    exits = []
    merged_initialized = []
    merged_known_bools = []
    has_live_exit = False
    if not state["terminated"]:
        merged_initialized = state["initialized_locals"]
        merged_known_bools = state["known_bools"]
        has_live_exit = True
        exits = method_append(exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    false_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, false_block)
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    state["known_bools"] = incoming_known_bools
    branch_idx = 0
    while branch_idx < len(statement["elifs"]):
        branch = statement["elifs"][branch_idx]
        branch_condition = native_direct_lower_condition(state, branch["condition"], path + ".elif[" + str(branch_idx) + "].condition")
        state = branch_condition["state"]
        branch_condition_block = state["current_block"]
        branch_true_block = state["next_block"]
        state = native_direct_finish_block(state, native_ir_v2_branch(branch_condition["result"], branch_true_block, -1))
        state = native_direct_begin_next_block(state)
        state = native_direct_lower_statements(state, branch["body"], path + ".elif[" + str(branch_idx) + "]")
        if not state["terminated"]:
            if has_live_exit:
                merged_initialized = native_direct_intersect_initialized(merged_initialized, state["initialized_locals"])
                merged_known_bools = native_direct_intersect_known_bools(merged_known_bools, state["known_bools"])
            else:
                merged_initialized = state["initialized_locals"]
                merged_known_bools = state["known_bools"]
                has_live_exit = True
            exits = method_append(exits, state["current_block"])
            state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        branch_false_block = state["next_block"]
        state = native_direct_patch_branch_false_target(state, branch_condition_block, branch_false_block)
        state = native_direct_begin_next_block(state)
        state["initialized_locals"] = incoming_initialized
        state["known_bools"] = incoming_known_bools
        branch_idx = branch_idx + 1

    state = native_direct_lower_statements(state, statement["else_body"], path + ".else")
    if not state["terminated"]:
        if has_live_exit:
            merged_initialized = native_direct_intersect_initialized(merged_initialized, state["initialized_locals"])
            merged_known_bools = native_direct_intersect_known_bools(merged_known_bools, state["known_bools"])
        else:
            merged_initialized = state["initialized_locals"]
            merged_known_bools = state["known_bools"]
            has_live_exit = True
        exits = method_append(exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
    if not has_live_exit:
        state["terminated"] = True
        return state
    merge_block = state["next_block"]
    exit_idx = 0
    while exit_idx < len(exits):
        state = native_direct_patch_jump_target(state, exits[exit_idx], merge_block)
        exit_idx = exit_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = merged_initialized
    state["known_bools"] = merged_known_bools
    return state


def native_direct_lower_while_statement(state, statement, path):
    incoming_initialized = state["initialized_locals"]
    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    condition = native_direct_lower_condition(state, statement["condition"], path + ".condition")
    state = condition["state"]
    condition_branch_block = state["current_block"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(condition["result"], body_block, -1))
    state = native_direct_begin_next_block(state)
    state = native_direct_push_loop(state, condition_block)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    if not state["terminated"]:
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_branch_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_range_arguments(state, expression, path):
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var" or expression["callee"]["value"] != "range":
        fail("direct-native lowering rejected code=for-iterator-not-lowered;position=" + path)
    args = expression["args"]
    if len(args) < 1 or len(args) > 3:
        fail("direct-native lowering rejected code=range-arity;arity=" + str(len(args)) + ";position=" + path)
    arg_idx = 0
    lowered = []
    while arg_idx < len(args):
        if args[arg_idx]["kind"] == "kwarg":
            fail("direct-native lowering rejected code=range-keyword-not-lowered;position=" + path + ".arg[" + str(arg_idx) + "]")
        value = native_direct_lower_scalar_expression(state, args[arg_idx], path + ".arg[" + str(arg_idx) + "]")
        state = value["state"]
        if value["type"] != "i32":
            fail("direct-native lowering rejected code=range-argument-type-not-lowered;position=" + path + ".arg[" + str(arg_idx) + "]")
        lowered = method_append(lowered, value["result"])
        arg_idx = arg_idx + 1
    if len(lowered) == 1:
        start = native_direct_append_const_int(state, 0, "i32")
        state = start["state"]
        step = native_direct_append_const_int(state, 1, "i32")
        return {"state": step["state"], "start": start["result"], "stop": lowered[0], "step": step["result"]}
    if len(lowered) == 2:
        step = native_direct_append_const_int(state, 1, "i32")
        return {"state": step["state"], "start": lowered[0], "stop": lowered[1], "step": step["result"]}
    return {"state": state, "start": lowered[0], "stop": lowered[1], "step": lowered[2]}


def native_direct_take_loop_control_slot(state, path):
    slot_idx = state["next_loop_control_slot"]
    if slot_idx >= len(state["loop_control_slots"]):
        fail("direct-native lowering rejected code=loop-control-slot-underflow;position=" + path)
    state["next_loop_control_slot"] = slot_idx + 1
    return {"state": state, "slot": state["loop_control_slots"][slot_idx]}


def native_direct_lower_literal_for_statement(state, statement, iterable, enumerate_mode, enumerate_start_expression, path):
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) != expected_targets:
        fail("direct-native lowering rejected code=for-literal-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    incoming_initialized = state["initialized_locals"]
    items = iterable["items"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    item_slots = []
    item_idx = 0
    while item_idx < len(items):
        item_control = native_direct_take_loop_control_slot(state, path)
        state = item_control["state"]
        item_value = native_direct_lower_scalar_expression(state, items[item_idx], path + ".iterable.item[" + str(item_idx) + "]")
        state = item_value["state"]
        if item_value["type"] != "i32":
            fail("direct-native lowering rejected code=for-literal-item-type-not-lowered;position=" + path + ".iterable.item[" + str(item_idx) + "]")
        item_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [item_control["slot"], item_value["result"]]})
        state = item_stored["state"]
        item_slots = method_append(item_slots, item_control["slot"])
        item_idx = item_idx + 1
    enumerate_slot = -1
    enumerate_start = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
        enumerate_start_type = "i32"
        if enumerate_start_expression == none:
            initial = native_direct_append_const_int(state, 0, "i32")
        else:
            initial = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
            enumerate_start_type = initial["type"]
        state = initial["state"]
        if enumerate_start_type != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_start = initial["result"]
    cursor_zero = native_direct_append_const_int(state, 0, "i32")
    state = cursor_zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, cursor_zero["result"]]})
    state = cursor_stored["state"]
    if enumerate_mode:
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start]})
        state = enumerate_stored["state"]
    if len(items) == 0:
        state["initialized_locals"] = incoming_initialized
        return state

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    cursor_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = cursor_value["state"]
    item_count = native_direct_append_const_int(state, len(items), "i32")
    state = item_count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [cursor_value["result"], item_count["result"]]})
    state = has_item["state"]
    dispatch_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], dispatch_block, -1))
    state = native_direct_begin_next_block(state)

    item_exits = []
    value_target_idx = 0
    if enumerate_mode:
        value_target_idx = 1
    target_name = statement["targets"][value_target_idx]
    target_slot = native_direct_local_slot(state, target_name)
    item_idx = 0
    while item_idx < len(items):
        if item_idx < len(items) - 1:
            dispatch_cursor = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
            state = dispatch_cursor["state"]
            dispatch_index = native_direct_append_const_int(state, item_idx, "i32")
            state = dispatch_index["state"]
            is_item = native_direct_append_instruction(state, "eq", "i1", {"args": [dispatch_cursor["result"], dispatch_index["result"]]})
            state = is_item["state"]
            item_block = state["next_block"]
            state = native_direct_finish_block(state, native_ir_v2_branch(is_item["result"], item_block, item_block + 1))
            state = native_direct_begin_next_block(state)
        selected = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [item_slots[item_idx]]})
        state = selected["state"]
        if enumerate_mode:
            enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_value["state"]
            enumerate_target_name = statement["targets"][0]
            enumerate_target = native_direct_local_slot(state, enumerate_target_name)
            enumerate_published = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_target, enumerate_value["result"]]})
            state = native_direct_mark_local_initialized(enumerate_published["state"], enumerate_target_name)
        published = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [target_slot, selected["result"]]})
        state = native_direct_mark_local_initialized(published["state"], target_name)
        item_exits = method_append(item_exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        if item_idx < len(items) - 1:
            state = native_direct_begin_next_block(state)
        item_idx = item_idx + 1

    body_block = state["next_block"]
    item_idx = 0
    while item_idx < len(item_exits):
        state = native_direct_patch_jump_target(state, item_exits[item_idx], body_block)
        item_idx = item_idx + 1
    state = native_direct_begin_next_block(state)
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            enumerate_one = native_direct_append_const_int(state, 1, "i32")
            state = enumerate_one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], enumerate_one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_variable_for_statement(state, statement, iterable_expression, enumerate_mode, enumerate_start_expression, path):
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) == 0 or (enumerate_mode and len(statement["targets"]) != expected_targets):
        fail("direct-native lowering rejected code=for-variable-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    incoming_initialized = state["initialized_locals"]
    snapshot = native_direct_take_loop_control_slot(state, path)
    state = snapshot["state"]
    snapshot_slot = snapshot["slot"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    enumerate_slot = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
    unpack_slot = -1
    if not enumerate_mode and len(statement["targets"]) > 1:
        unpack_control = native_direct_take_loop_control_slot(state, path)
        state = unpack_control["state"]
        unpack_slot = unpack_control["slot"]
    if iterable_expression["kind"] == "var":
        iterable_name = iterable_expression["value"]
        if not native_direct_name_in_list(state["initialized_locals"], iterable_name):
            fail("direct-native lowering rejected code=local-read-before-assignment;name=" + iterable_name + ";position=" + path + ".iterable")
        iterable_slot = native_direct_local_slot(state, iterable_name)
        copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [snapshot_slot, iterable_slot]})
        state = copied["state"]
    else:
        state = native_direct_lower_value_into_slot(state, iterable_expression, snapshot_slot, path + ".iterable", 0)
    state = native_direct_prepare_iterable(state, snapshot_slot, path + ".iterable.prepare", 1)
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]
    if enumerate_mode:
        enumerate_start_type = "i32"
        if enumerate_start_expression == none:
            enumerate_start = native_direct_append_const_int(state, 0, "i32")
        else:
            enumerate_start = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
            enumerate_start_type = enumerate_start["type"]
        state = enumerate_start["state"]
        if enumerate_start_type != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start["result"]]})
        state = enumerate_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [snapshot_slot]})
    state = count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    value_target_idx = 0
    if enumerate_mode:
        enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
        state = enumerate_value["state"]
        enumerate_target_name = statement["targets"][0]
        enumerate_target_slot = native_direct_local_slot(state, enumerate_target_name)
        enumerate_published = native_direct_append_instruction(state, "direct_slot_set_int_owned", "slot_ptr", {"args": [enumerate_target_slot, enumerate_value["result"]]})
        state = native_direct_mark_local_initialized(enumerate_published["state"], enumerate_target_name)
        value_target_idx = 1
    if unpack_slot < 0:
        target_name = statement["targets"][value_target_idx]
        target_slot = native_direct_local_slot(state, target_name)
        item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, snapshot_slot, current["result"]]})
        state = native_direct_mark_local_initialized(item["state"], target_name)
    else:
        item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [unpack_slot, snapshot_slot, current["result"]]})
        state = item["state"]
        state = native_direct_prepare_iterable(state, unpack_slot, path + ".item.prepare", 1)
        unpack_count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [unpack_slot]})
        state = unpack_count["state"]
        required_count = native_direct_append_const_int(state, len(statement["targets"]), "i32")
        state = required_count["state"]
        unpack_size_ok = native_direct_append_instruction(state, "eq", "i1", {"args": [unpack_count["result"], required_count["result"]]})
        state = unpack_size_ok["state"]
        unpack_condition_block = state["current_block"]
        unpack_failure_block = state["next_block"]
        state = native_direct_finish_block(state, native_ir_v2_branch(unpack_size_ok["result"], -1, unpack_failure_block))

        state = native_direct_begin_next_block(state)
        state = native_direct_append_write_fd(state, 2, "for-loop unpack size mismatch\n")
        state = native_direct_release_frame_slots(state)
        unpack_failure = native_direct_append_const_int(state, 3, "i32")
        state = native_direct_finish_block(unpack_failure["state"], native_ir_v2_return(unpack_failure["result"]))

        unpack_success_block = state["next_block"]
        state = native_direct_patch_branch_true_target(state, unpack_condition_block, unpack_success_block)
        state = native_direct_begin_next_block(state)
        target_idx = 0
        while target_idx < len(statement["targets"]):
            target_name = statement["targets"][target_idx]
            target_slot = native_direct_local_slot(state, target_name)
            item_index = native_direct_append_const_int(state, target_idx, "i32")
            state = item_index["state"]
            unpacked = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, unpack_slot, item_index["result"]]})
            state = native_direct_mark_local_initialized(unpacked["state"], target_name)
            target_idx = target_idx + 1
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = increment_current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            enumerate_one = native_direct_append_const_int(state, 1, "i32")
            state = enumerate_one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], enumerate_one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_zip_for_statement(state, statement, expression, path):
    if len(expression["args"]) == 0 or len(statement["targets"]) != len(expression["args"]):
        fail("direct-native lowering rejected code=zip-target-arity;targets=" + str(len(statement["targets"])) + ";iterables=" + str(len(expression["args"])) + ";position=" + path)
    incoming_initialized = state["initialized_locals"]
    snapshots = []
    arg_idx = 0
    while arg_idx < len(expression["args"]):
        argument = expression["args"][arg_idx]
        if argument["kind"] == "kwarg":
            fail("direct-native lowering rejected code=zip-keyword-not-lowered;position=" + path + ".iterable.arg[" + str(arg_idx) + "]")
        snapshot = native_direct_take_loop_control_slot(state, path)
        state = snapshot["state"]
        snapshot_slot = snapshot["slot"]
        if argument["kind"] == "var":
            if not native_direct_name_in_list(state["initialized_locals"], argument["value"]):
                fail("direct-native lowering rejected code=local-read-before-assignment;name=" + argument["value"] + ";position=" + path + ".iterable.arg[" + str(arg_idx) + "]")
            source_slot = native_direct_local_slot(state, argument["value"])
            copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [snapshot_slot, source_slot]})
            state = copied["state"]
        else:
            state = native_direct_lower_value_into_slot(state, argument, snapshot_slot, path + ".iterable.arg[" + str(arg_idx) + "]", 0)
        state = native_direct_prepare_iterable(state, snapshot_slot, path + ".iterable.arg[" + str(arg_idx) + "].prepare", 1)
        snapshots = method_append(snapshots, snapshot_slot)
        arg_idx = arg_idx + 1

    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    has_all = -1
    snapshot_idx = 0
    while snapshot_idx < len(snapshots):
        count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [snapshots[snapshot_idx]]})
        state = count["state"]
        has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
        state = has_item["state"]
        if has_all < 0:
            has_all = has_item["result"]
        else:
            combined = native_direct_append_instruction(state, "and_i1", "i1", {"args": [has_all, has_item["result"]]})
            state = combined["state"]
            has_all = combined["result"]
        snapshot_idx = snapshot_idx + 1
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_all, body_block, -1))

    state = native_direct_begin_next_block(state)
    target_idx = 0
    while target_idx < len(statement["targets"]):
        target_name = statement["targets"][target_idx]
        target_slot = native_direct_local_slot(state, target_name)
        item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, snapshots[target_idx], current["result"]]})
        state = native_direct_mark_local_initialized(item["state"], target_name)
        target_idx = target_idx + 1
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = increment_current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_for_statement(state, statement, path):
    incoming_initialized = state["initialized_locals"]
    iterable = statement["iterable"]
    if iterable["kind"] == "list" or iterable["kind"] == "tuple":
        return native_direct_lower_variable_for_statement(state, statement, iterable, False, none, path)
    if iterable["kind"] == "var":
        return native_direct_lower_variable_for_statement(state, statement, iterable, False, none, path)
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
        return native_direct_lower_zip_for_statement(state, statement, iterable, path)
    range_expression = iterable
    enumerate_mode = False
    enumerate_start_expression = none
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate":
        enumerate_mode = True
        if len(iterable["args"]) < 1 or len(iterable["args"]) > 2:
            fail("direct-native lowering rejected code=enumerate-arity;arity=" + str(len(iterable["args"])) + ";position=" + path + ".iterable")
        if iterable["args"][0]["kind"] == "kwarg":
            fail("direct-native lowering rejected code=enumerate-iterable-keyword;position=" + path + ".iterable.arg[0]")
        range_expression = iterable["args"][0]
        if len(iterable["args"]) == 2:
            enumerate_start_expression = iterable["args"][1]
            if enumerate_start_expression["kind"] == "kwarg":
                if enumerate_start_expression["name"] != "start":
                    fail("direct-native lowering rejected code=enumerate-keyword;name=" + enumerate_start_expression["name"] + ";position=" + path + ".iterable.arg[1]")
                enumerate_start_expression = enumerate_start_expression["value"]
    if enumerate_mode and (range_expression["kind"] == "list" or range_expression["kind"] == "tuple"):
        return native_direct_lower_variable_for_statement(state, statement, range_expression, True, enumerate_start_expression, path)
    if enumerate_mode and range_expression["kind"] == "var":
        return native_direct_lower_variable_for_statement(state, statement, range_expression, True, enumerate_start_expression, path)
    range_call = range_expression["kind"] == "call"
    if range_call:
        range_call = range_expression["callee"]["kind"] == "var" and range_expression["callee"]["value"] == "range"
    if not range_call:
        return native_direct_lower_variable_for_statement(state, statement, range_expression, enumerate_mode, enumerate_start_expression, path)
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) != expected_targets:
        fail("direct-native lowering rejected code=for-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    arguments = native_direct_lower_range_arguments(state, range_expression, path + ".iterable.range")
    state = arguments["state"]
    enumerate_start = -1
    if enumerate_mode:
        enumerate_start_type = "i32"
        if enumerate_start_expression == none:
            initial = native_direct_append_const_int(state, 0, "i32")
        else:
            initial = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
            enumerate_start_type = initial["type"]
        state = initial["state"]
        if enumerate_start_type != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_start = initial["result"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    range_slot = cursor["slot"]
    stop_control = native_direct_take_loop_control_slot(state, path)
    state = stop_control["state"]
    stop_slot = stop_control["slot"]
    step_control = native_direct_take_loop_control_slot(state, path)
    state = step_control["state"]
    step_slot = step_control["slot"]
    enumerate_slot = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
    stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [range_slot, arguments["start"]]})
    state = stored["state"]
    stop_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [stop_slot, arguments["stop"]]})
    state = stop_stored["state"]
    step_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [step_slot, arguments["step"]]})
    state = step_stored["state"]
    if enumerate_mode:
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start]})
        state = enumerate_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    condition_step = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [step_slot]})
    state = condition_step["state"]
    zero_step = native_direct_append_instruction(state, "eq", "i1", {"args": [condition_step["result"], zero["result"]]})
    state = zero_step["state"]
    zero_step_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(zero_step["result"], zero_step_block, -1))

    state = native_direct_begin_next_block(state)
    state = native_direct_append_write_fd(state, 2, "range() arg 3 must not be zero\n")
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    state = native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))

    sign_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, sign_block)
    state = native_direct_begin_next_block(state)
    sign_zero = native_direct_append_const_int(state, 0, "i32")
    state = sign_zero["state"]
    sign_step = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [step_slot]})
    state = sign_step["state"]
    positive = native_direct_append_instruction(state, "gt", "i1", {"args": [sign_step["result"], sign_zero["result"]]})
    state = positive["state"]
    positive_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(positive["result"], positive_block, positive_block + 1))

    state = native_direct_begin_next_block(state)
    positive_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = positive_value["state"]
    positive_stop = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [stop_slot]})
    state = positive_stop["state"]
    positive_condition = native_direct_append_instruction(state, "lt", "i1", {"args": [positive_value["result"], positive_stop["result"]]})
    positive_condition_block = state["current_block"]
    state = native_direct_finish_block(positive_condition["state"], native_ir_v2_branch(positive_condition["result"], -1, -1))

    state = native_direct_begin_next_block(state)
    negative_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = negative_value["state"]
    negative_stop = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [stop_slot]})
    state = negative_stop["state"]
    negative_condition = native_direct_append_instruction(state, "gt", "i1", {"args": [negative_value["result"], negative_stop["result"]]})
    negative_condition_block = state["current_block"]
    body_block = state["next_block"]
    state = native_direct_finish_block(negative_condition["state"], native_ir_v2_branch(negative_condition["result"], body_block, -1))
    state = native_direct_patch_branch_true_target(state, positive_condition_block, body_block)

    state = native_direct_begin_next_block(state)
    iteration_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = iteration_value["state"]
    value_target_idx = 0
    if enumerate_mode:
        enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
        state = enumerate_value["state"]
        enumerate_target = native_direct_local_slot(state, statement["targets"][0])
        enumerate_target_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_target, enumerate_value["result"]]})
        state = native_direct_mark_local_initialized(enumerate_target_stored["state"], statement["targets"][0])
        value_target_idx = 1
    value_target_name = statement["targets"][value_target_idx]
    value_target = native_direct_local_slot(state, value_target_name)
    iteration_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [value_target, iteration_value["result"]]})
    state = native_direct_mark_local_initialized(iteration_stored["state"], value_target_name)
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
        state = current["state"]
        increment_step = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [step_slot]})
        state = increment_step["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [current["result"], increment_step["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [range_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            one = native_direct_append_const_int(state, 1, "i32")
            state = one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, positive_condition_block, exit_block)
    state = native_direct_patch_branch_false_target(state, negative_condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_value_temporary_slot(state, depth, path):
    slot_idx = depth * 4
    if depth < 0 or slot_idx >= len(state["value_temporary_slots"]):
        fail("direct-native lowering rejected code=value-temporary-slot-underflow;depth=" + str(depth) + ";position=" + path)
    return state["value_temporary_slots"][slot_idx]


def native_direct_value_temporary_pair_slot(state, depth, pair_index, path):
    slot_idx = depth * 4 + pair_index
    if depth < 0 or pair_index < 0 or pair_index > 3 or slot_idx >= len(state["value_temporary_slots"]):
        fail("direct-native lowering rejected code=value-temporary-pair-slot-underflow;depth=" + str(depth) + ";pair=" + str(pair_index) + ";position=" + path)
    return state["value_temporary_slots"][slot_idx]


def native_direct_value_temporary_offset_slot(state, depth, offset, path):
    slot_idx = depth * 4 + offset
    if depth < 0 or offset < 0 or slot_idx >= len(state["value_temporary_slots"]):
        fail("direct-native lowering rejected code=value-temporary-offset-slot-underflow;depth=" + str(depth) + ";offset=" + str(offset) + ";position=" + path)
    return state["value_temporary_slots"][slot_idx]


def native_direct_function_plan(state, name):
    function_id = native_direct_reachability_index_first(state["symbol_index"], name, 1, state["scope_id"])
    if function_id == 0 and state["scope_id"] != 0:
        function_id = native_direct_reachability_index_first(state["symbol_index"], name, 1, 0)
    if function_id != 0:
        return native_direct_state_function_plan_by_id(state, function_id)
    fail("direct-native lowering rejected code=unknown-call;name=" + name)


def native_direct_has_function_plan(state, name):
    function_id = native_direct_reachability_index_first(state["symbol_index"], name, 1, state["scope_id"])
    if function_id == 0 and state["scope_id"] != 0:
        function_id = native_direct_reachability_index_first(state["symbol_index"], name, 1, 0)
    return function_id != 0


def native_direct_class_plan(state, name):
    class_id = native_direct_reachability_index_first(state["symbol_index"], name, 3, 0)
    if class_id > 0 and class_id <= len(state["class_plans"]):
        return state["class_plans"][class_id - 1]
    fail("direct-native lowering rejected code=unknown-class;name=" + name)


def native_direct_has_class_plan(state, name):
    return native_direct_reachability_index_first(state["symbol_index"], name, 3, 0) != 0


def native_direct_method_function_plan(state, class_id, method_name):
    function_id = native_direct_reachability_index_first(state["symbol_index"], method_name, 5, class_id)
    if function_id != 0:
        return native_direct_state_function_plan_by_id(state, function_id)
    fail("direct-native lowering rejected code=unknown-class-method;class-id=" + str(class_id) + ";name=" + method_name)


def native_direct_class_method_plan(state, class_plan, method_name):
    return native_direct_method_function_plan(state, class_plan["id"], method_name)


def native_direct_class_has_method(class_plan, method_name):
    idx = 0
    while idx < len(class_plan["methods"]):
        if class_plan["methods"][idx]["name"] == method_name:
            return True
        idx = idx + 1
    return False


def native_direct_classes_with_method(state, method_name):
    matches = []
    idx = 0
    while idx < len(state["class_plans"]):
        if native_direct_class_has_method(state["class_plans"][idx], method_name):
            matches = method_append(matches, state["class_plans"][idx])
        idx = idx + 1
    return matches


def native_direct_attribute_id(state, name):
    idx = 0
    while idx < len(state["attribute_names"]):
        if state["attribute_names"][idx] == name:
            return idx
        idx = idx + 1
    fail("direct-native lowering rejected code=unknown-attribute;name=" + name)


def native_direct_lambda_plan(state, path):
    function_id = native_direct_reachability_index_first(state["symbol_index"], path, 2, 0)
    if function_id != 0:
        return native_direct_state_function_plan_by_id(state, function_id)
    fail("direct-native lowering rejected code=lambda-plan-not-found;position=" + path)


def native_direct_closure_targets(state):
    targets = []
    idx = 0
    while idx < __tyrion_native_ast_builder_len(state["function_plan_store"], 0):
        plan = __tyrion_native_ast_builder_get(state["function_plan_store"], 0, idx)
        if plan["address_taken"]:
            targets = method_append(targets, {"id": plan["id"], "name": plan["symbol"], "arity": len(plan["parameters"])})
        idx = idx + 1
    return targets


def native_direct_parameter_index(function_plan, name):
    idx = 0
    while idx < len(function_plan["parameters"]):
        if function_plan["parameters"][idx]["name"] == name:
            return idx
        idx = idx + 1
    return -1


def native_direct_bind_call(function_plan, arguments, path):
    parameter_count = len(function_plan["parameters"])
    supplied = []
    idx = 0
    while idx < parameter_count:
        supplied = method_append(supplied, False)
        idx = idx + 1
    argument_parameter_indices = []
    positional_index = 0
    argument_idx = 0
    while argument_idx < len(arguments):
        argument = arguments[argument_idx]
        parameter_idx = positional_index
        if argument["kind"] == "kwarg":
            parameter_idx = native_direct_parameter_index(function_plan, argument["name"])
            if parameter_idx < 0:
                fail("direct-native lowering rejected code=unknown-keyword;function=" + function_plan["source_name"] + ";name=" + argument["name"] + ";position=" + path)
        else:
            positional_index = positional_index + 1
        if parameter_idx < 0 or parameter_idx >= parameter_count:
            fail("direct-native lowering rejected code=argument-count;function=" + function_plan["source_name"] + ";position=" + path)
        if supplied[parameter_idx]:
            fail("direct-native lowering rejected code=duplicate-argument;function=" + function_plan["source_name"] + ";parameter=" + function_plan["parameters"][parameter_idx]["name"] + ";position=" + path)
        supplied[parameter_idx] = True
        argument_parameter_indices = method_append(argument_parameter_indices, parameter_idx)
        argument_idx = argument_idx + 1
    missing = []
    parameter_idx = 0
    while parameter_idx < parameter_count:
        if not supplied[parameter_idx]:
            if not function_plan["parameters"][parameter_idx]["has_default"]:
                fail("direct-native lowering rejected code=missing-argument;function=" + function_plan["source_name"] + ";parameter=" + function_plan["parameters"][parameter_idx]["name"] + ";position=" + path)
            missing = method_append(missing, parameter_idx)
        parameter_idx = parameter_idx + 1
    return {"argument_parameter_indices": argument_parameter_indices, "default_parameter_indices": missing}


def native_direct_bind_bound_call(function_plan, arguments, path):
    if len(function_plan["parameters"]) == 0:
        fail("direct-native lowering rejected code=method-self-parameter;function=" + function_plan["source_name"] + ";position=" + path)
    parameter_count = len(function_plan["parameters"])
    supplied = []
    idx = 0
    while idx < parameter_count:
        supplied = method_append(supplied, False)
        idx = idx + 1
    supplied[0] = True
    argument_parameter_indices = []
    positional_index = 1
    argument_idx = 0
    while argument_idx < len(arguments):
        argument = arguments[argument_idx]
        parameter_idx = positional_index
        if argument["kind"] == "kwarg":
            parameter_idx = native_direct_parameter_index(function_plan, argument["name"])
            if parameter_idx <= 0:
                fail("direct-native lowering rejected code=unknown-keyword;function=" + function_plan["source_name"] + ";name=" + argument["name"] + ";position=" + path)
        else:
            positional_index = positional_index + 1
        if parameter_idx < 1 or parameter_idx >= parameter_count:
            fail("direct-native lowering rejected code=argument-count;function=" + function_plan["source_name"] + ";position=" + path)
        if supplied[parameter_idx]:
            fail("direct-native lowering rejected code=duplicate-argument;function=" + function_plan["source_name"] + ";parameter=" + function_plan["parameters"][parameter_idx]["name"] + ";position=" + path)
        supplied[parameter_idx] = True
        argument_parameter_indices = method_append(argument_parameter_indices, parameter_idx)
        argument_idx = argument_idx + 1
    missing = []
    parameter_idx = 1
    while parameter_idx < parameter_count:
        if not supplied[parameter_idx]:
            if not function_plan["parameters"][parameter_idx]["has_default"]:
                fail("direct-native lowering rejected code=missing-argument;function=" + function_plan["source_name"] + ";parameter=" + function_plan["parameters"][parameter_idx]["name"] + ";position=" + path)
            missing = method_append(missing, parameter_idx)
        parameter_idx = parameter_idx + 1
    return {"argument_parameter_indices": argument_parameter_indices, "default_parameter_indices": missing}


def native_direct_push_default_bindings(state, function_plan, argument_slots, parameter_limit):
    saved_locals = state["locals"]
    saved_local_index = state["local_index"]
    saved_initialized = state["initialized_locals"]
    locals = []
    initialized = []
    parameter_idx = 0
    while parameter_idx < parameter_limit:
        name = function_plan["parameters"][parameter_idx]["name"]
        locals = method_append(locals, {"name": name, "slot": argument_slots[parameter_idx]})
        initialized = method_append(initialized, name)
        parameter_idx = parameter_idx + 1
    local_idx = 0
    while local_idx < len(saved_locals):
        locals = method_append(locals, saved_locals[local_idx])
        local_idx = local_idx + 1
    initialized_idx = 0
    while initialized_idx < len(saved_initialized):
        initialized = method_append(initialized, saved_initialized[initialized_idx])
        initialized_idx = initialized_idx + 1
    state["locals"] = locals
    state = native_direct_rebuild_local_index(state)
    state["initialized_locals"] = initialized
    return {"state": state, "locals": saved_locals, "local_index": saved_local_index, "initialized": saved_initialized}


def native_direct_pop_default_bindings(state, saved):
    state["locals"] = saved["locals"]
    state["local_index"] = saved["local_index"]
    state["initialized_locals"] = saved["initialized"]
    return state


def native_direct_require_call_success(state, status_result, exception_slot, path):
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    succeeded = native_direct_append_instruction(state, "eq", "i1", {"args": [status_result, zero["result"]]})
    state = succeeded["state"]
    condition_block = state["current_block"]
    failure_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(succeeded["result"], -1, failure_block))
    state = native_direct_begin_next_block(state)
    state = native_direct_propagate_exception_slot(state, exception_slot, status_result, path + ".failure")
    success_block = state["next_block"]
    state = native_direct_patch_branch_true_target(state, condition_block, success_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_language_call_into_slot(state, expression, destination_slot, path, temporary_depth):
    # The C seed exposes parsed string fields as borrowed views.  Own the
    # callable name across index lookup and argument lowering so nested schema
    # and binding work cannot reuse its backing storage.
    callee_name = "" + expression["callee"]["value"]
    function_plan = native_direct_function_plan(state, callee_name)
    binding = native_direct_bind_call(function_plan, expression["args"], path)
    parameter_count = len(function_plan["parameters"])
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    argument_slots = []
    parameter_idx = 0
    while parameter_idx < parameter_count:
        argument_slots = method_append(argument_slots, native_direct_value_temporary_offset_slot(state, temporary_depth, parameter_idx + 1, path + ".bound[" + str(parameter_idx) + "]"))
        parameter_idx = parameter_idx + 1
    reserved_depth = native_direct_temporary_groups_for_arguments(parameter_count)
    argument_idx = 0
    while argument_idx < len(expression["args"]):
        argument = expression["args"][argument_idx]
        argument_expression = argument
        if argument["kind"] == "kwarg":
            argument_expression = argument["value"]
        parameter_idx = binding["argument_parameter_indices"][argument_idx]
        state = native_direct_lower_value_into_slot(state, argument_expression, argument_slots[parameter_idx], path + ".arg[" + str(argument_idx) + "]", temporary_depth + reserved_depth)
        argument_idx = argument_idx + 1
    default_idx = 0
    while default_idx < len(binding["default_parameter_indices"]):
        parameter_idx = binding["default_parameter_indices"][default_idx]
        pushed = native_direct_push_default_bindings(state, function_plan, argument_slots, parameter_idx)
        state = pushed["state"]
        state = native_direct_lower_value_into_slot(state, function_plan["parameters"][parameter_idx]["default"], argument_slots[parameter_idx], path + ".default[" + str(parameter_idx) + "]", temporary_depth + reserved_depth)
        state = native_direct_pop_default_bindings(state, pushed)
        default_idx = default_idx + 1
    call_args = [destination_slot, exception_slot]
    parameter_idx = 0
    while parameter_idx < len(argument_slots):
        call_args = method_append(call_args, argument_slots[parameter_idx])
        parameter_idx = parameter_idx + 1
    called = native_direct_append_instruction(state, "direct_language_call", "i32", {"args": call_args, "function_id": function_plan["id"], "name": function_plan["symbol"], "argc": parameter_count, "global_frame": state["global_frame"]})
    return native_direct_require_call_success(called["state"], called["result"], exception_slot, path)


def native_direct_lower_bound_call_into_slot(state, function_plan, arguments, receiver_slot, destination_slot, path, temporary_depth):
    binding = native_direct_bind_bound_call(function_plan, arguments, path)
    parameter_count = len(function_plan["parameters"])
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    argument_slots = []
    parameter_idx = 0
    while parameter_idx < parameter_count:
        argument_slots = method_append(argument_slots, native_direct_value_temporary_offset_slot(state, temporary_depth, parameter_idx + 1, path + ".bound[" + str(parameter_idx) + "]"))
        parameter_idx = parameter_idx + 1
    copied_self = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [argument_slots[0], receiver_slot]})
    state = copied_self["state"]
    reserved_depth = native_direct_temporary_groups_for_arguments(parameter_count)
    argument_idx = 0
    while argument_idx < len(arguments):
        argument = arguments[argument_idx]
        argument_expression = argument
        if argument["kind"] == "kwarg":
            argument_expression = argument["value"]
        parameter_idx = binding["argument_parameter_indices"][argument_idx]
        state = native_direct_lower_value_into_slot(state, argument_expression, argument_slots[parameter_idx], path + ".arg[" + str(argument_idx) + "]", temporary_depth + reserved_depth)
        argument_idx = argument_idx + 1
    default_idx = 0
    while default_idx < len(binding["default_parameter_indices"]):
        parameter_idx = binding["default_parameter_indices"][default_idx]
        pushed = native_direct_push_default_bindings(state, function_plan, argument_slots, parameter_idx)
        state = pushed["state"]
        state = native_direct_lower_value_into_slot(state, function_plan["parameters"][parameter_idx]["default"], argument_slots[parameter_idx], path + ".default[" + str(parameter_idx) + "]", temporary_depth + reserved_depth)
        state = native_direct_pop_default_bindings(state, pushed)
        default_idx = default_idx + 1
    call_args = [destination_slot, exception_slot]
    parameter_idx = 0
    while parameter_idx < len(argument_slots):
        call_args = method_append(call_args, argument_slots[parameter_idx])
        parameter_idx = parameter_idx + 1
    called = native_direct_append_instruction(state, "direct_language_call", "i32", {"args": call_args, "function_id": function_plan["id"], "name": function_plan["symbol"], "argc": parameter_count, "global_frame": state["global_frame"]})
    return native_direct_require_call_success(called["state"], called["result"], exception_slot, path)


def native_direct_require_runtime_success(state, status_result, path, temporary_depth):
    exception_slot = native_direct_value_temporary_offset_slot(state, temporary_depth, 0, path + ".exception")
    state = native_direct_lower_value_into_slot(state, {"kind": "none", "value": none, "items": []}, exception_slot, path + ".exception", temporary_depth + 1)
    return native_direct_require_call_success(state, status_result, exception_slot, path)


def native_direct_call_argument_value(argument):
    if argument["kind"] == "kwarg":
        return argument["value"]
    return argument


def native_direct_lower_sum_builtin_into_slot(state, expression, destination_slot, path, temporary_depth):
    base_depth = temporary_depth + 1
    iterable_slot = native_direct_value_temporary_offset_slot(state, base_depth, 0, path + ".iterable")
    cursor_slot = native_direct_value_temporary_offset_slot(state, base_depth, 1, path + ".cursor")
    item_slot = native_direct_value_temporary_offset_slot(state, base_depth, 2, path + ".item")
    next_slot = native_direct_value_temporary_offset_slot(state, base_depth, 3, path + ".next")
    nested_depth = base_depth + 1
    iterable = native_direct_call_argument_value(expression["args"][0])
    state = native_direct_lower_value_into_slot(state, iterable, iterable_slot, path + ".arg[0]", nested_depth)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".arg[0].prepare", nested_depth)
    if len(expression["args"]) == 2:
        start = native_direct_call_argument_value(expression["args"][1])
        state = native_direct_lower_value_into_slot(state, start, destination_slot, path + ".arg[1]", nested_depth)
    else:
        zero_value = native_direct_append_const_int(state, 0, "i32")
        state = zero_value["state"]
        initialized = native_direct_append_instruction(state, "direct_slot_set_int_owned", "slot_ptr", {"args": [destination_slot, zero_value["result"]]})
        state = initialized["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    copied = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [item_slot, iterable_slot, current["result"]]})
    state = copied["state"]
    added = native_direct_append_instruction(state, "direct_slot_binary", "i32", {"args": [next_slot, destination_slot, item_slot], "operator": "+"})
    state = added["state"]
    published = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [destination_slot, next_slot]})
    state = published["state"]
    increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = increment_current["state"]
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
    state = next_value["state"]
    next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
    state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_quantifier_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, all_mode):
    base_depth = temporary_depth + 1
    iterable_slot = native_direct_value_temporary_offset_slot(state, base_depth, 0, path + ".iterable")
    cursor_slot = native_direct_value_temporary_offset_slot(state, base_depth, 1, path + ".cursor")
    item_slot = native_direct_value_temporary_offset_slot(state, base_depth, 2, path + ".item")
    nested_depth = base_depth + 1
    iterable = native_direct_call_argument_value(expression["args"][0])
    state = native_direct_lower_value_into_slot(state, iterable, iterable_slot, path + ".arg[0]", nested_depth)
    state = native_direct_prepare_iterable(state, iterable_slot, path + ".arg[0].prepare", nested_depth)
    default_value = 0
    if all_mode:
        default_value = 1
    default_result = native_direct_append_const_int(state, default_value, "i1")
    state = default_result["state"]
    default_stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, default_result["result"]]})
    state = default_stored["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    copied = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [item_slot, iterable_slot, current["result"]]})
    state = copied["state"]
    truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [item_slot]})
    state = truthy["state"]
    decision_block = state["current_block"]
    early_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(truthy["result"], -1, -1))

    state = native_direct_begin_next_block(state)
    early_value = 1
    if all_mode:
        early_value = 0
    early_result = native_direct_append_const_int(state, early_value, "i1")
    state = early_result["state"]
    early_stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, early_result["result"]]})
    state = early_stored["state"]
    early_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    increment_block = state["next_block"]
    if all_mode:
        state = native_direct_patch_branch_true_target(state, decision_block, increment_block)
        state = native_direct_patch_branch_false_target(state, decision_block, early_block)
    else:
        state = native_direct_patch_branch_true_target(state, decision_block, early_block)
        state = native_direct_patch_branch_false_target(state, decision_block, increment_block)
    state = native_direct_begin_next_block(state)
    increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = increment_current["state"]
    one = native_direct_append_const_int(state, 1, "i32")
    state = one["state"]
    next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
    state = next_value["state"]
    next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
    state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    state = native_direct_patch_jump_target(state, early_exit, exit_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_extreme_builtin_into_slot(state, expression, destination_slot, path, temporary_depth, max_mode):
    base_depth = temporary_depth + 1
    iterable_slot = native_direct_value_temporary_offset_slot(state, base_depth, 0, path + ".iterable")
    cursor_slot = native_direct_value_temporary_offset_slot(state, base_depth, 1, path + ".cursor")
