        if index == 43:
            return "__tyrion_native_cache_encode"
        if index == 44:
            return "__tyrion_native_cache_decode"
        fail("primitive schema public name index out of range")

def primitive_schema_row(index):
    if index < 12:
        if index == 0:
            return "1|len|-|1|1|-|value|int|borrow|pure|core|len|2"
        if index == 1:
            return "2|int|-|1|2|-|value,int|int|borrow|pure|core|int|3"
        if index == 2:
            return "3|str|-|0|1|-|value|string|owned|pure|core|str|2"
        if index == 3:
            return "4|range|-|1|3|-|int,int,int|range|owned|pure|collections|range|4"
        if index == 4:
            return "5|open|-|1|2|-|string,string|file|owned|file|file|file_open|3"
        if index == 5:
            return "6|read_key|-|0|0|-|none|dict|owned|terminal|terminal|terminal_read_key|1"
        if index == 6:
            return "7|ansi_escape|-|0|0|-|none|string|owned|pure|terminal|ansi_escape|1"
        if index == 7:
            return "8|__tyrion_native_wall_time|-|0|0|-|none|float|borrow|clock|clock|wall_time|1"
        if index == 8:
            return "9|__tyrion_native_tcp_connect|-|3|3|-|string,int,int|handle|owned|network|tcp|tcp_connect|4"
        if index == 9:
            return "10|std_io_tcp_connect|__tyrion_native_tcp_connect|3|3|-|string,int,int|handle|owned|network|tcp|tcp_connect|4"
        if index == 10:
            return "11|__tyrion_native_tcp_write|-|3|3|-|handle,bytes,int|int|borrow|network|tcp|tcp_write|4"
        if index == 11:
            return "12|std_io_tcp_write|__tyrion_native_tcp_write|3|3|-|handle,bytes,int|int|borrow|network|tcp|tcp_write|4"
        fail("primitive schema row index out of range")
    else:
        index = index - 12
        if index == 0:
            return "13|__tyrion_native_tcp_read|-|3|3|-|handle,int,int|bytes-or-none|owned|network|tcp|tcp_read|4"
        if index == 1:
            return "14|std_io_tcp_read|__tyrion_native_tcp_read|3|3|-|handle,int,int|bytes-or-none|owned|network|tcp|tcp_read|4"
        if index == 2:
            return "15|__tyrion_native_tcp_close|-|1|1|-|handle|bool|move|network|tcp|tcp_close|2"
        if index == 3:
            return "16|std_io_tcp_close|__tyrion_native_tcp_close|1|1|-|handle|bool|move|network|tcp|tcp_close|2"
        if index == 4:
            return "17|read_text_file|-|1|1|-|string|string|owned|file|compiler-file|read_text_file|2"
        if index == 5:
            return "18|read_module_graph|-|1|1|-|string|string|owned|file|compiler-file|read_module_graph|2"
        if index == 6:
            return "19|write_text_file|-|2|2|-|string,string|bool|borrow|file|compiler-file|write_text_file|2"
        if index == 7:
            return "20|run_tool|-|4|4|-|string,string,string,string|bool|borrow|process|process|run_tool|5"
        if index == 8:
            return "21|asm_writer_open|-|1|1|-|string|writer|owned|file|compiler-writer|writer_open|2"
        if index == 9:
            return "22|asm_writer_append|-|2|2|-|writer,string|writer|retain|file|compiler-writer|writer_append|3"
        if index == 10:
            return "23|asm_writer_close|-|1|1|-|writer|bool|borrow|file|compiler-writer|writer_close|2"
        if index == 11:
            return "24|asm_writer_bytes|-|1|1|-|writer|int|borrow|pure|compiler-writer|writer_bytes|2"
        if index == 12:
            return "25|asm_writer_set_backend|-|2|2|-|writer,string|writer|retain|file|compiler-writer|writer_set_backend|3"
        if index == 13:
            return "26|asm_writer_is_x86|-|1|1|-|writer|bool|borrow|pure|compiler-writer|writer_is_x86|2"
        if index == 14:
            return "27|float|-|0|1|-|value|float|borrow|pure|core|float|2"
        if index == 15:
            return "28|enumerate|-|1|2|start|value,int|list|owned|pure|collections|enumerate|3"
