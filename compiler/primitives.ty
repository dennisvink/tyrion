def primitive_schema_index(index_name):
    row_index = primitive_schema_index_page_0(index_name)
    if row_index == -1:
        return primitive_schema_index_page_1(index_name)
    return row_index

def primitive_schema_find(search_name):
    row_index = primitive_schema_index(search_name)
    if row_index == -1:
        return []
    return primitive_schema_fields(primitive_schema_row(row_index))

def primitive_schema_has(has_name):
    return len(primitive_schema_find(has_name)) != 0

def primitive_schema_id(id_name):
    fields = primitive_schema_find(id_name)
    if len(fields) == 0:
        return -1
    return int(fields[0])

def primitive_schema_find_id(primitive_id):
    if primitive_id < 1 or primitive_id > primitive_schema_count():
        return []
    return primitive_schema_fields(primitive_schema_row(primitive_id - 1))

def primitive_schema_name_for_id(primitive_id):
    fields = primitive_schema_find_id(primitive_id)
    if len(fields) != 13:
        return ""
    return fields[1]

def primitive_schema_ownership_for_id(primitive_id):
    fields = primitive_schema_find_id(primitive_id)
    if len(fields) != 13:
        return ""
    return fields[8]

def primitive_schema_effect_for_id(primitive_id):
    fields = primitive_schema_find_id(primitive_id)
    if len(fields) != 13:
        return ""
    return fields[9]

def primitive_schema_capability_for_id(primitive_id):
    fields = primitive_schema_find_id(primitive_id)
    if len(fields) != 13:
        return ""
    return fields[10]

def primitive_schema_implementation_for_id(primitive_id):
    fields = primitive_schema_find_id(primitive_id)
    if len(fields) != 13:
        return ""
    return fields[11]

def primitive_schema_symbol(symbol_name):
    fields = primitive_schema_find(symbol_name)
    if len(fields) == 0:
        return ""
    if fields[2] == "-":
        return fields[1]
    return fields[2]

def primitive_schema_capability(capability_name):
    fields = primitive_schema_find(capability_name)
    if len(fields) == 0:
        return ""
    return fields[10]

def primitive_schema_impl_key(implementation_name):
    fields = primitive_schema_find(implementation_name)
    if len(fields) == 0:
        return ""
    return fields[11]

def primitive_schema_accepts_arity(arity_name, argc):
    fields = primitive_schema_find(arity_name)
    if len(fields) == 0:
        return False
    return argc >= int(fields[3]) and argc <= int(fields[4])

def primitive_schema_runtime_visible(visibility_name):
    fields = primitive_schema_find(visibility_name)
    if len(fields) == 0:
        return False
    capability = fields[10]
    return capability == "core" or capability == "collections" or capability == "file" or capability == "terminal" or capability == "clock" or capability == "tcp" or capability == "host-extension" or capability == "compiler-cache"

def primitive_schema_runtime_operations():
    out = []
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        fields = primitive_schema_fields(primitive_schema_row(idx))
        capability = fields[10]
        if capability == "file" or capability == "terminal" or capability == "clock" or capability == "tcp" or capability == "host-extension":
            out = method_append(out, fields)
        idx = idx + 1
    return out

def primitive_schema_lowered_fixed(fixed_name):
    implementation = primitive_schema_impl_key(fixed_name)
    fixed = ["len", "tcp_connect", "tcp_write", "tcp_read", "tcp_close", "read_text_file", "read_module_graph", "write_text_file", "run_tool", "writer_open", "writer_append", "writer_close", "writer_bytes", "writer_set_backend", "writer_is_x86", "ast_builder_create", "ast_builder_len", "ast_builder_append", "ast_builder_finish", "ast_builder_get", "token_builder_count", "token_builder_append", "token_builder_field", "lex", "cache_encode", "cache_decode"]
    idx = 0
    while idx < len(fixed):
        if fixed[idx] == implementation:
            return True
        idx = idx + 1
    return False


def primitive_schema_direct_source_body(source_name):
    # File reads use the canonical primitive ABI on every target. The old
    # AArch64 source wrapper loses its owned result during self-hosting.
    if source_name == "read_text_file":
        return False
    # Remaining seed-only source bodies are retired incrementally as their
    # legacy AArch64 emitter gains canonical primitive dispatch. NativeIR and
    # x86 already use the primitive ABI for all of them.
    if host_target()["backend"] == "linux-x86_64":
        return False
    source_bodies = ["read_module_graph", "write_text_file", "lex", "program_has_function", "asm_writer_open", "asm_writer_append", "asm_writer_close", "asm_writer_bytes", "asm_writer_set_backend", "asm_writer_is_x86"]
    idx = 0
    while idx < len(source_bodies):
        if source_bodies[idx] == source_name:
            return True
        idx = idx + 1
    return False


def primitive_schema_lowered_side_effect(effect_name):
    fields = primitive_schema_find(effect_name)
    if len(fields) == 0 or not primitive_schema_lowered_fixed(effect_name):
        return False
    return fields[9] != "pure"

def primitive_schema_dispatch_arg_count(dispatch_name):
    fields = primitive_schema_find(dispatch_name)
    if len(fields) == 0:
        return 0
    return int(fields[12])

def primitive_schema_lowered_plan_kind(plan_name):
    implementation = primitive_schema_impl_key(plan_name)
    if implementation == "len":
        return "native_len_body"
    if implementation == "read_text_file":
        return "native_read_text_file_body"
    if implementation == "read_module_graph":
        return "native_read_module_graph_body"
    if implementation == "lex":
        return "native_lex_body"
    if implementation == "write_text_file":
        return "native_write_text_file_body"
    if implementation == "run_tool":
        return "native_run_tool_body"
    if implementation == "tcp_connect" or implementation == "tcp_write" or implementation == "tcp_read" or implementation == "tcp_close":
        return "native_" + implementation + "_body"
    if implementation == "writer_open" or implementation == "writer_append" or implementation == "writer_close" or implementation == "writer_bytes" or implementation == "writer_set_backend" or implementation == "writer_is_x86":
        return "native_asm_" + implementation + "_body"
    return ""

def primitive_schema_require_target(required_name, target):
    capability = primitive_schema_capability(required_name)
    if capability == "":
        fail("unknown primitive: " + required_name)
    if not target_has_capability(target, capability):
        fail("primitive target implementation missing: " + required_name + ":" + target["backend"])
    implementation = primitive_schema_impl_key(required_name)
    if not backend_has_primitive_implementation(target, implementation):
        fail("primitive target implementation missing: " + required_name + ":" + target["backend"])
    return True

def primitive_schema_target_probe(probe_name, os_name, arch):
    target = target_spec(os_name, arch)
    primitive_schema_require_target(probe_name, target)
    return primitive_schema_id(probe_name)

def primitive_schema_manifest():
    return "tyrion-primitive-abi-v1\n" + primitive_schema_text()
