        if index == 33:
            return "46|__tyrion_native_token_builder_count|-|1|1|-|token-stream|int|borrow|pure|compiler-ast|token_builder_count|2"
        if index == 34:
            return "47|__tyrion_native_token_builder_append|-|5|5|-|ast-builder,string,string,int,int|none|borrow|mutation|compiler-ast|token_builder_append|6"
        if index == 35:
            return "48|__tyrion_native_token_builder_field|-|3|3|-|token-stream,int,string|value|borrow|pure|compiler-ast|token_builder_field|4"
        if index == 36:
            return "49|__tyrion_run_tool|-|2|2|-|string,list|dict|owned|process|process|run_tool_capture|3"
        if index == 37:
            return "50|lex|-|1|1|-|string|token-stream|owned|allocation|compiler-ast|lex|2"
        if index == 38:
            return "51|program_has_function|-|2|2|-|dict,string|bool|borrow|pure|compiler-ast|program_has_function|3"
        if index == 39:
            return "52|__tyrion_native_tls_write|-|3|3|-|int,bytes,int|int|borrow|network|host-extension|tls_write|4"
        if index == 40:
            return "53|__tyrion_native_tls_read|-|3|3|-|int,int,int|bytes-or-none|owned|network|host-extension|tls_read|4"
        if index == 41:
            return "54|__tyrion_native_ascii_text|-|1|1|-|bytes|string-or-none|owned|pure|core|ascii_text|2"
        if index == 42:
            return "55|input|-|0|1|-|value|string|owned|terminal|terminal|input|2"
        if index == 43:
            return "56|__tyrion_native_cache_encode|-|1|1|-|value|string|owned|allocation|compiler-cache|cache_encode|2"
        if index == 44:
            return "57|__tyrion_native_cache_decode|-|1|1|-|string|value|owned|allocation|compiler-cache|cache_decode|2"
        fail("primitive schema row index out of range")

def primitive_schema_rows():
    rows = []
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        rows = method_append(rows, primitive_schema_row(idx))
        idx = idx + 1
    return rows

def primitive_schema_text():
    out = ""
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        out = out + primitive_schema_row(idx) + "\n"
        idx = idx + 1
    return out

def primitive_schema_fields(row):
    fields = split_inventory_text(row, "|")
    if len(fields) != 13:
        fail("invalid primitive schema row")
    return fields

