# Canonical primitive ABI schema.
#
# Rows are intentionally scalar and deterministic so the C seed and every
# generated compiler consume the same representation without host objects.
# Fields:
# id|public|symbol|min|max|keywords|args|result|ownership|effects|capability|impl|dispatch

def primitive_schema_count():
    return 57

def primitive_schema_public_name(index):
    if index < 12:
        if index == 0:
            return "len"
        if index == 1:
            return "int"
        if index == 2:
            return "str"
        if index == 3:
            return "range"
        if index == 4:
            return "open"
        if index == 5:
            return "read_key"
        if index == 6:
            return "ansi_escape"
        if index == 7:
            return "__tyrion_native_wall_time"
        if index == 8:
            return "__tyrion_native_tcp_connect"
        if index == 9:
            return "std_io_tcp_connect"
        if index == 10:
            return "__tyrion_native_tcp_write"
        if index == 11:
            return "std_io_tcp_write"
        fail("primitive schema public name index out of range")
    else:
        index = index - 12
        if index == 0:
            return "__tyrion_native_tcp_read"
        if index == 1:
            return "std_io_tcp_read"
        if index == 2:
            return "__tyrion_native_tcp_close"
        if index == 3:
            return "std_io_tcp_close"
        if index == 4:
            return "read_text_file"
        if index == 5:
            return "read_module_graph"
        if index == 6:
            return "write_text_file"
        if index == 7:
            return "run_tool"
        if index == 8:
            return "asm_writer_open"
        if index == 9:
            return "asm_writer_append"
        if index == 10:
            return "asm_writer_close"
        if index == 11:
            return "asm_writer_bytes"
        if index == 12:
            return "asm_writer_set_backend"
        if index == 13:
            return "asm_writer_is_x86"
        if index == 14:
            return "float"
        if index == 15:
            return "enumerate"
        if index == 16:
            return "bool"
        if index == 17:
            return "zip"
        if index == 18:
            return "sum"
        if index == 19:
            return "min"
        if index == 20:
            return "max"
        if index == 21:
            return "any"
        if index == 22:
            return "all"
        if index == 23:
            return "sorted"
        if index == 24:
            return "time"
        if index == 25:
            return "__tyrion_native_host_load"
        if index == 26:
            return "__tyrion_native_host_call"
        if index == 27:
            return "__tyrion_native_host_unload"
        if index == 28:
            return "__tyrion_native_ast_builder_create"
        if index == 29:
            return "__tyrion_native_ast_builder_len"
        if index == 30:
            return "__tyrion_native_ast_builder_append"
        if index == 31:
            return "__tyrion_native_ast_builder_finish"
        if index == 32:
            return "__tyrion_native_ast_builder_get"
        if index == 33:
            return "__tyrion_native_token_builder_count"
        if index == 34:
            return "__tyrion_native_token_builder_append"
        if index == 35:
            return "__tyrion_native_token_builder_field"
        if index == 36:
            return "__tyrion_run_tool"
        if index == 37:
            return "lex"
        if index == 38:
            return "program_has_function"
        if index == 39:
            return "__tyrion_native_tls_write"
        if index == 40:
            return "__tyrion_native_tls_read"
        if index == 41:
            return "__tyrion_native_ascii_text"
        if index == 42:
