print(13 & 6)
print(13 | 6)
print(13 ^ 6)
print(~13)
print(3 << 4)
print(48 >> 3)

value = 5
value &= 3
print(value)
value |= 8
print(value)
value ^= 2
print(value)
value <<= 2
print(value)
value >>= 1
print(value)

# Signed operands exercise two's-complement AND/OR/XOR, arithmetic right
# shift, and the unary complement at the native boundary.
print(-13 & 6)
print(-13 | 6)
print(-13 ^ 6)
print(-48 >> 3)
print(~(-13))
