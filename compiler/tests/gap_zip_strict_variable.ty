values = [1, 2]
other = [10]
strict_mode = True
try:
    print(zip(values, other, strict=strict_mode))
except ValueError as error:
    print("caught-mismatch")

strict_mode = False
print(zip(values, other, strict=strict_mode))

try:
    print(zip(values, other, strict=1))
except ValueError as error:
    print("caught-mismatch-int")
