print("abs", abs(-7), abs(2.5))
print("pow", pow(2, 10), pow(2, 10, 1000), pow(2, -2))
print("divmod", divmod(17, 5), divmod(-17, 5))
print("round", round(2.5), round(3.5), round(12.345, 2), round(149, -2))
print("chars", chr(65), ord("Z"))
print("list", list("Arya"), list())
print("reverse", reversed([1, 2, 3]))
print("map", map(lambda x: x * 2, [1, 2, 3]))
print("filter", filter(lambda x: x > 1, [1, 2, 3]))
print("bases", bin(10), oct(10), hex(255), repr([1, 2]))
