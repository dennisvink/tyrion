def add(left, right):
    return left + right

def double(value):
    return value * 2

def add3(first, second, third):
    return first + second + third

def map(function, *iterables):
    result = []
    if len(iterables) == 1:
        for item in iterables[0]:
            result.append(function(item))
        return result
    arguments = []
    arguments.append(iterables[0][0])
    arguments.append(iterables[1][0])
    return [function(*arguments)]

print(map(add, *[[1, 2], [10, 20]]))
print(map(add, *[[1, 2, 3], [10, 20]]))
print(map(double, *[[1, 2, 3]]))
print(map(add3, *[[1, 2], [10, 20], [100, 200]]))
