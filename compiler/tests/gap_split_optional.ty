print("  Winter  Storm \n Night ".split())
print("a,b,,c,".split(","))
print("a,b,c".split(",", 1))
print("a,b,c".split(",", 0))
print("  a  b c".split(None, 1))
print("".split(","))
print("".split())
print("  a  b c  ".split(None, 0))
print("a::b::::c".split("::", 1))
print("a,b,c".split(",", -1))
print("a,b,c".rsplit(",", 1))
print("  a  b c  ".rsplit(None, 1))
print("a::b::::c".rsplit("::", 1))
print("a\r\nb\nc\r\nd\n".splitlines())
print("a\r\nb\nc\r\nd\n".splitlines(True))
print("".splitlines())
