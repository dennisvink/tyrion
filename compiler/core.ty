# compiler / core: responsibility-owned canonical compiler module.

def read_text_file(path):
    with open(path, "r") as f:
        data = f.read()
    return data

def compiler_optional_file_exists(path):
    # Native file reads report their own diagnostic before raising. Cache probes
    # are expected to miss on a cold build, so test their presence first and
    # reserve read-failed diagnostics for required compiler inputs.
    return __tyrion_run_tool("test", ["-f", path])["ok"]

def write_text_file(path, text):
    with open(path, "w") as f:
        f.write(text)


def append_text_file(path, text):
    with open(path, "a") as f:
        f.write(text)


def fail(message):
    raise message

def method_append(items, item):
    out = items.append(item)
    return out

def contains_text(haystack, needle):
    if needle == "":
        return True
    haystack_len = len(haystack)
    needle_len = len(needle)
    if needle_len > haystack_len:
        return False
    start = 0
    while start + needle_len <= haystack_len:
        offset = 0
        matched = True
        while offset < needle_len:
            if haystack[start + offset] != needle[offset]:
                matched = False
                break
            offset = offset + 1
        if matched:
            return True
        start = start + 1
    return False

def read_file(path):
    return read_text_file(path)

def make_asm_path(output_path):
    return output_path + ".s"

def run_tool(cmd, arg0, arg1, arg2):
    result = __tyrion_run_tool(cmd, [arg0, arg1, arg2])
    return result["ok"]


def run_tool_args(cmd, args):
    result = __tyrion_run_tool(cmd, args)
    return result["ok"]


def run_tool_capture(cmd, args):
    return __tyrion_run_tool(cmd, args)

def trim_spaces(text):
    start = 0
    text_len = len(text)
    while start < text_len:
        ch = text[start]
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n":
            break
        start = start + 1
    end = text_len
    while end > start:
        ch = text[end - 1]
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n":
            break
        end = end - 1
    return text[start:end]

def first_call_name(body):
    idx = 0
    while idx < len(body):
        name = call_stmt_name(body[idx])
        if name != "":
            return name
        idx = idx + 1
    return ""

def list_contains_string(items, value):
    idx = 0
    while idx < len(items):
        if items[idx] == value:
            return True
        idx = idx + 1
    return False

def split_inventory_text(text, delimiter):
    if delimiter == "":
        return [text]
    return text.split(delimiter)

def decimal_text(value):
    return str(value)

def read_key():
    fail("read_key requires native compiler runtime")

def ansi_escape():
    fail("ansi_escape requires native compiler runtime")
