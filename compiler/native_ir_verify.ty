# Structural verifier for architecture-neutral native IR records.

def native_ir_constant_exists(module, constant_id):
    if "constant_count" in module:
        return constant_id >= 0 and constant_id < module["constant_count"]
    idx = 0
    while idx < len(module["constants"]):
        if module["constants"][idx]["id"] == constant_id:
            return True
        idx = idx + 1
    return False


def native_ir_external(module, name):
    idx = 0
    while idx < len(module["externals"]):
        external = module["externals"][idx]
        if external["name"] == name:
            return external
        idx = idx + 1
    fail("native-ir rejected code=external-not-found;name=" + name)


def native_ir_function_by_name(module, name):
    if "function_store" in module:
        idx = 0
        while idx < module["function_count"]:
            function = __tyrion_native_ast_builder_get(module["function_store"], 0, idx)
            if function["name"] == name:
                return function
            idx = idx + 1
        fail("native-ir rejected code=function-not-found;name=" + name)
    idx = 0
    while idx < len(module["functions"]):
        function = module["functions"][idx]
        if function["name"] == name:
            return function
        idx = idx + 1
    fail("native-ir rejected code=function-not-found;name=" + name)


def native_ir_dispatch_table_by_id(module, table_id):
    idx = 0
    while idx < len(module["dispatch_tables"]):
        table = module["dispatch_tables"][idx]
        if table["id"] == table_id:
            return table
        idx = idx + 1
    fail("native-ir rejected code=dispatch-table-not-found;id=" + str(table_id))


def native_ir_static_program_by_id(module, table_id):
    idx = 0
    while idx < len(module["globals"]):
        item = module["globals"][idx]
        if item["kind"] == "static_program" and item["id"] == table_id:
            return item
        idx = idx + 1
    fail("native-ir rejected code=static-program-not-found;id=" + str(table_id))


def native_ir_value_type_before(instructions, stop, result):
    idx = 0
    while idx < stop:
        instruction = instructions[idx]
        if instruction["result"] == result:
            return instruction["type"]
        idx = idx + 1
    fail("native-ir rejected code=value-not-defined;value=" + str(result))


def native_ir_integer_type(value_type):
    return value_type == "i32" or value_type == "i64" or value_type == "usize" or value_type == "isize"


def native_ir_verify_arg_types(prior, args, types, op):
    if len(args) != len(types):
        fail("native-ir rejected code=operation-arity;op=" + op)
    arg_idx = 0
    while arg_idx < len(args):
        actual_type = native_ir_value_type_before(prior, len(prior), args[arg_idx])
        if actual_type != types[arg_idx]:
            fail("native-ir rejected code=operation-argument-type;op=" + op + ";index=" + str(arg_idx) + ";expected=" + types[arg_idx] + ";actual=" + actual_type)
        arg_idx = arg_idx + 1


def verify_native_ir_instruction(module, function, prior, instruction):
    expected_result = len(prior)
    if instruction["result"] != expected_result:
        fail("native-ir rejected code=noncanonical-result-id;expected=" + str(expected_result) + ";actual=" + str(instruction["result"]))
    op = instruction["op"]
    fields = instruction["fields"]
    if op == "parameter":
        index = fields["index"]
        if index < 0 or index >= len(function["parameters"]):
            fail("native-ir rejected code=parameter-index;index=" + str(index))
        if instruction["type"] != function["parameters"][index]:
            fail("native-ir rejected code=parameter-type;index=" + str(index))
        return
    if op == "const_int":
        if not native_ir_integer_type(instruction["type"]):
            fail("native-ir rejected code=const-int-type")
        return
    if op == "const_address":
        if instruction["type"] != "ptr":
            fail("native-ir rejected code=const-address-type")
        if not native_ir_constant_exists(module, fields["constant_id"]):
            fail("native-ir rejected code=constant-not-found;id=" + str(fields["constant_id"]))
        return
    if op == "call_external":
        external = native_ir_external(module, fields["name"])
        args = fields["args"]
        if len(args) != len(external["parameters"]):
            fail("native-ir rejected code=external-arity;name=" + fields["name"])
        arg_idx = 0
        while arg_idx < len(args):
            actual_type = native_ir_value_type_before(prior, len(prior), args[arg_idx])
            expected_type = external["parameters"][arg_idx]
            if actual_type != expected_type:
                fail("native-ir rejected code=external-argument-type;name=" + fields["name"] + ";index=" + str(arg_idx) + ";expected=" + expected_type + ";actual=" + actual_type)
            arg_idx = arg_idx + 1
        if instruction["type"] != external["result_type"]:
            fail("native-ir rejected code=external-result-type;name=" + fields["name"])
        return
    if op == "call_internal":
        called = native_ir_function_by_name(module, fields["name"])
        args = fields["args"]
        native_ir_verify_arg_types(prior, args, called["parameters"], op)
        if instruction["type"] != called["result_type"]:
            fail("native-ir rejected code=internal-result-type;name=" + fields["name"])
        return
    if op == "dispatch_call":
        table = native_ir_dispatch_table_by_id(module, fields["table_id"])
        name_type = native_ir_value_type_before(prior, len(prior), fields["name"])
        if name_type != "ptr":
            fail("native-ir rejected code=dispatch-name-type")
        args = fields["args"]
        if len(args) > len(table["parameter_types"]):
            fail("native-ir rejected code=dispatch-storage-arity;table=" + str(table["id"]))
        arg_idx = 0
        while arg_idx < len(args):
            actual_type = native_ir_value_type_before(prior, len(prior), args[arg_idx])
            expected_type = table["parameter_types"][arg_idx]
            if actual_type != expected_type:
                fail("native-ir rejected code=dispatch-argument-type;table=" + str(table["id"]) + ";index=" + str(arg_idx))
            arg_idx = arg_idx + 1
        actual_arity = fields["actual_arity"]
        if actual_arity < 0 or actual_arity > len(args):
            fail("native-ir rejected code=dispatch-actual-arity;table=" + str(table["id"]))
        if instruction["type"] != table["result_type"]:
            fail("native-ir rejected code=dispatch-result-type;table=" + str(table["id"]))
        return
    if op == "ast_from_static":
        table = native_ir_static_program_by_id(module, fields["table_id"])
        if fields["token_count"] != native_static_program_token_count(table):
            fail("native-ir rejected code=static-program-token-count;id=" + str(table["id"]))
        if fields["record_count"] != native_static_program_record_count(table):
            fail("native-ir rejected code=static-program-record-count;id=" + str(table["id"]))
        if fields["root"] != table["root"]:
            fail("native-ir rejected code=static-program-root;id=" + str(table["id"]))
        if instruction["type"] != "ast_handle_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    args = fields["args"]
    if op == "ast_create":
        native_ir_verify_arg_types(prior, args, ["i32", "i64", "i64", "i64", "i64", "i64"], op)
        if instruction["type"] != "ast_handle_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_retain" or op == "ast_release":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_kind":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_field":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "i32"], op)
        if instruction["type"] != "i64":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_bind_tokens":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "token_vector_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_view":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "usize"], op)
        if instruction["type"] != "ast_handle_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_append":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "i32", "i64", "i64", "i64", "i64"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "ast_append_record":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "i32", "i64", "i64", "i64", "i64", "i64", "i64", "i64"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "expr_eval":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "usize", "environment_ptr", "slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "environment_create":
        native_ir_verify_arg_types(prior, args, ["usize", "environment_ptr"], op)
        if instruction["type"] != "environment_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "environment_null":
        native_ir_verify_arg_types(prior, args, [], op)
        if instruction["type"] != "environment_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "environment_bind":
        native_ir_verify_arg_types(prior, args, ["environment_ptr", "ast_handle_ptr", "usize", "slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "environment_lookup":
        native_ir_verify_arg_types(prior, args, ["environment_ptr", "ast_handle_ptr", "usize", "slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "environment_release":
        native_ir_verify_arg_types(prior, args, ["environment_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "statement_execute":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "usize", "environment_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "statement_execute_result":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "usize", "environment_ptr", "slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "statement_execute_exception":
        native_ir_verify_arg_types(prior, args, ["ast_handle_ptr", "usize", "environment_ptr", "slot_ptr", "slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_vector_create":
        native_ir_verify_arg_types(prior, args, ["usize"], op)
        if instruction["type"] != "token_vector_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_vector_append":
        native_ir_verify_arg_types(prior, args, ["token_vector_ptr", "i32", "ptr", "usize", "usize", "usize"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_vector_count":
        native_ir_verify_arg_types(prior, args, ["token_vector_ptr"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_kind":
        native_ir_verify_arg_types(prior, args, ["token_vector_ptr", "usize"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_text_length":
        native_ir_verify_arg_types(prior, args, ["token_vector_ptr", "usize"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "token_vector_release":
        native_ir_verify_arg_types(prior, args, ["token_vector_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_alloc":
        native_ir_verify_arg_types(prior, args, [], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_zero":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_set_int":
        native_ir_verify_arg_types(prior, args, ["slot_ptr", "i32"], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_copy":
        native_ir_verify_arg_types(prior, args, ["slot_ptr", "slot_ptr"], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_copy_owned":
        native_ir_verify_arg_types(prior, args, ["slot_ptr", "slot_ptr"], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_tag":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_string_length":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_string_byte":
        native_ir_verify_arg_types(prior, args, ["slot_ptr", "usize"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_truthy":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_get_int":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "add" or op == "sub":
        native_ir_verify_arg_types(prior, args, [instruction["type"], instruction["type"]], op)
        if not native_ir_integer_type(instruction["type"]):
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "int_cast":
        if len(args) != 1:
            fail("native-ir rejected code=operation-arity;op=" + op)
        source_type = native_ir_value_type_before(prior, len(prior), args[0])
        if not native_ir_integer_type(source_type) or not native_ir_integer_type(instruction["type"]):
            fail("native-ir rejected code=operation-argument-type;op=" + op)
        return
    if op == "slot_set_writer":
        native_ir_verify_arg_types(prior, args, ["slot_ptr", "writer_ptr"], op)
        if instruction["type"] != "slot_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_get_writer":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "writer_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_release":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "slot_write_stderr":
        native_ir_verify_arg_types(prior, args, ["slot_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "writer_open":
        native_ir_verify_arg_types(prior, args, ["ptr"], op)
        if instruction["type"] != "writer_ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "writer_append":
        native_ir_verify_arg_types(prior, args, ["writer_ptr", "ptr", "usize"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "writer_bytes":
        native_ir_verify_arg_types(prior, args, ["writer_ptr"], op)
        if instruction["type"] != "usize":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "writer_close" or op == "writer_release":
        native_ir_verify_arg_types(prior, args, ["writer_ptr"], op)
        if instruction["type"] != "i32":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "eq":
        if len(args) != 2:
            fail("native-ir rejected code=operation-arity;op=" + op)
        left_type = native_ir_value_type_before(prior, len(prior), args[0])
        right_type = native_ir_value_type_before(prior, len(prior), args[1])
        if left_type != right_type:
            fail("native-ir rejected code=operation-argument-type;op=" + op)
        if instruction["type"] != "i1":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    if op == "argv_at":
        native_ir_verify_arg_types(prior, args, ["ptr", "i32"], op)
        if instruction["type"] != "ptr":
            fail("native-ir rejected code=operation-result-type;op=" + op)
        return
    fail("native-ir rejected code=unknown-operation;op=" + op)


def native_ir_block_exists(function, block_id):
    idx = 0
    while idx < len(function["blocks"]):
        if function["blocks"][idx]["id"] == block_id:
            return True
        idx = idx + 1
    return False


def verify_native_ir_block(module, function, block, prior):
    instructions = block["instructions"]
    idx = 0
    while idx < len(instructions):
        verify_native_ir_instruction(module, function, prior, instructions[idx])
        prior.append(instructions[idx])
        idx = idx + 1
    terminator = block["terminator"]
    if terminator["op"] == "return":
        return_type = native_ir_value_type_before(prior, len(prior), terminator["value"])
        if return_type != function["result_type"]:
            fail("native-ir rejected code=return-type;function=" + function["name"] + ";expected=" + function["result_type"] + ";actual=" + return_type)
        return prior
    if terminator["op"] == "branch":
        condition_type = native_ir_value_type_before(prior, len(prior), terminator["condition"])
        if condition_type != "i1":
            fail("native-ir rejected code=branch-condition-type;function=" + function["name"])
        if not native_ir_block_exists(function, terminator["true_target"]) or not native_ir_block_exists(function, terminator["false_target"]):
            fail("native-ir rejected code=branch-target;function=" + function["name"])
        return prior
    fail("native-ir rejected code=unsupported-terminator;op=" + terminator["op"])


def verify_native_ir_v1(module):
    if module["contract"] != "tyrion-native-ir-v1":
        fail("native-ir rejected code=contract-version")
    if module["target_independent_abi_version"] != 1:
        fail("native-ir rejected code=abi-version")
    if len(module["functions"]) == 0:
        fail("native-ir rejected code=no-functions")
    if "extensions" in module:
        extension_idx = 0
        while extension_idx < len(module["extensions"]):
            extension = module["extensions"][extension_idx]
            if extension["id"] != extension_idx:
                fail("native-ir rejected code=noncanonical-extension-id")
            if static_extension_identifier_valid(extension["name"]) != True:
                fail("native-ir rejected code=invalid-extension-name")
            if static_extension_identifier_valid(extension["call_symbol"]) != True:
                fail("native-ir rejected code=invalid-extension-symbol")
            extension_idx = extension_idx + 1
    global_idx = 0
    while global_idx < len(module["globals"]):
        item = module["globals"][global_idx]
        if item["kind"] != "static_program":
            fail("native-ir rejected code=unknown-global-kind;index=" + str(global_idx))
        if item["id"] != global_idx:
            fail("native-ir rejected code=noncanonical-static-program-id")
        token_count = native_static_program_token_count(item)
        record_count = native_static_program_record_count(item)
        if token_count == 0 or token_count > 1048576:
            fail("native-ir rejected code=static-program-token-count;id=" + str(item["id"]))
        if record_count == 0 or record_count > 1048576:
            fail("native-ir rejected code=static-program-record-count;id=" + str(item["id"]))
        if item["root"] < 0 or item["root"] >= record_count:
            fail("native-ir rejected code=static-program-root;id=" + str(item["id"]))
        token_idx = 0
        while token_idx < token_count:
            token = native_static_program_token(item, token_idx)
            if token["kind"] <= 0 or token["kind"] > len(generated_token_kind_names()):
                fail("native-ir rejected code=static-token-kind;table=" + str(item["id"]) + ";index=" + str(token_idx))
            if not ("builder" in item) and not native_ir_constant_exists(module, token_idx):
                fail("native-ir rejected code=static-token-constant;table=" + str(item["id"]) + ";index=" + str(token_idx))
            if len(token["text"]) < 0 or token["line"] < 0 or token["column"] < 0:
                fail("native-ir rejected code=static-token-field;table=" + str(item["id"]) + ";index=" + str(token_idx))
            token_idx = token_idx + 1
        record_idx = 0
        while record_idx < record_count:
            record = native_static_program_record(item, record_idx)
            if record["kind"] <= 0:
                fail("native-ir rejected code=static-record-kind;table=" + str(item["id"]) + ";index=" + str(record_idx))
            record_idx = record_idx + 1
        global_idx = global_idx + 1
    table_idx = 0
    while table_idx < len(module["dispatch_tables"]):
        table = module["dispatch_tables"][table_idx]
        if table["id"] != table_idx:
            fail("native-ir rejected code=noncanonical-dispatch-table-id")
        if len(table["parameter_types"]) > 4:
            fail("native-ir rejected code=dispatch-table-arity-not-supported;id=" + str(table["id"]))
        entry_idx = 0
        while entry_idx < len(table["entries"]):
            entry = table["entries"][entry_idx]
            if not native_ir_constant_exists(module, entry["constant_id"]):
                fail("native-ir rejected code=dispatch-name-constant-not-found;id=" + str(entry["constant_id"]))
            called = native_ir_function_by_name(module, entry["function"])
            if called["parameters"] != table["parameter_types"]:
                fail("native-ir rejected code=dispatch-function-parameters;name=" + entry["function"])
            if called["result_type"] != table["result_type"]:
                fail("native-ir rejected code=dispatch-function-result;name=" + entry["function"])
            entry_idx = entry_idx + 1
        table_idx = table_idx + 1
    function_idx = 0
    while function_idx < len(module["functions"]):
        function = module["functions"][function_idx]
        if len(function["blocks"]) == 0:
            fail("native-ir rejected code=no-blocks;function=" + function["name"])
        if function["entry_block"] != function["blocks"][0]["id"]:
            fail("native-ir rejected code=entry-block;function=" + function["name"])
        prior = []
        block_idx = 0
        while block_idx < len(function["blocks"]):
            if function["blocks"][block_idx]["id"] != block_idx:
                fail("native-ir rejected code=noncanonical-block-id;function=" + function["name"])
            prior = verify_native_ir_block(module, function, function["blocks"][block_idx], prior)
            block_idx = block_idx + 1
        function_idx = function_idx + 1
    return module


def native_ir_v2_integer_type(value_type):
    return value_type == "i1" or value_type == "i32" or value_type == "i64" or value_type == "usize" or value_type == "isize"


def native_ir_v2_block_target_exists(function, block_id):
    return block_id >= 0 and block_id < len(function["blocks"]) and function["blocks"][block_id]["id"] == block_id


def native_ir_v2_definition(function, value):
    if value < 0:
        return {"found": False, "block": -1, "instruction": -1, "type": ""}
    first_result = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        if value < first_result + len(instructions):
            instruction_idx = value - first_result
            if instruction_idx >= 0:
                instruction = instructions[instruction_idx]
                if instruction["result"] != value:
                    return {"found": False, "block": -1, "instruction": -1, "type": ""}
                return {"found": True, "block": block_idx, "instruction": instruction_idx, "type": instruction["type"]}
        first_result = first_result + len(instructions)
        block_idx = block_idx + 1
    return {"found": False, "block": -1, "instruction": -1, "type": ""}


def native_ir_v2_predecessors(function, block_id):
    predecessors = []
    block_idx = 0
    while block_idx < len(function["blocks"]):
        terminator = function["blocks"][block_idx]["terminator"]
        if terminator["op"] == "jump":
            if terminator["target"] == block_id:
                predecessors.append(block_idx)
        elif terminator["op"] == "branch":
            if terminator["true_target"] == block_id or terminator["false_target"] == block_id:
                predecessors.append(block_idx)
        block_idx = block_idx + 1
    return predecessors


def native_ir_v2_predecessor_matrix(function):
    predecessors = []
    block_idx = 0
    while block_idx < len(function["blocks"]):
        predecessors.append([])
        block_idx = block_idx + 1
    block_idx = 0
    while block_idx < len(function["blocks"]):
        terminator = function["blocks"][block_idx]["terminator"]
        if terminator["op"] == "jump":
            target = terminator["target"]
            predecessors[target] = method_append(predecessors[target], block_idx)
        elif terminator["op"] == "branch":
            true_target = terminator["true_target"]
            false_target = terminator["false_target"]
            predecessors[true_target] = method_append(predecessors[true_target], block_idx)
            if false_target != true_target:
                predecessors[false_target] = method_append(predecessors[false_target], block_idx)
        block_idx = block_idx + 1
    return predecessors


def native_ir_v2_reachable_blocks(function):
    count = len(function["blocks"])
    reachable = []
    idx = 0
    while idx < count:
        reachable.append(False)
        idx = idx + 1
    reachable[function["entry_block"]] = True
    changed = True
    while changed:
        changed = False
        block_idx = 0
        while block_idx < count:
            if reachable[block_idx]:
                terminator = function["blocks"][block_idx]["terminator"]
                if terminator["op"] == "jump":
                    target = terminator["target"]
                    if not reachable[target]:
                        reachable[target] = True
                        changed = True
                elif terminator["op"] == "branch":
                    true_target = terminator["true_target"]
                    false_target = terminator["false_target"]
                    if not reachable[true_target]:
                        reachable[true_target] = True
                        changed = True
                    if not reachable[false_target]:
                        reachable[false_target] = True
                        changed = True
            block_idx = block_idx + 1
    return reachable


def native_ir_v2_path_exists_avoiding(function, target, avoided):
    count = len(function["blocks"])
    if function["entry_block"] == avoided:
        return False
    reached = []
    idx = 0
    while idx < count:
        reached.append(False)
        idx = idx + 1
    reached[function["entry_block"]] = True
    changed = True
    iteration = 0
    while changed:
        iteration = iteration + 1
        if iteration > count * count + 2:
            fail("native-ir rejected code=reachability-convergence;function=" + function["name"])
        changed = False
        block_idx = 0
        while block_idx < count:
            if reached[block_idx]:
                terminator = function["blocks"][block_idx]["terminator"]
                targets = []
                if terminator["op"] == "jump":
                    targets.append(terminator["target"])
                elif terminator["op"] == "branch":
                    targets.append(terminator["true_target"])
                    targets.append(terminator["false_target"])
                target_idx = 0
                while target_idx < len(targets):
                    next_block = targets[target_idx]
                    if next_block != avoided and not reached[next_block]:
                        reached[next_block] = True
                        changed = True
                    target_idx = target_idx + 1
            block_idx = block_idx + 1
    return reached[target]


def native_ir_v2_reverse_postorder(function):
    count = len(function["blocks"])
    visited = range(count)
    stack_blocks = range(count)
    stack_edges = range(count)
    postorder = range(count)
    idx = 0
    while idx < count:
        visited[idx] = False
        stack_blocks[idx] = -1
        stack_edges[idx] = 0
        postorder[idx] = -1
        idx = idx + 1
    depth = 1
    post_count = 0
    stack_blocks[0] = function["entry_block"]
    visited[function["entry_block"]] = True
    while depth > 0:
        stack_idx = depth - 1
        block_id = stack_blocks[stack_idx]
        edge_idx = stack_edges[stack_idx]
        terminator = function["blocks"][block_id]["terminator"]
        edge_count = 0
        next_block = -1
        if terminator["op"] == "jump":
            edge_count = 1
            if edge_idx == 0:
                next_block = terminator["target"]
        elif terminator["op"] == "branch":
            edge_count = 2
            if edge_idx == 0:
                next_block = terminator["true_target"]
            elif edge_idx == 1:
                next_block = terminator["false_target"]
        if edge_idx < edge_count:
            stack_edges[stack_idx] = edge_idx + 1
            if not visited[next_block]:
                visited[next_block] = True
                stack_blocks[depth] = next_block
                stack_edges[depth] = 0
                depth = depth + 1
        else:
            postorder[post_count] = block_id
            post_count = post_count + 1
            depth = depth - 1
    if post_count != count:
        fail("native-ir rejected code=unreachable-block;function=" + function["name"])
    reverse_postorder = range(count)
    idx = 0
    while idx < count:
        reverse_postorder[idx] = postorder[count - idx - 1]
        idx = idx + 1
    return reverse_postorder


def native_ir_v2_immediate_dominators(entry_block, function_name, predecessors_by_block, reverse_postorder):
    count = len(reverse_postorder)
    rpo_index = range(count)
    immediate = range(count)
    idx = 0
    while idx < count:
        rpo_index[idx] = -1
        immediate[idx] = -1
        idx = idx + 1
    idx = 0
    while idx < count:
        rpo_index[reverse_postorder[idx]] = idx
        idx = idx + 1
    immediate[entry_block] = entry_block
    changed = True
    iteration = 0
    while changed:
        iteration = iteration + 1
        if iteration > count + 2:
            fail("native-ir rejected code=dominator-convergence;function=" + function_name)
        changed = False
        rpo_idx = 1
        while rpo_idx < count:
            block_id = reverse_postorder[rpo_idx]
            predecessors = predecessors_by_block[block_id]
            predecessor_idx = 0
            new_immediate = -1
            while predecessor_idx < len(predecessors):
                predecessor = predecessors[predecessor_idx]
                if immediate[predecessor] >= 0:
                    if new_immediate < 0:
                        new_immediate = predecessor
                    else:
                        left = predecessor
                        right = new_immediate
                        while left != right:
                            while rpo_index[left] > rpo_index[right]:
                                left = immediate[left]
                            while rpo_index[right] > rpo_index[left]:
                                right = immediate[right]
                        new_immediate = left
                predecessor_idx = predecessor_idx + 1
            if new_immediate < 0:
                fail("native-ir rejected code=dominator-predecessor;function=" + function_name + ";block=" + str(block_id))
            if immediate[block_id] != new_immediate:
                immediate[block_id] = new_immediate
                changed = True
            rpo_idx = rpo_idx + 1
    return immediate


def native_ir_v2_require_value(function, use_block, use_instruction, value, expected_type, operation):
    if "definition_store" in function:
        if value < 0 or value >= function["definition_count"]:
            fail("native-ir rejected code=value-not-defined;value=" + str(value))
        definition = __tyrion_native_ast_builder_get(function["definition_store"], 0, value)
    else:
        definition = native_ir_v2_definition(function, value)
        if not definition["found"]:
            fail("native-ir rejected code=value-not-defined;value=" + str(value))
    if definition["block"] == use_block:
        if definition["instruction"] >= use_instruction:
            fail("native-ir rejected code=value-not-defined-before-use;value=" + str(value) + ";op=" + operation)
    else:
        definition_preorder = __tyrion_native_ast_builder_get(function["dominator_preorder_store"], 0, definition["block"])
        definition_subtree_end = __tyrion_native_ast_builder_get(function["dominator_subtree_end_store"], 0, definition["block"])
        use_preorder = __tyrion_native_ast_builder_get(function["dominator_preorder_store"], 0, use_block)
        if definition_preorder < 0 or use_preorder < definition_preorder or use_preorder >= definition_subtree_end:
            fail("native-ir rejected code=value-not-dominating;value=" + str(value) + ";op=" + operation)
    if expected_type != "" and definition["type"] != expected_type:
        fail("native-ir rejected code=operation-argument-type;op=" + operation + ";expected=" + expected_type + ";actual=" + definition["type"])
    return definition["type"]


def native_ir_v2_definition_store(function):
    store = __tyrion_native_ast_builder_create()
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            instruction = instructions[instruction_idx]
            __tyrion_native_ast_builder_append(store, 0, {"block": block_idx, "instruction": instruction_idx, "type": instruction["type"]})
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return store


def native_ir_v2_dominator_store(dominators):
    store = __tyrion_native_ast_builder_create()
    block_idx = 0
    while block_idx < len(dominators):
        __tyrion_native_ast_builder_append(store, 0, dominators[block_idx])
        block_idx = block_idx + 1
    return store


def native_ir_v2_dominator_interval_stores(entry_block, immediate):
    count = len(immediate)
    first_child = range(count)
    next_sibling = range(count)
    preorder = range(count)
    subtree_end = range(count)
    block_idx = 0
    while block_idx < count:
        first_child[block_idx] = -1
        next_sibling[block_idx] = -1
        preorder[block_idx] = -1
        subtree_end[block_idx] = -1
        block_idx = block_idx + 1
    block_idx = 0
    while block_idx < count:
        if block_idx != entry_block:
            parent = immediate[block_idx]
            if parent < 0 or parent >= count:
                fail("native-ir rejected code=dominator-parent;block=" + str(block_idx))
            next_sibling[block_idx] = first_child[parent]
            first_child[parent] = block_idx
        block_idx = block_idx + 1

    stack_blocks = range(count)
    stack_children = range(count)
    depth = 1
    visit = 0
    stack_blocks[0] = entry_block
    stack_children[0] = first_child[entry_block]
    preorder[entry_block] = visit
    visit = visit + 1
    while depth > 0:
        stack_idx = depth - 1
        child = stack_children[stack_idx]
        if child >= 0:
            stack_children[stack_idx] = next_sibling[child]
            preorder[child] = visit
            visit = visit + 1
            stack_blocks[depth] = child
            stack_children[depth] = first_child[child]
            depth = depth + 1
        else:
            subtree_end[stack_blocks[stack_idx]] = visit
            depth = depth - 1
    if visit != count:
        fail("native-ir rejected code=dominator-tree-count")
    return {"preorder_store": native_ir_v2_dominator_store(preorder), "subtree_end_store": native_ir_v2_dominator_store(subtree_end)}


def native_ir_v2_instruction_function_context(function):
    callable_kind = ""
    capture_count = 0
    if "callable_kind" in function:
        callable_kind = function["callable_kind"]
    if "capture_count" in function:
        capture_count = function["capture_count"]
    definition_store = native_ir_v2_definition_store(function)
    return {"name": function["name"], "parameters": function["parameters"], "result_type": function["result_type"], "block_count": len(function["blocks"]), "callable_kind": callable_kind, "capture_count": capture_count, "definition_store": definition_store, "definition_count": __tyrion_native_ast_builder_len(definition_store, 0)}


def native_ir_v2_verifier_function_declaration(function):
    source_arity = -1
    callable_kind = ""
    capture_count = 0
    if "source_arity" in function:
        source_arity = function["source_arity"]
    if "callable_kind" in function:
        callable_kind = function["callable_kind"]
    if "capture_count" in function:
        capture_count = function["capture_count"]
    return {"id": function["id"], "name": function["name"], "parameters": function["parameters"], "result_type": function["result_type"], "source_arity": source_arity, "callable_kind": callable_kind, "capture_count": capture_count}


def native_ir_v2_instruction_module_context(module):
    function_store = __tyrion_native_ast_builder_create()
    function_idx = 0
    while function_idx < len(module["functions"]):
        __tyrion_native_ast_builder_append(function_store, 0, native_ir_v2_verifier_function_declaration(module["functions"][function_idx]))
        function_idx = function_idx + 1
    class_ids = []
    if "class_descriptors" in module:
        class_idx = 0
        while class_idx < len(module["class_descriptors"]):
            class_ids = method_append(class_ids, module["class_descriptors"][class_idx]["id"])
            class_idx = class_idx + 1
    constant_count = len(module["constants"])
    if "constant_count" in module:
        constant_count = module["constant_count"]
    global_slot_count = 0
    if "global_slots" in module:
        global_slot_count = len(module["global_slots"])
    attribute_count = 0
    if "attribute_names" in module:
        attribute_count = len(module["attribute_names"])
    return {"constant_count": constant_count, "global_slot_count": global_slot_count, "class_ids": class_ids, "attribute_count": attribute_count, "function_store": function_store, "function_count": __tyrion_native_ast_builder_len(function_store, 0), "externals": module["externals"], "production_direct": module["production_direct"]}


def native_ir_v2_external(module, name):
    idx = 0
    while idx < len(module["externals"]):
        if module["externals"][idx]["name"] == name:
            return module["externals"][idx]
        idx = idx + 1
    fail("native-ir rejected code=external-not-found;name=" + name)


def native_ir_v2_function_by_id(module, function_id):
    if "function_store" in module:
        if function_id < 0 or function_id >= module["function_count"]:
            fail("native-ir rejected code=function-not-found;id=" + str(function_id))
        function = __tyrion_native_ast_builder_get(module["function_store"], 0, function_id)
        if function["id"] != function_id:
            fail("native-ir rejected code=function-id-mismatch;id=" + str(function_id))
        return function
    if function_id < 0 or function_id >= len(module["functions"]):
        fail("native-ir rejected code=function-not-found;id=" + str(function_id))
    function = module["functions"][function_id]
    if function["id"] != function_id:
        fail("native-ir rejected code=function-id-mismatch;id=" + str(function_id))
    return function


def native_ir_v2_has_text(items, value):
    idx = 0
    while idx < len(items):
        if items[idx] == value:
            return True
        idx = idx + 1
    return False


def native_ir_v2_text_lists_equal(left, right):
    if not (len(left) == len(right)):
        return False
    idx = 0
    while idx < len(left):
        if not (left[idx] == right[idx]):
            return False
        idx = idx + 1
    return True


def native_ir_v2_function_has_operation(function, operation):
    if "operation_inventory" in function:
        return native_ir_v2_has_text(function["operation_inventory"], operation)
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            if instructions[instruction_idx]["op"] == operation:
                return True
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return False


def native_ir_v2_function_operation_inventory(function):
    if "operation_inventory" in function:
        return function["operation_inventory"]
    operations = []
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            operation = instructions[instruction_idx]["op"]
            if not native_ir_v2_has_text(operations, operation):
                operations = method_append(operations, operation)
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return operations


def native_ir_v2_function_primitive_manifest(function):
    if "primitive_implementations" in function and "primitive_capabilities" in function:
        return {"implementations": function["primitive_implementations"], "capabilities": function["primitive_capabilities"]}
    implementations = []
    capabilities = []
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            instruction = instructions[instruction_idx]
            if instruction["op"] == "direct_primitive_call":
                implementation = primitive_schema_implementation_for_id(instruction["fields"]["primitive_id"])
                capability = primitive_schema_capability_for_id(instruction["fields"]["primitive_id"])
                if implementation == "" or capability == "":
                    fail("native-ir rejected code=primitive-id")
                if not native_ir_v2_has_text(implementations, implementation):
                    implementations = method_append(implementations, implementation)
                if not native_ir_v2_has_text(capabilities, capability):
                    capabilities = method_append(capabilities, capability)
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return {"implementations": implementations, "capabilities": capabilities}


def native_ir_v2_module_has_operation(module, operation):
    if "streaming_verified" in module and module["streaming_verified"] and "stream_operation_inventory" in module:
        return native_ir_v2_has_text(module["stream_operation_inventory"], operation)
    function_idx = 0
    while function_idx < len(module["functions"]):
        if native_ir_v2_function_has_operation(module["functions"][function_idx], operation):
            return True
        function_idx = function_idx + 1
    return False


def native_ir_v2_module_has_any_operation(module, operations):
    operation_idx = 0
    while operation_idx < len(operations):
        if native_ir_v2_module_has_operation(module, operations[operation_idx]):
            return True
        operation_idx = operation_idx + 1
    return False


def native_ir_v2_slot_root_map(function):
    roots = range(function["frame"]["scalar_spills"])
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            instruction = instructions[instruction_idx]
            root = -1
            if instruction["type"] == "slot_ptr":
                if instruction["op"] == "slot_alloc" or instruction["op"] == "direct_argument_slot" or instruction["op"] == "direct_capture_slot" or instruction["op"] == "direct_generator_saved_slot" or instruction["op"] == "direct_global_slot" or instruction["op"] == "parameter":
                    root = instruction["result"]
                elif "args" in instruction["fields"] and len(instruction["fields"]["args"]) > 0:
                    source = instruction["fields"]["args"][0]
                    if source >= 0 and source < len(roots):
                        root = roots[source]
            roots[instruction["result"]] = root
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    return roots


def native_ir_v2_slot_allocation_ordinal_store(function, root_map):
    ordinals = range(function["frame"]["scalar_spills"])
    value_idx = 0
    while value_idx < len(ordinals):
        ordinals[value_idx] = -1
        value_idx = value_idx + 1
    ordinal = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            instruction = instructions[instruction_idx]
            if instruction["op"] == "slot_alloc":
                ordinals[instruction["result"]] = ordinal
                ordinal = ordinal + 1
            elif instruction["type"] == "slot_ptr":
                root = root_map[instruction["result"]]
                if root >= 0 and ordinals[root] >= 0:
                    ordinals[instruction["result"]] = ordinals[root]
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    store = __tyrion_native_ast_builder_create()
    value_idx = 0
    while value_idx < len(ordinals):
        __tyrion_native_ast_builder_append(store, 0, ordinals[value_idx])
        value_idx = value_idx + 1
    return store


def native_ir_v2_slot_root_mapped(roots, value):
    if value < 0 or value >= len(roots) or roots[value] < 0:
        fail("native-ir rejected code=slot-root-value;value=" + str(value))
    return roots[value]


def native_ir_v2_slot_roots_with_initial_state(function):
    roots = __tyrion_native_ast_builder_create()
    initialized = __tyrion_native_ast_builder_create()
    blocks = function["blocks"]
    block_idx = 0
    while block_idx < len(blocks):
        block = blocks[block_idx]
        instructions = block["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            op = instructions[instruction_idx]["op"]
            if op == "slot_alloc" or op == "direct_argument_slot" or op == "direct_capture_slot" or op == "direct_generator_saved_slot" or op == "direct_global_slot" or (op == "parameter" and instructions[instruction_idx]["type"] == "slot_ptr"):
                __tyrion_native_ast_builder_append(roots, 0, instructions[instruction_idx]["result"])
                initially_initialized = op == "direct_argument_slot" or op == "direct_capture_slot" or op == "direct_generator_saved_slot" or op == "direct_global_slot" or op == "parameter"
                __tyrion_native_ast_builder_append(initialized, 0, initially_initialized)
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    root_lists = __tyrion_native_ast_builder_finish(roots)
    initialized_lists = __tyrion_native_ast_builder_finish(initialized)
    return {"roots": root_lists[0], "initialized": initialized_lists[0]}


def native_ir_v2_slot_root_initially_initialized(function, root):
    definition = native_ir_v2_definition(function, root)
    if not definition["found"]:
        return False
    op = function["blocks"][definition["block"]]["instructions"][definition["instruction"]]["op"]
    return op == "direct_argument_slot" or op == "direct_capture_slot" or op == "direct_generator_saved_slot" or op == "direct_global_slot" or op == "parameter"


def native_ir_v2_slot_root_indices(root_map, roots):
    indices = range(len(root_map))
    value_idx = 0
    while value_idx < len(indices):
        indices[value_idx] = -1
        value_idx = value_idx + 1
    root_idx = 0
    while root_idx < len(roots):
        indices[roots[root_idx]] = root_idx
        root_idx = root_idx + 1
    value_idx = 0
    while value_idx < len(root_map):
        if root_map[value_idx] >= 0:
            indices[value_idx] = indices[root_map[value_idx]]
        value_idx = value_idx + 1
    store = __tyrion_native_ast_builder_create()
    value_idx = 0
    while value_idx < len(indices):
        __tyrion_native_ast_builder_append(store, 0, indices[value_idx])
        value_idx = value_idx + 1
    return store


def native_ir_v2_slot_root_index(value, root_indices):
    root_idx = __tyrion_native_ast_builder_get(root_indices, 0, value)
    if root_idx < 0:
        fail("native-ir rejected code=slot-root-value;value=" + str(value))
    return root_idx


def native_ir_v2_require_initialized_slot_state(value, root_idx, is_uninitialized, block_idx):
    if is_uninitialized:
        fail("native-ir rejected code=slot-read-uninitialized;value=" + str(value) + ";block=" + str(block_idx))


def native_ir_v2_operation_has_slot_state(op):
    return op == "slot_zero" or op == "slot_set_int" or op == "slot_set_bool" or op == "slot_set_none" or op == "direct_slot_set_int_owned" or op == "direct_slot_set_bool_owned" or op == "direct_slot_set_none_owned" or op == "direct_slot_set_float_text" or op == "direct_slot_set_string" or op == "direct_slot_set_collection" or op == "direct_slot_collection_new" or op == "direct_slot_dict_new" or op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice" or op == "direct_slot_method" or op == "direct_file_open" or op == "direct_file_method" or op == "direct_file_close" or op == "direct_process_argv" or op == "direct_primitive_call" or op == "direct_slot_unpack_star" or op == "direct_slot_index_set" or op == "direct_collection_append_owned" or op == "direct_dict_put_owned" or op == "direct_slot_copy_owned" or op == "direct_slot_release" or op == "slot_get_int" or op == "direct_slot_truthy" or op == "direct_iterable_prepare" or op == "direct_iterable_count" or op == "direct_iterable_item_copy" or op == "direct_print_string_slot" or op == "direct_language_call" or op == "direct_slot_closure_new" or op == "direct_closure_call" or op == "direct_generator_new" or op == "direct_object_new" or op == "direct_object_class_id" or op == "direct_object_attr_get" or op == "direct_object_attr_set"


def native_ir_v2_operation_initializes_slot_group_0(op):
    return op == "slot_set_int" or op == "slot_set_bool" or op == "slot_set_none" or op == "direct_slot_set_int_owned" or op == "direct_slot_set_bool_owned" or op == "direct_slot_set_none_owned" or op == "direct_slot_set_float_text" or op == "direct_slot_set_string"


def native_ir_v2_operation_initializes_slot_group_1(op):
    return op == "direct_slot_set_collection" or op == "direct_slot_collection_new" or op == "direct_slot_dict_new" or op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice" or op == "direct_slot_method"


def native_ir_v2_operation_initializes_slot_group_2(op):
    return op == "direct_file_open" or op == "direct_file_method" or op == "direct_process_argv" or op == "direct_primitive_call" or op == "direct_slot_unpack_star" or op == "direct_slot_copy_owned" or op == "direct_iterable_item_copy" or op == "direct_language_call"


def native_ir_v2_operation_initializes_slot_group_3(op):
    return op == "direct_slot_closure_new" or op == "direct_closure_call" or op == "direct_generator_new" or op == "direct_object_new" or op == "direct_object_attr_get"


def native_ir_v2_operation_initializes_slot(op):
    return native_ir_v2_operation_initializes_slot_group_0(op) or native_ir_v2_operation_initializes_slot_group_1(op) or native_ir_v2_operation_initializes_slot_group_2(op) or native_ir_v2_operation_initializes_slot_group_3(op)


def native_ir_v2_verify_all_slot_paths(function, roots, root_initially_initialized, root_map):
    root_count = len(roots)
    if root_count == 0:
        return none
    block_count = len(function["blocks"])
    root_indices = native_ir_v2_slot_root_indices(root_map, roots)
    state_count = block_count * root_count
    entry_uninitialized = range(state_count)
    entry_initialized = range(state_count)
    state_idx = 0
    while state_idx < state_count:
        entry_uninitialized[state_idx] = False
        entry_initialized[state_idx] = False
        state_idx = state_idx + 1
    root_idx = 0
    while root_idx < root_count:
        state_idx = function["entry_block"] * root_count + root_idx
        if root_initially_initialized[root_idx]:
            entry_initialized[state_idx] = True
        else:
            entry_uninitialized[state_idx] = True
        root_idx = root_idx + 1

    queued = range(block_count)
    block_idx = 0
    while block_idx < block_count:
        queued[block_idx] = False
        block_idx = block_idx + 1
    worklist = __tyrion_native_ast_builder_create()
    __tyrion_native_ast_builder_append(worklist, 0, function["entry_block"])
    queued[function["entry_block"]] = True
    work_idx = 0
    while work_idx < __tyrion_native_ast_builder_len(worklist, 0):
        block_idx = __tyrion_native_ast_builder_get(worklist, 0, work_idx)
        work_idx = work_idx + 1
        queued[block_idx] = False
        uninitialized = range(root_count)
        initialized = range(root_count)
        root_idx = 0
        while root_idx < root_count:
            state_idx = block_idx * root_count + root_idx
            uninitialized[root_idx] = entry_uninitialized[state_idx]
            initialized[root_idx] = entry_initialized[state_idx]
            root_idx = root_idx + 1
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            instruction = instructions[instruction_idx]
            op = instruction["op"]
            fields = instruction["fields"]
            if op == "direct_slots_release_contiguous":
                release_idx = 0
                while release_idx < len(fields["args"]):
                    release_root_idx = native_ir_v2_slot_root_index(fields["args"][release_idx], root_indices)
                    uninitialized[release_root_idx] = True
                    initialized[release_root_idx] = False
                    release_idx = release_idx + 1
            if native_ir_v2_operation_has_slot_state(op):
                args = fields["args"]
                destination_idx = native_ir_v2_slot_root_index(args[0], root_indices)

                if op == "slot_get_int" or op == "direct_slot_truthy" or op == "direct_iterable_prepare" or op == "direct_iterable_count" or op == "direct_print_string_slot" or op == "direct_file_close" or op == "direct_object_class_id":
                    native_ir_v2_require_initialized_slot_state(args[0], destination_idx, uninitialized[destination_idx], block_idx)
                if op == "direct_slot_copy_owned" or op == "direct_iterable_item_copy" or op == "direct_collection_append_owned" or op == "direct_dict_put_owned":
                    source_root_idx = native_ir_v2_slot_root_index(args[1], root_indices)
                    native_ir_v2_require_initialized_slot_state(args[1], source_root_idx, uninitialized[source_root_idx], block_idx)
                if op == "direct_collection_append_owned" or op == "direct_dict_put_owned":
                    native_ir_v2_require_initialized_slot_state(args[0], destination_idx, uninitialized[destination_idx], block_idx)
                if op == "direct_dict_put_owned":
                    source_root_idx = native_ir_v2_slot_root_index(args[2], root_indices)
                    native_ir_v2_require_initialized_slot_state(args[2], source_root_idx, uninitialized[source_root_idx], block_idx)
                if op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice":
                    source_idx = 1
                    while source_idx < len(args):
                        source_root_idx = native_ir_v2_slot_root_index(args[source_idx], root_indices)
                        native_ir_v2_require_initialized_slot_state(args[source_idx], source_root_idx, uninitialized[source_root_idx], block_idx)
                        source_idx = source_idx + 1
                if op == "direct_slot_index_set" or op == "direct_object_attr_set":
                    source_idx = 0
                    while source_idx < len(args):
                        source_root_idx = native_ir_v2_slot_root_index(args[source_idx], root_indices)
                        native_ir_v2_require_initialized_slot_state(args[source_idx], source_root_idx, uninitialized[source_root_idx], block_idx)
                        source_idx = source_idx + 1
                if op == "direct_slot_unpack_star":
                    source_root_idx = native_ir_v2_slot_root_index(args[1], root_indices)
                    native_ir_v2_require_initialized_slot_state(args[1], source_root_idx, uninitialized[source_root_idx], block_idx)
                if op == "direct_slot_method" or op == "direct_file_open" or op == "direct_file_method" or op == "direct_language_call" or op == "direct_primitive_call" or op == "direct_slot_closure_new" or op == "direct_generator_new" or op == "direct_closure_call":
                    source_idx = 1
                    while source_idx < len(args):
                        source_root_idx = native_ir_v2_slot_root_index(args[source_idx], root_indices)
                        native_ir_v2_require_initialized_slot_state(args[source_idx], source_root_idx, uninitialized[source_root_idx], block_idx)
                        source_idx = source_idx + 1
                if op == "direct_object_attr_get":
                    source_root_idx = native_ir_v2_slot_root_index(args[1], root_indices)
                    native_ir_v2_require_initialized_slot_state(args[1], source_root_idx, uninitialized[source_root_idx], block_idx)

                if op == "slot_zero" or op == "direct_slot_release":
                    uninitialized[destination_idx] = True
                    initialized[destination_idx] = False
                elif native_ir_v2_operation_initializes_slot(op):
                    uninitialized[destination_idx] = False
                    initialized[destination_idx] = True
            instruction_idx = instruction_idx + 1
        terminator = function["blocks"][block_idx]["terminator"]
        targets = []
        if terminator["op"] == "jump":
            targets = method_append(targets, terminator["target"])
        elif terminator["op"] == "branch":
            targets = method_append(targets, terminator["true_target"])
            targets = method_append(targets, terminator["false_target"])
        target_idx = 0
        while target_idx < len(targets):
            target = targets[target_idx]
            target_changed = False
            root_idx = 0
            while root_idx < root_count:
                state_idx = target * root_count + root_idx
                if uninitialized[root_idx] and not entry_uninitialized[state_idx]:
                    entry_uninitialized[state_idx] = True
                    target_changed = True
                if initialized[root_idx] and not entry_initialized[state_idx]:
                    entry_initialized[state_idx] = True
                    target_changed = True
                root_idx = root_idx + 1
            if target_changed and not queued[target]:
                __tyrion_native_ast_builder_append(worklist, 0, target)
                queued[target] = True
            target_idx = target_idx + 1
    return none


def native_ir_v2_verify_slot_paths(function, root, root_map):
    block_count = len(function["blocks"])
    uninitialized = []
    initialized = []
    block_idx = 0
    while block_idx < block_count:
        uninitialized = method_append(uninitialized, False)
        initialized = method_append(initialized, False)
        block_idx = block_idx + 1
    if native_ir_v2_slot_root_initially_initialized(function, root):
        initialized[0] = True
    else:
        uninitialized[0] = True

    changed = True
    iteration = 0
    iteration_limit = block_count + block_count + 2
    while changed:
        iteration = iteration + 1
        if iteration > iteration_limit:
            fail("native-ir rejected code=slot-state-convergence;function=" + function["name"])
        changed = False
        block_idx = 0
        while block_idx < block_count:
            blocks = function["blocks"]
            block = blocks[block_idx]
            instructions = block["instructions"]
            can_be_uninitialized = uninitialized[block_idx]
            can_be_initialized = initialized[block_idx]
            instruction_idx = 0
            while instruction_idx < len(instructions):
                instruction = instructions[instruction_idx]
                op = instruction["op"]
                if op == "slot_zero" or op == "slot_set_int" or op == "slot_set_bool" or op == "slot_set_none" or op == "direct_slot_set_int_owned" or op == "direct_slot_set_bool_owned" or op == "direct_slot_set_none_owned" or op == "direct_slot_set_float_text" or op == "direct_slot_set_string" or op == "direct_slot_set_collection" or op == "direct_slot_collection_new" or op == "direct_slot_dict_new" or op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice" or op == "direct_slot_method" or op == "direct_file_open" or op == "direct_file_method" or op == "direct_file_close" or op == "direct_process_argv" or op == "direct_primitive_call" or op == "direct_slot_unpack_star" or op == "direct_slot_index_set" or op == "direct_collection_append_owned" or op == "direct_dict_put_owned" or op == "direct_slot_copy_owned" or op == "direct_slot_release" or op == "slot_get_int" or op == "direct_slot_truthy" or op == "direct_iterable_prepare" or op == "direct_iterable_count" or op == "direct_iterable_item_copy" or op == "direct_print_string_slot" or op == "direct_language_call" or op == "direct_slot_closure_new" or op == "direct_closure_call" or op == "direct_generator_new" or op == "direct_object_new" or op == "direct_object_class_id" or op == "direct_object_attr_get" or op == "direct_object_attr_set":
                    args = instruction["fields"]["args"]
                    instruction_root = native_ir_v2_slot_root_mapped(root_map, args[0])
                    reads_root = False
                    if instruction_root == root and (op == "slot_get_int" or op == "direct_slot_truthy" or op == "direct_iterable_prepare" or op == "direct_iterable_count" or op == "direct_collection_append_owned" or op == "direct_dict_put_owned" or op == "direct_print_string_slot"):
                        reads_root = True
                    if op == "direct_slot_copy_owned" or op == "direct_iterable_item_copy" or op == "direct_collection_append_owned" or op == "direct_dict_put_owned":
                        source_root = native_ir_v2_slot_root_mapped(root_map, args[1])
                        if source_root == root:
                            reads_root = True
                    if op == "direct_dict_put_owned":
                        value_root = native_ir_v2_slot_root_mapped(root_map, args[2])
                        if value_root == root:
                            reads_root = True
                    if op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_slot_index_set":
                        source_idx = 0
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_slot_unpack_star":
                        source_root = native_ir_v2_slot_root_mapped(root_map, args[1])
                        if source_root == root:
                            reads_root = True
                    if op == "direct_slot_method":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_file_open" or op == "direct_file_method":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_file_close" and instruction_root == root:
                        reads_root = True
                    if op == "direct_language_call":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_primitive_call":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_slot_closure_new":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_generator_new":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_closure_call":
                        source_idx = 1
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if op == "direct_object_class_id":
                        if instruction_root == root:
                            reads_root = True
                    if op == "direct_object_attr_get":
                        source_root = native_ir_v2_slot_root_mapped(root_map, args[1])
                        if source_root == root:
                            reads_root = True
                    if op == "direct_object_attr_set":
                        source_idx = 0
                        while source_idx < len(args):
                            source_root = native_ir_v2_slot_root_mapped(root_map, args[source_idx])
                            if source_root == root:
                                reads_root = True
                            source_idx = source_idx + 1
                    if reads_root and can_be_uninitialized:
                        fail("native-ir rejected code=slot-read-uninitialized;value=" + str(root) + ";block=" + str(block_idx))
                    if instruction_root == root and (op == "slot_zero" or op == "direct_slot_release"):
                        can_be_uninitialized = can_be_uninitialized or can_be_initialized
                        can_be_initialized = False
                    elif instruction_root == root and (op == "slot_set_int" or op == "slot_set_bool" or op == "slot_set_none" or op == "direct_slot_set_int_owned" or op == "direct_slot_set_bool_owned" or op == "direct_slot_set_none_owned" or op == "direct_slot_set_float_text" or op == "direct_slot_set_string" or op == "direct_slot_set_collection" or op == "direct_slot_collection_new" or op == "direct_slot_dict_new" or op == "direct_slot_binary" or op == "direct_slot_unary" or op == "direct_slot_index" or op == "direct_slot_slice" or op == "direct_slot_method" or op == "direct_file_open" or op == "direct_file_method" or op == "direct_process_argv" or op == "direct_primitive_call" or op == "direct_slot_unpack_star" or op == "direct_slot_copy_owned" or op == "direct_iterable_item_copy" or op == "direct_language_call" or op == "direct_slot_closure_new" or op == "direct_closure_call" or op == "direct_generator_new" or op == "direct_object_new" or op == "direct_object_attr_get"):
                        can_be_initialized = can_be_initialized or can_be_uninitialized
                        can_be_uninitialized = False
                instruction_idx = instruction_idx + 1
            terminator = block["terminator"]
            targets = []
            if terminator["op"] == "jump":
                targets = method_append(targets, terminator["target"])
            elif terminator["op"] == "branch":
                targets = method_append(targets, terminator["true_target"])
                targets = method_append(targets, terminator["false_target"])
            target_idx = 0
            while target_idx < len(targets):
                target = targets[target_idx]
                if can_be_uninitialized and not uninitialized[target]:
                    uninitialized[target] = True
                    changed = True
                if can_be_initialized and not initialized[target]:
                    initialized[target] = True
                    changed = True
                target_idx = target_idx + 1
            block_idx = block_idx + 1


def native_ir_v2_verify_slot_initialization(function, root_map):
    root_inventory = native_ir_v2_slot_roots_with_initial_state(function)
    native_ir_v2_verify_all_slot_paths(function, root_inventory["roots"], root_inventory["initialized"], root_map)


def verify_native_ir_v2_instruction(module, function, block_idx, instruction_idx, instruction):
    op = instruction["op"]
    fields = instruction["fields"]
    if op == "parameter":
        parameter_idx = fields["index"]
        if parameter_idx < 0 or parameter_idx >= len(function["parameters"]):
            fail("native-ir rejected code=parameter-index;index=" + str(parameter_idx))
        if instruction["type"] != function["parameters"][parameter_idx]:
            fail("native-ir rejected code=parameter-type;index=" + str(parameter_idx))
        return
    if op == "const_int":
        if not native_ir_v2_integer_type(instruction["type"]):
            fail("native-ir rejected code=const-int-type")
        return
    if op == "const_address":
        if instruction["type"] != "ptr":
            fail("native-ir rejected code=const-address-type")
        if not native_ir_constant_exists(module, fields["constant_id"]):
            fail("native-ir rejected code=constant-not-found;id=" + str(fields["constant_id"]))
        return
    if op == "add" or op == "sub" or op == "mul":
        args = fields["args"]
        if len(args) != 2 or not native_ir_v2_integer_type(instruction["type"]) or instruction["type"] == "i1":
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, args[0], instruction["type"], op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, args[1], instruction["type"], op)
        return
    if op == "and_i1":
        args = fields["args"]
        if len(args) != 2 or instruction["type"] != "i1":
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, args[0], "i1", op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, args[1], "i1", op)
        return
    if op == "eq" or op == "ne" or op == "lt" or op == "le" or op == "gt" or op == "ge":
        args = fields["args"]
        if len(args) != 2 or instruction["type"] != "i1":
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        left_type = native_ir_v2_require_value(function, block_idx, instruction_idx, args[0], "", op)
        if not native_ir_v2_integer_type(left_type):
            fail("native-ir rejected code=comparison-type;op=" + op + ";type=" + left_type)
        native_ir_v2_require_value(function, block_idx, instruction_idx, args[1], left_type, op)
        return
    if op == "slot_alloc":
        if instruction["type"] != "slot_ptr" or len(fields["args"]) != 0:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        return
    if op == "direct_global_frame":
        if instruction["type"] != "ptr" or len(fields["args"]) > 1:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        if len(fields["args"]) == 1:
            native_ir_v2_require_value(function, block_idx, instruction_idx, fields["args"][0], "slot_ptr", op)
        return
    if op == "direct_global_slot":
        if instruction["type"] != "slot_ptr" or len(fields["args"]) != 1 or fields["index"] < 0 or fields["index"] >= module["global_slot_count"]:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, fields["args"][0], "ptr", op)
        return
    if op == "direct_closure_globals" or op == "direct_generator_globals":
        if instruction["type"] != "ptr" or len(fields["args"]) != 1:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, fields["args"][0], "ptr", op)
        return
    if op == "direct_argument_slot":
        if instruction["type"] != "slot_ptr" or len(fields["args"]) != 1 or fields["index"] < 0:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, fields["args"][0], "ptr", op)
        return
    if op == "direct_capture_slot":
        if instruction["type"] != "slot_ptr" or len(fields["args"]) != 1 or fields["index"] < 0:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        native_ir_v2_require_value(function, block_idx, instruction_idx, fields["args"][0], "ptr", op)
        if "capture_count" in function and fields["index"] >= function["capture_count"]:
            fail("native-ir rejected code=capture-index;function=" + function["name"])
        return
    if op == "slot_zero":
