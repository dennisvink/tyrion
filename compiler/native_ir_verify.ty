        return
    if op == "direct_closure_call":
        args = fields["args"]
        argc = fields["argc"]
        if instruction["type"] != "i32" or argc < 0 or len(args) != argc + 3 or len(fields["targets"]) == 0:
            fail("native-ir rejected code=operation-arity-or-type;op=" + op)
        arg_idx = 0
        while arg_idx < len(args):
            native_ir_v2_require_value(function, block_idx, instruction_idx, args[arg_idx], "slot_ptr", op)
            arg_idx = arg_idx + 1
        target_idx = 0
        while target_idx < len(fields["targets"]):
            target = fields["targets"][target_idx]
            callee = native_ir_v2_function_by_id(module, target["id"])
            if callee["name"] != target["name"] or (callee["callable_kind"] != "lambda" and callee["callable_kind"] != "function") or callee["source_arity"] != target["arity"]:
                fail("native-ir rejected code=closure-dispatch-target;id=" + str(target["id"]))
            target_idx = target_idx + 1
        return
    if op == "call_external":
        external = native_ir_v2_external(module, fields["name"])
        args = fields["args"]
        if len(args) != len(external["parameters"]):
            fail("native-ir rejected code=external-arity;name=" + fields["name"])
        arg_idx = 0
        while arg_idx < len(args):
            native_ir_v2_require_value(function, block_idx, instruction_idx, args[arg_idx], external["parameters"][arg_idx], op)
            arg_idx = arg_idx + 1
        if instruction["type"] != external["result_type"]:
            fail("native-ir rejected code=external-result-type;name=" + fields["name"])
        return
    if module["production_direct"] and (op == "ast_from_static" or op == "expr_eval" or op == "statement_execute" or op == "statement_execute_result" or op == "statement_execute_exception"):
        fail("native-ir rejected code=direct-evaluator-operation;op=" + op)
    fail("native-ir rejected code=unknown-operation;op=" + op)


def verify_native_ir_v2_terminator(function, block_idx, use_instruction, terminator):
    op = terminator["op"]
    if op == "return":
        native_ir_v2_require_value(function, block_idx, use_instruction, terminator["value"], function["result_type"], op)
        return
    if op == "jump":
        if terminator["target"] < 0 or terminator["target"] >= function["block_count"]:
            fail("native-ir rejected code=jump-target;function=" + function["name"])
        return
    if op == "branch":
        if terminator["true_target"] < 0 or terminator["true_target"] >= function["block_count"] or terminator["false_target"] < 0 or terminator["false_target"] >= function["block_count"]:
            fail("native-ir rejected code=branch-target;function=" + function["name"])
        native_ir_v2_require_value(function, block_idx, use_instruction, terminator["condition"], "i1", op)
        return
    if op == "unreachable":
        return
    fail("native-ir rejected code=unsupported-terminator;op=" + op)


def verify_native_ir_v2_function(module, function):
    function["operation_inventory"] = native_ir_v2_function_operation_inventory(function)
    if len(function["blocks"]) == 0 or function["entry_block"] != 0:
        fail("native-ir rejected code=entry-block;function=" + function["name"])
    frame = function["frame"]
    if frame["local_slots"] < 0 or frame["control_slots"] < 0 or frame["temporary_slots"] < 0 or frame["scalar_spills"] < 0:
        fail("native-ir rejected code=negative-frame-size;function=" + function["name"])
    if frame["scalar_spills"] > 268435455:
        fail("native-ir rejected code=frame-overflow;function=" + function["name"])
    if native_ir_v2_has_text(function["operation_inventory"], "call_external") or native_ir_v2_has_text(function["operation_inventory"], "print_int") or native_ir_v2_has_text(function["operation_inventory"], "print_bool") or native_ir_v2_has_text(function["operation_inventory"], "direct_print_string_slot"):
        if not native_ir_v2_has_text(function["effects"], "io"):
            fail("native-ir rejected code=missing-effect;function=" + function["name"] + ";effect=io")
    if (native_ir_v2_has_text(function["operation_inventory"], "call_external") or native_ir_v2_has_text(function["operation_inventory"], "print_int") or native_ir_v2_has_text(function["operation_inventory"], "print_bool") or native_ir_v2_has_text(function["operation_inventory"], "direct_print_string_slot")) and not native_ir_v2_has_text(module["components"], "print"):
        fail("native-ir rejected code=missing-component;component=print")
    has_aggregate_operation = native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_int_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_bool_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_none_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_float_text") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_string") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_set_collection") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_collection_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_collection_append_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_dict_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_dict_put_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_binary") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_unary") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_index") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_slice") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_method") or native_ir_v2_has_text(function["operation_inventory"], "direct_file_open") or native_ir_v2_has_text(function["operation_inventory"], "direct_file_method") or native_ir_v2_has_text(function["operation_inventory"], "direct_file_close") or native_ir_v2_has_text(function["operation_inventory"], "direct_process_argv") or native_ir_v2_has_text(function["operation_inventory"], "direct_primitive_call") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_unpack_star") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_index_set") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_truthy") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_copy_owned") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_release") or native_ir_v2_has_text(function["operation_inventory"], "direct_iterable_prepare") or native_ir_v2_has_text(function["operation_inventory"], "direct_iterable_count") or native_ir_v2_has_text(function["operation_inventory"], "direct_iterable_item_copy") or native_ir_v2_has_text(function["operation_inventory"], "direct_language_call") or native_ir_v2_has_text(function["operation_inventory"], "direct_slot_closure_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_closure_call") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_saved_slot") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_class_id") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_attr_get") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_attr_set")
    has_aggregate_operation = has_aggregate_operation or native_ir_v2_has_text(function["operation_inventory"], "direct_slots_release_contiguous")
    if has_aggregate_operation and not native_ir_v2_has_text(module["components"], "aggregate-core"):
        fail("native-ir rejected code=missing-component;component=aggregate-core")
    has_file_operation = native_ir_v2_has_text(function["operation_inventory"], "direct_file_open") or native_ir_v2_has_text(function["operation_inventory"], "direct_file_method") or native_ir_v2_has_text(function["operation_inventory"], "direct_file_close")
    if has_file_operation and not native_ir_v2_has_text(module["components"], "file"):
        fail("native-ir rejected code=missing-component;component=file")
    has_object_operation = native_ir_v2_has_text(function["operation_inventory"], "direct_object_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_class_id") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_attr_get") or native_ir_v2_has_text(function["operation_inventory"], "direct_object_attr_set")
    if has_object_operation and not native_ir_v2_has_text(module["components"], "objects"):
        fail("native-ir rejected code=missing-component;component=objects")
    has_generator_operation = native_ir_v2_has_text(function["operation_inventory"], "direct_generator_new") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_saved_slot") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_state") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_set_state") or native_ir_v2_has_text(function["operation_inventory"], "direct_generator_finish")
    if has_generator_operation and not native_ir_v2_has_text(module["components"], "generators"):
        fail("native-ir rejected code=missing-component;component=generators")
    if has_aggregate_operation and function["ownership"] != "owned-frame-cleanup":
        fail("native-ir rejected code=ownership-contract;function=" + function["name"])
    if has_aggregate_operation and module["ownership_manifest"] != "direct-owned-aggregate":
        fail("native-ir rejected code=ownership-manifest")
    next_result = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        block = function["blocks"][block_idx]
        if block["id"] != block_idx:
            fail("native-ir rejected code=noncanonical-block-id;function=" + function["name"])
        terminator = block["terminator"]
        if terminator["op"] == "jump":
            if not native_ir_v2_block_target_exists(function, terminator["target"]):
                fail("native-ir rejected code=jump-target;function=" + function["name"])
        elif terminator["op"] == "branch":
            if not native_ir_v2_block_target_exists(function, terminator["true_target"]) or not native_ir_v2_block_target_exists(function, terminator["false_target"]):
                fail("native-ir rejected code=branch-target;function=" + function["name"])
        instruction_idx = 0
        while instruction_idx < len(block["instructions"]):
            instruction = block["instructions"][instruction_idx]
            if instruction["result"] != next_result:
                fail("native-ir rejected code=noncanonical-result-id;expected=" + str(next_result) + ";actual=" + str(instruction["result"]))
            next_result = next_result + 1
            instruction_idx = instruction_idx + 1
        block_idx = block_idx + 1
    if frame["scalar_spills"] < next_result:
        fail("native-ir rejected code=scalar-spill-underflow;function=" + function["name"])
    allocated_slots = 0
    count_block_idx = 0
    while count_block_idx < len(function["blocks"]):
        count_instruction_idx = 0
        count_instructions = function["blocks"][count_block_idx]["instructions"]
        while count_instruction_idx < len(count_instructions):
            if count_instructions[count_instruction_idx]["op"] == "slot_alloc":
                allocated_slots = allocated_slots + 1
            count_instruction_idx = count_instruction_idx + 1
        count_block_idx = count_block_idx + 1
    if allocated_slots != frame["local_slots"] + frame["control_slots"] + frame["temporary_slots"]:
        fail("native-ir rejected code=frame-slot-count;function=" + function["name"])
    reachable = native_ir_v2_reachable_blocks(function)
    block_idx = 0
    while block_idx < len(reachable):
        if not reachable[block_idx]:
            fail("native-ir rejected code=unreachable-block;function=" + function["name"] + ";block=" + str(block_idx))
        block_idx = block_idx + 1
    predecessors = native_ir_v2_predecessor_matrix(function)
    reverse_postorder = native_ir_v2_reverse_postorder(function)
    dominators = native_ir_v2_immediate_dominators(function["entry_block"], function["name"], predecessors, reverse_postorder)
    root_map = native_ir_v2_slot_root_map(function)
    instruction_function = native_ir_v2_instruction_function_context(function)
    instruction_function["slot_allocation_ordinal_store"] = native_ir_v2_slot_allocation_ordinal_store(function, root_map)
    dominator_intervals = native_ir_v2_dominator_interval_stores(function["entry_block"], dominators)
    instruction_function["dominator_preorder_store"] = dominator_intervals["preorder_store"]
    instruction_function["dominator_subtree_end_store"] = dominator_intervals["subtree_end_store"]
    dominators = none
    instruction_module = native_ir_v2_instruction_module_context(module)
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instructions = function["blocks"][block_idx]["instructions"]
        instruction_idx = 0
        while instruction_idx < len(instructions):
            verify_native_ir_v2_instruction(instruction_module, instruction_function, block_idx, instruction_idx, instructions[instruction_idx])
            instruction_idx = instruction_idx + 1
        verify_native_ir_v2_terminator(instruction_function, block_idx, len(instructions) + 1, function["blocks"][block_idx]["terminator"])
        block_idx = block_idx + 1
    native_ir_v2_verify_slot_initialization(function, root_map)
    return function


def verify_native_ir_v2(module):
    if module["contract"] != "tyrion-native-ir-v2":
        fail("native-ir rejected code=contract-version")
    if module["target_independent_abi_version"] != 2:
        fail("native-ir rejected code=abi-version")
    if len(module["functions"]) == 0:
        fail("native-ir rejected code=no-functions")
    inventory_function_idx = 0
    while inventory_function_idx < len(module["functions"]):
        inventory_function = module["functions"][inventory_function_idx]
        if not ("streaming_verified" in module) or not module["streaming_verified"]:
            inventory_function["operation_inventory"] = native_ir_v2_function_operation_inventory(inventory_function)
        inventory_function_idx = inventory_function_idx + 1
    component_idx = 0
    while component_idx < len(module["components"]):
        prior_component = 0
        while prior_component < component_idx:
            if module["components"][prior_component] == module["components"][component_idx]:
                fail("native-ir rejected code=duplicate-component;component=" + module["components"][component_idx])
            prior_component = prior_component + 1
        component_idx = component_idx + 1
    if not native_ir_v2_has_text(module["components"], "scalar-core"):
        fail("native-ir rejected code=missing-component;component=scalar-core")
    if "root_manifest" in module:
        root_manifest = module["root_manifest"]
        if root_manifest["contract"] != "tyrion-native-direct-roots-v1":
            fail("native-ir rejected code=root-manifest-contract")
        if root_manifest["target_backend"] == "":
            fail("native-ir rejected code=root-manifest-target")
        if not native_ir_v2_text_lists_equal(root_manifest["entry_roots"], ["main"]):
            fail("native-ir rejected code=root-manifest-entry-roots")
        root_idx = 0
        while root_idx < len(root_manifest["address_taken_roots"]):
            root_name = root_manifest["address_taken_roots"][root_idx]
            root_function = native_ir_function_by_name(module, root_name)
            if not ("callable_kind" in root_function) or (root_function["callable_kind"] != "lambda" and root_function["callable_kind"] != "function"):
                fail("native-ir rejected code=root-manifest-address-taken-kind;name=" + root_name)
            if not ("address_taken" in root_function) or not root_function["address_taken"]:
                fail("native-ir rejected code=root-manifest-address-taken-metadata;name=" + root_name)
            prior_root = 0
            while prior_root < root_idx:
                if root_manifest["address_taken_roots"][prior_root] == root_name:
                    fail("native-ir rejected code=root-manifest-address-taken-duplicate;name=" + root_name)
                prior_root = prior_root + 1
            root_idx = root_idx + 1
        manifest_function_idx = 0
        while manifest_function_idx < len(module["functions"]):
            manifest_function = module["functions"][manifest_function_idx]
            if "address_taken" in manifest_function and manifest_function["address_taken"] and not native_ir_v2_has_text(root_manifest["address_taken_roots"], manifest_function["name"]):
                fail("native-ir rejected code=root-manifest-address-taken-missing;name=" + manifest_function["name"])
            manifest_function_idx = manifest_function_idx + 1
    extension_idx = 0
    while extension_idx < len(module["extensions"]):
        extension = module["extensions"][extension_idx]
        if extension["id"] != extension_idx:
            fail("native-ir rejected code=noncanonical-extension-id")
        if static_extension_identifier_valid(extension["name"]) != True:
            fail("native-ir rejected code=invalid-extension-name")
        if static_extension_identifier_valid(extension["call_symbol"]) != True:
            fail("native-ir rejected code=invalid-extension-symbol")
        extension_idx = extension_idx + 1
    if "exception_abi" in module:
        if module["exception_abi"] != "caller-owned-slot-status-v1":
            fail("native-ir rejected code=exception-abi")
        if not native_ir_v2_has_text(module["components"], "exceptions"):
            fail("native-ir rejected code=missing-component;component=exceptions")
    if "generator_abi" in module:
        if module["generator_abi"] != "owned-state-resume-status-v1":
            fail("native-ir rejected code=generator-abi")
        if not native_ir_v2_has_text(module["components"], "generators"):
            fail("native-ir rejected code=missing-component;component=generators")
    expected_primitive_implementations = []
    expected_primitive_capabilities = []
    primitive_function_idx = 0
    if "streaming_verified" in module and module["streaming_verified"]:
        expected_primitive_implementations = module["stream_primitive_implementations"]
        expected_primitive_capabilities = module["stream_primitive_capabilities"]
        primitive_function_idx = len(module["functions"])
    while primitive_function_idx < len(module["functions"]):
        primitive_function = module["functions"][primitive_function_idx]
        primitive_manifest = native_ir_v2_function_primitive_manifest(primitive_function)
        if "streaming_verified" in module and module["streaming_verified"]:
            primitive_manifest = {"implementations": primitive_function["primitive_implementations"], "capabilities": primitive_function["primitive_capabilities"]}
        primitive_implementation_idx = 0
        while primitive_implementation_idx < len(primitive_manifest["implementations"]):
            primitive_implementation = primitive_manifest["implementations"][primitive_implementation_idx]
            if not native_ir_v2_has_text(expected_primitive_implementations, primitive_implementation):
                expected_primitive_implementations = method_append(expected_primitive_implementations, primitive_implementation)
            primitive_implementation_idx = primitive_implementation_idx + 1
        primitive_capability_idx = 0
        while primitive_capability_idx < len(primitive_manifest["capabilities"]):
            primitive_capability = primitive_manifest["capabilities"][primitive_capability_idx]
            if not native_ir_v2_has_text(expected_primitive_capabilities, primitive_capability):
                expected_primitive_capabilities = method_append(expected_primitive_capabilities, primitive_capability)
            primitive_capability_idx = primitive_capability_idx + 1
        primitive_function_idx = primitive_function_idx + 1
    if len(expected_primitive_implementations) > 0 or "primitive_implementations" in module or "primitive_capabilities" in module:
        if not ("primitive_implementations" in module) or not ("primitive_capabilities" in module):
            fail("native-ir rejected code=primitive-manifest-missing")
        if not native_ir_v2_text_lists_equal(module["primitive_implementations"], expected_primitive_implementations):
            fail("native-ir rejected code=primitive-implementation-manifest")
        if not native_ir_v2_text_lists_equal(module["primitive_capabilities"], expected_primitive_capabilities):
            fail("native-ir rejected code=primitive-capability-manifest")
    if "root_manifest" in module:
        if not native_ir_v2_text_lists_equal(module["root_manifest"]["primitive_roots"], module["primitive_implementations"]):
            fail("native-ir rejected code=root-manifest-primitive-roots")
        if not native_ir_v2_text_lists_equal(module["root_manifest"]["runtime_roots"], module["components"]):
            fail("native-ir rejected code=root-manifest-runtime-roots")
    expected_components = ["scalar-core"]
    aggregate_operations = ["direct_slot_set_int_owned", "direct_slot_set_bool_owned", "direct_slot_set_none_owned", "direct_slot_set_float_text", "direct_slot_set_string", "direct_slot_set_collection", "direct_slot_collection_new", "direct_collection_append_owned", "direct_slot_dict_new", "direct_dict_put_owned", "direct_slot_binary", "direct_slot_unary", "direct_slot_index", "direct_slot_slice", "direct_slot_method", "direct_file_open", "direct_file_method", "direct_file_close", "direct_process_argv", "direct_primitive_call", "direct_slot_unpack_star", "direct_slot_index_set", "direct_slot_truthy", "direct_slot_copy_owned", "direct_slot_release", "direct_iterable_prepare", "direct_iterable_count", "direct_iterable_item_copy", "direct_language_call", "direct_slot_closure_new", "direct_closure_call", "direct_generator_new", "direct_generator_saved_slot", "direct_generator_state", "direct_generator_set_state", "direct_generator_finish", "direct_object_new", "direct_object_class_id", "direct_object_attr_get", "direct_object_attr_set"]
    aggregate_operations = method_append(aggregate_operations, "direct_slots_release_contiguous")
    if native_ir_v2_module_has_any_operation(module, aggregate_operations):
        expected_components = method_append(expected_components, "aggregate-core")
    print_operations = ["call_external", "print_int", "print_bool", "direct_print_string_slot"]
    if native_ir_v2_module_has_any_operation(module, print_operations):
        expected_components = method_append(expected_components, "print")
    object_operations = ["direct_object_new", "direct_object_class_id", "direct_object_attr_get", "direct_object_attr_set"]
    if native_ir_v2_module_has_any_operation(module, object_operations):
        expected_components = method_append(expected_components, "objects")
    if "exception_abi" in module:
        expected_components = method_append(expected_components, "exceptions")
    generator_operations = ["direct_generator_new", "direct_generator_saved_slot", "direct_generator_state", "direct_generator_set_state", "direct_generator_finish"]
    if native_ir_v2_module_has_any_operation(module, generator_operations):
        expected_components = method_append(expected_components, "generators")
    file_operations = ["direct_file_open", "direct_file_method", "direct_file_close"]
    if native_ir_v2_module_has_any_operation(module, file_operations):
        expected_components = method_append(expected_components, "file")
    capability_idx = 0
    while capability_idx < len(expected_primitive_capabilities):
        capability = expected_primitive_capabilities[capability_idx]
        component = ""
        if capability == "process":
            component = "process"
        elif capability == "collections":
            component = "collections"
        elif capability == "compiler-file":
            component = "compiler-file"
        elif capability == "compiler-writer":
            component = "writer"
        elif capability == "host-extension":
            component = "host-extension"
        elif capability == "tcp":
            component = "tcp"
        elif capability == "terminal":
            component = "terminal"
        elif capability == "clock":
            component = "clock"
        if component != "" and not native_ir_v2_has_text(expected_components, component):
            expected_components = method_append(expected_components, component)
        capability_idx = capability_idx + 1
    implementation_idx = 0
    while implementation_idx < len(expected_primitive_implementations):
        implementation = expected_primitive_implementations[implementation_idx]
        if (implementation == "ast_builder_create" or implementation == "ast_builder_len" or implementation == "ast_builder_append" or implementation == "ast_builder_finish" or implementation == "ast_builder_get") and not native_ir_v2_has_text(expected_components, "compiler-ast-builder"):
            expected_components = method_append(expected_components, "compiler-ast-builder")
        if (implementation == "token_builder_count" or implementation == "token_builder_append" or implementation == "token_builder_field") and not native_ir_v2_has_text(expected_components, "compiler-token"):
            expected_components = method_append(expected_components, "compiler-token")
        implementation_idx = implementation_idx + 1
    expected_component_idx = 0
    while expected_component_idx < len(expected_components):
        if not native_ir_v2_has_text(module["components"], expected_components[expected_component_idx]):
            fail("native-ir rejected code=missing-component;component=" + expected_components[expected_component_idx])
        expected_component_idx = expected_component_idx + 1
    if not native_ir_v2_text_lists_equal(module["components"], expected_components):
        fail("native-ir rejected code=component-manifest")
    constant_idx = 0
    while constant_idx < len(module["constants"]):
        constant = module["constants"][constant_idx]
        if constant["id"] != constant_idx:
            fail("native-ir rejected code=noncanonical-constant-id")
        if constant["kind"] != "bytes" and constant["kind"] != "string":
            fail("native-ir rejected code=unknown-constant-kind;index=" + str(constant_idx))
        if constant["length"] != len(constant["value"]):
            fail("native-ir rejected code=constant-length;index=" + str(constant_idx))
        constant_idx = constant_idx + 1
    external_idx = 0
    while external_idx < len(module["externals"]):
        external = module["externals"][external_idx]
        if external["name"] == "":
            fail("native-ir rejected code=empty-external-name")
        prior_external = 0
        while prior_external < external_idx:
            if module["externals"][prior_external]["name"] == external["name"]:
                fail("native-ir rejected code=duplicate-external-name;name=" + external["name"])
            prior_external = prior_external + 1
        external_idx = external_idx + 1
    global_idx = 0
    while global_idx < len(module["globals"]):
        global_value = module["globals"][global_idx]
        if global_value["id"] != global_idx:
            fail("native-ir rejected code=noncanonical-global-id")
        if module["production_direct"] and global_value["kind"] == "static_program":
            fail("native-ir rejected code=direct-static-program")
        if global_value["kind"] != "value_slot":
            fail("native-ir rejected code=unknown-global-kind;index=" + str(global_idx))
        global_idx = global_idx + 1
    if "attribute_names" in module:
        attribute_idx = 0
        while attribute_idx < len(module["attribute_names"]):
            if module["attribute_names"][attribute_idx] == "":
                fail("native-ir rejected code=empty-attribute-name")
            prior_attribute = 0
            while prior_attribute < attribute_idx:
                if module["attribute_names"][prior_attribute] == module["attribute_names"][attribute_idx]:
                    fail("native-ir rejected code=duplicate-attribute-name;name=" + module["attribute_names"][attribute_idx])
                prior_attribute = prior_attribute + 1
            attribute_idx = attribute_idx + 1
    if "class_descriptors" in module:
        class_idx = 0
        while class_idx < len(module["class_descriptors"]):
            descriptor = module["class_descriptors"][class_idx]
            if descriptor["id"] != class_idx + 1 or descriptor["name"] == "":
                fail("native-ir rejected code=noncanonical-class-descriptor")
            prior_class = 0
            while prior_class < class_idx:
                if module["class_descriptors"][prior_class]["name"] == descriptor["name"]:
                    fail("native-ir rejected code=duplicate-class-name;name=" + descriptor["name"])
                prior_class = prior_class + 1
            method_idx = 0
            while method_idx < len(descriptor["methods"]):
                method = descriptor["methods"][method_idx]
                target = native_ir_v2_function_by_id(module, method["function_id"])
                if target["name"] != method["symbol"] or target["callable_kind"] != "method" or target["class_id"] != descriptor["id"] or target["method_name"] != method["name"] or target["source_arity"] != method["arity"]:
                    fail("native-ir rejected code=class-method-descriptor;class=" + descriptor["name"] + ";method=" + method["name"])
                prior_method = 0
                while prior_method < method_idx:
                    if descriptor["methods"][prior_method]["name"] == method["name"]:
                        fail("native-ir rejected code=duplicate-class-method;class=" + descriptor["name"] + ";method=" + method["name"])
                    prior_method = prior_method + 1
                method_idx = method_idx + 1
            class_idx = class_idx + 1
    function_idx = 0
    while function_idx < len(module["functions"]):
        function = module["functions"][function_idx]
        function_operations = function["operation_inventory"]
        if function["id"] != function_idx:
            fail("native-ir rejected code=noncanonical-function-id")
        if function["name"] == "":
            fail("native-ir rejected code=empty-function-name")
        prior_function = 0
        while prior_function < function_idx:
            if module["functions"][prior_function]["name"] == function["name"]:
                fail("native-ir rejected code=duplicate-function-name;name=" + function["name"])
            prior_function = prior_function + 1
        if "streaming_verified" in module and module["streaming_verified"]:
            if not function["stream_verified"]:
                fail("native-ir rejected code=stream-function-not-verified;function=" + function["name"])
        else:
            verify_native_ir_v2_function(module, function)
        function_idx = function_idx + 1
    return module


def verify_native_ir(module):
    if module["contract"] == "tyrion-native-ir-v1":
        return verify_native_ir_v1(module)
    if module["contract"] == "tyrion-native-ir-v2":
        return verify_native_ir_v2(module)
    fail("native-ir rejected code=contract-version")
