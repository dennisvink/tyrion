start = 0\n        while start < len(text) and __tyrion_core_char_in(whitespace, text[start]):\n            start = start + 1\n        if maxsplit == 0:\n            if start < len(text):\n                return [text[start:]]\n            return []\n        index = start\n        while index < len(text):\n            if __tyrion_core_char_in(whitespace, text[index]):\n                result.append(text[start:index])\n                splits = splits + 1\n                while index < len(text) and __tyrion_core_char_in(whitespace, text[index]):\n                    index = index + 1\n                if maxsplit >= 0 and splits >= maxsplit:\n                    if index < len(text):\n                        result.append(text[index:])\n                    return result\n                start = index\n            else:\n                index = index + 1\n        if start < len(text):\n            result.append(text[start:])\n        return result\n    if separator == \"\":\n        raise \"ValueError: empty separator\"\n    if maxsplit == 0:\n        return [text]\n    start = 0\n    index = 0\n    while index + len(separator) <= len(text):\n        if text[index:index + len(separator)] == separator:\n            result.append(text[start:index])\n            splits = splits + 1\n            index = index + len(separator)\n            start = index\n            if maxsplit >= 0 and splits >= maxsplit:\n                result.append(text[start:])\n                return result\n        else:\n            index = index + 1\n    result.append(text[start:])\n    return result\n\ndef __tyrion_method_rsplit(text, separator=None, maxsplit=-1):\n    if separator != None:\n        parts = __tyrion_method_split(text, separator, -1)\n        if maxsplit < 0 or maxsplit >= len(parts) - 1:\n            return parts\n        keep = len(parts) - maxsplit\n        prefix = parts[0]\n        index = 1\n        while index < keep:\n            prefix = prefix + separator + parts[index]\n            index = index + 1\n        result = [prefix]\n        while index < len(parts):\n            result.append(parts[index])\n            index = index + 1\n        return result\n    whitespace = \" \\t\\n\\r\\v\\f\"\n    end = len(text)\n    while end > 0 and __tyrion_core_char_in(whitespace, text[end - 1]):\n        end = end - 1\n    if maxsplit == 0:\n        if end > 0:\n            return [text[:end]]\n        return []\n    reverse_parts = []\n    splits = 0\n    while end > 0:\n        token_start = end\n        while token_start > 0 and not __tyrion_core_char_in(whitespace, text[token_start - 1]):\n            token_start = token_start - 1\n        reverse_parts.append(text[token_start:end])\n        splits = splits + 1\n        if maxsplit >= 0 and splits >= maxsplit:\n            prefix_end = token_start\n            while prefix_end > 0 and __tyrion_core_char_in(whitespace, text[prefix_end - 1]):\n                prefix_end = prefix_end - 1\n            if prefix_end > 0:\n                reverse_parts.append(text[:prefix_end])\n            break\n        end = token_start\n        while end > 0 and __tyrion_core_char_in(whitespace, text[end - 1]):\n            end = end - 1\n    return reversed(reverse_parts)\n\ndef __tyrion_method_splitlines(text, keepends=False):\n    result = []\n    start = 0\n    index = 0\n    while index < len(text):\n        width = 0\n        if text[index] == \"\\r\":\n            width = 1\n            if index + 1 < len(text) and text[index + 1] == \"\\n\":\n                width = 2\n        elif text[index] == \"\\n\" or text[index] == \"\\v\" or text[index] == \"\\f\":\n            width = 1\n        if width > 0:\n            stop = index\n            if keepends:\n                stop = index + width\n            result.append(text[start:stop])\n            index = index + width\n            start = index\n        else:\n            index = index + 1\n    if start < len(text):\n        result.append(text[start