-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n    codes = [9, 10, 13]\n    value = 32\n    while value <= 126:\n        codes.append(value)\n        value = value + 1\n    index = 0\n    while index < len(codes):\n        if codes[index] == codepoint:\n            return table[index]\n        index = index + 1\n    raise \"ValueError: chr currently supports ASCII code points 9, 10, 13, and 32..126\"\n\n\ndef ord(character):\n    if len(character) != 1:\n        raise \"TypeError: ord expects one character\"\n    table = \"\\t\\n\\r !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n    codes = [9, 10, 13]\n    value = 32\n    while value <= 126:\n        codes.append(value)\n        value = value + 1\n    index = 0\n    while index < len(table):\n        if table[index] == character:\n            return codes[index]\n        index = index + 1\n    raise \"ValueError: ord currently supports ASCII\"\n\n\ndef list(iterable=None):\n    if iterable == None:\n        return []\n    return [item for item in iterable]\n\n\ndef __tyrion_dict_from_mapping(iterable=None, keywords=None):\n    result = {}\n    if iterable != None:\n        for pair in iterable.items():\n            result[pair[0]] = pair[1]\n    if keywords != None:\n        for key in keywords:\n            result[key] = keywords[key]\n    return result\n\n\ndef __tyrion_dict_from_pairs(iterable=None, keywords=None):\n    result = {}\n    if iterable != None:\n        for pair in iterable:\n            result[pair[0]] = pair[1]\n    if keywords != None:\n        for key in keywords:\n            result[key] = keywords[key]\n    return result\n\n\ndef reversed(iterable):\n    result = []\n    index = len(iterable)\n    while index > 0:\n        index = index - 1\n        result.append(iterable[index])\n    return result\n\n\ndef __tyrion_map(function, *iterables):\n    result = []\n    if len(iterables) == 0:\n        raise \"TypeError: map() must have at least one iterable\"\n    limit = len(iterables[0])\n    iterable_index = 1\n    while iterable_index < len(iterables):\n        if len(iterables[iterable_index]) < limit:\n            limit = len(iterables[iterable_index])\n        iterable_index = iterable_index + 1\n    index = 0\n    while index < limit:\n        arguments = []\n        iterable_index = 0\n        while iterable_index < len(iterables):\n            arguments.append(iterables[iterable_index][index])\n            iterable_index = iterable_index + 1\n        if len(arguments) == 1:\n            result.append(function(arguments[0]))\n        elif len(arguments) == 2:\n            result.append(function(arguments[0], arguments[1]))\n        elif len(arguments) == 3:\n            result.append(function(arguments[0], arguments[1], arguments[2]))\n        elif len(arguments) == 4:\n            result.append(function(arguments[0], arguments[1], arguments[2], arguments[3]))\n        else:\n            result.append(function(*arguments))\n        index = index + 1\n    return result\n\n\ndef map(function, *iterables):\n    return __tyrion_map(function, *iterables)\n\n\ndef filter(function, iterable):\n    result = []\n    if function == None:\n        for item in iterable:\n            if item:\n                result.append(item)\n        return result\n    for item in iterable:\n        if function(item):\n            result.append(item)\n    return result\n\n\ndef __tyrion_base_text(value, base, prefix):\n    digits = \"0123456789abcdefghijklmnopqrstuvwxyz\"\n    if base < 2 or base > len(digits):\n        raise \"ValueError: base must be between 2 and 36\"\n    sign = \"\"\n    remaining = value\n    if remaining < 0:\n        sign = \"-\"\n        remaining = 0 - remaining\n    body = \"0\"\n    if remaining > 0:\n        body = \"\"\n        while remaining > 0:\n            digit = remaining % base\n            body = digits[digit] + body\n            remaining