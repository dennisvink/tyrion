len(needle)] == needle:\n            count = count + 1\n            index = index + len(needle)\n        else:\n            index = index + 1\n    return count\n\n\ndef __tyrion_method_list_count(values, needle):\n    count = 0\n    for value in values:\n        if value == needle:\n            count = count + 1\n    return count\n\ndef __tyrion_method_dict_get(values, key, default=None):\n    if key in values:\n        return values[key]\n    return default\n\ndef __tyrion_method_dict_values(values):\n    result = []\n    for key in values:\n        result.append(values[key])\n    return result\n\ndef __tyrion_method_dict_update(values, other=None, keyword_values=None):\n    if other != None:\n        for key in other:\n            values[key] = other[key]\n    if keyword_values != None:\n        for key in keyword_values:\n            values[key] = keyword_values[key]\n    return values\n\ndef __tyrion_method_dict_pop_rebuild(values, key, default=None, has_default=False):\n    if key in values:\n        result = values[key]\n        replacement = {}\n        for entry_key in values:\n            if entry_key != key:\n                replacement[entry_key] = values[entry_key]\n        return (result, replacement)\n    if has_default:\n        return (default, values)\n    raise \"KeyError: \" + str(key)\n\ndef __tyrion_method_dict_setdefault(values, key, default=None):\n    if key in values:\n        return values[key]\n    values[key] = default\n    return default\n\ndef __tyrion_method_dict_setdefault_pair(values, key, default=None):\n    if key in values:\n        return (values[key], values)\n    values[key] = default\n    return (default, values)\n\ndef __tyrion_method_dict_clear_pair(values):\n    return (None, {})\n\ndef __tyrion_method_dict_popitem_pair(values):\n    keys = values.keys()\n    if len(keys) == 0:\n        raise \"KeyError: popitem from empty dictionary\"\n    key = keys[len(keys) - 1]\n    value = values[key]\n    replacement = {}\n    index = 0\n    while index < len(keys) - 1:\n        entry_key = keys[index]\n        replacement[entry_key] = values[entry_key]\n        index = index + 1\n    return ((key, value), replacement)\n\ndef __tyrion_dict_fromkeys(iterable, value=None):\n    result = {}\n    for key in iterable:\n        result[key] = value\n    return result\n\ndef __tyrion_dict_union(left, right):\n    result = {}\n    for key in left:\n        result[key] = left[key]\n    for key in right:\n        result[key] = right[key]\n    return result\n\ndef __tyrion_method_list_index(values, needle, start=0, stop=None):\n    if stop == None or stop > len(values):\n        stop = len(values)\n    if start < 0:\n        start = len(values) + start\n    if start < 0:\n        start = 0\n    index = start\n    while index < stop:\n        if values[index] == needle:\n            return index\n        index = index + 1\n    raise \"ValueError\"\n\ndef __tyrion_delete_index(values, index):\n    if str(index) == index:\n        if index in values:\n            result = {}\n            for key in values:\n                if key != index:\n                    result[key] = values[key]\n            return result\n        raise \"KeyError: \" + str(index)\n    length = len(values)\n    if index < 0:\n        index = length + index\n    if index < 0 or index >= length:\n        raise \"IndexError: list index out of range\"\n    result = []\n    cursor = 0\n    while cursor < length:\n        if cursor != index:\n            result.append(values[cursor])\n        cursor = cursor + 1\n    return result\n\ndef __tyrion_delete_slice(values, start=None, stop=None):\n    length = len(values)\n    if start == None:\n        start = 0\n    if stop == None:\n        stop = length\n    if start < 0:\n        start = length + start\n    if stop < 0:\n        stop = length + stop\n    if start < 0:\n        start = 0\n    if stop < 0:\n        stop = 0\n    if start > length:\n        start = length\n    if stop > length:\n        stop = length\n    result = []\n    cursor = 0\n    while cursor < length:\n        if cursor < start or cursor >= stop:\n            result.append(values[cursor])\n        cursor = cursor + 1\n    return result\n\ndef __tyrion_assign_slice(values, start, stop, replacement):\n    length = len(values)\n    if start == None:\n        start = 0\n    if stop == None:\n        stop = length\n    if start < 0:\n        start = length + start\n    if stop < 0:\n        stop = length + stop\n    if start < 0:\n        start = 0\n    if stop < 0:\n        stop = 0\n    if start > length:\n        start = length\n    if stop > length:\n        stop = length\n    result = []\n    cursor = 0\n    while cursor < start:\n        result.append(values[cursor])\n        cursor = cursor + 1\n    for item in replacement:\n        result.append(item)\n    cursor = stop\n    while cursor < length:\n        result.append(values[cursor])\n        cursor = cursor + 1\n    return result\n\ndef __tyrion_method_list_reverse(values):\n    result = []\n    index = len(values)\n    while index > 0:\n        index = index - 1\n        result.append(values[index])\n    return result\n\ndef __tyrion_method_list_sort(values, key=None, reverse=False):\n    ordered = []\n    for value in values:\n        ordered.append(value)\n    left = 0\n    while left < len(ordered):\n        right = left + 1\n        while right < len(ordered):\n            left_value = ordered[left]\n            right_value = ordered[right]\n            if key != None:\n                left_value = key(left_value)\n                right_value = key(right_value)\n            should_swap = right_value < left_value\n            if reverse:\n                should_swap = left_value < right_value\n            if should_swap:\n                swap = ordered[left]\n                ordered[left] = ordered[right]\n                ordered[right] = swap\n            right = right + 1\n        left = left + 1\n    return ordered\n\ndef __tyrion_method_list_sort_plain(values, reverse=False):\n    ordered = []\n    for value in values:\n        ordered.append(value)\n    left = 0\n    while left < len(ordered):\n        right = left + 1\n        while right < len(ordered):\n            should_swap = ordered[right] < ordered[left]\n            if reverse:\n                should_swap = ordered[left] < ordered[right]\n            if should_swap:\n                swap = ordered[left]\n                ordered[left] = ordered[right]\n                ordered[right] = swap\n            right = right + 1\n        left = left + 1\n    return ordered\n\n\ndef __tyrion_method_replace(text, old, replacement, limit=-1):\n    if old == \"\":\n        raise \"ValueError: empty replacement pattern is not supported yet\"\n    result = \"\"\n    start = 0\n    replaced = 0\n    found = __tyrion_string_find(text, old, start, None, False)\n    while found >= 0 and (limit < 0 or replaced < limit):\n        result = result + text[start:found] + replacement\n        start = found + len(old)\n        replaced = replaced + 1\n        found = __tyrion_string_find(text, old, start, None, False)\n    return result + text[start:]\n\n\ndef __tyrion_method_join(separator, values):\n    result = \"\"\n    index = 0\n    for value in values:\n        if index > 0:\n            result = result + separator\n        result = result + value\n        index = index + 1\n    return result\n\n\ndef __tyrion_method_removeprefix(text, prefix):\n    if len(prefix) <= len(text) and text[0:len(prefix)] == prefix:\n        return text[len(prefix):]\n    return text\n\n\ndef __tyrion_method_removesuffix(text, suffix):\n    if len(suffix) <= len(text) and text[len(text) - len(suffix):] == suffix:\n        return text[:len(text) - len(suffix)]\n    return text\n\n\ndef __tyrion_method_partition(text, separator):\n    found = __tyrion_string_find(text, separator, 0, None, False)\n    if found < 0:\n        return (text, \"\", \"\")\n    return (text[:found], separator, text[found + len(separator):])\n\n\ndef __tyrion_method_rpartition(text, separator):\n    found = __tyrion_string_find(text, separator, 0, None, True)\n    if found < 0:\n        return (\"\", \"\", text)\n    return (text[:found], separator, text[found + len(separator):])\n"


def builtin_module_http_source():
    return "# Tyrion HTTP/1.1 client module.\n# Plain HTTP uses native TCP; HTTPS uses the built-in TLS transport.\n\nimport tls\n\n\ndef http_ascii_bytes(text):\n    printable = \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n    result = []\n    for ch in text:\n        if ch == \"\\r\":\n            result.append(13)\n        elif ch == \"\\n\":\n            result.append(10)\n        elif ch == \"\\t\":\n            result.append(9)\n        else:\n            idx = 0\n            found = -1\n            while idx < len(printable):\n                if printable[idx] == ch:\n                    found = idx + 32\n                idx = idx + 1\n            if found < 0:\n                raise \"UnicodeError: HTTP module currently accepts ASCII text\"\n            result.append(found)\n    return result\n\n\ndef http_ascii_text(data):\n    result = __tyrion_native_ascii_text(data)\n    if result == None:\n        raise \"UnicodeError: HTTP response is not ASCII text\"\n    return result\n\n\ndef http_lower_ascii(text):\n    upper = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    lower = \"abcdefghijklmnopqrstuvwxyz\"\n    result = \"\"\n    for ch in text:\n        idx = 0\n        replacement = ch\n        while idx < len(upper):\n            if ch == upper[idx]:\n                replacement = lower[idx]\n            idx = idx + 1\n        result = result + replacement\n    return result\n\n\ndef http_text_contains(text, expected):\n    if expected == \"\":\n        return True\n    if len(expected) > len(text):\n        return False\n    idx = 0\n    while idx + len(expected) <= len(text):\n        if text[idx:idx + len(expected)] == expected:\n            return True\n        idx = idx + 1\n    return False\n\n\ndef http_parse_url(url):\n    prefix = \"http://\"\n    scheme = \"http\"\n    default_port = 80\n    if len(url) >= 8 and url[0:8] == \"https://\":\n        prefix = \"https://\"\n        scheme = \"https\"\n        default_port = 443\n    elif len(url) < len(prefix) or url[0:len(prefix)] != prefix:\n        raise \"ValueError: HTTP URL must start with http:// or https://\"\n    rest = url[len(prefix):]\n    slash = -1\n    idx = 0\n    while idx < len(rest):\n        if rest[idx] == \"/\" and slash < 0:\n            slash = idx\n        idx = idx + 1\n    if slash < 0:\n        authority = rest\n        path = \"/\"\n    else:\n        authority = rest[0:slash]\n        path = rest[slash:]\n    if authority == \"\":\n        raise \"ValueError: HTTP URL has no host\"\n    colon = -1\n    idx = 0\n    while idx < len(authority):\n        if authority[idx] == \":\":\n            if colon >= 0:\n                raise \"ValueError: IPv6 HTTP URLs are not supported yet\"\n            colon = idx\n        idx = idx + 1\n    host = authority\n    port = default_port\n    if colon >= 0:\n        host = authority[0:colon]\n        port_text = authority[colon + 1:]\n        if host == \"\" or port_text == \"\":\n            raise \"ValueError: invalid HTTP host or port\"\n        port = int(port_text)\n        if port < 1 or port > 65535:\n            raise \"ValueError: HTTP port is outside 1..65535\"\n    return {\"scheme\": scheme, \"host\": host, \"port\": port, \"path\": path, \"authority\": authority}\n\n\ndef http_header_present(headers, expected):\n    expected_lower = http_lower_ascii(expected)\n    for name in headers:\n        if http_lower_ascii(name) == expected_lower:\n            return True\n    return False\n\n\ndef http_validate_request_text(label, text):\n    if http_text_contains(text, \"\\r\") or http_text_contains(text, \"\\n\"):\n        raise \"ValueError: HTTP \" + label + \" contains a newline\"\n\n\ndef http_request_bytes(method, target, headers, body):\n    http_validate_request_text(\"method\", method)\n    http_validate_request_text(\"target\", target[\"path\"])\n    request = method + \" \" + target[\"path\"] + \" HTTP/1.1\\r\\n\"\n    if not http_header_present(headers, \"host\"):\n        request = request + \"Host: \" + target[\"authority\"] + \"\\r\\n\"\n    if not http_header_present(headers, \"connection\"):\n        request = request + \"Connection: close\\r\\n\"\n    if len(body) > 0 and not http_header_present(headers, \"content-length\"):\n        request = request + \"Content-Length: \" + str(len(body)) + \"\\r\\n\"\n    for name in headers:\n        value = headers[name]\n        http_validate_request_text(\"header name\", name)\n        http_validate_request_text(\"header value\", value)\n        request = request + name + \": \" + value + \"\\r\\n\"\n    result = http_ascii_bytes(request + \"\\r\\n\")\n    for byte in body:\n        if byte < 0 or byte > 255:\n            raise \"ValueError: HTTP body byte is outside 0..255\"\n        result.append(byte)\n    return result\n\n\ndef http_write_all(handle, data, timeout_ms):\n    offset = 0\n    while offset < len(data):\n        written = __tyrion_native_tcp_write(handle, data[offset:], timeout_ms)\n        if written <= 0:\n            raise \"ConnectionError: HTTP socket write failed\"\n        offset = offset + written\n    return offset\n\n\ndef http_read_all(handle, timeout_ms):\n    result = []\n    while True:\n        chunk = __tyrion_native_tcp_read(handle, 4096, timeout_ms)\n        if chunk == None or len(chunk) == 0:\n            return result\n        if len(result) == 0:\n            result = chunk\n        else:\n            result = result + chunk\n\n\ndef http_find_header_end(data):\n    idx = 0\n    while idx + 3 < len(data):\n        if data[idx] == 13 and data[idx + 1] == 10 and data[idx + 2] == 13 and data[idx + 3] == 10:\n            return {\"header_end\": idx, \"body_start\": idx + 4, \"separator\": \"\\r\\n\"}\n        idx = idx + 1\n    idx = 0\n    while idx + 1 < len(data):\n        if data[idx] == 10 and data[idx + 1] == 10:\n            return {\"header_end\": idx, \"body_start\": idx + 2, \"separator\": \"\\n\"}\n        idx = idx + 1\n    raise \"ValueError: malformed HTTP response headers\"\n\n\ndef http_parse_status_line(line):\n    parts = line.split(\" \")\n    if len(parts) < 2 or len(parts[0]) < 5 or parts[0][0:5] != \"HTTP/\":\n        raise \"ValueError: malformed HTTP status line\"\n    status = int(parts[1])\n    reason = \"\"\n    idx = 2\n    while idx < len(parts):\n        if reason != \"\":\n            reason = reason + \" \"\n        reason = reason + parts[idx]\n        idx = idx + 1\n    return {\"status\": status, \"reason\": reason}\n\n\ndef http_parse_headers(lines):\n    headers = {}\n    idx = 1\n    while idx < len(lines):\n        line = lines[idx]\n        if line != \"\":\n            colon = -1\n            cursor = 0\n            while cursor < len(line):\n                if line[cursor] == \":\" and colon < 0:\n                    colon = cursor\n                cursor = cursor + 1\n            if colon <= 0:\n                raise \"ValueError: malformed HTTP response header\"\n            name = http_lower_ascii(line[0:colon].strip())\n            value = line[colon + 1:].strip()\n            if name in headers:\n                headers[name] = headers[name] + \", \" + value\n            else:\n                headers[name] = value\n        idx = idx + 1\n    return headers\n\n\ndef http_hex_value(byte):\n    if byte >= 48 and byte <= 57:\n        return byte - 48\n    if byte >= 65 and byte <= 70:\n        return byte - 55\n    if byte >= 97 and byte <= 102:\n        return byte - 87\n    return -1\n\n\ndef http_join_byte_chunks(chunks):\n    if len(chunks) == 0:\n        return []\n    while len(chunks) > 1:\n        merged = []\n        idx = 0\n        while idx < len(chunks):\n            if idx + 1 < len(chunks):\n                merged.append(chunks[idx] + chunks[idx + 1])\n            else:\n                merged.append(chunks[idx])\n            idx = idx + 2\n        chunks = merged\n    return chunks[0]\n\n\ndef http_decode_chunked(data):\n    chunks = []\n    cursor = 0\n    while True:\n        line_end = -1\n        idx = cursor\n        while idx + 1 < len(data) and line_end < 0:\n            if data[idx] == 13 and data[idx + 1] == 10:\n                line_end = idx\n            idx = idx + 1\n        if line_end < 0:\n            raise \"ValueError: incomplete HTTP chunk size\"\n        size = 0\n        digits = 0\n        idx = cursor\n        while idx < line_end and data[idx] != 59:\n            value = http_hex_value(data[idx])\n            if value < 0:\n                raise \"ValueError: invalid HTTP chunk size\"\n            size = size * 16 + value\n            digits = digits + 1\n            idx = idx + 1\n        if digits == 0:\n            raise \"ValueError: empty HTTP chunk size\"\n        cursor = line_end + 2\n        if size == 0:\n            return http_join_byte_chunks(chunks)\n        if cursor + size + 2 > len(data):\n            raise \"ValueError: incomplete HTTP chunk body\"\n        stop = cursor + size\n        chunks.append(data[cursor:stop])\n        cursor = stop\n        if data[cursor] != 13 or data[cursor + 1] != 10:\n            raise \"ValueError: malformed HTTP chunk terminator\"\n        cursor = cursor + 2\n\n\ndef http_parse_response(data):\n    boundary = http_find_header_end(data)\n    header_text = http_ascii_text(data[0:boundary[\"header_end\"]])\n    lines = header_text.split(boundary[\"separator\"])\n    status = http_parse_status_line(lines[0])\n    headers = http_parse_headers(lines)\n    body = data[boundary[\"body_start\"]:]\n    if \"transfer-encoding\" in headers and http_text_contains(http_lower_ascii(headers[\"transfer-encoding\"]), \"chunked\"):\n        body = http_decode_chunked(body)\n    elif \"content-length\" in headers:\n        expected = int(headers[\"content-length\"])\n        if len(body) < expected:\n            raise \"ValueError: incomplete HTTP response body\"\n        body = body[0:expected]\n    return {\"status\": status[\"status\"], \"reason\": status[\"reason\"], \"headers\": headers, \"body\": body, \"ok\": status[\"status\"] >= 200 and status[\"status\"] < 400}\n\n\ndef http_request(method, url, headers, body, timeout_ms):\n    target = http_parse_url(url)\n    request = http_request_bytes(method, target, headers, body)\n    if target[\"scheme\"] == \"https\":\n        handle = tls_connect(target[\"host\"], target[\"port\"], timeout_ms)\n        try:\n            offset = 0\n            while offset < len(request):\n                written = tls_write(handle, request[offset:], timeout_ms)\n                if written <= 0:\n                    raise \"ConnectionError: HTTPS socket write failed\"\n                offset = offset + written\n            response = []\n            while True:\n                chunk = tls_read(handle, 4096, timeout_ms)\n                if chunk == None or len(chunk) == 0:\n                    break\n                if len(response) == 0:\n                    response = chunk\n                else:\n                    response = response + chunk\n        finally:\n            tls_close(handle)\n    else:\n        handle = __tyrion_native_tcp_connect(target[\"host\"], target[\"port\"], timeout_ms)\n        try:\n            http_write_all(handle, request, timeout_ms)\n            response = http_read_all(handle, timeout_ms)\n        finally:\n            __tyrion_native_tcp_close(handle)\n    return http_parse_response(response)\n\n\ndef http_get_timeout(url, timeout_ms):\n    return http_request(\"GET\", url, {}, [], timeout_ms)\n\n\ndef http_get(url):\n    return http_get_timeout(url, 30000)\n\n\ndef http_body_text(response):\n    return http_ascii_text(response[\"body\"])\n"


def builtin_module_tls_source():
    return "# Tyrion TLS client transport.\n# The native extension is precompiled and embedded in the Tyrion toolchain;\n# applications only link it when this module is present in their graph.\n\n\ndef tls_require_result(result, operation):\n    if result == None:\n        raise \"ConnectionError: TLS \" + operation + \" returned no result\"\n    if len(result) >= 4 and result[0:4] == \"err:\":\n        raise \"ConnectionError: TLS \" + operation + \" failed: \" + result[4:]\n    return result\n\n\ndef tls_connect(host, port, timeout_ms):\n    extension = __tyrion_native_host_load(\"tls\")\n    result = __tyrion_native_host_call(\n        extension,\n        \"tls.connect\",\n        host + \"\\n\" + str(port) + \"\\n\" + str(timeout_ms),\n    )\n    result = tls_require_result(result, \"connect\")\n    if len(result) < 4 or result[0:3] != \"ok:\":\n        __tyrion_native_host_unload(extension)\n        raise \"ConnectionError: malformed TLS connect response\"\n    return {\"extension\": extension, \"session\": int(result[3:])}\n\n\ndef tls_write(handle, data, timeout_ms):\n    result = __tyrion_native_tls_write(handle[\"session\"], data, timeout_ms)\n    if result < 0:\n        raise \"ConnectionError: TLS write failed\"\n    return result\n\n\ndef tls_read(handle, maximum, timeout_ms):\n    result = __tyrion_native_tls_read(handle[\"session\"], maximum, timeout_ms)\n    if result == None:\n        raise \"ConnectionError: TLS read failed\"\n    return result\n\n\ndef tls_close(handle):\n    result = None\n    try:\n        result = __tyrion_native_host_call(\n            handle[\"extension\"],\n            \"tls.close\",\n            str(handle[\"session\"]),\n        )\n    finally:\n        __tyrion_native_host_unload(handle[\"extension\"])\n    result = tls_require_result(result, \"close\")\n    if result != \"ok\":\n        raise \"ConnectionError: malformed TLS close response\"\n    return True\n"


def builtin_module_path(name):
    if name == "core":
        return "@tyrion/core"
    if name == "http":
        return "@tyrion/http"
    if name == "tls":
        return "@tyrion/tls"
    return ""


def builtin_module_source_for_path(path):
    if path == "@tyrion/core":
        return builtin_module_core_source()
    if path == "@tyrion/http":
        return builtin_module_http_source()
    if path == "@tyrion/tls":
        return builtin_module_tls_source()
    return ""
