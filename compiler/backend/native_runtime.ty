def emit_native_runtime_direct_tcp_runtime(out, target):
    out = emit_native_runtime_direct_token_equals_runtime(out, target)
    out = emit_native_runtime_direct_tcp_call_runtime(out, target)
    return out

def emit_native_runtime_direct_token_equals_runtime(out, target):
    out = asm_label(out, "L_native_runtime_direct_token_equals")
    out = asm_line(out, "stp x29, x30, [sp, #-16]!")
