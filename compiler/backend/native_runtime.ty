    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_find_class_init_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")
    return out

def emit_native_runtime_direct_call_arg_expr_runtime(out, target):
    # Evaluate reverse kind-8 call arguments in source order before the
    # generated application moves sp to its exact argument area.
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_exprs")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "str x23, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_call_arg_exprs_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_call_arg_exprs_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_call_arg_exprs_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_call_arg_exprs")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_call_arg_exprs_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "b L_native_runtime_direct_emit_call_arg_exprs_return")
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_exprs_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_call_arg_exprs_return")
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_exprs_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_exprs_return")
    out = asm_line(out, "ldr x23, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # Bound calls reuse the canonical argument/default binder with one leading
    # receiver parameter. x0=handle, x1=call AST, x2=function record,
    # x3=receiver AST slot, x4=text, x5=data, x6=result AST slot.
    out = asm_label(out, "L_native_runtime_direct_emit_bound_call")
    out = asm_line(out, "stp x29, x30, [sp, #-160]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x23, x4")
    out = asm_line(out, "mov x24, x5")
    out = asm_line(out, "mov x25, x6")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x27, x9, x20, lsl #6")
    out = asm_line(out, "add x28, x9, x21, lsl #6")
    out = asm_line(out, "ldr x9, [x27]")
    out = asm_line(out, "cmp x9, #6")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_bound_call_record_ok")
    out = asm_line(out, "cmp x9, #7")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_unsupported")
    out = asm_label(out, "L_native_runtime_direct_emit_bound_call_record_ok")
    out = asm_line(out, "ldr x9, [x28]")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_unsupported")
    out = asm_line(out, "ldr x9, [x28, #48]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.lo L_native_runtime_direct_emit_bound_call_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x27, #32]")
    out = asm_line(out, "mov x2, x23")
    out = asm_line(out, "mov x3, x24")
    out = asm_line(out, "bl L_native_runtime_direct_emit_call_arg_exprs")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x28, #32]")
    out = asm_line(out, "ldr x2, [x27, #32]")
    out = asm_line(out, "mov x3, x23")
    out = asm_line(out, "mov x4, x24")
    out = asm_line(out, "ldr x5, [x28, #32]")
    out = asm_line(out, "mov x6, #1")
    out = asm_line(out, "bl L_native_runtime_direct_emit_call_default_exprs")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_return")
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_setup_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "ldr x1, [x28, #48]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_setup_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x27, #32]")
    out = asm_line(out, "mov x2, x23")
    out = asm_line(out, "ldr x3, [x28, #32]")
    out = asm_line(out, "mov x4, #1")
    out = asm_line(out, "bl L_native_runtime_direct_emit_call_arg_copies")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x28, #32]")
    out = asm_line(out, "ldr x2, [x27, #32]")
    out = asm_line(out, "mov x3, x23")
    out = asm_line(out, "ldr x4, [x28, #32]")
    out = asm_line(out, "mov x5, #1")
    out = asm_line(out, "bl L_native_runtime_direct_emit_call_default_copies")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_bound_call_return")
    # Parameter zero receives the object from the saved caller frame.
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "lsl x1, x22, #7")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_setup_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
    out = asm_line(out, "ldr x1, [x28, #48]")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_bound_call_fail")
