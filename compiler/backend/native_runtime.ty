def emit_native_runtime_direct_comprehension_runtime(out, target):
    # x0=handle, x1=kind-16 wrapper AST, x2=text builder, x3=data builder.
    # The wrapper owns the output expression/key, optional dict value, target
    # token and kind-19 comprehension record. Runtime values remain in their
    # canonical AST-indexed 128-byte slots.
    out = asm_label(out, "L_native_runtime_direct_emit_comprehension")
    out = asm_line(out, "stp x29, x30, [sp, #-144]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
