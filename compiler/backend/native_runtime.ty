    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #160")
    out = asm_line(out, "ret")
    return out

def emit_native_runtime_direct_method_runtime(out, target):
    # x0=identifier token record. Project its spelling once to the canonical
    # method ID owned by application_semantics.ty.
    method_count = application_method_count()
    out = asm_label(out, "L_native_runtime_direct_method_id")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "cbz x19, L_native_runtime_direct_method_id_unknown")
    method_idx = 0
    while method_idx < method_count:
        method_name = application_method_name_at(method_idx)
        method_id = application_method_id_at(method_idx)
        out = asm_line(out, "ldr x9, [x19, #16]")
        out = asm_line(out, "cmp x9, #" + str(len(method_name)))
        out = asm_line(out, "b.ne L_native_runtime_direct_method_id_next_" + str(method_id))
        out = asm_line(out, "ldr x0, [x19, #8]")
        out = asm_addr(out, target, "x1", "L_native_runtime_direct_method_name_" + str(method_id))
        out = asm_line(out, "mov x2, #" + str(len(method_name)))
        out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
        out = asm_line(out, "cbz w0, L_native_runtime_direct_method_id_found_" + str(method_id))
        out = asm_label(out, "L_native_runtime_direct_method_id_next_" + str(method_id))
        method_idx = method_idx + 1
    out = asm_label(out, "L_native_runtime_direct_method_id_unknown")
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "b L_native_runtime_direct_method_id_return")
    method_idx = 0
    while method_idx < method_count:
        method_id = application_method_id_at(method_idx)
        out = asm_label(out, "L_native_runtime_direct_method_id_found_" + str(method_id))
        out = asm_line(out, "mov x0, #" + str(method_id))
        out = asm_line(out, "b L_native_runtime_direct_method_id_return")
        method_idx = method_idx + 1
    out = asm_label(out, "L_native_runtime_direct_method_id_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # Bare kind-4 member access. Calls whose callee is kind 4 continue through
    # L_native_runtime_direct_emit_method; this path handles `object.name`.
    out = asm_label(out, "L_native_runtime_direct_emit_attr")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #64]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_attr_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #4")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_attr_unsupported")
    out = asm_line(out, "ldr x0, [sp, #64]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_receiver")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_attr_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "ldr x24, [x19, #40]")
    out = asm_line(out, "ldr x9, [x19, #16]")
    out = asm_line(out, "ldr x9, [x9, #8]")
    out = asm_line(out, "add x24, x24, x9")
    out = asm_line(out, "mov x2, x24")
    out = asm_line(out, "mov x3, x20")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_name_slot")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_attr_get_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "lsl x1, x20, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_attr_get_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_attr_get_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_attr_get_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_attr_return")
    out = asm_label(out, "L_native_runtime_direct_emit_attr_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_attr_return")
    out = asm_label(out, "L_native_runtime_direct_emit_attr_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_attr_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # Canonical kind-4 method calls currently expose the persistent file ABI.
    # x0=handle, x1=method AST, x2=text builder, x3=data builder.
    out = asm_label(out, "L_native_runtime_direct_emit_method")
    out = asm_line(out, "stp x29, x30, [sp, #-128]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #96]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x24, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x24]")
    out = asm_line(out, "cmp x9, #6")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "str x24, [sp, #80]")
    out = asm_line(out, "ldr x9, [x24, #24]")
    out = asm_line(out, "ldr x10, [x19, #40]")
    out = asm_line(out, "cmp x9, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x19, #32]")
    out = asm_line(out, "add x23, x10, x9, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #4")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "mov x25, #-1")
    out = asm_line(out, "mov x26, #0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "bl L_native_runtime_direct_find_unique_class_method")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "cmp x1, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_builtin_start")
    out = asm_line(out, "mov x25, x1")
    out = asm_line(out, "mov x26, x2")
    out = asm_line(out, "ldr x0, [sp, #96]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_receiver")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_object_guard_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_object_guard_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_object_guard_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_method_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov x2, x25")
    out = asm_line(out, "ldr x3, [x23, #24]")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "mov x5, x22")
    out = asm_line(out, "mov x6, x20")
    out = asm_line(out, "bl L_native_runtime_direct_emit_bound_call")
    out = asm_line(out, "b L_native_runtime_direct_emit_method_return")
    out = asm_label(out, "L_native_runtime_direct_emit_method_builtin_start")
    out = asm_line(out, "mov x0, x24")
    out = asm_line(out, "bl L_native_runtime_direct_method_id")
    out = asm_line(out, "mov x9, x0")
    method_idx = 0
    while method_idx < method_count:
        method_id = application_method_id_at(method_idx)
        out = asm_line(out, "cmp x9, #" + str(method_id))
        out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_select_" + str(method_id))
        method_idx = method_idx + 1
    out = asm_line(out, "b L_native_runtime_direct_emit_method_unknown")
    method_idx = 0
    while method_idx < method_count:
        method_id = application_method_id_at(method_idx)
        method_code_label = ""
        if method_idx == 0:
            method_code_label = "L_native_runtime_direct_method_append"
        if method_idx == 1:
            method_code_label = "L_native_runtime_direct_method_remove"
        if method_idx == 2:
            method_code_label = "L_native_runtime_direct_method_add"
        if method_idx == 3:
            method_code_label = "L_native_runtime_direct_method_keys"
        if method_idx == 4:
            method_code_label = "L_native_runtime_direct_method_items"
        if method_idx == 5:
            method_code_label = "L_native_runtime_direct_method_strip"
        if method_idx == 6:
            method_code_label = "L_native_runtime_direct_method_split"
        if method_idx == 7:
            method_code_label = "L_native_runtime_direct_method_startswith"
        if method_idx == 8:
            method_code_label = "L_native_runtime_direct_method_endswith"
        if method_idx == 9:
            method_code_label = "L_native_runtime_direct_method_read"
        if method_idx == 10:
            method_code_label = "L_native_runtime_direct_method_write"
        if method_idx == 11:
            method_code_label = "L_native_runtime_direct_method_flush"
        if method_idx == 12:
            method_code_label = "L_native_runtime_direct_method_seek_a"
        if method_idx == 13:
            method_code_label = "L_native_runtime_direct_method_close"
        out = asm_label(out, "L_native_runtime_direct_emit_method_select_" + str(method_id))
        out = asm_addr(out, target, "x26", method_code_label)
        out = asm_line(out, "b L_native_runtime_direct_emit_method_args")
        method_idx = method_idx + 1
    out = asm_label(out, "L_native_runtime_direct_emit_method_args")
    out = asm_line(out, "ldr x9, [sp, #80]")
    out = asm_line(out, "ldr x24, [x9, #32]")
    out = asm_line(out, "mov x25, #-1")
    out = asm_line(out, "str x25, [sp, #88]")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_no_arg")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x24, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #40]")
    out = asm_line(out, "cmp x10, #0")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_one_arg")
    out = asm_line(out, "cmp x10, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #24]")
    out = asm_line(out, "str x10, [sp, #88]")
    out = asm_line(out, "ldr x24, [x9, #32]")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x19, #40]")
    out = asm_line(out, "cmp x24, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x19, #32]")
    out = asm_line(out, "add x9, x10, x24, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #32]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #40]")
    out = asm_line(out, "cbnz x10, L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x25, [x9, #24]")
    out = asm_line(out, "ldr x24, [sp, #88]")
    out = asm_line(out, "b L_native_runtime_direct_emit_method_no_arg")
    out = asm_label(out, "L_native_runtime_direct_emit_method_one_arg")
    out = asm_line(out, "ldr x10, [x9, #32]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "ldr x25, [x9, #24]")
    out = asm_line(out, "mov x24, #-1")
    out = asm_label(out, "L_native_runtime_direct_emit_method_no_arg")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_method_seek_a")
    out = asm_line(out, "cmp x26, x9")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_method_non_seek_arity")
    out = asm_line(out, "cmp x25, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_unsupported")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_method_unsupported")
