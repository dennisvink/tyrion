    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_ctor_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_ctor_e")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_ctor_f")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_ctor_g")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")

    # Resume prologue restores the canonical frame and jumps through the
