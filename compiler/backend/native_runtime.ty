    out = asm_label(out, "L_native_ast_sequence_get_value")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x2")
    out = asm_line(out, "mov x21, x1")
    out = asm_line(out, "cbz x19, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "ldr x9, [x19, #64]")
