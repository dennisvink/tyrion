    out = asm_label(out, "L_native_ast_field_target_assignment")
    out = asm_line(out, "ldr x9, [x22, #40]")
    out = asm_line(out, "cmp x9, #2")
    out = asm_line(out, "b.eq L_native_ast_field_target_assignment_unpack")
    out = asm_line(out, "cbnz x9, L_native_ast_field_target_assignment_record")
