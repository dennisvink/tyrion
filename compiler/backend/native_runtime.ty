    text = text + "    mov x22, x0\n    mov x1, x20\n    mov x2, x21\n    bl _memcpy\n"
    text = text + "    strb wzr, [x22, x21]\n    str x22, [x19]\n    str x21, [x19, #8]\n"
    text = text + "    mov w9, #8\n    strb w9, [x19, #127]\n"
    text = text + "    ldp x21, x22, [sp, #32]\n    ldp x19, x20, [sp, #16]\n"
    text = text + "    ldp x29, x30, [sp], #64\n    ret\n"
    text = text + "__tyrion_app_terminal_event_put:\n    stp x29, x30, [sp, #-176]!\n"
    text = text + "    mov x29, sp\n    str x19, [sp, #16]\n    mov x19, x0\n"
    text = text + "    str x1, [sp, #32]\n    str x2, [sp, #40]\n    mov w9, #4\n"
    text = text + "    strb w9, [sp, #159]\n    mov x0, x19\n    add x1, sp, #32\n    mov x2, x3\n"
    text = text + "    bl __tyrion_app_dict_set\n    ldr x19, [sp, #16]\n"
    text = text + "    ldp x29, x30, [sp], #176\n    ret\n"
    return text

def native_runtime_direct_terminal_data_text():
    text = native_runtime_direct_terminal_support_text()
    text = text + ".section __DATA,__const\n.p2align 0\n"
    fields = ["key", "text", "sequence", "shift", "alt", "ctrl", "super"]
    for field in fields:
        text = text + "__tyrion_app_key_field_" + field + ":\n    .ascii \"" + field + "\"\n"
    names = ["up", "down", "left", "right", "enter", "space", "escape", "tab", "backspace", "home", "end", "insert", "delete", "page_up", "page_down", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "char", "codepoint", "unknown", "eof"]
    for name in names:
        text = text + "__tyrion_app_key_" + name + ":\n    .ascii \"" + name + "\"\n"
    text = text + "__tyrion_app_key_empty:\n    .byte 0\n"
    text = text + "__tyrion_app_ansi_escape_byte:\n    .byte 27\n"
    text = text + ".section __TEXT,__text,regular,pure_instructions\n.p2align 2\n"
    return text

def runtime_native_replace_all(text, needle, replacement):
    if needle == "":
        return text
    out = ""
    idx = 0
    needle_len = len(needle)
    text_len = len(text)
    while idx < text_len:
        stop = idx + needle_len
        if stop <= text_len and text[idx:stop] == needle:
            out = out + replacement
            idx = stop
        else:
            out = out + text[idx]
            idx = idx + 1
    return out


def runtime_native_linux_aarch64_line(line):
    had_pageoff = contains_text(line, "@PAGEOFF")
    if had_pageoff:
        comma_count = 0
        idx = 0
        while idx + 1 < len(line):
            if line[idx:idx + 2] == ", ":
                comma_count = comma_count + 1
            idx = idx + 1
        rewritten = ""
        seen_commas = 0
        idx = 0
        while idx < len(line):
            handled = 0
            if idx + 8 <= len(line) and line[idx:idx + 8] == "@PAGEOFF":
                idx = idx + 8
                handled = 1
            if handled == 0:
                if idx + 2 <= len(line) and line[idx:idx + 2] == ", ":
                    rewritten = rewritten + ", "
                    seen_commas = seen_commas + 1
                    if seen_commas == comma_count:
                        rewritten = rewritten + ":lo12:"
                    idx = idx + 2
                    handled = 1
            if handled == 0:
                rewritten = rewritten + line[idx]
                idx = idx + 1
        line = rewritten
    line = runtime_native_replace_all(line, "@PAGE", "")
    line = runtime_native_replace_all(line, ".section __TEXT,__text,regular,pure_instructions", ".text")
    line = runtime_native_replace_all(line, ".section __TEXT,__cstring,cstring_literals", ".section .rodata")
    line = runtime_native_replace_all(line, ".section __TEXT,__cstring", ".section .rodata")
    line = runtime_native_replace_all(line, ".section __TEXT,__const", ".section .rodata")
    line = runtime_native_replace_all(line, ".section __DATA,__const", ".section .data.rel.ro")
    line = runtime_native_replace_all(line, ".section __DATA,__data", ".data")
    line = runtime_native_replace_all(line, ".section __DATA,__bss", ".bss")
    line = runtime_native_replace_all(line, ".globl _main", ".globl main")
    if line == "_main:":
        line = "main:"
    line = runtime_native_replace_all(line, "bl _strlen", "bl strlen")
    line = runtime_native_replace_all(line, "bl _write", "bl write")
    line = runtime_native_replace_all(line, "b _write", "b write")
    line = runtime_native_replace_all(line, "bl _read", "bl read")
    line = runtime_native_replace_all(line, "bl _malloc", "bl malloc")
    line = runtime_native_replace_all(line, "bl _calloc", "bl calloc")
    line = runtime_native_replace_all(line, "bl _realloc", "bl realloc")
    line = runtime_native_replace_all(line, "bl _free", "bl free")
    line = runtime_native_replace_all(line, "bl _memcpy", "bl memcpy")
    line = runtime_native_replace_all(line, "bl _memcmp", "bl memcmp")
    line = runtime_native_replace_all(line, "bl _fopen", "bl fopen")
    line = runtime_native_replace_all(line, "bl _fread", "bl fread")
    line = runtime_native_replace_all(line, "bl _fwrite", "bl fwrite")
    line = runtime_native_replace_all(line, "bl _fclose", "bl fclose")
    line = runtime_native_replace_all(line, "bl _fflush", "bl fflush")
    line = runtime_native_replace_all(line, "bl _fseek", "bl fseek")
    line = runtime_native_replace_all(line, "bl _ftell", "bl ftell")
    line = runtime_native_replace_all(line, "bl _strtod", "bl strtod")
    line = runtime_native_replace_all(line, "bl _strtoll", "bl strtoll")
    line = runtime_native_replace_all(line, "bl _snprintf", "bl snprintf")
    line = runtime_native_replace_all(line, "bl _time", "bl time")
    line = runtime_native_replace_all(line, "bl _socket", "bl socket")
    line = runtime_native_replace_all(line, "bl _connect", "bl connect")
    line = runtime_native_replace_all(line, "bl _send", "bl send")
    line = runtime_native_replace_all(line, "bl _recv", "bl recv")
    line = runtime_native_replace_all(line, "bl _close", "bl close")
    line = runtime_native_replace_all(line, "bl _dup", "bl dup")
    line = runtime_native_replace_all(line, "b _exit", "b exit")
    if line == ".subsections_via_symbols":
        line = ""
    if trim_spaces(line) == "ret":
        # GNU as defers `ldr xN, =imm` constants to literal pools. Large
        # generated functions need bounded, non-fallthrough pool sites.
        line = line + "\n    .ltorg"
    elif len(trim_spaces(line)) >= 3 and trim_spaces(line)[0:3] == "b L":
        # Internal unconditional branches are also non-fallthrough. Flush
        # pending literals here so a single very large lowered function cannot
        # exceed GNU as's per-pool capacity before reaching its final `ret`.
        line = line + "\n    .ltorg"
    return line


def runtime_native_linux_aarch64_asm_text(text):
    out = ""
    idx = 0
    text_len = len(text)
    while idx < text_len:
        line = ""
        while idx < text_len and text[idx] != "\n":
            line = line + text[idx]
            idx = idx + 1
        if idx < text_len:
            idx = idx + 1
            source_line = line
            line = runtime_native_linux_aarch64_line(line)
            if line != "":
                out = out + line + "\n"
            elif source_line == "":
                out = out + "\n"
        else:
            line = runtime_native_linux_aarch64_line(line)
            if line != "":
                out = out + line
    return out


def runtime_native_append_target_asm_text(out, text, target):
    if target["backend"] == "darwin-aarch64":
        return asm_raw(out, text)
    lines = split_inventory_text(text, "\n")
    idx = 0
    while idx < len(lines):
        line = lines[idx]
        if target["backend"] == "linux-aarch64":
            line = runtime_native_linux_aarch64_line(line)
            if line != "":
                out = asm_raw(out, line + "\n")
        elif target["backend"] == "linux-x86_64":
            fail("legacy semantic x86 runtime renderer removed; use the native x86 emitter")
        else:
            fail("runtime-native assembly text target is not implemented: " + target["backend"])
        idx = idx + 1
    return out


def runtime_native_target_asm_text(text, target):
    if target["backend"] == "linux-x86_64":
        fail("legacy semantic x86 runtime renderer removed; use the native x86 emitter")
    if target["backend"] == "linux-aarch64":
        return runtime_native_linux_aarch64_asm_text(text)
    return text


def emit_native_runtime_direct_data_terminal(out, target):
    text = "# tyrion-app-component: terminal\n" + native_runtime_direct_terminal_key_text(target)
    return asm_cstr(out, "L_native_runtime_direct_terminal_suffix", runtime_native_target_asm_text(text, target))

