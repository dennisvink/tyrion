    out = asm_label(out, "L_native_runtime_direct_append_exception_branch_try_prefix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_exception_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_exception_branch_fail")
    out = asm_line(out, "b L_native_runtime_direct_append_exception_branch_target_done")
    out = asm_label(out, "L_native_runtime_direct_append_exception_branch_function")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_function")
    out = asm_line(out, "ldr x21, [x9]")
    out = asm_line(out, "cmp x21, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_exception_branch_unhandled")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_return_branch")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_exception_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
