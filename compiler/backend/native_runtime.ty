def emit_native_runtime_direct_dict_runtime(out, target):
    # Materialize a kind-14 dictionary through its reverse kind-13 pair chain.
    # Pair recursion restores source order, so repeated keys deterministically
    # retain the last source value through __tyrion_app_dict_set.
