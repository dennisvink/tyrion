def emit_native_runtime_direct_call_runtime(out, target):
    primitive_ok = emit_native_runtime_direct_primitive_lookup_runtime(out, target)
    if not primitive_ok:
        fail("primitive lookup runtime emission failed")
    out = emit_native_runtime_direct_call_lookup_runtime(out, target)
    out = emit_native_runtime_direct_call_arg_expr_runtime(out, target)
    out = emit_native_runtime_direct_call_binding_runtime(out, target)
    out = emit_native_runtime_direct_call_arg_copy_runtime(out, target)
    out = emit_native_runtime_direct_comprehension_runtime(out, target)
    out = emit_native_runtime_direct_sorted_runtime(out, target)
    out = emit_native_runtime_direct_aggregate_runtime(out, target)
    out = emit_native_runtime_direct_dict_runtime(out, target)
    out = emit_native_runtime_direct_index_runtime(out, target)
    out = emit_native_runtime_direct_slice_runtime(out, target)
    out = emit_native_runtime_direct_method_runtime(out, target)
    out = emit_native_runtime_direct_tcp_runtime(out, target)
    out = emit_native_runtime_direct_extension_plan_runtime(out, target)
    out = emit_native_runtime_direct_general_builtin_runtime(out, target)
    out = emit_native_runtime_direct_unary_builtin_runtime(out, target)
    out = emit_native_runtime_direct_data(out, target)
    return out

def emit_native_runtime_direct_primitive_lookup_runtime(out, target):
    # Resolve a source identifier token once to the canonical primitive-schema
    # ID. Descendant dispatch consumes these stable IDs; target-local operation
    # modes remain private to the renderer that implements the primitive.
    out = asm_label(out, "L_native_runtime_direct_primitive_id")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    primitive_count = primitive_schema_count()
    idx = 0
    while idx < primitive_count:
        public_name = primitive_schema_public_name(idx)
        primitive_id = idx + 1
        out = asm_line(out, "mov x0, x19")
        out = asm_addr(out, target, "x1", "L_native_runtime_direct_primitive_name_" + str(idx))
        out = asm_line(out, "mov x2, #" + str(len(public_name)))
        out = asm_line(out, "bl L_native_runtime_direct_token_equals")
        out = asm_line(out, "cbnz w0, L_native_runtime_direct_primitive_id_" + str(primitive_id))
        idx = idx + 1
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "b L_native_runtime_direct_primitive_id_return")
    idx = 0
    while idx < primitive_count:
        primitive_id = idx + 1
        out = asm_label(out, "L_native_runtime_direct_primitive_id_" + str(primitive_id))
        out = asm_line(out, "mov w0, #" + str(primitive_id))
        out = asm_line(out, "b L_native_runtime_direct_primitive_id_return")
        idx = idx + 1
    out = asm_label(out, "L_native_runtime_direct_primitive_id_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")
    return True

def emit_native_runtime_direct_sorted_runtime(out, target):
    # x0=handle, x1=call AST, x2=text builder, x3=data builder. The optional
    # key lambda is emitted through the ordinary generated function ABI.
    out = asm_label(out, "L_native_runtime_direct_emit_sorted")
    out = asm_line(out, "stp x29, x30, [sp, #-160]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x9, #-1")
    out = asm_line(out, "stp x9, x9, [sp, #80]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_sorted_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x23, [x9, #32]")
    out = asm_line(out, "mov x24, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_sorted_collect")
    out = asm_line(out, "cmp x23, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_sorted_validate")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x23, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_sorted_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x25, x9, x23, lsl #6")
