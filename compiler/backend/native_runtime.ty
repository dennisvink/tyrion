def emit_native_runtime_direct_data_lifecycle(out, target):
    text = "# tyrion-app-component: lifecycle\n" + native_runtime_direct_lifecycle_text()
    return asm_cstr(out, "L_native_runtime_direct_lifecycle_suffix", runtime_native_target_asm_text(text, target))

def native_runtime_direct_shared_storage_text():
    text = ".section __DATA,__bss\n.p2align 3\n"
    text = text + "__tyrion_app_shared_heads:\n    .space 2097152\n"
    text = text + ".section __TEXT,__text,regular,pure_instructions\n.p2align 2\n"
    text = text + "__tyrion_app_shared_retain:\n    stp x29, x30, [sp, #-64]!\n"
