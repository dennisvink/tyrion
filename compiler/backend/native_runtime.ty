    # helper. Register them directly instead of packing them into an aliasing
    # aggregate; semantic selection still uses only canonical operation IDs.
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(0)), binary_code_0)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(1)), binary_code_1)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(2)), binary_code_2)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(3)), binary_code_3)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(4)), binary_code_4)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(5)), binary_code_5)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(6)), binary_code_6)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(7)), binary_code_7)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(8)), binary_code_8)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(9)), binary_code_9)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(10)), binary_code_10)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(11)), binary_code_11)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(12)), binary_code_12)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(13)), binary_code_13)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(14)), binary_code_14)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(15)), binary_code_15)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(16)), binary_code_16)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(17)), binary_code_17)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(18)), binary_code_18)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(19)), binary_code_19)
    out = asm_cstr(out, "L_native_runtime_direct_binary_code_" + str(application_binary_operator_id_at(20)), binary_code_20)
    out = asm_line(out, ".p2align 2")
    return out

def emit_native_write_text_file_primitive(out, target):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x21 = generated_value_tag_mem("x21")

    out = asm_label(out, "L_native_write_text_file")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "cbz x21, L_write_text_file_fail")
    out = asm_line(out, "ldrb w9, " + value_tag_x21)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne L_write_text_file_path_ready")
    out = asm_line(out, "ldr x21, [x21]")
    out = asm_label(out, "L_write_text_file_path_ready")
    out = asm_line(out, "mov x19, x1")
    out = asm_line(out, "cbz x19, L_write_text_file_fail")
    out = asm_line(out, "ldrb w9, " + value_tag_x19)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq L_write_text_file_text_heap_ready")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq L_write_text_file_text_heap_ready")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.ne L_write_text_file_text_ready")
    out = asm_label(out, "L_write_text_file_text_heap_ready")
    out = asm_line(out, "ldr x10, [x19]")
    out = asm_line(out, "cbz x10, L_write_text_file_text_ready")
    out = asm_line(out, "cmp x10, #4096")
    out = asm_line(out, "b.lo L_write_text_file_text_ready")
    out = asm_line(out, "lsr x11, x10, #48")
    out = asm_line(out, "cbnz x11, L_write_text_file_text_ready")
    out = asm_line(out, "mov x19, x10")
    out = asm_label(out, "L_write_text_file_text_ready")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_mode_w")
    out = asm_line(out, "bl " + asm_call_name(target, "fopen"))
    out = asm_line(out, "cbz x0, L_write_text_file_fail")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "fputs"))
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_write_text_file_fail")
    out = asm_addr(out, target, "x0", "L_native_compiler_file_write_failed")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_compiler_file_report_failure")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    return out

def emit_native_lex_buffer_runtime(out, target):
    asm_label(out, "L_native_lex_buffer_init")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
