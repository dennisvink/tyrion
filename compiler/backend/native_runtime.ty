def native_runtime_dynamic_extension_root_prefix(target):
    return target["rodata_section"] + "\n__tyrion_app_extension_root:\n    .byte "

def native_runtime_dynamic_extension_root_suffix(target):
    return "0\n" + target["text_section"] + "\n"

def emit_native_runtime_direct_data_core(out, target):
    primitive_count = primitive_schema_count()
    primitive_idx = 0
    while primitive_idx < primitive_count:
        primitive_name = primitive_schema_public_name(primitive_idx)
        out = asm_cstr(out, "L_native_runtime_direct_primitive_name_" + str(primitive_idx), primitive_name)
        primitive_idx = primitive_idx + 1
    out = asm_cstr(out, "L_native_runtime_direct_diag_call_prefix", "direct-native analysis rejected code=unknown-call;kind=call;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_method_prefix", "direct-native analysis rejected code=unsupported-method;kind=method_call;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_primitive_arity_prefix", "direct-native analysis rejected code=primitive-arity;kind=call;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_keyword_prefix", "direct-native analysis rejected code=unsupported-keyword;kind=kwarg;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_assignment_target_prefix", "direct-native analysis rejected code=unsupported-assignment-target;kind=assignment_target;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_multiple_starred_prefix", "direct-native analysis rejected code=multiple-starred-targets;kind=unpack;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_break_context_prefix", "direct-native analysis rejected code=break-outside-loop;kind=break;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_continue_context_prefix", "direct-native analysis rejected code=continue-outside-loop;kind=continue;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_return_context_prefix", "direct-native analysis rejected code=return-outside-function;kind=return;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_yield_context_prefix", "direct-native analysis rejected code=yield-outside-function;kind=yield;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_lambda_capture_prefix", "direct-native analysis rejected code=unsupported-lambda-capture;kind=lambda;position=")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_root", "program")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_stmt", ".stmt")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_arg", ".arg")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_body", ".body")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_resource", ".resource")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_except", ".except")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_finally", ".finally")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_if", ".if")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_elif", ".elif")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_else", ".else")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_condition", ".condition")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_value", ".value")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_left", ".left")
    out = asm_cstr(out, "L_native_runtime_direct_diag_path_right", ".right")
