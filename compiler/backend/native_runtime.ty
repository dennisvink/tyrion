def emit_native_runtime_direct_call_lookup_runtime(out, target):
    # x0=handle, x1=callee identifier token -> x1=kind-107 record or -1.
    out = asm_label(out, "L_native_runtime_direct_find_function")
    out = asm_line(out, "stp x29, x30, [sp, #-128]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x20, [x0, #8]")
    out = asm_line(out, "ldr x21, [x0, #16]")
    out = asm_line(out, "ldr x22, [x19, #56]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x22, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x22, lsl #6")
    out = asm_line(out, "ldr x9, [x9, #24]")
    out = asm_line(out, "mov x22, x9")
    out = asm_label(out, "L_native_runtime_direct_find_function_loop")
    out = asm_line(out, "cmp x22, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_find_function_absent")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x22, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x22, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x24, [x23, #24]")
    out = asm_line(out, "ldr x22, [x23, #32]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x25, x9, x24, lsl #6")
    out = asm_line(out, "ldr x9, [x25]")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_function_loop")
    out = asm_line(out, "ldr x1, [x25, #24]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "ldr x9, [x0, #16]")
    out = asm_line(out, "cmp x9, x21")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_function_loop")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_find_function_loop")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_find_function_return")
    out = asm_label(out, "L_native_runtime_direct_find_function_absent")
    out = asm_line(out, "mov x1, #-1")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_find_function_return")
    out = asm_label(out, "L_native_runtime_direct_find_function_fail")
    out = asm_line(out, "mov x1, #-1")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_find_function_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #128")
    out = asm_line(out, "ret")

    # x0=handle, x1=class-name token -> x1=kind-120 record or -1.
    out = asm_label(out, "L_native_runtime_direct_find_class")
    out = asm_line(out, "stp x29, x30, [sp, #-128]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_find_class_fail")
    out = asm_line(out, "ldr x20, [x0, #8]")
    out = asm_line(out, "ldr x21, [x0, #16]")
    out = asm_line(out, "ldr x22, [x19, #56]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x22, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_find_class_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x22, lsl #6")
    out = asm_line(out, "ldr x22, [x9, #24]")
    out = asm_label(out, "L_native_runtime_direct_find_class_loop")
    out = asm_line(out, "cmp x22, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_find_class_absent")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x22, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_find_class_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x22, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_class_fail")
    out = asm_line(out, "ldr x24, [x23, #24]")
    out = asm_line(out, "ldr x22, [x23, #32]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
