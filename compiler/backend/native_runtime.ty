    out = asm_label(out, "L_native_runtime_direct_emit_function_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_function_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_function_binding_runtime(out, target)
    out = emit_native_runtime_direct_generator_runtime(out, target)
    return out

def emit_native_runtime_direct_generator_runtime(out, target):
    # Determine generator-ness from canonical child records. Nested function
    # definitions are intentionally opaque: a yield in a nested definition
    # does not turn the enclosing function into a generator.
    # x0=handle, x1=kind-113 block index -> w0=0/1.
    out = asm_label(out, "L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #113")
    out = asm_line(out, "b.ne L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x21, [x9, #24]")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_loop")
    out = asm_line(out, "cmp x21, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x21, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x22, x9, x21, lsl #6")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x23, [x22, #32]")
    out = asm_line(out, "ldr x21, [x22, #24]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x21, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x22, x9, x21, lsl #6")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #119")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "cmp x9, #103")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_if")
    out = asm_line(out, "cmp x9, #104")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_child32")
    out = asm_line(out, "cmp x9, #108")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_child40")
    out = asm_line(out, "cmp x9, #116")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_child40")
    out = asm_line(out, "cmp x9, #117")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_try")
    out = asm_line(out, "mov x21, x23")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_loop")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_child32")
    out = asm_line(out, "ldr x1, [x22, #32]")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_child_call")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_child40")
    out = asm_line(out, "ldr x1, [x22, #40]")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_child_call")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "mov x21, x23")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_loop")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_if")
    out = asm_line(out, "ldr x1, [x22, #32]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "ldr x24, [x22, #40]")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_if_branch")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_next")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x24, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #115")
    out = asm_line(out, "b.ne L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "ldr x1, [x9, #32]")
    out = asm_line(out, "ldr x24, [x9, #40]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_if_branch")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_try")
    out = asm_line(out, "ldr x1, [x22, #24]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "ldr x1, [x22, #32]")
    out = asm_line(out, "cmp x1, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_try_finally")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_try_finally")
    out = asm_line(out, "ldr x1, [x22, #40]")
    out = asm_line(out, "cmp x1, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_block_has_yield_next")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_runtime_direct_block_has_yield")
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_block_has_yield_yes")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_next")
    out = asm_line(out, "mov x21, x23")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_loop")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_yes")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_block_has_yield_return")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_no")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_block_has_yield_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_generator_function_emitter(out, target)
    return out

def emit_native_runtime_direct_generator_function_emitter(out, target):
    # x0=handle, x1=kind-107 function record, x2=text builder, x3=data builder.
    # The emitted application constructor owns a heap snapshot of the normal
    # value-slot frame. Resume restores that frame and jumps to the exact
    # continuation address stored by the canonical kind-119 yield emitter.
    out = asm_label(out, "L_native_runtime_direct_emit_generator_function")
    out = asm_line(out, "stp x29, x30, [sp, #-144]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_generator_function_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_generator_function_unsupported")
    # Every token and AST record has a canonical 128-byte value slot. Keeping
    # the exact same frame shape lets the ordinary expression/block emitters
    # run unchanged inside a resumed generator.
    out = asm_line(out, "ldr x9, [x19, #16]")
    out = asm_line(out, "ldr x24, [x9, #8]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "add x24, x24, x9")
    out = asm_line(out, "lsl x25, x24, #7")
    out = asm_line(out, "add x26, x25, #256")

    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_prologue_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_prologue_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_prologue_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [x23, #48]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_prologue_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_label_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "bl L_native_runtime_direct_emit_param_bindings")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_generator_function_return")

    # Constructor body: allocate state, retain the initialized parameter
    # frame, publish the resume entry, and return a tag-21 generator value.
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_ctor_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
