    out = asm_label(out, "L_native_ast_sequence_get_chain_else_next")
    out = asm_line(out, "ldr x22, [x9, #40]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_chain_match")
    out = asm_line(out, "ldr x10, [sp, #56]")
    out = asm_line(out, "cmp x10, #2")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_argument")
    out = asm_line(out, "ldr x22, [x9, #24]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain_self")
    out = asm_label(out, "L_native_ast_sequence_get_argument")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.ne L_native_ast_sequence_get_fail")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_ast_sequence_get_chain_self")
    out = asm_line(out, "ldr x22, [x9, #24]")
    out = asm_label(out, "L_native_ast_sequence_get_chain_self")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "b L_native_ast_sequence_get_return")
    out = asm_label(out, "L_native_ast_sequence_get_fail")
    out = asm_line(out, "mov x0, #0")
    out = asm_label(out, "L_native_ast_sequence_get_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # Canonical slot writers used by field projection and sequence iteration.
    # x0=span, x1=len, x2=result slot -> w0=success. AST projection must use
    # canonical string values: private borrowed-span tags are invisible to the
    # ordinary expression evaluator and would make field results look inline.
    out = asm_label(out, "L_native_ast_write_borrowed_string")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "cbz x21, L_native_ast_write_string_fail")
    out = asm_line(out, "cbnz x19, L_native_ast_write_string_release")
    out = asm_line(out, "cbnz x20, L_native_ast_write_string_fail")
    out = asm_label(out, "L_native_ast_write_string_release")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_generated_value_release_owned_slot")
    out = asm_line(out, "cmp x20, #120")
    out = asm_line(out, "b.hi L_native_ast_write_string_heap")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "cbz x20, L_native_ast_write_string_inline_done")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x19")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_label(out, "L_native_ast_write_string_inline_done")
    out = asm_line(out, "strb wzr, [x21, x20]")
    out = asm_line(out, "mov w9, #1")
    out = asm_line(out, "strb w9, " + value_tag_x21)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_ast_write_string_return")
    out = asm_label(out, "L_native_ast_write_string_heap")
    out = asm_line(out, "add x0, x20, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_ast_write_string_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "mov x1, x19")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "strb wzr, [x22, x20]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "str x22, [x21]")
    out = asm_line(out, "str x20, [x21, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, " + value_tag_x21)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_ast_write_string_return")
    out = asm_label(out, "L_native_ast_write_string_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_ast_write_string_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    out = asm_label(out, "L_native_ast_write_handle")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, L_native_ast_write_handle_fail")
