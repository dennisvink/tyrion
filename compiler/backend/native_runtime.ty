    text_suffix = text_suffix + "__tyrion_app_print_string_inline:\n    mov x0, x19\n    mov x1, #0\n__tyrion_app_print_string_inline_len:\n    ldrb w9, [x0, x1]\n    cbz w9, __tyrion_app_print_string_inline_write\n    add x1, x1, #1\n    cmp x1, #121\n    b.lo __tyrion_app_print_string_inline_len\n__tyrion_app_print_string_inline_write:\n    bl __tyrion_app_write\n    b __tyrion_app_print_done\n__tyrion_app_print_string:\n    ldr x0, [x19]\n"
