    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x24, x4")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally")
    out = asm_line(out, "ldr x23, [x9]")
    out = asm_line(out, "cmp x23, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_control_branch_direct")
    out = asm_line(out, "cmp x20, #1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_control_branch_pending")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally_loop")
    out = asm_line(out, "ldr x9, [x9]")
    out = asm_line(out, "cmp x9, x24")
    out = asm_line(out, "b.ne L_native_runtime_direct_append_control_branch_direct")
    out = asm_label(out, "L_native_runtime_direct_append_control_branch_pending")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_pending_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "lsl x1, x23, #7")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_pending_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_pending_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "b L_native_runtime_direct_append_control_branch_suffix")
    out = asm_label(out, "L_native_runtime_direct_append_control_branch_direct")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_branch_fail")
