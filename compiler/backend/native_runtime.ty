    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "mov x1, x2")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_find_class_method_fail")
    out = asm_line(out, "ldr x21, [x0, #8]")
    out = asm_line(out, "ldr x22, [x0, #16]")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x20, [x9, #32]")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x20, [x9, #24]")
    out = asm_label(out, "L_native_runtime_direct_find_class_method_loop")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_find_class_method_absent")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_class_method_fail")
    out = asm_line(out, "ldr x24, [x23, #24]")
    out = asm_line(out, "ldr x20, [x23, #32]")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x25, x9, x24, lsl #6")
    out = asm_line(out, "ldr x9, [x25]")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_class_method_loop")
    out = asm_line(out, "ldr x1, [x25, #24]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
