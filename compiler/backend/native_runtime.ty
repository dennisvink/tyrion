    out = asm_line(out, "b.ne L_native_runtime_direct_token_equals_no")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cmp w0, #0")
    out = asm_line(out, "cset w0, eq")
    out = asm_line(out, "b L_native_runtime_direct_token_equals_return")
    out = asm_label(out, "L_native_runtime_direct_token_equals_no")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_token_equals_return")
    out = asm_line(out, "ldp x29, x30, [sp], #16")
    out = asm_line(out, "ret")
    return out

def emit_native_runtime_direct_tcp_call_runtime(out, target):
    # x0=AST handle, x1=call AST index, x2=operation, x3=text builder,
    # x4=data builder. Positional arguments are materialized in source order.
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call")
