    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_resume_e")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_resume_f")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")

    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_function")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #112]")
    out = asm_line(out, "str x20, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_generator")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #120]")
    out = asm_line(out, "str x20, [x9]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "mov x4, #-1")
    out = asm_line(out, "mov x5, x20")
    out = asm_line(out, "bl L_native_runtime_direct_emit_block")
    out = asm_line(out, "str w0, [sp, #128]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_generator")
    out = asm_line(out, "ldr x10, [sp, #120]")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_function")
    out = asm_line(out, "ldr x10, [sp, #112]")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "ldr w0, [sp, #128]")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_generator_function_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_done_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_done_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_done_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_done_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_generator_function_return")
    out = asm_label(out, "L_native_runtime_direct_emit_generator_function_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_generator_function_return")
    out = asm_label(out, "L_native_runtime_direct_emit_generator_function_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_generator_function_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #144")
    out = asm_line(out, "ret")
    return out

def emit_native_runtime_direct_function_binding_runtime(out, target):
    # x0=handle, x1=reverse kind-114 link, x2=text builder.
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "str x23, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings_loop")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_param_bindings_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_param_bindings_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #114")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_param_bindings_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "bl L_native_runtime_direct_variable_offset")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_unsupported")
    out = asm_line(out, "mov x22, x1")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_param_bind_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_param_bind_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "ldr x1, [x23, #48]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_param_bind_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "ldr x20, [x23, #40]")
    out = asm_line(out, "b L_native_runtime_direct_emit_param_bindings_loop")
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_param_bindings_return")
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_param_bindings_return")
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_param_bindings_return")
    out = asm_line(out, "ldr x23, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_argument_runtime(out, target)
    return out

def emit_native_runtime_direct_argument_runtime(out, target):

    # Evaluate a reverse kind-8 argument list into AST-indexed value slots.
    # Output is emitted by a separate pass only after every expression succeeds.
    out = asm_label(out, "L_native_runtime_direct_emit_arguments")
    out = asm_line(out, "stp x29, x30, [sp, #-128]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #96]")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_arguments_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_arguments_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_arguments_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_arguments")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_arguments_return")
    out = asm_line(out, "ldr x0, [sp, #96]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_arguments_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_arg")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_arguments_fail")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_arg_next")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_addr(out, target, "x11", "L_native_runtime_direct_diag_arg_index")
    out = asm_line(out, "str x10, [x11]")
    out = asm_addr(out, target, "x11", "L_native_runtime_direct_diag_has_arg")
    out = asm_line(out, "mov x12, #1")
    out = asm_line(out, "str x12, [x11]")
    out = asm_line(out, "mov x0, x10")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_index")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_arguments_fail")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_arg_next")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "add x10, x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "ldr x24, [x23, #24]")
    out = asm_line(out, "mov x26, x24")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_arguments_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x24, x9, x24, lsl #6")
    out = asm_line(out, "ldr x9, [x24]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "b L_native_runtime_direct_emit_arguments_return")
    out = asm_label(out, "L_native_runtime_direct_emit_arguments_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_arguments_return")
    out = asm_label(out, "L_native_runtime_direct_emit_arguments_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_arguments_return")
    out = asm_label(out, "L_native_runtime_direct_emit_arguments_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_arguments_return")
    out = asm_line(out, "ldr x27, [sp, #80]")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #128")
    out = asm_line(out, "ret")

    # Append print operations in source order after the evaluation pass has
    # completed. x0=handle, x1=reverse kind-8 list, x2=text builder.
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_argument_values_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_argument_values_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x22, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_argument_values_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x22, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "bl L_native_runtime_direct_emit_argument_values")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_argument_values_return")
    out = asm_line(out, "ldr x9, [x22, #40]")
    out = asm_line(out, "cbz x9, L_native_runtime_direct_emit_argument_values_value")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_write_space")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_argument_values_fail")
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values_value")
    out = asm_line(out, "ldr x20, [x22, #24]")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_print_slot_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_argument_values_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "lsl x1, x20, #7")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_argument_values_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_print_slot_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_argument_values_fail")
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_argument_values_return")
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_argument_values_return")
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_argument_values_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_expression_runtime(out, target)
    return out

def emit_native_runtime_direct_expression_runtime(out, target):

    # Textual operator spelling is projected once at the AST boundary. All
    # downstream direct-emitter selection consumes canonical semantic IDs.
    binary_count = application_binary_operator_count()
    out = asm_label(out, "L_native_runtime_direct_binary_id")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    binary_idx = 0
    while binary_idx < binary_count:
        binary_name = application_binary_operator_name_at(binary_idx)
        binary_id = application_binary_operator_id_at(binary_idx)
        out = asm_line(out, "cmp x20, #" + str(len(binary_name)))
        out = asm_line(out, "b.ne L_native_runtime_direct_binary_id_next_" + str(binary_id))
        out = asm_line(out, "mov x0, x19")
        out = asm_addr(out, target, "x1", "L_native_runtime_direct_binary_name_" + str(binary_id))
        out = asm_line(out, "mov x2, #" + str(len(binary_name)))
        out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
        out = asm_line(out, "cbz w0, L_native_runtime_direct_binary_id_found_" + str(binary_id))
        out = asm_label(out, "L_native_runtime_direct_binary_id_next_" + str(binary_id))
        binary_idx = binary_idx + 1
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "b L_native_runtime_direct_binary_id_return")
    binary_idx = 0
    while binary_idx < binary_count:
        binary_id = application_binary_operator_id_at(binary_idx)
        out = asm_label(out, "L_native_runtime_direct_binary_id_found_" + str(binary_id))
        out = asm_line(out, "mov x0, #" + str(binary_id))
        out = asm_line(out, "b L_native_runtime_direct_binary_id_return")
        binary_idx = binary_idx + 1
    out = asm_label(out, "L_native_runtime_direct_binary_id_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # x0=canonical binary operation ID, x1=text builder. Return 1 appended,
    # 2 unsupported, or 0 on builder failure.
    out = asm_label(out, "L_native_runtime_direct_append_binary_op")
    binary_idx = 0
    while binary_idx < binary_count:
