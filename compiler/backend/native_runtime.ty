    asm_label(out, "L_native_pratt_bp_4")
    asm_line(out, "mov x0, #30")
    asm_line(out, "mov x1, #5")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_5")
    asm_line(out, "mov x0, #30")
    asm_line(out, "mov x1, #6")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_6")
    asm_line(out, "mov x0, #30")
    asm_line(out, "mov x1, #7")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_7")
    asm_line(out, "mov x0, #30")
    asm_line(out, "mov x1, #8")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_8")
    asm_line(out, "mov x0, #30")
    asm_line(out, "mov x1, #9")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_9")
    asm_line(out, "mov x0, #40")
    asm_line(out, "mov x1, #10")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_10")
    asm_line(out, "mov x0, #40")
    asm_line(out, "mov x1, #11")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_11")
    asm_line(out, "mov x0, #50")
    asm_line(out, "mov x1, #12")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_12")
    asm_line(out, "mov x0, #50")
    asm_line(out, "mov x1, #13")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_13")
    asm_line(out, "mov x0, #50")
    asm_line(out, "mov x1, #14")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_14")
    asm_line(out, "mov x0, #50")
    asm_line(out, "mov x1, #15")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_15")
    asm_line(out, "mov x0, #60")
    asm_line(out, "mov x1, #16")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_binding_power_return")
    asm_line(out, "ldr x19, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #48")
    asm_line(out, "ret")
    asm_cstr(out, "L_native_pratt_op_0", "KW_OR")
    asm_cstr(out, "L_native_pratt_op_1", "KW_AND")
    asm_cstr(out, "L_native_pratt_op_2", "EQEQ")
    asm_cstr(out, "L_native_pratt_op_3", "NE")
    asm_cstr(out, "L_native_pratt_op_4", "LT")
    asm_cstr(out, "L_native_pratt_op_5", "LE")
    asm_cstr(out, "L_native_pratt_op_6", "GT")
    asm_cstr(out, "L_native_pratt_op_7", "GE")
    asm_cstr(out, "L_native_pratt_op_8", "KW_IN")
