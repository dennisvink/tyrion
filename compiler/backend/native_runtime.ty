    out = asm_addr(out, target, "x1", "L_native_runtime_direct_builtin_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_unary_builtin_fail")
    out = asm_line(out, "lsl x1, x20, #7")
