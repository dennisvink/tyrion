    out = asm_label(out, "L_native_runtime_direct_find_class_method_absent")
    out = asm_line(out, "mov x1, #-1")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_find_class_method_return")
    out = asm_label(out, "L_native_runtime_direct_find_class_method_fail")
    out = asm_line(out, "mov x1, #-1")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_find_class_method_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #128")
