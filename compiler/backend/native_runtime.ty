    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_call_arg_copies_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov x2, x22")
    out = asm_line(out, "ldr x3, [sp, #72]")
    out = asm_line(out, "bl L_native_runtime_direct_argument_param_ordinal")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_unsupported")
    out = asm_line(out, "mov x24, x1")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_fail")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_fail")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_call_copy_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_call_arg_copies_fail")
    out = asm_line(out, "ldr x20, [x23, #32]")
    out = asm_line(out, "b L_native_runtime_direct_emit_call_arg_copies_loop")
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_copies_ok")
