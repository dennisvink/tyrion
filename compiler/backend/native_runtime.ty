    asm_line(out, "ldr x0, [x21]")
    asm_line(out, "cbz x0, L_native_parse_expression_to_handle_fail")
    asm_line(out, "bl " + asm_call_name(target, "free"))
    asm_label(out, "L_native_parse_expression_to_handle_fail")
    asm_line(out, "mov x0, #0")
    asm_label(out, "L_native_parse_expression_to_handle_return")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #128")
    asm_line(out, "ret")

    # x0=typed token vector -> x0=owned program AST handle or zero.
    asm_label(out, "L_native_parse_program_to_handle")
    asm_line(out, "stp x29, x30, [sp, #-128]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "cbz x19, L_native_parse_program_to_handle_fail")
    asm_line(out, "ldrb w9, [x19]")
    asm_line(out, "cmp w9, #167")
    asm_line(out, "b.ne L_native_parse_program_to_handle_fail")
    asm_line(out, "add x20, sp, #64")
    asm_line(out, "stp xzr, xzr, [x20]")
    asm_line(out, "stp xzr, xzr, [x20, #16]")
    asm_line(out, "mov x0, x20")
    asm_line(out, "mov x1, #64")
    asm_line(out, "bl L_native_ast_arena_init")
    asm_line(out, "cbz w0, L_native_parse_program_to_handle_fail")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, #0")
    asm_line(out, "mov x2, x20")
    asm_line(out, "bl L_native_parse_program")
    asm_line(out, "cbz w0, L_native_parse_program_to_handle_free")
    asm_line(out, "mov x21, x1")
    asm_line(out, "mov x22, x2")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x20")
    asm_line(out, "mov x2, x21")
    asm_line(out, "mov x3, x22")
    asm_line(out, "bl L_native_ast_handle_create")
    asm_line(out, "cbnz x0, L_native_parse_program_to_handle_return")
    asm_label(out, "L_native_parse_program_to_handle_free")
    asm_line(out, "ldr x0, [x20]")
    asm_line(out, "cbz x0, L_native_parse_program_to_handle_fail")
    asm_line(out, "bl " + asm_call_name(target, "free"))
    asm_label(out, "L_native_parse_program_to_handle_fail")
    asm_line(out, "mov x0, #0")
    asm_label(out, "L_native_parse_program_to_handle_return")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #128")
    asm_line(out, "ret")
    asm_cstr(out, "L_native_program_eof_kind", "EOF")
    asm_cstr(out, "L_native_program_newline_kind", "NEWLINE")
    asm_cstr(out, "L_native_parse_failure_format", "parser rejected code=syntax-error;line=%llu;column=%llu;detail=%s\n")
    asm_line(out, ".p2align 2")

    # x0=typed token vector. Report the parser-owned failure token exactly
    # once and mark it terminal so outer build layers do not add generic text.
    asm_label(out, "L_native_parse_report_failure")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_addr(out, target, "x9", "L_native_parse_failure_pos")
    asm_line(out, "ldr x1, [x9]")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_native_token_record_at")
    asm_line(out, "cbz x0, L_native_parse_report_failure_fail")
    asm_line(out, "ldr x3, [x0]")
    asm_line(out, "ldp x1, x2, [x0, #24]")
    asm_addr(out, target, "x0", "L_native_parse_failure_format")
    if target["os"] == "darwin":
        # Darwin/AArch64 passes variadic arguments on the stack. The fixed
        # format parameter remains in x0; Linux/AArch64 keeps x1-x3.
        asm_line(out, "sub sp, sp, #32")
        asm_line(out, "str x1, [sp]")
        asm_line(out, "str x2, [sp, #8]")
        asm_line(out, "str x3, [sp, #16]")
    asm_line(out, "bl " + asm_call_name(target, "printf"))
    if target["os"] == "darwin":
        asm_line(out, "add sp, sp, #32")
    asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    asm_line(out, "mov x10, #1")
    asm_line(out, "str x10, [x9]")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_native_parse_report_failure_return")
    asm_label(out, "L_native_parse_report_failure_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_native_parse_report_failure_return")
    asm_line(out, "ldr x19, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #48")
    asm_line(out, "ret")

    asm_label(out, "L_native_parse_failure_position")
    asm_addr(out, target, "x9", "L_native_parse_failure_pos")
    asm_line(out, "ldr x0, [x9]")
    asm_line(out, "ret")
    asm_section(out, target["data_section"])
    asm_line(out, ".p2align 3")
    asm_label(out, "L_native_parse_failure_pos")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_current_function")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_current_generator")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_current_try")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_current_try_mode")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_current_finally")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_current_finally_loop")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_diag_code")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_stmt")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_arg_index")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_arg_next")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_nested_arg_index")
    asm_line(out, ".quad -1")
    asm_label(out, "L_native_runtime_direct_diag_has_arg")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_parent_kind")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_parent_stmt")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_edge_kind")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_detail_ptr")
    asm_line(out, ".quad 0")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_numeric_detail")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_diag_reported")
    asm_line(out, ".quad 0")
    asm_line(out, ".p2align 3")
    asm_label(out, "L_native_runtime_direct_diag_path_builder")
    asm_line(out, ".space 24")
    asm_label(out, "L_native_runtime_direct_diag_path_storage")
    asm_line(out, ".space 512")
    asm_line(out, ".p2align 3")
    asm_label(out, "L_native_runtime_direct_extension_count")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_extension_source_count")
    asm_line(out, ".quad 0")
    asm_label(out, "L_native_runtime_direct_extension_names")
    asm_line(out, ".space 1024")
    asm_label(out, "L_native_runtime_direct_extension_root")
    asm_line(out, ".space 512")
    asm_label(out, "L_native_runtime_direct_extension_manifest")
    asm_line(out, ".space 512")
    asm_label(out, "L_native_runtime_direct_extension_sources")
    asm_line(out, ".space 16384")
    asm_label(out, "L_native_runtime_direct_extension_symbols")
    asm_line(out, ".space 2048")
    asm_section(out, target["text_section"])
    asm_line(out, ".p2align 2")
    return out
