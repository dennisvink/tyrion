    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #58")
    out = asm_line(out, "bic x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")

    out = asm_label(out, "L_native_ast_field_lambda_binding_target")
    out = asm_line(out, "ldr x24, [x22, #24]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl L_native_ast_handle_token_leaf_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")

    out = asm_label(out, "L_native_ast_field_lambda_binding_value")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x19, #56]")
    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x0, #64]")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #58")
    out = asm_line(out, "bic x9, x9, x10")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #57")
    out = asm_line(out, "orr x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")
    out = asm_label(out, "L_native_ast_field_target_assignment_record")
    out = asm_line(out, "ldr x24, [x22, #24]")
    out = asm_line(out, "b L_native_ast_field_write_child")
    out = asm_label(out, "L_native_ast_field_target_assignment_unpack")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x19, #56]")
    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x0, #64]")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #61")
    out = asm_line(out, "orr x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")

    # Preserve the efficient physical mode-3 assignment record while exposing
