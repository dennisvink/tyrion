def emit_native_runtime_direct_control_dispatch_runtime(out, target):
    # x0=builder, x1=try record, x2=enclosing loop record, x3=function record.
    # The active-finally globals already describe the containing finally.
    out = asm_label(out, "L_native_runtime_direct_append_control_dispatch")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
