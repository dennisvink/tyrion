def emit_native_runtime_direct_control_branch_runtime(out, target):
    # x0=builder, x1=control kind (return/break/continue), x2=direct branch
    # prefix, x3=direct label suffix, x4=enclosing loop record or -1.
    out = asm_label(out, "L_native_runtime_direct_append_control_branch")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
