    asm_line(out, "mov x0, x23")
    asm_addr(out, target, "x1", "L_native_pratt_prefix_kind_1")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_prefix_unary")
