def emit_native_runtime_direct_data_finally_control_templates(out, target):
    out = asm_cstr(out, "L_native_runtime_direct_control_pending_a", "    ldr x15, =")
    out = asm_cstr(out, "L_native_runtime_direct_control_pending_b", "\n    add x13, sp, x15\n    mov x9, #")
