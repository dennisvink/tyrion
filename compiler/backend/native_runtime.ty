    out = asm_line(out, "ldr x0, [x20]")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_identifier_kind")
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_variable_offset_next")
    out = asm_line(out, "ldr x9, [x20, #16]")
    out = asm_line(out, "cmp x9, x22")
    out = asm_line(out, "b.ne L_native_runtime_direct_variable_offset_next")
    out = asm_line(out, "ldr x0, [x20, #8]")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "mov x2, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cbz w0, L_native_runtime_direct_variable_offset_found")
    out = asm_label(out, "L_native_runtime_direct_variable_offset_next")
    out = asm_line(out, "add x23, x23, #1")
    out = asm_line(out, "b L_native_runtime_direct_variable_offset_loop")
    out = asm_label(out, "L_native_runtime_direct_variable_offset_found")
    out = asm_line(out, "ldr x1, [x19, #40]")
    out = asm_line(out, "add x1, x1, x23")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_variable_offset_return")
    out = asm_label(out, "L_native_runtime_direct_variable_offset_fail")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_variable_offset_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # x0=handle, x1=kind-113 block record, x2=text builder, x3=data builder,
    # x4=enclosing while statement index or -1, x5=function record or -1.
    out = asm_label(out, "L_native_runtime_direct_emit_block")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "str x4, [sp, #48]")
    out = asm_line(out, "str x5, [sp, #56]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_block_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #113")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_block_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x9, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "ldr x4, [sp, #48]")
    out = asm_line(out, "ldr x5, [sp, #56]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_statements")
    out = asm_line(out, "b L_native_runtime_direct_emit_block_return")
    out = asm_label(out, "L_native_runtime_direct_emit_block_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_label(out, "L_native_runtime_direct_emit_block_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_branch_runtime(out, target)
    return out

def emit_native_runtime_direct_try_statement(out, target):
    # Kind-117 layout: body, except body, finally body, kind-118 clause.
    # Emission state is compiler-local; generated applications carry only the
    # canonical owned exception slot and deterministic labels.
    out = asm_label(out, "L_native_runtime_direct_emit_statement_try")
    # Nested builder/token helpers are not allowed to own the statement ID.
    # Keep the label suffix in this emitter frame and reload it at every use.
    out = asm_line(out, "str x20, [sp, #128]")
    out = asm_line(out, "str x24, [sp, #112]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #80]")
    out = asm_line(out, "str x20, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try_mode")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #88]")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #136]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally_loop")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "str x10, [sp, #144]")
    out = asm_line(out, "ldr x10, [x23, #40]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try_control_ready")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally")
    out = asm_line(out, "str x20, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally_loop")
    out = asm_line(out, "str x24, [x9]")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_init_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_init_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_label(out, "L_native_runtime_direct_emit_statement_try_control_ready")
    out = asm_line(out, "ldr x0, [sp, #120]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_body")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "ldr x4, [sp, #112]")
    out = asm_line(out, "ldr x5, [sp, #64]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_block")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_try_restore_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_branch_finally")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_label_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")

    # Handler entry. An absent except body leaves the exception pending and
    # proceeds through finally. The parser currently materializes one clause;
    # the record representation can be chained later without changing the ABI.
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_handler_label")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "ldr x24, [x23, #48]")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try_finally")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statement_try_unsupported_restore")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x24, x9, x24, lsl #6")
    out = asm_line(out, "ldr x9, [x24]")
    out = asm_line(out, "cmp x9, #118")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_try_unsupported_restore")
    out = asm_line(out, "ldr x25, [x24, #24]")
    out = asm_line(out, "cmp x25, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try_match_any")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_emit_statement_try_unsupported_restore")
    out = asm_line(out, "mov x26, x0")
    out = asm_line(out, "mov x0, x22")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_name_data_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x22")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_name_data_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "ldr x1, [x26, #8]")
    out = asm_line(out, "ldr x2, [x26, #16]")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x22")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_name_data_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_match_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "ldr x1, [x26, #16]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_match_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_match_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_match_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_match_e")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_label(out, "L_native_runtime_direct_emit_statement_try_match_any")
    out = asm_line(out, "ldr x25, [x24, #32]")
    out = asm_line(out, "cmp x25, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try_clear")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl L_native_runtime_direct_variable_offset")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_unsupported_restore")
    out = asm_line(out, "mov x25, x1")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_bind_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_bind_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_label(out, "L_native_runtime_direct_emit_statement_try_clear")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_clear")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try_mode")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "ldr x0, [sp, #120]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_except")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "ldr x4, [sp, #112]")
    out = asm_line(out, "ldr x5, [sp, #64]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_block")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_try_restore_return")

    out = asm_label(out, "L_native_runtime_direct_emit_statement_try_finally")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_finally_label")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "ldr x1, [sp, #128]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try_mode")
    out = asm_line(out, "mov x10, #2")
    out = asm_line(out, "str x10, [x9]")
    # A control exit from inside this finally must target the containing
    # finally, not re-enter this one. Restore the outer control context before
    # lowering the finally body; exception routing keeps its separate try mode.
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally")
    out = asm_line(out, "ldr x10, [sp, #136]")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally_loop")
    out = asm_line(out, "ldr x10, [sp, #144]")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "cmp x1, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try_restore_propagate")
    out = asm_line(out, "ldr x0, [sp, #120]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_try_fail_restore")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_finally")
