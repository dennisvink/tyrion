    out = asm_line(out, "bl L_native_runtime_direct_extension_prepare")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_tcp_call_unsupported")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_plan_ready")
    out = asm_line(out, "mov x23, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_eval")
    out = asm_line(out, "cmp x23, x26")
