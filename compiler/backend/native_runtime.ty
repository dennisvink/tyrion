    asm_line(out, "str x0, [x19]")
    asm_line(out, "add x9, x0, #32")
    asm_line(out, "str x9, [x19, #8]")
    asm_line(out, "str xzr, [x19, #16]")
    asm_line(out, "str x20, [x19, #24]")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_native_lex_buffer_init_return")
    asm_label(out, "L_native_lex_buffer_init_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_native_lex_buffer_init_return")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #48")
    asm_line(out, "ret")

    asm_label(out, "L_native_lex_buffer_reserve")
    asm_line(out, "stp x29, x30, [sp, #-64]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, x1")
    asm_line(out, "ldr x21, [x19, #16]")
    asm_line(out, "adds x22, x21, x20")
    asm_line(out, "b.cs L_native_lex_buffer_reserve_fail")
    asm_line(out, "ldr x9, [x19, #24]")
    asm_line(out, "cmp x22, x9")
    asm_line(out, "b.ls L_native_lex_buffer_reserve_ok")
    asm_label(out, "L_native_lex_buffer_reserve_grow")
    asm_line(out, "mov x10, #1")
    asm_line(out, "lsl x10, x10, #25")
    asm_line(out, "cmp x9, x10")
    asm_line(out, "b.hs L_native_lex_buffer_reserve_fail")
    asm_line(out, "lsl x9, x9, #1")
    asm_line(out, "cmp x9, x22")
    asm_line(out, "b.lo L_native_lex_buffer_reserve_grow")
    asm_line(out, "ldr x0, [x19]")
    asm_line(out, "mov x10, #40")
    asm_line(out, "mul x1, x9, x10")
    asm_line(out, "adds x1, x1, #32")
    asm_line(out, "b.cs L_native_lex_buffer_reserve_fail")
    asm_line(out, "str x9, [sp, #48]")
    asm_line(out, "bl " + asm_call_name(target, "realloc"))
    asm_line(out, "cbz x0, L_native_lex_buffer_reserve_fail")
    asm_line(out, "ldr x9, [sp, #48]")
    asm_line(out, "str x21, [x0, #8]")
    asm_line(out, "str x9, [x0, #16]")
    asm_line(out, "str x0, [x19]")
    asm_line(out, "add x10, x0, #32")
    asm_line(out, "str x10, [x19, #8]")
    asm_line(out, "str x9, [x19, #24]")
    asm_label(out, "L_native_lex_buffer_reserve_ok")
    asm_line(out, "mov w0, #1")
    asm_line(out, "b L_native_lex_buffer_reserve_return")
    asm_label(out, "L_native_lex_buffer_reserve_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, "L_native_lex_buffer_reserve_return")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #64")
    asm_line(out, "ret")

    return out

