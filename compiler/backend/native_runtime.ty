    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x0, #64]")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #59")
    out = asm_line(out, "bic x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")
    out = asm_label(out, "L_native_ast_field_write_lambda_child")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_ast_field_get_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x0, #64]")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #57")
    out = asm_line(out, "bic x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")
    out = asm_label(out, "L_native_ast_field_sequence_root_1")
    out = asm_line(out, "mov x24, #1")
    out = asm_label(out, "L_native_ast_field_write_root_sequence")
    out = asm_line(out, "ldr x25, [x19, #56]")
    out = asm_line(out, "mov x9, x24")
    out = asm_line(out, "mov x24, x25")
    out = asm_line(out, "mov x25, x9")
    out = asm_line(out, "b L_native_ast_field_write_sequence")
    out = asm_label(out, "L_native_ast_field_write_empty_sequence")
    out = asm_line(out, "ldr x24, [x19, #56]")
    out = asm_line(out, "mov x25, #11")
    out = asm_label(out, "L_native_ast_field_write_sequence")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "mov x2, x25")
    out = asm_line(out, "bl L_native_ast_handle_sequence_view")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")
    out = asm_label(out, "L_native_ast_field_write_token")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl L_native_ast_token_record")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x0, #8]")
    out = asm_line(out, "ldr x10, [x0, #16]")
    out = asm_line(out, "mov x0, x9")
    out = asm_line(out, "mov x1, x10")
    out = asm_line(out, "mov x2, x23")
    out = asm_line(out, "bl L_native_ast_write_borrowed_string")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")

    # x0=handle, x24=token index -> x0=typed token record.
    out = asm_label(out, "L_native_ast_token_record")
    out = asm_line(out, "ldr x0, [x0, #16]")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "b L_native_token_record_at")

    literal_names = ["unary", "binary", "attr", "index", "slice", "kwarg", "list", "tuple", "set", "dict_entry", "dict", "lambda", "comprehension", "unpack_target", "unpack", "assign", "return", "expr", "if", "while", "break", "continue", "function", "for", "raise", "param", "branch", "with", "try", "except", "yield", "class", "call", "method_call", "string", "int", "float", "bool", "none", "var"]
    literal_idx = 0
    while literal_idx < len(literal_names):
        literal = literal_names[literal_idx]
        out = asm_label(out, "L_native_ast_field_literal_" + literal)
        out = asm_addr(out, target, "x0", "L_native_ast_field_literal_text_" + str(literal_idx))
        out = asm_line(out, "mov x1, #" + str(len(literal)))
        out = asm_line(out, "mov x2, x23")
        out = asm_line(out, "bl L_native_ast_write_borrowed_string")
        out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
        out = asm_line(out, "b L_native_ast_field_get_ok")
        literal_idx = literal_idx + 1

    out = asm_label(out, "L_native_ast_field_get_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_ast_field_get_return")
    out = asm_label(out, "L_native_ast_field_get_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_ast_field_get_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #128")
    out = asm_line(out, "ret")

    idx = 0
    while idx < len(keys):
        out = asm_cstr(out, "L_native_ast_field_key_" + str(idx), keys[idx])
        idx = idx + 1
    leaf_idx = 0
    while leaf_idx < len(leaf_kinds):
        out = asm_cstr(out, "L_native_ast_leaf_kind_" + str(leaf_idx), leaf_kinds[leaf_idx])
        leaf_idx = leaf_idx + 1
    out = asm_cstr(out, "L_native_ast_field_comprehension_list_text", "list")
    out = asm_cstr(out, "L_native_ast_field_comprehension_dict_text", "dict")
    out = asm_cstr(out, "L_native_ast_field_augmented_plus_text", "+")
    literal_idx = 0
    while literal_idx < len(literal_names):
        out = asm_cstr(out, "L_native_ast_field_literal_text_" + str(literal_idx), literal_names[literal_idx])
        literal_idx = literal_idx + 1
    out = asm_line(out, ".p2align 2")
    return out

def emit_native_text_builder_runtime(out, target):
    value_tag_x20 = generated_value_tag_mem("x20")
    value_owner_x20 = generated_value_owner_mem("x20")

    # Builder layout: data pointer, byte length, byte capacity. It grows on the
    # heap and is consumed into a canonical generated string slot on success.
    out = asm_label(out, "L_native_text_builder_init")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "str x19, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "cbz x19, L_native_text_builder_init_fail")
    out = asm_line(out, "mov x0, #256")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_text_builder_init_fail")
    out = asm_line(out, "str x0, [x19]")
    out = asm_line(out, "str xzr, [x19, #8]")
    out = asm_line(out, "mov x9, #256")
    out = asm_line(out, "str x9, [x19, #16]")
    out = asm_line(out, "strb wzr, [x0]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_text_builder_init_return")
    out = asm_label(out, "L_native_text_builder_init_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_text_builder_init_return")
    out = asm_line(out, "ldr x19, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")

    # x0=builder, x1=span, x2=len -> w0=success.
    out = asm_label(out, "L_native_text_builder_append_span")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "cbz x19, L_native_text_builder_append_span_fail")
    out = asm_line(out, "cbz x20, L_native_text_builder_append_span_empty_check")
    out = asm_line(out, "b L_native_text_builder_append_span_size")
    out = asm_label(out, "L_native_text_builder_append_span_empty_check")
    out = asm_line(out, "cbnz x21, L_native_text_builder_append_span_fail")
    out = asm_label(out, "L_native_text_builder_append_span_size")
    out = asm_line(out, "ldr x22, [x19, #8]")
    out = asm_line(out, "adds x23, x22, x21")
    out = asm_line(out, "b.cs L_native_text_builder_append_span_fail")
    out = asm_line(out, "adds x24, x23, #1")
    out = asm_line(out, "b.cs L_native_text_builder_append_span_fail")
    out = asm_line(out, "ldr x9, [x19, #16]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.ls L_native_text_builder_append_span_copy")
    out = asm_label(out, "L_native_text_builder_append_span_grow")
    out = asm_line(out, "cmp x9, #256")
    out = asm_line(out, "b.hs L_native_text_builder_append_span_double")
    out = asm_line(out, "mov x9, #256")
    out = asm_label(out, "L_native_text_builder_append_span_double")
    out = asm_line(out, "adds x9, x9, x9")
    out = asm_line(out, "b.cs L_native_text_builder_append_span_fail")
    out = asm_line(out, "cmp x9, x24")
    out = asm_line(out, "b.lo L_native_text_builder_append_span_grow")
    out = asm_line(out, "str x9, [sp, #64]")
    out = asm_line(out, "ldr x0, [x19]")
    out = asm_line(out, "mov x1, x9")
    out = asm_line(out, "bl " + asm_call_name(target, "realloc"))
    out = asm_line(out, "cbz x0, L_native_text_builder_append_span_fail")
    out = asm_line(out, "ldr x9, [sp, #64]")
    out = asm_line(out, "str x0, [x19]")
    out = asm_line(out, "str x9, [x19, #16]")
    out = asm_label(out, "L_native_text_builder_append_span_copy")
    out = asm_line(out, "ldr x0, [x19]")
    out = asm_line(out, "add x0, x0, x22")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "ldr x9, [x19]")
    out = asm_line(out, "strb wzr, [x9, x23]")
    out = asm_line(out, "str x23, [x19, #8]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_text_builder_append_span_return")
    out = asm_label(out, "L_native_text_builder_append_span_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_text_builder_append_span_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # x0=builder, x1=NUL-terminated static string -> w0=success.
    out = asm_label(out, "L_native_text_builder_append_cstr")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x20, L_native_text_builder_append_cstr_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "b L_native_text_builder_append_cstr_return")
    out = asm_label(out, "L_native_text_builder_append_cstr_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_text_builder_append_cstr_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # x0=builder, x1=unsigned integer -> w0=success.
    out = asm_label(out, "L_native_text_builder_append_u64")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "add x21, sp, #80")
    out = asm_line(out, "mov x22, x21")
    out = asm_label(out, "L_native_text_builder_append_u64_digit")
    out = asm_line(out, "mov x9, #10")
    out = asm_line(out, "udiv x10, x20, x9")
    out = asm_line(out, "msub x11, x10, x9, x20")
    out = asm_line(out, "add w11, w11, #48")
    out = asm_line(out, "sub x22, x22, #1")
    out = asm_line(out, "strb w11, [x22]")
    out = asm_line(out, "mov x20, x10")
    out = asm_line(out, "cbnz x20, L_native_text_builder_append_u64_digit")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "sub x2, x21, x22")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # x0=builder, x1=result slot -> w0=success. Builder ownership transfers for
    # heap strings and remains caller-owned for short inline strings.
    out = asm_label(out, "L_native_text_builder_finish")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, L_native_text_builder_finish_fail")
    out = asm_line(out, "cbz x20, L_native_text_builder_finish_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "ldr x9, [x19, #8]")
    out = asm_line(out, "cmp x9, #127")
    out = asm_line(out, "b.hs L_native_text_builder_finish_heap")
    out = asm_line(out, "ldr x1, [x19]")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_string_copy")
    out = asm_line(out, "mov w9, #1")
    out = asm_line(out, "strb w9, " + value_tag_x20)
    out = asm_line(out, "b L_native_text_builder_finish_ok")
    out = asm_label(out, "L_native_text_builder_finish_heap")
    out = asm_line(out, "ldr x10, [x19]")
    out = asm_line(out, "str x10, [x20]")
    out = asm_line(out, "str x9, [x20, #8]")
    out = asm_line(out, "mov w10, #" + str(generated_value_tag_string_heap()))
    out = asm_line(out, "strb w10, " + value_tag_x20)
    out = asm_line(out, "mov w10, #1")
    out = asm_line(out, "strb w10, " + value_owner_x20)
    out = asm_line(out, "str xzr, [x19]")
    out = asm_label(out, "L_native_text_builder_finish_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_text_builder_finish_return")
    out = asm_label(out, "L_native_text_builder_finish_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_text_builder_finish_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # x0=builder. Safe for both transferred and retained buffers.
    out = asm_label(out, "L_native_text_builder_dispose")
    out = asm_line(out, "cbz x0, L_native_text_builder_dispose_return")
    out = asm_line(out, "ldr x0, [x0]")
    out = asm_line(out, "cbz x0, L_native_text_builder_dispose_return")
    out = asm_line(out, "b " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_text_builder_dispose_return")
    out = asm_line(out, "ret")

    # x0=builder, x1=raw numeric token span, x2=length. Tyrion permits
    # underscore separators; generated C integer/float literals do not, so
    # append every non-separator byte while preserving the exact numeric text.
    out = asm_label(out, "L_native_text_builder_append_numeric_token")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, #0")
    out = asm_label(out, "L_native_text_builder_append_numeric_token_loop")
    out = asm_line(out, "cmp x22, x21")
    out = asm_line(out, "b.hs L_native_text_builder_append_numeric_token_ok")
    out = asm_line(out, "ldrb w9, [x20, x22]")
    out = asm_line(out, "cmp w9, #95")
    out = asm_line(out, "b.eq L_native_text_builder_append_numeric_token_next")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "add x1, x20, x22")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "cbz w0, L_native_text_builder_append_numeric_token_fail")
    out = asm_label(out, "L_native_text_builder_append_numeric_token_next")
    out = asm_line(out, "add x22, x22, #1")
    out = asm_line(out, "b L_native_text_builder_append_numeric_token_loop")
    out = asm_label(out, "L_native_text_builder_append_numeric_token_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_text_builder_append_numeric_token_return")
    out = asm_label(out, "L_native_text_builder_append_numeric_token_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_text_builder_append_numeric_token_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    return out

def emit_native_runtime_direct_diagnostic_path_runtime(out, target):
    # The generated renderer owns one bounded diagnostic path builder. Callers
    # save a length mark before descending, append the AST edge they own, and
    # restore the mark before visiting a sibling. A terminal failure leaves the
    # complete root-to-leaf path available to the shared reporter.
    out = asm_label(out, "L_native_runtime_direct_diag_path_reset")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_path_builder")
    out = asm_addr(out, target, "x10", "L_native_runtime_direct_diag_path_storage")
    out = asm_line(out, "stp x10, xzr, [x9]")
    out = asm_line(out, "mov x11, #512")
    out = asm_line(out, "str x11, [x9, #16]")
    out = asm_line(out, "mov x0, x9")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_diag_path_root")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")

    out = asm_label(out, "L_native_runtime_direct_diag_path_mark")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "ldr x0, [x9, #8]")
    out = asm_line(out, "ret")

    # x0=previous path length.
    out = asm_label(out, "L_native_runtime_direct_diag_path_restore")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "ldr x10, [x9, #16]")
    out = asm_line(out, "cmp x0, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_diag_path_restore_fail")
    out = asm_line(out, "str x0, [x9, #8]")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "strb wzr, [x10, x0]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_native_runtime_direct_diag_path_restore_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")

    # x0=NUL-terminated edge text.
    out = asm_label(out, "L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "mov x1, x0")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "b L_native_text_builder_append_cstr")

    # x0=edge span pointer, x1=edge byte length.
    out = asm_label(out, "L_native_runtime_direct_diag_path_append_span")
    out = asm_line(out, "mov x2, x1")
    out = asm_line(out, "mov x1, x0")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "b L_native_text_builder_append_span")

    # x0=source-order index.
    out = asm_label(out, "L_native_runtime_direct_diag_path_append_index")
    out = asm_line(out, "mov x1, x0")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "b L_native_text_builder_append_u64")

    out = asm_label(out, "L_native_runtime_direct_diag_path_current")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_path_builder")
    out = asm_line(out, "ldr x0, [x9]")
    out = asm_line(out, "ret")
    return out


def emit_native_runtime_direct_assignment_target_token_test(out, target, token_label, target_kind_name):
    out = asm_addr(out, target, "x1", token_label)
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_assignment_target_" + target_kind_name)
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_emit_statement_assignment_target_expression")
    out = asm_line(out, "ldr x0, [x0]")
    return out


def emit_native_runtime_direct_program_runtime(out, target):
    # Compact descendant-owned direct renderer. Public ABI: x0=canonical AST
    # handle, x1=result slot. Unsupported shape is success+none; allocation or
    # rendering failure is x0=0. Internal renderers return 1 for rendered, 2
    # for unsupported, and 0 for failure.
    out = emit_native_runtime_direct_diagnostic_path_runtime(out, target)
    out = asm_label(out, "L_native_runtime_direct_program")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "sub sp, sp, #64")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_code")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_detail_ptr")
    out = asm_line(out, "stp xzr, xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_numeric_detail")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_nested_arg_index")
    out = asm_line(out, "mov x10, #-1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_has_arg")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_parent_kind")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_parent_stmt")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_edge_kind")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_reset")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_fail")
    out = asm_line(out, "cbz x19, L_native_runtime_direct_program_fail")
    out = asm_line(out, "cbz x20, L_native_runtime_direct_program_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "stp xzr, xzr, [sp]")
    out = asm_line(out, "str xzr, [sp, #16]")
    out = asm_line(out, "stp xzr, xzr, [sp, #32]")
    out = asm_line(out, "str xzr, [sp, #48]")
    out = asm_line(out, "ldrb w9, [x19]")
    out = asm_line(out, "cmp w9, #170")
    out = asm_line(out, "b.ne L_native_runtime_direct_program_unsupported")
    out = asm_line(out, "ldr x21, [x19, #32]")
    out = asm_line(out, "ldr x22, [x19, #40]")
    out = asm_line(out, "ldr x9, [x19, #56]")
    out = asm_line(out, "cmp x9, x22")
    out = asm_line(out, "b.hs L_native_runtime_direct_program_unsupported")
    out = asm_line(out, "add x23, x21, x9, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #111")
    out = asm_line(out, "b.ne L_native_runtime_direct_program_unsupported")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_init")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_fail")
    out = asm_line(out, "add x0, sp, #32")
    out = asm_line(out, "bl L_native_text_builder_init")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_text_prefix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "ldr x9, [x19, #16]")
    out = asm_line(out, "ldr x9, [x9, #8]")
    out = asm_line(out, "add x1, x22, x9")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "add x1, x1, #256")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_text_prefix_end")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, sp")
    out = asm_line(out, "add x3, sp, #32")
    out = asm_line(out, "mov x4, #-1")
    out = asm_line(out, "mov x5, #-1")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_function")
    out = asm_line(out, "mov x10, #-1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try_mode")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_finally_loop")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_statements")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "cmp w0, #2")
    out = asm_line(out, "b.eq L_native_runtime_direct_program_dispose_unsupported")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_main_suffix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    # Statement rendering traverses a large recursive emitter graph. Reload
    # the canonical program root from the handle instead of relying on a
    # cached record pointer surviving that graph.
    out = asm_line(out, "ldr x9, [x19, #56]")
    out = asm_line(out, "ldr x10, [x19, #40]")
    out = asm_line(out, "cmp x9, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "ldr x23, [x19, #32]")
    out = asm_line(out, "add x23, x23, x9, lsl #6")
    out = asm_line(out, "ldr x10, [x23]")
    out = asm_line(out, "cmp x10, #111")
    out = asm_line(out, "b.ne L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, sp")
    out = asm_line(out, "add x3, sp, #32")
    out = asm_line(out, "bl L_native_runtime_direct_emit_functions")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.eq L_native_runtime_direct_program_functions_ok")
    out = asm_line(out, "cmp w0, #2")
    out = asm_line(out, "b.eq L_native_runtime_direct_program_dispose_unsupported")
    out = asm_line(out, "b L_native_runtime_direct_program_dispose_both_fail")
    out = asm_label(out, "L_native_runtime_direct_program_functions_ok")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_lifecycle_suffix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_string_suffix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    # Resolve the optional section plan against the application plus its core
    # runtime closure. Core value lifecycle/formatting currently requires the
    # collection component; file, TCP, and terminal remain independently
    # selected by their emitted symbol references.
    out = emit_native_runtime_direct_optional_suffix(out, target, "collection", "L_native_runtime_direct_collection_suffix", ["L_native_runtime_direct_need_list", "L_native_runtime_direct_need_dict", "L_native_runtime_direct_need_range"])
    out = emit_native_runtime_direct_optional_suffix(out, target, "file", "L_native_runtime_direct_file_suffix", ["L_native_runtime_direct_need_file"])
    out = emit_native_runtime_direct_optional_suffix(out, target, "tcp_connect", "L_native_runtime_direct_tcp_connect_suffix", ["L_native_runtime_direct_need_tcp"])
    out = emit_native_runtime_direct_optional_suffix(out, target, "tcp_io", "L_native_runtime_direct_tcp_io_suffix", ["L_native_runtime_direct_need_tcp"])
    out = emit_native_runtime_direct_optional_suffix(out, target, "terminal", "L_native_runtime_direct_terminal_suffix", ["L_native_runtime_direct_need_terminal", "L_native_runtime_direct_need_ansi"])
    out = emit_native_runtime_direct_optional_suffix(out, target, "process", "L_native_runtime_direct_process_suffix", ["L_native_runtime_direct_need_process"])
    out = emit_native_runtime_direct_optional_extension_suffix(out, target)
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_text_suffix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "ldr x1, [sp, #32]")
    out = asm_line(out, "ldr x2, [sp, #40]")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_finish")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "add x0, sp, #32")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_program_return")
    out = asm_label(out, "L_native_runtime_direct_program_dispose_unsupported")
    out = asm_line(out, "add x0, sp, #32")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_line(out, "b L_native_runtime_direct_program_unsupported")
    out = asm_label(out, "L_native_runtime_direct_program_dispose_both_fail")
    out = asm_line(out, "add x0, sp, #32")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_label(out, "L_native_runtime_direct_program_dispose_fail")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_line(out, "b L_native_runtime_direct_program_fail")
    out = asm_label(out, "L_native_runtime_direct_program_unsupported")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_program_return")
    out = asm_label(out, "L_native_runtime_direct_program_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_program_return")
    out = asm_line(out, "add sp, sp, #64")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # Report structured failures captured by the renderer that owns the
    # support decision. This deliberately consumes token spans from the live
    # AST handle; it never reparses source or invokes compiler helper bodies.
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "sub sp, sp, #32")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_code")
    out = asm_line(out, "ldr x19, [x9]")
    out = asm_line(out, "cbz x19, L_native_runtime_direct_report_diagnostic_none")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_init")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_report_diagnostic_none")
    out = asm_line(out, "cmp x19, #1")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_unknown_call")
    out = asm_line(out, "cmp x19, #2")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_method")
    out = asm_line(out, "cmp x19, #3")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_primitive_arity")
    out = asm_line(out, "cmp x19, #4")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_keyword")
    out = asm_line(out, "cmp x19, #5")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_assignment_target")
    out = asm_line(out, "cmp x19, #6")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_multiple_starred")
    out = asm_line(out, "cmp x19, #7")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_break_context")
    out = asm_line(out, "cmp x19, #8")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_continue_context")
    out = asm_line(out, "cmp x19, #9")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_return_context")
    out = asm_line(out, "cmp x19, #10")
    out = asm_line(out, "b.eq L_native_runtime_direct_report_diagnostic_yield_context")
    out = asm_line(out, "cmp x19, #11")
    out = asm_line(out, "b.ne L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_lambda_capture_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_yield_context")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_yield_context_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_return_context")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_return_context_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_continue_context")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_continue_context_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_break_context")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_break_context_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_multiple_starred")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_multiple_starred_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_assignment_target")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_assignment_target_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_keyword")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_keyword_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_primitive_arity")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_primitive_arity_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_method")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_method_prefix")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_unknown_call")
    out = asm_addr(out, target, "x20", "L_native_runtime_direct_diag_call_prefix")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_prefix")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_current")
    out = asm_line(out, "mov x1, x0")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_diag_detail")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_line(out, "cmp x19, #6")
    out = asm_line(out, "b.ne L_native_runtime_direct_report_diagnostic_detail_span")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_numeric_detail")
    out = asm_line(out, "ldr x1, [x9]")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "b L_native_runtime_direct_report_diagnostic_detail_done")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_detail_span")
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_detail_ptr")
    out = asm_line(out, "ldp x1, x2, [x9]")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_detail_done")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "ldr x1, [sp]")
    out = asm_line(out, "ldr x2, [sp, #8]")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, #2")
    out = asm_addr(out, target, "x1", "L_runtime_newline")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_dispose")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_text_builder_dispose")
    out = asm_label(out, "L_native_runtime_direct_report_diagnostic_none")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "ldr x0, [x9]")
    out = asm_line(out, "add sp, sp, #32")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_statement_runtime(out, target)
    return out

def emit_native_runtime_direct_optional_suffix(out, target, component, suffix_label, needle_labels):
    append_label = "L_native_runtime_direct_append_" + component
    done_label = append_label + "_done"
    for needle_label in needle_labels:
        out = asm_line(out, "ldr x0, [sp]")
        out = asm_line(out, "cbz x0, L_native_runtime_direct_program_dispose_both_fail")
        out = asm_addr(out, target, "x1", needle_label)
        out = asm_line(out, "bl " + asm_call_name(target, "strstr"))
        out = asm_line(out, "cbnz x0, " + append_label)
    out = asm_line(out, "b " + done_label)
    out = asm_label(out, append_label)
    out = asm_line(out, "mov x0, sp")
    out = asm_addr(out, target, "x1", suffix_label)
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_label(out, done_label)
    return out

def emit_native_runtime_direct_extension_plan_runtime(out, target):
    # x0=AST handle, x1=host-load call AST. The one-extension descendant
    # slice derives and validates its static manifest before any application
    # assembly or linker input is committed.
    out = asm_label(out, "L_native_runtime_direct_extension_prepare")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "sub sp, sp, #768")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov w26, #0")
    out = asm_line(out, "add x0, sp, #128")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #256")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_addr(out, target, "x9", "L_cli_extension_mode")
    out = asm_line(out, "ldr x9, [x9]")
    out = asm_line(out, "cbnz x9, L_native_runtime_direct_extension_prepare_mode_ok")
    out = asm_addr(out, target, "x10", "L_cli_dynamic_extension_mode")
    out = asm_line(out, "ldr x10, [x10]")
    out = asm_line(out, "cbz x10, L_native_runtime_direct_extension_prepare_disabled")
    # Static-off with dynamic allowed is an intentional runtime-only plan.
    out = asm_line(out, "mov w26, #1")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_disabled")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_disabled")
    out = asm_line(out, "bl " + asm_call_name(target, "puts"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_mode_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x21, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x21]")
    out = asm_line(out, "cmp x9, #6")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x22, [x21, #32]")
    out = asm_line(out, "cmp x22, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x10, [x19, #40]")
    out = asm_line(out, "cmp x22, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x22, x9, x22, lsl #6")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x9, [x22, #32]")
    out = asm_line(out, "cmp x9, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x23, [x22, #24]")
    out = asm_line(out, "ldr x10, [x19, #40]")
    out = asm_line(out, "cmp x23, x10")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x23, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_nonliteral")
    out = asm_line(out, "ldr x1, [x23, #40]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "ldr x0, [x24]")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_string_kind")
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_extension_prepare_nonliteral")
    out = asm_line(out, "ldr x25, [x24, #16]")
    out = asm_line(out, "cmp x25, #3")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "cmp x25, #65")
    out = asm_line(out, "b.hi L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldr x24, [x24, #8]")
    out = asm_line(out, "ldrb w9, [x24]")
    out = asm_line(out, "cmp w9, #34")
    out = asm_line(out, "b.eq L_native_runtime_direct_extension_prepare_quote_ok")
    out = asm_line(out, "cmp w9, #39")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_quote_ok")
    out = asm_line(out, "sub x25, x25, #2")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "mov x9, #0")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_copy")
    out = asm_line(out, "cmp x9, x25")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_name_ready")
    out = asm_line(out, "ldrb w10, [x24, x9]")
    out = asm_line(out, "cmp w10, #48")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_name_alpha")
    out = asm_line(out, "cmp w10, #57")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_name_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_alpha")
    out = asm_line(out, "cmp w10, #65")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_name_lower")
    out = asm_line(out, "cmp w10, #90")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_name_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_lower")
    out = asm_line(out, "cmp w10, #97")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_name_underscore")
    out = asm_line(out, "cmp w10, #122")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_name_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_underscore")
    out = asm_line(out, "cmp w10, #95")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_store")
    out = asm_line(out, "strb w10, [sp, x9]")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_name_copy")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_name_ready")
    out = asm_line(out, "strb wzr, [sp, x25]")
    # Resolve an existing extension ID or reserve the next bounded table row.
    out = asm_addr(out, target, "x23", "L_native_runtime_direct_extension_count")
    out = asm_line(out, "ldr x22, [x23]")
    out = asm_line(out, "mov x21, #0")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_find")
    out = asm_line(out, "cmp x21, x22")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_new")
    out = asm_addr(out, target, "x23", "L_native_runtime_direct_extension_names")
    out = asm_line(out, "add x23, x23, x21, lsl #7")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "mov x1, sp")
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbz w0, L_native_runtime_direct_extension_prepare_existing")
    out = asm_line(out, "add x21, x21, #1")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_find")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_existing")
    out = asm_line(out, "add w26, w21, #1")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_new")
    out = asm_line(out, "cmp x22, #8")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_done")
    out = asm_addr(out, target, "x23", "L_native_runtime_direct_extension_names")
    out = asm_line(out, "add x23, x23, x22, lsl #7")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "mov x1, sp")
    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_root")
    out = asm_addr(out, target, "x9", "L_cli_extension_root_ptr")
    out = asm_line(out, "ldr x1, [x9]")
    out = asm_line(out, "cbnz x1, L_native_runtime_direct_extension_prepare_root_ready")
    out = asm_addr(out, target, "x1", "L_cli_default_extension_root")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_root_ready")
    out = asm_line(out, "str x1, [sp, #384]")
    out = asm_line(out, "mov x0, x1")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "cmp x0, #380")
    out = asm_line(out, "b.hi L_native_runtime_direct_extension_prepare_root_too_long")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_root")
    out = asm_line(out, "ldr x1, [sp, #384]")
    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_root")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_path_separator")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_root")
    out = asm_line(out, "mov x1, sp")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_manifest")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_root")
    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_manifest")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_manifest_suffix")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "add x0, sp, #128")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_manifest")
    out = asm_line(out, "bl L_generated_value_set_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "add x0, sp, #128")
    out = asm_line(out, "add x1, sp, #256")
    out = asm_line(out, "bl L_native_read_text_file")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "add x0, sp, #256")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "mov x0, x24")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_abi_line")
    out = asm_line(out, "bl " + asm_call_name(target, "strstr"))
    out = asm_line(out, "cbz x0, L_native_runtime_direct_extension_prepare_bad_abi")
    out = asm_line(out, "add x25, sp, #512")
    out = asm_line(out, "mov x0, x25")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_name_line_prefix")
    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    out = asm_line(out, "mov x0, x25")
    out = asm_line(out, "mov x1, sp")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "mov x0, x25")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_quote")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "mov x0, x24")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl " + asm_call_name(target, "strstr"))
    out = asm_line(out, "cbz x0, L_native_runtime_direct_extension_prepare_done")
    # Extract the manifest-owned call symbol instead of imposing a generated
    # naming convention. Symbols remain identifier-only in the v1 ABI.
    out = asm_line(out, "mov x0, x24")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_extension_call_line_prefix")
    out = asm_line(out, "bl " + asm_call_name(target, "strstr"))
    out = asm_line(out, "cbz x0, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "mov x23, x0")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_call_line_prefix")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "add x23, x23, x0")
    out = asm_addr(out, target, "x25", "L_native_runtime_direct_extension_symbols")
    out = asm_line(out, "add x25, x25, x22, lsl #8")
    out = asm_line(out, "mov x9, #0")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_copy")
    out = asm_line(out, "cmp x9, #255")
    out = asm_line(out, "b.hs L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "ldrb w10, [x23, x9]")
    out = asm_line(out, "cmp w10, #34")
    out = asm_line(out, "b.eq L_native_runtime_direct_extension_prepare_symbol_ready")
    out = asm_line(out, "cmp w10, #48")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_symbol_alpha")
    out = asm_line(out, "cmp w10, #57")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_symbol_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_alpha")
    out = asm_line(out, "cmp w10, #65")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_symbol_lower")
    out = asm_line(out, "cmp w10, #90")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_symbol_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_lower")
    out = asm_line(out, "cmp w10, #97")
    out = asm_line(out, "b.lt L_native_runtime_direct_extension_prepare_symbol_underscore")
    out = asm_line(out, "cmp w10, #122")
    out = asm_line(out, "b.ls L_native_runtime_direct_extension_prepare_symbol_store")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_underscore")
    out = asm_line(out, "cmp w10, #95")
    out = asm_line(out, "b.ne L_native_runtime_direct_extension_prepare_done")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_store")
    out = asm_line(out, "strb w10, [x25, x9]")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "b L_native_runtime_direct_extension_prepare_symbol_copy")
    out = asm_label(out, "L_native_runtime_direct_extension_prepare_symbol_ready")
    out = asm_line(out, "cbz x9, L_native_runtime_direct_extension_prepare_done")
    out = asm_line(out, "strb wzr, [x25, x9]")
    # Parse a bounded manifest source list into the flat linker-source table.
    out = asm_line(out, "mov x0, x24")
