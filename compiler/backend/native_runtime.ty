    out = asm_label(out, "L_native_ast_field_out_kind")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #16")
    out = asm_line(out, "b.ne L_native_ast_field_get_fail")
    out = asm_line(out, "mov x24, #1")
    out = asm_label(out, "L_native_ast_field_comprehension_resolve")
    out = asm_line(out, "ldr x9, [x22]")
    out = asm_line(out, "cmp x9, #16")
    out = asm_line(out, "b.ne L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x25, [x22, #48]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x25, x9")
    out = asm_line(out, "b.hs L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x26, [x19, #32]")
    out = asm_line(out, "add x26, x26, x25, lsl #6")
