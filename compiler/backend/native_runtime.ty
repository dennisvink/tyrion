    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #1")
    out = asm_addr(out, target, "x2", "L_native_runtime_direct_return_branch")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "mov x4, #-1")
    out = asm_line(out, "bl L_native_runtime_direct_append_control_branch")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")

    out = asm_label(out, "L_native_runtime_direct_append_control_dispatch_loop_labels")
    out = asm_line(out, "cmp x21, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_control_dispatch_done_label")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_break_label")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #2")
    out = asm_addr(out, target, "x2", "L_native_runtime_direct_break_a")
    out = asm_line(out, "mov x3, x21")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "bl L_native_runtime_direct_append_control_branch")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")

    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_continue_label")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #3")
    out = asm_addr(out, target, "x2", "L_native_runtime_direct_continue_a")
    out = asm_line(out, "mov x3, x21")
    out = asm_line(out, "mov x4, x21")
    out = asm_line(out, "bl L_native_runtime_direct_append_control_branch")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")

    out = asm_label(out, "L_native_runtime_direct_append_control_dispatch_done_label")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_control_done_label")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_append_control_dispatch_return")
    out = asm_label(out, "L_native_runtime_direct_append_control_dispatch_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_append_control_dispatch_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")
    return out


def emit_native_runtime_direct_branch_runtime(out, target):
    # Append a deterministic if label. x0=builder, x1=label prefix,
    # x2=parent statement index, x3=branch ordinal or -1, x4=suffix.
    out = asm_label(out, "L_native_runtime_direct_append_if_label")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "str x23, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x2")
    out = asm_line(out, "mov x21, x3")
    out = asm_line(out, "mov x22, x4")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_if_label_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_if_label_fail")
    out = asm_line(out, "cmp x21, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_if_label_suffix")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_label_separator")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_if_label_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_if_label_fail")
    out = asm_label(out, "L_native_runtime_direct_append_if_label_suffix")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_if_label_fail")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_append_if_label_return")
    out = asm_label(out, "L_native_runtime_direct_append_if_label_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_append_if_label_return")
    out = asm_line(out, "ldr x23, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # Render a reverse kind-115 branch chain in source order. x0=handle,
    # x1=reverse link, x2=text builder, x3=data builder, x4=loop context,
    # x5=parent if statement index, x6=total branch count, x7=function record.
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches")
    out = asm_line(out, "stp x29, x30, [sp, #-144]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x23, x4")
    out = asm_line(out, "mov x24, x5")
    out = asm_line(out, "mov x25, x6")
    out = asm_line(out, "str x7, [sp, #80]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #88]")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_if_branches_ok")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_if_branches_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x26, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x26]")
    out = asm_line(out, "cmp x9, #115")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_if_branches_unsupported")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x26, #40]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "mov x4, x23")
    out = asm_line(out, "mov x5, x24")
    out = asm_line(out, "mov x6, x25")
    out = asm_line(out, "ldr x7, [sp, #80]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_if_branches")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_if_branches_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_branch_label")
    out = asm_line(out, "mov x2, x24")
    out = asm_line(out, "ldr x3, [x26, #48]")
    out = asm_addr(out, target, "x4", "L_native_runtime_direct_colon_nl")
    out = asm_line(out, "bl L_native_runtime_direct_append_if_label")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x9, [x26, #24]")
    out = asm_line(out, "cmp x9, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_if_branches_body")
    out = asm_line(out, "ldr x0, [sp, #88]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_elif")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x0, [x26, #48]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_index")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_condition")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "mov x0, x19")
    # Path-builder calls use caller-saved registers. Reload the condition AST
    # index from the preserved branch record before expression lowering.
    out = asm_line(out, "ldr x1, [x26, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_if_branches_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_branch_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x1, [x26, #24]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_branch_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x9, [x26, #48]")
    out = asm_line(out, "add x3, x9, #1")
    out = asm_line(out, "cmp x3, x25")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_if_branches_false_end")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_branch_label")
    out = asm_line(out, "mov x2, x24")
    out = asm_addr(out, target, "x4", "L_native_runtime_direct_label_nl")
    out = asm_line(out, "bl L_native_runtime_direct_append_if_label")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "b L_native_runtime_direct_emit_if_branches_body")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_false_end")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_label")
    out = asm_line(out, "mov x2, x24")
    out = asm_line(out, "mov x3, #-1")
    out = asm_addr(out, target, "x4", "L_native_runtime_direct_label_nl")
    out = asm_line(out, "bl L_native_runtime_direct_append_if_label")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_body")
    out = asm_line(out, "ldr x0, [sp, #88]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x9, [x26, #24]")
    out = asm_line(out, "cmp x9, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_if_branches_else_path")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_elif")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "ldr x0, [x26, #48]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_index")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "b L_native_runtime_direct_emit_if_branches_body_path_ready")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_else_path")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_else")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_body_path_ready")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x26, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "mov x4, x23")
    out = asm_line(out, "ldr x5, [sp, #80]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_block")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_if_branches_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_if_end_branch")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_label_nl")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_if_branches_fail")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_if_branches_return")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_if_branches_return")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_if_branches_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #144")
    out = asm_line(out, "ret")

    out = emit_native_runtime_direct_function_runtime(out, target)
    return out

def emit_native_runtime_direct_function_runtime(out, target):
    # Emit every top-level kind-107 definition in source order. The reverse
    # statement list is materialized into an exact-sized index vector.
    out = asm_label(out, "L_native_runtime_direct_emit_functions")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "str x1, [sp, #64]")
    out = asm_line(out, "mov x23, #0")
    out = asm_line(out, "mov x24, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_functions_count")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_functions_allocate")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_functions_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_functions_unsupported")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "ldr x20, [x9, #32]")
