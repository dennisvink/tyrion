    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    out = emit_native_runtime_direct_control_branch_runtime(out, target)
    out = emit_native_runtime_direct_control_dispatch_runtime(out, target)
