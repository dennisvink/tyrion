    out = asm_line(out, "b.eq L_native_ast_field_comprehension_project_expr")
    out = asm_line(out, "cmp x24, #3")
    out = asm_line(out, "b.eq L_native_ast_field_comprehension_project_key")
    out = asm_line(out, "cmp x24, #4")
    out = asm_line(out, "b.eq L_native_ast_field_comprehension_project_value")
    out = asm_line(out, "cmp x24, #5")
    out = asm_line(out, "b.eq L_native_ast_field_comprehension_project_target")
    out = asm_line(out, "cmp x24, #6")
    out = asm_line(out, "b.eq L_native_ast_field_comprehension_project_iterable")
    out = asm_line(out, "b L_native_ast_field_comprehension_project_condition")
    out = asm_label(out, "L_native_ast_field_comprehension_out_kind")
    out = asm_line(out, "ldr x9, [x26, #40]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.eq L_native_ast_field_comprehension_out_list")
