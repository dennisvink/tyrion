def emit_native_runtime_direct_exception_branch_runtime(out, target):
    # x0=text builder, x1=AST record id used to make the continuation label.
    # The compiler-local context chooses a generated application target:
    # try handler, finally entry, try propagation, function return, or the
    # top-level unhandled exception path.
    out = asm_label(out, "L_native_runtime_direct_append_exception_branch")
