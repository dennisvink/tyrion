def emit_native_runtime_direct_call_arg_copy_runtime(out, target):
    # Emit argument slot copies after sp has moved. x20 in the generated
    # application retains the caller frame base across the native call. x3 is
    # the canonical parameter link used to map keyword names to ordinals.
    out = asm_label(out, "L_native_runtime_direct_emit_call_arg_copies")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
