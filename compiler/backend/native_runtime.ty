    text = text + "__tyrion_app_shared_retain_find:\n    cbz x20, __tyrion_app_shared_retain_new\n"
    text = text + "    ldr x9, [x20]\n    cmp x9, x19\n    b.eq __tyrion_app_shared_retain_found\n"
    text = text + "    ldr x20, [x20, #16]\n    b __tyrion_app_shared_retain_find\n"
    text = text + "__tyrion_app_shared_retain_found:\n    ldr x9, [x20, #8]\n"
