    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #59")
    out = asm_line(out, "orr x9, x9, x10")
    out = asm_line(out, "str x9, [x0, #64]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
    out = asm_line(out, "b L_native_ast_field_get_ok")
