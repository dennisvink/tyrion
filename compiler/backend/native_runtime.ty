    out = asm_line(out, "b.eq L_native_ast_sequence_get_value_target")
    out = asm_line(out, "cmp x9, #10")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_value_synthetic_lambda_param")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_ast_sequence_get")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "bl L_native_ast_project_source_statement_view")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_ast_write_handle")
    out = asm_line(out, "b L_native_ast_sequence_get_value_return")
    out = asm_label(out, "L_native_ast_sequence_get_value_target")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_sequence_len")
    out = asm_line(out, "cbz w1, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "cmp x21, x0")
    out = asm_line(out, "b.hs L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_handle_root_record")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "ldr x22, [x0, #24]")
    out = asm_line(out, "add x1, x22, x21, lsl #1")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "ldr x1, [x0, #16]")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl L_native_ast_write_borrowed_string")
    out = asm_line(out, "b L_native_ast_sequence_get_value_return")
    out = asm_label(out, "L_native_ast_sequence_get_value_synthetic_lambda_param")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl L_native_ast_sequence_get")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "bl L_native_ast_handle_root_record")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_synthetic_lambda_param_release_fail")
    out = asm_line(out, "ldr x9, [x0]")
    out = asm_line(out, "cmp x9, #114")
    out = asm_line(out, "b.ne L_native_ast_sequence_get_value_synthetic_lambda_param_release_fail")
    out = asm_line(out, "ldr x1, [x0, #24]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_value_synthetic_lambda_param_release_fail")
    out = asm_line(out, "ldr x1, [x0, #16]")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl L_native_ast_write_borrowed_string")
    out = asm_line(out, "str w0, [sp, #48]")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "bl L_native_ast_handle_release")
    out = asm_line(out, "ldr w0, [sp, #48]")
    out = asm_line(out, "b L_native_ast_sequence_get_value_return")
    out = asm_label(out, "L_native_ast_sequence_get_value_synthetic_lambda_param_release_fail")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "bl L_native_ast_handle_release")
    out = asm_line(out, "b L_native_ast_sequence_get_value_fail")
    out = asm_label(out, "L_native_ast_sequence_get_value_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_ast_sequence_get_value_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # The physical parser lowers `name = lambda ...` to a kind-107 function
    # record so calls share the normal function ABI. Source-level consumers
    # must still observe the canonical assignment/lambda AST. Function records
    # created by `def` keep reserved record field +56 clear; lowered lambda
    # bindings set it to one at construction. Mark only those records with
    # synthetic-view bit 58 instead of inferring origin from mutable cursors.
    out = asm_label(out, "L_native_ast_project_source_statement_view")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "cbz x19, L_native_ast_project_source_statement_return")
    out = asm_line(out, "bl L_native_ast_handle_root_record")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "cbz x20, L_native_ast_project_source_statement_return")
    out = asm_line(out, "ldr x9, [x20]")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.ne L_native_ast_project_source_statement_return")
    out = asm_line(out, "ldr x9, [x20, #56]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.ne L_native_ast_project_source_statement_return")
    out = asm_line(out, "ldr x9, [x19, #64]")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "lsl x10, x10, #58")
    out = asm_line(out, "orr x9, x9, x10")
    out = asm_line(out, "str x9, [x19, #64]")
    out = asm_label(out, "L_native_ast_project_source_statement_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")

    out = emit_native_ast_field_access_runtime(out, target)
    return out


def emit_native_ast_field_access_runtime(out, target):
    keys = ["kind", "items", "body", "target", "value", "receiver", "resource", "index", "start", "stop", "left", "right", "op", "name", "vararg", "callee", "args", "entries", "key", "iterable", "condition", "expr", "out_kind", "targets", "elifs", "else_body", "except_name", "except_binding", "except_body", "finally_body", "params", "star", "has_default", "default"]
    value_tag_x23 = generated_value_tag_mem("x23")

    # x0=handle, x1=field bytes, x2=field length, x3=result slot.
    out = asm_label(out, "L_native_ast_field_get")
    out = asm_line(out, "stp x29, x30, [sp, #-128]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x23, x3")
    out = asm_line(out, "cbz x19, L_native_ast_field_get_fail")
    out = asm_line(out, "cbz x20, L_native_ast_field_get_fail")
    out = asm_line(out, "cbz x23, L_native_ast_field_get_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_handle_root_record")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "cbz x22, L_native_ast_field_get_fail")
    idx = 0
    while idx < len(keys):
        key = keys[idx]
        out = asm_line(out, "cmp x21, #" + str(len(key)))
        out = asm_line(out, "b.ne L_native_ast_field_key_next_" + str(idx))
        out = asm_line(out, "mov x0, x20")
        out = asm_addr(out, target, "x1", "L_native_ast_field_key_" + str(idx))
        out = asm_line(out, "mov x2, #" + str(len(key)))
        out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
        out = asm_line(out, "cbz w0, L_native_ast_field_" + key)
        out = asm_label(out, "L_native_ast_field_key_next_" + str(idx))
        idx = idx + 1
    out = asm_line(out, "b L_native_ast_field_get_fail")

    out = asm_label(out, "L_native_ast_field_kind")
    # Compact parser records can have canonical source views that do not exist
    # as physical arena records. Bits 57/58 project the lambda expression and
    # assignment synthesized from a lowered lambda-function record; bit 59
    # projects mode-3 `target += rhs` as `target + rhs`; bit 61 projects unpack.
    out = asm_line(out, "ldr x9, [x19, #64]")
    out = asm_line(out, "tbnz x9, #58, L_native_ast_field_literal_assign")
    out = asm_line(out, "tbnz x9, #57, L_native_ast_field_literal_lambda")
    out = asm_line(out, "tbnz x9, #59, L_native_ast_field_literal_binary")
    out = asm_line(out, "tbnz x9, #60, L_native_ast_field_literal_none")
    out = asm_line(out, "tbnz x9, #61, L_native_ast_field_literal_unpack")
    out = asm_line(out, "ldr x24, [x22]")
    out = asm_line(out, "cmp x24, #1")
    out = asm_line(out, "b.eq L_native_ast_field_kind_leaf")
    out = asm_line(out, "cmp x24, #6")
    out = asm_line(out, "b.eq L_native_ast_field_kind_call")
    kind_values = [2, 3, 4, 5, 7, 8, 10, 11, 12, 13, 14, 15, 16, 20, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 114, 115, 116, 117, 118, 119, 120]
    kind_names = ["unary", "binary", "attr", "index", "slice", "kwarg", "list", "tuple", "set", "dict_entry", "dict", "lambda", "comprehension", "unpack_target", "assign", "return", "expr", "if", "while", "break", "continue", "function", "for", "raise", "param", "branch", "with", "try", "except", "yield", "class"]
    kind_idx = 0
    while kind_idx < len(kind_values):
        out = asm_line(out, "cmp x24, #" + str(kind_values[kind_idx]))
        out = asm_line(out, "b.eq L_native_ast_field_literal_" + kind_names[kind_idx])
        kind_idx = kind_idx + 1
    out = asm_line(out, "b L_native_ast_field_get_fail")

    out = asm_label(out, "L_native_ast_field_kind_call")
    out = asm_line(out, "ldr x24, [x22, #24]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x24, lsl #6")
    out = asm_line(out, "ldr x9, [x9]")
    out = asm_line(out, "cmp x9, #4")
    out = asm_line(out, "b.eq L_native_ast_field_literal_method_call")
    out = asm_line(out, "b L_native_ast_field_literal_call")

    out = asm_label(out, "L_native_ast_field_kind_leaf")
    out = asm_line(out, "ldr x24, [x22, #24]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_token_record")
    out = asm_line(out, "cbz x0, L_native_ast_field_get_fail")
    out = asm_line(out, "ldr x24, [x0]")
    leaf_kinds = ["STRING", "INT", "FLOAT", "KW_TRUE", "KW_FALSE", "KW_NONE", "IDENTIFIER"]
    leaf_names = ["string", "int", "float", "bool", "bool", "none", "var"]
    leaf_idx = 0
    while leaf_idx < len(leaf_kinds):
        out = asm_line(out, "mov x0, x24")
        out = asm_addr(out, target, "x1", "L_native_ast_leaf_kind_" + str(leaf_idx))
        out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
        out = asm_line(out, "cbz w0, L_native_ast_field_literal_" + leaf_names[leaf_idx])
        leaf_idx = leaf_idx + 1
    out = asm_line(out, "b L_native_ast_field_get_fail")

    # Child-record fields.
    child_row_keys = ["target", "value", "value", "value", "value", "value", "value", "value", "receiver", "receiver", "receiver", "resource", "index", "start", "stop", "left", "right", "callee", "key", "value", "iterable", "condition", "condition", "condition", "default"]
    child_row_kinds = [100, 2, 8, 100, 101, 102, 109, 119, 4, 5, 7, 116, 5, 7, 7, 3, 3, 6, 13, 13, 108, 103, 104, 115, 114]
    child_row_offsets = [24, 24, 24, 32, 24, 24, 24, 24, 24, 24, 24, 24, 32, 32, 40, 24, 32, 24, 24, 32, 32, 24, 24, 24, 48]
    child_keys = ["target", "value", "receiver", "resource", "index", "start", "stop", "left", "right", "op", "name", "callee", "key", "iterable", "condition", "expr", "default"]
    child_key_idx = 0
    while child_key_idx < len(child_keys):
        key = child_keys[child_key_idx]
        out = asm_label(out, "L_native_ast_field_" + key)
        if key == "left":
            out = asm_line(out, "ldr x9, [x19, #64]")
            out = asm_line(out, "tbnz x9, #59, L_native_ast_field_augmented_left")
        if key == "right":
            out = asm_line(out, "ldr x9, [x19, #64]")
            out = asm_line(out, "tbnz x9, #59, L_native_ast_field_augmented_right")
        if key == "target":
            out = asm_line(out, "ldr x10, [x19, #64]")
            out = asm_line(out, "tbnz x10, #58, L_native_ast_field_lambda_binding_target")
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #100")
            out = asm_line(out, "b.eq L_native_ast_field_target_assignment")
        if key == "target" or key == "value" or key == "key" or key == "iterable" or key == "condition" or key == "expr":
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #16")
            out = asm_line(out, "b.eq L_native_ast_field_comprehension_" + key)
        # Assignment values need mode-sensitive projection before the generic
        # kind/offset table consumes kind 100. Mode 3 exposes a synthetic
        # source-level binary while ordinary assignments fall back to the same
        # physical child row.
        if key == "value":
            out = asm_line(out, "ldr x10, [x19, #64]")
            out = asm_line(out, "tbnz x10, #58, L_native_ast_field_lambda_binding_value")
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #100")
            out = asm_line(out, "b.eq L_native_ast_field_value_assignment")
        child_idx = 0
        while child_idx < len(child_row_keys):
            if child_row_keys[child_idx] == key:
                out = asm_line(out, "ldr x9, [x22]")
                out = asm_line(out, "cmp x9, #" + str(child_row_kinds[child_idx]))
                out = asm_line(out, "b.eq L_native_ast_field_" + key + "_kind_" + str(child_idx))
            child_idx = child_idx + 1
        if key == "value":
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #1")
            out = asm_line(out, "b.eq L_native_ast_field_value_leaf")
        if key == "receiver" or key == "name":
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #6")
            out = asm_line(out, "b.eq L_native_ast_field_" + key + "_method_call")
        if key == "name":
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #8")
            out = asm_line(out, "b.eq L_native_ast_field_name_keyword")
            out = asm_line(out, "cmp x9, #20")
            out = asm_line(out, "b.eq L_native_ast_field_name_record")
            out = asm_line(out, "cmp x9, #4")
            out = asm_line(out, "b.eq L_native_ast_field_name_member")
            out = asm_line(out, "cmp x9, #107")
            out = asm_line(out, "b.eq L_native_ast_field_name_record")
            out = asm_line(out, "cmp x9, #114")
            out = asm_line(out, "b.eq L_native_ast_field_name_record")
            out = asm_line(out, "cmp x9, #120")
            out = asm_line(out, "b.eq L_native_ast_field_name_record")
            out = asm_line(out, "cmp x9, #116")
            out = asm_line(out, "b.eq L_native_ast_field_name_with")
        if key == "op":
            out = asm_line(out, "ldr x9, [x19, #64]")
            out = asm_line(out, "tbnz x9, #59, L_native_ast_field_augmented_op")
            out = asm_line(out, "ldr x9, [x22]")
            out = asm_line(out, "cmp x9, #2")
            out = asm_line(out, "b.eq L_native_ast_field_op_token")
            out = asm_line(out, "cmp x9, #3")
            out = asm_line(out, "b.eq L_native_ast_field_op_token")
        out = asm_line(out, "b L_native_ast_field_get_fail")
