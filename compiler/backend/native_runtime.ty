    asm_line(out, "cbz w0, L_native_pratt_bp_15")
    asm_line(out, "mov x0, #0")
    asm_line(out, "b L_native_pratt_binding_power_return")
    asm_label(out, "L_native_pratt_bp_0")
    asm_line(out, "mov x0, #10")
