    out = asm_addr(out, target, "x1", "L_native_runtime_direct_exception_check_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_exception_branch_fail")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try")
    out = asm_line(out, "ldr x21, [x9]")
    out = asm_line(out, "cmp x21, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_exception_branch_function")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_try_mode")
    out = asm_line(out, "ldr x22, [x9]")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_handler_branch")
    out = asm_line(out, "cmp x22, #0")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_exception_branch_try_prefix")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_try_finally_branch")
    out = asm_line(out, "cmp x22, #1")
    out = asm_line(out, "b.eq L_native_runtime_direct_append_exception_branch_try_prefix")
