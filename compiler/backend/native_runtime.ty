    out = asm_addr(out, target, "x1", "L_native_runtime_direct_exception_check_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_append_exception_branch_fail")
