    out = asm_addr(out, target, "x0", "L_native_ast_field_comprehension_dict_text")
    out = asm_line(out, "b L_native_ast_field_comprehension_write_kind")
    out = asm_label(out, "L_native_ast_field_comprehension_out_list")
    out = asm_addr(out, target, "x0", "L_native_ast_field_comprehension_list_text")
    out = asm_label(out, "L_native_ast_field_comprehension_write_kind")
    out = asm_line(out, "mov x1, #4")
    out = asm_line(out, "mov x2, x23")
    out = asm_line(out, "bl L_native_ast_write_borrowed_string")
    out = asm_line(out, "cbz w0, L_native_ast_field_get_fail")
