    out = asm_line(out, "cmp x10, #20")
    out = asm_line(out, "b.ne L_native_ast_sequence_get_fail")
    out = asm_line(out, "ldr x10, [x9, #40]")
    out = asm_line(out, "cmp x10, x20")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_unpack_match")
    out = asm_line(out, "ldr x22, [x9, #32]")
    out = asm_line(out, "b L_native_ast_sequence_get_unpack_walk")
    out = asm_label(out, "L_native_ast_sequence_get_unpack_match")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl L_native_ast_handle_view")
    out = asm_line(out, "b L_native_ast_sequence_get_return")
    out = asm_label(out, "L_native_ast_sequence_get_if_elif")
    out = asm_line(out, "ldr x22, [x0, #40]")
    out = asm_line(out, "mov x21, #4")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_if_else")
    out = asm_line(out, "ldr x22, [x0, #40]")
    out = asm_line(out, "mov x21, #5")
    out = asm_label(out, "L_native_ast_sequence_get_chain")
    out = asm_line(out, "cmp x22, #-1")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_fail")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x22, x9")
    out = asm_line(out, "b.hs L_native_ast_sequence_get_fail")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x22, lsl #6")
    out = asm_line(out, "cmp x21, #4")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_elif")
    out = asm_line(out, "cmp x21, #5")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_else")
    out = asm_line(out, "cmp x21, #3")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_param")
    out = asm_line(out, "ldr x10, [x9, #40]")
    out = asm_line(out, "cmp x10, x20")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_match")
    out = asm_line(out, "cmp x21, #2")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_dict_next")
    out = asm_line(out, "ldr x22, [x9, #32]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_chain_dict_next")
    out = asm_line(out, "ldr x22, [x9, #40]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_chain_param")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, x20")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_self")
    out = asm_line(out, "ldr x22, [x9, #40]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_chain_elif")
    out = asm_line(out, "ldr x10, [x9, #24]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_elif_next")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, x20")
    out = asm_line(out, "b.eq L_native_ast_sequence_get_chain_self")
    out = asm_label(out, "L_native_ast_sequence_get_chain_elif_next")
    out = asm_line(out, "ldr x22, [x9, #40]")
    out = asm_line(out, "b L_native_ast_sequence_get_chain")
    out = asm_label(out, "L_native_ast_sequence_get_chain_else")
    out = asm_line(out, "ldr x10, [x9, #24]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_ast_sequence_get_chain_else_next")
    out = asm_line(out, "ldr x22, [x9, #32]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl L_native_ast_handle_sequence_view")
    out = asm_line(out, "cbz x0, L_native_ast_sequence_get_fail")
