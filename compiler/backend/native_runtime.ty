def emit_native_pratt_ast_runtime(out, target):
    asm_label(out, "L_native_token_record_at")
    asm_line(out, "cbz x0, L_native_token_record_at_fail")
    asm_line(out, "ldrb w9, [x0]")
    asm_line(out, "cmp w9, #167")
    asm_line(out, "b.ne L_native_token_record_at_fail")
    asm_line(out, "ldr x9, [x0, #8]")
    asm_line(out, "cbz x9, L_native_token_record_at_fail")
    # Parsing diagnostics own a furthest-token cursor. Updating it at the
    # canonical token accessor covers nested Pratt and delimiter probes
    # without adding a diagnostic parameter to every parser helper ABI.
    asm_line(out, "cmp x1, x9")
    asm_line(out, "b.lo L_native_token_record_at_position_in_range")
    asm_line(out, "sub x10, x9, #1")
    asm_line(out, "b L_native_token_record_at_position_ready")
    asm_label(out, "L_native_token_record_at_position_in_range")
    asm_line(out, "mov x10, x1")
    asm_label(out, "L_native_token_record_at_position_ready")
    asm_addr(out, target, "x11", "L_native_parse_failure_pos")
    asm_line(out, "ldr x12, [x11]")
    asm_line(out, "cmp x10, x12")
    asm_line(out, "b.ls L_native_token_record_at_position_done")
    asm_line(out, "str x10, [x11]")
    asm_label(out, "L_native_token_record_at_position_done")
    asm_line(out, "cmp x1, x9")
    asm_line(out, "b.hs L_native_token_record_at_fail")
    asm_line(out, "add x0, x0, #32")
    asm_line(out, "mov x9, #40")
    asm_line(out, "madd x0, x1, x9, x0")
    asm_line(out, "ret")
    asm_label(out, "L_native_token_record_at_fail")
    asm_line(out, "mov x0, #0")
    asm_line(out, "ret")

    asm_label(out, "L_native_pratt_binding_power")
    asm_line(out, "stp x29, x30, [sp, #-48]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_0")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_0")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_1")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_1")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_2")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_2")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_3")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_3")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_4")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_4")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_5")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_5")
