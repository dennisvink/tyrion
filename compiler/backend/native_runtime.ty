    text = text + "    add x9, x9, #1\n    str x9, [x20, #8]\n"
    text = text + "    b __tyrion_app_shared_retain_success\n"
    text = text + "__tyrion_app_shared_retain_new:\n    mov x0, #24\n    bl _malloc\n"
    text = text + "    cbz x0, __tyrion_app_shared_retain_fail\n    str x19, [x0]\n"
    text = text + "    mov x9, #2\n    str x9, [x0, #8]\n    ldr x9, [x21]\n"
    text = text + "    str x9, [x0, #16]\n    str x0, [x21]\n"
    text = text + "__tyrion_app_shared_retain_success:\n    mov w0, #1\n"
    text = text + "    b __tyrion_app_shared_retain_done\n"
    text = text + "__tyrion_app_shared_retain_fail:\n    mov w0, #0\n"
    text = text + "__tyrion_app_shared_retain_done:\n    ldr x21, [sp, #32]\n"
    text = text + "    ldp x19, x20, [sp, #16]\n    ldp x29, x30, [sp], #64\n    ret\n"
