    out = asm_line(out, "ret")
    out = asm_cstr(out, "L_module_graph_source_prefix", "# module-source: ")
    out = asm_cstr(out, "L_module_graph_hash_prefix", "# module-graph-hash: ")
    out = asm_label(out, "L_module_graph_hash_zero")
    out = asm_dir(out, ".byte 0")
    out = asm_dir(out, ".p2align 3")
    out = asm_label(out, "L_module_graph_fnv_offset")
    out = asm_dir(out, ".quad 1469598103934665603")
    out = asm_label(out, "L_module_graph_fnv_prime")
