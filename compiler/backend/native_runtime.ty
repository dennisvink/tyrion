    out = asm_cstr(out, "L_native_runtime_direct_control_init_a", "    ldr x15, =")
    out = asm_cstr(out, "L_native_runtime_direct_control_init_b", "\n    add x13, sp, x15\n    str xzr, [x13]\n")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_a", "    ldr x15, =")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_b", "\n    add x13, sp, x15\n    ldr x9, [x13]\n")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_return", "    cmp x9, #1\n    b.eq L_tyrion_direct_try_control_return_")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_c", "\n    cmp x9, #2\n    b.eq L_tyrion_direct_try_control_break_")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_d", "\n    cmp x9, #3\n    b.eq L_tyrion_direct_try_control_continue_")
    out = asm_cstr(out, "L_native_runtime_direct_control_dispatch_e", "\n    b L_tyrion_direct_try_control_done_")
    out = asm_cstr(out, "L_native_runtime_direct_control_return_label", "L_tyrion_direct_try_control_return_")
    out = asm_cstr(out, "L_native_runtime_direct_control_break_label", "L_tyrion_direct_try_control_break_")
    out = asm_cstr(out, "L_native_runtime_direct_control_continue_label", "L_tyrion_direct_try_control_continue_")
    out = asm_cstr(out, "L_native_runtime_direct_control_done_label", "L_tyrion_direct_try_control_done_")
    return out

def emit_native_runtime_direct_data_expression_ops(out, target):
    expr_pair_a = "    ldr x15, ="
    expr_pair_b = "\n    add x13, sp, x15\n    ldr x15, ="
    expr_unary_minus = "\n    add x10, sp, x15\n    ldr x9, [x10]\n"
    expr_unary_minus = expr_unary_minus + "    neg x9, x9\n    str x9, [x13]\n"
    expr_unary_minus = expr_unary_minus + "    mov w9, #2\n    strb w9, [x13, #127]\n"
    expr_unary_not = "\n    add x10, sp, x15\n    ldr x9, [x10]\n"
    expr_unary_not = expr_unary_not + "    cmp x9, #0\n    cset w9, eq\n"
    expr_unary_not = expr_unary_not + "    str x9, [x13]\n    mov w9, #3\n"
    expr_unary_not = expr_unary_not + "    strb w9, [x13, #127]\n"
    expr_triple_a = "    ldr x15, ="
    expr_triple_b = "\n    add x13, sp, x15\n    ldr x15, ="
    expr_triple_c = "\n    add x10, sp, x15\n    ldr x15, ="
    binary_tail_int = "\n    str x9, [x13]\n    mov w9, #2\n    strb w9, [x13, #127]\n"
    binary_tail_bool = "\n    str x9, [x13]\n    mov w9, #3\n    strb w9, [x13, #127]\n"
    binary_head = "\n    add x11, sp, x15\n    ldr x9, [x10]\n"
    binary_head = binary_head + "    ldr x12, [x11]\n"
    binary_code_0 = binary_head + "    mov x0, x13\n    mov x1, x10\n"
    binary_code_0 = binary_code_0 + "    mov x2, x11\n    bl __tyrion_app_add\n"
    numeric_code = "\n    add x11, sp, x15\n    mov x0, x13\n    mov x1, x10\n    mov x2, x11\n    mov x3, #"
    numeric_code_tail = "\n    bl __tyrion_app_numeric_binary\n"
    binary_code_1 = numeric_code + "1" + numeric_code_tail
    binary_code_2 = numeric_code + "2" + numeric_code_tail
    compare_code = "\n    add x11, sp, x15\n    sub sp, sp, #16\n    str x13, [sp]\n"
    compare_code = compare_code + "    mov x0, x10\n    mov x1, x11\n    bl __tyrion_app_value_compare\n"
    compare_code = compare_code + "    cmp w0, #0\n    cset w9, "
    compare_code_tail = "\n    ldr x13, [sp]\n    add sp, sp, #16" + binary_tail_bool
    binary_code_3 = binary_head + "    sub sp, sp, #16\n    str x13, [sp]\n"
    binary_code_3 = binary_code_3 + "    mov x0, x10\n    mov x1, x11\n"
    binary_code_3 = binary_code_3 + "    bl __tyrion_app_equal\n    mov x9, x0\n"
    binary_code_3 = binary_code_3 + "    ldr x13, [sp]\n    add sp, sp, #16" + binary_tail_bool
    binary_code_4 = binary_head + "    sub sp, sp, #16\n    str x13, [sp]\n"
    binary_code_4 = binary_code_4 + "    mov x0, x10\n    mov x1, x11\n"
    binary_code_4 = binary_code_4 + "    bl __tyrion_app_equal\n    eor w9, w0, #1\n"
    binary_code_4 = binary_code_4 + "    ldr x13, [sp]\n    add sp, sp, #16" + binary_tail_bool
    binary_code_5 = compare_code + "lt" + compare_code_tail
    binary_code_6 = compare_code + "le" + compare_code_tail
    binary_code_7 = compare_code + "gt" + compare_code_tail
    binary_code_8 = compare_code + "ge" + compare_code_tail
    binary_code_9 = numeric_code + "3" + numeric_code_tail
    binary_code_10 = "\n    add x11, sp, x15\n    mov x0, x10\n"
    binary_code_10 = binary_code_10 + "    mov x1, x11\n    mov x2, x13\n"
    binary_code_10 = binary_code_10 + "    bl __tyrion_app_contains\n"
    binary_code_11 = "\n    add x11, sp, x15\n    sub sp, sp, #16\n    stp x11, x13, [sp]\n"
    binary_code_11 = binary_code_11 + "    mov x0, x10\n    bl __tyrion_app_truthy\n"
    binary_code_11 = binary_code_11 + "    cbnz w0, 1f\n    ldr x0, [sp]\n    bl __tyrion_app_truthy\n"
    binary_code_11 = binary_code_11 + "1:\n    ldr x13, [sp, #8]\n    add sp, sp, #16\n"
    binary_code_11 = binary_code_11 + "    str x0, [x13]\n    mov w9, #3\n    strb w9, [x13, #127]\n"
    binary_code_12 = "\n    add x11, sp, x15\n    sub sp, sp, #16\n    stp x11, x13, [sp]\n"
    binary_code_12 = binary_code_12 + "    mov x0, x10\n    bl __tyrion_app_truthy\n"
    binary_code_12 = binary_code_12 + "    cbz w0, 1f\n    ldr x0, [sp]\n    bl __tyrion_app_truthy\n"
    binary_code_12 = binary_code_12 + "1:\n    ldr x13, [sp, #8]\n    add sp, sp, #16\n"
    binary_code_12 = binary_code_12 + "    str x0, [x13]\n    mov w9, #3\n    strb w9, [x13, #127]\n"
    binary_code_13 = numeric_code + "4" + numeric_code_tail
    binary_code_14 = numeric_code + "5" + numeric_code_tail
    binary_code_15 = numeric_code + "6" + numeric_code_tail
    binary_code_16 = numeric_code + "7" + numeric_code_tail
    binary_code_17 = numeric_code + "8" + numeric_code_tail
    binary_code_18 = numeric_code + "9" + numeric_code_tail
    binary_code_19 = numeric_code + "10" + numeric_code_tail
    binary_code_20 = numeric_code + "11" + numeric_code_tail
    out = asm_cstr(out, "L_native_runtime_direct_expr_pair_a", expr_pair_a)
    out = asm_cstr(out, "L_native_runtime_direct_expr_pair_b", expr_pair_b)
    out = asm_cstr(out, "L_native_runtime_direct_expr_unary_minus", expr_unary_minus)
    out = asm_cstr(out, "L_native_runtime_direct_expr_unary_not", expr_unary_not)
    out = asm_cstr(out, "L_native_runtime_direct_expr_triple_a", expr_triple_a)
    out = asm_cstr(out, "L_native_runtime_direct_expr_triple_b", expr_triple_b)
    out = asm_cstr(out, "L_native_runtime_direct_expr_triple_c", expr_triple_c)
    binary_count = application_binary_operator_count()
    binary_idx = 0
    while binary_idx < binary_count:
        binary_id = application_binary_operator_id_at(binary_idx)
        binary_name = application_binary_operator_name_at(binary_idx)
        out = asm_cstr(out, "L_native_runtime_direct_binary_name_" + str(binary_id), binary_name)
        binary_idx = binary_idx + 1
