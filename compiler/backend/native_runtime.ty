    out = asm_line(out, "mov x26, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_tcp_call_record")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_two_arity")
    out = asm_line(out, "mov x26, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_tcp_call_record")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_four_arity")
    out = asm_line(out, "mov x26, #4")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_record")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_tcp_call_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x24, [x23, #32]")
    out = asm_line(out, "mov x10, x26")
    out = asm_label(out, "L_native_runtime_direct_emit_tcp_call_collect")
    out = asm_line(out, "cbz x10, L_native_runtime_direct_emit_tcp_call_collected")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_tcp_call_unsupported")
