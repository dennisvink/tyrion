# compiler / backend / native runtime: responsibility-owned canonical compiler module.

def emit_native_read_text_file_primitive(out, target):
    value_tag_x0 = generated_value_tag_mem("x0")
    value_tag_x19 = generated_value_tag_mem("x19")

    out = asm_label(out, "L_native_read_text_file")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x1")
    out = asm_line(out, "ldrb w9, " + value_tag_x0)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne L_read_file_path_ready")
    out = asm_line(out, "ldr x0, [x0]")
    out = asm_label(out, "L_read_file_path_ready")
    out = asm_line(out, "mov x20, x0")
    out = asm_addr(out, target, "x1", "L_mode_r")
    out = asm_line(out, "bl " + asm_call_name(target, "fopen"))
    out = asm_line(out, "cbz x0, L_read_file_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x0, #4096")
    out = asm_line(out, "lsl x0, x0, #10")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_read_file_fail_close")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "mov x1, #1")
    out = asm_line(out, "mov x2, #4096")
    out = asm_line(out, "lsl x2, x2, #10")
    out = asm_line(out, "sub x2, x2, #1")
    out = asm_line(out, "mov x3, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "fread"))
    out = asm_line(out, "strb wzr, [x22, x0]")
    out = asm_line(out, "str x22, [x19]")
    out = asm_line(out, "str x0, [x19, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, " + value_tag_x19)
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    # x0=primitive name pointer, x1=name length. Record a renderer-owned
    # arity rejection without consulting compiler source or reparsing text.
    out = asm_label(out, "L_native_runtime_direct_set_primitive_arity_diagnostic")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_detail_ptr")
    out = asm_line(out, "stp x0, x1, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_nested_arg_index")
    out = asm_line(out, "mov x10, #-1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_code")
    out = asm_line(out, "mov x10, #3")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")

    # x0=AST handle, x1=keyword token index, x2=nested argument index.
    out = asm_label(out, "L_native_runtime_direct_set_keyword_diagnostic")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "str x2, [sp, #16]")
    out = asm_line(out, "ldr x0, [x0, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_set_keyword_diagnostic_fail")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_detail_ptr")
    out = asm_line(out, "ldp x10, x11, [x0, #8]")
    out = asm_line(out, "stp x10, x11, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_nested_arg_index")
    out = asm_line(out, "ldr x10, [sp, #16]")
    out = asm_line(out, "str x10, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_code")
    out = asm_line(out, "mov x10, #4")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_set_keyword_diagnostic_return")
    out = asm_label(out, "L_native_runtime_direct_set_keyword_diagnostic_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_set_keyword_diagnostic_return")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")

    # x0=diagnostic code, x1=NUL-terminated static detail. This is the common
    # statement/parser rejection path; the owning renderer establishes the
    # canonical AST path before calling it.
    out = asm_label(out, "L_native_runtime_direct_set_static_diagnostic")
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_detail_ptr")
    out = asm_line(out, "stp x20, x0, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_code")
    out = asm_line(out, "str x19, [x9]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")

    # x0=static failure code, x1=NUL-terminated path. Emit one bounded
    # compiler-file diagnostic without allocation or variadic ABI use.
    out = asm_label(out, "L_native_compiler_file_report_failure")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_addr(out, target, "x21", "L_native_compiler_file_diag_prefix")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x21", "L_native_compiler_file_diag_path")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, #2")
    out = asm_addr(out, target, "x1", "L_runtime_newline")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    out = asm_cstr(out, "L_native_compiler_file_diag_prefix", "compiler-file rejected code=")
    out = asm_cstr(out, "L_native_compiler_file_diag_path", ";path=")
    out = asm_cstr(out, "L_native_compiler_file_read_failed", "read-failed")
    out = asm_cstr(out, "L_native_compiler_file_write_failed", "write-failed")
    out = asm_line(out, ".p2align 2")

    # x0=static code, x1=input path, x2=output path. Report native tool
    # failure at the owning primitive so helper/build/CLI layers remain silent.
    out = asm_label(out, "L_native_tool_report_failure")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x22, x2")
    out = asm_addr(out, target, "x21", "L_native_tool_diag_prefix")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x21", "L_native_tool_diag_path")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x21", "L_native_tool_diag_output")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x2, x0")
    out = asm_line(out, "mov x0, #2")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_line(out, "mov x0, #2")
    out = asm_addr(out, target, "x1", "L_runtime_newline")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "write"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    out = asm_cstr(out, "L_native_tool_diag_prefix", "native-tool rejected code=")
    out = asm_cstr(out, "L_native_tool_diag_path", ";path=")
    out = asm_cstr(out, "L_native_tool_diag_output", ";output=")
    out = asm_cstr(out, "L_native_tool_assemble_failed", "assemble-failed")
    out = asm_cstr(out, "L_native_tool_link_failed", "link-failed")
    out = asm_line(out, ".p2align 2")

    out = asm_label(out, "L_read_file_fail_close")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_label(out, "L_read_file_fail")
    out = asm_addr(out, target, "x0", "L_native_compiler_file_read_failed")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_compiler_file_report_failure")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    return out

def emit_native_module_graph_primitive(out, target):
    # Module graph context: output ptr/len/cap, loaded ptr/len, active ptr/len,
    # symbol ptr/len, hash, hash scratch, and immutable entry path. Dotted
    # imports resolve from the entry module directory, not the importing file.
    value_tag_x20 = generated_value_tag_mem("x20")
    out = asm_label(out, "L_native_read_module_graph")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "str x25, [sp, #64]")
    out = asm_line(out, "sub sp, sp, #112")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, sp")
    out = asm_line(out, "mov x22, #0")
    out = asm_line(out, "mov x23, #0")
    out = asm_line(out, "mov x24, #0")
    out = asm_line(out, "stp xzr, xzr, [x21]")
    out = asm_line(out, "stp xzr, xzr, [x21, #16]")
    out = asm_line(out, "stp xzr, xzr, [x21, #32]")
    out = asm_line(out, "stp xzr, xzr, [x21, #48]")
    out = asm_line(out, "stp xzr, xzr, [x21, #64]")
    out = asm_line(out, "str xzr, [x21, #104]")
    out = asm_addr(out, target, "x9", "L_module_graph_fnv_offset")
    out = asm_line(out, "ldr x9, [x9]")
    out = asm_line(out, "str x9, [x21, #72]")
    out = asm_line(out, "cbz x19, L_native_read_module_graph_fail")
    out = asm_line(out, "cbz x20, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "str x19, [x21, #96]")
    out = asm_line(out, "mov x0, #4096")
    out = asm_line(out, "lsl x0, x0, #12")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "str x0, [x21]")
    out = asm_line(out, "str xzr, [x21, #8]")
    out = asm_line(out, "mov x9, #4096")
    out = asm_line(out, "lsl x9, x9, #12")
    out = asm_line(out, "str x9, [x21, #16]")
    out = asm_line(out, "mov x0, #4096")
    out = asm_line(out, "lsl x0, x0, #6")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x23, x0")
    out = asm_line(out, "str x0, [x21, #24]")
    out = asm_line(out, "str xzr, [x21, #32]")
    out = asm_line(out, "mov x0, #4096")
    out = asm_line(out, "lsl x0, x0, #4")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "str x0, [x21, #40]")
    out = asm_line(out, "str xzr, [x21, #48]")
    out = asm_line(out, "mov x0, #4096")
    out = asm_line(out, "lsl x0, x0, #6")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_read_module_graph_fail")
    out = asm_line(out, "str x0, [x21, #56]")
    out = asm_line(out, "str xzr, [x21, #64]")
    out = asm_addr(out, target, "x0", "L_module_graph_builtin_core_path")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "mov x2, #0")
    out = asm_line(out, "bl L_module_graph_visit_native")
    out = asm_line(out, "cbz w0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "mov x2, #0")
    out = asm_line(out, "bl L_module_graph_visit_native")
    out = asm_line(out, "cbz w0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_module_graph_hash_prefix")
    out = asm_line(out, "mov x2, #21")
    out = asm_line(out, "bl L_module_graph_output_append")
    out = asm_line(out, "cbz w0, L_native_read_module_graph_fail")
    out = asm_line(out, "ldr x9, [x21, #72]")
    out = asm_line(out, "mov x10, #0")
    out = asm_line(out, "add x11, x21, #80")
    out = asm_label(out, "L_native_read_module_graph_hash_loop")
    out = asm_line(out, "cmp x10, #16")
    out = asm_line(out, "b.eq L_native_read_module_graph_hash_done")
    out = asm_line(out, "mov x12, #15")
    out = asm_line(out, "sub x12, x12, x10")
    out = asm_line(out, "lsl x12, x12, #2")
    out = asm_line(out, "lsr x13, x9, x12")
    out = asm_line(out, "and x13, x13, #15")
    out = asm_line(out, "cmp x13, #10")
    out = asm_line(out, "b.lo L_native_read_module_graph_hash_digit")
    out = asm_line(out, "add x13, x13, #87")
    out = asm_line(out, "b L_native_read_module_graph_hash_store")
    out = asm_label(out, "L_native_read_module_graph_hash_digit")
    out = asm_line(out, "add x13, x13, #48")
    out = asm_label(out, "L_native_read_module_graph_hash_store")
    out = asm_line(out, "strb w13, [x11, x10]")
    out = asm_line(out, "add x10, x10, #1")
    out = asm_line(out, "b L_native_read_module_graph_hash_loop")
    out = asm_label(out, "L_native_read_module_graph_hash_done")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x11")
    out = asm_line(out, "mov x2, #16")
    out = asm_line(out, "bl L_module_graph_output_append")
    out = asm_line(out, "cbz w0, L_native_read_module_graph_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_runtime_newline")
    out = asm_line(out, "mov x2, #1")
    out = asm_line(out, "bl L_module_graph_output_append")
    out = asm_line(out, "cbz w0, L_native_read_module_graph_fail")
    out = asm_line(out, "ldr x0, [x21]")
    out = asm_line(out, "ldr x9, [x21, #8]")
    out = asm_line(out, "strb wzr, [x0, x9]")
    out = asm_line(out, "str x0, [x20]")
    out = asm_line(out, "str x9, [x20, #8]")
    out = asm_line(out, "mov w10, #8")
    out = asm_line(out, "strb w10, " + value_tag_x20)
    out = asm_line(out, "mov x22, #0")
    out = asm_line(out, "mov w19, #1")
    out = asm_line(out, "b L_native_read_module_graph_cleanup")
    out = asm_label(out, "L_native_read_module_graph_fail")
    out = asm_line(out, "ldr x1, [x21, #96]")
    out = asm_line(out, "cbz x1, L_native_read_module_graph_fail_reported")
    out = asm_addr(out, target, "x0", "L_native_compiler_file_read_failed")
    out = asm_line(out, "ldr x9, [x21, #104]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.ne L_native_read_module_graph_fail_not_cycle")
    out = asm_addr(out, target, "x0", "L_native_module_cycle_failed")
    out = asm_line(out, "b L_native_read_module_graph_fail_emit")
    out = asm_label(out, "L_native_read_module_graph_fail_not_cycle")
    out = asm_line(out, "cmp x9, #2")
    out = asm_line(out, "b.ne L_native_read_module_graph_fail_emit")
    out = asm_addr(out, target, "x0", "L_native_module_duplicate_failed")
    out = asm_label(out, "L_native_read_module_graph_fail_emit")
    out = asm_line(out, "bl L_native_compiler_file_report_failure")
    out = asm_label(out, "L_native_read_module_graph_fail_reported")
    out = asm_line(out, "mov w19, #0")
    out = asm_label(out, "L_native_read_module_graph_cleanup")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "cbz x0, L_native_read_module_graph_free_loaded")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_read_module_graph_free_loaded")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "cbz x0, L_native_read_module_graph_free_active")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_read_module_graph_free_active")
    out = asm_line(out, "mov x0, x24")
    out = asm_line(out, "cbz x0, L_native_read_module_graph_free_symbols")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_read_module_graph_free_symbols")
    out = asm_line(out, "ldr x0, [x21, #56]")
    out = asm_line(out, "cbz x0, L_native_read_module_graph_return")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_read_module_graph_return")
    out = asm_line(out, "mov w0, w19")
    out = asm_line(out, "add sp, sp, #112")
    out = asm_line(out, "ldr x25, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # x0=typed STRING token record, x1=result slot -> w0=success. Token text
    # intentionally retains source quotes for diagnostics; AST `value` must
    # expose the decoded Tyrion string used by the source frontend instead.
    out = asm_label(out, "L_native_ast_write_string_token_value")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, #0")
    out = asm_line(out, "cbz x19, L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "cbz x20, L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "ldr x22, [x19, #8]")
    out = asm_line(out, "ldr x23, [x19, #16]")
    out = asm_line(out, "cbz x22, L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "cmp x23, #2")
    out = asm_line(out, "b.lo L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "ldrb w24, [x22]")
    out = asm_line(out, "cmp w24, #34")
    out = asm_line(out, "b.eq L_native_ast_write_string_token_value_quote_ok")
    out = asm_line(out, "cmp w24, #39")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_fail")
    out = asm_label(out, "L_native_ast_write_string_token_value_quote_ok")
    out = asm_line(out, "sub x25, x23, #1")
    out = asm_line(out, "ldrb w9, [x22, x25]")
    out = asm_line(out, "cmp w9, w24")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "cbz x21, L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "mov x24, #1")
    out = asm_line(out, "mov x26, #0")
    out = asm_label(out, "L_native_ast_write_string_token_value_loop")
    out = asm_line(out, "cmp x24, x25")
    out = asm_line(out, "b.hs L_native_ast_write_string_token_value_done")
    out = asm_line(out, "ldrb w9, [x22, x24]")
    out = asm_line(out, "cmp w9, #92")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_copy")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "cmp x24, x25")
    out = asm_line(out, "b.hs L_native_ast_write_string_token_value_release_fail")
    out = asm_line(out, "ldrb w9, [x22, x24]")
    out = asm_line(out, "cmp w9, #110")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_escape_r")
    out = asm_line(out, "mov w9, #10")
    out = asm_line(out, "b L_native_ast_write_string_token_value_copy")
    out = asm_label(out, "L_native_ast_write_string_token_value_escape_r")
    out = asm_line(out, "cmp w9, #114")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_escape_t")
    out = asm_line(out, "mov w9, #13")
    out = asm_line(out, "b L_native_ast_write_string_token_value_copy")
    out = asm_label(out, "L_native_ast_write_string_token_value_escape_t")
    out = asm_line(out, "cmp w9, #116")
    out = asm_line(out, "b.ne L_native_ast_write_string_token_value_copy")
    out = asm_line(out, "mov w9, #9")
    out = asm_label(out, "L_native_ast_write_string_token_value_copy")
    out = asm_line(out, "strb w9, [x21, x26]")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "add x26, x26, #1")
    out = asm_line(out, "b L_native_ast_write_string_token_value_loop")
    out = asm_label(out, "L_native_ast_write_string_token_value_done")
    out = asm_line(out, "strb wzr, [x21, x26]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl L_native_ast_write_borrowed_string")
    out = asm_line(out, "mov x25, x0")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "mov x21, #0")
    out = asm_line(out, "mov x0, x25")
    out = asm_line(out, "b L_native_ast_write_string_token_value_return")
    out = asm_label(out, "L_native_ast_write_string_token_value_release_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_ast_write_string_token_value_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_ast_write_string_token_value_return")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    # x0=context, x1=bytes, x2=length. Fixed 16 MiB output arena.
    out = asm_label(out, "L_module_graph_output_append")
    out = asm_line(out, "ldr x9, [x0, #8]")
    out = asm_line(out, "add x10, x9, x2")
    out = asm_line(out, "ldr x11, [x0, #16]")
    out = asm_line(out, "cmp x10, x11")
    out = asm_line(out, "b.hs L_module_graph_output_append_fail")
    out = asm_line(out, "stp x0, x10, [sp, #-32]!")
    out = asm_line(out, "str x2, [sp, #16]")
    out = asm_line(out, "str x30, [sp, #24]")
    out = asm_line(out, "ldr x0, [x0]")
    out = asm_line(out, "add x0, x0, x9")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "ldp x9, x10, [sp]")
    out = asm_line(out, "ldr x30, [sp, #24]")
    out = asm_line(out, "str x10, [x9, #8]")
    out = asm_line(out, "add sp, sp, #32")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_module_graph_output_append_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")

    # x0=list, x1=list length, x2=text, x3=text length.
    out = asm_label(out, "L_module_graph_list_contains")
    out = asm_line(out, "mov x8, #0")
    out = asm_label(out, "L_module_graph_list_contains_next")
    out = asm_line(out, "cmp x8, x1")
    out = asm_line(out, "b.hs L_module_graph_list_contains_no")
    out = asm_line(out, "mov x9, x8")
    out = asm_label(out, "L_module_graph_list_contains_end")
    out = asm_line(out, "cmp x9, x1")
    out = asm_line(out, "b.hs L_module_graph_list_contains_compare")
    out = asm_line(out, "ldrb w10, [x0, x9]")
    out = asm_line(out, "cmp w10, #10")
    out = asm_line(out, "b.eq L_module_graph_list_contains_compare")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "b L_module_graph_list_contains_end")
    out = asm_label(out, "L_module_graph_list_contains_compare")
    out = asm_line(out, "sub x10, x9, x8")
    out = asm_line(out, "cmp x10, x3")
    out = asm_line(out, "b.ne L_module_graph_list_contains_advance")
    out = asm_line(out, "stp x0, x1, [sp, #-64]!")
    out = asm_line(out, "stp x2, x3, [sp, #16]")
    out = asm_line(out, "str x9, [sp, #32]")
    out = asm_line(out, "str x8, [sp, #40]")
    out = asm_line(out, "str x30, [sp, #48]")
    out = asm_line(out, "add x0, x0, x8")
    out = asm_line(out, "mov x1, x2")
    out = asm_line(out, "mov x2, x3")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "mov w10, w0")
    out = asm_line(out, "ldp x0, x1, [sp]")
    out = asm_line(out, "ldp x2, x3, [sp, #16]")
    out = asm_line(out, "ldr x9, [sp, #32]")
    out = asm_line(out, "ldr x8, [sp, #40]")
    out = asm_line(out, "ldr x30, [sp, #48]")
    out = asm_line(out, "add sp, sp, #64")
    out = asm_line(out, "cbz w10, L_module_graph_list_contains_yes")
    out = asm_label(out, "L_module_graph_list_contains_advance")
    out = asm_line(out, "add x8, x9, #1")
    out = asm_line(out, "b L_module_graph_list_contains_next")
    out = asm_label(out, "L_module_graph_list_contains_yes")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_module_graph_list_contains_no")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")

    # x0=list, x1=current length, x2=capacity, x3=text, x4=text length.
    out = asm_label(out, "L_module_graph_list_append")
    out = asm_line(out, "add x9, x1, x4")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "cmp x9, x2")
    out = asm_line(out, "b.hi L_module_graph_list_append_fail")
    out = asm_line(out, "stp x1, x9, [sp, #-32]!")
    out = asm_line(out, "str x0, [sp, #16]")
    out = asm_line(out, "str x30, [sp, #24]")
    out = asm_line(out, "add x0, x0, x1")
    out = asm_line(out, "mov x1, x3")
    out = asm_line(out, "mov x2, x4")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "ldr x10, [sp, #16]")
    out = asm_line(out, "ldr x9, [sp, #8]")
    out = asm_line(out, "ldr x30, [sp, #24]")
    out = asm_line(out, "sub x11, x9, #1")
    out = asm_line(out, "mov w12, #10")
    out = asm_line(out, "strb w12, [x10, x11]")
    out = asm_line(out, "mov x0, x9")
    out = asm_line(out, "add sp, sp, #32")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_module_graph_list_append_fail")
    out = asm_line(out, "mov x0, #-1")
    out = asm_line(out, "ret")

    # x0=path. Returns owned bytes in x0 and length in x1.
    out = asm_label(out, "L_module_graph_read_file")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_addr(out, target, "x1", "L_module_graph_builtin_core_path")
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbnz w0, L_module_graph_read_file_try_http")
    out = asm_addr(out, target, "x19", "L_module_graph_builtin_core_source")
    out = asm_line(out, "b L_module_graph_read_file_builtin")
    out = asm_label(out, "L_module_graph_read_file_try_http")
    out = asm_addr(out, target, "x0", "L_module_graph_builtin_http_path")
    out = asm_line(out, "mov x1, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    out = asm_line(out, "cbnz w0, L_module_graph_read_file_regular")
    out = asm_addr(out, target, "x19", "L_module_graph_builtin_http_source")
    out = asm_label(out, "L_module_graph_read_file_builtin")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "add x0, x20, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_module_graph_read_file_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x1, x19")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "strb wzr, [x21, x20]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "b L_module_graph_read_file_return")
    out = asm_label(out, "L_module_graph_read_file_regular")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_mode_r")
    out = asm_line(out, "bl " + asm_call_name(target, "fopen"))
    out = asm_line(out, "cbz x0, L_module_graph_read_file_fail")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "mov x2, #2")
    out = asm_line(out, "bl " + asm_call_name(target, "fseek"))
    out = asm_line(out, "cbnz w0, L_module_graph_read_file_fail_close")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "ftell"))
    out = asm_line(out, "cmp x0, #0")
    out = asm_line(out, "b.lt L_module_graph_read_file_fail_close")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "mov x2, #0")
    out = asm_line(out, "bl " + asm_call_name(target, "fseek"))
    out = asm_line(out, "cbnz w0, L_module_graph_read_file_fail_close")
    out = asm_line(out, "add x0, x20, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_module_graph_read_file_fail_close")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x1, #1")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "mov x3, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fread"))
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "strb wzr, [x21, x22]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "b L_module_graph_read_file_return")
    out = asm_label(out, "L_module_graph_read_file_fail_close")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_label(out, "L_module_graph_read_file_fail")
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "mov x1, #0")
    out = asm_label(out, "L_module_graph_read_file_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # x0=line, x1=len. Returns module-name pointer/length or zero/zero.
    out = asm_label(out, "L_module_graph_import_span")
    out = asm_line(out, "cmp x1, #7")
    out = asm_line(out, "b.lo L_module_graph_import_span_from")
    out = asm_line(out, "ldrb w9, [x0]")
    out = asm_line(out, "cmp w9, #105")
    out = asm_line(out, "b.ne L_module_graph_import_span_from")
