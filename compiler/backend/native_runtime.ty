    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")
    return out

def emit_native_runtime_direct_optional_extension_suffix(out, target):
    out = asm_addr(out, target, "x9", "L_cli_extension_mode")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #2")
    out = asm_line(out, "b.ne L_native_runtime_direct_append_extension_mode_ready")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_extension_count")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cbnz x10, L_native_runtime_direct_append_extension_mode_ready")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_extension_required")
    out = asm_line(out, "bl " + asm_call_name(target, "puts"))
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "b L_native_runtime_direct_program_dispose_both_fail")
    out = asm_label(out, "L_native_runtime_direct_append_extension_mode_ready")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_extension_count")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cbnz x10, L_native_runtime_direct_append_extension_needed")
    out = asm_addr(out, target, "x9", "L_cli_dynamic_extension_mode")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cbz x10, L_native_runtime_direct_append_extension_done")
    out = asm_label(out, "L_native_runtime_direct_append_extension_needed")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_native_runtime_direct_append_extension_runtime")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_program_dispose_both_fail")
    out = asm_label(out, "L_native_runtime_direct_append_extension_done")
    return out

def emit_native_runtime_direct_statement_runtime(out, target):

    # x0=handle, x1=reverse kind-110 link, x2=text builder, x3=data builder,
    # x4=enclosing while statement index or -1, x5=function record or -1.
    out = asm_label(out, "L_native_runtime_direct_emit_statements")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "str x1, [sp, #64]")
    out = asm_line(out, "str x4, [sp, #80]")
    out = asm_line(out, "str x5, [sp, #88]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #96]")
    out = asm_line(out, "mov x23, #0")
    out = asm_line(out, "mov x24, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_count")
    out = asm_line(out, "cmp x20, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statements_allocate")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statements_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statements_unsupported")
    out = asm_line(out, "add x24, x24, #1")
    out = asm_line(out, "ldr x20, [x9, #32]")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_count")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_allocate")
    out = asm_line(out, "cbz x24, L_native_runtime_direct_emit_statements_ok")
    out = asm_line(out, "lsl x0, x24, #3")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_native_runtime_direct_emit_statements_fail")
    out = asm_line(out, "mov x23, x0")
    out = asm_line(out, "ldr x20, [sp, #64]")
    out = asm_line(out, "mov x9, x24")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_fill")
    out = asm_line(out, "cbz x9, L_native_runtime_direct_emit_statements_execute_begin")
    out = asm_line(out, "sub x9, x9, #1")
    out = asm_line(out, "str x20, [x23, x9, lsl #3]")
    out = asm_line(out, "ldr x10, [x19, #32]")
    out = asm_line(out, "add x10, x10, x20, lsl #6")
    out = asm_line(out, "ldr x20, [x10, #32]")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_fill")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_execute_begin")
    out = asm_line(out, "mov x20, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_execute")
    out = asm_line(out, "cmp x20, x24")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statements_cleanup_ok")
    out = asm_line(out, "ldr x9, [x23, x20, lsl #3]")
    out = asm_line(out, "ldr x10, [x19, #32]")
    out = asm_line(out, "add x9, x10, x9, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #110")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statements_cleanup_unsupported")
    out = asm_line(out, "ldr x0, [sp, #96]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statements_cleanup_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_stmt")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statements_cleanup_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_index")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statements_cleanup_fail")
    out = asm_line(out, "ldr x9, [x23, x20, lsl #3]")
    out = asm_line(out, "ldr x10, [x19, #32]")
    out = asm_line(out, "add x9, x10, x9, lsl #6")
    out = asm_addr(out, target, "x10", "L_native_runtime_direct_diag_stmt")
    out = asm_line(out, "str x20, [x10]")
    out = asm_addr(out, target, "x10", "L_native_runtime_direct_diag_has_arg")
    out = asm_line(out, "str xzr, [x10]")
    out = asm_addr(out, target, "x10", "L_native_runtime_direct_diag_nested_arg_index")
    out = asm_line(out, "mov x11, #-1")
    out = asm_line(out, "str x11, [x10]")
    out = asm_addr(out, target, "x10", "L_native_runtime_direct_diag_edge_kind")
    out = asm_line(out, "str xzr, [x10]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x9, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "ldr x4, [sp, #80]")
    out = asm_line(out, "ldr x5, [sp, #88]")
    out = asm_line(out, "bl L_native_runtime_direct_emit_statement")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statements_cleanup_result")
    out = asm_line(out, "add x20, x20, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_execute")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_cleanup_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_cleanup_result")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_cleanup_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_cleanup_result")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_cleanup_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_cleanup_result")
    out = asm_line(out, "str w0, [sp, #72]")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "ldr w0, [sp, #72]")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_return")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_return")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_unsupported")
    out = asm_line(out, "mov w0, #2")
    out = asm_line(out, "b L_native_runtime_direct_emit_statements_return")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_statements_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # Render canonical scalar assignments, structured control flow, loop
    # signals, and print expression statements. x4 is the loop context.
    out = asm_label(out, "L_native_runtime_direct_emit_statement")
    out = asm_line(out, "stp x29, x30, [sp, #-176]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "str x23, [sp, #48]")
    out = asm_line(out, "str x24, [sp, #56]")
    out = asm_line(out, "stp x25, x26, [sp, #96]")
    out = asm_line(out, "str x5, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x24, x4")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #120]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #100")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_assign")
    out = asm_line(out, "cmp x9, #103")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_if")
    out = asm_line(out, "cmp x9, #104")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_while")
    out = asm_line(out, "cmp x9, #105")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_break")
    out = asm_line(out, "cmp x9, #106")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_continue")
    out = asm_line(out, "cmp x9, #101")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_return_value")
    out = asm_line(out, "cmp x9, #107")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_definition")
    out = asm_line(out, "cmp x9, #108")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_for")
    out = asm_line(out, "cmp x9, #116")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_with")
    out = asm_line(out, "cmp x9, #109")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_raise")
    out = asm_line(out, "cmp x9, #117")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_try")
    out = asm_line(out, "cmp x9, #119")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_yield")
    out = asm_line(out, "cmp x9, #120")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_definition")
    out = asm_line(out, "cmp x9, #102")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x20, [x23, #24]")
    out = asm_line(out, "str x20, [sp, #72]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x23, x9, x20, lsl #6")
    out = asm_line(out, "ldr x9, [x23]")
    out = asm_line(out, "cmp x9, #6")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x20, [x23, #24]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_expression")
    out = asm_line(out, "ldr x1, [x9, #40]")
    out = asm_line(out, "ldr x0, [x19, #16]")
    out = asm_line(out, "bl L_native_token_record_at")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_emit_statement_unsupported")
    out = asm_line(out, "ldr x9, [x0, #16]")
    out = asm_line(out, "cmp x9, #5")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_expression")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_print")
    out = asm_line(out, "mov x2, #5")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_emit_statement_expression")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_arg_next")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_diag_nested_arg_index")
    out = asm_line(out, "mov x10, #-1")
    out = asm_line(out, "str x10, [x9]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_arguments")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_return")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #32]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "bl L_native_runtime_direct_emit_argument_values")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_write_newline")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_emit_statement_return")

    out = asm_label(out, "L_native_runtime_direct_emit_statement_expression")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [sp, #72]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "b L_native_runtime_direct_emit_statement_return")

    out = asm_label(out, "L_native_runtime_direct_emit_statement_yield")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_current_generator")
    out = asm_line(out, "ldr x25, [x9]")
    out = asm_line(out, "cmp x25, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_statement_yield_context")
    out = asm_line(out, "ldr x0, [sp, #120]")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_restore")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_addr(out, target, "x0", "L_native_runtime_direct_diag_path_value")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x22")
    out = asm_line(out, "bl L_native_runtime_direct_emit_expression")
    out = asm_line(out, "cmp w0, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_statement_return")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_yield_a")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "ldr x1, [x23, #24]")
    out = asm_line(out, "lsl x1, x1, #7")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_yield_b")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_yield_c")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_addr(out, target, "x1", "L_native_runtime_direct_generator_yield_d")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_emit_statement_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl L_native_text_builder_append_u64")
