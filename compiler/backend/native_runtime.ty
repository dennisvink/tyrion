    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_11")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_12")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_12")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_14")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_14")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", "L_native_pratt_op_13")
    asm_line(out, "bl " + asm_call_name(target, "strcmp"))
    asm_line(out, "cbz w0, L_native_pratt_bp_13")
    asm_line(out, "mov x0, x19")
