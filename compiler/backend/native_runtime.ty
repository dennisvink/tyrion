    out = asm_cstr(out, "L_err_native_read_module_graph", "error: native module graph load failed")
    out = asm_cstr(out, "L_native_module_cycle_failed", "module-graph rejected code=cycle;path=")
    out = asm_cstr(out, "L_native_module_duplicate_failed", "module-graph rejected code=duplicate-symbol;path=")
    out = asm_cstr(out, "L_module_graph_builtin_core_path", "@tyrion/core")
    out = asm_cstr(out, "L_module_graph_builtin_core_source", builtin_module_core_source())
    out = asm_cstr(out, "L_module_graph_builtin_http_path", "@tyrion/http")
    out = asm_cstr(out, "L_module_graph_builtin_http_source", builtin_module_http_source())
    out = asm_line(out, ".p2align 2")
    return out

def emit_native_ast_handle_lifetime_runtime(out, target):
    handle_magic_x0 = generated_ast_handle_magic_mem("x0")
    handle_refcount_x0 = generated_ast_handle_refcount_mem("x0")
    handle_magic_x19 = generated_ast_handle_magic_mem("x19")
    handle_refcount_x19 = generated_ast_handle_refcount_mem("x19")
    handle_token_owner_x19 = generated_ast_handle_token_owner_mem("x19")
    handle_records_owner_x19 = generated_ast_handle_records_owner_mem("x19")
    handle_record_count_x19 = generated_ast_handle_record_count_mem("x19")
    handle_flags_x19 = generated_ast_handle_flags_mem("x19")
    handle_parent_x19 = generated_ast_handle_parent_mem("x19")
    handle_magic_x21 = generated_ast_handle_magic_mem("x21")
    handle_refcount_x21 = generated_ast_handle_refcount_mem("x21")
    handle_token_owner_x21 = generated_ast_handle_token_owner_mem("x21")
    handle_records_owner_x21 = generated_ast_handle_records_owner_mem("x21")
    handle_records_x21 = generated_ast_handle_records_mem("x21")
    handle_record_count_x21 = generated_ast_handle_record_count_mem("x21")
    handle_record_capacity_x21 = generated_ast_handle_record_capacity_mem("x21")
    handle_root_x21 = generated_ast_handle_root_mem("x21")
    handle_flags_x21 = generated_ast_handle_flags_mem("x21")
    handle_parent_x21 = generated_ast_handle_parent_mem("x21")
    out = asm_label(out, "L_native_ast_handle_retain")
    out = asm_line(out, "cbz x0, L_native_ast_handle_retain_fail")
    out = asm_line(out, "ldrb w9, " + handle_magic_x0)
    out = asm_line(out, "cmp w9, #170")
    out = asm_line(out, "b.ne L_native_ast_handle_retain_fail")
    out = asm_line(out, "ldr x9, " + handle_refcount_x0)
    out = asm_line(out, "adds x9, x9, #1")
    out = asm_line(out, "b.cs L_native_ast_handle_retain_fail")
    out = asm_line(out, "str x9, " + handle_refcount_x0)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, "L_native_ast_handle_retain_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")

    # x0=owner handle, x1=record index -> x0=owned child-root view. The view
    # retains its parent and never owns or duplicates the shared arena bytes.
    out = asm_label(out, "L_native_ast_handle_view")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, L_native_ast_handle_view_fail")
    out = asm_line(out, "ldrb w9, " + handle_magic_x19)
    out = asm_line(out, "cmp w9, #170")
    out = asm_line(out, "b.ne L_native_ast_handle_view_fail")
    out = asm_line(out, "ldr x9, " + handle_record_count_x19)
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_ast_handle_view_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_handle_retain")
    out = asm_line(out, "cbz w0, L_native_ast_handle_view_fail")
    out = asm_line(out, "mov x0, #80")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "cbz x21, L_native_ast_handle_view_release")
    out = asm_line(out, "mov w9, #170")
    out = asm_line(out, "strb w9, " + handle_magic_x21)
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "str x9, " + handle_refcount_x21)
    out = asm_line(out, "ldr x9, " + handle_token_owner_x19)
    out = asm_line(out, "str x9, " + handle_token_owner_x21)
    out = asm_line(out, "ldp x9, x10, " + handle_records_owner_x19)
    out = asm_line(out, "stp x9, x10, " + handle_records_owner_x21)
    out = asm_line(out, "ldp x9, x10, " + handle_record_count_x19)
    out = asm_line(out, "stp x9, x10, " + handle_record_count_x21)
    out = asm_line(out, "str x20, " + handle_root_x21)
    # Projection and sequence bits 56..63 describe the current view, not the
    # shared arena. Child views inherit only low parser metadata; specialized
    # constructors below add their own high-byte selector/projection flags.
    # Copying the high byte made a child call record of a lambda retain the
    # synthetic-lambda bit and route `child[\"body\"]` through lambda decoding.
    out = asm_line(out, "ldr x9, " + handle_flags_x19)
    out = asm_line(out, "lsl x9, x9, #8")
    out = asm_line(out, "lsr x9, x9, #8")
    out = asm_line(out, "str x9, " + handle_flags_x21)
    out = asm_line(out, "str x19, " + handle_parent_x21)
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "b L_native_ast_handle_view_return")
    out = asm_label(out, "L_native_ast_handle_view_release")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_native_ast_handle_release")
    out = asm_label(out, "L_native_ast_handle_view_fail")
    out = asm_line(out, "mov x0, #0")
    out = asm_label(out, "L_native_ast_handle_view_return")
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # x0=owner handle, x1=token index -> x0=owned synthetic kind-1 leaf view.
    # Simple assignment targets are stored canonically as token indices rather
    # than arena-record indices. Keep that parser layout and expose the target
    # through the same AST-handle API by carrying one synthetic record after
    # the 80-byte handle header. Flag bit 62 distinguishes this view; bit 63
    # remains reserved for sequence views.
    out = asm_label(out, "L_native_ast_handle_token_leaf_view")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, L_native_ast_handle_token_leaf_view_fail")
    out = asm_line(out, "ldrb w9, " + handle_magic_x19)
    out = asm_line(out, "cmp w9, #170")
    out = asm_line(out, "b.ne L_native_ast_handle_token_leaf_view_fail")
    out = asm_line(out, "mov x0, x19")
