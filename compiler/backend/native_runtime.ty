    out = asm_label(out, "L_native_ast_field_comprehension_project_expr")
    out = asm_line(out, "ldr x9, [x26, #40]")
    out = asm_line(out, "cmp x9, #1")
    out = asm_line(out, "b.ne L_native_ast_field_write_none_view")
    out = asm_line(out, "ldr x24, [x22, #24]")
    out = asm_line(out, "b L_native_ast_field_write_child")
    out = asm_label(out, "L_native_ast_field_comprehension_project_key")
