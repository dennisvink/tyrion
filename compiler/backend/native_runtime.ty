def emit_native_runtime_direct_data_strings(out, target):
    text = "# tyrion-app-component: strings\n" + native_runtime_direct_strings_text()
    return asm_cstr(out, "L_native_runtime_direct_string_suffix", runtime_native_target_asm_text(text, target))

