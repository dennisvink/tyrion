def emit_native_runtime_direct_general_builtin_runtime(out, target):

    # x0=AST handle, x1=call AST, x2=text builder, x3=data builder,
    # x4=operation ID. Up to eight argument expressions are evaluated in
    # source order and copied into a temporary contiguous value vector in the
    # generated application. This is an ABI bridge, not a source-shape route.
    out = asm_label(out, "L_native_runtime_direct_emit_general_builtin")
    out = asm_line(out, "stp x29, x30, [sp, #-256]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "mov x25, x4")
    out = asm_line(out, "bl L_native_runtime_direct_diag_path_mark")
    out = asm_line(out, "str x0, [sp, #152]")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_general_builtin_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x20, lsl #6")
    out = asm_line(out, "ldr x24, [x9, #32]")
    out = asm_line(out, "mov x26, #0")
    out = asm_label(out, "L_native_runtime_direct_emit_general_builtin_collect")
    out = asm_line(out, "cmp x24, #-1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_general_builtin_validate")
    out = asm_line(out, "cmp x26, #8")
    out = asm_line(out, "b.lo L_native_runtime_direct_emit_general_builtin_collect_record")
    out = asm_line(out, "cmp x25, #1")
    out = asm_line(out, "b.eq L_native_runtime_direct_emit_general_builtin_range_arity")
    out = asm_line(out, "b L_native_runtime_direct_emit_general_builtin_unsupported")
    out = asm_label(out, "L_native_runtime_direct_emit_general_builtin_collect_record")
    out = asm_line(out, "ldr x9, [x19, #40]")
    out = asm_line(out, "cmp x24, x9")
    out = asm_line(out, "b.hs L_native_runtime_direct_emit_general_builtin_unsupported")
    out = asm_line(out, "ldr x9, [x19, #32]")
    out = asm_line(out, "add x9, x9, x24, lsl #6")
    out = asm_line(out, "ldr x10, [x9]")
    out = asm_line(out, "cmp x10, #8")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_general_builtin_unsupported")
    out = asm_line(out, "cmp x25, #1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_general_builtin_collect_value")
    out = asm_line(out, "ldr x10, [x9, #48]")
    out = asm_line(out, "cmp x10, #-1")
    out = asm_line(out, "b.ne L_native_runtime_direct_emit_general_builtin_range_keyword")
    out = asm_label(out, "L_native_runtime_direct_emit_general_builtin_collect_value")
    out = asm_line(out, "ldr x10, [x9, #24]")
    out = asm_line(out, "add x11, sp, #80")
    out = asm_line(out, "str x10, [x11, x26, lsl #3]")
    out = asm_line(out, "add x26, x26, #1")
    out = asm_line(out, "ldr x24, [x9, #32]")
    out = asm_line(out, "b L_native_runtime_direct_emit_general_builtin_collect")
