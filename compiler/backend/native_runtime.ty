    out = asm_line(out, "cmp x9, x22")
    out = asm_line(out, "b.ne L_native_runtime_direct_find_class_method_loop")
    out = asm_line(out, "ldr x0, [x0, #8]")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "mov x2, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
    out = asm_line(out, "cbnz w0, L_native_runtime_direct_find_class_method_loop")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "mov w0, #1")
