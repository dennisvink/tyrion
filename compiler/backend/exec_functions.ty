def emit_exec_fn_generic_source_argument_copy(out, target, name, idx):
    value_tag_x10 = generated_value_tag_mem("x10")
    value_tag_x11 = generated_value_tag_mem("x11")

    name_offset = idx * 128
    arg_offset = 3904 + (idx * 8)
    param_ordinal_text = decimal_text(idx)
    copy_label = "L_gsf_copy_slot_" + name + "_" + param_ordinal_text
    raw_label = "L_gsf_copy_raw_" + name + "_" + param_ordinal_text
    copy_done = "L_gsf_copy_done_" + name + "_" + param_ordinal_text
    raw_num_check = "L_gsf_raw_num_check_" + name + "_" + param_ordinal_text
    raw_num_first = "L_gsf_raw_num_first_" + name + "_" + param_ordinal_text
    raw_num_loop = "L_gsf_raw_num_loop_" + name + "_" + param_ordinal_text
