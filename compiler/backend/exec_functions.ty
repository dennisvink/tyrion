    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    out = asm_line(out, "mov x0, x24")
    out = asm_addr(out, target, "x1", exec_label + "_asm_suffix")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "str x24, [sp, #256]")
    out = asm_line(out, "add x9, x26, #10")
    out = asm_line(out, "str x9, [sp, #264]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, [sp, #383]")
    out = asm_line(out, "add x0, sp, #256")
    out = asm_line(out, "add x1, sp, #128")
    out = asm_line(out, "bl L_native_write_text_file")
    out = asm_line(out, "cbz w0, " + exec_label + "_fail")
