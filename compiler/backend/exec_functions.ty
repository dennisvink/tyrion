# compiler / backend / exec functions: responsibility-owned canonical compiler module.

def emit_exec_fn_native_read_text_file(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "b L_native_read_text_file")
    return out

def emit_exec_fn_native_read_module_graph(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "b L_native_read_module_graph")
    return out

def emit_exec_fn_native_tcp(out, target, name, primitive):
    exec_label = lowered_function_label("L_exec_fn_", name)
    out = asm_label(out, exec_label)
    out = asm_line(out, "b L_native_tcp_" + primitive)
    return out

def emit_exec_fn_native_asm_writer(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "b L_" + name)
    return out

def emit_exec_fn_read_file(out, target, fn):
    out = asm_label(out, fn["exec_label"])
    if not fn["body_plan"]["shape_ok"]:
        out = asm_line(out, "mov w0, #0")
        out = asm_line(out, "ret")
        return out
    out = asm_line(out, "b L_native_read_text_file")
    return out

def emit_exec_fn_make_asm_path(out, target, name):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")

    exec_label = lowered_function_label("L_exec_fn_", name)
    out = asm_label(out, exec_label)
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "mov x19, x1")
    out = asm_line(out, "cbz x20, " + exec_label + "_fail")
    out = asm_line(out, "cbz x19, " + exec_label + "_fail")
    out = asm_line(out, "ldrb w9, " + value_tag_x20)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq " + exec_label + "_heap")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq " + exec_label + "_heap")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.ne " + exec_label + "_source_ready")
    out = asm_label(out, exec_label + "_heap")
    out = asm_line(out, "ldr x20, [x20]")
    out = asm_line(out, "cbz x20, " + exec_label + "_fail")
    out = asm_label(out, exec_label + "_source_ready")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_string_copy")
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", "L_make_asm_path_suffix")
    out = asm_line(out, "bl L_string_append")
    out = asm_line(out, "mov w9, #1")
    out = asm_line(out, "strb w9, " + value_tag_x19)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b " + exec_label + "_return")
    out = asm_label(out, exec_label + "_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, exec_label + "_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")
    return out

def emit_exec_fn_native_len(out, target, name):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")

    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-80]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, x1")
    asm_line(out, "cbz x19, " + exec_label + "_fail")
    asm_line(out, "cbz x20, " + exec_label + "_fail")
    asm_line(out, "mov x11, #1")
    asm_line(out, "lsl x11, x11, #32")
    asm_line(out, "cmp x19, x11")
    asm_line(out, "b.lo " + exec_label + "_fail")
    asm_line(out, "ldrb w14, " + value_tag_x19)
    asm_line(out, "cbz w14, " + exec_label + "_raw_string")
    asm_line(out, "cmp w14, #16")
    asm_line(out, "b.hi " + exec_label + "_raw_bar_payload")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x14")
    asm_line(out, "bl L_collection_len_payload")
    asm_line(out, "cbz w1, " + exec_label + "_fail")
    asm_line(out, "b " + exec_label + "_write")
    asm_label(out, exec_label + "_raw_bar_payload")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, #5")
    asm_line(out, "bl L_collection_len_payload")
    asm_line(out, "cbz w1, " + exec_label + "_fail")
    asm_line(out, "b " + exec_label + "_write")
    asm_label(out, exec_label + "_raw_string")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl " + asm_call_name(target, "strlen"))
    asm_line(out, "mov w1, #1")
    asm_line(out, "b " + exec_label + "_write")
    asm_label(out, exec_label + "_write")
    asm_line(out, "mov x24, x0")
    asm_line(out, "mov x26, x20")
    asm_line(out, "bl L_write_uint_x24")
    asm_line(out, "cbz w9, " + exec_label + "_fail")
    asm_line(out, "mov w9, #2")
    asm_line(out, "strb w9, " + value_tag_x20)
    asm_line(out, "mov w0, w9")
    asm_label(out, exec_label + "_return")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #80")
    asm_line(out, "ret")

    asm_label(out, exec_label + "_fail")
    if target["backend"] == "darwin-aarch64":
        asm_line(out, "mov x0, x19")
        asm_line(out, "bl L_print_u64_decimal_line")
        asm_line(out, "mov x11, #1")
        asm_line(out, "lsl x11, x11, #32")
        asm_line(out, "cmp x19, x11")
        asm_line(out, "b.lo " + exec_label + "_fail_no_tag_print")
        asm_line(out, "ldrb w0, " + value_tag_x19)
        asm_line(out, "bl L_print_u64_decimal_line")
        asm_label(out, exec_label + "_fail_no_tag_print")
    asm_line(out, "mov w0, #0")
    asm_line(out, "b " + exec_label + "_return")
    return out

def emit_exec_fn_native_write_text_file(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "b L_native_write_text_file")
    return out

def emit_exec_fn_native_run_tool(out, target, name):
    value_tag_x23 = generated_value_tag_mem("x23")

    exec_label = lowered_function_label("L_exec_fn_", name)
    system_call = asm_call_name(target, "system")
    out = asm_label(out, exec_label)
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "stp x25, x26, [sp, #64]")
    out = asm_line(out, "stp x27, x28, [sp, #80]")
    out = asm_line(out, "sub sp, sp, #4096")
    out = asm_line(out, "str x0, [sp]")
    out = asm_line(out, "str x1, [sp, #8]")
    out = asm_line(out, "str x2, [sp, #16]")
    out = asm_line(out, "str x3, [sp, #24]")
    out = asm_line(out, "mov x23, x4")
    out = asm_line(out, "cbz x23, " + exec_label + "_abi_fail")

    # Resolve all four typed string arguments before constructing the command.
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x24, x1")
    out = asm_line(out, "ldr x0, [sp, #8]")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "mov x25, x1")
    out = asm_line(out, "ldr x0, [sp, #16]")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x26, x1")
    out = asm_line(out, "ldr x0, [sp, #24]")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "mov x27, x1")

    # Four quoted arguments, three separators, and the trailing NUL must fit in
    # the bounded stack buffer. Apostrophes and line breaks are rejected below.
    out = asm_line(out, "add x9, x24, x25")
    out = asm_line(out, "adds x9, x9, x26")
    out = asm_line(out, "b.cs " + exec_label + "_abi_fail")
    out = asm_line(out, "adds x9, x9, x27")
    out = asm_line(out, "b.cs " + exec_label + "_abi_fail")
    out = asm_line(out, "add x9, x9, #12")
    out = asm_line(out, "cmp x9, #4032")
    out = asm_line(out, "b.hi " + exec_label + "_abi_fail")

    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl " + exec_label + "_validate")
    out = asm_line(out, "cbz w0, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl " + exec_label + "_validate")
    out = asm_line(out, "cbz w0, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "bl " + exec_label + "_validate")
    out = asm_line(out, "cbz w0, " + exec_label + "_abi_fail")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "mov x1, x27")
    out = asm_line(out, "bl " + exec_label + "_validate")
    out = asm_line(out, "cbz w0, " + exec_label + "_abi_fail")

    out = asm_line(out, "add x28, sp, #64")
    out = asm_line(out, "mov x9, x28")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl " + exec_label + "_append")
    out = asm_line(out, "mov x9, x0")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "mov x1, x25")
    out = asm_line(out, "bl " + exec_label + "_append")
    out = asm_line(out, "mov x9, x0")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x26")
    out = asm_line(out, "bl " + exec_label + "_append")
    out = asm_line(out, "mov x9, x0")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "mov x1, x27")
    out = asm_line(out, "bl " + exec_label + "_append_last")
    out = asm_line(out, "mov x0, x28")
    out = asm_line(out, "bl " + system_call)
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "cbnz w19, " + exec_label + "_false")
    out = asm_line(out, "mov w9, #84")
    out = asm_line(out, "strb w9, [x23]")
    out = asm_line(out, "mov w9, #114")
    out = asm_line(out, "strb w9, [x23, #1]")
    out = asm_line(out, "mov w9, #117")
    out = asm_line(out, "strb w9, [x23, #2]")
    out = asm_line(out, "mov w9, #101")
    out = asm_line(out, "strb w9, [x23, #3]")
    out = asm_line(out, "b " + exec_label + "_tag")
    out = asm_label(out, exec_label + "_false")
    out = asm_line(out, "mov w9, #70")
    out = asm_line(out, "strb w9, [x23]")
    out = asm_line(out, "mov w9, #97")
    out = asm_line(out, "strb w9, [x23, #1]")
    out = asm_line(out, "mov w9, #108")
    out = asm_line(out, "strb w9, [x23, #2]")
    out = asm_line(out, "mov w9, #115")
    out = asm_line(out, "strb w9, [x23, #3]")
    out = asm_line(out, "mov w9, #101")
    out = asm_line(out, "strb w9, [x23, #4]")
    out = asm_label(out, exec_label + "_tag")
    out = asm_line(out, "mov w9, #3")
    out = asm_line(out, "strb w9, " + value_tag_x23)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b " + exec_label + "_return")
    out = asm_label(out, exec_label + "_abi_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, exec_label + "_return")
    out = asm_line(out, "add sp, sp, #4096")
    out = asm_line(out, "ldp x27, x28, [sp, #80]")
    out = asm_line(out, "ldp x25, x26, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #112")
    out = asm_line(out, "ret")

    # x0=bytes, x1=len -> w0=valid shell-safe compiler argument.
    out = asm_label(out, exec_label + "_validate")
    out = asm_line(out, "mov x9, #0")
    out = asm_label(out, exec_label + "_validate_loop")
    out = asm_line(out, "cmp x9, x1")
    out = asm_line(out, "b.hs " + exec_label + "_validate_ok")
    out = asm_line(out, "ldrb w10, [x0, x9]")
    out = asm_line(out, "cmp w10, #39")
    out = asm_line(out, "b.eq " + exec_label + "_validate_fail")
    out = asm_line(out, "cmp w10, #10")
    out = asm_line(out, "b.eq " + exec_label + "_validate_fail")
    out = asm_line(out, "cmp w10, #13")
    out = asm_line(out, "b.eq " + exec_label + "_validate_fail")
    out = asm_line(out, "add x9, x9, #1")
    out = asm_line(out, "b " + exec_label + "_validate_loop")
    out = asm_label(out, exec_label + "_validate_ok")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "ret")
    out = asm_label(out, exec_label + "_validate_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")

    # x0=bytes, x1=len, x9=cursor -> x0=new cursor. Arguments are quoted and
    # separated; the last variant terminates instead of appending a separator.
    out = asm_label(out, exec_label + "_append")
    out = asm_line(out, "mov w10, #39")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "mov x11, #0")
    out = asm_label(out, exec_label + "_append_copy")
    out = asm_line(out, "cmp x11, x1")
    out = asm_line(out, "b.hs " + exec_label + "_append_close")
    out = asm_line(out, "ldrb w10, [x0, x11]")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "b " + exec_label + "_append_copy")
    out = asm_label(out, exec_label + "_append_close")
    out = asm_line(out, "mov w10, #39")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "mov w10, #32")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "mov x0, x9")
    out = asm_line(out, "ret")
    out = asm_label(out, exec_label + "_append_last")
    out = asm_line(out, "mov w10, #39")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "mov x11, #0")
    out = asm_label(out, exec_label + "_append_last_copy")
    out = asm_line(out, "cmp x11, x1")
    out = asm_line(out, "b.hs " + exec_label + "_append_last_close")
    out = asm_line(out, "ldrb w10, [x0, x11]")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "add x11, x11, #1")
    out = asm_line(out, "b " + exec_label + "_append_last_copy")
    out = asm_label(out, exec_label + "_append_last_close")
    out = asm_line(out, "mov w10, #39")
    out = asm_line(out, "strb w10, [x9], #1")
    out = asm_line(out, "strb wzr, [x9]")
    out = asm_line(out, "mov x0, x9")
    out = asm_line(out, "ret")
    return out

def emit_exec_fn_runtime_native_direct_source(out, target):
    # Raw ABI: x0=source value slot, x1=result slot. A successful unsupported
    # shape returns none; a selected shape returns generated assembly text.
    out = asm_label(out, "L_native_runtime_direct_source")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "sub sp, sp, #128")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, #0")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_extension_count")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_addr(out, target, "x9", "L_native_runtime_direct_extension_source_count")
    out = asm_line(out, "str xzr, [x9]")
    out = asm_line(out, "mov x0, sp")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "cbz x19, L_native_runtime_direct_source_fail")
    out = asm_line(out, "cbz x20, L_native_runtime_direct_source_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, L_native_runtime_direct_source_fail")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, sp")
    out = asm_line(out, "bl L_exec_fn_lex")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_source_unsupported")
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "bl L_native_parse_program_to_handle")
    out = asm_line(out, "cbnz x0, L_native_runtime_direct_source_parsed")
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "bl L_native_parse_report_failure")
    out = asm_line(out, "mov w22, #0")
    out = asm_line(out, "b L_native_runtime_direct_source_fail")
    out = asm_label(out, "L_native_runtime_direct_source_parsed")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "bl L_native_runtime_direct_program")
    out = asm_line(out, "cbz w0, L_native_runtime_direct_source_fail")
    out = asm_line(out, "bl L_native_runtime_direct_report_diagnostic")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_native_ast_handle_release")
    out = asm_line(out, "mov x21, #0")
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_source_success")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "str xzr, [sp]")
    out = asm_label(out, "L_native_runtime_direct_source_success")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_native_runtime_direct_source_return")
    out = asm_label(out, "L_native_runtime_direct_source_unsupported")
    out = asm_line(out, "mov w22, #1")
    out = asm_line(out, "b L_native_runtime_direct_source_fail")
    out = asm_label(out, "L_native_runtime_direct_source_fail")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_source_fail_tokens")
    out = asm_line(out, "bl L_native_ast_handle_release")
    out = asm_label(out, "L_native_runtime_direct_source_fail_tokens")
    out = asm_line(out, "ldr x0, [sp]")
    out = asm_line(out, "cbz x0, L_native_runtime_direct_source_fail_done")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "L_native_runtime_direct_source_fail_done")
    out = asm_line(out, "mov w0, w22")
    out = asm_label(out, "L_native_runtime_direct_source_return")
    out = asm_line(out, "add sp, sp, #128")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    return out

def emit_exec_fn_runtime_native_program_build_direct(out, target, fn):
    value_tag_x22 = generated_value_tag_mem("x22")

    name = fn["name"]
    exec_label = lowered_function_label("L_exec_fn_", name)
    out = asm_label(out, exec_label)
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
