    out = asm_line(out, "mov x23, x20")
    out = asm_line(out, "ldrb w9, " + value_tag_x23)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_text_heap")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_text_heap")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_text_heap")
    out = asm_line(out, "b " + fn["exec_label"] + "_text_ready")
    out = asm_label(out, fn["exec_label"] + "_text_heap")
    out = asm_line(out, "ldr x23, [x23]")
    out = asm_label(out, fn["exec_label"] + "_text_ready")
    out = asm_line(out, "cbz x23, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "mov x0, x23")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "add x24, x24, x0")
    out = asm_line(out, "add x24, x24, #" + str(len(plan["prefix"]) + len(plan["suffix"]) + 1))
    out = asm_line(out, "mov x0, x24")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "str x0, [x21]")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    if len(plan["prefix"]) > 0:
        out = asm_line(out, "ldr x0, [x21]")
        out = asm_addr(out, target, "x1", prefix_label)
        out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "ldr x0, [x21]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    if len(plan["suffix"]) > 0:
        out = asm_line(out, "ldr x0, [x21]")
        out = asm_addr(out, target, "x1", suffix_label)
        out = asm_line(out, "bl " + asm_call_name(target, "strcat"))
    out = asm_line(out, "ldr x0, [x21]")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "str x0, [x21, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, " + value_tag_x21)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b " + fn["exec_label"] + "_return")
    out = asm_label(out, fn["exec_label"] + "_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, fn["exec_label"] + "_return")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")
    out = asm_label(out, prefix_label)
    out = asm_line(out, ".asciz \"" + asm_escape_string(plan["prefix"]) + "\"")
    out = asm_line(out, ".p2align 2")
    out = asm_label(out, suffix_label)
    out = asm_line(out, ".asciz \"" + asm_escape_string(plan["suffix"]) + "\"")
    out = asm_line(out, ".p2align 2")
    return out

def emit_exec_fn_asm_addr(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    return_label = lowered_function_label(exec_label, "_return")
    adrp_label = lowered_function_label(exec_label, "_adrp")
    add_label = lowered_function_label(exec_label, "_add")
    comma_label = lowered_function_label(exec_label, "_comma")
    lo12_prefix_label = lowered_function_label(exec_label, "_lo12_prefix")
    branch_return = "b " + return_label
    strlen_symbol = asm_call_name(target, "strlen")
    strlen_call = lowered_function_label("bl ", strlen_symbol)
    darwin_format = name == "asm_darwin_addr" or target["backend"] == "darwin-aarch64"
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-16]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "sub sp, sp, #1424")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "stp x23, x24, [sp, #48]")
    asm_line(out, "stp x25, x26, [sp, #64]")
    asm_line(out, "stp x27, x28, [sp, #80]")
    asm_line(out, "mov x19, x0")
    if name == "asm_darwin_addr":
        asm_line(out, "mov x20, x1")
        asm_line(out, "mov x21, x2")
        asm_line(out, "mov x22, x3")
    else:
        asm_line(out, "mov x20, x2")
        asm_line(out, "mov x21, x3")
        asm_line(out, "mov x22, x4")
    asm_line(out, "mov x25, #0")
    asm_line(out, "cbz x19, " + exec_label + "_fail_args")
    asm_line(out, "cbz x20, " + exec_label + "_fail_args")
    asm_line(out, "cbz x21, " + exec_label + "_fail_args")
    asm_line(out, "cbz x22, " + exec_label + "_fail_args")
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, " + exec_label + "_fail_args")
    asm_line(out, "mov x20, x0")
    asm_line(out, "mov x0, x21")
    asm_line(out, "bl L_generated_value_string_ptr_len")
    asm_line(out, "cbz w2, " + exec_label + "_fail_args")
    asm_line(out, "mov x21, x0")
    asm_line(out, "add x23, sp, #128")
    asm_line(out, "add x24, sp, #256")
    asm_line(out, "add x27, sp, #1152")
    asm_line(out, "mov x0, x27")
    asm_line(out, "bl L_generated_value_zero_slot")
    if name == "asm_addr" and target["backend"] == "linux-x86_64":
        # asm_addr used to append canonical AArch64 text directly, bypassing
        # writer-owned target rendering. Keep one semantic representation and
        # lower each address-materialization line through the normal x86
        # renderer when this concrete writer targets Linux/x86-64.
        asm_line(out, "mov x0, x23")
        asm_line(out, "bl L_generated_value_zero_slot")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", adrp_label)
        asm_line(out, "bl L_string_copy")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x1, x20")
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", comma_label)
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x1, x21")
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, strlen_call)
        asm_line(out, "mov x1, x0")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x2, x24")
        asm_line(out, "bl L_native_runtime_x86_asm_line_fixed")
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x24")
        asm_line(out, "mov x2, x22")
        asm_line(out, "bl L_asm_writer_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, "bl L_generated_value_zero_slot")
        asm_line(out, "mov x0, x24")
        asm_line(out, "bl L_generated_value_zero_slot")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", add_label)
        asm_line(out, "bl L_string_copy")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x1, x20")
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", comma_label)
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x1, x20")
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", comma_label)
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", lo12_prefix_label)
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x1, x21")
        asm_line(out, "bl L_string_append")
        asm_line(out, "mov x0, x23")
        asm_line(out, strlen_call)
        asm_line(out, "mov x1, x0")
        asm_line(out, "mov x0, x23")
        asm_line(out, "mov x2, x24")
        asm_line(out, "bl L_native_runtime_x86_asm_line_fixed")
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x24")
        asm_line(out, "mov x2, x22")
        asm_line(out, "bl L_asm_writer_append")
        asm_line(out, branch_return)
    asm_line(out, "mov x0, x27")
    asm_addr(out, target, "x1", exec_label + "_newline")
    asm_line(out, "bl L_string_copy")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_adrp")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_comma")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x21")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_page_newline_add")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_comma")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_comma")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    if not darwin_format:
        asm_line(out, "mov x0, x19")
        asm_addr(out, target, "x1", exec_label + "_lo12_prefix")
        asm_line(out, "bl L_asm_writer_append_cstr")
        asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x21")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_addr(out, target, "x1", exec_label + "_pageoff")
    asm_line(out, "bl L_asm_writer_append_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail_append")
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x27")
    asm_line(out, "mov x2, x22")
    asm_line(out, "bl L_asm_writer_append")
    asm_line(out, "b " + exec_label + "_return")
    asm_label(out, exec_label + "_fail_args")
    asm_addr(out, target, "x0", exec_label + "_error_args")
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "b " + exec_label + "_fail")
    asm_label(out, exec_label + "_fail_alloc")
    asm_addr(out, target, "x0", exec_label + "_error_alloc")
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "b " + exec_label + "_fail")
    asm_label(out, exec_label + "_fail_format")
    asm_addr(out, target, "x0", exec_label + "_error_format")
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "b " + exec_label + "_fail")
    asm_label(out, exec_label + "_fail_append")
    asm_addr(out, target, "x0", exec_label + "_error_append")
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "b " + exec_label + "_fail")
    asm_label(out, exec_label + "_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, exec_label + "_return")
    asm_line(out, "mov x28, x0")
    asm_line(out, "mov x0, x25")
    asm_line(out, "cbz x0, " + exec_label + "_return_no_free")
    asm_line(out, "bl " + asm_call_name(target, "free"))
    asm_label(out, exec_label + "_return_no_free")
    asm_line(out, "mov x0, x28")
    asm_line(out, "ldp x27, x28, [sp, #80]")
    asm_line(out, "ldp x25, x26, [sp, #64]")
    asm_line(out, "ldp x23, x24, [sp, #48]")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "add sp, sp, #1424")
    asm_line(out, "ldp x29, x30, [sp], #16")
    asm_line(out, "ret")
    asm_cstr(out, exec_label + "_adrp", "    adrp ")
    asm_cstr(out, exec_label + "_add", "    add ")
    asm_cstr(out, exec_label + "_comma", ", ")
    if darwin_format:
        asm_cstr(out, exec_label + "_page_newline_add", "@PAGE\n    add ")
        asm_cstr(out, exec_label + "_lo12_prefix", "")
        asm_cstr(out, exec_label + "_pageoff", "@PAGEOFF")
    else:
        asm_cstr(out, exec_label + "_page_newline_add", "\n    add ")
        asm_cstr(out, exec_label + "_lo12_prefix", ":lo12:")
        asm_cstr(out, exec_label + "_pageoff", "")
    asm_cstr(out, exec_label + "_newline", "\n")
    asm_cstr(out, exec_label + "_error_args", "error: asm_addr invalid generated ABI arguments")
    asm_cstr(out, exec_label + "_error_alloc", "error: asm_addr formatting allocation failed")
    asm_cstr(out, exec_label + "_error_format", "error: asm_addr instruction formatting failed")
    asm_cstr(out, exec_label + "_error_append", "error: asm_addr writer append failed")
    asm_line(out, ".p2align 2")
    return out

def emit_exec_fn_asm_writer_format(out, target, name):
    has_prefix = 0
    suffix_kind = 0
    if name == "asm_line":
        has_prefix = 1
        suffix_kind = 1
    elif name == "asm_label":
        suffix_kind = 2
    elif name == "asm_dir":
        suffix_kind = 1
    elif name == "asm_raw":
        suffix_kind = 0
    elif name == "asm_section":
        suffix_kind = 1
    else:
        fail("unsupported asm writer format function: " + name)
    exec_label = lowered_function_label("L_exec_fn_", name)
    fail_label = lowered_function_label(exec_label, "_fail")
    return_label = lowered_function_label(exec_label, "_return")
    native_format_label = lowered_function_label(exec_label, "_native_format")
    prefix_label = lowered_function_label(exec_label, "_prefix")
    suffix_label = lowered_function_label(exec_label, "_suffix")
    cbz_x19_fail = lowered_function_label("cbz x19, ", fail_label)
    cbz_x20_fail = lowered_function_label("cbz x20, ", fail_label)
    cbz_x21_fail = lowered_function_label("cbz x21, ", fail_label)
    cbz_w0_fail = lowered_function_label("cbz w0, ", fail_label)
    cbz_w2_fail = lowered_function_label("cbz w2, ", fail_label)
    cbz_w9_native_format = lowered_function_label("cbz w9, ", native_format_label)
    branch_return = lowered_function_label("b ", return_label)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-16]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "sub sp, sp, #496")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "stp x23, x24, [sp, #48]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, x1")
    asm_line(out, "mov x21, x2")
    asm_line(out, "add x22, sp, #96")
    asm_line(out, "add x23, sp, #224")
    asm_line(out, "add x24, sp, #352")
    asm_line(out, cbz_x19_fail)
    asm_line(out, cbz_x20_fail)
    asm_line(out, cbz_x21_fail)
    asm_line(out, "mov x0, x22")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "mov x0, x23")
    asm_line(out, "bl L_generated_value_zero_slot")
    asm_line(out, "mov x0, x24")
    asm_line(out, "bl L_generated_value_zero_slot")
    if name == "asm_line" and target["backend"] == "linux-x86_64":
        # Fixed helper bodies must preserve the source asm_line contract. The
        # writer owns the backend mode; translate one semantic line only when
        # this concrete writer is producing a Linux/x86-64 artifact.
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x24")
        asm_line(out, "bl L_asm_writer_is_x86")
        asm_line(out, cbz_w0_fail)
        asm_line(out, "ldrb w9, [x24]")
        asm_line(out, cbz_w9_native_format)
        asm_line(out, "mov x0, x20")
        asm_line(out, "bl L_generated_value_string_ptr_len")
        asm_line(out, cbz_w2_fail)
        asm_line(out, "mov x2, x23")
        asm_line(out, "bl L_native_runtime_x86_asm_line_fixed")
        asm_line(out, cbz_w0_fail)
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x23")
        asm_line(out, "mov x2, x21")
        asm_line(out, "bl L_asm_writer_append")
        asm_line(out, branch_return)
        asm_label(out, native_format_label)
    if has_prefix == 1:
        asm_line(out, "mov x0, x23")
        asm_addr(out, target, "x1", prefix_label)
        asm_line(out, "bl L_string_copy")
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x23")
        asm_line(out, "mov x2, x22")
        asm_line(out, "bl L_asm_writer_append")
        asm_line(out, cbz_w0_fail)
    asm_line(out, "mov x0, x19")
    asm_line(out, "mov x1, x20")
    if suffix_kind == 0:
        asm_line(out, "mov x2, x21")
    else:
        asm_line(out, "mov x2, x22")
    asm_line(out, "bl L_asm_writer_append")
    asm_line(out, cbz_w0_fail)
    if suffix_kind != 0:
        asm_line(out, "mov x0, x24")
        asm_addr(out, target, "x1", suffix_label)
        asm_line(out, "bl L_string_copy")
        asm_line(out, "mov x0, x19")
        asm_line(out, "mov x1, x24")
        asm_line(out, "mov x2, x21")
        asm_line(out, "bl L_asm_writer_append")
        asm_line(out, branch_return)
    asm_line(out, branch_return)
    asm_label(out, fail_label)
    asm_line(out, "mov w0, #0")
    asm_label(out, return_label)
    asm_line(out, "ldp x23, x24, [sp, #48]")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "add sp, sp, #496")
    asm_line(out, "ldp x29, x30, [sp], #16")
    asm_line(out, "ret")
    if has_prefix == 1:
        asm_cstr(out, prefix_label, "    ")
    if suffix_kind == 1:
        asm_cstr(out, suffix_label, "\n")
    elif suffix_kind == 2:
        asm_cstr(out, suffix_label, ":\n")
    asm_line(out, ".p2align 2")
    return out

def emit_exec_fn_decimal_text(out, target, name):
    value_tag_x20 = generated_value_tag_mem("x20")

    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-64]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "mov x20, x1")
    asm_line(out, "cbz x19, " + exec_label + "_fail")
    asm_line(out, "cbz x20, " + exec_label + "_fail")
    asm_line(out, "mov x0, x19")
    asm_line(out, "bl L_generated_value_string_ptr_len")
