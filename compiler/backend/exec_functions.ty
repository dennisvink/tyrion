    asm_line(out, "mov w9, #1")
    asm_label(out, raw_num_tag)
    asm_line(out, "strb w9, " + value_tag_x10)
    asm_line(out, "b " + copy_done)
    asm_label(out, copy_label)
    # Typed helper arguments use the canonical value lifetime ABI. In
    # particular, persistent AST handles (tag 18) must be retained rather than
    # shallow-copied or reclassified as raw strings.
    asm_line(out, "mov x0, x10")
    asm_line(out, "mov x1, x11")
    asm_line(out, "bl L_generated_value_copy_slot")
    asm_line(out, "cbz w0, L_gsf_fail_" + name)
    asm_line(out, "b " + copy_done)
