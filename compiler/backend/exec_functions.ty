def emit_runtime_native_linux_aarch64_exact_branch(out, target, needle_label, branch_label):
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "mov x1, x21")
    out = asm_addr(out, target, "x2", needle_label)
    out = asm_line(out, "bl L_native_runtime_linux_aarch64_span_equal")
    out = asm_line(out, "cbnz w0, " + branch_label)
    return out


def emit_runtime_native_linux_aarch64_exact_append(out, target, branch_label, replacement_label):
    out = asm_label(out, branch_label)
    out = asm_line(out, "mov x0, x19")
    out = asm_addr(out, target, "x1", replacement_label)
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "b L_native_runtime_linux_aarch64_line_return")
    return out


def emit_exec_fn_runtime_native_linux_aarch64_asm_text(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    out = asm_label(out, exec_label)
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, " + exec_label + "_fail")
    out = asm_line(out, "cbz x20, " + exec_label + "_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x22, x1")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x22")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl L_native_runtime_linux_aarch64_asm_text_fixed")
    out = asm_line(out, "b " + exec_label + "_return")
    out = asm_label(out, exec_label + "_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, exec_label + "_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    # x0=bytes, x1=length, x2=result value slot -> w0=success. Complete
    # application assembly is normalized only here, after all dynamic
    # fragments have been joined.
    out = asm_label(out, "L_native_runtime_linux_aarch64_asm_text_fixed")
    out = asm_line(out, "stp x29, x30, [sp, #-112]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
