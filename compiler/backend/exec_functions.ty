    asm_line(out, "cmp x28, #6")
    asm_line(out, "b.eq L_exec_method_append_maybe_typed_heap_empty")
    asm_line(out, "cmp x28, #9")
    asm_line(out, "b.eq L_exec_method_append_maybe_typed_heap_empty")
