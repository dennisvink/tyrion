    asm_line(out, "bl " + asm_call_name(target, "malloc"))
    asm_line(out, "cbz x0, L_gsf_fail_" + name)
    asm_line(out, "ldr x10, [sp, #3864]")
    asm_line(out, "str x0, [x10]")
    asm_line(out, "ldr x14, [sp, #3880]")
    asm_line(out, "str x14, [x10, #8]")
    asm_line(out, "ldr x1, [sp, #3872]")
    asm_line(out, "mov x2, x14")
