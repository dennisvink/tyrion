    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl L_generated_value_string_ptr_len")
    out = asm_line(out, "cbz w2, " + exec_label + "_fail")
    out = asm_line(out, "mov x25, x0")
    out = asm_line(out, "mov x26, x1")
    out = asm_line(out, "add x0, x26, #11")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, " + exec_label + "_fail")
