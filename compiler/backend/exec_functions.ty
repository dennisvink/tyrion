def emit_exec_fn_host_target(out, target, name):
    value_tag_x19 = generated_value_tag_mem("x19")

    exec_label = lowered_function_label("L_exec_fn_", name)
    # Keep this construction in normal bounded expression shapes. Descendant
    # compilers execute emitter bodies directly and must not need a special
    # variadic-concatenation evaluator for target metadata.
    target_text = "contract=" + target["contract"]
    target_text = target_text + "|backend=" + target["backend"]
    target_text = target_text + "|backend_status=" + target["backend_status"]
    target_text = target_text + "|arch=" + target["arch"]
    target_text = target_text + "|os=" + target["os"]
    target_text = target_text + "|triple=" + target["triple"]
    target_text = target_text + "|object_format=" + target["object_format"]
    target_text = target_text + "|assembler_dialect=" + target["assembler_dialect"]
    target_text = target_text + "|calling_convention=" + target["calling_convention"]
    target_text = target_text + "|symbol_prefix=" + target["symbol_prefix"]
    target_text = target_text + "|linker=" + target["linker"]
    target_text = target_text + "|entry_symbol=" + target["entry_symbol"]
    target_text = target_text + "|text_section=" + target["text_section"]
    target_text = target_text + "|rodata_section=" + target["rodata_section"]
    target_text = target_text + "|data_section=" + target["data_section"]
    target_text = target_text + "|const_data_section=" + target["const_data_section"]
    target_text = target_text + "|asm_syntax=" + target["asm_syntax"]
    target_text = target_text + "|capabilities=" + target["capabilities"]
    target_text = target_text + "|operations=" + target["operations"]
    target_text_len = len(target_text)
    target_text_len_text = decimal_text(target_text_len)
    target_alloc_len_text = decimal_text(target_text_len + 1)
    target_label = exec_label + "_value"
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-32]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "str x19, [sp, #16]")
    asm_line(out, "mov x19, x0")
    asm_line(out, "cbz x19, " + exec_label + "_fail")
    asm_line(out, "mov x0, #" + target_alloc_len_text)
    asm_line(out, "bl " + asm_call_name(target, "malloc"))
    asm_line(out, "cbz x0, " + exec_label + "_fail")
    asm_line(out, "str x0, [x19]")
    asm_line(out, "mov x9, #" + target_text_len_text)
    asm_line(out, "str x9, [x19, #8]")
    asm_addr(out, target, "x1", target_label)
    asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    asm_line(out, "mov w9, #11")
    asm_line(out, "strb w9, " + value_tag_x19)
    asm_line(out, "mov w0, #1")
    asm_line(out, "b " + exec_label + "_return")
    asm_label(out, exec_label + "_fail")
    asm_line(out, "mov w0, #0")
    asm_label(out, exec_label + "_return")
    asm_line(out, "ldr x19, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #32")
    asm_line(out, "ret")
    asm_label(out, target_label)
    asm_line(out, ".asciz \"" + asm_escape_string(target_text) + "\"")
    asm_line(out, ".p2align 2")
    return out

def emit_exec_fn_print_static_text(out, target, name, label):
    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-16]!")
    asm_line(out, "mov x29, sp")
    asm_addr(out, target, "x0", label)
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "mov w0, #1")
    asm_line(out, "ldp x29, x30, [sp], #16")
    asm_line(out, "ret")
    return out

def emit_exec_fn_char_equals(out, target, fn):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")

    code = fn["body_plan"]["char_code"]
    out = asm_label(out, fn["exec_label"])
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "cbz x20, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "ldrb w9, " + value_tag_x19)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "b " + fn["exec_label"] + "_ready")
    out = asm_label(out, fn["exec_label"] + "_heap")
    out = asm_line(out, "ldr x19, [x19]")
    out = asm_line(out, "cbz x19, " + fn["exec_label"] + "_fail")
    out = asm_label(out, fn["exec_label"] + "_ready")
    out = asm_line(out, "mov x11, #0")
    out = asm_line(out, "ldrb w9, [x19]")
    out = asm_line(out, "cmp w9, #" + str(code))
    out = asm_line(out, "b.ne " + fn["exec_label"] + "_write")
    out = asm_line(out, "ldrb w10, [x19, #1]")
    out = asm_line(out, "cbnz w10, " + fn["exec_label"] + "_write")
    out = asm_line(out, "mov x11, #1")
    out = asm_label(out, fn["exec_label"] + "_write")
    out = asm_line(out, "cbz x11, " + fn["exec_label"] + "_false")
    out = asm_line(out, "mov w9, #84")
    out = asm_line(out, "strb w9, [x20]")
    out = asm_line(out, "mov w9, #114")
    out = asm_line(out, "strb w9, [x20, #1]")
    out = asm_line(out, "mov w9, #117")
    out = asm_line(out, "strb w9, [x20, #2]")
    out = asm_line(out, "mov w9, #101")
    out = asm_line(out, "strb w9, [x20, #3]")
    out = asm_line(out, "strb wzr, [x20, #4]")
    out = asm_line(out, "b " + fn["exec_label"] + "_tag")
    out = asm_label(out, fn["exec_label"] + "_false")
    out = asm_line(out, "mov w9, #70")
    out = asm_line(out, "strb w9, [x20]")
    out = asm_line(out, "mov w9, #97")
    out = asm_line(out, "strb w9, [x20, #1]")
    out = asm_line(out, "mov w9, #108")
    out = asm_line(out, "strb w9, [x20, #2]")
    out = asm_line(out, "mov w9, #115")
    out = asm_line(out, "strb w9, [x20, #3]")
    out = asm_line(out, "mov w9, #101")
    out = asm_line(out, "strb w9, [x20, #4]")
    out = asm_line(out, "strb wzr, [x20, #5]")
    out = asm_label(out, fn["exec_label"] + "_tag")
    out = asm_line(out, "mov w9, #3")
    out = asm_line(out, "strb w9, " + value_tag_x20)
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b " + fn["exec_label"] + "_return")
    out = asm_label(out, fn["exec_label"] + "_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, fn["exec_label"] + "_return")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")
    return out

def emit_exec_fn_char_class(out, target, fn):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")

    kind = fn["body_plan"]["class_kind"]
    out = asm_label(out, fn["exec_label"])
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "cbz x20, " + fn["exec_label"] + "_fail")
    out = asm_line(out, "ldrb w9, " + value_tag_x19)
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.eq " + fn["exec_label"] + "_heap")
    out = asm_line(out, "b " + fn["exec_label"] + "_ready")
    out = asm_label(out, fn["exec_label"] + "_heap")
    out = asm_line(out, "ldr x19, [x19]")
    out = asm_line(out, "cbz x19, " + fn["exec_label"] + "_fail")
    out = asm_label(out, fn["exec_label"] + "_ready")
    out = asm_line(out, "mov x11, #0")
    out = asm_line(out, "ldrb w9, [x19]")
    if kind == 1:
        out = asm_line(out, "cmp w9, #48")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_write")
        out = asm_line(out, "cmp w9, #57")
        out = asm_line(out, "cset x11, le")
    elif kind == 2:
        out = asm_line(out, "cmp w9, #97")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_write")
        out = asm_line(out, "cmp w9, #122")
        out = asm_line(out, "cset x11, le")
    elif kind == 3:
        out = asm_line(out, "cmp w9, #65")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_write")
        out = asm_line(out, "cmp w9, #90")
        out = asm_line(out, "cset x11, le")
    elif kind == 4:
        out = asm_line(out, "cmp w9, #32")
        out = asm_line(out, "b.eq " + fn["exec_label"] + "_true")
        out = asm_line(out, "cmp w9, #9")
        out = asm_line(out, "b.eq " + fn["exec_label"] + "_true")
        out = asm_line(out, "cmp w9, #13")
        out = asm_line(out, "cset x11, eq")
    elif kind == 5:
        out = asm_line(out, "cmp w9, #97")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_alpha_upper")
        out = asm_line(out, "cmp w9, #122")
        out = asm_line(out, "b.le " + fn["exec_label"] + "_true")
        out = asm_label(out, fn["exec_label"] + "_alpha_upper")
        out = asm_line(out, "cmp w9, #65")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_write")
        out = asm_line(out, "cmp w9, #90")
        out = asm_line(out, "cset x11, le")
    elif kind == 6:
        out = asm_line(out, "cmp w9, #95")
        out = asm_line(out, "b.eq " + fn["exec_label"] + "_true")
        out = asm_line(out, "cmp w9, #97")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_ident_start_upper")
        out = asm_line(out, "cmp w9, #122")
        out = asm_line(out, "b.le " + fn["exec_label"] + "_true")
        out = asm_label(out, fn["exec_label"] + "_ident_start_upper")
        out = asm_line(out, "cmp w9, #65")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_write")
        out = asm_line(out, "cmp w9, #90")
        out = asm_line(out, "cset x11, le")
    else:
        out = asm_line(out, "cmp w9, #95")
        out = asm_line(out, "b.eq " + fn["exec_label"] + "_true")
        out = asm_line(out, "cmp w9, #48")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_ident_continue_lower")
        out = asm_line(out, "cmp w9, #57")
        out = asm_line(out, "b.le " + fn["exec_label"] + "_true")
        out = asm_label(out, fn["exec_label"] + "_ident_continue_lower")
        out = asm_line(out, "cmp w9, #97")
        out = asm_line(out, "b.lt " + fn["exec_label"] + "_ident_continue_upper")
