    asm_line(out, "strb w10, [x22, #1]")
    asm_line(out, "b " + exec_label + "_escaped_pair")
    asm_label(out, exec_label + "_escape_quote")
    asm_line(out, "mov w10, #92")
    asm_line(out, "strb w10, [x22]")
    asm_line(out, "mov w10, #34")
    asm_line(out, "strb w10, [x22, #1]")
    asm_line(out, "b " + exec_label + "_escaped_pair")
    asm_label(out, exec_label + "_escape_newline")
    asm_line(out, "mov w10, #92")
    asm_line(out, "strb w10, [x22]")
    asm_line(out, "mov w10, #110")
    asm_line(out, "strb w10, [x22, #1]")
    asm_line(out, "b " + exec_label + "_escaped_pair")
    asm_label(out, exec_label + "_escape_tab")
