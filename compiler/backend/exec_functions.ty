def emit_exec_fn_build_native_program_route(out, target, exec_label):
    value_tag_x23 = generated_value_tag_mem("x23")

    asm_label(out, exec_label + "_fallback")
    asm_line(out, "strb wzr, [x23]")
    asm_line(out, "strb wzr, " + value_tag_x23)
    asm_line(out, "mov x0, x24")
    asm_line(out, "mov x1, x19")
    asm_line(out, "bl L_generated_value_set_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail")
    asm_line(out, "mov x0, x25")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl L_generated_value_set_cstr")
    asm_line(out, "cbz w0, " + exec_label + "_fail")
    asm_line(out, "mov x26, #4")
    # The direct builder consumes the source slot, a non-null scratch/result
    # slot, and typed input/output path slots.  The old compiler-specialized
    # call passed path/exception registers in these positions, which surfaced
    # as the opaque "string method receiver must be str" failure on ARM and
    # prevented the x86 successor from reaching its native emitter.
    asm_line(out, "mov x0, x21")
    asm_line(out, "mov x1, x22")
    asm_line(out, "mov x2, x24")
    asm_line(out, "mov x3, x25")
    asm_line(out, "bl L_exec_fn_build_runtime_native_program_if_needed")
    asm_line(out, "cbz w0, " + exec_label + "_fail")
    asm_line(out, "ldrb w9, " + value_tag_x23)
    asm_line(out, "cmp w9, #3")
    asm_line(out, "b.ne " + exec_label + "_fail")
    asm_line(out, "ldrb w9, [x23]")
    asm_line(out, "cmp w9, #84")
    asm_line(out, "b.eq " + exec_label + "_success")
    # Direct lowering is the only production application route. A false result
    # is an unsupported-program error, not permission to enter a compatibility
    # backend.
    asm_line(out, "b " + exec_label + "_fail")
    return out

def emit_exec_fn_build_native_close(out, target, exec_label):
    asm_label(out, exec_label + "_success")
    asm_line(out, "mov w26, #1")
    asm_line(out, "b " + exec_label + "_return")
    asm_label(out, exec_label + "_fail")
    asm_addr(out, target, "x9", "L_native_runtime_direct_diag_reported")
    asm_line(out, "ldr x9, [x9]")
    asm_line(out, "cbnz x9, " + exec_label + "_fail_reported")
    asm_addr(out, target, "x0", "L_err_build_native_stage")
    asm_line(out, "bl " + asm_call_name(target, "puts"))
    asm_line(out, "mov x0, x26")
    asm_line(out, "bl L_print_u64_decimal_line")
    asm_label(out, exec_label + "_fail_reported")
    asm_line(out, "mov w26, #0")
    asm_label(out, exec_label + "_return")
    asm_addr(out, target, "x9", generated_active_compiler_source_label())
    asm_line(out, "ldr x0, [x9]")
    asm_line(out, "str xzr, [x9]")
    asm_line(out, "cbz x0, " + exec_label + "_active_source_released")
    asm_line(out, "bl " + asm_call_name(target, "free"))
    asm_label(out, exec_label + "_active_source_released")
    asm_line(out, "add sp, sp, #640")
    asm_line(out, "mov w0, w26")
    asm_line(out, "ldp x27, x28, [sp, #80]")
    asm_line(out, "ldp x25, x26, [sp, #64]")
    asm_line(out, "ldp x23, x24, [sp, #48]")
    asm_line(out, "ldp x21, x22, [sp, #32]")
    asm_line(out, "ldp x19, x20, [sp, #16]")
    asm_line(out, "ldp x29, x30, [sp], #112")
    asm_line(out, "ret")
    return out

def emit_exec_fn_build_native(out, target, name):
    exec_label = lowered_function_label("L_exec_fn_", name)
    out = emit_exec_fn_build_native_open(out, target, exec_label)
    # The compiler is an ordinary Tyrion program.  Its historical special
    # route called the compatibility compiler-CLI emitter, which is disabled
    # for x86 native lowering and caused C1 to stop after emitting a partial
    # assembly file.  Route every source, including tyrion.ty itself, through
    # the same verified native program builder.
    out = emit_exec_fn_build_native_program_route(out, target, exec_label)
    out = emit_exec_fn_build_native_close(out, target, exec_label)
    return out

