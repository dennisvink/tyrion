    raw_num_no = "L_gsf_raw_num_no_" + name + "_" + param_ordinal_text
    raw_num_tag = "L_gsf_raw_num_tag_" + name + "_" + param_ordinal_text
    packed_arg_label = "L_gsf_copy_packed_arg_" + name + "_" + param_ordinal_text
    asm_line(out, "add x0, x21, #" + decimal_text(name_offset))
    param_label_prefix = "L_fn_param_" + name + "_"
    param_label = lowered_function_label(param_label_prefix, param_ordinal_text)
    asm_addr(out, target, "x1", param_label)
    asm_line(out, "bl L_string_copy")
    asm_line(out, "ldr x11, [sp, #" + decimal_text(arg_offset) + "]")
    asm_line(out, "cbz x11, L_gsf_fail_" + name)
    asm_line(out, "add x10, x22, #" + decimal_text(name_offset))
    if name == "build_native":
        build_native_raw_ptr = "L_gsf_build_native_raw_ptr_" + param_ordinal_text
        asm_line(out, "ldrb w9, [x11]")
        asm_line(out, "cbz w9, " + raw_label)
        asm_label(out, build_native_raw_ptr)
        asm_line(out, "str x11, [x10]")
        asm_line(out, "mov x0, x11")
        asm_line(out, "bl " + asm_call_name(target, "strlen"))
        asm_line(out, "str x0, [x10, #8]")
        asm_line(out, "mov w9, #8")
        asm_line(out, "strb w9, " + value_tag_x10)
        asm_line(out, "b " + copy_done)
    asm_line(out, "mov x12, x11")
    asm_line(out, "lsr x13, x12, #48")
    asm_line(out, "cbnz x13, " + packed_arg_label)
    asm_line(out, "mov x13, #1")
    asm_line(out, "lsl x13, x13, #32")
    asm_line(out, "cmp x12, x13")
    asm_line(out, "b.lo " + packed_arg_label)
    # Generated value slots passed between lowered helpers live in the active
    # stack arena. Raw compiler metadata strings and aggregate payloads may be
    # heap/static pointers and are not 128-byte value slots; never probe their
    # tag byte before classifying the pointer.
    asm_line(out, "mov x13, sp")
    asm_line(out, "cmp x11, x13")
    asm_line(out, "b.lo " + raw_label)
    asm_line(out, "mov x14, #1")
    asm_line(out, "lsl x14, x14, #24")
    asm_line(out, "add x13, x13, x14")
    asm_line(out, "cmp x11, x13")
    asm_line(out, "b.hs " + raw_label)
    asm_line(out, "ldrb w9, " + value_tag_x11)
    asm_line(out, "cbz w9, " + raw_label)
    asm_line(out, "cmp w9, #18")
    asm_line(out, "b.ls " + copy_label)
    asm_line(out, "b " + raw_label)
    asm_label(out, raw_label)
    raw_copy_label = "L_gsf_copy_raw_text_" + name + "_" + param_ordinal_text
    asm_line(out, "ldrb w9, [x11]")
    asm_line(out, "cbnz w9, " + raw_copy_label)
    asm_line(out, "mov w9, #48")
    asm_line(out, "strb w9, [x10]")
    asm_line(out, "strb wzr, [x10, #1]")
    asm_line(out, "mov w9, #2")
    asm_line(out, "strb w9, " + value_tag_x10)
    asm_line(out, "b " + copy_done)
    asm_label(out, raw_copy_label)
    raw_heap_label = "L_gsf_copy_raw_heap_" + name + "_" + param_ordinal_text
    asm_line(out, "str x10, [sp, #3864]")
    asm_line(out, "str x11, [sp, #3872]")
    asm_line(out, "mov x0, x11")
    asm_line(out, "bl " + asm_call_name(target, "strlen"))
    asm_line(out, "str x0, [sp, #3880]")
    asm_line(out, "cmp x0, #120")
    asm_line(out, "b.hi " + raw_heap_label)
    asm_line(out, "ldr x10, [sp, #3864]")
    asm_line(out, "ldr x11, [sp, #3872]")
    asm_line(out, "mov x0, x10")
    asm_line(out, "mov x1, x11")
    asm_line(out, "bl L_string_copy")
    asm_line(out, "ldr x10, [sp, #3864]")
    asm_line(out, "mov x12, x10")
    asm_line(out, "mov x13, #0")
