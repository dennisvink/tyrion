    value_tag_reg = generated_value_tag_mem(reg)
    value_tag_line = lowered_function_label("ldrb w9, ", value_tag_reg)
    value_tag_x10 = generated_value_tag_mem("x10")
    value_tag_x10_line = lowered_function_label("ldrb w9, ", value_tag_x10)
    load_x10_deref_line = lowered_function_label("ldr x10, [", reg)
    load_x10_deref_line = lowered_function_label(load_x10_deref_line, "]")
    store_sp_line = lowered_function_label("str ", reg)
    store_sp_line = lowered_function_label(store_sp_line, ", [sp]")
    load_sp8_line = lowered_function_label("ldr ", reg)
    load_sp8_line = lowered_function_label(load_sp8_line, ", [sp, #8]")
    load_sp_line = lowered_function_label("ldr ", reg)
    load_sp_line = lowered_function_label(load_sp_line, ", [sp]")
    move_from_x10_line = lowered_function_label("mov ", reg)
    move_from_x10_line = lowered_function_label(move_from_x10_line, ", x10")
    asm_line(out, value_tag_line)
    asm_line(out, "cmp w9, #8")
    asm_line(out, "b.eq " + heap_label)
    asm_line(out, "cmp w9, #9")
    asm_line(out, "b.eq " + heap_label)
    asm_line(out, "cmp w9, #11")
    asm_line(out, "b.eq " + heap_label)
    if target["os"] == "linux" and target["arch"] == "x86_64":
        asm_line(out, "cmp w9, #1")
        asm_line(out, "b.eq " + tag1_label)
    asm_line(out, "b " + ready_label)
    if target["os"] == "linux" and target["arch"] == "x86_64":
        # Tag-1 aliases may point either at a raw C string or at another typed
        # value slot. Follow bounded typed-slot chains before accepting a raw
        # pointer; generated call/assignment frames can introduce more than one
        # reference layer.
        asm_label(out, tag1_label)
        asm_line(out, load_x10_deref_line)
        asm_line(out, "cbz x10, " + ready_label)
        asm_line(out, "sub sp, sp, #32")
        asm_line(out, store_sp_line)
        asm_line(out, "str x10, [sp, #8]")
        asm_line(out, "mov x12, #0")
        asm_label(out, tag1_probe_label)
        asm_line(out, "ldr x10, [sp, #8]")
        asm_line(out, "lsr x0, x10, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #24")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, " + tag1_inline_label)
        asm_line(out, "ldr x10, [sp, #8]")
        asm_line(out, "add x0, x10, #127")
        asm_line(out, "lsr x0, x0, #12")
        asm_line(out, "lsl x0, x0, #12")
        asm_line(out, "mov x1, #1")
        asm_line(out, "lsl x1, x1, #12")
        asm_line(out, "add x2, sp, #24")
        asm_line(out, "bl " + asm_call_name(target, "mincore"))
        asm_line(out, "cbnz w0, " + tag1_raw_label)
        asm_line(out, "ldr x10, [sp, #8]")
        asm_line(out, value_tag_x10_line)
        asm_line(out, "cmp w9, #8")
        asm_line(out, "b.eq " + tag1_typed_label)
        asm_line(out, "cmp w9, #9")
        asm_line(out, "b.eq " + tag1_typed_label)
        asm_line(out, "cmp w9, #11")
        asm_line(out, "b.eq " + tag1_typed_label)
        asm_line(out, "cmp w9, #1")
        asm_line(out, "b.eq " + tag1_nested_label)
        asm_label(out, tag1_raw_label)
        asm_line(out, load_sp8_line)
        asm_line(out, "add sp, sp, #32")
        asm_line(out, "b " + ready_label)
        asm_label(out, tag1_nested_label)
        asm_line(out, "add x12, x12, #1")
        asm_line(out, "cmp x12, #4")
        asm_line(out, "b.hs " + tag1_raw_label)
        asm_line(out, "ldr x10, [sp, #8]")
        asm_line(out, "ldr x10, [x10]")
        asm_line(out, "cbz x10, " + tag1_raw_label)
        asm_line(out, "str x10, [sp, #8]")
        asm_line(out, "b " + tag1_probe_label)
        asm_label(out, tag1_typed_label)
        asm_line(out, load_sp8_line)
        asm_line(out, "add sp, sp, #32")
        asm_line(out, "b " + heap_label)
        asm_label(out, tag1_inline_label)
        asm_line(out, load_sp_line)
        asm_line(out, "add sp, sp, #32")
        asm_line(out, "b " + ready_label)
    asm_label(out, heap_label)
    asm_line(out, load_x10_deref_line)
    asm_line(out, "cbz x10, " + ready_label)
    if target["os"] == "linux":
        asm_line(out, move_from_x10_line)
        asm_line(out, "b " + ready_label)
    asm_line(out, "and x11, x10, #7")
    asm_line(out, "cbnz x11, " + ready_label)
    asm_line(out, "sub sp, sp, #16")
    asm_line(out, store_sp_line)
    asm_line(out, "str x10, [sp, #8]")
    asm_line(out, "mov x0, x10")
    asm_line(out, "bl " + malloc_size_call)
    asm_line(out, "ldr x10, [sp, #8]")
    asm_line(out, "cbz x0, " + heap_invalid_label)
    asm_line(out, "add sp, sp, #16")
    asm_line(out, move_from_x10_line)
    asm_line(out, "b " + ready_label)
    asm_label(out, heap_invalid_label)
    asm_line(out, load_sp_line)
    asm_line(out, "add sp, sp, #16")
    asm_label(out, ready_label)
    return out

