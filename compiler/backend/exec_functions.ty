    asm_line(out, "ldr x10, [sp, #3864]")
    asm_line(out, "ldr x11, [x10]")
    asm_line(out, "ldr x14, [sp, #3880]")
    asm_line(out, "strb wzr, [x11, x14]")
    asm_line(out, "mov w9, #8")
    asm_line(out, "strb w9, " + value_tag_x10)
    asm_line(out, "b " + copy_done)
    asm_label(out, packed_arg_label)
    asm_line(out, "str x11, [x10]")
    asm_line(out, "str xzr, [x10, #8]")
    asm_line(out, "mov x12, x10")
    asm_line(out, "mov x13, #0")
    asm_label(out, raw_num_check)
    asm_line(out, "ldrb w9, [x12]")
    asm_line(out, "cmp w9, #45")
    asm_line(out, "b.ne " + raw_num_first)
    asm_line(out, "add x12, x12, #1")
    asm_label(out, raw_num_first)
    asm_line(out, "ldrb w9, [x12]")
    asm_line(out, "cmp w9, #48")
    asm_line(out, "b.lt " + raw_num_no)
    asm_line(out, "cmp w9, #57")
    asm_line(out, "b.gt " + raw_num_no)
    asm_label(out, raw_num_loop)
    asm_line(out, "ldrb w9, [x12]")
    asm_line(out, "cbz w9, " + raw_num_yes)
    asm_line(out, "cmp w9, #48")
    asm_line(out, "b.lt " + raw_num_no)
    asm_line(out, "cmp w9, #57")
    asm_line(out, "b.gt " + raw_num_no)
    asm_line(out, "mov x13, #1")
    asm_line(out, "add x12, x12, #1")
    asm_line(out, "b " + raw_num_loop)
    asm_label(out, raw_num_yes)
    asm_line(out, "cbz x13, " + raw_num_no)
    asm_line(out, "mov w9, #2")
    asm_line(out, "b " + raw_num_tag)
