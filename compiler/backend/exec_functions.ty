    asm_label(out, "L_link_asm_abi_fail")
    asm_line(out, "str wzr, [sp, #4088]")
    asm_label(out, "L_link_asm_finish")
    asm_line(out, "ldr w9, [sp, #4088]")
    asm_line(out, "cbz x22, L_link_asm_direct_result")
    asm_line(out, "mov x11, x9")
