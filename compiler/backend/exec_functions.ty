def emit_exec_fn_generic_source_body_from_inventory_row(out, target, row):
    state_active_stream_x10 = generated_state_active_stream_mem("x10")
    state_active_stream_x24 = generated_state_active_stream_mem("x24")
    state_assignment_base_x24 = generated_state_assignment_base_mem("x24")
    state_assignment_end_x24 = generated_state_assignment_end_mem("x24")
    state_function_table_x24 = generated_state_function_table_mem("x24")
    state_scope_floor_x24 = generated_state_scope_floor_mem("x24")
    state_source_base_x24 = generated_state_source_base_mem("x24")
    state_source_cursor_x24 = generated_state_source_cursor_mem("x24")
    value_tag_x11 = generated_value_tag_mem("x11")

    inventory = row
    name = lowered_function_inventory_field(row, 0)
    arity_text = lowered_function_inventory_field(row, 1)
    name_label = lowered_function_label("L_fn_", name)
    exec_label = lowered_function_label("L_exec_fn_", name)
    source_arity = lowered_function_inventory_arity(arity_text)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-112]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "stp x23, x24, [sp, #48]")
    asm_line(out, "stp x25, x26, [sp, #64]")
    asm_line(out, "stp x27, x28, [sp, #80]")
    frame_page = 0
    while frame_page < 12:
        asm_line(out, "sub sp, sp, #4096")
        frame_page = frame_page + 1
    asm_line(out, "str x0, [sp, #3904]")
    asm_line(out, "str x1, [sp, #3912]")
    asm_line(out, "str x2, [sp, #3920]")
    asm_line(out, "str x3, [sp, #3928]")
    asm_line(out, "str x4, [sp, #3936]")
    asm_line(out, "str x5, [sp, #3944]")
    asm_line(out, "add x21, sp, #4096")
    asm_line(out, "add x22, sp, #4096")
    asm_line(out, "add x22, x22, #4096")
    asm_line(out, "add x22, x22, #4096")
    asm_line(out, "add x22, x22, #4096")
    asm_line(out, "add x22, x22, #4096")
    asm_line(out, "add x23, sp, #4096")
    asm_line(out, "add x23, x23, #4096")
