    asm_line(out, "mov x2, x20")
    asm_line(out, "bl L_native_tool_report_failure")
    asm_label(out, "L_link_asm_cleanup_fail")
    asm_line(out, "str wzr, [sp, #4088]")
    asm_line(out, "mov x0, x21")
    asm_line(out, "bl " + asm_call_name(target, "unlink"))
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl " + asm_call_name(target, "unlink"))
