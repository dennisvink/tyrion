    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
    asm_line(out, "sub sp, sp, #4096")
    asm_line(out, "str wzr, [sp, #4088]")
    asm_line(out, "mov x22, #0")
    asm_line(out, "cmp x7, #3")
    asm_line(out, "b.ne L_link_asm_result_arg_ready")
    asm_line(out, "mov x22, x2")
    asm_label(out, "L_link_asm_result_arg_ready")
    asm_line(out, "mov x19, x0")
    asm_line(out, "ldrb w9, " + value_tag_x19)
    asm_line(out, "cmp w9, #8")
    asm_line(out, "b.ne L_link_asm_asm_path_arg_ready")
    asm_line(out, "ldr x10, [x19]")
    asm_line(out, "cbz x10, L_link_asm_asm_path_arg_ready")
    asm_line(out, "cmp x10, #4096")
    asm_line(out, "b.lo L_link_asm_asm_path_arg_ready")
    asm_line(out, "lsr x11, x10, #48")
    asm_line(out, "cbnz x11, L_link_asm_asm_path_arg_ready")
    asm_line(out, "mov x19, x10")
    asm_label(out, "L_link_asm_asm_path_arg_ready")
    asm_line(out, "mov x20, x1")
    asm_line(out, "ldrb w9, " + value_tag_x20)
    asm_line(out, "cmp w9, #8")
    asm_line(out, "b.ne L_link_asm_output_path_arg_ready")
    asm_line(out, "ldr x10, [x20]")
    asm_line(out, "cbz x10, L_link_asm_output_path_arg_ready")
    asm_line(out, "cmp x10, #4096")
    asm_line(out, "b.lo L_link_asm_output_path_arg_ready")
    asm_line(out, "lsr x11, x10, #48")
    asm_line(out, "cbnz x11, L_link_asm_output_path_arg_ready")
    asm_line(out, "mov x20, x10")
    asm_label(out, "L_link_asm_output_path_arg_ready")
    # Derive the intermediate object path in the final quarter of the bounded
    # scratch page; the command builder occupies the first three quarters.
    asm_line(out, "mov x0, x20")
    asm_line(out, "bl " + asm_call_name(target, "strlen"))
    asm_line(out, "cmp x0, #1000")
    asm_line(out, "b.hi L_link_asm_abi_fail")
    asm_line(out, "add x21, sp, #3072")
    asm_line(out, "mov x0, x21")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    asm_line(out, "mov x0, x21")
    asm_addr(out, target, "x1", "L_cmd_object_suffix")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))

    # Stage one: assemble source into a relocatable object.
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_cmd_assemble_prefix")
    asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "mov x1, x19")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_cmd_middle")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "mov x1, x21")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "bl " + asm_call_name(target, "system"))
    asm_line(out, "cmp w0, #0")
    asm_line(out, "b.ne L_link_asm_assemble_fail")

    # Stage two: link the object and any planned extension sources.
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_cmd_prefix")
    asm_line(out, "bl " + asm_call_name(target, "strcpy"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "mov x1, x21")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
