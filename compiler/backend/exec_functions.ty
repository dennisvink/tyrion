    out = asm_line(out, "cbz w2, " + exec_label + "_fail")
    out = asm_line(out, "mov x2, x1")
    out = asm_line(out, "mov x1, x0")
    out = asm_line(out, "add x0, sp, #768")
    out = asm_line(out, "bl L_native_text_builder_append_span")
    out = asm_line(out, "cbz w0, " + exec_label + "_fail")
    out = asm_line(out, "add x0, sp, #768")
    out = asm_addr(out, target, "x1", exec_label + "_artifact_suffix")
    out = asm_line(out, "bl L_native_text_builder_append_cstr")
    out = asm_line(out, "cbz w0, " + exec_label + "_fail")
