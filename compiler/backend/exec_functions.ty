    asm_line(out, "ldr x11, [sp, #3064]")
    asm_line(out, "cmp x11, x10")
    asm_line(out, "b.hs L_link_asm_extension_ready")
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_cmd_space")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_native_runtime_direct_extension_sources")
    asm_line(out, "ldr x11, [sp, #3064]")
    asm_line(out, "add x1, x1, x11, lsl #9")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "ldr x11, [sp, #3064]")
    asm_line(out, "add x11, x11, #1")
    asm_line(out, "str x11, [sp, #3064]")
    asm_line(out, "b L_link_asm_extension_loop")
    asm_label(out, "L_link_asm_extension_ready")
    if target["os"] == "linux":
        asm_addr(out, target, "x9", "L_cli_dynamic_extension_mode")
        asm_line(out, "ldr x9, [x9]")
        asm_line(out, "cbz x9, L_link_asm_dynamic_ready")
        asm_line(out, "mov x0, sp")
        asm_addr(out, target, "x1", "L_cmd_ldl")
        asm_line(out, "bl " + asm_call_name(target, "strcat"))
        asm_label(out, "L_link_asm_dynamic_ready")
    asm_line(out, "mov x0, sp")
    asm_addr(out, target, "x1", "L_cmd_middle")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "mov x1, x20")
    asm_line(out, "bl " + asm_call_name(target, "strcat"))
    asm_line(out, "mov x0, sp")
    asm_line(out, "bl " + asm_call_name(target, "system"))
    asm_line(out, "cmp w0, #0")
    asm_line(out, "b.ne L_link_asm_link_fail")
    asm_line(out, "mov w9, #1")
    asm_line(out, "str w9, [sp, #4088]")
    asm_line(out, "b L_link_asm_finish")

    asm_label(out, "L_link_asm_assemble_fail")
    asm_addr(out, target, "x0", "L_native_tool_assemble_failed")
    asm_line(out, "mov x1, x19")
    asm_line(out, "mov x2, x21")
    asm_line(out, "bl L_native_tool_report_failure")
    asm_line(out, "b L_link_asm_cleanup_fail")
    asm_label(out, "L_link_asm_link_fail")
    asm_addr(out, target, "x0", "L_native_tool_link_failed")
