    out = asm_line(out, "add x0, sp, #256")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #384")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #512")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x0, sp, #640")
    out = asm_line(out, "bl L_generated_value_zero_slot")
    out = asm_line(out, "add x9, sp, #768")
    out = asm_line(out, "stp xzr, xzr, [x9]")
    out = asm_line(out, "str xzr, [x9, #16]")
    out = asm_line(out, "cbz x19, " + exec_label + "_fail")
    out = asm_line(out, "cbz x20, " + exec_label + "_fail")
    out = asm_line(out, "cbz x21, " + exec_label + "_fail")
    out = asm_line(out, "cbz x22, " + exec_label + "_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "add x1, sp, #128")
    out = asm_line(out, "bl L_native_runtime_direct_source")
    out = asm_line(out, "cbz w0, " + exec_label + "_fail")
    out = asm_line(out, "ldrb w9, [sp, #255]")
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.eq " + exec_label + "_selected")
    out = asm_line(out, "cmp w9, #9")
    out = asm_line(out, "b.eq " + exec_label + "_selected")
    out = asm_line(out, "cmp w9, #11")
    out = asm_line(out, "b.ne " + exec_label + "_unsupported")
    out = asm_label(out, exec_label + "_selected")
    if target["backend"] == "linux-x86_64":
        # x86 applications are lowered by the source-level Native IR v2
        # builder.  The old fixed renderer below is the removed semantic
        # compatibility path; dispatch around it with the five-argument
        # source entry point while preserving the normal cleanup ABI.
        out = asm_line(out, "add x0, sp, #128")
        out = asm_addr(out, target, "x1", exec_label + "_ext_mode_off")
        out = asm_line(out, "bl L_generated_value_set_cstr")
        out = asm_line(out, "cbz w0, " + exec_label + "_fail")
        out = asm_line(out, "add x0, sp, #256")
        out = asm_addr(out, target, "x1", exec_label + "_ext_root_default")
        out = asm_line(out, "bl L_generated_value_set_cstr")
        out = asm_line(out, "cbz w0, " + exec_label + "_fail")
        out = asm_line(out, "add x0, sp, #384")
        out = asm_addr(out, target, "x1", exec_label + "_ext_dynamic_off")
        out = asm_line(out, "bl L_generated_value_set_cstr")
        out = asm_line(out, "cbz w0, " + exec_label + "_fail")
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "mov x1, x22")
        out = asm_line(out, "add x2, sp, #128")
        out = asm_line(out, "add x3, sp, #256")
        out = asm_line(out, "add x4, sp, #384")
        out = asm_line(out, "add x5, sp, #512")
        out = asm_line(out, "bl L_exec_fn_build_runtime_native_x86_program_from_source")
        out = asm_line(out, "cbz w0, " + exec_label + "_fail")
        out = asm_line(out, "mov w23, #1")
        out = asm_line(out, "b " + exec_label + "_cleanup")
    if target["backend"] == "linux-aarch64":
