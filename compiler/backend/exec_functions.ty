def emit_exec_fn_generic_source_bodies_from_inventory(out, target, inventory):
    rows = lowered_function_inventory_rows(inventory)
    return emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, 0, len(rows))

def emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, start, stop):
    count_rows = lowered_function_inventory_rows(inventory)
    row_count = len(count_rows)
    row_index = start
    limit = stop
    if limit > row_count:
        limit = row_count
    while row_index < limit:
        name = lowered_function_inventory_cell(inventory, row_index, 0)
        plan_kind = lowered_function_inventory_native_plan_kind(name)
        if plan_kind == "generic_source_body":
            row = lowered_function_inventory_row(inventory, row_index)
            out = emit_exec_fn_generic_source_body_from_inventory_row(out, target, row)
        row_index = row_index + 1
    return out

def emit_exec_fn_method_append_native(out, target, name):
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")
    value_tag_x21 = generated_value_tag_mem("x21")
    value_owner_x19 = generated_value_owner_mem("x19")
    value_owner_x21 = generated_value_owner_mem("x21")

    exec_label = lowered_function_label("L_exec_fn_", name)
    asm_label(out, exec_label)
    asm_line(out, "stp x29, x30, [sp, #-112]!")
    asm_line(out, "mov x29, sp")
    asm_line(out, "stp x19, x20, [sp, #16]")
    asm_line(out, "stp x21, x22, [sp, #32]")
