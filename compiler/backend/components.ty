# compiler / backend / components: responsibility-owned canonical compiler module.

def minimal_compiler_cli_artifact_chunks():
    artifact = "tyrion-bootstrap-native v0\n"
    artifact = artifact + "native-build-target-kind=compiler-cli\n"
    artifact = artifact + "native-lowering-plan=bootstrap-compiler-cli-generated-minimal\n"
    artifact = artifact + "native-exec-mode=compiler-cli-native-partial\n"
    artifact = artifact + "native-link-mode=direct\n"
    return split_text_chunks(artifact, 3000)

def link_asm(asm_path, output_path):
    object_path = output_path + ".o"
    if not run_tool("cc", "-c", asm_path, "-o" + object_path):
        fail("native-tool rejected code=assemble-failed;path=" + asm_path + ";output=" + object_path)
    # Keep the native link lane ready for numeric builtins (notably **), whose
    # floating-point implementation uses the platform libm.
    if not run_tool("cc", object_path, "-o" + output_path, "-lm"):
        fail("native-tool rejected code=link-failed;path=" + object_path + ";output=" + output_path)
    return True

def emit_lowered_function_inventory_name_data(out, inventory):
    rows = lowered_function_inventory_rows(inventory)
    idx = 0
    while idx < len(rows):
        row = rows[idx]
        name = lowered_function_inventory_field(row, 0)
        out = asm_cstr(out, lowered_function_label("L_fn_", name), name)
        arity_text = lowered_function_inventory_field(row, 1)
        param_count = int(arity_text)
        ordinal = 0
        while ordinal < param_count:
            param_name = lowered_function_inventory_param(inventory, name, ordinal)
            out = asm_cstr(out, lowered_function_label("L_fn_param_" + name + "_", decimal_text(ordinal)), param_name)
            ordinal = ordinal + 1
        idx = idx + 1
    return out

def emit_lowered_function_inventory_table(out, inventory):
    rows = lowered_function_inventory_rows(inventory)
    idx = 0
    while idx < len(rows):
        name = lowered_function_inventory_field(rows[idx], 0)
        out = asm_dir(out, ".quad " + lowered_function_label("L_fn_", name) + ", " + lowered_function_label("L_clcf_", name))
        idx = idx + 1
    return out

def compiler_cli_minimal_helpers_available(program):
    if not program_has_function(program, "usage"):
        return False
    if not program_has_function(program, "version"):
        return False
    if not program_has_function(program, "cli_main"):
        return False
    return True

def materialize_cli_route_records(cli):
    records = []
    idx = 0
    while idx < len(cli["body"]):
        stmt = cli["body"][idx]
        if stmt["kind"] == "if":
            records.append({"info": cli_route_info(stmt["condition"]), "action": first_call_name(stmt["body"])})
            elif_idx = 0
            while elif_idx < len(stmt["elifs"]):
                branch = stmt["elifs"][elif_idx]
                records.append({"info": cli_route_info(branch["condition"]), "action": first_call_name(branch["body"])})
                elif_idx = elif_idx + 1
            if len(stmt["else_body"]) > 0:
                records.append({"info": {"argc": -1, "tests": []}, "action": first_call_name(stmt["else_body"])})
        idx = idx + 1
    return records

def emit_lowered_function_dispatch_wrappers(out, functions):
    idx = 0
    while idx < len(functions):
        fn = functions[idx]
        out = asm_label(out, fn["handler_label"])
        if fn["plan_kind"] == "native_compiler_cli_asm_into_body":
            with_result_label = fn["handler_label"] + "_with_result"
            no_result_label = fn["handler_label"] + "_no_result"
            out = asm_line(out, "mov x9, #6")
            out = asm_line(out, "str x9, [sp, #96]")
            out = asm_line(out, "cmp x27, #5")
            out = asm_line(out, "b.eq " + no_result_label)
            out = asm_line(out, "cmp x27, #6")
            out = asm_line(out, "b.ne L_clcf_arity_mismatch")
            out = asm_label(out, with_result_label)
            out = asm_line(out, "mov x0, x20")
            out = asm_line(out, "mov x1, x21")
            out = asm_line(out, "mov x2, x22")
            out = asm_line(out, "mov x3, x23")
            out = asm_line(out, "mov x4, x24")
            out = asm_line(out, "mov x5, x26")
            out = asm_line(out, "bl " + fn["exec_label"])
            out = asm_line(out, "b L_clcf_return")
            out = asm_label(out, no_result_label)
            out = asm_line(out, "mov x0, x20")
            out = asm_line(out, "mov x1, x21")
            out = asm_line(out, "mov x2, x22")
            out = asm_line(out, "mov x3, x23")
            out = asm_line(out, "mov x4, x24")
            out = asm_line(out, "mov x5, #0")
            out = asm_line(out, "bl " + fn["exec_label"])
            out = asm_line(out, "b L_clcf_return")
            idx = idx + 1
            continue
        if fn["plan_kind"] == "native_program_function_print_text_body":
            with_result_label = fn["handler_label"] + "_with_result"
            no_result_label = fn["handler_label"] + "_no_result"
            out = asm_line(out, "mov x9, #3")
            out = asm_line(out, "str x9, [sp, #96]")
            out = asm_line(out, "cmp x27, #2")
            out = asm_line(out, "b.eq " + no_result_label)
            out = asm_line(out, "cmp x27, #3")
            out = asm_line(out, "b.ne L_clcf_arity_mismatch")
            out = asm_label(out, with_result_label)
            out = asm_line(out, "mov x0, x20")
            out = asm_line(out, "mov x1, x21")
            out = asm_line(out, "mov x2, x22")
            out = asm_line(out, "bl " + fn["exec_label"])
            out = asm_line(out, "b L_clcf_return")
            out = asm_label(out, no_result_label)
            out = asm_line(out, "mov x0, x20")
            out = asm_line(out, "mov x1, x21")
            out = asm_line(out, "mov x2, #0")
            out = asm_line(out, "bl " + fn["exec_label"])
            out = asm_line(out, "b L_clcf_return")
            idx = idx + 1
            continue
        if fn["plan_kind"] == "generic_source_body" and fn["body_plan"]["has_return"]:
            source_arg_count = len(fn["source_params"])
            with_result_label = fn["handler_label"] + "_with_result"
            no_result_label = fn["handler_label"] + "_no_result"
            out = asm_line(out, "mov x9, #" + str(fn["dispatch_arg_count"]))
            out = asm_line(out, "str x9, [sp, #96]")
            out = asm_line(out, "cmp x27, #" + str(source_arg_count))
            out = asm_line(out, "b.eq " + no_result_label)
            out = asm_line(out, "cmp x27, #" + str(fn["dispatch_arg_count"]))
            out = asm_line(out, "b.ne L_clcf_arity_mismatch")
            out = asm_label(out, with_result_label)
            if fn["dispatch_arg_count"] > 0:
                out = asm_line(out, "mov x0, x20")
            if fn["dispatch_arg_count"] > 1:
                out = asm_line(out, "mov x1, x21")
            if fn["dispatch_arg_count"] > 2:
                out = asm_line(out, "mov x2, x22")
            if fn["dispatch_arg_count"] > 3:
                out = asm_line(out, "mov x3, x23")
            if fn["dispatch_arg_count"] > 4:
                out = asm_line(out, "mov x4, x24")
            if fn["dispatch_arg_count"] > 5:
                out = asm_line(out, "mov x5, x26")
            out = asm_line(out, "bl " + fn["exec_label"])
            if fn["force_success"]:
                out = asm_line(out, "mov w0, #1")
            out = asm_line(out, "b L_clcf_return")
            out = asm_label(out, no_result_label)
            if source_arg_count > 0:
                out = asm_line(out, "mov x0, x20")
            if source_arg_count > 1:
                out = asm_line(out, "mov x1, x21")
            if source_arg_count > 2:
                out = asm_line(out, "mov x2, x22")
            if source_arg_count == 0:
                out = asm_line(out, "mov x0, #0")
            if source_arg_count == 1:
                out = asm_line(out, "mov x1, #0")
            if source_arg_count == 2:
                out = asm_line(out, "mov x2, #0")
            if source_arg_count == 3:
                out = asm_line(out, "mov x3, #0")
            if source_arg_count == 4:
                out = asm_line(out, "mov x4, #0")
            if source_arg_count == 5:
                out = asm_line(out, "mov x5, #0")
            out = asm_line(out, "bl " + fn["exec_label"])
            if fn["force_success"]:
                out = asm_line(out, "mov w0, #1")
            out = asm_line(out, "b L_clcf_return")
            idx = idx + 1
            continue
        out = asm_line(out, "mov x9, #" + str(fn["dispatch_arg_count"]))
        out = asm_line(out, "str x9, [sp, #96]")
        out = asm_line(out, "cmp x27, #" + str(fn["dispatch_arg_count"]))
        out = asm_line(out, "b.ne L_clcf_arity_mismatch")
        if fn["dispatch_arg_count"] > 0:
            out = asm_line(out, "mov x0, x20")
        if fn["dispatch_arg_count"] > 1:
            out = asm_line(out, "mov x1, x21")
        if fn["dispatch_arg_count"] > 2:
            out = asm_line(out, "mov x2, x22")
        if fn["dispatch_arg_count"] > 3:
            out = asm_line(out, "mov x3, x23")
        if fn["dispatch_arg_count"] > 4:
            out = asm_line(out, "mov x4, x24")
        if fn["dispatch_arg_count"] > 5:
            out = asm_line(out, "mov x5, x26")
        out = asm_line(out, "bl " + fn["exec_label"])
        if fn["force_success"]:
            out = asm_line(out, "mov w0, #1")
        out = asm_line(out, "b L_clcf_return")
        idx = idx + 1
    return out

def emit_lowered_function_dispatch_wrapper_from_inventory(out, inventory, row_index):
    wrapper_name = lowered_function_inventory_cell(inventory, row_index, 0)
    arity_text = lowered_function_inventory_cell(inventory, row_index, 1)
    source_arg_count = lowered_function_inventory_arity(arity_text)
    plan_kind = lowered_function_inventory_native_plan_kind(wrapper_name)
    handler_label = lowered_function_label("L_clcf_", wrapper_name)
    exec_label = lowered_function_label("L_exec_fn_", wrapper_name)
    out = asm_label(out, handler_label)
    if plan_kind == "native_compiler_cli_asm_into_body":
        with_result_base = lowered_function_label("L_clcf_", wrapper_name)
        with_result_label = lowered_function_label(with_result_base, "_with_result")
        no_result_base = lowered_function_label("L_clcf_", wrapper_name)
        no_result_label = lowered_function_label(no_result_base, "_no_result")
        out = asm_line(out, "mov x9, #6")
        out = asm_line(out, "str x9, [sp, #96]")
        out = asm_line(out, "cmp x27, #5")
        out = asm_line(out, "b.eq " + no_result_label)
        out = asm_line(out, "cmp x27, #6")
        out = asm_line(out, "b.ne L_clcf_arity_mismatch")
        out = asm_label(out, with_result_label)
        out = asm_line(out, "mov x0, x20")
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, x22")
        out = asm_line(out, "mov x3, x23")
        out = asm_line(out, "mov x4, x24")
        out = asm_line(out, "mov x5, x26")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        out = asm_label(out, no_result_label)
        out = asm_line(out, "mov x0, x20")
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, x22")
        out = asm_line(out, "mov x3, x23")
        out = asm_line(out, "mov x4, x24")
        out = asm_line(out, "mov x5, #0")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        return out
    if plan_kind == "native_program_function_print_text_body":
        with_result_base = lowered_function_label("L_clcf_", wrapper_name)
        with_result_label = lowered_function_label(with_result_base, "_with_result")
        no_result_base = lowered_function_label("L_clcf_", wrapper_name)
        no_result_label = lowered_function_label(no_result_base, "_no_result")
        out = asm_line(out, "mov x9, #3")
        out = asm_line(out, "str x9, [sp, #96]")
        out = asm_line(out, "cmp x27, #2")
        out = asm_line(out, "b.eq " + no_result_label)
        out = asm_line(out, "cmp x27, #3")
        out = asm_line(out, "b.ne L_clcf_arity_mismatch")
        out = asm_label(out, with_result_label)
        out = asm_line(out, "mov x0, x20")
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, x22")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        out = asm_label(out, no_result_label)
        out = asm_line(out, "mov x0, x20")
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, #0")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        return out
    if plan_kind == "generic_source_body":
        dispatch_arg_count = source_arg_count + 1
        with_result_base = lowered_function_label("L_clcf_", wrapper_name)
        with_result_label = lowered_function_label(with_result_base, "_with_result")
        no_result_base = lowered_function_label("L_clcf_", wrapper_name)
        no_result_label = lowered_function_label(no_result_base, "_no_result")
        out = asm_line(out, "mov x9, #" + decimal_text(dispatch_arg_count))
        out = asm_line(out, "str x9, [sp, #96]")
        out = asm_line(out, "cmp x27, #" + decimal_text(source_arg_count))
        out = asm_line(out, "b.eq " + no_result_label)
        out = asm_line(out, "cmp x27, #" + decimal_text(dispatch_arg_count))
        out = asm_line(out, "b.ne L_clcf_arity_mismatch")
        out = asm_label(out, with_result_label)
        if dispatch_arg_count > 0:
            out = asm_line(out, "mov x0, x20")
        if dispatch_arg_count > 1:
            out = asm_line(out, "mov x1, x21")
        if dispatch_arg_count > 2:
            out = asm_line(out, "mov x2, x22")
        if dispatch_arg_count > 3:
            out = asm_line(out, "mov x3, x23")
        if dispatch_arg_count > 4:
            out = asm_line(out, "mov x4, x24")
        if dispatch_arg_count > 5:
            out = asm_line(out, "mov x5, x26")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        out = asm_label(out, no_result_label)
        if source_arg_count > 0:
            out = asm_line(out, "mov x0, x20")
        if source_arg_count > 1:
            out = asm_line(out, "mov x1, x21")
        if source_arg_count > 2:
            out = asm_line(out, "mov x2, x22")
        if source_arg_count == 0:
            out = asm_line(out, "mov x0, #0")
        if source_arg_count == 1:
            out = asm_line(out, "mov x1, #0")
        if source_arg_count == 2:
            out = asm_line(out, "mov x2, #0")
        if source_arg_count == 3:
            out = asm_line(out, "mov x3, #0")
        if source_arg_count == 4:
            out = asm_line(out, "mov x4, #0")
        if source_arg_count == 5:
            out = asm_line(out, "mov x5, #0")
        out = asm_line(out, "mov x7, x27")
        out = asm_line(out, "bl " + exec_label)
        out = asm_line(out, "b L_clcf_return")
        return out
    dispatch_arg_count = lowered_function_dispatch_arg_count(wrapper_name)
    out = asm_line(out, "mov x9, #" + decimal_text(dispatch_arg_count))
    out = asm_line(out, "str x9, [sp, #96]")
    out = asm_line(out, "cmp x27, #" + decimal_text(dispatch_arg_count))
    out = asm_line(out, "b.ne L_clcf_arity_mismatch")
    if dispatch_arg_count > 0:
        out = asm_line(out, "mov x0, x20")
    if dispatch_arg_count > 1:
        out = asm_line(out, "mov x1, x21")
    if dispatch_arg_count > 2:
        out = asm_line(out, "mov x2, x22")
    if dispatch_arg_count > 3:
        out = asm_line(out, "mov x3, x23")
    if dispatch_arg_count > 4:
        out = asm_line(out, "mov x4, x24")
    if dispatch_arg_count > 5:
        out = asm_line(out, "mov x5, x26")
    out = asm_line(out, "mov x7, x27")
    out = asm_line(out, "bl " + exec_label)
    out = asm_line(out, "b L_clcf_return")
    return out

def emit_lowered_function_dispatch_wrappers_from_inventory(out, inventory):
    count_rows = lowered_function_inventory_rows(inventory)
    row_count = len(count_rows)
    idx = 0
    while idx < row_count:
        out = emit_lowered_function_dispatch_wrapper_from_inventory(out, inventory, idx)
        idx = idx + 1
    return out

def emit_direct_value_scalar_templates(out, target):
    write_space = "    mov x0, #1\n"
    write_space = write_space + "    adrp x1, L_tyrion_direct_space@PAGE\n"
    write_space = write_space + "    add x1, x1, L_tyrion_direct_space@PAGEOFF\n"
    write_space = write_space + "    mov x2, #1\n    bl _write\n"
    write_newline = "    mov x0, #1\n"
    write_newline = write_newline + "    adrp x1, L_tyrion_direct_newline@PAGE\n"
    write_newline = write_newline + "    add x1, x1, L_tyrion_direct_newline@PAGEOFF\n"
    write_newline = write_newline + "    mov x2, #1\n    bl _write\n"
    literal_code_a = "    mov x0, #1\n    adrp x1, L_tyrion_direct_literal_"
    literal_code_b = "@PAGE\n    add x1, x1, L_tyrion_direct_literal_"
    literal_code_c = "@PAGEOFF\n    mov x2, #"
    literal_code_d = "\n    bl _write\n"
    literal_data_a = "L_tyrion_direct_literal_"
    literal_data_b = ":\n    .ascii "
    literal_data_c = "\n    .byte 0\n"
    literal_data_quote = "\""
    literal_data_quote_end = "\"\n"
    print_slot_a = "    ldr x15, ="
    print_slot_b = "\n    add x0, sp, x15\n    bl __tyrion_app_print_value\n"
    expr_slot_a = "    ldr x15, ="
    expr_int_a = "\n    add x13, sp, x15\n    ldr x9, ="
    expr_int_b = "\n    str x9, [x13]\n    mov w9, #2\n    strb w9, [x13, #127]\n"
    expr_float_a = "    ldr x15, ="
    expr_float_b = "\n    add x0, sp, x15\n    adrp x1, L_tyrion_direct_literal_"
    expr_float_c = "@PAGE\n    add x1, x1, L_tyrion_direct_literal_"
    expr_float_d = "@PAGEOFF\n    bl __tyrion_app_float_from_text\n"
    expr_bool_a = "\n    add x13, sp, x15\n    mov x9, #"
    expr_bool_b = "\n    str x9, [x13]\n    mov w9, #3\n    strb w9, [x13, #127]\n"
    expr_none_b = "\n    add x13, sp, x15\n    str xzr, [x13]\n    strb wzr, [x13, #127]\n"
    expr_string_a = "    ldr x15, ="
    expr_string_b = "\n    add x13, sp, x15\n    adrp x9, L_tyrion_direct_literal_"
    expr_string_c = "@PAGE\n    add x9, x9, L_tyrion_direct_literal_"
    expr_string_d = "@PAGEOFF\n    str x9, [x13]\n    mov x9, #"
    expr_string_e = "\n    str x9, [x13, #8]\n    mov w9, #4\n    strb w9, [x13, #127]\n"
    expr_var_a = "\n    add x13, sp, x15\n    ldr x15, ="
    expr_var_b = "\n    add x10, sp, x15\n    mov x0, x13\n    mov x1, x10\n"
    expr_var_b = expr_var_b + "    bl __tyrion_app_slot_copy\n"
    assign_a = "    ldr x15, ="
    assign_b = "\n    add x13, sp, x15\n    ldr x15, ="
    assign_c = "\n    add x10, sp, x15\n    mov x0, x13\n    mov x1, x10\n"
    assign_c = assign_c + "    bl __tyrion_app_slot_copy\n"
    attr_get_a = "    ldr x15, ="
    attr_get_b = "\n    add x0, sp, x15\n    ldr x15, ="
    attr_get_c = "\n    add x1, sp, x15\n    ldr x15, ="
    attr_get_d = "\n    add x2, sp, x15\n    bl __tyrion_app_object_attr_get\n"
    attr_set_a = "    ldr x15, ="
    attr_set_b = "\n    add x2, sp, x15\n    ldr x15, ="
    attr_set_c = "\n    add x0, sp, x15\n    ldr x15, ="
    attr_set_d = "\n    add x1, sp, x15\n    bl __tyrion_app_object_attr_set\n"
    object_new_a = "    ldr x15, ="
    object_new_b = "\n    add x0, sp, x15\n    mov x1, #"
    object_new_c = "\n    bl __tyrion_app_object_new\n"
    object_guard_a = "    ldr x15, ="
    object_guard_b = "\n    add x9, sp, x15\n    ldrb w10, [x9, #127]\n"
    object_guard_b = object_guard_b + "    cmp w10, #6\n    b.ne __tyrion_app_object_fail\n"
    object_guard_b = object_guard_b + "    ldr x9, [x9]\n    cbz x9, __tyrion_app_object_fail\n"
    object_guard_b = object_guard_b + "    ldr x9, [x9, #8]\n    cmp x9, #"
    object_guard_c = "\n    b.ne __tyrion_app_object_fail\n"
    unpack_len_a = "    ldr x15, ="
    unpack_len_b = "\n    add x0, sp, x15\n    bl __tyrion_app_iter_len\n    cmp x0, #"
