    method_endswith = "\n    add x2, sp, x15\n    bl __tyrion_app_string_endswith\n"
    append_a = "    ldr x15, ="
    append_b = "\n    add x0, sp, x15\n    ldr x15, ="
    append_c = "\n    add x1, sp, x15\n    bl __tyrion_app_list_append\n    ldr x15, ="
    append_d = "\n    add x0, sp, x15\n    ldr x15, ="
    append_e = "\n    add x1, sp, x15\n    bl __tyrion_app_slot_copy\n"
    mutation_commit_a = "    ldr x15, ="
    mutation_commit_b = "\n    add x0, sp, x15\n    ldr x15, ="
    mutation_commit_c = "\n    add x1, sp, x15\n    bl __tyrion_app_slot_copy\n"
    out = asm_cstr(out, "L_native_runtime_direct_list_new_a", list_new_a)
    out = asm_cstr(out, "L_native_runtime_direct_multi_begin", multi_begin)
    out = asm_cstr(out, "L_native_runtime_direct_multi_arg_a", multi_arg_a)
    out = asm_cstr(out, "L_native_runtime_direct_multi_arg_b", multi_arg_b)
    out = asm_cstr(out, "L_native_runtime_direct_multi_arg_c", multi_arg_c)
    out = asm_cstr(out, "L_native_runtime_direct_multi_call_a", multi_call_a)
    out = asm_cstr(out, "L_native_runtime_direct_multi_call_b", multi_call_b)
    out = asm_cstr(out, "L_native_runtime_direct_multi_range", multi_range)
    out = asm_cstr(out, "L_native_runtime_direct_multi_enumerate", multi_enumerate)
    out = asm_cstr(out, "L_native_runtime_direct_multi_sum", multi_sum)
    out = asm_cstr(out, "L_native_runtime_direct_multi_min", multi_min)
    out = asm_cstr(out, "L_native_runtime_direct_multi_max", multi_max)
    out = asm_cstr(out, "L_native_runtime_direct_multi_any", multi_any)
    out = asm_cstr(out, "L_native_runtime_direct_multi_all", multi_all)
    out = asm_cstr(out, "L_native_runtime_direct_multi_zip", multi_zip)
    out = asm_cstr(out, "L_native_runtime_direct_multi_end", multi_end)
