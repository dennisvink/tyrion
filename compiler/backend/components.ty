        out = asm_line(out, "cmp x9, #" + str(len(field_name)))
        out = asm_line(out, "b.ne __tyrion_app_token_builder_field_next_" + str(field_idx))
        out = asm_line(out, "ldr x0, [x20]")
        out = asm_addr(out, target, "x1", "__tyrion_app_builder_key_" + field_name)
        out = asm_line(out, "mov x2, #" + str(len(field_name)))
        out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
        out = asm_line(out, "cbz w0, __tyrion_app_token_builder_field_" + field_name)
        out = asm_label(out, "__tyrion_app_token_builder_field_next_" + str(field_idx))
        field_idx = field_idx + 1
    out = asm_line(out, "b __tyrion_app_oom")
    out = asm_label(out, "__tyrion_app_token_builder_field_kind")
    out = asm_line(out, "mov x25, #" + str(generated_builder_token_kind_offset()))
    out = asm_line(out, "b __tyrion_app_token_builder_field_string")
    out = asm_label(out, "__tyrion_app_token_builder_field_text")
    out = asm_line(out, "mov x25, #" + str(generated_builder_token_text_offset()))
    out = asm_label(out, "__tyrion_app_token_builder_field_string")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "add x10, x24, x25")
    out = asm_line(out, "ldr x9, [x10, #8]")
    out = asm_line(out, "add x0, x9, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_oom")
    out = asm_line(out, "str x0, [x19]")
    out = asm_line(out, "add x10, x24, x25")
    out = asm_line(out, "ldr x1, [x10]")
    out = asm_line(out, "ldr x2, [x10, #8]")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "add x10, x24, x25")
    out = asm_line(out, "ldr x9, [x10, #8]")
    out = asm_line(out, "str x9, [x19, #8]")
    out = asm_line(out, "ldr x10, [x19]")
    out = asm_line(out, "strb wzr, [x10, x9]")
    out = asm_line(out, "mov w9, #4")
    out = asm_line(out, "strb w9, [x19, #127]")
    out = asm_line(out, "b __tyrion_app_token_builder_field_done")
    out = asm_label(out, "__tyrion_app_token_builder_field_line")
    out = asm_line(out, "mov x25, #" + str(generated_builder_token_line_offset()))
    out = asm_line(out, "b __tyrion_app_token_builder_field_int")
    out = asm_label(out, "__tyrion_app_token_builder_field_column")
    out = asm_line(out, "mov x25, #" + str(generated_builder_token_column_offset()))
    out = asm_label(out, "__tyrion_app_token_builder_field_int")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "ldr x9, [x24, x25]")
    out = asm_line(out, "str x9, [x19]")
    out = asm_line(out, "mov w9, #2")
    out = asm_line(out, "strb w9, [x19, #127]")
    out = asm_label(out, "__tyrion_app_token_builder_field_done")
    out = asm_line(out, "ldr x25, [sp, #64]")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    out = asm_section(out, target["rodata_section"])
    keys = ["kind", "text", "line", "column"]
    for key in keys:
        out = asm_cstr(out, "__tyrion_app_builder_key_" + key, key)
    return asm_section(out, target["text_section"])


def emit_runtime_native_direct_runtime(out, target, plan):
    value_tag_x0 = generated_value_tag_mem("x0")
    value_tag_x19 = generated_value_tag_mem("x19")
    value_tag_x20 = generated_value_tag_mem("x20")
    value_tag_x21 = generated_value_tag_mem("x21")
    value_tag_x22 = generated_value_tag_mem("x22")

    # The portable runtime text names a few libc/libm calls without a target
    # prefix. Mach-O keeps those symbols underscored, while ELF does not.
    # Provide aliases at the runtime boundary so C-bootstrap-generated
    # Darwin ARM64 fixtures link like the native compiler path.
    if target["backend"] == "darwin-aarch64":
        out = asm_raw(out, ".globl memmove\n.set memmove, _memmove\n.globl pow\n.set pow, _pow\n")
    # The direct application runtime uses this helper for errors raised by
    # native builtins (notably zip(strict=True)).  Keep it in the portable
    # direct runtime rather than relying on the compiler-only asm-writer
    # component, which is not emitted for Linux AArch64 applications.
    out = asm_label(out, "L_generated_value_set_cstr")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "cbz x19, L_generated_value_set_cstr_fail")
    out = asm_line(out, "cbz x20, L_generated_value_set_cstr_fail")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "cmp x21, #120")
    out = asm_line(out, "b.hi L_generated_value_set_cstr_heap")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "mov x22, #0")
    out = asm_label(out, "L_generated_value_set_cstr_inline_loop")
    out = asm_line(out, "ldrb w9, [x20, x22]")
    out = asm_line(out, "strb w9, [x19, x22]")
    out = asm_line(out, "add x22, x22, #1")
    out = asm_line(out, "cbnz w9, L_generated_value_set_cstr_inline_loop")
    out = asm_line(out, "str x21, [x19, #8]")
    out = asm_line(out, "mov w9, #4")
    out = asm_line(out, "strb w9, [x19, #127]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_generated_value_set_cstr_return")
    out = asm_label(out, "L_generated_value_set_cstr_heap")
    out = asm_line(out, "add x0, x21, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, L_generated_value_set_cstr_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "mov x1, x20")
    out = asm_line(out, "add x2, x21, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "str x22, [x19]")
    out = asm_line(out, "str x21, [x19, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, [x19, #127]")
    out = asm_line(out, "mov w9, #1")
    out = asm_line(out, "strb w9, [x19, #126]")
    out = asm_line(out, "mov w0, #1")
    out = asm_line(out, "b L_generated_value_set_cstr_return")
    out = asm_label(out, "L_generated_value_set_cstr_fail")
    out = asm_line(out, "mov w0, #0")
    out = asm_label(out, "L_generated_value_set_cstr_return")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_lifecycle_text(), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_strings_text(), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_collections_text(target), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_terminal_key_text(target), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_tcp_connect_text(target), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_tcp_io_text(target), target)
    out = runtime_native_append_target_asm_text(out, native_runtime_direct_ascii_text_text(target), target)
    extension_idx = 0
    while extension_idx < len(plan["extensions"]):
        if plan["extensions"][extension_idx]["name"] == "tls":
            out = runtime_native_append_target_asm_text(out, native_runtime_direct_tls_io_text(target), target)
        extension_idx = extension_idx + 1
    out = emit_runtime_native_direct_process_runtime(out, target)
    out = emit_runtime_native_direct_host_extension_runtime(out, target, plan)
    out = emit_runtime_native_builder_runtime(out, target)
    out = asm_label(out, "__tyrion_app_input")
