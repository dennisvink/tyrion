    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_4", tcp_call_suffix_4)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_5", tcp_call_suffix_5)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_6", tcp_call_suffix_6)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_7", tcp_call_suffix_7)
