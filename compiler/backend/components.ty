    out = asm_line(out, "ldrb w9, [x21, x22]")
    out = asm_line(out, "cmp w9, #10")
    out = asm_line(out, "b.eq __tyrion_app_input_publish")
    out = asm_line(out, "add x22, x22, #1")
    out = asm_line(out, "cmp x22, x23")
    out = asm_line(out, "b.lo __tyrion_app_input_read")
    out = asm_line(out, "lsl x24, x23, #1")
    out = asm_line(out, "cmp x24, x23")
    out = asm_line(out, "b.ls __tyrion_app_oom")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "mov x1, x24")
    out = asm_line(out, "bl " + asm_call_name(target, "realloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_oom")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x23, x24")
    out = asm_line(out, "b __tyrion_app_input_read")
    out = asm_label(out, "__tyrion_app_input_publish")
    out = asm_line(out, "strb wzr, [x21, x22]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "str x21, [x19]")
    out = asm_line(out, "str x22, [x19, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, " + value_tag_x19)
    out = asm_line(out, "mov w25, #1")
    out = asm_line(out, "b __tyrion_app_input_done")
    out = asm_label(out, "__tyrion_app_input_eof")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_addr(out, target, "x9", "__tyrion_app_input_eof_error")
    out = asm_line(out, "str x9, [x19]")
    out = asm_line(out, "mov x9, #33")
    out = asm_line(out, "str x9, [x19, #8]")
    out = asm_line(out, "mov w9, #4")
