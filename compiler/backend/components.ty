    if plan_kind == "native_string_concat_body":
        return emit_exec_fn_string_concat(out, target, name)
    if plan_kind == "native_asm_writer_open_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "native_asm_writer_append_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "native_asm_writer_close_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "native_asm_writer_bytes_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "native_asm_writer_set_backend_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "native_asm_writer_is_x86_body":
        return emit_exec_fn_native_asm_writer(out, target, name)
    if plan_kind == "method_append_body":
        return emit_exec_fn_method_append_native(out, target, name)
    if plan_kind == "usage_body":
