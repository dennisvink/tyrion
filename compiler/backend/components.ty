def emit_direct_value_collection_templates(out, target):
    multi_begin = "    sub sp, sp, #512\n"
    multi_begin = multi_begin + "    mov x0, sp\n    mov x1, #512\n"
    multi_begin = multi_begin + "    bl __tyrion_app_zero_region\n"
    multi_arg_a = "    add x14, sp, #512\n    add x0, sp, #"
    multi_arg_b = "\n    ldr x15, ="
    multi_arg_c = "\n    add x1, x14, x15\n    bl __tyrion_app_slot_copy\n"
    multi_call_a = "    add x14, sp, #512\n    ldr x15, ="
    multi_call_b = "\n    add x0, x14, x15\n    mov x1, sp\n    mov x2, #"
    multi_range = "\n    bl __tyrion_app_range_full\n"
    multi_enumerate = "\n    bl __tyrion_app_enumerate\n"
    multi_sum = "\n    bl __tyrion_app_builtin_sum\n"
    multi_min = "\n    bl __tyrion_app_builtin_min\n"
    multi_max = "\n    bl __tyrion_app_builtin_max\n"
    multi_any = "\n    bl __tyrion_app_builtin_any\n"
    multi_all = "\n    bl __tyrion_app_builtin_all\n"
    # The general builtin emitter does not carry keyword metadata into the
    # compact multi-call ABI. Give zip an explicit false ValueSlot and use a
    # second reference for its exception slot so the helper sees a valid ABI
    # even for ordinary zip(a, b) calls emitted through this path.
    multi_zip = "\n    add x3, sp, #384\n    str xzr, [x3]\n    mov w9, #3\n    strb w9, [x3, #127]\n    add x4, sp, #400\n    bl __tyrion_app_builtin_zip\n    ldrb w9, [x4, #127]\n    cbz w9, L_native_runtime_direct_multi_zip_ok\n    mov x0, x4\n    bl __tyrion_app_unhandled_exception\nL_native_runtime_direct_multi_zip_ok:\n"
    multi_end = "    mov x0, sp\n    mov x1, #512\n"
    multi_end = multi_end + "    bl __tyrion_app_cleanup_region\n    add sp, sp, #512\n"
    list_new_a = "    ldr x15, ="
    list_new_b = "\n    add x0, sp, x15\n    mov x1, #"
    list_new_c = "\n    bl __tyrion_app_list_new\n"
    list_set_a = "    ldr x15, ="
    list_set_b = "\n    add x0, sp, x15\n    mov x1, #"
    list_set_c = "\n    ldr x15, ="
    list_set_d = "\n    add x2, sp, x15\n    bl __tyrion_app_list_set\n"
    set_new_a = "    ldr x15, ="
    set_new_b = "\n    add x0, sp, x15\n    mov x1, #"
    set_new_c = "\n    bl __tyrion_app_set_new\n"
    set_insert_a = "    ldr x15, ="
    set_insert_b = "\n    add x0, sp, x15\n    ldr x15, ="
    set_insert_c = "\n    add x1, sp, x15\n    bl __tyrion_app_set_insert\n"
    index_a = "    ldr x15, ="
    index_b = "\n    add x0, sp, x15\n    ldr x15, ="
    index_c = "\n    add x1, sp, x15\n    ldr x15, ="
    index_d = "\n    add x2, sp, x15\n    bl __tyrion_app_index\n"
    slice_a = "    ldr x15, ="
    slice_b = "\n    add x0, sp, x15\n    ldr x15, ="
    slice_c = "\n    add x1, sp, x15\n    ldr x15, ="
    slice_d = "\n    add x2, sp, x15\n    ldr x15, ="
    slice_e = "\n    add x3, sp, x15\n    bl __tyrion_app_slice\n"
    slice_none_a = "    ldr x15, ="
    slice_none_b = "\n    add x13, sp, x15\n    str xzr, [x13]\n    strb wzr, [x13, #127]\n"
    set_index_a = "    ldr x15, ="
    set_index_b = "\n    add x0, sp, x15\n    ldr x15, ="
    set_index_c = "\n    add x1, sp, x15\n    ldr x15, ="
    set_index_d = "\n    add x2, sp, x15\n    bl __tyrion_app_set_index\n"
    len_a = "    ldr x15, ="
    len_b = "\n    add x0, sp, x15\n    ldr x15, ="
    len_c = "\n    add x1, sp, x15\n    bl __tyrion_app_len\n"
    dict_new_a = "    ldr x15, ="
    dict_new_b = "\n    add x0, sp, x15\n    mov x1, #"
    dict_new_c = "\n    bl __tyrion_app_dict_new\n"
    dict_set_a = "    ldr x15, ="
    dict_set_b = "\n    add x0, sp, x15\n    ldr x15, ="
    dict_set_c = "\n    add x1, sp, x15\n    ldr x15, ="
    dict_set_d = "\n    add x2, sp, x15\n    bl __tyrion_app_dict_set\n"
    open_a = "    ldr x15, ="
    open_b = "\n    add x0, sp, x15\n    ldr x15, ="
    open_c = "\n    add x1, sp, x15\n    ldr x15, ="
    open_d = "\n    cmp x15, #-1\n    b.eq 1f\n    add x2, sp, x15\n    b 2f\n1:\n"
    open_d = open_d + "    mov x2, #0\n2:\n    bl __tyrion_app_file_open\n"
    method_a = "    ldr x15, ="
    method_b = "\n    add x0, sp, x15\n    ldr x15, ="
    method_c = "\n    add x1, sp, x15\n    ldr x15, ="
    method_read = "\n    cmp x15, #-1\n    b.eq 1f\n    add x2, sp, x15\n    b 2f\n1:\n"
    method_read = method_read + "    mov x2, #0\n2:\n    bl __tyrion_app_file_read\n"
