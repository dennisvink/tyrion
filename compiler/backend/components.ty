    if plan_kind == "native_run_tool_body":
        return emit_exec_fn_native_run_tool(out, target, name)
    if plan_kind == "native_runtime_program_build_body":
        body_plan = lowered_function_body_plan({}, name)
        fn = {"name": name, "body_plan": body_plan}
        return emit_exec_fn_runtime_native_program_build_direct(out, target, fn)
    if plan_kind == "link_asm_body":
        return emit_exec_fn_link_asm(out, target, name)
    if plan_kind == "build_native_body":
