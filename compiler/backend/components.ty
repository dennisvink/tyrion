    fail("unsupported scalar fixed lowered function: " + name + "/" + plan_kind)

def emit_lowered_function_exec_bodies_from_inventory(out, target, inventory):
    out = emit_lowered_function_generic_exec_bodies_from_inventory(out, target, inventory)
    return emit_lowered_function_fixed_exec_bodies_from_inventory(out, target, inventory)

def emit_lowered_function_generic_exec_bodies_from_inventory(out, target, inventory):
    out = emit_exec_fn_generic_source_bodies_from_inventory(out, target, inventory)
    return out

def emit_lowered_function_generic_exec_bodies_partition_0(out, target, inventory):
    return emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, 0, 170)

def emit_lowered_function_generic_exec_bodies_partition_1(out, target, inventory):
    return emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, 170, 340)

def emit_lowered_function_generic_exec_bodies_partition_2(out, target, inventory):
    return emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, 340, 510)

def emit_lowered_function_generic_exec_bodies_partition_3(out, target, inventory):
    rows = lowered_function_inventory_rows(inventory)
    return emit_exec_fn_generic_source_bodies_from_inventory_range(out, target, inventory, 510, len(rows))

def emit_lowered_function_fixed_exec_bodies_from_inventory(out, target, inventory):
    count_rows = lowered_function_inventory_rows(inventory)
    row_count = len(count_rows)
    idx = 0
    while idx < row_count:
        name = lowered_function_inventory_cell(inventory, idx, 0)
        plan_kind = lowered_function_inventory_native_plan_kind(name)
        if plan_kind != "generic_source_body":
            out = emit_lowered_function_fixed_exec_body(out, target, name, plan_kind)
        idx = idx + 1
    return out

def emit_object_source(writer, lowered):
    if lowered["contract"] != "tyrion-lowered-program-v1":
        fail("invalid lowered program boundary record")
    target = backend_require_operation(lowered["target"], "runtime-object")
    return backend_emit_runtime_object_source(writer, target, lowered["program"], lowered["runtime"])

def emit_runtime_native_direct_call_plan(out, fn_plan, args, call_context):
    receiver_slot = call_context["receiver_slot"]
    dst = call_context["dst"]
    temp = call_context["temp"]
    plan = call_context["plan"]
    state = call_context["state"]
    arg_count = len(args)
    param_count = len(fn_plan["params"])
    bound_actuals = []
    param_idx = 0
    while param_idx < param_count:
        bound_actuals = method_append(bound_actuals, -1)
        param_idx = param_idx + 1
    first_user_param = 0
    if receiver_slot >= 0:
        if param_count == 0:
            fail("runtime-native method has no receiver parameter: " + fn_plan["name"])
        first_user_param = 1
    next_positional = first_user_param
    keyword_seen = False
    arg_idx = 0
    while arg_idx < arg_count:
        arg = args[arg_idx]
        arg_value = arg
        if arg["kind"] == "kwarg":
            keyword_seen = True
            target_idx = first_user_param
            while target_idx < param_count and fn_plan["params"][target_idx] != arg["name"]:
                target_idx = target_idx + 1
            if target_idx == param_count:
                fail("runtime-native direct unknown keyword: " + fn_plan["name"] + "." + arg["name"])
            arg_value = arg["value"]
        else:
            if keyword_seen:
                fail("runtime-native direct positional argument follows keyword: " + fn_plan["name"])
            target_idx = next_positional
            next_positional = next_positional + 1
            if target_idx >= param_count:
                fail("runtime-native direct too many arguments: " + fn_plan["name"])
        if bound_actuals[target_idx] != -1:
            fail("runtime-native direct duplicate argument: " + fn_plan["params"][target_idx])
        bound_actuals[target_idx] = arg_idx
        out = emit_runtime_native_direct_expr(out, arg_value, temp + arg_idx, temp + arg_count + param_count + 1, plan, state)
        arg_idx = arg_idx + 1
    bound_base = temp + arg_count
    # The top-level legacy route can hand us a destination that aliases the
    # first temporary slot. Keep the callee's bound-argument frame distinct;
    # otherwise its prologue releases the result slot before the call and the
    # return value is lost (or the caller crashes during cleanup).
    if bound_base == dst:
        bound_base = bound_base + 1
    if receiver_slot >= 0:
        out = runtime_native_direct_slot_addr_v2(out, "x0", bound_base)
        out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        bound_actuals[0] = -2
    param_idx = first_user_param
    while param_idx < param_count:
        actual_idx = bound_actuals[param_idx]
        if actual_idx >= 0:
            out = runtime_native_direct_slot_addr_v2(out, "x0", bound_base + param_idx)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + actual_idx)
            out = asm_line(out, "bl __tyrion_app_slot_move")
        else:
            param = fn_plan["parameter_records"][param_idx]
            has_default = False
            if "has_default" in param:
                has_default = param["has_default"]
            if not has_default:
                fail("runtime-native direct missing argument: " + fn_plan["name"] + "." + fn_plan["params"][param_idx])
            out = emit_runtime_native_direct_expr(out, param["default"], bound_base + param_idx, temp + arg_count + param_count + 1, plan, state)
        param_idx = param_idx + 1
    call_exception_slot = bound_base + param_count
    out = runtime_native_direct_slot_addr_v2(out, "x0", call_exception_slot)
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = runtime_native_direct_slot_addr_v2(out, "x0", bound_base)
    out = asm_line(out, "mov x1, #" + str(param_count))
    out = runtime_native_direct_slot_addr_v2(out, "x2", dst)
    out = runtime_native_direct_slot_addr_v2(out, "x3", call_exception_slot)
    out = asm_line(out, "bl " + fn_plan["label"])
    out = runtime_native_direct_slot_addr_v2(out, "x9", call_exception_slot)
    out = asm_line(out, "ldrb w10, " + generated_value_tag_mem("x9"))
    out = asm_line(out, "cbz w10, 97f")
    if state["raise_label"] == "":
        # x9 addresses the top-level call's exception slot. x22 is not a
        # stable exception register in this lowering path.
        out = asm_line(out, "mov x0, x9")
        out = asm_line(out, "b __tyrion_app_unhandled_exception")
    else:
        out = runtime_native_direct_slot_addr_v2(out, "x0", state["exception_slot"])
        out = runtime_native_direct_slot_addr_v2(out, "x1", call_exception_slot)
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        out = runtime_native_direct_slot_addr_v2(out, "x0", call_exception_slot)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = asm_line(out, "b " + state["raise_label"])
    return asm_label(out, "97")

def runtime_native_direct_has_function(plan, name):
    for candidate in plan["functions"]:
        if candidate["name"] == name:
            return True
    return False

def emit_runtime_native_direct_static_vector_call(out, fn_plan, vector_expr, dst, temp, plan, state):
    # AArch64's legacy direct ABI has no first-class closure object.  This
    # static-vector lane still supports `add(*values)` without inventing a
    # target-local value tag: the callee label is known at compile time and
    # the vector is expanded into its fixed parameter frame at runtime.
    if len(fn_plan["params"]) == 0:
        fail("runtime-native direct starred call requires parameters: " + fn_plan["name"])
    vector_slot = temp
    item_slot = temp + 1
    exception_slot = temp + 2
    bound_base = temp + 3
    out = emit_runtime_native_direct_expr(out, vector_expr, vector_slot, temp + 4, plan, state)
    out = runtime_native_direct_slot_addr_v2(out, "x0", vector_slot)
    out = asm_line(out, "bl __tyrion_app_iter_len")
    vector_id = __tyrion_native_ast_builder_len(state["branch_ids"], 0)
    __tyrion_native_ast_builder_append(state["branch_ids"], 0, vector_id)
    vector_label = "__tyrion_app_vector_call_" + str(state["frame"]["id"]) + "_" + str(vector_id)
    out = asm_line(out, "cmp x0, #" + str(len(fn_plan["params"])))
    out = asm_line(out, "b.ne " + vector_label + "_arity_fail")
    param_idx = 0
    while param_idx < len(fn_plan["params"]):
        out = runtime_native_direct_slot_addr_v2(out, "x0", item_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", vector_slot)
        out = asm_line(out, "mov x2, #" + str(param_idx))
        out = asm_line(out, "bl __tyrion_app_iter_at")
        out = runtime_native_direct_slot_addr_v2(out, "x0", bound_base + param_idx)
        out = runtime_native_direct_slot_addr_v2(out, "x1", item_slot)
        out = asm_line(out, "bl __tyrion_app_slot_move")
        param_idx = param_idx + 1
    out = runtime_native_direct_slot_addr_v2(out, "x0", exception_slot)
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = runtime_native_direct_slot_addr_v2(out, "x0", bound_base)
    out = asm_line(out, "mov x1, #" + str(len(fn_plan["params"])))
    out = runtime_native_direct_slot_addr_v2(out, "x2", dst)
    out = runtime_native_direct_slot_addr_v2(out, "x3", exception_slot)
    out = asm_line(out, "bl " + fn_plan["label"])
    out = asm_line(out, "b " + vector_label + "_exception")
    out = asm_label(out, vector_label + "_arity_fail")
    # Keep the fixed direct ABI's existing failure convention for now. A
    # dedicated dynamic-arity diagnostic belongs with the eventual first-class
    # closure descriptor rather than introducing an unregistered literal here.
    out = asm_line(out, "b " + vector_label + "_done")
    out = asm_label(out, vector_label + "_exception")
    out = runtime_native_direct_slot_addr_v2(out, "x9", exception_slot)
    out = asm_line(out, "ldrb w10, " + generated_value_tag_mem("x9"))
    out = asm_line(out, "cbz w10, " + vector_label + "_done")
    if state["raise_label"] == "":
        out = asm_line(out, "mov x0, x9")
        out = asm_line(out, "b __tyrion_app_unhandled_exception")
    else:
        out = runtime_native_direct_slot_addr_v2(out, "x0", state["exception_slot"])
        out = runtime_native_direct_slot_addr_v2(out, "x1", exception_slot)
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        out = asm_line(out, "b " + state["raise_label"])
    out = asm_label(out, vector_label + "_done")
    return out

def runtime_native_direct_classes_with_method(plan, method_name):
    matches = []
    for class_plan in plan["classes"]:
        for candidate in class_plan["methods"]:
            if candidate == method_name:
                matches = method_append(matches, class_plan)
    return matches

def runtime_native_direct_var_addr(out, register, expr, plan, state):
    synthetic_index = 0
    while synthetic_index < len(state["synthetic_slots"]):
        synthetic = state["synthetic_slots"][synthetic_index]
        if synthetic["name"] == expr["value"]:
            return runtime_native_direct_slot_addr_v2(out, register, synthetic["slot"])
        synthetic_index = synthetic_index + 1
    source = runtime_native_direct_local_index_or_none(state["frame"], expr["value"])
    if source >= 0:
        return runtime_native_direct_slot_addr_v2(out, register, source)
    global_index = runtime_native_direct_global_index(plan, expr["value"])
    out = asm_addr(out, state["target"], register, "__tyrion_app_global_base")
    out = asm_line(out, "ldr " + register + ", [" + register + "]")
    out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(global_index), state["target"])
    return asm_line(out, "add " + register + ", " + register + ", x15")

def emit_aarch64_immediate(out, register, value):
    # Darwin's assembler cannot keep a literal-pool load in range in the
    # generated compiler-sized object. Materialise constants in the register
    # instead, which is valid for both AArch64 targets.
    negative = value < 0
    magnitude = value
    if negative:
        magnitude = 0 - value - 1
    low = magnitude & 65535
    if negative:
        out = asm_line(out, "movn " + register + ", #" + str(low))
    else:
        out = asm_line(out, "movz " + register + ", #" + str(low))
    shift = 16
    while shift < 64:
        chunk = (magnitude >> shift) & 65535
        if chunk != 0:
            out = asm_line(out, "movk " + register + ", #" + str(chunk) + ", lsl #" + str(shift))
        shift = shift + 16
    return out

def emit_runtime_native_immediate(out, register, value, target):
    if target["backend"] == "darwin-aarch64" or target["backend"] == "linux-aarch64":
        return emit_aarch64_immediate(out, register, value)
    return asm_line(out, "ldr " + register + ", =" + str(value))

def runtime_native_direct_synthetic_var(name, slot):
    return {"kind": "var", "value": name, "items": []}

def runtime_native_direct_synthetic_call(name, args):
    return {"kind": "call", "callee": runtime_native_direct_synthetic_var(name, -1), "args": args, "items": []}

def runtime_native_direct_expr_fingerprint(expr):
    kind = expr["kind"]
    if kind == "var":
        return application_name_hash(expr["value"])
    if kind == "int":
        return expr["value"]
    if kind == "string":
        return application_name_hash(expr["value"])
    if kind == "list" or kind == "tuple":
        value = len(expr["items"]) + 1
        idx = 0
        while idx < len(expr["items"]):
            value = value * 131 + runtime_native_direct_expr_fingerprint(expr["items"][idx])
            idx = idx + 1
        return value
    if kind == "call":
        value = application_name_hash(expr["callee"]["value"]) + len(expr["args"])
        idx = 0
        while idx < len(expr["args"]):
            value = value * 131 + runtime_native_direct_expr_fingerprint(expr["args"][idx])
            idx = idx + 1
        return value
    return 0

def runtime_native_direct_raise_builtin_error(out, dst, state, plan, message):
    # Builtin argument errors must remain catchable.  Materialize the class
    # token in the expression destination, then route it through the same
    # exception slot used by declared calls and zip/next.
    label = "L_tyrion_direct_builtin_typeerror"
    if message != "TypeError":
        fail("unsupported native builtin error token: " + message)
    out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
    out = asm_addr(out, state["target"], "x9", label)
    out = asm_line(out, "str x9, [x13]")
    out = asm_line(out, "mov x9, #9")
    out = asm_line(out, "str x9, [x13, #8]")
    out = asm_line(out, "mov w9, #4")
    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
    if state["raise_label"] == "":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        return asm_line(out, "b __tyrion_app_unhandled_exception")
    out = runtime_native_direct_slot_addr_v2(out, "x0", state["exception_slot"])
    out = runtime_native_direct_slot_addr_v2(out, "x1", dst)
    out = asm_line(out, "bl __tyrion_app_slot_copy")
    out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
    out = asm_line(out, "bl __tyrion_app_slot_release")
    return asm_line(out, "b " + state["raise_label"])

def runtime_native_direct_lower_map_filter_expr(out, expr, dst, temp, plan, state, map_mode):
    # AArch64's legacy direct ABI cannot dispatch an arbitrary closure from
    # the core map/filter implementation. Lower the public call directly to
    # the already-supported comprehension emitter instead. Named callbacks
    # remain statically resolvable, while the synthetic iteration variable is
    # assigned a temporary frame slot (never a source-level local).
    if len(expr["args"]) < 2 and map_mode:
        return runtime_native_direct_raise_builtin_error(out, dst, state, plan, "TypeError")
    if len(expr["args"]) != 2 and not map_mode:
        return runtime_native_direct_raise_builtin_error(out, dst, state, plan, "TypeError")
    callback = expr["args"][0]
    if (callback["kind"] == "none" and map_mode) or callback["kind"] == "int" or callback["kind"] == "float" or callback["kind"] == "bool" or callback["kind"] == "string":
        return runtime_native_direct_raise_builtin_error(out, dst, state, plan, "TypeError")
    callback_name = ""
    callback_label = "callback"
    known_callback_plan = none
    if callback["kind"] == "lambda":
        callback_plan = runtime_native_direct_lambda_plan_for_expr(plan, state["frame"]["name"], callback, state["lambda_index"])
        known_callback_plan = callback_plan
        state["lambda_index"] = state["lambda_index"] + 1
        callback_name = callback_plan["name"]
        callback_label = callback_plan["label"]
        callback = runtime_native_direct_synthetic_var(callback_name, -1)
    elif callback["kind"] == "var":
        callback_name = callback["value"]
        callback_plan = runtime_native_direct_function_plan(plan, callback_name)
        callback_label = callback_plan["label"]
    iterable_args = []
    arg_idx = 1
    while arg_idx < len(expr["args"]):
        argument = expr["args"][arg_idx]
        if argument["kind"] == "starred":
            # Literal packs can be expanded directly. A dynamic pack is
            # lowered below into fixed indexed lanes when callback arity is
            # statically known.
            if argument["value"]["kind"] == "list":
                for packed in argument["value"]["items"]:
                    iterable_args = method_append(iterable_args, packed)
            else:
                # A dynamic pack still has a statically known callback arity
                # for named functions and lambdas. Materialize the required
                # iterable lanes as indexed views of the pack; this preserves
                # map's shortest-input behavior without inventing a dynamic
                # closure ABI for the legacy AArch64 emitter.
                callback_plan = known_callback_plan
                if callback_plan == none and callback["kind"] == "var":
                    callback_plan = runtime_native_direct_function_plan(plan, callback["value"])
                if callback_plan == none:
                    fail("map dynamic starred iterables require a statically known callback")
                required = len(callback_plan["params"]) - len(iterable_args)
                if required < 1:
                    fail("map dynamic starred iterable arity mismatch")
                pack_idx = 0
                while pack_idx < required:
                    iterable_args = method_append(iterable_args, {"kind": "index", "receiver": argument["value"], "index": {"kind": "int", "value": pack_idx}, "items": []})
                    pack_idx = pack_idx + 1
        else:
            iterable_args = method_append(iterable_args, argument)
        arg_idx = arg_idx + 1
    item_name = "__tyrion_direct_item_" + state["frame"]["label"] + "_" + str(dst) + "_" + callback_label
    # Keep the synthetic item outside the callback's normal temporary window;
    # filter must retain the item while evaluating its predicate.
    item_slot = temp + plan["temporary_slots"] + 4
    state["synthetic_slots"] = []
    state["synthetic_slots"] = method_append(state["synthetic_slots"], {"name": item_name, "slot": item_slot})
    item_var = runtime_native_direct_synthetic_var(item_name, item_slot)
    iterable = iterable_args[0]
    callback_args = [item_var]
    if len(iterable_args) > 1:
        zip_args = []
        for argument in iterable_args:
            zip_args = method_append(zip_args, argument)
        iterable = runtime_native_direct_synthetic_call("zip", zip_args)
        callback_args = [{"kind": "starred", "value": item_var, "items": []}]
    if map_mode:
        mapped = {"kind": "call", "callee": callback, "args": callback_args, "items": []}
        condition = {"kind": "bool", "value": True, "items": []}
        comprehension = {"kind": "comprehension", "out_kind": "list", "expr": mapped, "key": none, "value": none, "target": item_name, "iterable": iterable, "condition": condition, "items": []}
    else:
        condition = item_var
        if callback["kind"] != "none":
            condition = {"kind": "call", "callee": callback, "args": callback_args, "items": []}
        comprehension = {"kind": "comprehension", "out_kind": "list", "expr": item_var, "key": none, "value": none, "target": item_name, "iterable": iterable, "condition": condition, "items": []}
    if "source_pos" in expr:
        comprehension["source_pos"] = expr["source_pos"]
    return emit_runtime_native_direct_expr(out, comprehension, dst, temp, plan, state)

def emit_runtime_native_direct_expr(out, expr, dst, temp, plan, state):
    value_tag_x13 = generated_value_tag_mem("x13")

    kind = expr["kind"]
    out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
    if kind == "none":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        out = asm_line(out, "str xzr, [x13]")
        return asm_line(out, "strb wzr, " + value_tag_x13)
    if kind == "bool":
        value = 0
        if expr["value"]:
            value = 1
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        out = asm_line(out, "mov x9, #" + str(value))
        out = asm_line(out, "str x9, [x13]")
        out = asm_line(out, "mov w9, #3")
        return asm_line(out, "strb w9, " + value_tag_x13)
    if kind == "int":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        out = emit_runtime_native_immediate(out, "x9", expr["value"], state["target"])
        out = asm_line(out, "str x9, [x13]")
        out = asm_line(out, "mov w9, #2")
        return asm_line(out, "strb w9, " + value_tag_x13)
    if kind == "float":
        literal_label = runtime_native_direct_literal_label(plan, "float", expr["value"])
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_addr(out, state["target"], "x1", literal_label)
        return asm_line(out, "bl __tyrion_app_float_from_text")
    if kind == "string":
        literal_label = runtime_native_direct_literal_label(plan, "string", expr["value"])
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        out = asm_addr(out, state["target"], "x9", literal_label)
        out = asm_line(out, "str x9, [x13]")
        out = asm_line(out, "mov x9, #" + str(len(expr["value"])))
        out = asm_line(out, "str x9, [x13, #8]")
        out = asm_line(out, "mov w9, #4")
        return asm_line(out, "strb w9, " + value_tag_x13)
    if kind == "var":
        if expr["value"] == "SEEK_SET" or expr["value"] == "SEEK_CUR" or expr["value"] == "SEEK_END":
            seek_value = 0
            if expr["value"] == "SEEK_CUR":
                seek_value = 1
            elif expr["value"] == "SEEK_END":
                seek_value = 2
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "bl __tyrion_app_slot_release")
            out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
            out = asm_line(out, "mov x9, #" + str(seek_value))
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov w9, #2")
            return asm_line(out, "strb w9, " + value_tag_x13)
        source = runtime_native_direct_local_index_or_none(state["frame"], expr["value"])
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        synthetic_source = -1
        synthetic_idx = 0
        while synthetic_idx < len(state["synthetic_slots"]):
            synthetic = state["synthetic_slots"][synthetic_idx]
            if synthetic["name"] == expr["value"]:
                synthetic_source = synthetic["slot"]
                break
            synthetic_idx = synthetic_idx + 1
        if synthetic_source >= 0:
            out = runtime_native_direct_slot_addr_v2(out, "x1", synthetic_source)
        elif source >= 0:
            out = runtime_native_direct_slot_addr_v2(out, "x1", source)
        else:
            global_index = runtime_native_direct_global_index(plan, expr["value"])
            out = asm_addr(out, state["target"], "x1", "__tyrion_app_global_base")
            out = asm_line(out, "ldr x1, [x1]")
            out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(global_index), state["target"])
            out = asm_line(out, "add x1, x1, x15")
        return asm_line(out, "bl __tyrion_app_slot_copy")
    if kind == "list" or kind == "tuple":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "mov x1, #" + str(len(expr["items"])))
        if kind == "tuple" and state["frame"]["name"] == "divmod":
            out = asm_line(out, "bl __tyrion_app_tuple_new")
        else:
            out = asm_line(out, "bl __tyrion_app_list_new")
        item_idx = 0
        for item in expr["items"]:
            out = emit_runtime_native_direct_expr(out, item, temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "mov x1, #" + str(item_idx))
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp)
            out = asm_line(out, "bl __tyrion_app_list_set")
            item_idx = item_idx + 1
        return out
    if kind == "dict":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "mov x1, #" + str(len(expr["entries"])))
        out = asm_line(out, "bl __tyrion_app_dict_new")
        for entry in expr["entries"]:
            out = emit_runtime_native_direct_expr(out, entry["key"], temp, temp + 2, plan, state)
            out = emit_runtime_native_direct_expr(out, entry["value"], temp + 1, temp + 2, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            out = asm_line(out, "bl __tyrion_app_dict_set")
        return out
    if kind == "set":
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "mov x1, #" + str(len(expr["items"])))
        out = asm_line(out, "bl __tyrion_app_set_new")
        for item in expr["items"]:
            out = emit_runtime_native_direct_expr(out, item, temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = asm_line(out, "bl __tyrion_app_set_insert")
        return out
    if kind == "comprehension":
        # State is passed as value records, so mutable counters do not survive
        # sibling expressions. Parser source positions are stable per call.
        expr_id = state["frame"]["label"] + "_" + str(dst) + "_" + expr["target"]
        if "source_pos" in expr:
            expr_id = state["frame"]["label"] + "_" + str(expr["source_pos"])
        fingerprint = runtime_native_direct_expr_fingerprint(expr["iterable"])
        if fingerprint < 0:
            fingerprint = 0 - fingerprint
        expr_id = expr_id + "_" + str(fingerprint)
        test_label = "__tyrion_app_comp_test_" + str(expr_id)
        advance_label = "__tyrion_app_comp_advance_" + str(expr_id)
        end_label = "__tyrion_app_comp_end_" + str(expr_id)
        iterable_slot = temp
        index_slot = temp + 1
        value_slot = temp + 2
        condition_slot = temp + 3
        result_a_slot = temp + 4
        result_b_slot = temp + 5
        out = emit_runtime_native_direct_expr(out, expr["iterable"], iterable_slot, temp + 6, plan, state)
        if expr["out_kind"] == "list":
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "mov x1, #0")
            out = asm_line(out, "bl __tyrion_app_list_new")
        elif expr["out_kind"] == "dict":
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "mov x1, #0")
            out = asm_line(out, "bl __tyrion_app_dict_new")
        else:
            fail("unsupported runtime-native comprehension kind: " + expr["out_kind"])
        out = runtime_native_direct_slot_addr_v2(out, "x13", index_slot)
        out = asm_line(out, "str xzr, [x13]")
        out = asm_line(out, "mov w9, #2")
        out = asm_line(out, "strb w9, " + value_tag_x13)
        out = asm_label(out, test_label)
        out = runtime_native_direct_slot_addr_v2(out, "x0", iterable_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", index_slot)
        out = asm_line(out, "ldr x1, [x1]")
        out = asm_line(out, "bl __tyrion_app_iter_has_next")
        out = asm_line(out, "cbz w0, " + end_label)
        out = runtime_native_direct_slot_addr_v2(out, "x0", value_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", iterable_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x2", index_slot)
        out = asm_line(out, "ldr x2, [x2]")
        out = asm_line(out, "bl __tyrion_app_iter_at")
        target_slot = runtime_native_direct_local_index_or_none(state["frame"], expr["target"])
        if target_slot < 0:
            synthetic_idx = 0
            while synthetic_idx < len(state["synthetic_slots"]):
                synthetic = state["synthetic_slots"][synthetic_idx]
                if synthetic["name"] == expr["target"]:
                    target_slot = synthetic["slot"]
                    break
                synthetic_idx = synthetic_idx + 1
        if target_slot < 0:
            fail("runtime-native direct comprehension target not found: " + expr["target"])
        out = runtime_native_direct_slot_addr_v2(out, "x0", target_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", value_slot)
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        out = emit_runtime_native_direct_expr(out, expr["condition"], condition_slot, temp + 6, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x0", condition_slot)
        out = asm_line(out, "bl __tyrion_app_truthy")
        out = asm_line(out, "cbz w0, " + advance_label)
        if expr["out_kind"] == "list":
            out = emit_runtime_native_direct_expr(out, expr["expr"], result_a_slot, temp + 6, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", result_a_slot)
            out = asm_line(out, "bl __tyrion_app_list_append")
        else:
            out = emit_runtime_native_direct_expr(out, expr["key"], result_a_slot, temp + 6, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["value"], result_b_slot, temp + 6, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", result_a_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x2", result_b_slot)
            out = asm_line(out, "bl __tyrion_app_dict_set")
        out = asm_label(out, advance_label)
        out = runtime_native_direct_slot_addr_v2(out, "x9", index_slot)
        out = asm_line(out, "ldr x10, [x9]")
        out = asm_line(out, "add x10, x10, #1")
        out = asm_line(out, "str x10, [x9]")
        out = asm_line(out, "b " + test_label)
        return asm_label(out, end_label)
    if kind == "unary":
        out = emit_runtime_native_direct_expr(out, expr["value"], temp, temp + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x10", temp)
        out = asm_line(out, "ldr x9, [x10]")
        out = asm_line(out, "mov x22, x9")
        out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = asm_line(out, "mov x9, x22")
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        if expr["op"] == "-":
            out = asm_line(out, "neg x9, x9")
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov w9, #2")
            return asm_line(out, "strb w9, " + value_tag_x13)
        if expr["op"] == "not":
            out = asm_line(out, "cmp x9, #0")
            out = asm_line(out, "cset w9, eq")
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov w9, #3")
            return asm_line(out, "strb w9, " + value_tag_x13)
        if expr["op"] == "~":
            out = asm_line(out, "mvn x9, x9")
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov w9, #2")
            return asm_line(out, "strb w9, " + value_tag_x13)
        fail("unsupported runtime-native direct unary operator: " + expr["op"])
    if kind == "binary":
        op = expr["op"]
        if op == "and" or op == "or":
            branch_index = __tyrion_native_ast_builder_len(state["branch_ids"], 0)
            __tyrion_native_ast_builder_append(state["branch_ids"], 0, branch_index)
            label_base = "__tyrion_app_short_" + str(state["frame"]["id"]) + "_" + str(branch_index)
            eval_right_label = label_base + "_right"
            done_label = label_base + "_done"
            out = emit_runtime_native_direct_expr(out, expr["left"], temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = asm_line(out, "bl __tyrion_app_truthy")
            if op == "and":
                out = asm_line(out, "cbnz w0, " + eval_right_label)
                out = asm_line(out, "mov x9, #0")
            else:
                out = asm_line(out, "cbz w0, " + eval_right_label)
                out = asm_line(out, "mov x9, #1")
            out = asm_line(out, "b " + done_label)
            out = asm_label(out, eval_right_label)
            out = emit_runtime_native_direct_expr(out, expr["right"], temp + 1, temp + 2, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
            out = asm_line(out, "bl __tyrion_app_truthy")
            out = asm_line(out, "mov x9, x0")
            out = asm_label(out, done_label)
            out = asm_line(out, "mov x22, x9")
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "bl __tyrion_app_slot_release")
            out = asm_line(out, "mov x9, x22")
            out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov w9, #2")
            return asm_line(out, "strb w9, " + value_tag_x13)
        out = emit_runtime_native_direct_expr(out, expr["left"], temp, temp + 2, plan, state)
        out = emit_runtime_native_direct_expr(out, expr["right"], temp + 1, temp + 2, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x10", temp)
        out = runtime_native_direct_slot_addr_v2(out, "x11", temp + 1)
        out = runtime_native_direct_slot_addr_v2(out, "x13", dst)
        operation_id = application_binary_operator_id(op)
        if operation_id == application_binary_operator_id("+"):
            out = asm_line(out, "mov x0, x13")
            out = asm_line(out, "mov x1, x10")
            out = asm_line(out, "mov x2, x11")
            out = asm_line(out, "bl __tyrion_app_add")
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = asm_line(out, "bl __tyrion_app_slot_release")
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
            return asm_line(out, "bl __tyrion_app_slot_release")
        if operation_id == application_binary_operator_id("-") or operation_id == application_binary_operator_id("*") or operation_id == application_binary_operator_id("/") or operation_id == application_binary_operator_id("//") or operation_id == application_binary_operator_id("%") or operation_id == application_binary_operator_id("**") or operation_id == application_binary_operator_id("|") or operation_id == application_binary_operator_id("^") or operation_id == application_binary_operator_id("&") or operation_id == application_binary_operator_id("<<") or operation_id == application_binary_operator_id(">>"):
            operation = 1
            if operation_id == application_binary_operator_id("*"):
                operation = 2
            elif operation_id == application_binary_operator_id("/"):
                operation = 3
            elif operation_id == application_binary_operator_id("//"):
                operation = 5
            elif operation_id == application_binary_operator_id("**"):
                operation = 6
            elif operation_id == application_binary_operator_id("%"):
                operation = 4
            elif operation_id == application_binary_operator_id("|"):
                operation = 7
            elif operation_id == application_binary_operator_id("^"):
                operation = 8
            elif operation_id == application_binary_operator_id("&"):
                operation = 9
            elif operation_id == application_binary_operator_id("<<"):
                operation = 10
            elif operation_id == application_binary_operator_id(">>"):
                operation = 11
            out = asm_line(out, "mov x0, x13")
            out = asm_line(out, "mov x1, x10")
            out = asm_line(out, "mov x2, x11")
            out = asm_line(out, "mov x3, #" + str(operation))
            out = asm_line(out, "bl __tyrion_app_numeric_binary")
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = asm_line(out, "bl __tyrion_app_slot_release")
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
