        expr_string_b = "\n    add x13, sp, x15\n    adrp x9, L_tyrion_direct_literal_"
        expr_string_c = "\n    add x9, x9, :lo12:L_tyrion_direct_literal_"
        expr_string_d = "\n    str x9, [x13]\n    mov x9, #"
        expr_float_b = "\n    add x0, sp, x15\n    adrp x1, L_tyrion_direct_literal_"
        expr_float_c = "\n    add x1, x1, :lo12:L_tyrion_direct_literal_"
        expr_float_d = "\n    bl __tyrion_app_float_from_text\n"
    out = asm_cstr(out, "L_native_runtime_direct_write_space", write_space)
