def print_literal_arg_text(arg):
    arg_kind = arg["kind"]
    if arg_kind == "string":
        return arg["value"]
    if arg_kind == "int":
        return str(arg["value"])
    if arg_kind == "float":
        return str(arg["value"])
    if arg_kind == "bool":
        if arg["value"]:
            return "True"
        return "False"
    if arg_kind == "none":
        return "none"
    fail("native function print lowering requires literal print args, got: " + arg_kind)

def materialize_function_print_records(fn):
    records = []
    idx = 0
    while idx < len(fn["body"]):
        stmt = fn["body"][idx]
        if stmt["kind"] != "expr":
            fail("native function print lowering only supports expr statements in " + fn["name"])
        expr = stmt["value"]
        if expr["kind"] != "call" or expr["callee"]["kind"] != "var" or expr["callee"]["value"] != "print":
            fail("native function print lowering only supports print statements in " + fn["name"])
        line = ""
        arg_idx = 0
        while arg_idx < len(expr["args"]):
            if arg_idx > 0:
                line = line + " "
            line = line + print_literal_arg_text(expr["args"][arg_idx])
            arg_idx = arg_idx + 1
        records.append({"text": line})
        idx = idx + 1
    return records

def print_records_text(records):
    out = ""
    idx = 0
    while idx < len(records):
        out = out + records[idx]["text"] + "\n"
        idx = idx + 1
    return out

def compiler_program_function_print_text(program, name):
    fn = program_find_function(program, name)
    return print_records_text(materialize_function_print_records(fn))
