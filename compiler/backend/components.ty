def emit_lowered_function_exec_bodies(out, target, functions):
    idx = 0
    while idx < len(functions):
        out = emit_lowered_function_exec_body(out, target, functions[idx])
        idx = idx + 1
    return out

def emit_lowered_function_fixed_exec_body(out, target, name, plan_kind):
    if plan_kind == "native_runtime_linux_aarch64_asm_text_body":
