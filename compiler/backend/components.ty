def emit_lowered_function_exec_body(out, target, fn):
    kind = fn["plan_kind"]
    if kind == "native_runtime_linux_aarch64_asm_text_body":
        return emit_exec_fn_runtime_native_linux_aarch64_asm_text(out, target, fn["name"])
    if kind == "native_string_concat_body":
        return emit_exec_fn_string_concat(out, target, fn["name"])
    if kind == "native_asm_writer_open_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if kind == "native_asm_writer_append_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if kind == "native_asm_writer_close_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if kind == "native_asm_writer_bytes_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if kind == "native_asm_writer_set_backend_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if kind == "native_asm_writer_is_x86_body":
        return emit_exec_fn_native_asm_writer(out, target, fn["name"])
    if fn["name"] == "method_append":
        return emit_exec_fn_method_append_native(out, target, fn["name"])
    if kind == "usage_body":
        return emit_exec_fn_print_static_text(out, target, fn["name"], "L_usage_text")
    if kind == "version_body":
        return emit_exec_fn_print_static_text(out, target, fn["name"], "L_version_text")
    if kind == "char_equals_body":
        return emit_exec_fn_char_equals(out, target, fn)
    if kind == "char_class_body":
        return emit_exec_fn_char_class(out, target, fn)
    if kind == "contains_text_body":
        return emit_exec_fn_contains_text(out, target, fn["name"])
    if kind == "numeric_text_body":
        return emit_exec_fn_numeric_text(out, target, fn)
    if kind == "is_compare_token_body":
        return emit_exec_fn_is_compare_token(out, target, fn)
    if kind == "fail_body":
        return emit_exec_fn_fail(out, target, fn)
    if kind == "fail_closed_body":
        return emit_exec_fn_fail_closed(out, target, fn)
    if kind == "render_compiler_cli_artifact_body":
        return emit_exec_fn_render_compiler_cli_artifact(out, target, fn)
    if kind == "asm_append_body":
        return emit_exec_fn_asm_append(out, target, fn)
    if kind == "asm_addr_body":
        return emit_exec_fn_asm_addr(out, target, fn["name"])
    if kind == "asm_writer_format_body":
        return emit_exec_fn_asm_writer_format(out, target, fn["name"])
    if kind == "native_inventory_param_body":
        return emit_exec_fn_inventory_param(out, target, fn["name"])
    if kind == "native_inventory_has_name_body":
        return emit_exec_fn_inventory_has_name(out, target, fn["name"])
    if kind == "native_inventory_rows_body":
        return emit_exec_fn_inventory_rows(out, target, fn["name"])
    if kind == "native_split_text_body":
        return emit_exec_fn_split_text(out, target, fn["name"])
    if kind == "native_inventory_field_body":
        return emit_exec_fn_inventory_field(out, target, fn["name"])
    if kind == "native_inventory_row_body":
        return emit_exec_fn_inventory_row(out, target, fn["name"])
    if kind == "native_inventory_cell_body":
        return emit_exec_fn_inventory_cell(out, target, fn["name"])
    if kind == "native_decimal_text_body":
        return emit_exec_fn_decimal_text(out, target, fn["name"])
    if kind == "asm_escape_string_body":
        return emit_exec_fn_asm_escape_string(out, target, fn["name"])
    if kind == "asm_cstr_body":
        return emit_exec_fn_asm_cstr(out, target, fn)
    if kind == "asm_cstr_writer_body":
        return emit_exec_fn_asm_cstr_writer(out, target, fn["name"])
    if kind == "string_map_body":
        return emit_exec_fn_string_map(out, target, fn)
    if kind == "two_char_token_kind_body":
        return emit_exec_fn_two_char_token_kind(out, target, fn)
    if kind == "token_body":
        return emit_exec_fn_token(out, target, fn)
    if kind == "native_lex_body":
        return emit_exec_fn_native_lex(out, target, fn["name"])
    if kind == "token_field_at_body":
        return emit_exec_fn_token_field_at(out, target, fn)
