def emit_direct_value_tcp_templates(out, target):
    tcp_call_a = "    ldr x15, ="
    tcp_call_dest_b = "\n    add x0, sp, x15"
    tcp_call_arg_a = "\n    ldr x15, ="
    tcp_call_arg_b = "\n    add x"
    tcp_call_arg_c = ", sp, x15"
    tcp_call_suffix_1 = "\n    bl __tyrion_app_tcp_connect\n"
    tcp_call_suffix_2 = "\n    bl __tyrion_app_tcp_write\n"
    tcp_call_suffix_3 = "\n    bl __tyrion_app_tcp_read\n"
    tcp_call_suffix_4 = "\n    bl __tyrion_app_tcp_close\n"
    tcp_call_suffix_5 = "\n    bl __tyrion_app_terminal_read_key\n"
    tcp_call_suffix_6 = "\n    bl __tyrion_app_ansi_escape\n"
    tcp_call_suffix_7 = "\n    bl __tyrion_app_host_load\n"
    tcp_call_suffix_8 = "\n    bl __tyrion_app_host_call\n"
    tcp_call_suffix_9 = "\n    bl __tyrion_app_host_unload\n"
    tcp_call_suffix_10 = "\n    bl __tyrion_app_run_tool\n"
    tcp_call_suffix_11 = "\n    bl __tyrion_app_run_tool_capture\n"
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_a", tcp_call_a)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_dest_b", tcp_call_dest_b)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_arg_a", tcp_call_arg_a)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_arg_b", tcp_call_arg_b)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_arg_c", tcp_call_arg_c)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_1", tcp_call_suffix_1)
    out = asm_cstr(out, "L_native_runtime_direct_tcp_call_suffix_2", tcp_call_suffix_2)
