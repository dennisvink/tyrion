    out = asm_line(out, "scvtf d1, x9")
    out = asm_line(out, "fsub d0, d0, d1")
    out = asm_line(out, "fabs d0, d0")
    out = asm_line(out, "fcmp d0, #0.0")
    # Floats retain their type in text form: `7.0` must not become `7`.
    out = asm_line(out, "b.eq __tyrion_app_print_float_integral")
    out = emit_runtime_native_immediate(out, "x10", 1000000, target)
    out = asm_line(out, "scvtf d2, x10")
    out = asm_line(out, "fmul d0, d0, d2")
    out = asm_line(out, "mov x10, #1")
    out = asm_line(out, "scvtf d1, x10")
    out = asm_line(out, "mov x10, #2")
    out = asm_line(out, "scvtf d2, x10")
    out = asm_line(out, "fdiv d1, d1, d2")
    out = asm_line(out, "fadd d0, d0, d1")
    out = asm_line(out, "fcvtzs x9, d0")
    out = asm_line(out, "add x10, sp, #240")
    out = asm_line(out, "mov x11, #6")
    out = asm_label(out, "__tyrion_app_print_float_digits")
    out = asm_line(out, "mov x12, #10")
    out = asm_line(out, "udiv x13, x9, x12")
    out = asm_line(out, "msub x12, x13, x12, x9")
    out = asm_line(out, "add w12, w12, #48")
    out = asm_line(out, "sub x10, x10, #1")
    out = asm_line(out, "strb w12, [x10]")
    out = asm_line(out, "mov x9, x13")
    out = asm_line(out, "sub x11, x11, #1")
    out = asm_line(out, "cbnz x11, __tyrion_app_print_float_digits")
    out = asm_line(out, "add x11, sp, #240")
    out = asm_label(out, "__tyrion_app_print_float_trim")
    out = asm_line(out, "sub x12, x11, x10")
    out = asm_line(out, "cmp x12, #1")
    out = asm_line(out, "b.ls __tyrion_app_print_float_write")
    out = asm_line(out, "sub x13, x11, #1")
    out = asm_line(out, "ldrb w14, [x13]")
    out = asm_line(out, "cmp w14, #48")
    out = asm_line(out, "b.ne __tyrion_app_print_float_write")
    out = asm_line(out, "mov x11, x13")
    out = asm_line(out, "b __tyrion_app_print_float_trim")
    out = asm_label(out, "__tyrion_app_print_float_write")
    out = asm_addr(out, target, "x0", "__tyrion_app_dot")
    out = asm_line(out, "mov x1, #1")
    out = asm_line(out, "bl __tyrion_app_write")
    out = asm_line(out, "mov x0, x10")
    out = asm_line(out, "sub x1, x11, x10")
    out = asm_line(out, "bl __tyrion_app_write")
    out = asm_line(out, "b __tyrion_app_print_done")
    out = asm_label(out, "__tyrion_app_print_float_integral")
    out = asm_line(out, "add x0, sp, #224")
    out = asm_line(out, "mov w9, #46")
    out = asm_line(out, "strb w9, [x0]")
    out = asm_line(out, "mov w9, #48")
    out = asm_line(out, "strb w9, [x0, #1]")
    out = asm_line(out, "mov x1, #2")
    out = asm_line(out, "bl __tyrion_app_write")
    out = asm_label(out, "__tyrion_app_print_done")
    out = asm_line(out, "ldr x19, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #256")
    out = asm_line(out, "ret")
    return out

def emit_runtime_native_direct_generator_function(out, program, plan, fn_plan, target):
    value_tag_x2 = generated_value_tag_mem("x2")
    value_tag_x19 = generated_value_tag_mem("x19")
    # The bootstrap compatibility table can resolve the dynamic planner to a
    # stale zero-valued helper. Keep a bounded concrete frame until that ABI
    # table is regenerated; 64 KiB covers the compiler and native fixtures.
    frame_bytes = 65536
    fn = runtime_native_direct_source_function(program, fn_plan["name"])
    resume_label = fn_plan["label"] + "_resume"
    body_label = fn_plan["label"] + "_resume_body"
    done_label = fn_plan["label"] + "_resume_done"
    allocation_ready_label = fn_plan["label"] + "_allocation_ready"
    frame_slot_count = frame_bytes / generated_value_slot_size()
    heap_size = (frame_slot_count + 2) * generated_value_slot_size()
    out = asm_label(out, fn_plan["label"])
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = emit_runtime_native_immediate(out, "x0", heap_size, target)
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    # AArch64 conditional branch relocations cannot cross ELF object
    # boundaries. Generator functions are emitted in module shards whereas
    # the OOM handler belongs to the root runtime object, so branch locally
    # on success and use an ordinary long-range branch on failure.
    out = asm_line(out, "cbnz x0, " + allocation_ready_label)
    out = asm_line(out, "b __tyrion_app_oom")
    out = asm_label(out, allocation_ready_label)
    out = asm_line(out, "mov x22, x0")
    out = emit_runtime_native_immediate(out, "x1", heap_size, target)
    out = asm_line(out, "bl __tyrion_app_zero_region")
    out = asm_addr(out, target, "x9", resume_label)
    out = asm_line(out, "str x9, [x22]")
    out = asm_line(out, "mov x9, #" + str(frame_slot_count))
    out = asm_line(out, "str x9, [x22, #24]")
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "str x9, [x22, #32]")
    param_idx = 0
    while param_idx < len(fn_plan["params"]):
        out = asm_line(out, "add x0, x22, #256")
        out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(param_idx), target)
        out = asm_line(out, "add x0, x0, x15")
        out = asm_line(out, "add x1, x19, x15")
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        param_idx = param_idx + 1
    out = asm_line(out, "str x22, [x21]")
    out = asm_line(out, "mov w9, #21")
    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x21"))
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    out = asm_label(out, resume_label)
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x1")
    out = asm_line(out, "ldr x20, [x0]")
    finished_label = fn_plan["label"] + "_resume_finished"
    out = asm_line(out, "cbz x20, " + finished_label)
    out = asm_line(out, "ldr x9, [x20, #16]")
    out = asm_line(out, "cbnz x9, " + finished_label)
    out = emit_runtime_native_immediate(out, "x15", frame_bytes, target)
    out = asm_line(out, "sub sp, sp, x15")
    out = asm_line(out, "mov x0, sp")
    out = emit_runtime_native_immediate(out, "x1", frame_bytes, target)
    out = asm_line(out, "bl __tyrion_app_zero_region")
    local_idx = 0
    while local_idx < frame_slot_count:
        out = runtime_native_direct_slot_addr_v2(out, "x0", local_idx)
        out = asm_line(out, "add x1, x20, #256")
        out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(local_idx), target)
        out = asm_line(out, "add x1, x1, x15")
        out = asm_line(out, "bl __tyrion_app_slot_move")
        local_idx = local_idx + 1
    out = asm_line(out, "ldr x9, [x20, #8]")
    out = asm_line(out, "cbz x9, " + body_label)
    yield_paths = runtime_native_direct_yield_paths(fn["body"], "_generator_" + fn_plan["label"], [])
    yield_idx = 1
    while yield_idx <= len(yield_paths):
        out = asm_line(out, "cmp x9, #" + str(yield_idx))
        out = asm_line(out, "b.eq " + resume_label + "_yield_" + str(yield_idx))
        yield_idx = yield_idx + 1
    out = asm_line(out, "b " + done_label)
    out = asm_label(out, body_label)
    branch_ids = __tyrion_native_ast_builder_create()
    state = {"target": target, "frame": fn_plan, "frame_bytes": frame_bytes, "branch_ids": branch_ids, "break_label": "", "continue_label": "", "return_label": done_label, "raise_label": "", "exception_slot": 0, "temp_base": len(fn_plan["locals"]), "lambda_index": 0, "generator": True, "generator_label": resume_label, "yield_paths": yield_paths, "finally_label": "", "finally_pending_slot": 0, "finally_scope_path": "", "synthetic_slots": [], "comprehension_index": 0, "range_names": [], "range_descriptors": []}
    out = emit_runtime_native_direct_statements(out, fn["body"], plan, state, "_generator_" + fn_plan["label"])
    out = asm_label(out, done_label)
    out = asm_line(out, "str xzr, [x19]")
    out = asm_line(out, "strb wzr, " + value_tag_x19)
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "str x9, [x20, #16]")
    out = asm_line(out, "mov x0, sp")
    out = emit_runtime_native_immediate(out, "x1", frame_bytes, target)
    out = asm_line(out, "bl __tyrion_app_cleanup_region")
    out = emit_runtime_native_immediate(out, "x15", frame_bytes, target)
    out = asm_line(out, "add sp, sp, x15")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")
    out = asm_label(out, finished_label)
    out = asm_line(out, "str xzr, [x19]")
    out = asm_line(out, "strb wzr, " + value_tag_x19)
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "mov w0, #0")
    out = asm_line(out, "ret")
    if target["backend"] == "linux-aarch64":
        # Direct-lowered functions precede the runtime text transformer. Flush
        # GNU as pseudo-load literals at each non-fallthrough function boundary
        # so large applications never carry one pool across the whole program.
        out = asm_dir(out, ".ltorg")
    return out

def emit_runtime_native_direct_function_v2(out, program, plan, fn_plan, target):
    value_tag_x19 = generated_value_tag_mem("x19")
    frame_bytes = 65536

    is_generator = False
    if "generator" in fn_plan:
        is_generator = fn_plan["generator"]
    if is_generator:
        return emit_runtime_native_direct_generator_function(out, program, plan, fn_plan, target)
    is_lambda = False
    if "lambda" in fn_plan:
        is_lambda = fn_plan["lambda"]
    fn = none
    if not is_lambda:
        fn = runtime_native_direct_source_function(program, fn_plan["name"])
    return_label = fn_plan["label"] + "_return"
    exception_label = fn_plan["label"] + "_raise"
    exception_slot = len(fn_plan["locals"])
    branch_ids = __tyrion_native_ast_builder_create()
    state = {"target": target, "frame": fn_plan, "frame_bytes": frame_bytes, "branch_ids": branch_ids, "break_label": "", "continue_label": "", "return_label": return_label, "raise_label": exception_label, "exception_slot": exception_slot, "temp_base": exception_slot + 1, "lambda_index": 0, "generator": False, "finally_label": "", "finally_pending_slot": 0, "finally_scope_path": "", "synthetic_slots": [], "comprehension_index": 0, "range_names": [], "range_descriptors": []}
    if fn != none:
        state = runtime_native_direct_collect_range_descriptors(fn["body"], state)
    out = asm_label(out, fn_plan["label"])
    out = asm_line(out, "stp x29, x30, [sp, #-48]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "mov x19, x2")
    out = asm_line(out, "mov x21, x3")
    out = emit_runtime_native_immediate(out, "x15", frame_bytes, target)
    out = asm_line(out, "sub sp, sp, x15")
    out = asm_line(out, "mov x0, sp")
    out = emit_runtime_native_immediate(out, "x1", frame_bytes, target)
    out = asm_line(out, "bl __tyrion_app_zero_region")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    param_idx = 0
    while param_idx < len(fn_plan["params"]):
        out = runtime_native_direct_slot_addr_v2(out, "x0", param_idx)
        out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(param_idx), target)
        out = asm_line(out, "add x1, x20, x15")
        out = asm_line(out, "bl __tyrion_app_slot_move")
        param_idx = param_idx + 1
    if is_lambda:
        result_slot = len(fn_plan["locals"])
        out = emit_runtime_native_direct_expr(out, fn_plan["body_expr"], result_slot, result_slot + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x1", result_slot)
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "bl __tyrion_app_slot_move")
        out = asm_line(out, "b " + return_label)
    else:
        out = emit_runtime_native_direct_statements(out, fn["body"], plan, state, "_fn_" + fn_plan["label"])
    out = asm_line(out, "b " + return_label)
    out = asm_label(out, exception_label)
    out = asm_line(out, "mov x0, x21")
    out = runtime_native_direct_slot_addr_v2(out, "x1", exception_slot)
    out = asm_line(out, "bl __tyrion_app_slot_copy")
    out = asm_label(out, return_label)
    out = asm_line(out, "mov x0, sp")
    out = emit_runtime_native_immediate(out, "x1", frame_bytes, target)
    out = asm_line(out, "bl __tyrion_app_cleanup_region")
    out = emit_runtime_native_immediate(out, "x15", frame_bytes, target)
    out = asm_line(out, "add sp, sp, x15")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #48")
    out = asm_line(out, "ret")
    if target["backend"] == "linux-aarch64":
        # See the generator path above: direct program text is not passed
        # through runtime_native_linux_aarch64_asm_text.
        out = asm_dir(out, ".ltorg")
    return out

def backend_emit_runtime_object_source(out, target, program, plan):
    if target["backend"] == "linux-x86_64":
        out = asm_writer_set_backend(out, "linux-x86_64")
        return emit_darwin_aarch64_runtime_native_program_asm_into(out, target, program, plan)
    if target["backend"] == "darwin-aarch64" or target["backend"] == "linux-aarch64":
        return emit_darwin_aarch64_runtime_native_program_asm_into(out, target, program, plan)
    fail("backend runtime object emission is not implemented: " + target["backend"])

def emit_constant_asm(payload, target):
    backend_require_operation(target, "constant")
    if target["backend"] == "darwin-aarch64":
        return emit_darwin_aarch64_constant_asm(payload, target)
    if target["backend"] == "linux-aarch64":
        return emit_linux_aarch64_constant_asm(payload, target)
    if target["backend"] == "linux-x86_64":
        return emit_linux_x86_64_constant_asm(payload, target)
    fail("unsupported first backend target: " + target["triple"])

def emit_runtime_file_read_asm(plan, target):
    backend_require_operation(target, "link")
    if target["backend"] == "darwin-aarch64" or target["backend"] == "linux-aarch64":
        return emit_aarch64_runtime_file_read_asm(plan, target)
    if target["backend"] == "linux-x86_64":
        return emit_linux_x86_64_runtime_file_read_asm(plan, target)
    fail("runtime file read lowering is not implemented for target: " + target["triple"])


# These declarations keep the compiler primitive ABI visible to source-derived
# function inventory. Descendants select their fixed native plan kinds, so the
# placeholder bodies are never used as a fallback implementation.

def backend_compiler_cli_preamble(target, spec):
    backend_require_implemented(target)
    if target["backend"] == "darwin-aarch64":
        return emit_darwin_aarch64_compiler_cli_preamble(target, spec)
    return "# tyrionc-bootstrap-asm v0 target=" + target["triple"] + "\n"

def compiler_asm_section_dependent(section_id):
    if section_id == "preamble":
        return "cli_entry"
    if section_id == "cli_entry":
        return "lowered_dispatch"
    if section_id == "lowered_dispatch":
        return "lowered_exec_generic_0"
    if section_id == "lowered_exec_generic_0":
        return "lowered_exec_generic_1"
    if section_id == "lowered_exec_generic_1":
        return "lowered_exec_generic_2"
    if section_id == "lowered_exec_generic_2":
        return "lowered_exec_generic_3"
    if section_id == "lowered_exec_generic_3":
        return "lowered_exec_fixed"
    if section_id == "lowered_exec_fixed":
        return "asm_writer_runtime"
    if section_id == "asm_writer_runtime":
        return "source_function_runtime"
    if section_id == "source_function_runtime":
        return "native_read_text_file"
    if section_id == "native_read_text_file":
        return "native_module_graph"
    if section_id == "native_module_graph":
        return "native_runtime_direct"
    if section_id == "native_runtime_direct":
        return "native_write_text_file"
    if section_id == "native_write_text_file":
        return "print_u64_decimal"
    if section_id == "print_u64_decimal":
        return "with_open_runtime"
    if section_id == "with_open_runtime":
        return "source_line_runtime"
    if section_id == "source_line_runtime":
        return "statement_parser_runtime"
    if section_id == "statement_parser_runtime":
        return "child_record_runtime"
    if section_id == "child_record_runtime":
        return "program_child_materializer"
    if section_id == "program_child_materializer":
        return "range_child_materializer"
    if section_id == "range_child_materializer":
        return "function_body_runtime"
    if section_id == "function_body_runtime":
        return "loop_record_runtime"
    if section_id == "loop_record_runtime":
        return "statement_call_probe_runtime"
    if section_id == "statement_call_probe_runtime":
        return "statement_mutation"
    if section_id == "statement_mutation":
        return "control_flow"
    if section_id == "control_flow":
        return "function_registry"
    if section_id == "function_registry":
        return "function_calls"
    if section_id == "function_calls":
        return "expression_eval"
    if section_id == "expression_eval":
        return "expression_ast"
    if section_id == "expression_ast":
        return "atom_core"
    if section_id == "atom_core":
        return "builtin_atoms"
    if section_id == "builtin_atoms":
        return "indexing"
    if section_id == "indexing":
        return "methods_objects"
    if section_id == "methods_objects":
        return "slots_ownership"
    if section_id == "slots_ownership":
        return "assignment_mutation"
    if section_id == "assignment_mutation":
        return "scalar_formatting"
    if section_id == "scalar_formatting":
        return ""
    fail("unknown compiler assembly section graph node: " + section_id)

def emit_compiler_asm_section(out, section, target, spec):
    section_id = section
    lowered_function_inventory = spec["lowered_function_inventory"]
    comment_prefix = ";"
    if target["object_format"] == "elf64":
        comment_prefix = "#"
    out = asm_raw(out, comment_prefix + " tyrion-component: " + section_id + "\n")
    if section_id == "preamble":
        return emit_darwin_aarch64_compiler_cli_preamble_into(out, target, spec)
    if section_id == "cli_entry":
        return emit_darwin_aarch64_compiler_cli_entry(out, target)
    if section_id == "lowered_dispatch":
        return emit_darwin_aarch64_lowered_dispatch(out, target, lowered_function_inventory)
    if section_id == "lowered_exec_generic_0":
        return emit_lowered_function_generic_exec_bodies_partition_0(out, target, lowered_function_inventory)
    if section_id == "lowered_exec_generic_1":
        return emit_lowered_function_generic_exec_bodies_partition_1(out, target, lowered_function_inventory)
    if section_id == "lowered_exec_generic_2":
        return emit_lowered_function_generic_exec_bodies_partition_2(out, target, lowered_function_inventory)
    if section_id == "lowered_exec_generic_3":
        return emit_lowered_function_generic_exec_bodies_partition_3(out, target, lowered_function_inventory)
    if section_id == "lowered_exec_fixed":
        return emit_lowered_function_fixed_exec_bodies_from_inventory(out, target, lowered_function_inventory)
    if section_id == "asm_writer_runtime":
        return emit_darwin_aarch64_asm_writer_runtime(out, target)
    if section_id == "source_function_runtime":
        return emit_darwin_aarch64_source_function_runtime(out, target)
    if section_id == "native_read_text_file":
        return emit_native_read_text_file_primitive(out, target)
    if section_id == "native_module_graph":
        return emit_native_module_graph_primitive(out, target)
    if section_id == "native_runtime_direct":
        out = emit_native_text_builder_runtime(out, target)
        out = emit_native_runtime_direct_program_runtime(out, target)
        return emit_exec_fn_runtime_native_direct_source(out, target)
    if section_id == "native_write_text_file":
        return emit_native_write_text_file_primitive(out, target)
    if section_id == "print_u64_decimal":
        return emit_darwin_aarch64_print_u64_decimal_line(out, target)
    if section_id == "with_open_runtime":
        return emit_darwin_aarch64_with_open_runtime(out, target)
    if section_id == "source_line_runtime":
        return emit_darwin_aarch64_source_line_runtime(out)
    if section_id == "statement_parser_runtime":
        return emit_darwin_aarch64_statement_parser_runtime(out, target)
    if section_id == "child_record_runtime":
        return emit_darwin_aarch64_child_record_runtime(out)
    if section_id == "program_child_materializer":
        return emit_darwin_aarch64_program_child_materializer(out)
    if section_id == "range_child_materializer":
        return emit_darwin_aarch64_range_child_materializer(out)
    if section_id == "function_body_runtime":
        return emit_darwin_aarch64_function_body_runtime(out, target)
    if section_id == "loop_record_runtime":
        return emit_darwin_aarch64_loop_record_runtime(out, target)
    if section_id == "statement_call_probe_runtime":
        return emit_darwin_aarch64_statement_call_probe_runtime(out, target)
    if section_id == "statement_mutation":
        return emit_darwin_aarch64_statement_mutation_component(out, target, "", "", spec)
    if section_id == "control_flow":
        return emit_darwin_aarch64_control_flow_component(out, target, "", "", spec)
    if section_id == "function_registry":
        return emit_darwin_aarch64_function_registry_component(out, target, "", "", spec)
    if section_id == "function_calls":
        return emit_darwin_aarch64_function_calls_component(out, target, "", "", spec)
    if section_id == "expression_eval":
        return emit_darwin_aarch64_expression_eval_component(out, target, "", "", spec)
    if section_id == "expression_ast":
        return emit_darwin_aarch64_expression_ast_component(out, target, "", "", spec)
    if section_id == "atom_core":
        return emit_darwin_aarch64_atom_core_component(out, target, "", "", spec)
    if section_id == "builtin_atoms":
        return emit_darwin_aarch64_builtin_atoms_component(out, target, "", "", spec)
    if section_id == "indexing":
        return emit_darwin_aarch64_indexing_component(out, target, "", "", spec)
    if section_id == "methods_objects":
        return emit_darwin_aarch64_methods_objects_component(out, target, "", "", spec)
    if section_id == "slots_ownership":
        return emit_darwin_aarch64_slots_ownership_component(out, target, "", "", spec)
    if section_id == "assignment_mutation":
        return emit_darwin_aarch64_assignment_mutation_component(out, target, "", "", spec)
    if section_id == "scalar_formatting":
        return emit_darwin_aarch64_scalar_formatting_component(out, target, "", "", spec)
    fail("unknown compiler assembly section: " + section_id)

def emit_compiler_asm_section_plan(out, plan, target, spec):
    start = 0
    idx = 0
    while idx < len(plan):
        if plan[idx] == "|":
            if idx == start:
                fail("empty compiler assembly section during emission")
            section = plan[start:idx]
            out = emit_compiler_asm_section(out, section, target, spec)
            start = idx + 1
        idx = idx + 1
    if start != len(plan):
        fail("unterminated compiler assembly section during emission")
    return out

def emit_compiler_cli_asm(target, usage_text, version_text, spec):
    backend_require_operation(target, "section")
    backend_require_operation(target, "link")
    if target["backend"] == "darwin-aarch64":
        return emit_darwin_aarch64_compiler_cli_asm(target, usage_text, version_text, spec)
    if target["backend"] == "linux-aarch64" or target["backend"] == "linux-x86_64":
        fail("linux compiler cli emission requires the assembly writer ABI")
    fail("unsupported compiler cli target: " + target["triple"])

def emit_compiler_cli_asm_into(out, target, usage_text, version_text, spec):
    if target["backend"] == "darwin-aarch64":
        return emit_darwin_aarch64_compiler_cli_asm_into(out, target, usage_text, version_text, spec)
    if target["backend"] == "linux-aarch64":
        return emit_linux_aarch64_compiler_cli_asm_into(out, target, usage_text, version_text, spec)
    if target["backend"] == "linux-x86_64":
        return emit_linux_x86_64_compiler_cli_asm_into(out, target, usage_text, version_text, spec)
    fail("unsupported compiler cli target: " + target["triple"])

def render_native_artifact(input_path, target, asm):
    out = "tyrion-bootstrap-native v0\n"
    out = out + "entry=" + input_path + "\n"
    out = out + "target=" + target["triple"] + "\n"
    out = out + "target-arch=" + target["arch"] + "\n"
    out = out + "target-os=" + target["os"] + "\n"
    out = out + "target-asm-syntax=" + target["asm_syntax"] + "\n"
    out = out + "native-entry-symbol=" + target["entry_symbol"] + "\n"
    out = out + "native-build-target-kind=user-program\n"
    out = out + "native-lowering-plan=bootstrap-print-constant\n"
    out = out + "native-exec-mode=user-program-native\n"
    out = out + "native-link-mode=pending\n"
    out = out + "---TYPED-IR---\n"
    out = out + "typed-ir-unavailable:bootstrap-tyrion-v0\n"
    out = out + "---LOWERED-IR---\n"
    out = out + "lowered-ir-unavailable:bootstrap-tyrion-v0\n"
    out = out + "---BACKEND-IR---\n"
    out = out + "backend-ir-bootstrap-tyrion-v0\n"
    out = out + "---ASM---\n"
    out = out + asm
    return out

