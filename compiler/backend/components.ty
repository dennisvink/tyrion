                receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
                out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 3, plan, state)
                out = emit_runtime_native_direct_expr(out, expr["args"][1], temp + 2, temp + 4, plan, state)
                out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 3)
                out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
                out = runtime_native_direct_slot_addr_v2(out, "x3", temp + 2)
                out = asm_line(out, "bl __tyrion_app_list_insert")
                out = asm_line(out, "cbz w0, __tyrion_app_object_fail")
                out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 3)
                out = asm_line(out, "bl __tyrion_app_slot_copy")
                out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
                out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
                return asm_line(out, "bl __tyrion_app_slot_copy")
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 4, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 4, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][1], temp + 2, temp + 4, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 3)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            out = runtime_native_direct_slot_addr_v2(out, "x3", temp + 2)
            out = asm_line(out, "bl __tyrion_app_list_insert")
            out = asm_line(out, "cbz w0, __tyrion_app_object_fail")
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 3)
            return asm_line(out, "bl __tyrion_app_slot_copy")
        if name == "copy":
            if expr["receiver"]["kind"] == "var":
                receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
            else:
                receiver_slot = temp
                out = emit_runtime_native_direct_expr(out, expr["receiver"], receiver_slot, temp + 2, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
            out = asm_line(out, "bl __tyrion_app_copy")
            out = asm_line(out, "cbz w0, __tyrion_app_object_fail")
            return out
        if name == "clear" and expr["receiver"]["kind"] == "var":
            helper = {"kind": "call", "callee": {"kind": "var", "value": "__tyrion_method_dict_clear_pair"}, "args": [expr["receiver"]]}
            pair_slot = temp
            out = emit_runtime_native_direct_expr(out, helper, pair_slot, temp + 5, plan, state)
            out = emit_runtime_native_direct_expr(out, {"kind": "int", "value": 0, "items": []}, temp + 1, temp + 5, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", pair_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            out = asm_line(out, "bl __tyrion_app_index")
            receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
            out = emit_runtime_native_direct_expr(out, {"kind": "int", "value": 1, "items": []}, temp + 1, temp + 5, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x1", pair_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            return asm_line(out, "bl __tyrion_app_index")
        if name == "clear":
            if expr["receiver"]["kind"] == "var":
                receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
            else:
                receiver_slot = temp
                out = emit_runtime_native_direct_expr(out, expr["receiver"], receiver_slot, temp + 2, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
            out = asm_line(out, "mov x1, #0")
            out = asm_line(out, "bl __tyrion_app_list_new")
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = asm_line(out, "bl __tyrion_app_slot_release")
            return out
        if name == "append" or name == "remove" or name == "add":
            if expr["receiver"]["kind"] == "var":
                receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
                out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 3, plan, state)
                if name == "append":
                    out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                    out = asm_line(out, "bl __tyrion_app_list_append")
                else:
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 2)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
                    if name == "remove":
                        out = asm_line(out, "bl __tyrion_app_list_removed")
                    else:
                        out = asm_line(out, "bl __tyrion_app_set_added")
                    out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 2)
                    out = asm_line(out, "bl __tyrion_app_slot_copy")
                out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
                out = runtime_native_direct_slot_addr_v2(out, "x1", receiver_slot)
                return asm_line(out, "bl __tyrion_app_slot_copy")
            if expr["receiver"]["kind"] == "index" and expr["receiver"]["receiver"]["kind"] == "var":
                # Mutating an indexed collection must write the detached value
                # back into its owning slot.  Evaluating it as an ordinary
                # expression only mutates a temporary after copy-on-write.
                owner_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["receiver"]["value"])
                out = emit_runtime_native_direct_expr(out, expr["receiver"]["index"], temp, temp + 4, plan, state)
                out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
                out = runtime_native_direct_slot_addr_v2(out, "x1", owner_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x2", temp)
                out = asm_line(out, "bl __tyrion_app_index")
                out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 2, temp + 4, plan, state)
                if name == "append":
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 2)
                    out = asm_line(out, "bl __tyrion_app_list_append")
                else:
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 3)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                    out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
                    if name == "remove":
                        out = asm_line(out, "bl __tyrion_app_list_removed")
                    else:
                        out = asm_line(out, "bl __tyrion_app_set_added")
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 1)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 3)
                    out = asm_line(out, "bl __tyrion_app_slot_copy")
                out = runtime_native_direct_slot_addr_v2(out, "x0", owner_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
                out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
                out = asm_line(out, "bl __tyrion_app_set_index")
                out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
                out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                return asm_line(out, "bl __tyrion_app_slot_copy")
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 3, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 3, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 2)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            if name == "append":
                out = asm_line(out, "bl __tyrion_app_list_appended")
            elif name == "remove":
                out = asm_line(out, "bl __tyrion_app_list_removed")
            else:
                out = asm_line(out, "bl __tyrion_app_set_added")
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 2)
            return asm_line(out, "bl __tyrion_app_slot_copy")
        if name == "keys" or name == "items":
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            if name == "keys":
                return asm_line(out, "bl __tyrion_app_dict_keys")
            return asm_line(out, "bl __tyrion_app_dict_items")
        if name == "values":
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            return asm_line(out, "bl __tyrion_app_dict_values")
        if name == "update":
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 4, plan, state)
            positional = none
            for argument in expr["args"]:
                if argument["kind"] != "kwarg":
                    positional = argument
            if positional != none:
                if positional["kind"] == "dict":
                    for entry in positional["entries"]:
                        out = emit_runtime_native_direct_expr(out, entry["key"], temp + 1, temp + 4, plan, state)
                        out = emit_runtime_native_direct_expr(out, entry["value"], temp + 2, temp + 4, plan, state)
                        out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
                        out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                        out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
                        out = asm_line(out, "bl __tyrion_app_dict_set")
                else:
                    out = emit_runtime_native_direct_expr(out, positional, temp + 1, temp + 4, plan, state)
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                    out = asm_line(out, "bl __tyrion_app_dict_update")
            for argument in expr["args"]:
                if argument["kind"] == "kwarg":
                    key_expr = {"kind": "string", "value": argument["name"]}
                    out = emit_runtime_native_direct_expr(out, key_expr, temp + 1, temp + 4, plan, state)
                    out = emit_runtime_native_direct_expr(out, argument["value"], temp + 2, temp + 4, plan, state)
                    out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                    out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
                    out = asm_line(out, "bl __tyrion_app_dict_set")
            if expr["receiver"]["kind"] == "var":
                receiver_slot = runtime_native_direct_local_index(state["frame"], expr["receiver"]["value"])
                out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
                out = asm_line(out, "bl __tyrion_app_slot_copy")
            return emit_runtime_native_direct_expr(out, {"kind": "none"}, dst, temp + 4, plan, state)
        if name == "get":
            if len(expr["args"]) < 1:
                fail("runtime-native direct get requires a key")
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 2, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 2, plan, state)
            if len(expr["args"]) > 1:
                out = emit_runtime_native_direct_expr(out, expr["args"][1], temp + 2, temp + 3, plan, state)
                out = runtime_native_direct_slot_addr_v2(out, "x3", temp + 2)
            else:
                out = asm_line(out, "mov x3, #0")
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            if len(expr["args"]) > 1:
                out = runtime_native_direct_slot_addr_v2(out, "x3", temp + 2)
            return asm_line(out, "bl __tyrion_app_dict_get")
        if name == "startswith" or name == "endswith":
            out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 2, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 2, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", dst)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 1)
            if name == "startswith":
                return asm_line(out, "bl __tyrion_app_string_startswith")
            return asm_line(out, "bl __tyrion_app_string_endswith")
        out = emit_runtime_native_direct_expr(out, expr["receiver"], temp, temp + 3, plan, state)
        if name == "read":
            out = asm_line(out, "mov x1, #-1")
            if len(expr["args"]) == 1:
                out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 3, plan, state)
                out = runtime_native_direct_slot_addr_v2(out, "x9", temp + 1)
                out = asm_line(out, "ldr x1, [x9]")
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x2", dst)
            return asm_line(out, "bl __tyrion_app_file_read")
        if name == "write":
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 3, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
            out = runtime_native_direct_slot_addr_v2(out, "x2", dst)
            return asm_line(out, "bl __tyrion_app_file_write")
        if name == "flush":
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x1", dst)
            return asm_line(out, "bl __tyrion_app_file_flush")
        if name == "seek":
            out = emit_runtime_native_direct_expr(out, expr["args"][0], temp + 1, temp + 4, plan, state)
            out = emit_runtime_native_direct_expr(out, expr["args"][1], temp + 2, temp + 4, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
            out = runtime_native_direct_slot_addr_v2(out, "x3", dst)
            return asm_line(out, "bl __tyrion_app_file_seek")
        if name == "close":
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x1", dst)
            return asm_line(out, "bl __tyrion_app_file_close")
        fail("unsupported runtime-native direct method: " + name)
    fail("unsupported runtime-native direct expression: " + kind)

def emit_runtime_native_direct_print(out, expr, temp, plan, state):
    positional = []
    separator_expr = {"kind": "none"}
    ending_expr = {"kind": "none"}
    file_expr = {"kind": "none"}
    flush_requested = False
    idx = 0
    while idx < len(expr["args"]):
        arg = expr["args"][idx]
        if arg["kind"] == "kwarg":
            if arg["name"] == "sep":
                separator_expr = arg["value"]
            elif arg["name"] == "end":
                ending_expr = arg["value"]
            elif arg["name"] == "file":
                file_expr = arg["value"]
            elif arg["name"] == "flush":
                if arg["value"]["kind"] == "bool":
                    flush_requested = arg["value"]["value"]
                elif arg["value"]["kind"] != "none":
                    fail("runtime-native direct print flush must be a boolean or None")
            else:
                fail("runtime-native direct print unknown keyword: " + arg["name"])
        else:
            positional = method_append(positional, arg)
        idx = idx + 1
    arg_count = len(positional)
    separator_slot = temp + arg_count
    ending_slot = temp + arg_count + 1
    idx = 0
    while idx < arg_count:
        out = emit_runtime_native_direct_expr(out, positional[idx], temp + idx, ending_slot + 1, plan, state)
        idx = idx + 1
    separator_dynamic = separator_expr["kind"] == "string"
    ending_dynamic = ending_expr["kind"] == "string"
    if separator_expr["kind"] != "none" and not separator_dynamic:
        fail("runtime-native direct print sep must be None or a string literal")
    if ending_expr["kind"] != "none" and not ending_dynamic:
        fail("runtime-native direct print end must be None or a string literal")

    # File targets use the same canonical stringification path as `str()` and
    # the existing file-write runtime. `file_write` flushes the stream after
    # each write, so `flush=True` is naturally satisfied for redirected output.
    if file_expr["kind"] != "none":
        file_slot = temp + arg_count + 2
        output_base = file_slot + 1
        out = emit_runtime_native_direct_expr(out, file_expr, file_slot, output_base + arg_count + 4, plan, state)
        output_exprs = []
        idx = 0
        while idx < arg_count:
            if idx > 0:
                if separator_dynamic:
                    output_exprs = method_append(output_exprs, separator_expr)
                else:
                    output_exprs = method_append(output_exprs, {"kind": "string", "value": " ", "items": []})
            output_exprs = method_append(output_exprs, positional[idx])
            idx = idx + 1
        if ending_dynamic:
            output_exprs = method_append(output_exprs, ending_expr)
        else:
            output_exprs = method_append(output_exprs, {"kind": "string", "value": "\n", "items": []})
        idx = 0
        while idx < len(output_exprs):
            text_slot = output_base + idx
            out = emit_runtime_native_direct_expr(out, {"kind": "call", "callee": {"kind": "var", "value": "str"}, "args": [output_exprs[idx]]}, text_slot, output_base + len(output_exprs) + 2, plan, state)
            result_slot = output_base + len(output_exprs) + 1
            out = runtime_native_direct_slot_addr_v2(out, "x0", file_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x1", text_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x2", result_slot)
            out = asm_line(out, "bl __tyrion_app_file_write")
            idx = idx + 1
        if flush_requested:
            flush_slot = output_base + len(output_exprs) + 2
            out = runtime_native_direct_slot_addr_v2(out, "x0", file_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x1", flush_slot)
            out = asm_line(out, "bl __tyrion_app_file_flush")
        return out

    if separator_dynamic:
        out = emit_runtime_native_direct_expr(out, separator_expr, separator_slot, ending_slot + 1, plan, state)
    if ending_dynamic:
        out = emit_runtime_native_direct_expr(out, ending_expr, ending_slot, ending_slot + 1, plan, state)
    idx = 0
    while idx < arg_count:
        if idx > 0:
            if separator_dynamic:
                out = runtime_native_direct_slot_addr_v2(out, "x9", separator_slot)
                out = asm_line(out, "ldr x0, [x9]")
                out = asm_line(out, "ldr x1, [x9, #8]")
            else:
                out = asm_addr(out, state["target"], "x0", "__tyrion_app_space")
                out = asm_line(out, "mov x1, #1")
            out = asm_line(out, "bl __tyrion_app_write")
        out = runtime_native_direct_slot_addr_v2(out, "x0", temp + idx)
        out = asm_line(out, "bl __tyrion_app_print_value")
        idx = idx + 1
    if ending_dynamic:
        out = runtime_native_direct_slot_addr_v2(out, "x9", ending_slot)
        out = asm_line(out, "ldr x0, [x9]")
        out = asm_line(out, "ldr x1, [x9, #8]")
    else:
        out = asm_addr(out, state["target"], "x0", "__tyrion_app_newline")
        out = asm_line(out, "mov x1, #1")
    return asm_line(out, "bl __tyrion_app_write")

def emit_runtime_native_direct_statements(out, items, plan, state, path):
    idx = 0
    while idx < len(items):
        out = emit_runtime_native_direct_statement(out, items[idx], plan, state, path + "_" + str(idx))
        idx = idx + 1
    return out


def runtime_native_direct_yield_paths(items, path, paths):
    idx = 0
    while idx < len(items):
        stmt = items[idx]
        stmt_path = path + "_" + str(idx)
        kind = stmt["kind"]
        if kind == "yield":
            paths = method_append(paths, stmt_path)
        elif kind == "if":
            paths = runtime_native_direct_yield_paths(stmt["body"], stmt_path + "_if", paths)
            branch_idx = 0
            while branch_idx < len(stmt["elifs"]):
                paths = runtime_native_direct_yield_paths(stmt["elifs"][branch_idx]["body"], stmt_path + "_elif_" + str(branch_idx), paths)
                branch_idx = branch_idx + 1
            paths = runtime_native_direct_yield_paths(stmt["else_body"], stmt_path + "_else", paths)
        elif kind == "while":
            paths = runtime_native_direct_yield_paths(stmt["body"], stmt_path + "_while", paths)
        elif kind == "for":
            paths = runtime_native_direct_yield_paths(stmt["body"], stmt_path + "_for", paths)
        elif kind == "with":
            paths = runtime_native_direct_yield_paths(stmt["body"], stmt_path + "_with", paths)
        elif kind == "try":
            paths = runtime_native_direct_yield_paths(stmt["body"], stmt_path + "_try", paths)
            paths = runtime_native_direct_yield_paths(stmt["except_body"], stmt_path + "_except", paths)
            paths = runtime_native_direct_yield_paths(stmt["finally_body"], stmt_path + "_finally", paths)
        idx = idx + 1
    return paths


def runtime_native_direct_yield_id(paths, path):
    idx = 0
    while idx < len(paths):
        if paths[idx] == path:
            return idx + 1
        idx = idx + 1
    fail("runtime-native generator yield path not found: " + path)

def emit_runtime_native_direct_control_value(out, slot, kind):
    out = runtime_native_direct_slot_addr_v2(out, "x13", slot)
    out = asm_line(out, "mov x9, #" + str(kind))
    out = asm_line(out, "str x9, [x13]")
    out = asm_line(out, "mov w9, #2")
    return asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))

def runtime_native_direct_control_crosses_finally(state):
    if state["finally_label"] == "":
        return False
    return not contains_text(state["break_label"], state["finally_scope_path"])

def emit_runtime_native_direct_control_forward(out, state, kind, target_label):
    if state["finally_label"] != "":
        out = emit_runtime_native_direct_control_value(out, state["finally_pending_slot"], kind)
        return asm_line(out, "b " + state["finally_label"])
    return asm_line(out, "b " + target_label)

def runtime_native_direct_range_descriptor(state, name):
    index = 0
    while index < len(state["range_names"]):
        if state["range_names"][index] == name:
            return state["range_descriptors"][index]
        index = index + 1
    return none

def runtime_native_direct_literal_int(expression):
    if expression["kind"] == "int":
        return {"ok": True, "value": expression["value"]}
    if expression["kind"] == "unary" and expression["op"] == "-" and expression["value"]["kind"] == "int":
        return {"ok": True, "value": 0 - expression["value"]["value"]}
    if expression["kind"] == "binary" and expression["op"] == "-" and expression["left"]["kind"] == "int" and expression["right"]["kind"] == "int" and expression["left"]["value"] == 0:
        return {"ok": True, "value": 0 - expression["right"]["value"]}
    return {"ok": False, "value": 0}

def runtime_native_direct_record_range(state, name, expression):
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var" or expression["callee"]["value"] != "range":
        return state
    args = expression["args"]
    if len(args) < 1 or len(args) > 3:
        return state
    values = []
    index = 0
    while index < len(args):
        literal = runtime_native_direct_literal_int(args[index])
        if not literal["ok"]:
            return state
        values = method_append(values, literal["value"])
        index = index + 1
    if len(values) == 1:
        descriptor = [0, values[0], 1]
    elif len(values) == 2:
        descriptor = [values[0], values[1], 1]
    else:
        descriptor = [values[0], values[1], values[2]]
    index = 0
    while index < len(state["range_names"]):
        if state["range_names"][index] == name:
            replacement = []
            replacement_index = 0
            while replacement_index < len(state["range_descriptors"]):
                if replacement_index == index:
                    replacement.append(descriptor)
                else:
                    replacement.append(state["range_descriptors"][replacement_index])
                replacement_index = replacement_index + 1
            state["range_descriptors"] = replacement
            return state
        index = index + 1
    state["range_names"] = method_append(state["range_names"], name)
    state["range_descriptors"] = method_append(state["range_descriptors"], descriptor)
    return state

def runtime_native_direct_collect_range_descriptors(items, state):
    # Collect literal range assignments before emission.  This keeps the
    # descriptor available to a later attribute statement even when the
    # statement emitter returns only assembly text (and not its updated state).
    index = 0
    while index < len(items):
        statement = items[index]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            state = runtime_native_direct_record_range(state, statement["target"]["value"], statement["value"])
        index = index + 1
    return state

def emit_runtime_native_direct_statement(out, stmt, plan, state, path):
    kind = stmt["kind"]
    temp = state["temp_base"]
    # Keep the source compiler's definite-assignment analysis explicit: the
    # assignment target only exists on the `assign` branch, but all of its
    # target-shape cases are intentionally handled below that branch.
    target = none
    if kind == "assign":
        target = stmt["target"]
        if target["kind"] == "var":
            dst = runtime_native_direct_local_index(state["frame"], target["value"])
            state = runtime_native_direct_record_range(state, target["value"], stmt["value"])
            return emit_runtime_native_direct_expr(out, stmt["value"], dst, temp, plan, state)
        if target["kind"] == "index":
            receiver_slot = temp
            if target["receiver"]["kind"] == "var":
                receiver_slot = runtime_native_direct_local_index(state["frame"], target["receiver"]["value"])
            else:
                out = emit_runtime_native_direct_expr(out, target["receiver"], temp, temp + 3, plan, state)
            out = emit_runtime_native_direct_expr(out, target["index"], temp + 1, temp + 3, plan, state)
            out = emit_runtime_native_direct_expr(out, stmt["value"], temp + 2, temp + 3, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", receiver_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
            return asm_line(out, "bl __tyrion_app_set_index")
        if target["kind"] == "attr":
            out = emit_runtime_native_direct_expr(out, target["receiver"], temp, temp + 3, plan, state)
            literal_label = runtime_native_direct_literal_label(plan, "string", target["name"])
            out = runtime_native_direct_slot_addr_v2(out, "x13", temp + 1)
            out = asm_addr(out, state["target"], "x9", literal_label)
            out = asm_line(out, "str x9, [x13]")
            out = asm_line(out, "mov x9, #" + str(len(target["name"])))
            out = asm_line(out, "str x9, [x13, #8]")
            out = asm_line(out, "mov w9, #4")
            out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
            out = emit_runtime_native_direct_expr(out, stmt["value"], temp + 2, temp + 3, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
            out = runtime_native_direct_slot_addr_v2(out, "x2", temp + 2)
            return asm_line(out, "bl __tyrion_app_object_attr_set")
        if target["kind"] == "unpack":
            iterable_slot = temp
            length_slot = temp + 1
            start_slot = temp + 2
            stop_slot = temp + 3
            out = emit_runtime_native_direct_expr(out, stmt["value"], iterable_slot, temp + 4, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", iterable_slot)
            out = asm_line(out, "bl __tyrion_app_iter_len")
            out = runtime_native_direct_slot_addr_v2(out, "x13", length_slot)
            out = asm_line(out, "str x0, [x13]")
            out = asm_line(out, "mov w9, #2")
            out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
            star_idx = -1
            scan_idx = 0
            for unpack_target in target["targets"]:
                if unpack_target["star"]:
                    star_idx = scan_idx
                scan_idx = scan_idx + 1
            required = len(target["targets"])
            if star_idx >= 0:
                required = required - 1
                out = asm_line(out, "cmp x0, #" + str(required))
                out = asm_line(out, "b.lo __tyrion_app_list_fail")
            else:
                out = asm_line(out, "cmp x0, #" + str(required))
                out = asm_line(out, "b.ne __tyrion_app_list_fail")
            target_idx = 0
            while target_idx < len(target["targets"]):
                unpack_target = target["targets"][target_idx]
                target_slot = runtime_native_direct_local_index(state["frame"], unpack_target["name"])
                if unpack_target["star"]:
                    trailing = len(target["targets"]) - target_idx - 1
                    out = runtime_native_direct_slot_addr_v2(out, "x13", start_slot)
                    out = asm_line(out, "mov x9, #" + str(target_idx))
                    out = asm_line(out, "str x9, [x13]")
                    out = asm_line(out, "mov w9, #2")
                    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
                    out = runtime_native_direct_slot_addr_v2(out, "x13", stop_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x9", length_slot)
                    out = asm_line(out, "ldr x9, [x9]")
                    if trailing > 0:
                        out = asm_line(out, "sub x9, x9, #" + str(trailing))
                    out = asm_line(out, "str x9, [x13]")
                    out = asm_line(out, "mov w9, #2")
                    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
                    out = runtime_native_direct_slot_addr_v2(out, "x0", target_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", iterable_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x2", start_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x3", stop_slot)
                    out = asm_line(out, "bl __tyrion_app_slice")
                else:
                    out = runtime_native_direct_slot_addr_v2(out, "x0", target_slot)
                    out = runtime_native_direct_slot_addr_v2(out, "x1", iterable_slot)
                    if star_idx >= 0 and target_idx > star_idx:
                        trailing_index = len(target["targets"]) - target_idx
                        out = runtime_native_direct_slot_addr_v2(out, "x9", length_slot)
                        out = asm_line(out, "ldr x2, [x9]")
                        out = asm_line(out, "sub x2, x2, #" + str(trailing_index))
                    else:
                        out = asm_line(out, "mov x2, #" + str(target_idx))
                    out = asm_line(out, "bl __tyrion_app_iter_at")
                target_idx = target_idx + 1
            return out
        fail("unsupported runtime-native direct assignment target: " + target["kind"])
    if kind == "expr":
        expr = stmt["value"]
        if expr["kind"] == "call" and expr["callee"]["kind"] == "var" and expr["callee"]["value"] == "print":
            return emit_runtime_native_direct_print(out, expr, temp, plan, state)
        return emit_runtime_native_direct_expr(out, expr, temp, temp + 1, plan, state)
    if kind == "if":
        target_condition = native_direct_target_condition_value(stmt["condition"], state["target"], True)
        if target_condition == 1:
            return emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_if")
        if target_condition == 0 and len(stmt["elifs"]) == 0:
            return emit_runtime_native_direct_statements(out, stmt["else_body"], plan, state, path + "_else")
        end_label = "__tyrion_app_if_end" + path
        next_label = "__tyrion_app_if_next" + path + "_0"
        out = emit_runtime_native_direct_expr(out, stmt["condition"], temp, temp + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
        out = asm_line(out, "bl __tyrion_app_truthy")
        out = asm_line(out, "cbz w0, " + next_label)
        out = emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_if")
        out = asm_line(out, "b " + end_label)
        out = asm_label(out, next_label)
        branch_idx = 0
        for branch in stmt["elifs"]:
            branch_next = "__tyrion_app_if_next" + path + "_" + str(branch_idx + 1)
            out = emit_runtime_native_direct_expr(out, branch["condition"], temp, temp + 1, plan, state)
            out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
            out = asm_line(out, "bl __tyrion_app_truthy")
            out = asm_line(out, "cbz w0, " + branch_next)
            out = emit_runtime_native_direct_statements(out, branch["body"], plan, state, path + "_elif_" + str(branch_idx))
            out = asm_line(out, "b " + end_label)
            out = asm_label(out, branch_next)
            branch_idx = branch_idx + 1
        out = emit_runtime_native_direct_statements(out, stmt["else_body"], plan, state, path + "_else")
        return asm_label(out, end_label)
    if kind == "while":
        test_label = "__tyrion_app_while_test" + path
        end_label = "__tyrion_app_while_end" + path
        old_break = state["break_label"]
        old_continue = state["continue_label"]
        state["break_label"] = end_label
        state["continue_label"] = test_label
        out = asm_label(out, test_label)
        out = emit_runtime_native_direct_expr(out, stmt["condition"], temp, temp + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x0", temp)
        out = asm_line(out, "bl __tyrion_app_truthy")
        out = asm_line(out, "cbz w0, " + end_label)
        out = emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_while")
        out = asm_line(out, "b " + test_label)
        out = asm_label(out, end_label)
        state["break_label"] = old_break
        state["continue_label"] = old_continue
        return out
    if kind == "for":
        test_label = "__tyrion_app_for_test" + path
        advance_label = "__tyrion_app_for_advance" + path
        end_label = "__tyrion_app_for_end" + path
        iterable_slot = temp
        index_slot = temp + 1
        value_slot = temp + 2
        out = emit_runtime_native_direct_expr(out, stmt["iterable"], iterable_slot, temp + 3, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x13", index_slot)
        out = asm_line(out, "str xzr, [x13]")
        out = asm_line(out, "mov w9, #2")
        out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
        old_break = state["break_label"]
        old_continue = state["continue_label"]
        old_temp_base = state["temp_base"]
        state["break_label"] = end_label
        state["continue_label"] = advance_label
        state["temp_base"] = temp + 3
        out = asm_label(out, test_label)
        out = runtime_native_direct_slot_addr_v2(out, "x0", iterable_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", index_slot)
        out = asm_line(out, "ldr x1, [x1]")
        out = asm_line(out, "bl __tyrion_app_iter_has_next")
        out = asm_line(out, "cbz w0, " + end_label)
        out = runtime_native_direct_slot_addr_v2(out, "x0", value_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", iterable_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x2", index_slot)
        out = asm_line(out, "ldr x2, [x2]")
        out = asm_line(out, "bl __tyrion_app_iter_at")
        target_idx = 0
        while target_idx < len(stmt["targets"]):
            target_slot = runtime_native_direct_local_index(state["frame"], stmt["targets"][target_idx])
            out = runtime_native_direct_slot_addr_v2(out, "x0", target_slot)
            out = runtime_native_direct_slot_addr_v2(out, "x1", value_slot)
            if len(stmt["targets"]) == 1:
                out = asm_line(out, "bl __tyrion_app_slot_copy")
            else:
                out = asm_line(out, "mov x2, #" + str(target_idx))
                out = asm_line(out, "bl __tyrion_app_iter_at")
            target_idx = target_idx + 1
        out = emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_for")
        out = asm_label(out, advance_label)
        out = runtime_native_direct_slot_addr_v2(out, "x9", index_slot)
        out = asm_line(out, "ldr x10, [x9]")
        out = asm_line(out, "add x10, x10, #1")
        out = asm_line(out, "str x10, [x9]")
        out = asm_line(out, "b " + test_label)
        out = asm_label(out, end_label)
        state["temp_base"] = old_temp_base
        state["break_label"] = old_break
        state["continue_label"] = old_continue
        return out
    if kind == "try":
        handler_label = "__tyrion_app_try_handler" + path
        try_finally_label = "__tyrion_app_try_finally" + path
        end_label = "__tyrion_app_try_end" + path
        propagate_label = "__tyrion_app_try_propagate" + path
        exception_slot = temp
        pending_slot = temp + 3
        old_raise = state["raise_label"]
        old_exception_slot = state["exception_slot"]
        old_temp_base = state["temp_base"]
        old_finally_label = state["finally_label"]
        old_finally_pending_slot = state["finally_pending_slot"]
        old_finally_scope_path = state["finally_scope_path"]
        try_break = state["break_label"]
        try_continue = state["continue_label"]
        state["raise_label"] = handler_label
        state["exception_slot"] = exception_slot
        state["temp_base"] = temp + 4
        if len(stmt["finally_body"]) > 0:
            state["finally_label"] = try_finally_label
            state["finally_pending_slot"] = pending_slot
            state["finally_scope_path"] = path
        out = runtime_native_direct_slot_addr_v2(out, "x0", exception_slot)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 2)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = emit_runtime_native_direct_control_value(out, pending_slot, 0)
        out = emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_try")
        out = asm_line(out, "b " + try_finally_label)
        out = asm_label(out, handler_label)
        if len(stmt["except_body"]) == 0:
            out = asm_line(out, "b " + propagate_label)
        else:
            if stmt["except_name"] != "":
                literal_label = runtime_native_direct_literal_label(plan, "string", stmt["except_name"])
                out = runtime_native_direct_slot_addr_v2(out, "x13", temp + 1)
                out = asm_addr(out, state["target"], "x9", literal_label)
                out = asm_line(out, "str x9, [x13]")
                out = asm_line(out, "mov x9, #" + str(len(stmt["except_name"])))
                out = asm_line(out, "str x9, [x13, #8]")
                out = asm_line(out, "mov w9, #4")
                out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
                out = runtime_native_direct_slot_addr_v2(out, "x0", exception_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", temp + 1)
                out = asm_line(out, "bl __tyrion_app_value_equal")
                out = asm_line(out, "cbz w0, " + propagate_label)
            if stmt["except_binding"] != "":
                binding_slot = runtime_native_direct_local_index(state["frame"], stmt["except_binding"])
                out = runtime_native_direct_slot_addr_v2(out, "x0", binding_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", exception_slot)
                out = asm_line(out, "bl __tyrion_app_slot_copy")
            state["raise_label"] = propagate_label
            out = emit_runtime_native_direct_statements(out, stmt["except_body"], plan, state, path + "_except")
            out = asm_line(out, "b " + try_finally_label)
        out = asm_label(out, propagate_label)
        out = runtime_native_direct_slot_addr_v2(out, "x13", temp + 2)
        out = asm_line(out, "mov x9, #1")
        out = asm_line(out, "str x9, [x13]")
        out = asm_line(out, "mov w9, #3")
        out = asm_line(out, "strb w9, " + generated_value_tag_mem("x13"))
        out = asm_label(out, try_finally_label)
        state["raise_label"] = old_raise
        state["exception_slot"] = old_exception_slot
        state["finally_label"] = old_finally_label
        state["finally_pending_slot"] = old_finally_pending_slot
        state["finally_scope_path"] = old_finally_scope_path
        out = emit_runtime_native_direct_statements(out, stmt["finally_body"], plan, state, path + "_finally")
        pending_return = "__tyrion_app_try_pending_return" + path
        pending_break = "__tyrion_app_try_pending_break" + path
        pending_continue = "__tyrion_app_try_pending_continue" + path
        pending_done = "__tyrion_app_try_pending_done" + path
        out = runtime_native_direct_slot_addr_v2(out, "x13", pending_slot)
        out = asm_line(out, "ldr x9, [x13]")
        if state["return_label"] != "":
            out = asm_line(out, "cmp x9, #1")
            out = asm_line(out, "b.eq " + pending_return)
        if try_break != "":
            out = asm_line(out, "cmp x9, #2")
            out = asm_line(out, "b.eq " + pending_break)
        if try_continue != "":
            out = asm_line(out, "cmp x9, #3")
            out = asm_line(out, "b.eq " + pending_continue)
        out = asm_line(out, "b " + pending_done)
        if state["return_label"] != "":
            out = asm_label(out, pending_return)
            out = emit_runtime_native_direct_control_forward(out, state, 1, state["return_label"])
        if try_break != "":
            out = asm_label(out, pending_break)
            if runtime_native_direct_control_crosses_finally(state):
                out = emit_runtime_native_direct_control_forward(out, state, 2, try_break)
            else:
                out = asm_line(out, "b " + try_break)
        if try_continue != "":
            out = asm_label(out, pending_continue)
            if runtime_native_direct_control_crosses_finally(state):
                out = emit_runtime_native_direct_control_forward(out, state, 3, try_continue)
            else:
                out = asm_line(out, "b " + try_continue)
        out = asm_label(out, pending_done)
        out = runtime_native_direct_slot_addr_v2(out, "x0", temp + 2)
        out = asm_line(out, "bl __tyrion_app_truthy")
        out = asm_line(out, "cbz w0, " + end_label)
        if old_raise == "":
            out = asm_line(out, "b __tyrion_app_list_fail")
        else:
            if old_exception_slot != exception_slot:
                out = runtime_native_direct_slot_addr_v2(out, "x0", old_exception_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", exception_slot)
                out = asm_line(out, "bl __tyrion_app_slot_copy")
            out = asm_line(out, "b " + old_raise)
        out = asm_label(out, end_label)
        state["temp_base"] = old_temp_base
        return out
    if kind == "raise":
        if state["raise_label"] == "":
            fail("runtime-native direct uncaught raise")
        out = emit_runtime_native_direct_expr(out, stmt["value"], state["exception_slot"], temp + 1, plan, state)
        return asm_line(out, "b " + state["raise_label"])
    if kind == "yield":
        if not state["generator"]:
            fail("runtime-native direct yield outside generator")
        yield_id = runtime_native_direct_yield_id(state["yield_paths"], path)
        continuation_label = state["generator_label"] + "_yield_" + str(yield_id)
        out = emit_runtime_native_direct_expr(out, stmt["value"], temp, temp + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "bl __tyrion_app_slot_move")
        local_idx = 0
        frame_slot_count = state["frame_bytes"] / generated_value_slot_size()
        while local_idx < frame_slot_count:
            out = asm_line(out, "add x0, x20, #256")
            out = emit_runtime_native_immediate(out, "x15", runtime_native_direct_slot_offset_v2(local_idx), target)
            out = asm_line(out, "add x0, x0, x15")
            out = runtime_native_direct_slot_addr_v2(out, "x1", local_idx)
            out = asm_line(out, "bl __tyrion_app_slot_move")
            local_idx = local_idx + 1
        out = asm_line(out, "mov x9, #" + str(yield_id))
        out = asm_line(out, "str x9, [x20, #8]")
        out = emit_runtime_native_immediate(out, "x15", state["frame_bytes"], target)
        out = asm_line(out, "add sp, sp, x15")
        out = asm_line(out, "ldp x21, x22, [sp, #32]")
        out = asm_line(out, "ldp x19, x20, [sp, #16]")
        out = asm_line(out, "ldp x29, x30, [sp], #48")
        out = asm_line(out, "mov w0, #1")
        out = asm_line(out, "ret")
        return asm_label(out, continuation_label)
    if kind == "break":
        if state["break_label"] == "":
            fail("runtime-native direct break outside loop")
        if runtime_native_direct_control_crosses_finally(state):
            out = emit_runtime_native_direct_control_value(out, state["finally_pending_slot"], 2)
            return asm_line(out, "b " + state["finally_label"])
        return asm_line(out, "b " + state["break_label"])
    if kind == "continue":
        if state["continue_label"] == "":
            fail("runtime-native direct continue outside loop")
        if runtime_native_direct_control_crosses_finally(state):
            out = emit_runtime_native_direct_control_value(out, state["finally_pending_slot"], 3)
            return asm_line(out, "b " + state["finally_label"])
        return asm_line(out, "b " + state["continue_label"])
    if kind == "return":
        if state["return_label"] == "":
            fail("runtime-native direct return outside function")
        if state["generator"]:
            return asm_line(out, "b " + state["return_label"])
        out = emit_runtime_native_direct_expr(out, stmt["value"], temp, temp + 1, plan, state)
        out = runtime_native_direct_slot_addr_v2(out, "x1", temp)
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "bl __tyrion_app_slot_copy")
        if state["finally_label"] != "":
            out = emit_runtime_native_direct_control_value(out, state["finally_pending_slot"], 1)
            return asm_line(out, "b " + state["finally_label"])
        return asm_line(out, "b " + state["return_label"])
    if kind == "with":
        cleanup_label = "__tyrion_app_try_finally" + path
        exception_label = "__tyrion_app_with_exception" + path
        end_label = "__tyrion_app_with_end" + path
        pending_return = "__tyrion_app_with_pending_return" + path
        pending_break = "__tyrion_app_with_pending_break" + path
        pending_continue = "__tyrion_app_with_pending_continue" + path
        pending_raise = "__tyrion_app_with_pending_raise" + path
        resource_slot = runtime_native_direct_local_index(state["frame"], stmt["name"])
        pending_slot = temp
        exception_slot = temp + 1
        close_result_slot = temp + 2
        old_raise = state["raise_label"]
        old_exception_slot = state["exception_slot"]
        old_temp_base = state["temp_base"]
        old_finally_label = state["finally_label"]
        old_finally_pending_slot = state["finally_pending_slot"]
        old_finally_scope_path = state["finally_scope_path"]
        with_break = state["break_label"]
        with_continue = state["continue_label"]
        out = emit_runtime_native_direct_expr(out, stmt["resource"], resource_slot, temp + 3, plan, state)
        out = emit_runtime_native_direct_control_value(out, pending_slot, 0)
        out = runtime_native_direct_slot_addr_v2(out, "x0", exception_slot)
        out = asm_line(out, "bl __tyrion_app_slot_release")
        state["raise_label"] = exception_label
        state["exception_slot"] = exception_slot
        state["temp_base"] = temp + 3
        state["finally_label"] = cleanup_label
        state["finally_pending_slot"] = pending_slot
        state["finally_scope_path"] = path
        out = emit_runtime_native_direct_statements(out, stmt["body"], plan, state, path + "_with")
        out = asm_line(out, "b " + cleanup_label)
        out = asm_label(out, exception_label)
        out = emit_runtime_native_direct_control_value(out, pending_slot, 4)
        out = asm_line(out, "b " + cleanup_label)
        out = asm_label(out, cleanup_label)
        state["raise_label"] = old_raise
        state["exception_slot"] = old_exception_slot
        state["temp_base"] = old_temp_base
        state["finally_label"] = old_finally_label
        state["finally_pending_slot"] = old_finally_pending_slot
        state["finally_scope_path"] = old_finally_scope_path
        out = runtime_native_direct_slot_addr_v2(out, "x0", resource_slot)
        out = runtime_native_direct_slot_addr_v2(out, "x1", close_result_slot)
        out = asm_line(out, "bl __tyrion_app_file_close")
        out = runtime_native_direct_slot_addr_v2(out, "x13", pending_slot)
        out = asm_line(out, "ldr x9, [x13]")
        if state["return_label"] != "":
            out = asm_line(out, "cmp x9, #1")
            out = asm_line(out, "b.eq " + pending_return)
        if with_break != "":
            out = asm_line(out, "cmp x9, #2")
            out = asm_line(out, "b.eq " + pending_break)
        if with_continue != "":
            out = asm_line(out, "cmp x9, #3")
            out = asm_line(out, "b.eq " + pending_continue)
        out = asm_line(out, "cmp x9, #4")
        out = asm_line(out, "b.eq " + pending_raise)
        out = asm_line(out, "b " + end_label)
        if state["return_label"] != "":
            out = asm_label(out, pending_return)
            out = emit_runtime_native_direct_control_forward(out, state, 1, state["return_label"])
        if with_break != "":
            out = asm_label(out, pending_break)
            if runtime_native_direct_control_crosses_finally(state):
                out = emit_runtime_native_direct_control_forward(out, state, 2, with_break)
            else:
                out = asm_line(out, "b " + with_break)
        if with_continue != "":
            out = asm_label(out, pending_continue)
            if runtime_native_direct_control_crosses_finally(state):
                out = emit_runtime_native_direct_control_forward(out, state, 3, with_continue)
            else:
                out = asm_line(out, "b " + with_continue)
        out = asm_label(out, pending_raise)
        if old_raise == "":
            out = asm_line(out, "b __tyrion_app_list_fail")
        else:
            if old_exception_slot != exception_slot:
                out = runtime_native_direct_slot_addr_v2(out, "x0", old_exception_slot)
                out = runtime_native_direct_slot_addr_v2(out, "x1", exception_slot)
                out = asm_line(out, "bl __tyrion_app_slot_copy")
            out = asm_line(out, "b " + old_raise)
        return asm_label(out, end_label)
    if kind == "function":
        return out
    if kind == "class":
        return out
    fail("unsupported runtime-native direct statement: " + kind)

def emit_runtime_native_direct_host_extension_runtime(out, target, plan):
    extension_tag = str(generated_value_tag_extension_handle())
    # Host ABI strings are C strings, while Tyrion strings are byte spans.
    # Materialize bounded owned copies so borrowed/token-backed values cannot
    # read through the end of their logical payload.
    out = asm_label(out, "__tyrion_app_extension_string_cstr")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "cmp w9, #4")
    out = asm_line(out, "b.eq __tyrion_app_extension_string_cstr_type_ok")
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne __tyrion_app_extension_string_cstr_fail")
    out = asm_label(out, "__tyrion_app_extension_string_cstr_type_ok")
    out = asm_line(out, "ldr x20, [x19, #8]")
    out = asm_line(out, "mov x9, #1073741823")
    out = asm_line(out, "cmp x20, x9")
    out = asm_line(out, "b.hi __tyrion_app_extension_string_cstr_fail")
    out = asm_line(out, "add x0, x20, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_extension_string_cstr_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "ldr x1, [x19]")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "strb wzr, [x21, x20]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "b __tyrion_app_extension_string_cstr_done")
    out = asm_label(out, "__tyrion_app_extension_string_cstr_fail")
    out = asm_line(out, "mov x0, #0")
    out = asm_label(out, "__tyrion_app_extension_string_cstr_done")
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    out = asm_label(out, "__tyrion_app_host_load_static")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "mov x0, #48")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_host_load_static_fail")
    out = asm_line(out, "mov x22, x0")
    out = asm_line(out, "mov x1, #48")
    out = asm_line(out, "bl __tyrion_app_zero_region")
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "str x9, [x22]")
    out = asm_line(out, "str x9, [x22, #8]")
    out = asm_line(out, "str x20, [x22, #16]")
    out = asm_line(out, "str x21, [x22, #24]")
    out = asm_line(out, "str x9, [x22, #32]")
    out = asm_line(out, "str x22, [x19]")
    out = asm_line(out, "mov w9, #" + extension_tag)
    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "b __tyrion_app_host_load_static_done")
    out = asm_label(out, "__tyrion_app_host_load_static_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_label(out, "__tyrion_app_host_load_static_done")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # Runtime-only extension loads are available only in the explicit dynamic
    # mode. Names remain identifiers and are resolved beneath the embedded,
    # compiler-approved extension root.
    out = asm_label(out, "__tyrion_app_extension_close")
    out = asm_line(out, "b " + asm_call_name(target, "dlclose"))
    out = asm_label(out, "__tyrion_app_host_load")
    if len(plan["extensions"]) > 0:
        out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x1"))
        out = asm_line(out, "cmp w9, #4")
        out = asm_line(out, "b.eq __tyrion_app_host_load_static_type_ok")
        out = asm_line(out, "cmp w9, #8")
        out = asm_line(out, "b.ne __tyrion_app_host_load_fallback")
        out = asm_label(out, "__tyrion_app_host_load_static_type_ok")
        for extension in plan["extensions"]:
            extension_id = extension["id"]
            next_label = "__tyrion_app_host_load_static_next_" + str(extension_id)
            loop_label = "__tyrion_app_host_load_static_name_" + str(extension_id)
            match_label = "__tyrion_app_host_load_static_match_" + str(extension_id)
            out = asm_line(out, "ldr x9, [x1, #8]")
            out = emit_runtime_native_immediate(out, "x14", len(extension["name"]), target)
            out = asm_line(out, "cmp x9, x14")
            out = asm_line(out, "b.ne " + next_label)
            out = asm_line(out, "ldr x9, [x1]")
            out = asm_addr(out, target, "x10", "__tyrion_app_static_extension_name_" + str(extension_id))
            out = asm_line(out, "mov x11, #0")
            out = asm_label(out, loop_label)
            out = asm_line(out, "cmp x11, x14")
            out = asm_line(out, "b.hs " + match_label)
            out = asm_line(out, "ldrb w12, [x9, x11]")
            out = asm_line(out, "ldrb w13, [x10, x11]")
            out = asm_line(out, "cmp w12, w13")
            out = asm_line(out, "b.ne " + next_label)
            out = asm_line(out, "add x11, x11, #1")
            out = asm_line(out, "b " + loop_label)
            out = asm_label(out, match_label)
            out = emit_runtime_native_immediate(out, "x1", extension_id, target)
            out = asm_addr(out, target, "x2", target["symbol_prefix"] + extension["call_symbol"])
            out = asm_line(out, "b __tyrion_app_host_load_static")
            out = asm_label(out, next_label)
        out = asm_label(out, "__tyrion_app_host_load_fallback")
    if plan["dynamic_extension_mode"] != "allowed":
        out = asm_line(out, "b __tyrion_app_slot_release")
    else:
        dynamic_suffix = "/libtyrion_ext.dylib"
        dynamic_flags = 6
        if target["os"] == "linux":
            dynamic_suffix = "/libtyrion_ext.so"
            dynamic_flags = 2
        out = asm_line(out, "stp x29, x30, [sp, #-128]!")
        out = asm_line(out, "mov x29, sp")
        out = asm_line(out, "stp x19, x20, [sp, #16]")
        out = asm_line(out, "stp x21, x22, [sp, #32]")
        out = asm_line(out, "stp x23, x24, [sp, #48]")
        out = asm_line(out, "stp x25, x26, [sp, #64]")
        out = asm_line(out, "mov x19, x0")
        out = asm_line(out, "mov x20, x1")
        out = asm_line(out, "mov x23, #0")
        out = asm_line(out, "mov x24, #0")
        out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x20"))
        out = asm_line(out, "cmp w9, #4")
        out = asm_line(out, "b.eq __tyrion_app_host_load_dynamic_type_ok")
        out = asm_line(out, "cmp w9, #8")
        out = asm_line(out, "b.ne __tyrion_app_host_load_dynamic_fail")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_type_ok")
        out = asm_line(out, "ldr x21, [x20]")
        out = asm_line(out, "ldr x22, [x20, #8]")
        out = asm_line(out, "cbz x21, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "cbz x22, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "cmp x22, #128")
        out = asm_line(out, "b.hi __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x9, #0")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_loop")
        out = asm_line(out, "cmp x9, x22")
        out = asm_line(out, "b.hs __tyrion_app_host_load_dynamic_name_valid")
        out = asm_line(out, "ldrb w10, [x21, x9]")
        out = asm_line(out, "cmp w10, #48")
        out = asm_line(out, "b.lt __tyrion_app_host_load_dynamic_name_alpha")
        out = asm_line(out, "cmp w10, #57")
        out = asm_line(out, "b.ls __tyrion_app_host_load_dynamic_name_next")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_alpha")
        out = asm_line(out, "cmp w10, #65")
        out = asm_line(out, "b.lt __tyrion_app_host_load_dynamic_name_lower")
        out = asm_line(out, "cmp w10, #90")
        out = asm_line(out, "b.ls __tyrion_app_host_load_dynamic_name_next")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_lower")
        out = asm_line(out, "cmp w10, #97")
        out = asm_line(out, "b.lt __tyrion_app_host_load_dynamic_name_underscore")
        out = asm_line(out, "cmp w10, #122")
        out = asm_line(out, "b.ls __tyrion_app_host_load_dynamic_name_next")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_underscore")
        out = asm_line(out, "cmp w10, #95")
        out = asm_line(out, "b.ne __tyrion_app_host_load_dynamic_fail")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_next")
        out = asm_line(out, "add x9, x9, #1")
        out = asm_line(out, "b __tyrion_app_host_load_dynamic_name_loop")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_name_valid")
        path_extra = len(plan["dynamic_extension_root"]) + len(dynamic_suffix) + 2
        out = asm_line(out, "add x0, x22, #" + str(path_extra))
        out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
        out = asm_line(out, "cbz x0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x23, x0")
        out = asm_addr(out, target, "x1", "__tyrion_app_extension_root")
        out = asm_line(out, "mov x2, #" + str(len(plan["dynamic_extension_root"]) + 1))
        out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
        out = asm_line(out, "add x0, x23, #" + str(len(plan["dynamic_extension_root"]) + 1))
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, x22")
        out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
        out = asm_line(out, "add x0, x23, #" + str(len(plan["dynamic_extension_root"]) + 1))
        out = asm_line(out, "add x0, x0, x22")
        out = asm_addr(out, target, "x1", "__tyrion_app_extension_suffix")
        out = asm_line(out, "mov x2, #" + str(len(dynamic_suffix) + 1))
        out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
        out = asm_line(out, "mov x0, x23")
        out = asm_line(out, "mov w1, #" + str(dynamic_flags))
        out = asm_line(out, "bl " + asm_call_name(target, "dlopen"))
        out = asm_line(out, "mov x24, x0")
        out = asm_line(out, "mov x0, x23")
        out = asm_line(out, "bl " + asm_call_name(target, "free"))
        out = asm_line(out, "mov x23, #0")
        out = asm_line(out, "cbz x24, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x0, x24")
        out = asm_addr(out, target, "x1", "__tyrion_app_extension_manifest_symbol")
        out = asm_line(out, "bl " + asm_call_name(target, "dlsym"))
        out = asm_line(out, "cbz x0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "blr x0")
        out = asm_line(out, "cbz x0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "ldr x9, [x0]")
        out = asm_line(out, "cmp x9, #32")
        out = asm_line(out, "b.lo __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "ldr x9, [x0, #8]")
        out = asm_line(out, "cmp x9, #1")
        out = asm_line(out, "b.ne __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "ldr x25, [x0, #16]")
        out = asm_line(out, "ldr x9, [x0, #24]")
        out = asm_line(out, "str x9, [sp, #80]")
        out = asm_line(out, "cbz x25, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "cbz x9, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x0, x25")
        out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
        out = asm_line(out, "cmp x0, x22")
        out = asm_line(out, "b.ne __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x0, x25")
        out = asm_line(out, "mov x1, x21")
        out = asm_line(out, "mov x2, x22")
        out = asm_line(out, "bl " + asm_call_name(target, "memcmp"))
        out = asm_line(out, "cbnz w0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "ldr x1, [sp, #80]")
        out = asm_line(out, "ldrb w9, [x1]")
        out = asm_line(out, "cbz w9, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x0, x24")
        out = asm_line(out, "bl " + asm_call_name(target, "dlsym"))
        out = asm_line(out, "cbz x0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x25, x0")
        out = asm_line(out, "mov x0, #48")
        out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
        out = asm_line(out, "cbz x0, __tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "mov x26, x0")
        out = asm_line(out, "mov x1, #48")
        out = asm_line(out, "bl __tyrion_app_zero_region")
        out = asm_line(out, "mov x9, #1")
        out = asm_line(out, "str x9, [x26]")
        out = asm_line(out, "mov x9, #2")
        out = asm_line(out, "str x9, [x26, #8]")
        out = asm_line(out, "str x24, [x26, #16]")
        out = asm_line(out, "str x25, [x26, #24]")
        out = asm_line(out, "mov x9, #1")
        out = asm_line(out, "str x9, [x26, #32]")
        out = asm_addr(out, target, "x9", "__tyrion_app_extension_close")
        out = asm_line(out, "str x9, [x26, #40]")
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = asm_line(out, "str x26, [x19]")
        out = asm_line(out, "mov w9, #" + extension_tag)
        out = asm_line(out, "strb w9, " + generated_value_tag_mem("x19"))
        out = asm_line(out, "mov x24, #0")
        out = asm_line(out, "b __tyrion_app_host_load_dynamic_done")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_fail")
        out = asm_line(out, "cbz x23, __tyrion_app_host_load_dynamic_fail_close")
        out = asm_line(out, "mov x0, x23")
        out = asm_line(out, "bl " + asm_call_name(target, "free"))
        out = asm_label(out, "__tyrion_app_host_load_dynamic_fail_close")
        out = asm_line(out, "cbz x24, __tyrion_app_host_load_dynamic_fail_release")
        out = asm_line(out, "mov x0, x24")
        out = asm_line(out, "bl " + asm_call_name(target, "dlclose"))
        out = asm_label(out, "__tyrion_app_host_load_dynamic_fail_release")
        out = asm_line(out, "mov x0, x19")
        out = asm_line(out, "bl __tyrion_app_slot_release")
        out = asm_label(out, "__tyrion_app_host_load_dynamic_done")
        out = asm_line(out, "ldp x25, x26, [sp, #64]")
        out = asm_line(out, "ldp x23, x24, [sp, #48]")
        out = asm_line(out, "ldp x21, x22, [sp, #32]")
        out = asm_line(out, "ldp x19, x20, [sp, #16]")
        out = asm_line(out, "ldp x29, x30, [sp], #128")
        out = asm_line(out, "ret")
        out = asm_section(out, target["rodata_section"])
        out = asm_cstr(out, "__tyrion_app_extension_root", plan["dynamic_extension_root"] + "/")
        out = asm_cstr(out, "__tyrion_app_extension_suffix", dynamic_suffix)
        out = asm_cstr(out, "__tyrion_app_extension_manifest_symbol", "tyrion_host_extension_manifest_v1")
        out = asm_section(out, target["text_section"])

    out = asm_label(out, "__tyrion_app_host_call")
    out = asm_line(out, "stp x29, x30, [sp, #-96]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "stp x23, x24, [sp, #48]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    # Cleanup is shared by every early-failure edge.  Keep the temporary C
    # string pointers null until each conversion succeeds so a rejected or
    # already-unloaded handle cannot pass uninitialized stack data to free().
    out = asm_line(out, "str xzr, [sp, #64]")
    out = asm_line(out, "str xzr, [sp, #72]")
    out = asm_line(out, "str xzr, [sp, #80]")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x20"))
    out = asm_line(out, "cmp w9, #" + extension_tag)
    out = asm_line(out, "b.ne __tyrion_app_host_call_fail")
    out = asm_line(out, "ldr x9, [x20]")
    out = asm_line(out, "cbz x9, __tyrion_app_host_call_fail")
    out = asm_line(out, "ldr x10, [x9, #32]")
    out = asm_line(out, "cbz x10, __tyrion_app_host_call_fail")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x21"))
    out = asm_line(out, "cmp w9, #4")
    out = asm_line(out, "b.eq __tyrion_app_host_call_op_ok")
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne __tyrion_app_host_call_fail")
    out = asm_label(out, "__tyrion_app_host_call_op_ok")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x22"))
    out = asm_line(out, "cmp w9, #4")
    out = asm_line(out, "b.eq __tyrion_app_host_call_payload_ok")
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne __tyrion_app_host_call_fail")
    out = asm_label(out, "__tyrion_app_host_call_payload_ok")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "bl __tyrion_app_extension_string_cstr")
    out = asm_line(out, "cbz x0, __tyrion_app_host_call_fail")
    out = asm_line(out, "str x0, [sp, #64]")
    out = asm_line(out, "mov x0, x22")
    out = asm_line(out, "bl __tyrion_app_extension_string_cstr")
    out = asm_line(out, "cbz x0, __tyrion_app_host_call_fail")
    out = asm_line(out, "str x0, [sp, #72]")
    out = asm_line(out, "ldr x9, [x20]")
    out = asm_line(out, "ldr x9, [x9, #24]")
    out = asm_line(out, "cbz x9, __tyrion_app_host_call_fail")
    out = asm_line(out, "ldr x0, [sp, #64]")
    out = asm_line(out, "ldr x1, [sp, #72]")
    out = asm_line(out, "blr x9")
    out = asm_label(out, "__tyrion_app_host_call_result")
    out = asm_line(out, "cbz x0, __tyrion_app_host_call_fail")
    out = asm_line(out, "mov x23, x0")
    out = asm_line(out, "bl " + asm_call_name(target, "strlen"))
    out = asm_line(out, "mov x24, x0")
    out = asm_line(out, "add x0, x24, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_host_call_fail")
    out = asm_line(out, "str x0, [sp, #80]")
    out = asm_line(out, "mov x1, x23")
    out = asm_line(out, "add x2, x24, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "ldr x9, [sp, #80]")
    out = asm_line(out, "str x9, [x19]")
    out = asm_line(out, "str x24, [x19, #8]")
    out = asm_line(out, "mov w9, #8")
    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "b __tyrion_app_host_call_cleanup")
    out = asm_label(out, "__tyrion_app_host_call_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_label(out, "__tyrion_app_host_call_cleanup")
    out = asm_line(out, "ldr x0, [sp, #64]")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "ldr x0, [sp, #72]")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_label(out, "__tyrion_app_host_call_done")
    out = asm_line(out, "ldp x23, x24, [sp, #48]")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #96")
    out = asm_line(out, "ret")

    out = asm_label(out, "__tyrion_app_host_unload")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, #0")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x1"))
    out = asm_line(out, "cmp w9, #" + extension_tag)
    out = asm_line(out, "b.ne __tyrion_app_host_unload_false")
    out = asm_line(out, "ldr x20, [x1]")
    out = asm_line(out, "cbz x20, __tyrion_app_host_unload_false")
    out = asm_line(out, "ldr x9, [x20, #32]")
    out = asm_line(out, "cbz x9, __tyrion_app_host_unload_false")
    out = asm_line(out, "str xzr, [x20, #32]")
    out = asm_line(out, "ldr x9, [x20, #8]")
    out = asm_line(out, "cmp x9, #2")
    out = asm_line(out, "b.ne __tyrion_app_host_unload_closed")
    out = asm_line(out, "ldr x9, [x20, #40]")
    out = asm_line(out, "cbz x9, __tyrion_app_host_unload_closed")
    out = asm_line(out, "ldr x0, [x20, #16]")
    out = asm_line(out, "str xzr, [x20, #16]")
    out = asm_line(out, "str xzr, [x20, #24]")
    out = asm_line(out, "str xzr, [x20, #40]")
    out = asm_line(out, "blr x9")
    out = asm_label(out, "__tyrion_app_host_unload_closed")
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "b __tyrion_app_host_unload_publish")
    out = asm_label(out, "__tyrion_app_host_unload_false")
    out = asm_line(out, "mov x9, #0")
    out = asm_label(out, "__tyrion_app_host_unload_publish")
    out = asm_line(out, "str x9, [x19]")
    out = asm_line(out, "mov w10, #3")
    out = asm_line(out, "strb w10, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    if len(plan["extensions"]) > 0:
        out = asm_section(out, target["rodata_section"])
        for extension in plan["extensions"]:
            out = asm_cstr(out, "__tyrion_app_static_extension_name_" + str(extension["id"]), extension["name"])
        out = asm_section(out, target["text_section"])
        out = asm_section(out, ".p2align 2")
    return out

def emit_runtime_native_direct_object_runtime(out, target):
    out = asm_label(out, "__tyrion_app_object_new")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "bl __tyrion_app_slot_release")
    out = asm_line(out, "mov x0, #160")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_oom")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x1, #160")
    out = asm_line(out, "bl __tyrion_app_zero_region")
    out = asm_line(out, "mov x9, #1")
    out = asm_line(out, "str x9, [x21]")
    out = asm_line(out, "str x20, [x21, #8]")
    out = asm_line(out, "add x0, x21, #16")
    out = asm_line(out, "mov x1, #4")
    out = asm_line(out, "bl __tyrion_app_dict_new")
    out = asm_line(out, "str x21, [x19]")
    out = asm_line(out, "mov w9, #6")
    out = asm_line(out, "strb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")
    out = asm_label(out, "__tyrion_app_object_attr_set")
    out = asm_line(out, "stp x29, x30, [sp, #-32]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "str x19, [sp, #16]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "cmp w9, #6")
    out = asm_line(out, "b.ne __tyrion_app_object_fail")
    out = asm_line(out, "ldr x0, [x19]")
    out = asm_line(out, "cbz x0, __tyrion_app_object_fail")
    out = asm_line(out, "add x0, x0, #16")
    out = asm_line(out, "bl __tyrion_app_dict_set")
    out = asm_line(out, "ldr x19, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #32")
    out = asm_line(out, "ret")
    out = asm_label(out, "__tyrion_app_object_attr_get")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x1"))
    out = asm_line(out, "cmp w9, #6")
    out = asm_line(out, "b.ne __tyrion_app_object_fail")
    out = asm_line(out, "ldr x1, [x1]")
    out = asm_line(out, "cbz x1, __tyrion_app_object_fail")
    out = asm_line(out, "add x1, x1, #16")
    out = asm_line(out, "b __tyrion_app_dict_index")
    out = asm_label(out, "__tyrion_app_object_fail")
    out = asm_line(out, "mov x0, #5")
    out = asm_line(out, "b " + asm_call_name(target, "exit"))
    return out

def emit_runtime_native_direct_process_runtime(out, target):
    # Convert a length-addressed Tyrion string into an owned C string.
    # x0=value slot; returns x0=malloc buffer or zero.
    out = asm_label(out, "__tyrion_app_process_string_cstr")
    out = asm_line(out, "stp x29, x30, [sp, #-64]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "str x21, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "ldrb w9, " + generated_value_tag_mem("x19"))
    out = asm_line(out, "cmp w9, #4")
    out = asm_line(out, "b.eq __tyrion_app_process_string_cstr_type_ok")
    out = asm_line(out, "cmp w9, #8")
    out = asm_line(out, "b.ne __tyrion_app_process_string_cstr_fail")
    out = asm_label(out, "__tyrion_app_process_string_cstr_type_ok")
    out = asm_line(out, "ldr x20, [x19, #8]")
    out = asm_line(out, "add x0, x20, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_process_string_cstr_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "ldr x1, [x19]")
    out = asm_line(out, "mov x2, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "memcpy"))
    out = asm_line(out, "strb wzr, [x21, x20]")
    out = asm_line(out, "mov x0, x21")
    out = asm_line(out, "b __tyrion_app_process_string_cstr_done")
    out = asm_label(out, "__tyrion_app_process_string_cstr_fail")
    out = asm_line(out, "mov x0, #0")
    out = asm_label(out, "__tyrion_app_process_string_cstr_done")
    out = asm_line(out, "ldr x21, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #64")
    out = asm_line(out, "ret")

    # Read and close a seekable FILE stream. x0=FILE; returns x0=buffer,
    # x1=byte length. A zero buffer denotes failure; empty output still owns
    # a one-byte NUL-terminated allocation.
    out = asm_label(out, "__tyrion_app_process_read_stream_all")
    out = asm_line(out, "stp x29, x30, [sp, #-80]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, #0")
    out = asm_line(out, "mov x21, #0")
    out = asm_line(out, "cbz x19, __tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "mov x2, #2")
    out = asm_line(out, "bl " + asm_call_name(target, "fseek"))
    out = asm_line(out, "cbnz w0, __tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "ftell"))
    out = asm_line(out, "tbnz x0, #63, __tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "mov x21, x0")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "mov x1, #0")
    out = asm_line(out, "mov x2, #0")
    out = asm_line(out, "bl " + asm_call_name(target, "fseek"))
    out = asm_line(out, "cbnz w0, __tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "add x0, x21, #1")
    out = asm_line(out, "bl " + asm_call_name(target, "malloc"))
    out = asm_line(out, "cbz x0, __tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "mov x20, x0")
    out = asm_line(out, "cbz x21, __tyrion_app_process_read_stream_all_terminate")
    out = asm_line(out, "mov x1, #1")
    out = asm_line(out, "mov x2, x21")
    out = asm_line(out, "mov x3, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fread"))
    out = asm_line(out, "cmp x0, x21")
    out = asm_line(out, "b.ne __tyrion_app_process_read_stream_all_free")
    out = asm_label(out, "__tyrion_app_process_read_stream_all_terminate")
    out = asm_line(out, "strb wzr, [x20, x21]")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_line(out, "mov x19, #0")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "mov x1, x21")
    out = asm_line(out, "b __tyrion_app_process_read_stream_all_done")
    out = asm_label(out, "__tyrion_app_process_read_stream_all_free")
    out = asm_line(out, "mov x0, x20")
    out = asm_line(out, "bl " + asm_call_name(target, "free"))
    out = asm_line(out, "mov x20, #0")
    out = asm_label(out, "__tyrion_app_process_read_stream_all_fail")
    out = asm_line(out, "cbz x19, __tyrion_app_process_read_stream_all_failed")
    out = asm_line(out, "mov x0, x19")
    out = asm_line(out, "bl " + asm_call_name(target, "fclose"))
    out = asm_label(out, "__tyrion_app_process_read_stream_all_failed")
    out = asm_line(out, "mov x0, #0")
    out = asm_line(out, "mov x1, #0")
    out = asm_label(out, "__tyrion_app_process_read_stream_all_done")
    out = asm_line(out, "ldp x21, x22, [sp, #32]")
    out = asm_line(out, "ldp x19, x20, [sp, #16]")
    out = asm_line(out, "ldp x29, x30, [sp], #80")
    out = asm_line(out, "ret")

    # x0=dict, x1=literal key bytes, x2=key length, x3=value slot.
    out = asm_label(out, "__tyrion_app_process_dict_set")
    out = asm_line(out, "stp x29, x30, [sp, #-192]!")
    out = asm_line(out, "mov x29, sp")
    out = asm_line(out, "stp x19, x20, [sp, #16]")
    out = asm_line(out, "stp x21, x22, [sp, #32]")
    out = asm_line(out, "mov x19, x0")
    out = asm_line(out, "mov x20, x1")
    out = asm_line(out, "mov x21, x2")
    out = asm_line(out, "mov x22, x3")
    out = asm_line(out, "add x0, sp, #64")
    out = asm_line(out, "mov x1, #128")
    out = asm_line(out, "bl __tyrion_app_zero_region")
