    if plan_kind == "native_inventory_has_name_body":
        return emit_exec_fn_inventory_has_name(out, target, name)
    if plan_kind == "native_inventory_rows_body":
        return emit_exec_fn_inventory_rows(out, target, name)
    if plan_kind == "native_split_text_body":
        return emit_exec_fn_split_text(out, target, name)
    if plan_kind == "native_inventory_field_body":
        return emit_exec_fn_inventory_field(out, target, name)
    if plan_kind == "native_inventory_row_body":
        return emit_exec_fn_inventory_row(out, target, name)
    if plan_kind == "native_inventory_cell_body":
        return emit_exec_fn_inventory_cell(out, target, name)
    if plan_kind == "native_decimal_text_body":
        return emit_exec_fn_decimal_text(out, target, name)
    if plan_kind == "asm_escape_string_body":
        return emit_exec_fn_asm_escape_string(out, target, name)
    if plan_kind == "asm_cstr_writer_body":
        return emit_exec_fn_asm_cstr_writer(out, target, name)
    if plan_kind == "asm_writer_format_body":
        return emit_exec_fn_asm_writer_format(out, target, name)
    if plan_kind == "native_lex_body":
        return emit_exec_fn_native_lex(out, target, name)
    if plan_kind == "parse_program_body":
        return emit_exec_fn_parse_program(out, target, name)
    if plan_kind == "native_collect_cli_spec_body":
        return emit_exec_fn_collect_cli_spec(out, target, name)
    if plan_kind == "native_program_function_print_text_body":
        return emit_exec_fn_program_function_print_text(out, target, name)
    if plan_kind == "native_compiler_cli_asm_into_body":
        return emit_exec_fn_compiler_cli_asm_into(out, target, name)
    if plan_kind == "host_target_body":
        return emit_exec_fn_host_target(out, target, name)
    if plan_kind == "native_len_body":
        return emit_exec_fn_native_len(out, target, name)
    if plan_kind == "native_read_text_file_body":
        return emit_exec_fn_native_read_text_file(out, target, name)
    if plan_kind == "native_read_module_graph_body":
        return emit_exec_fn_native_read_module_graph(out, target, name)
    if plan_kind == "native_tcp_connect_body":
        return emit_exec_fn_native_tcp(out, target, name, "connect")
    if plan_kind == "native_tcp_write_body":
        return emit_exec_fn_native_tcp(out, target, name, "write")
    if plan_kind == "native_tcp_read_body":
        return emit_exec_fn_native_tcp(out, target, name, "read")
    if plan_kind == "native_tcp_close_body":
